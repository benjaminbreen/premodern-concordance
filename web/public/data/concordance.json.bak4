ons": 7, "members": [{"entity_id": "conde", "book_id": "kosmos_humboldt_1845", "name": "Conde", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Conde"], "contexts": ["author of 'Hist. de la Domin. de los Arabes'", "noticed a heavy shower of shooting stars"]}, {"entity_id": "conde\u00e7a", "book_id": "polyanthea_medicinal", "name": "Conde\u00e7a", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 5, "variants": ["Conde\u00e7a", "Conde", "Condes"], "contexts": ["unguent for treating kidneys", "associated with a unguent"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Conde", "target_book": "polyanthea_medicinal", "target_name": "Conde\u00e7a", "similarity": 0.848}], "id": 3287, "stable_key": "clu_fb7c29619f4321ce", "ground_truth": {"modern_name": "Arab Conquest of Hispania", "confidence": "medium", "type": "concept", "note": "The reference to 'Conde' and 'Conde\u00e7a' in relation to an 'author of Hist. de la Domin. de los Arabes' and a kidney unguent is ambiguous. It could refer to a specific historical figure or a title. Without more context, identifying a precise person is difficult. The concept of the Arab conquest of Hispania is strongly implied by the title, making it the most probable referent."}}, {"canonical_name": "Lyra", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "lyra", "book_id": "kosmos_humboldt_1845", "name": "Lyra", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Lyra"], "contexts": ["constellation"]}, {"entity_id": "lyra", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Lyra", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 5, "variants": ["Lyra"], "contexts": ["constellation containing a star", "constellation containing a ring nebula"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Lyra", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Lyra", "similarity": 1.0}], "id": 3288, "stable_key": "clu_9b8450420487c139", "ground_truth": {"modern_name": "Lyra (constellation)", "confidence": "high", "type": "concept", "note": "While 'Lyra' can refer to a musical instrument, in the context of scientific texts mentioning constellations, it unequivocally refers to the astronomical constellation."}}, {"canonical_name": "Brewster", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "brewster", "book_id": "kosmos_humboldt_1845", "name": "Brewster", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Brewster"], "contexts": ["author of 'Life of Sir Isaac Newton'", "author of 'Treaties on Magnetism'"]}, {"entity_id": "brewster", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Brewster", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["Brewster"], "contexts": ["scholar who concluded refraction without colour", "analyzed solar spectrum"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Brewster", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Brewster", "similarity": 1.0}], "id": 3289, "stable_key": "clu_381574b0d2c9e245-2", "ground_truth": {"modern_name": "David Brewster", "confidence": "high", "type": "person", "birth_year": 1781, "death_year": 1868, "description": "Scottish physicist, inventor, and writer on scientific subjects.", "wikidata_id": "Q15442692", "wikidata_description": "American journalist", "wikipedia_url": "https://en.wikipedia.org/wiki/David%20Brewster%20%28journalist%29", "wikipedia_extract": "David Clark Brewster (born September 26, 1939) is an American journalist and the founder, editor and publisher of the Seattle Weekly and the Northwest news website Crosscut.com. He is also the founder, creator and former executive director of the nonprofit cultural center Town Hall Seattle. He was born on September 26, 1939, in Newark, New Jersey, the son of Gaylord Clark Brewster and Marjorie Jane Anderson. His father was a 1930 graduate of the University of Nebraska. He graduated in 1961, Phi Beta Kappa,  with a Bachelor of Arts from Yale University in New Haven, Connecticut, and he received  his master's degree from Yale University in 1963. In 1964, he married Joyce Skaggs, a 1961 graduate of Smith College."}}, {"canonical_name": "mines", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "mines", "book_id": "kosmos_humboldt_1845", "name": "Mines", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Mines"], "contexts": ["excavations for minerals", "locations where minerals are extracted"]}, {"entity_id": "mines", "book_id": "connexion_physical_sciences_somerville_1858", "name": "mines", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Mines", "mines"], "contexts": ["locations with high temperature", "locations for extracting minerals"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Mines", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "mines", "similarity": 0.991}], "id": 3290, "stable_key": "clu_69a3e49d5f2dd557", "ground_truth": {"modern_name": "Mines", "confidence": "high", "type": "place", "note": "Refers to excavations for minerals, including coal and gold. 'Minas' in Spanish also refers to mines.", "wikidata_id": "Q820477", "wikidata_description": "place for the extraction of minerals", "wikipedia_url": "https://en.wikipedia.org/wiki/Mine%20%28mining%29"}}, {"canonical_name": "earthquakes", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "earthquake_shocks", "book_id": "kosmos_humboldt_1845", "name": "earthquake shocks", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["earthquake shocks"], "contexts": ["ground tremors", "geological disturbances"]}, {"entity_id": "earthquakes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "earthquakes", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 5, "variants": ["Earthquakes", "earthquakes"], "contexts": ["geological events causing subterranean noises", "tremors propagated through the ground"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "earthquake shocks", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "earthquakes", "similarity": 0.952}], "id": 3291, "stable_key": "clu_751d25fc7c798428-2", "ground_truth": {"modern_name": "Earthquake", "confidence": "high", "type": "concept", "note": "While earthquakes are geological events, they were sometimes discussed in early modern texts in relation to their perceived physical or even 'unnatural' causes, sometimes grouped loosely with phenomena that could affect health or the environment, hence the 'disease' categorization in the prompt's format.", "wikidata_id": "Q7944", "wikidata_description": "result of a sudden release of energy in the Earth's crust that creates seismic waves", "wikipedia_url": "https://en.wikipedia.org/wiki/Earthquake", "modern_term": "Earthquake", "wikipedia_extract": "An earthquake, also called a quake, tremor, or temblor, is the shaking of the Earth's surface resulting from a sudden release of energy in the lithosphere that creates seismic waves. Earthquakes can range in intensity, from those so weak they cannot be felt, to those violent enough to propel objects and people into the air, damage critical infrastructure, and wreak destruction across entire cities. The seismic activity of an area is the frequency, type, and size of earthquakes experienced over a particular time. The seismicity at a particular location in the Earth is the average rate of seismic energy release per unit volume. In its most general sense, the word earthquake is used to describe any seismic event that generates seismic waves. Earthquakes can occur naturally or be induced by human activities, such as mining, fracking, and nuclear weapons testing."}}, {"canonical_name": "Seasons", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "seasons_of_the_year", "book_id": "kosmos_humboldt_1845", "name": "seasons of the year", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["seasons of the year"], "contexts": ["dependent on planetary axial position"]}, {"entity_id": "seasons", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Seasons", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["Seasons", "seasons"], "contexts": ["periods of the year with distinct weather", "periods of the year"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "seasons of the year", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Seasons", "similarity": 0.936}], "id": 3292, "stable_key": "clu_83d76fcb5332bb6f", "ground_truth": {"modern_name": "Season", "confidence": "high", "type": "concept", "note": "The contexts clearly indicate the divisions of the year and their relation to celestial mechanics and natural phenomena.", "wikidata_id": "Q27020041", "wikidata_description": "season of a sports league or competition, generally a specific one year period", "wikipedia_url": "https://en.wikipedia.org/wiki/Season%20%28sports%29", "wikipedia_extract": "In an organized sports league, a typical season is the portion of one year in which regulated games of the sport are in session: for example, in Major League Baseball the season lasts approximately from the last week of March to the last week of September. In other team sports, like association football or basketball, it is generally from August or September to May although in some countries \u2013 such as Northern Europe, North America or East Asia \u2013 the season for outdoor summer sports starts in the spring and finishes in autumn, mainly due to weather conditions encountered during the winter. A year can often be broken up into several distinct sections (sometimes themselves called seasons). These are: a preseason, usually a series of exhibition games played for training purposes; a regular season, the main period of the league's competition; the postseason, a playoff tournament played against the league's top teams to determine the league's champion; and the offseason, the time when there is no official competition. In association football, many clubs tour and then play a series of exhibition games for training purposes. Specifically in Brazil, teams play in state championships before the start of the Brazilian League."}}, {"canonical_name": "Coma Berenices", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "comae_berenicis", "book_id": "kosmos_humboldt_1845", "name": "Comae Berenicis", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Comae Berenicis"], "contexts": ["region in the heavens"]}, {"entity_id": "coma_berenices", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Coma Berenices", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 6, "variants": ["Coma Berenices"], "contexts": ["constellation named after a queen", "constellation where nebul\u00e6 are abundant"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Comae Berenicis", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Coma Berenices", "similarity": 0.906}], "id": 3293, "stable_key": "clu_587d4d617fe03f90", "ground_truth": {"modern_name": "Coma Berenices", "confidence": "high", "type": "place", "country": "Unknown", "note": "This refers to the constellation.", "wikidata_id": "Q9285", "wikidata_description": "constellation in the northern celestial hemisphere"}}, {"canonical_name": "Solstices", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "solstices", "book_id": "kosmos_humboldt_1845", "name": "solstices", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["solstices"], "contexts": ["astronomical events"]}, {"entity_id": "solstices", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Solstices", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["Solstices", "solstices"], "contexts": ["extremes of sun's declination", "times of longest and shortest days"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "solstices", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Solstices", "similarity": 0.977}], "id": 3294, "stable_key": "clu_7b1db0f31484d0a2", "ground_truth": {"modern_name": "Solstice", "confidence": "high", "type": "concept", "wikidata_id": "Q109312907", "wikidata_description": "Spanish hardstyle musician and DJ"}}, {"canonical_name": "magnetic lines of force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "magnetic_lines", "book_id": "kosmos_humboldt_1845", "name": "magnetic lines", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["magnetic lines"], "contexts": ["lines representing magnetic field"]}, {"entity_id": "magnetic_lines_of_force", "book_id": "connexion_physical_sciences_somerville_1858", "name": "magnetic lines of force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["magnetic lines of force"], "contexts": ["direction of magnetic field", "continuous closed curves alike in shape, size, power"]}, {"entity_id": "magnetic_lines", "book_id": "connexion_physical_sciences_somerville_1858", "name": "magnetic lines", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["magnetic lines"], "contexts": ["charted by Gauss"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "magnetic lines", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic lines of force", "similarity": 0.891}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic lines", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic lines", "similarity": 1.0}], "id": 3295, "stable_key": "clu_69c184c1036260fa", "ground_truth": {"modern_name": "Magnetic field lines", "confidence": "high", "type": "concept", "wikidata_id": "Q611322", "wikidata_description": "Historical concept in electromagnetism"}}, {"canonical_name": "diameter", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "diameter", "book_id": "kosmos_humboldt_1845", "name": "diameter", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["diameter"], "contexts": ["measurement of celestial body size"]}, {"entity_id": "diameter", "book_id": "connexion_physical_sciences_somerville_1858", "name": "diameter", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["diameter"], "contexts": ["measurement of spheres", "straight line passing through the center"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "diameter", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "diameter", "similarity": 1.0}], "id": 3296, "stable_key": "clu_da1d21618a67f630", "ground_truth": {"modern_name": "Diameter", "confidence": "high", "type": "concept"}}, {"canonical_name": "agua de lengua de buey", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "agua_de_lengua_de_buey", "book_id": "historia_medicinal_monardes_1574", "name": "agua de lengua de buey", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 6, "variants": ["agua de lengua de buey", "agua de legua de buey", "agua de lengua de Buey"], "contexts": ["water of ox tongue", "water with ox tongue"]}, {"entity_id": "agua_de_linguade_vacca", "book_id": "polyanthea_medicinal", "name": "agua de linguade vacca", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["agua de linguade vacca"], "contexts": ["cow's tongue water for ointment"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "agua de lengua de buey", "target_book": "polyanthea_medicinal", "target_name": "agua de linguade vacca", "similarity": 0.891}], "id": 3297, "stable_key": "clu_53a86599d55f2fb0", "ground_truth": {"modern_name": "Water of Ox Tongue", "confidence": "high", "type": "substance", "description": "A medicinal preparation made with ox tongue.", "wikipedia_extract": "Redox potential (also known as oxidation / reduction potential, ORP, pe, ) is a measure of the tendency of a chemical species to acquire electrons from or lose electrons to an electrode and thereby be reduced or oxidised respectively. Redox potential is expressed in volts (V). Each species has its own intrinsic redox potential; for example, the more positive the reduction potential (reduction potential is more often used due to general formalism in electrochemistry), the greater the species' affinity for electrons and tendency to be reduced. In aqueous solutions, redox potential is a measure of the tendency of the solution to either gain or lose electrons in a reaction. A solution with a higher (more positive) reduction potential than some other molecule will have a tendency to gain electrons from this molecule (i.e. to be reduced by oxidizing this other molecule) and a solution with a lower (more negative) reduction potential will have a tendency to lose electrons to other substances (i.e. to be oxidized by reducing the other substance). Because the absolute potentials are next to impossible to accurately measure, reduction potentials are defined relative to a reference electrode."}}, {"canonical_name": "Alberto Magno", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "alberto_magno", "book_id": "historia_medicinal_monardes_1574", "name": "Alberto magno", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Alberto magno", "Albert\u00f3 magno"], "contexts": ["medieval scholar on treasures", "authority on metals"]}, {"entity_id": "alberto_magno", "book_id": "coloquios_da_orta_1563", "name": "Alberto Magno", "category": "PERSON", "subcategory": "AUTHORITY", "count": 4, "variants": ["Alberto Magno"], "contexts": ["medieval philosopher and theologian, Albertus Magnus", "medieval scholar"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Alberto magno", "target_book": "coloquios_da_orta_1563", "target_name": "Alberto Magno", "similarity": 0.967}], "id": 3298, "stable_key": "clu_642c994b615164d7", "ground_truth": {"modern_name": "Albertus Magnus", "confidence": "high", "type": "person", "birth_year": 1200, "death_year": 1280, "description": "Medieval philosopher, theologian, and prolific writer on natural philosophy.", "wikidata_id": "Q60059", "wikidata_description": "German-Dominican friar and saint (c. 1200\u20131280)"}}, {"canonical_name": "malicia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "malicia", "book_id": "historia_medicinal_monardes_1574", "name": "malicia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["malicia"], "contexts": ["quality of being harmful or evil", "malice of poison"]}, {"entity_id": "malicia", "book_id": "polyanthea_medicinal", "name": "malicia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["malicia"], "contexts": ["negative judgment of actions", "malice, referring to disease"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "malicia", "target_book": "polyanthea_medicinal", "target_name": "malicia", "similarity": 1.0}], "id": 3299, "stable_key": "clu_03d47c7ffbfe2c35", "ground_truth": {"modern_name": "Malice", "confidence": "high", "type": "concept", "description": "The quality of being harmful, evil, or malevolent.", "note": "Can refer to intent, poison, or disease.", "wikipedia_extract": "Capoeira (Portuguese pronunciation: [kapu\u02c8e(j)\u027e\u0250]) is an Afro-Brazilian martial art and game that includes elements of dance, acrobatics, music, and spirituality. It includes acrobatic and complex manoeuvres, often involving hands on the ground and inverted kicks. It emphasizes flowing movements rather than fixed stances; the ginga, a rocking step, is usually the focal point of the technique. Though often said to be a martial art disguised as a dance, capoeira also serves as a way to maintain spirituality and culture. Capoeira has been practiced among Black Brazilians for centuries. The date of its creation is unknown, but it was first mentioned in a judicial document under the name Capoeiragem in 1789, as \"the gravest of crimes\"."}}, {"canonical_name": "falitre", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "falitre", "book_id": "historia_medicinal_monardes_1574", "name": "falitre", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["falitre"], "contexts": ["substance with cold virtue"]}, {"entity_id": "falitre", "book_id": "polyanthea_medicinal", "name": "falitre", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 6, "variants": ["falitre"], "contexts": ["saltpeter, dissolved in water with oil", "saltpeter, a medicinal ingredient"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "falitre", "target_book": "polyanthea_medicinal", "target_name": "falitre", "similarity": 0.757}], "id": 3300, "stable_key": "clu_e9edfb855c12c045-2", "ground_truth": {"modern_name": "Saltpeter", "confidence": "high", "type": "mineral", "wikidata_id": "Q11183742", "wikidata_description": "mineral form of potassium nitrate", "wikipedia_url": "https://en.wikipedia.org/wiki/Niter", "wikipedia_extract": "Niter or nitre is the mineral form of potassium nitrate, KNO3. It is a soft, white, highly soluble mineral found primarily in arid climates or cave deposits. Potassium and other nitrates are of great importance for use in fertilizers and, historically, gunpowder. Much of the world's demand is now met by synthetically produced nitrates, though the natural mineral is still mined and is still of significant commercial value. Historically, the term niter was not well differentiated from natron, both of which have been very vaguely defined but generally refer to compounds of sodium or potassium combined with carbonate or nitrate ions. Niter is a colorless to white mineral crystallizing in the orthorhombic crystal system.", "note": "The spelling 'falitre' is an archaic Portuguese form of saltpeter."}}, {"canonical_name": "croco indiaco", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "croco_indiaco", "book_id": "coloquios_da_orta_1563", "name": "croco indiaco", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["croco indiaco", "CROCO INDIACO", "Croco Indiaco", "croco indiano"], "contexts": ["substance discussed", "Orta's name for Curcuma longa rhizome"]}, {"entity_id": "croco", "book_id": "polyanthea_medicinal", "name": "croco", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["croco"], "contexts": ["ingredient in preparation"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "croco indiaco", "target_book": "polyanthea_medicinal", "target_name": "croco", "similarity": 0.891}], "id": 3301, "stable_key": "clu_602934df4832c9b1", "ground_truth": {"modern_name": "Turmeric", "confidence": "high", "type": "plant", "linnaean": "Curcuma longa", "family": "Zingiberaceae", "description": "A spice derived from a rhizome, used in medicine and as a dye.", "note": "Also known as 'croco indiaco' in the text.", "wikipedia_extract": "Turmeric (), or Curcuma longa (), is a flowering plant in the ginger family Zingiberaceae. It is a perennial, rhizomatous, herbaceous plant native to the Indian subcontinent and Southeast Asia that requires temperatures between 20 and 30 \u00b0C (68 and 86 \u00b0F) and high annual rainfall to thrive. Plants are gathered each year for their rhizomes, some for propagation in the following season and some for consumption or dyeing. The rhizomes can be used fresh, but they are often boiled in water and dried, after which they are ground into a deep orange-yellow shelf-stable spice powder commonly used as a coloring and flavoring agent in many Asian cuisines, especially for curries (curry powder). Turmeric powder has a warm, bitter, black pepper-like flavor and earthy, mustard-like aroma. Although long used in Ayurvedic medicine, there is no high-quality clinical evidence that consuming turmeric or the principal turmeric constituent, curcumin, is effective for treating any disease."}}, {"canonical_name": "citrinos", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "citrinos", "book_id": "coloquios_da_orta_1563", "name": "citrinos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["citrinos"], "contexts": ["type of fruit", "from the same tree as quebulas"]}, {"entity_id": "citrinos", "book_id": "polyanthea_medicinal", "name": "citrinos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["citrinos"], "contexts": ["citrus fruits, used for their peels"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "citrinos", "target_book": "polyanthea_medicinal", "target_name": "citrinos", "similarity": 1.0}], "id": 3302, "stable_key": "clu_72ae665ca19ec27e", "ground_truth": {"modern_name": "Citrus", "confidence": "high", "type": "plant", "linnaean": "Citrus", "family": "Rutaceae", "note": "The term 'citrinos' in early modern Portuguese refers to citrus fruits in general, not a specific species.", "wikidata_id": "Q81513", "wikidata_description": "genus of fruit-bearing plants (source of fruit such as lemons and oranges)", "wikipedia_url": "https://en.wikipedia.org/wiki/Citrus", "wikipedia_extract": "Citrus is a genus of flowering trees and shrubs in the family Rutaceae. Plants in the genus produce citrus fruits, such as citrons, mandarins, and pomelos. Many important citrus crops have been developed through extensive hybridization, including oranges, lemons, grapefruits, and limes, all of which have many cultivars. Citrus is native to South Asia, East Asia, Southeast Asia, Melanesia, and Australia. Indigenous people in these areas have used and domesticated various species since ancient times. Its cultivation first spread into Micronesia and Polynesia through the Austronesian expansion (c."}}, {"canonical_name": "junco odorato", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "junco_odorato", "book_id": "coloquios_da_orta_1563", "name": "junco odorato", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["junco odorato", "junco arom\u00e1tico"], "contexts": ["fragrant rush", "description of a fruit's appearance"]}, {"entity_id": "giunco_odorato", "book_id": "ricettario_fiorentino_1597", "name": "Giunco odorato", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["giunco odorato", "Giunco odorato"], "contexts": ["fragrant rush", "plant product used in preparations"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "junco odorato", "target_book": "ricettario_fiorentino_1597", "target_name": "Giunco odorato", "similarity": 0.933}], "id": 3303, "stable_key": "clu_c5fa780c1d96df6e", "ground_truth": {"modern_name": "Fragrant rush", "confidence": "high", "type": "plant", "description": "A fragrant rush plant, often used in herbal preparations.", "wikipedia_extract": "This article lists plants referenced in the Bible, ordered alphabetically by English common/colloquial name. For plants whose identities are unconfirmed or debated the most probable species is listed first. Plants named in the Old Testament (Hebrew Bible or Tenakh) are given with their Hebrew name, while those mentioned in the New Testament are given with their Greek names. Hepper, F. Nigel (2000). Planting a Bible Garden (illustrated ed.)."}}, {"canonical_name": "ameos", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "ameos", "book_id": "coloquios_da_orta_1563", "name": "ameos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["ameos"], "contexts": ["rustic cumin, mixed with calamus", "herb, ingredient in Arata"]}, {"entity_id": "ameos", "book_id": "polyanthea_medicinal", "name": "Ameos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["ameos", "Ameos"], "contexts": ["ingredient in a remedy", "a plant, possibly related to elm"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "ameos", "target_book": "polyanthea_medicinal", "target_name": "Ameos", "similarity": 0.817}], "id": 3304, "stable_key": "clu_2d02fa171cdc7f37", "ground_truth": {"modern_name": "Ammi visnaga", "confidence": "high", "type": "plant", "linnaean": "Ammi visnaga", "family": "Apiaceae", "note": "The context 'rustic cumin' points to Apiaceae family members. Ammi visnaga is a strong candidate.", "wikidata_id": "Q866203", "wikidata_description": "species of plant"}}, {"canonical_name": "Frederico II", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "frederico_ii", "book_id": "coloquios_da_orta_1563", "name": "Frederico II", "category": "PERSON", "subcategory": "PATRON", "count": 4, "variants": ["Frederico II", "Felipe II"], "contexts": ["emperor who reigned 1220-1240", "identified as Imperador"]}, {"entity_id": "frederico_i", "book_id": "polyanthea_medicinal", "name": "Frederico I", "category": "PERSON", "subcategory": "PATRON", "count": 3, "variants": ["Frederico I"], "contexts": ["Duke of Bavaria", "Prince Federico"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Frederico II", "target_book": "polyanthea_medicinal", "target_name": "Frederico I", "similarity": 0.882}], "id": 3305, "stable_key": "clu_51ca8fa38ad3ee3a", "ground_truth": {"modern_name": "Frederick II, Holy Roman Emperor", "confidence": "high", "type": "person", "birth_year": 1194, "death_year": 1250, "description": "Holy Roman Emperor and King of Sicily, patron of arts and sciences.", "note": "The date range 1220-1240 clearly indicates Frederick II. The 'Duke of Bavaria' mention is likely a confusion with other Fredericks."}}, {"canonical_name": "mo\u00e7o", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "mo\u00e7o", "book_id": "coloquios_da_orta_1563", "name": "mo\u00e7o", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 4, "variants": ["mo\u00e7o", "MO\u00c7O", "Mo\u00e7a"], "contexts": ["interlocutor in dialogue", "boy who brought a branch"]}, {"entity_id": "mo\u00e7a", "book_id": "polyanthea_medicinal", "name": "mo\u00e7a", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["mo\u00e7a", "mo\u00e7a nobre"], "contexts": ["young woman, patient description", "young woman, treated for baldness"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "mo\u00e7o", "target_book": "polyanthea_medicinal", "target_name": "mo\u00e7a", "similarity": 0.918}], "id": 3306, "stable_key": "clu_759b8d22bdbc94b6", "ground_truth": {"modern_name": "youth", "confidence": "high", "type": "concept", "note": "The terms 'mo\u00e7o' and 'mo\u00e7a' in Portuguese refer to a young male or female, often used in a general sense of youth or as an interlocutor in a dialogue."}}, {"canonical_name": "Rhod.", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "roxb_", "book_id": "coloquios_da_orta_1563", "name": "Roxb.", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Roxb."], "contexts": ["author of Flora Indica", "botanist who used Alpinia Cardamomum"]}, {"entity_id": "rhod_", "book_id": "polyanthea_medicinal", "name": "Rhod.", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Rhod.", "Rhod", "Rhud."], "contexts": ["medical authority", "early modern scholar"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Roxb.", "target_book": "polyanthea_medicinal", "target_name": "Rhod.", "similarity": 0.873}], "id": 3307, "stable_key": "clu_2e7e85528f4d8d30", "ground_truth": {"modern_name": "William Roxburgh", "confidence": "high", "type": "person", "birth_year": 1751, "death_year": 1815, "description": "Scottish botanist and surgeon, author of 'Flora Indica'.", "note": "The abbreviation 'Rhod.' is very likely a misspelling or archaic rendering of 'Roxb.', referring to William Roxburgh, given the context of 'Flora Indica' and botanical works.", "wikidata_id": "Q748967", "wikidata_description": "British surgeon and botanist (1751\u20131815)", "wikipedia_url": "https://en.wikipedia.org/wiki/William%20Roxburgh"}}, {"canonical_name": "S. Francisco Xavier", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "s__francisco_xavier", "book_id": "coloquios_da_orta_1563", "name": "S. Francisco Xavier", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["S. Francisco Xavier"], "contexts": ["apostle of the Indies", "apostle of the coast of Pescaria"]}, {"entity_id": "francifco_xavier", "book_id": "polyanthea_medicinal", "name": "Francifco Xavier", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Francifco Xavier"], "contexts": ["servant of Dom Jo\u017feph de Menezes", "son of Domingos Henriques"]}, {"entity_id": "franci\u017fco_xavier", "book_id": "polyanthea_medicinal", "name": "Franci\u017fco Xavier", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Franci\u017fco Xavier"], "contexts": ["son of Domingos Henriques", "patient with persistent hiccups"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "S. Francisco Xavier", "target_book": "polyanthea_medicinal", "target_name": "Francifco Xavier", "similarity": 0.922}, {"source_book": "coloquios_da_orta_1563", "source_name": "S. Francisco Xavier", "target_book": "polyanthea_medicinal", "target_name": "Franci\u017fco Xavier", "similarity": 0.94}], "id": 3308, "stable_key": "clu_b097a08aff49b73e", "ground_truth": {"modern_name": "Francis Xavier", "confidence": "high", "type": "person", "birth_year": 1506, "death_year": 1552, "description": "Jesuit missionary, saint, apostle of the Indies", "wikidata_id": "Q163900", "wikidata_description": "Spanish Catholic saint and missionary (1506\u20131552)"}}, {"canonical_name": "lentilhas", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "lentilhas_de_agoa", "book_id": "coloquios_da_orta_1563", "name": "lentilhas de agoa", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["lentilhas de agoa", "lentilha de agoa"], "contexts": ["plants that grow on water", "aquatic plant"]}, {"entity_id": "lentilhas", "book_id": "polyanthea_medicinal", "name": "lentilhas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["lentilhas", "Lentilhas"], "contexts": ["ingredient for mouthwash", "lentils used in a remedy"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "lentilhas de agoa", "target_book": "polyanthea_medicinal", "target_name": "lentilhas", "similarity": 0.899}], "id": 3309, "stable_key": "clu_3e3c4215bc48f02c", "ground_truth": {"modern_name": "Lentil", "confidence": "medium", "type": "plant", "linnaean": "Lens culinaris", "family": "Fabaceae", "description": "A herbaceous annual legume plant grown for its edible seed.", "note": "Includes related terms for aquatic plants and similar-leafed plants, suggesting broader botanical interest.", "wikipedia_extract": "The lentil (Vicia lens or Lens culinaris) is an annual legume grown for its lens-shaped edible seeds or pulses, also called lentils. It is about 40 cm (16 in) tall, and the seeds grow in pods, usually with two seeds in each. Lentil seeds are used around the world for culinary purposes, most commonly in stews or soups. In cuisines of the Indian subcontinent, where lentils are a staple, split lentils (often with their hulls removed) known as dal are often cooked into a thick curry that is usually eaten with rice or roti. The English word \"lentil\" ultimately derives from the Latin lens ('lentil'). The Latin word is of classical Roman or Latin origin and may be the source of the prominent Roman family name Lentulus, just as the family name \"Cicero\" was derived from the chickpea, Cicer arietinum, and \"Fabia\" (as in Quintus Fabius Maximus) from the fava bean (Vicia faba)."}}, {"canonical_name": "Elvas", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "elvas", "book_id": "coloquios_da_orta_1563", "name": "Elvas", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Elvas"], "contexts": ["Location of commissioners' meeting", "city where commissioners met"]}, {"entity_id": "elvas", "book_id": "polyanthea_medicinal", "name": "Elvas", "category": "PLACE", "subcategory": "CITY", "count": 5, "variants": ["Elvas"], "contexts": ["city in Portugal", "city where the bishop is from"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Elvas", "target_book": "polyanthea_medicinal", "target_name": "Elvas", "similarity": 1.0}], "id": 3310, "stable_key": "clu_096283220888bb7a", "ground_truth": {"modern_name": "Elvas", "confidence": "high", "type": "place", "description": "A city in the Alentejo region of Portugal.", "wikipedia_extract": "Elvas (Portuguese pronunciation: [\u02c8\u025blv\u0250\u0283] ), officially the City of Elvas (Portuguese: Cidade de Elvas), is a Portuguese municipality, former episcopal city and frontier fortress of easternmost central Portugal, located in the district of Portalegre in Alentejo. It is situated about 200 kilometres (120 mi) east of Lisbon, and about 8 kilometres (5.0 mi) west of the Spanish fortress of Badajoz, by the Madrid-Badajoz-Lisbon railway. The municipality population as of 2011 was 23,078, in an area of 631.29 square kilometres (243.74 sq mi). The city itself had a population of 16,640 as of 2011. Elvas is among the finest examples of intensive usage of the trace italienne (star fort) in military architecture, and has been a World Heritage Site since 30 June 2012. The inscribed site name is Garrison Border Town of Elvas and its Fortifications."}}, {"canonical_name": "Ammi", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "ammi", "book_id": "coloquios_da_orta_1563", "name": "Ammi", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Ammi"], "contexts": ["possible genus for ameos", "species of plant"]}, {"entity_id": "ammi", "book_id": "ricettario_fiorentino_1597", "name": "Ammi", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["Ammi", "AMMh"], "contexts": ["plant from Alexandria, Candia, or Tuscany", "seed used in preparations"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Ammi", "target_book": "ricettario_fiorentino_1597", "target_name": "Ammi", "similarity": 1.0}], "id": 3311, "stable_key": "clu_2d02fa171cdc7f37-2", "ground_truth": {"modern_name": "Ammi visnaga", "confidence": "high", "type": "plant", "linnaean": "Ammi visnaga", "family": "Apiaceae", "note": "The context 'rustic cumin' points to Apiaceae family members. Ammi visnaga is a strong candidate.", "wikidata_id": "Q866203", "wikidata_description": "species of plant"}}, {"canonical_name": "Bode", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "bode", "book_id": "coloquios_da_orta_1563", "name": "bode", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["bode"], "contexts": ["goat where the stone is found", "animal from which bezoar stone is created"]}, {"entity_id": "bode", "book_id": "polyanthea_medicinal", "name": "Bode", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 5, "variants": ["Bode", "bode", "bove"], "contexts": ["goat", "animal used for remedy"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "bode", "target_book": "polyanthea_medicinal", "target_name": "Bode", "similarity": 0.917}], "id": 3312, "stable_key": "clu_3329782a3e39bd73-2", "ground_truth": {"modern_name": "Goat", "confidence": "high", "type": "animal", "wikidata_id": "Q45320358", "wikidata_description": "species of mammal", "description": "An animal, specifically a goat, from which the bezoar stone was historically derived.", "wikipedia_extract": "The goat or domestic goat (Capra hircus) is a species of goat-antelope that is mostly kept as livestock. It was domesticated from the wild goat (C. aegagrus) of Southwest Asia and Eastern Europe. The goat is a member of the family Bovidae, meaning it is closely related to the sheep. It was one of the first animals to be domesticated, in Iran around 10,000 years ago. Goats have been used for milk, meat, wool, and skins across much of the world. Milk from goats is often turned into cheese."}}, {"canonical_name": "Hera", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "hera", "book_id": "coloquios_da_orta_1563", "name": "Hera", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Hera"], "contexts": ["plant with creeping growth", "plant mentioned as an example"]}, {"entity_id": "hera", "book_id": "polyanthea_medicinal", "name": "Hera", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["Hera", "hera"], "contexts": ["plant used in water for drinking", "leaves used for heating feet"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Hera", "target_book": "polyanthea_medicinal", "target_name": "Hera", "similarity": 1.0}], "id": 3313, "stable_key": "clu_efba16c6ad2a16ae", "ground_truth": {"modern_name": "Hera", "confidence": "low", "type": "plant", "description": "A plant used medicinally, possibly for foot baths and drinking water.", "note": "The context suggests a common herb, but 'Hera' is not a recognized common name for a specific plant in this context. It might be a misspelling or a regional name.", "wikipedia_extract": "In ancient Greek religion, Hera (; Ancient Greek: \u1f2d\u03c1\u03b1, romanized: H\u1e17r\u0101; \u1f2d\u03c1\u03b7, H\u1e17r\u0113 in Ionic and Homeric Greek) is the goddess of marriage, women, and family, and the protector of women during childbirth. In Greek mythology, she is queen of the twelve Olympians and Mount Olympus, sister and wife of Zeus, and daughter of the Titans Cronus and Rhea. One of her defining characteristics in myth is her jealous and vengeful nature in dealing with any who offended her, especially Zeus's numerous adulterous lovers and illegitimate offspring. Her iconography usually presents her as a dignified, matronly figure, upright or enthroned, crowned with a polos or diadem, sometimes veiled as a married woman. She is the patron goddess of lawful marriage. She presides over weddings, blesses and legalises marital unions, and protects women from harm during childbirth."}}, {"canonical_name": "ferula", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "ferula", "book_id": "coloquios_da_orta_1563", "name": "ferula", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["ferula"], "contexts": ["plant name, possibly fennel", "plant with similar leaf"]}, {"entity_id": "ferula", "book_id": "ricettario_fiorentino_1597", "name": "ferula", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["ferula"], "contexts": ["plant similar to Euphorbium", "plant from which Galbanum is derived"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "ferula", "target_book": "ricettario_fiorentino_1597", "target_name": "ferula", "similarity": 1.0}], "id": 3314, "stable_key": "clu_a8898920d90ca209", "ground_truth": {"modern_name": "Fennel", "confidence": "medium", "type": "plant", "linnaean": "Foeniculum vulgare", "family": "Apiaceae", "note": "While 'ferula' can refer to the genus Ferula, in early modern texts, it was often used more broadly and could also refer to plants like fennel, especially when compared to Euphorbium. The context 'plant similar to Euphorbium' suggests a strong, possibly acrid sap, which could apply to Ferula or other plants."}}, {"canonical_name": "mantimento", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "mantimentos", "book_id": "coloquios_da_orta_1563", "name": "mantimentos", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["mantimentos"], "contexts": ["provisions on the ship"]}, {"entity_id": "mantimento", "book_id": "polyanthea_medicinal", "name": "mantimento", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 6, "variants": ["mantimento", "mantimentos"], "contexts": ["food", "food, sustenance"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "mantimentos", "target_book": "polyanthea_medicinal", "target_name": "mantimento", "similarity": 0.976}], "id": 3315, "stable_key": "clu_6c26bac126d1a63a", "ground_truth": {"modern_name": "Food", "confidence": "high", "type": "substance", "description": "Sustenance for humans and provisions for voyages.", "wikipedia_extract": "Food is any substance consumed by an organism for nutritional support. Food usually consists of plant, animal, or fungal origin and contains essential nutrients such as carbohydrates, fats, proteins, vitamins, or minerals. The substance is ingested by an organism and assimilated by the organism's cells to provide energy, maintain life, or support growth. Different species of animals have different feeding behaviours that satisfy the needs of their metabolisms and have evolved to fill specific ecological niches within specific geographical contexts. Omnivorous humans are highly adaptable and have adapted to obtaining food in many different ecosystems. Humans generally use cooking to prepare food for consumption."}}, {"canonical_name": "filhos", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "f\u00edlhos", "book_id": "coloquios_da_orta_1563", "name": "f\u00edlhos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["f\u00edlhos"], "contexts": ["children of the king"]}, {"entity_id": "filho", "book_id": "coloquios_da_orta_1563", "name": "filho", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["filho"], "contexts": ["male offspring"]}, {"entity_id": "filhos", "book_id": "polyanthea_medicinal", "name": "filhos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 5, "variants": ["filhos", "filha", "filho"], "contexts": ["offspring, children", "children"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "f\u00edlhos", "target_book": "polyanthea_medicinal", "target_name": "filhos", "similarity": 0.517}, {"source_book": "coloquios_da_orta_1563", "source_name": "filho", "target_book": "polyanthea_medicinal", "target_name": "filhos", "similarity": 0.888}], "id": 3316, "stable_key": "clu_693438570b9312f3", "ground_truth": {"modern_name": "Children", "confidence": "high", "type": "concept", "wikidata_id": "Q239526", "wikidata_description": "in biology, the product of reproduction of an organism"}}, {"canonical_name": "indigest\u00f5es", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "indigist\u00f5es_do_est\u00f4mago", "book_id": "coloquios_da_orta_1563", "name": "indigist\u00f5es do est\u00f4mago", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["indigist\u00f5es do est\u00f4mago"], "contexts": ["stomach indigestion"]}, {"entity_id": "indigest\u00f5es", "book_id": "polyanthea_medicinal", "name": "indigest\u00f5es", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 6, "variants": ["indigest\u00f5es", "indigetto", "indige\u017ftas"], "contexts": ["cause of diarrhea", "difficulty in digesting food"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "indigist\u00f5es do est\u00f4mago", "target_book": "polyanthea_medicinal", "target_name": "indigest\u00f5es", "similarity": 0.896}], "id": 3317, "stable_key": "clu_1287d81619ac1a29", "ground_truth": {"modern_name": "indigestion", "confidence": "high", "type": "disease", "modern_term": "indigestion"}}, {"canonical_name": "Amianto", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "pietra_amianto", "book_id": "ricettario_fiorentino_1597", "name": "pietra Amianto", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["pietra Amianto"], "contexts": ["substance used to adulterate alum"]}, {"entity_id": "amianto", "book_id": "polyanthea_medicinal", "name": "Amianto", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 6, "variants": ["Amianto", "Amia", "Amianthus"], "contexts": ["stone that makes fire-resistant cloth", "Mineral substance, also called Alumenplumosum"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "pietra Amianto", "target_book": "polyanthea_medicinal", "target_name": "Amianto", "similarity": 0.939}], "id": 3318, "stable_key": "clu_936a1d1332249f60", "ground_truth": {"modern_name": "asbestos", "confidence": "high", "type": "mineral", "wikidata_id": "Q104085", "wikidata_description": "group of highly stable, non-flammable silicate minerals with a fibrous structure"}}, {"canonical_name": "cohesive force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "cohesive_force", "book_id": "connexion_physical_sciences_somerville_1858", "name": "cohesive force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["cohesive force"], "contexts": ["force uniting particles of matter", "force uniting molecules of substances"]}, {"entity_id": "cohesive_force", "book_id": "first_principles_spencer_1862", "name": "cohesive force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["cohesive force"], "contexts": ["force holding matter together"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "cohesive force", "target_book": "first_principles_spencer_1862", "target_name": "cohesive force", "similarity": 1.0}], "id": 3319, "stable_key": "clu_8b996afab5768fed", "ground_truth": {"modern_name": "Cohesive force", "confidence": "high", "type": "concept"}}, {"canonical_name": "lens", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "lens", "book_id": "connexion_physical_sciences_somerville_1858", "name": "lens", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 6, "variants": ["lens"], "contexts": ["optical device for focusing light", "device to focus heat"]}, {"entity_id": "lense", "book_id": "first_principles_spencer_1862", "name": "lense", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["lense"], "contexts": ["instrument for magnifying small details"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "lens", "target_book": "first_principles_spencer_1862", "target_name": "lense", "similarity": 0.989}], "id": 3320, "stable_key": "clu_39b797d4612296e6", "ground_truth": {"modern_name": "lens", "confidence": "high", "type": "object", "wikidata_id": "Q148983", "wikidata_description": "genus of plants", "wikipedia_extract": "A lens is a transmissive optical device that focuses or disperses a light beam by means of refraction. A simple lens consists of a single piece of transparent material, while a compound lens consists of several simple lenses (elements), usually arranged along a common axis. Lenses are made from materials such as glass or plastic and are ground, polished, or molded to the required shape. A lens can focus light to form an image, unlike a prism, which refracts light without focusing. Devices that similarly focus or disperse waves and radiation other than visible light are also called \"lenses\", such as microwave lenses, electron lenses, acoustic lenses, or explosive lenses. Lenses are used in various imaging devices such as telescopes, binoculars, and cameras.", "wikipedia_url": "https://en.wikipedia.org/wiki/Lens_%28plant%29"}}, {"canonical_name": "Polarity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "polarity", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Polarity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["Polarity", "polarity"], "contexts": ["Polarity", "distinguishing character of magnetism"]}, {"entity_id": "mutual_polarity", "book_id": "first_principles_spencer_1862", "name": "mutual polarity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mutual polarity"], "contexts": ["force between units"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Polarity", "target_book": "first_principles_spencer_1862", "target_name": "mutual polarity", "similarity": 0.881}], "id": 3321, "stable_key": "clu_ce2a504988ba3984-2", "ground_truth": {"modern_name": "polarity", "confidence": "high", "type": "concept", "note": "Refers to forces or properties exhibiting opposing characteristics, often related to magnetism or philosophical dualities.", "wikidata_id": "Q2101088", "wikidata_description": "board game that requires strategic thinking and dexterity to control hovering magnetic discs", "wikipedia_url": "https://en.wikipedia.org/wiki/Polarity%20%28game%29", "wikipedia_extract": "Polarity is a board game that requires strategic thinking and dexterity to control hovering magnetic discs. Polarity was invented in 1985 by Canadian artist and designer Douglas Seaton. It was first published in 1986. The game has had a tumultuous past, with production changing hands several times over the past four decades. The game has been published by Telemotion Technologies, Irwin Toy, briefly with Mattel and most recently by Temple Games. The game ships in a canvas sleeve and include the magnets, the board, and a paper rulebook."}}, {"canonical_name": "chemical force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "chemical_force", "book_id": "connexion_physical_sciences_somerville_1858", "name": "chemical force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["chemical force", "Chemical force"], "contexts": ["powerful force of attraction in chemistry", "force from chemical reactions"]}, {"entity_id": "chemical_forces", "book_id": "first_principles_spencer_1862", "name": "chemical forces", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["chemical forces"], "contexts": ["forces governing chemical reactions", "forces causing material changes"]}, {"entity_id": "chemical_force", "book_id": "first_principles_spencer_1862", "name": "chemical force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["chemical force"], "contexts": ["force governing chemical reactions"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "chemical force", "target_book": "first_principles_spencer_1862", "target_name": "chemical forces", "similarity": 0.947}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "chemical force", "target_book": "first_principles_spencer_1862", "target_name": "chemical force", "similarity": 1.0}], "id": 3322, "stable_key": "clu_e161157ac754691c", "ground_truth": {"modern_name": "Chemical force", "confidence": "high", "type": "concept", "wikidata_id": "Q56639784", "wikidata_description": "article by Aleksandr Noy et al published August 1995 in Journal of the American Chemical Society"}}, {"canonical_name": "George Stephenson", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "george_stephenson", "book_id": "connexion_physical_sciences_somerville_1858", "name": "George Stephenson", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["George Stephenson"], "contexts": ["observed restoration of sun's light and heat", "influential figure in human affairs"]}, {"entity_id": "stephenson,_george", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Stephenson, George", "category": "PERSON", "subcategory": "SCHOLAR", 