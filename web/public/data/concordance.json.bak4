SON", "subcategory": "SCHOLAR", "count": 2, "variants": ["BACON", "Bacon"], "contexts": ["quote about studying natural phenomena", "philosopher who made conjectures"]}, {"entity_id": "bacon", "book_id": "first_principles_spencer_1862", "name": "Bacon", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Bacon"], "contexts": ["Renaissance philosopher and scientist"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "Bacon", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Bacon", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Bacon", "target_book": "polyanthea_medicinal", "target_name": "Bacon", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Bacon", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bacon", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Bacon", "target_book": "first_principles_spencer_1862", "target_name": "Bacon", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bacon", "target_book": "polyanthea_medicinal", "target_name": "Bacon", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bacon", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bacon", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bacon", "target_book": "first_principles_spencer_1862", "target_name": "Bacon", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "Bacon", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bacon", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "Bacon", "target_book": "first_principles_spencer_1862", "target_name": "Bacon", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Bacon", "target_book": "first_principles_spencer_1862", "target_name": "Bacon", "similarity": 1.0}], "id": 190, "stable_key": "clu_199b99a4a8765014", "ground_truth": {"modern_name": "Francis Bacon", "confidence": "high", "type": "person", "birth_year": 1561, "death_year": 1626, "description": "Philosopher, statesman, scientist, lawyer, jurist, author and orator", "wikidata_id": "Q37388", "wikidata_description": "English philosopher and statesman (1561\u20131626)", "wikipedia_url": "https://en.wikipedia.org/wiki/Francis%20Bacon", "wikipedia_extract": "Francis Bacon, 1st Viscount St Alban  (; 22 January 1561 \u2013 9 April 1626) was an English philosopher and statesman who served as Attorney General and Lord Chancellor of England under King James I. Bacon argued for the importance of natural philosophy, guided by the scientific method, and his works remained influential throughout the Scientific Revolution. Bacon has been called the father of empiricism. He argued for the possibility of scientific knowledge based only upon inductive reasoning and careful observation of events in nature. He believed that science could be achieved by the use of a sceptical and methodical approach whereby scientists aim to avoid misleading themselves. Although his most specific proposals about such a method, the Baconian method, did not have long-lasting influence, the general idea of the importance and possibility of a sceptical methodology makes Bacon one of the founders of the scientific method."}}, {"canonical_name": "Darwin", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 5, "total_mentions": 20, "members": [{"entity_id": "darwin", "book_id": "medecine_experimentale_bernard_1865", "name": "Darwin", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Darwin"], "contexts": ["naturalist and evolution theorist"]}, {"entity_id": "darwin", "book_id": "origin_of_species_darwin_1859", "name": "Darwin", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Darwin"], "contexts": ["implied author of natural selection theory", "author of the passage"]}, {"entity_id": "darwin", "book_id": "principles_of_psychology_james_1890", "name": "Darwin", "category": "PERSON", "subcategory": "SCHOLAR", "count": 6, "variants": ["Darwin", "Mr. Darwin"], "contexts": ["author of 'Descent of Man'", "naturalist and evolution theorist"]}, {"entity_id": "darwin", "book_id": "kosmos_humboldt_1845", "name": "Darwin", "category": "PERSON", "subcategory": "SCHOLAR", "count": 10, "variants": ["Darwin"], "contexts": ["author of 'Volcanic Islands'", "author of geological papers"]}, {"entity_id": "darwin", "book_id": "coloquios_da_orta_1563", "name": "Darwin", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Darwin"], "contexts": ["precursors of Darwin"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "Darwin", "target_book": "origin_of_species_darwin_1859", "target_name": "Darwin", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Darwin", "target_book": "principles_of_psychology_james_1890", "target_name": "Darwin", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Darwin", "target_book": "kosmos_humboldt_1845", "target_name": "Darwin", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Darwin", "target_book": "coloquios_da_orta_1563", "target_name": "Darwin", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Darwin", "target_book": "principles_of_psychology_james_1890", "target_name": "Darwin", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Darwin", "target_book": "kosmos_humboldt_1845", "target_name": "Darwin", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Darwin", "target_book": "coloquios_da_orta_1563", "target_name": "Darwin", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Darwin", "target_book": "kosmos_humboldt_1845", "target_name": "Darwin", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Darwin", "target_book": "coloquios_da_orta_1563", "target_name": "Darwin", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Darwin", "target_book": "coloquios_da_orta_1563", "target_name": "Darwin", "similarity": 1.0}], "id": 191, "stable_key": "clu_12dc642a90f6e076", "ground_truth": {"modern_name": "Charles Darwin", "confidence": "high", "type": "person", "birth_year": 1809, "death_year": 1882, "description": "Naturalist, geologist, and biologist, famous for theory of evolution", "note": "While 'Darwin' is used, the contexts strongly point to Charles Darwin due to 'natural selection' and 'evolution'.", "wikidata_id": "Q1035", "wikidata_description": "English naturalist and biologist (1809\u20131882)", "wikipedia_url": "https://en.wikipedia.org/wiki/Charles%20Darwin", "wikipedia_extract": "Charles Robert Darwin ( DAR-win; 12 February 1809 \u2013 19 April 1882) was an English naturalist, geologist, and biologist, widely known for his contributions to evolutionary biology. His proposition that all species of life have descended from a common ancestor is now generally accepted and considered a fundamental scientific concept. In a joint presentation with Alfred Russel Wallace, he introduced his scientific theory that this branching pattern of evolution resulted from a process he called natural selection, in which the struggle for existence has a similar effect to the artificial selection involved in selective breeding. Darwin has been described as one of the most influential figures in human history and was honoured by burial in Westminster Abbey. Darwin's early interest in nature led him to neglect his medical education at the University of Edinburgh; instead, he helped Robert Edmond Grant to investigate marine invertebrates. His studies at the University of Cambridge's Christ's College from 1828 to 1831 encouraged his passion for natural science."}}, {"canonical_name": "Adam", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 5, "total_mentions": 20, "members": [{"entity_id": "adam", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Adam", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 11, "variants": ["Adam"], "contexts": ["first man, supposed wisest", "first man, received fruit"]}, {"entity_id": "adam", "book_id": "epoques_nature_buffon_1778", "name": "Adam", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Adam"], "contexts": ["first man in biblical tradition"]}, {"entity_id": "adam", "book_id": "english_physician_1652", "name": "Adam", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 5, "variants": ["Adam"], "contexts": ["biblical figure", "had infinite knowledge in innocence"]}, {"entity_id": "adam", "book_id": "principles_of_psychology_james_1890", "name": "Adam", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Adam"], "contexts": ["first man in religious narrative"]}, {"entity_id": "adam", "book_id": "coloquios_da_orta_1563", "name": "Adam", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Adam"], "contexts": ["figure associated with a mountain peak", "biblical figure"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Adam", "target_book": "epoques_nature_buffon_1778", "target_name": "Adam", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Adam", "target_book": "english_physician_1652", "target_name": "Adam", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Adam", "target_book": "principles_of_psychology_james_1890", "target_name": "Adam", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Adam", "target_book": "coloquios_da_orta_1563", "target_name": "Adam", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Adam", "target_book": "english_physician_1652", "target_name": "Adam", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Adam", "target_book": "principles_of_psychology_james_1890", "target_name": "Adam", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Adam", "target_book": "coloquios_da_orta_1563", "target_name": "Adam", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Adam", "target_book": "principles_of_psychology_james_1890", "target_name": "Adam", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Adam", "target_book": "coloquios_da_orta_1563", "target_name": "Adam", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Adam", "target_book": "coloquios_da_orta_1563", "target_name": "Adam", "similarity": 1.0}], "id": 192, "stable_key": "clu_049e971624ed6b55", "ground_truth": {"modern_name": "Adam", "confidence": "high", "type": "person", "description": "Biblical first man, figure in religious narratives.", "note": "This refers to the biblical figure, not a specific historical person with that name.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Adam", "wikipedia_extract": "Adam is the name given in Genesis 1\u20135 to the first human. Adam is the first human being aware of God, and features as such in various belief systems (including Judaism, Christianity, Gnosticism, Islam, and the Bah\u00e1\u02bc\u00ed Faith). According to Christianity, Adam sinned in the Garden of Eden by eating from the tree of the knowledge of good and evil. This action introduced death and sin into the world. This sinful nature infected all his descendants, and led humanity to be expelled from the Garden. Only through the crucifixion of Jesus, humanity can be redeemed."}}, {"canonical_name": "Italy", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 5, "total_mentions": 20, "members": [{"entity_id": "italy", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Italy", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Italy"], "contexts": ["country where misseltoe was sourced", "location of experiment"]}, {"entity_id": "italy", "book_id": "english_physician_1652", "name": "Italy", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Italy"], "contexts": ["country where Garden Rue is used against Plague", "native land of Turnsole"]}, {"entity_id": "italy", "book_id": "kosmos_humboldt_1845", "name": "Italy", "category": "PLACE", "subcategory": "COUNTRY", "count": 12, "variants": ["Italy"], "contexts": ["country visited", "country with bright nights in 1831"]}, {"entity_id": "italy", "book_id": "polyanthea_medicinal", "name": "Italy", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Italy"], "contexts": ["country of origin for some authors"]}, {"entity_id": "italy", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Italy", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Italy"], "contexts": ["local attraction affecting measurement"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Italy", "target_book": "english_physician_1652", "target_name": "Italy", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Italy", "target_book": "kosmos_humboldt_1845", "target_name": "Italy", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Italy", "target_book": "polyanthea_medicinal", "target_name": "Italy", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Italy", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Italy", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Italy", "target_book": "kosmos_humboldt_1845", "target_name": "Italy", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Italy", "target_book": "polyanthea_medicinal", "target_name": "Italy", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Italy", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Italy", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Italy", "target_book": "polyanthea_medicinal", "target_name": "Italy", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Italy", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Italy", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "Italy", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Italy", "similarity": 1.0}], "id": 193, "stable_key": "clu_0af750baac0f4da7-2", "ground_truth": {"modern_name": "Italy", "confidence": "high", "type": "place", "description": "European country associated with specific plants and historical references.", "wikipedia_extract": "Italy, officially the Italian Republic, is a country in Southern and Western Europe. It consists of a peninsula that extends into the Mediterranean Sea, with the Alps on its northern land border, as well as nearly 800 islands, notably Sicily and Sardinia. Italy shares land borders with France to the west; Switzerland and Austria to the north; Slovenia to the east; and the two enclaves of Vatican City and San Marino. It is the tenth-largest country in Europe by area, covering 301,340 km2 (116,350 sq mi), and the third-most populous member state of the European Union, with nearly 59 million inhabitants. Italy's capital and largest city is Rome; other major cities include Milan, Naples, Turin, Palermo, Bologna, Florence, Genoa, and Venice. The history of Italy goes back to numerous Italic peoples, notably including the ancient Romans, who conquered the Mediterranean world during the Roman Republic and ruled it for centuries during the Roman Empire."}}, {"canonical_name": "Jap\u00e3o", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 5, "total_mentions": 20, "members": [{"entity_id": "japon", "book_id": "epoques_nature_buffon_1778", "name": "Japon", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Japon"], "contexts": ["island country in East Asia", "island nation"]}, {"entity_id": "japan", "book_id": "origin_of_species_darwin_1859", "name": "Japan", "category": "PLACE", "subcategory": "COUNTRY", "count": 5, "variants": ["Japan"], "contexts": ["island nation", "sea area"]}, {"entity_id": "japon", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Japon", "category": "PLACE", "subcategory": "COUNTRY", "count": 4, "variants": ["Japon"], "contexts": ["country in Eastern Asia", "island nation east of Asia"]}, {"entity_id": "japan", "book_id": "kosmos_humboldt_1845", "name": "Japan", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Japan"], "contexts": ["country with flora studied"]}, {"entity_id": "jap\u00e3o", "book_id": "coloquios_da_orta_1563", "name": "Jap\u00e3o", "category": "PLACE", "subcategory": "COUNTRY", "count": 8, "variants": ["Jap\u00e3o", "Jap\u00e1o"], "contexts": ["market for import", "destination for camphor"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Japon", "target_book": "origin_of_species_darwin_1859", "target_name": "Japan", "similarity": 0.988}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Japon", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Japon", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Japon", "target_book": "kosmos_humboldt_1845", "target_name": "Japan", "similarity": 0.988}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Japon", "target_book": "coloquios_da_orta_1563", "target_name": "Jap\u00e3o", "similarity": 0.98}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Japan", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Japon", "similarity": 0.988}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Japan", "target_book": "kosmos_humboldt_1845", "target_name": "Japan", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Japan", "target_book": "coloquios_da_orta_1563", "target_name": "Jap\u00e3o", "similarity": 0.981}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Japon", "target_book": "kosmos_humboldt_1845", "target_name": "Japan", "similarity": 0.988}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Japon", "target_book": "coloquios_da_orta_1563", "target_name": "Jap\u00e3o", "similarity": 0.98}, {"source_book": "kosmos_humboldt_1845", "source_name": "Japan", "target_book": "coloquios_da_orta_1563", "target_name": "Jap\u00e3o", "similarity": 0.981}], "id": 194, "stable_key": "clu_9844254ff29d68ec", "ground_truth": {"modern_name": "Japan", "confidence": "high", "type": "place", "country": "Japan", "wikidata_id": "Q17", "wikidata_description": "island country in East Asia", "wikipedia_url": "https://en.wikipedia.org/wiki/Japan", "wikipedia_extract": "Japan is an island country in East Asia. Located in the Pacific Ocean off the northeast coast of the Asian mainland, it is bordered to the west by the Sea of Japan and extends from the Sea of Okhotsk in the north to the East China Sea in the south. The Japanese archipelago consists of four major islands alongside 14,121 smaller islands. Japan is divided into 47 administrative prefectures and eight traditional regions, and around 75% of its terrain is mountainous and heavily forested, concentrating its agriculture and highly urbanized population along its eastern coastal plains. With a population of almost 123 million as of 2026, it is the world's 11th most populous country. Tokyo is the country's capital and largest city."}}, {"canonical_name": "flask", "category": "OBJECT", "subcategory": "VESSEL", "book_count": 5, "total_mentions": 20, "members": [{"entity_id": "flask", "book_id": "english_physician_1652", "name": "Flask", "category": "OBJECT", "subcategory": "VESSEL", "count": 1, "variants": ["Flask"], "contexts": ["container for liquids"]}, {"entity_id": "flacon", "book_id": "relation_historique_humboldt_vol3_1825", "name": "flacon", "category": "OBJECT", "subcategory": "VESSEL", "count": 1, "variants": ["flacon"], "contexts": ["container for volcano air"]}, {"entity_id": "flask", "book_id": "principles_of_psychology_james_1890", "name": "flask", "category": "OBJECT", "subcategory": "VESSEL", "count": 1, "variants": ["flask"], "contexts": ["container for cologne"]}, {"entity_id": "flask", "book_id": "ricettario_fiorentino_1597", "name": "Flask", "category": "OBJECT", "subcategory": "VESSEL", "count": 1, "variants": ["Flask"], "contexts": ["glass container"]}, {"entity_id": "flask", "book_id": "polyanthea_medicinal", "name": "flask", "category": "OBJECT", "subcategory": "VESSEL", "count": 16, "variants": ["flask", "Flask"], "contexts": ["a laboratory container", "container for liquids"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Flask", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "flacon", "similarity": 0.935}, {"source_book": "english_physician_1652", "source_name": "Flask", "target_book": "principles_of_psychology_james_1890", "target_name": "flask", "similarity": 0.955}, {"source_book": "english_physician_1652", "source_name": "Flask", "target_book": "ricettario_fiorentino_1597", "target_name": "Flask", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Flask", "target_book": "polyanthea_medicinal", "target_name": "flask", "similarity": 0.955}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "flacon", "target_book": "principles_of_psychology_james_1890", "target_name": "flask", "similarity": 0.932}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "flacon", "target_book": "ricettario_fiorentino_1597", "target_name": "Flask", "similarity": 0.935}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "flacon", "target_book": "polyanthea_medicinal", "target_name": "flask", "similarity": 0.932}, {"source_book": "principles_of_psychology_james_1890", "source_name": "flask", "target_book": "ricettario_fiorentino_1597", "target_name": "Flask", "similarity": 0.955}, {"source_book": "principles_of_psychology_james_1890", "source_name": "flask", "target_book": "polyanthea_medicinal", "target_name": "flask", "similarity": 1.0}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Flask", "target_book": "polyanthea_medicinal", "target_name": "flask", "similarity": 0.955}], "id": 195, "stable_key": "clu_c864926948ad091e", "ground_truth": {"modern_name": "Flask", "confidence": "high", "type": "object", "wikidata_id": "Q80228", "wikidata_description": "closable cylindrical container for transport and storage of liquids and gases", "wikipedia_url": "https://en.wikipedia.org/wiki/Bottle", "wikipedia_extract": "A bottle is a narrow-necked container made of an impermeable material (such as glass, pottery, porcelain, plastic or aluminium) in various shapes and sizes that stores and transports liquids. Its mouth, at the bottling line, can be sealed with an internal stopper, an external bottle cap, a closure, or induction sealing. First attested in 14th century. From the English word bottle derives from an Old French word boteille, from vulgar Latin butticula, from late Latin buttis (\"cask\"), a latinisation of the Greek \u03b2\u03bf\u1fe6\u03c4\u03c4\u03b9\u03c2 (bouttis) (\"vessel\"). The glass bottle represented an important development in the history of wine, because, when combined with a high-quality stopper such as a cork, it allowed long-term aging of wine. Glass has all the qualities required for long-term storage."}}, {"canonical_name": "bolo armenio", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 5, "total_mentions": 20, "members": [{"entity_id": "bolo_armenico", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "bolo armenico", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["bolo armenico"], "contexts": ["Armenian bole, an astringent earth"]}, {"entity_id": "bolo_armenico", "book_id": "historia_medicinal_monardes_1574", "name": "Bolo armenico", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Bolo armenico", "Bolo armeno"], "contexts": ["Armenian bole, a medicinal earth"]}, {"entity_id": "bolo_arm\u00e9nio", "book_id": "coloquios_da_orta_1563", "name": "bolo arm\u00e9nio", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["bolo arm\u00e9nio"], "contexts": ["argillaceous earth used in medicine"]}, {"entity_id": "bolo_armeno", "book_id": "ricettario_fiorentino_1597", "name": "Bolo armeno", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 7, "variants": ["Bolo armeno", "Bolo Armen", "Bolo Armeno", "bolo armeno", "bolo armeno orientale"], "contexts": ["another name for Sinopia", "Armenian bole earth"]}, {"entity_id": "bolo_armenio", "book_id": "polyanthea_medicinal", "name": "bolo armenio", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 9, "variants": ["bolo armenio", "bollo armenio", "bolo Armenio", "bolus armenius"], "contexts": ["ingredient in a repercussive plaster", "ingredient in wound powder"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "bolo armenico", "target_book": "historia_medicinal_monardes_1574", "target_name": "Bolo armenico", "similarity": 0.974}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "bolo armenico", "target_book": "coloquios_da_orta_1563", "target_name": "bolo arm\u00e9nio", "similarity": 0.938}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "bolo armenico", "target_book": "ricettario_fiorentino_1597", "target_name": "Bolo armeno", "similarity": 0.929}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "bolo armenico", "target_book": "polyanthea_medicinal", "target_name": "bolo armenio", "similarity": 0.95}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Bolo armenico", "target_book": "coloquios_da_orta_1563", "target_name": "bolo arm\u00e9nio", "similarity": 0.933}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Bolo armenico", "target_book": "ricettario_fiorentino_1597", "target_name": "Bolo armeno", "similarity": 0.962}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Bolo armenico", "target_book": "polyanthea_medicinal", "target_name": "bolo armenio", "similarity": 0.953}, {"source_book": "coloquios_da_orta_1563", "source_name": "bolo arm\u00e9nio", "target_book": "ricettario_fiorentino_1597", "target_name": "Bolo armeno", "similarity": 0.928}, {"source_book": "coloquios_da_orta_1563", "source_name": "bolo arm\u00e9nio", "target_book": "polyanthea_medicinal", "target_name": "bolo armenio", "similarity": 0.958}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Bolo armeno", "target_book": "polyanthea_medicinal", "target_name": "bolo armenio", "similarity": 0.978}], "id": 196, "stable_key": "clu_6a3f3c2ba39ed199", "ground_truth": {"modern_name": "Armenian bole", "confidence": "high", "type": "mineral", "description": "A reddish-yellow medicinal clay from Armenia.", "wikipedia_extract": "Armenian bole, also known as bolus armenus or bole armoniac, is an earthy clay, usually red, native to Armenia but also found in other places. The term Armenian was later referred to a specific quality of the clay. Originally used in medication, it has also been used as a pigment, as a poliment or base for gilding, and for other uses. It is red due to the presence of iron oxide; the clay also contains hydrous silicates of aluminum and possibly magnesium. Historically, the term bolu or bolus was used only for medicinal earths and Armenian bole was used as an astringent, prescribed against diarrhea, dysentery, and bleeding. References to Armenian bole were made by Theophrastus, Dioscorides (c. 41\u201390 AD) and Pliny the Elder (23\u201379 AD)."}}, {"canonical_name": "Hollande", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 5, "total_mentions": 20, "members": [{"entity_id": "hollande", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Hollande", "category": "PLACE", "subcategory": "COUNTRY", "count": 11, "variants": ["Hollande", "Nouvelle-Hollande"], "contexts": ["northern country with scattered rocks", "country with sandy plains"]}, {"entity_id": "holland", "book_id": "kosmos_humboldt_1845", "name": "Holland", "category": "PLACE", "subcategory": "COUNTRY", "count": 5, "variants": ["Holland"], "contexts": ["country visited", "center of commercial relations"]}, {"entity_id": "holanda", "book_id": "coloquios_da_orta_1563", "name": "Holanda", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Holanda"], "contexts": ["country where coco was rare"]}, {"entity_id": "hollandia", "book_id": "polyanthea_medicinal", "name": "Hollandia", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Hollandia", "Hol\u017facia"], "contexts": ["country where a woman was seen", "Republic that rewarded scholars"]}, {"entity_id": "netherlands", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Netherlands", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Netherlands"], "contexts": ["country on isothermal line of 50\u00b0 Fahrenheit"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Hollande", "target_book": "kosmos_humboldt_1845", "target_name": "Holland", "similarity": 0.977}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Hollande", "target_book": "coloquios_da_orta_1563", "target_name": "Holanda", "similarity": 0.929}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Hollande", "target_book": "polyanthea_medicinal", "target_name": "Hollandia", "similarity": 0.973}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Hollande", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Netherlands", "similarity": 0.917}, {"source_book": "kosmos_humboldt_1845", "source_name": "Holland", "target_book": "coloquios_da_orta_1563", "target_name": "Holanda", "similarity": 0.956}, {"source_book": "kosmos_humboldt_1845", "source_name": "Holland", "target_book": "polyanthea_medicinal", "target_name": "Hollandia", "similarity": 0.987}, {"source_book": "kosmos_humboldt_1845", "source_name": "Holland", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Netherlands", "similarity": 0.955}, {"source_book": "coloquios_da_orta_1563", "source_name": "Holanda", "target_book": "polyanthea_medicinal", "target_name": "Hollandia", "similarity": 0.962}, {"source_book": "coloquios_da_orta_1563", "source_name": "Holanda", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Netherlands", "similarity": 0.96}, {"source_book": "polyanthea_medicinal", "source_name": "Hollandia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Netherlands", "similarity": 0.956}], "id": 197, "stable_key": "clu_f74b716cbeb683a4", "ground_truth": {"modern_name": "Netherlands", "confidence": "high", "type": "place", "country": "Netherlands", "note": "While 'Holland' is historically used, 'Netherlands' is the current and more precise term for the country.", "wikidata_id": "Q55", "wikidata_description": "one of the four autonomous countries of the Kingdom of the Netherlands; with territories in the Caribbean", "wikipedia_url": "https://en.wikipedia.org/wiki/Netherlands", "wikipedia_extract": "The Netherlands, informally Holland, is a country in Northwestern Europe, with overseas territories in the Caribbean. It is the largest of the four constituent countries of the Kingdom of the Netherlands. The Netherlands consists of twelve provinces; it borders Germany to the east and Belgium to the south, with a North Sea coastline to the north and west. It shares maritime borders with the United Kingdom, Germany, and Belgium. The official language is Dutch, with West Frisian as a secondary official language in the province of Friesland. Dutch, English, and Papiamento are official in the Caribbean territories."}}, {"canonical_name": "Cuvier", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 5, "total_mentions": 19, "members": [{"entity_id": "cuvier", "book_id": "medecine_experimentale_bernard_1865", "name": "Cuvier", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["Cuvier"], "contexts": ["distinguished observer from experimenter", "scholar who shared this opinion"]}, {"entity_id": "cuvier", "book_id": "epoques_nature_buffon_1778", "name": "Cuvier", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Cuvier"], "contexts": ["associated with geological revolutions"]}, {"entity_id": "cuvier", "book_id": "origin_of_species_darwin_1859", "name": "Cuvier", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["Cuvier"], "contexts": ["illustrious, insisted on conditions of existence", "urged no monkey in tertiary stratum"]}, {"entity_id": "cuvier", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cuvier", "category": "PERSON", "subcategory": "SCHOLAR", "count": 7, "variants": ["Cuvier", "M. Cuvier", "MM. Cuvier"], "contexts": ["author of Ossem. foss.", "scholar cited for fossil bones"]}, {"entity_id": "cuvier", "book_id": "principles_of_psychology_james_1890", "name": "Cuvier", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Cuvier"], "contexts": ["naturalist"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "Cuvier", "target_book": "epoques_nature_buffon_1778", "target_name": "Cuvier", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Cuvier", "target_book": "origin_of_species_darwin_1859", "target_name": "Cuvier", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Cuvier", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Cuvier", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Cuvier", "target_book": "principles_of_psychology_james_1890", "target_name": "Cuvier", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Cuvier", "target_book": "origin_of_species_darwin_1859", "target_name": "Cuvier", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Cuvier", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Cuvier", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Cuvier", "target_book": "principles_of_psychology_james_1890", "target_name": "Cuvier", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Cuvier", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Cuvier", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Cuvier", "target_book": "principles_of_psychology_james_1890", "target_name": "Cuvier", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cuvier", "target_book": "principles_of_psychology_james_1890", "target_name": "Cuvier", "similarity": 1.0}], "id": 198, "stable_key": "clu_d43817dded10abfa", "ground_truth": {"modern_name": "Georges Cuvier", "confidence": "high", "type": "person", "birth_year": 1769, "death_year": 1832, "description": "French naturalist and zoologist, founder of paleontology", "note": "The mention of 'coloquios_da_orta_1563' is an anomaly; the person is clearly Georges Cuvier based on other texts from the 19th century.", "wikidata_id": "Q171969", "wikidata_description": "French naturalist, zoologist and paleontologist (1769\u20131832)", "wikipedia_url": "https://en.wikipedia.org/wiki/Georges%20Cuvier", "wikipedia_extract": "Jean L\u00e9opold Nicolas Fr\u00e9d\u00e9ric, baron Cuvier (23 August 1769 \u2013 13 May 1832), known as Georges Cuvier (;  French: [\u0292\u0254\u0281\u0292(\u0259) kyvje]), was a French naturalist and zoologist, sometimes referred to as the \"founding father of paleontology\". Cuvier was a major figure in natural sciences research in the early 19th century and was instrumental in establishing the fields of comparative anatomy and paleontology through his work in comparing living animals with fossils. Cuvier's work is considered the foundation of vertebrate paleontology, and he expanded Linnaean taxonomy by grouping classes into phyla and incorporating both fossils and living species into the classification. Cuvier is also known for establishing extinction as a scientific fact\u2014at the time, extinction was considered by many of Cuvier's contemporaries to be merely controversial speculation. In his Essay on the Theory of the Earth (1813), Cuvier proposed that now-extinct species had been wiped out by periodic catastrophic flooding events. In this way, Cuvier became the most influential proponent of catastrophism in geology in the early 19th century."}}, {"canonical_name": "April", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 19, "members": [{"entity_id": "april", "book_id": "english_physician_1652", "name": "April", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 12, "variants": ["April"], "contexts": ["month when Alder-Tree flowers", "month when Bilberries flower"]}, {"entity_id": "abril", "book_id": "historia_medicinal_monardes_1574", "name": "Abril", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Abril"], "contexts": ["month when amber fruit is ripe"]}, {"entity_id": "abril", "book_id": "coloquios_da_orta_1563", "name": "abril", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["abril"], "contexts": ["month for pearl diving"]}, {"entity_id": "aprile", "book_id": "ricettario_fiorentino_1597", "name": "Aprile", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Aprile"], "contexts": ["month of April"]}, {"entity_id": "abril", "book_id": "polyanthea_medicinal", "name": "Abril", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Abril"], "contexts": ["emetic preparation", "month of the year"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "April", "target_book": "coloquios_da_orta_1563", "target_name": "abril", "similarity": 0.953}, {"source_book": "english_physician_1652", "source_name": "April", "target_book": "ricettario_fiorentino_1597", "target_name": "Aprile", "similarity": 0.979}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Abril", "target_book": "coloquios_da_orta_1563", "target_name": "abril", "similarity": 0.917}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Abril", "target_book": "polyanthea_medicinal", "target_name": "Abril", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "abril", "target_book": "ricettario_fiorentino_1597", "target_name": "Aprile", "similarity": 0.947}, {"source_book": "coloquios_da_orta_1563", "source_name": "abril", "target_book": "polyanthea_medicinal", "target_name": "Abril", "similarity": 0.917}], "id": 199, "stable_key": "clu_a2da1305d0d4b84a", "ground_truth": {"modern_name": "April", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/April", "wikipedia_extract": "April is the fourth month of the year in the Gregorian and Julian calendars. Its length is 30 days. April is commonly associated with the season of spring in the Northern Hemisphere, and autumn in the Southern Hemisphere, where it is the seasonal equivalent to October in the Northern Hemisphere and vice versa. The Romans gave this month the Latin name Aprilis but the derivation of this name is uncertain. The traditional etymology is from the verb aperire, \"to open\", in allusion to its being the season when trees and flowers begin to \"open\", which is supported by comparison with the modern Greek use of \u03ac\u03bd\u03bf\u03b9\u03be\u03b7 (\u00e1nixi) (opening) for spring. Since some of the Roman months were named in honor of divinities, and as April was sacred to the goddess Venus, her Veneralia being held on the first day, it has been suggested that Aprilis was originally her month Aphrilis, from her equivalent Greek goddess name Aphrodite (Aphros), or the Etruscan name Apru."}}, {"canonical_name": "Author", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 5, "total_mentions": 19, "members": [{"entity_id": "author", "book_id": "origin_of_species_darwin_1859", "name": "author", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["author"], "contexts": ["writer of scientific text"]}, {"entity_id": "author", "book_id": "principles_of_psychology_james_1890", "name": "author", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["author"], "contexts": ["profession of Sidney Dean"]}, {"entity_id": "author", "book_id": "coloquios_da_orta_1563", "name": "author", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["author"], "contexts": ["narrator of the text"]}, {"entity_id": "author", "book_id": "polyanthea_medicinal", "name": "Author", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 15, "variants": ["Author", "Authordavida"], "contexts": ["refers to the author of the text", "source of information"]}, {"entity_id": "author", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Author", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Author"], "contexts": ["creator of the universe"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "author", "target_book": "principles_of_psychology_james_1890", "target_name": "author", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "author", "target_book": "coloquios_da_orta_1563", "target_name": "author", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "author", "target_book": "polyanthea_medicinal", "target_name": "Author", "similarity": 0.994}, {"source_book": "origin_of_species_darwin_1859", "source_name": "author", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Author", "similarity": 0.994}, {"source_book": "principles_of_psychology_james_1890", "source_name": "author", "target_book": "coloquios_da_orta_1563", "target_name": "author", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "author", "target_book": "polyanthea_medicinal", "target_name": "Author", "similarity": 0.994}, {"source_book": "principles_of_psychology_james_1890", "source_name": "author", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Author", "similarity": 0.994}, {"source_book": "coloquios_da_orta_1563", "source_name": "author", "target_book": "polyanthea_medicinal", "target_name": "Author", "similarity": 0.994}, {"source_book": "coloquios_da_orta_1563", "source_name": "author", "target_book": "connexion_phy