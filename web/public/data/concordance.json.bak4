perimentale_bernard_1865", "name": "f\u00e9condations", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["f\u00e9condations"], "contexts": ["process of reproduction between species"]}, {"entity_id": "f\u00e9condation", "book_id": "epoques_nature_buffon_1778", "name": "f\u00e9condation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["f\u00e9condation"], "contexts": ["fertilization"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "f\u00e9condations", "target_book": "epoques_nature_buffon_1778", "target_name": "f\u00e9condation", "similarity": 0.944}], "id": 5114, "stable_key": "clu_b1cbaa340983169e", "ground_truth": {"modern_name": "Fertilization", "confidence": "high", "type": "concept", "wikidata_id": "Q14890574", "wikidata_description": "union of gametes of opposite sexes during the process of sexual reproduction to form a zygote", "wikipedia_url": "https://en.wikipedia.org/wiki/Fertilisation"}}, {"canonical_name": "\u00e9t\u00e9", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "\u00e9t\u00e9", "book_id": "medecine_experimentale_bernard_1865", "name": "\u00e9t\u00e9", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["\u00e9t\u00e9"], "contexts": ["season"]}, {"entity_id": "\u00e9t\u00e9", "book_id": "relation_historique_humboldt_vol3_1825", "name": "\u00e9t\u00e9", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["\u00e9t\u00e9"], "contexts": ["season when cold was felt"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "\u00e9t\u00e9", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "\u00e9t\u00e9", "similarity": 1.0}], "id": 5115, "stable_key": "clu_c2f15b5488e1b951-2", "ground_truth": {"modern_name": "Summer", "confidence": "high", "type": "concept", "description": "The warmest season of the year, between spring and autumn.", "note": "Includes references to Midsummer and abstract concepts of summer.", "wikipedia_extract": "Summer or summertime is the hottest and brightest of the four temperate seasons, occurring after spring and before autumn. At or centred on the summer solstice, daylight hours are the longest and darkness hours are the shortest, with day length decreasing as the season progresses after the solstice. The earliest sunrises and latest sunsets also occur near the date of the solstice. The date of the beginning of summer varies according to definition, climate, tradition, and culture. When it is summer in the Northern Hemisphere, it is winter in the Southern Hemisphere, and vice versa. The modern English summer derives from the Middle English somer, via the Old English sumor."}}, {"canonical_name": "nerfs c\u00e9r\u00e9bro-spinaux", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "nerfs_c\u00e9r\u00e9bro-spinaux", "book_id": "medecine_experimentale_bernard_1865", "name": "nerfs c\u00e9r\u00e9bro-spinaux", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["nerfs c\u00e9r\u00e9bro-spinaux"], "contexts": ["nerves of the brain and spinal cord"]}, {"entity_id": "nerbepuelos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "nerbepuelos", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["nerbepuelos"], "contexts": ["vein-like structures on leaves"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "nerfs c\u00e9r\u00e9bro-spinaux", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "nerbepuelos", "similarity": 0.895}], "id": 5116, "stable_key": "clu_931513b50668d1c4", "ground_truth": {"modern_name": "Cranial nerves and spinal nerves", "confidence": "medium", "type": "concept", "note": "The term 'nerfs c\u00e9r\u00e9bro-spinaux' directly translates to cerebro-spinal nerves, referring to the nerves originating from the brain and spinal cord. 'Nerbepuelos' from Hernandez is more obscure but likely refers to a similar anatomical concept. The reference to 'vein-like structures on leaves' suggests a potential botanical analogy rather than a direct medical term."}}, {"canonical_name": "m\u00e9thode par diff\u00e9rence", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "m\u00e9thode_par_diff\u00e9rence", "book_id": "medecine_experimentale_bernard_1865", "name": "m\u00e9thode par diff\u00e9rence", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["m\u00e9thode par diff\u00e9rence"], "contexts": ["scientific method of isolating variables"]}, {"entity_id": "method_of_difference", "book_id": "principles_of_psychology_james_1890", "name": "method of difference", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["method of difference"], "contexts": ["experimental method contrasting cases"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "m\u00e9thode par diff\u00e9rence", "target_book": "principles_of_psychology_james_1890", "target_name": "method of difference", "similarity": 0.934}], "id": 5117, "stable_key": "clu_6c1e464382c2c865", "ground_truth": {"modern_name": "Method of difference", "confidence": "high", "type": "concept", "wikidata_id": "Q137772518", "wikidata_description": "Article published in May 1973 The Annals of Statistics"}}, {"canonical_name": "glande parotide", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "glande_parotide", "book_id": "medecine_experimentale_bernard_1865", "name": "glande parotide", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["glande parotide"], "contexts": ["salivary gland in dogs and humans"]}, {"entity_id": "glandu