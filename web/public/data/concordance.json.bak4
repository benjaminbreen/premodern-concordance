 "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "anatomiques", "book_id": "medecine_experimentale_bernard_1865", "name": "anatomiques", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["anatomiques"], "contexts": ["relating to the structure of the body"]}, {"entity_id": "anatomia", "book_id": "polyanthea_medicinal", "name": "Anatomia", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["Anatomia"], "contexts": ["anatomy", "study of the body for physicians"]}, {"entity_id": "anatomy", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Anatomy", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Anatomy"], "contexts": ["Professor of Anatomy"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "anatomiques", "target_book": "polyanthea_medicinal", "target_name": "Anatomia", "similarity": 0.952}, {"source_book": "polyanthea_medicinal", "source_name": "Anatomia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Anatomy", "similarity": 0.991}], "id": 1388, "stable_key": "clu_6d37d1b17176e5e8", "ground_truth": {"modern_name": "Anatomy", "confidence": "high", "type": "concept", "wikidata_id": "Q514", "wikidata_description": "study of the internal structure of organisms and their parts"}}, {"canonical_name": "singes", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "singes", "book_id": "medecine_experimentale_bernard_1865", "name": "singes", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["singes"], "contexts": ["animals used in Galen's experiments", "animals used for dissection by Galen"]}, {"entity_id": "singe", "book_id": "medecine_experimentale_bernard_1865", "name": "singe", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["singe"], "cont