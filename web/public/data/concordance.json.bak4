": 0.928}], "id": 4338, "stable_key": "clu_b1cf564ee346f4fc", "ground_truth": {"modern_name": "Organic evolution", "confidence": "high", "type": "concept", "wikidata_id": "Q51515007", "wikidata_description": "London: T.C. & E.C. Jack, [1905]."}}, {"canonical_name": "lower animals", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "\u00eatres_vivants_inf\u00e9rieurs", "book_id": "medecine_experimentale_bernard_1865", "name": "\u00eatres vivants inf\u00e9rieurs", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["\u00eatres vivants inf\u00e9rieurs"], "contexts": ["lower living beings, animals or plants"]}, {"entity_id": "lower_animals", "book_id": "principles_of_psychology_james_1890", "name": "lower animals", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["lower animals"], "contexts": ["non-human animals", "animals less complex than humans"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "\u00eatres vivants inf\u00e9rieurs", "target_book": "principles_of_psychology_james_1890", "target_name": "lower animals", "similarity": 0.917}], "id": 4339, "stable_key": "clu_ae4ef7afb13429d7", "ground_truth": {"modern_name": "Lower animals", "confidence": "high", "type": "animal", "wikidata_id": "Q76892121", "wikidata_description": "scientific article published on 01 October 1964"}}, {"canonical_name": "organized beings", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "\u00eatres_organis\u00e9s", "book_id": "medecine_experimentale_bernard_1865", "name": "\u00eatres organis\u00e9s", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["\u00eatres organis\u00e9s"], "contexts": ["organized beings"]}, {"entity_id": "organized_beings", "book_id": "kosmos_humboldt_1845", "name": "organized beings", "category": "CONCEPT", "subcat