ription": "ancient Greek and Roman system of medicine involving four fluid types", "wikipedia_url": "https://en.wikipedia.org/wiki/Humorism"}}, {"canonical_name": "lepra", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 4, "total_mentions": 66, "members": [{"entity_id": "lepra", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "lepra", "category": "DISEASE", "subcategory": "CHRONIC", "count": 6, "variants": ["lepra"], "contexts": ["skin disease cured by plant", "leprosy, a chronic infectious disease"]}, {"entity_id": "lepra", "book_id": "historia_medicinal_monardes_1574", "name": "Lepra", "category": "DISEASE", "subcategory": "CHRONIC", "count": 2, "variants": ["Lepra"], "contexts": ["disease name, possibly referring to leprosy", "skin disease"]}, {"entity_id": "lepra", "book_id": "coloquios_da_orta_1563", "name": "lepra", "category": "DISEASE", "subcategory": "CHRONIC", "count": 5, "variants": ["lepra"], "contexts": ["disease caused by milk and fish", "leprosy, treated with the stone"]}, {"entity_id": "lepra", "book_id": "polyanthea_medicinal", "name": "lepra", "category": "DISEASE", "subcategory": "CHRONIC", "count": 53, "variants": ["lepra", "Lepra", "lepra Gr\u00e6corum", "lepra branca", "lepram", "lepras", "lepras rebeldes", "leprous"], "contexts": ["skin disease", "leprosy"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "lepra", "target_book": "historia_medicinal_monardes_1574", "target_name": "Lepra", "similarity": 0.99}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "lepra", "target_book": "coloquios_da_orta_1563", "target_name": "lepra", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "lepra", "target_book": "polyanthea_medicinal", "target_name": "lepra", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Lepra", "target_book": "coloquios_da_orta_1563", "target_name": "lepra", "similarity": 0.99}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Lepra", "target_book": "polyanthea_medicinal", "target_name": "lepra", "similarity": 0.99}, {"source_book": "coloquios_da_orta_1563", "source_name": "lepra", "target_book": "polyanthea_medicinal", "target_name": "lepra", "similarity": 1.0}], "id": 366, "stable_key": "clu_15d8f9dfbddb30bc", "ground_truth": {"modern_name": "Leprosy", "confidence": "high", "type": "disease", "description": "A chronic infectious disease affecting skin and nerves.", "note": "Covers historical understanding and terminology for leprosy.", "wikipedia_extract": "Leprosy, also known as Hansen's disease (HD), is a long-term infection by the bacteria Mycobacterium leprae or Mycobacterium lepromatosis. Infection can lead to damage of the nerves, respiratory tract, skin, and eyes. This nerve damage may result in the loss of nociception, which can lead to the loss of parts of a person's extremities from repeated injuries or infection through unnoticed wounds. An infected person may also experience muscle weakness and loss of eyesight. Leprosy symptoms may begin within one year or take 20 years or more. Leprosy is spread between people, although extensive contact is necessary.", "modern_term": "Leprosy", "wikidata_id": "Q100400591", "wikidata_description": "scholarly article"}}, {"canonical_name": "Chymicos", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 4, "total_mentions": 63, "members": [{"entity_id": "chimiste", "book_id": "medecine_experimentale_bernard_1865", "name": "chimiste", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 19, "variants": ["chimiste"], "contexts": ["practitioner who experiments on phenomena", "practitioner of chemistry"]}, {"entity_id": "le_chimiste", "book_id": "medecine_experimentale_bernard_1865", "name": "le chimiste", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["le chimiste"], "contexts": ["scientist studying chemistry"]}, {"entity_id": "chemist", "book_id": "principles_of_psychology_james_1890", "name": "chemist", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["chemist"], "contexts": ["practitioner of chemistry"]}, {"entity_id": "chymicos", "book_id": "polyanthea_medicinal", "name": "Chymicos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 37, "variants": ["Chymicos"], "contexts": ["Relating to alchemy or chemistry", "alchemical"]}, {"entity_id": "chemist", "book_id": "first_principles_spencer_1862", "name": "chemist", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 5, "variants": ["Chemist", "chemist"], "contexts": ["scientist studying chemistry", "practitioner of chemistry"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "chimiste", "target_book": "principles_of_psychology_james_1890", "target_name": "chemist", "similarity": 0.98}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "chimiste", "target_book": "polyanthea_medicinal", "target_name": "Chymicos", "similarity": 0.872}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "le chimiste", "target_book": "principles_of_psychology_james_1890", "target_name": "chemist", "similarity": 0.885}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "le chimiste", "target_book": "first_principles_spencer_1862", "target_name": "chemist", "similarity": 0.929}, {"source_book": "principles_of_psychology_james_1890", "source_name": "chemist", "target_book": "polyanthea_medicinal", "target_name": "Chymicos", "similarity": 0.894}, {"source_book": "principles_of_psychology_james_1890", "source_name": "chemist", "target_book": "first_principles_spencer_1862", "target_name": "chemist", "similarity": 0.918}], "id": 367, "stable_key": "clu_56606156310e98e7", "ground_truth": {"modern_name": "Chemist", "confidence": "high", "type": "person", "description": "A practitioner of alchemy or chemistry.", "note": "Refers to practitioners of early chemistry or alchemy.", "wikipedia_extract": "A chemist (from Greek ch\u0113m(\u00eda) alchemy; replacing chymist from Medieval Latin alchemist) is a graduated scientist trained in the study of chemistry, or an officially enrolled student in the field. Chemists study the composition of matter and its properties. Chemists carefully describe the properties they study in terms of quantities, with detail on the level of molecules and their component atoms. Chemists carefully measure substance proportions, chemical reaction rates, and other chemical properties. In Commonwealth English, pharmacists are often called chemists. Chemists use their knowledge to learn the composition and properties of unfamiliar substances, as well as to reproduce and synthesize large quantities of useful naturally occurring substances and create new artificial substances and useful processes."}}, {"canonical_name": "Gout", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 4, "total_mentions": 62, "members": [{"entity_id": "gout", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Gout", "category": "DISEASE", "subcategory": "CHRONIC", "count": 2, "variants": ["Gout"], "contexts": ["inflammatory arthritis", "joint inflammation treated with Loadstone"]}, {"entity_id": "gout", "book_id": "english_physician_1652", "name": "Gout", "category": "DISEASE", "subcategory": "CHRONIC", "count": 55, "variants": ["Gout", "Gouts"], "contexts": ["disease helped by the herb", "ailment treated by the herb"]}, {"entity_id": "gout", "book_id": "principles_of_psychology_james_1890", "name": "gout", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["gout"], "contexts": ["metabolic disease causing joint inflammation"]}, {"entity_id": "gout", "book_id": "polyanthea_medicinal", "name": "Gout", "category": "DISEASE", "subcategory": "CHRONIC", "count": 4, "variants": ["Gout", "gout", "goutta"], "contexts": ["joint inflammation", "disease affecting joints"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Gout", "target_book": "english_physician_1652", "target_name": "Gout", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Gout", "target_book": "principles_of_psychology_james_1890", "target_name": "gout", "similarity": 0.949}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Gout", "target_book": "polyanthea_medicinal", "target_name": "Gout", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Gout", "target_book": "principles_of_psychology_james_1890", "target_name": "gout", "similarity": 0.949}, {"source_book": "english_physician_1652", "source_name": "Gout", "target_book": "polyanthea_medicinal", "target_name": "Gout", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "gout", "target_book": "polyanthea_medicinal", "target_name": "Gout", "similarity": 0.949}], "id": 368, "stable_key": "clu_88100adab4afa6a2", "ground_truth": {"modern_name": "Gout", "confidence": "high", "type": "disease", "modern_term": "Gout", "wikidata_id": "Q133087", "wikidata_description": "medical condition that results in recurrent pain and swelling of joints", "wikipedia_url": "https://en.wikipedia.org/wiki/Gout", "wikipedia_extract": "Gout ( GOWT) is a form of inflammatory arthritis characterized by recurrent attacks of pain in a red, tender, hot, and swollen joint, caused by the deposition of needle-shaped crystals of the monosodium salt of uric acid. Pain typically comes on rapidly, reaching maximal intensity in less than 12 hours. In about half of cases, the joint at the base of the big toe is affected (Podagra). It may also result in tophi, kidney stones, or kidney damage. Gout is due to persistently elevated levels of uric acid (urate) in the blood (hyperuricemia). This occurs from a combination of diet, other health problems, and genetic factors.", "note": "The term 'gota coral' appears to be an early modern descriptor for gout, possibly with specific regional or contextual nuances, as suggested by the mention of 'coconut' in the context of treatment. However, the core disease is gout.", "description": "A metabolic disease causing joint inflammation."}}, {"canonical_name": "Mer du Sud", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 62, "members": [{"entity_id": "mer_du_sud", "book_id": "epoques_nature_buffon_1778", "name": "mer du Sud", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["mer du Sud"], "contexts": ["ocean"]}, {"entity_id": "mar_del_sur", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "mar del Sur", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["mar del Sur"], "contexts": ["geographic location", "region from which tlacoxochitl was brought"]}, {"entity_id": "mer_du_sud", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Mer du Sud", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 58, "variants": ["mer du Sud", "Mer du Sud"], "contexts": ["ocean bordering Guatemala", "ocean, likely Pacific"]}, {"entity_id": "south_sea", "book_id": "connexion_physical_sciences_somerville_1858", "name": "South Sea", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["South Sea"], "contexts": ["location of Tahiti observation"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "mer du Sud", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "mar del Sur", "similarity": 0.92}, {"source_book": "epoques_nature_buffon_1778", "source_name": "mer du Sud", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Mer du Sud", "similarity": 0.988}, {"source_book": "epoques_nature_buffon_1778", "source_name": "mer du Sud", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "South Sea", "similarity": 0.914}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "mar del Sur", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Mer du Sud", "similarity": 0.906}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Mer du Sud", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "South Sea", "similarity": 0.904}], "id": 369, "stable_key": "clu_a911490fe9a26789", "ground_truth": {"modern_name": "Pacific Ocean", "confidence": "high", "type": "place", "country": "N/A", "note": "'Mer du Sud' and 'South Sea' are historical names for the Pacific Ocean.", "wikidata_id": "Q844857", "wikidata_description": "geographic region consisting of the islands of the Pacific Ocean", "wikipedia_url": "https://en.wikipedia.org/wiki/Pacific%20Islands"}}, {"canonical_name": "Jardinillos", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 62, "members": [{"entity_id": "gardens", "book_id": "english_physician_1652", "name": "Gardens", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 29, "variants": ["Gardens"], "contexts": ["location where herb is sown", "location where Asarabacca grows"]}, {"entity_id": "jardines", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "jardines", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["jardines"], "contexts": ["gardens where plants are cultivated"]}, {"entity_id": "jardinillos", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Jardinillos", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 31, "variants": ["Jardinillos", "Jardines", "Jardines y Jaixlinillos", "Jardines y Jardinillos", "Jardinillos dtl Rey y de la Reyna", "Jardins", "Jardins du Boi"], "contexts": ["Jardinillos", "group of cayes near Isla de Pinos"]}, {"entity_id": "giardini", "book_id": "ricettario_fiorentino_1597", "name": "Giardini", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Giardini"], "contexts": ["gardens where white hellebore flower was seen"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Gardens", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "jardines", "similarity": 0.976}, {"source_book": "english_physician_1652", "source_name": "Gardens", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Jardinillos", "similarity": 0.918}, {"source_book": "english_physician_1652", "source_name": "Gardens", "target_book": "ricettario_fiorentino_1597", "target_name": "Giardini", "similarity": 0.946}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "jardines", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Jardinillos", "similarity": 0.941}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "jardines", "target_book": "ricettario_fiorentino_1597", "target_name": "Giardini", "similarity": 0.939}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Jardinillos", "target_book": "ricettario_fiorentino_1597", "target_name": "Giardini", "similarity": 0.915}], "id": 370, "stable_key": "clu_6af94cce1f0ea253", "ground_truth": {"modern_name": "Gardens", "confidence": "high", "type": "place", "note": "The term 'Jardinillos' can refer to specific gardens but in this context, across multiple languages and texts, it broadly refers to gardens where plants were cultivated or observed.", "wikidata_id": "Q740887", "wikidata_description": "genus of flowering plants in the coffee family Rubiaceae", "wikipedia_url": "https://en.wikipedia.org/wiki/Gardenia", "wikipedia_extract": "Gardenia is a genus of flowering plants in the coffee family, Rubiaceae, native to the tropical and subtropical regions of Africa, Asia, Madagascar, Pacific Islands, and Australia. The genus was named by Carl Linnaeus and John Ellis after Alexander Garden (1730\u20131791), a Scottish naturalist. The type species is Gardenia jasminoides, as first published by Ellis in 1761. Gardenia species typically grow as shrubs or small trees, however some species, such as those native to New Guinea, may grow to 20-30m tall. A small number of species found in tropical East Africa and southern Africa grow as small pyrophytic subshrubs. At least one species, Gardenia epiphytica, native to Gabon and Cameroon, grows as an epiphyte."}}, {"canonical_name": "delirios", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 4, "total_mentions": 62, "members": [{"entity_id": "delirium", "book_id": "principles_of_psychology_james_1890", "name": "delirium", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 7, "variants": ["delirium"], "contexts": ["state due to foreign matters or brain changes", "confused mental state"]}, {"entity_id": "delirium", "book_id": "kosmos_humboldt_1845", "name": "delirium", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["delirium"], "contexts": ["disturbed state of mind"]}, {"entity_id": "delirios", "book_id": "polyanthea_medicinal", "name": "delirios", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 52, "variants": ["delirios", "Delirio", "Delirios", "delir.", "deliran-", "delirante", "delirantes", "delirar", "delirava", "deliria", "delirio", "deliriocom", "delirios implacaveis", "delirios teymosos", "delirium"], "contexts": ["Condition of delirium", "delirium"]}, {"entity_id": "delirium", "book_id": "first_principles_spencer_1862", "name": "delirium", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["delirium"], "contexts": ["state of severe confusion and disordered thought", "confused and disturbed state of mind"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "delirium", "target_book": "kosmos_humboldt_1845", "target_name": "delirium", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "delirium", "target_book": "polyanthea_medicinal", "target_name": "delirios", "similarity": 0.96}, {"source_book": "principles_of_psychology_james_1890", "source_name": "delirium", "target_book": "first_principles_spencer_1862", "target_name": "delirium", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "delirium", "target_book": "polyanthea_medicinal", "target_name": "delirios", "similarity": 0.96}, {"source_book": "kosmos_humboldt_1845", "source_name": "delirium", "target_book": "first_principles_spencer_1862", "target_name": "delirium", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "delirios", "target_book": "first_principles_spencer_1862", "target_name": "delirium", "similarity": 0.96}], "id": 371, "stable_key": "clu_b841739754f498fe", "ground_truth": {"modern_name": "Delirium", "confidence": "high", "type": "disease", "modern_term": "Delirium", "wikidata_id": "Q160796", "wikidata_description": "severe confusion that develops quickly, and often fluctuates in intensity", "wikipedia_url": "https://en.wikipedia.org/wiki/Delirium", "note": "Historically, 'phrensy' could encompass a broader range of mental disturbances, but in these contexts, it strongly points to delirium or a state of acute mental derangement, often associated with fever.", "wikipedia_extract": "Delirium (formerly acute confusional state, an ambiguous term that is now discouraged) is a specific state of acute confusion attributable to the direct physiological consequence of a medical condition, effects of a psychoactive substance, or multiple causes, which usually develops over the course of hours to days. As a syndrome, delirium presents with disturbances in attention, awareness, and higher-order cognition. People with delirium may experience other neuropsychiatric disturbances including changes in psychomotor activity (e.g., hyperactive, hypoactive, or mixed level of activity), disrupted sleep-wake cycle, emotional disturbances, disturbances of consciousness, or altered state of consciousness, as well as perceptual disturbances (e.g., hallucinations and delusions), although these features are not required for diagnosis. Diagnostically, delirium encompasses both the syndrome of acute confusion and its underlying organic process known as an acute encephalopathy. The cause of delirium may be either a disease process inside the brain or a process outside the brain that nonetheless affects the brain. Delirium may be the result of an underlying medical condition (e.g., infection or hypoxia), side effect of a medication such as diphenhydramine, promethazine, and dicyclomine, substance intoxication (e.g., opioids or hallucinogenic deliriants), substance withdrawal (e.g., alcohol or sedatives), or from multiple factors affecting one's overall health (e.g., malnutrition, pain, etc.)."}}, {"canonical_name": "Mouth", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 61, "members": [{"entity_id": "mouth", "book_id": "english_physician_1652", "name": "Mouth", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 51, "variants": ["Mouth", "Mouths", "mouth"], "contexts": ["body part gargled with decoction", "body part from which bleeding is stanched"]}, {"entity_id": "mouth", "book_id": "origin_of_species_darwin_1859", "name": "mouth", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["mouth"], "contexts": ["part of pigeon anatomy", "opening for ingestion and vocalization"]}, {"entity_id": "mouth", "book_id": "principles_of_psychology_james_1890", "name": "mouth", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["mouth"], "contexts": ["opening for eating and speaking", "facial feature"]}, {"entity_id": "mouth", "book_id": "first_principles_spencer_1862", "name": "mouth", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["mouth"], "contexts": ["opening for ingestion", "oral cavity"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Mouth", "target_book": "origin_of_species_darwin_1859", "target_name": "mouth", "similarity": 0.985}, {"source_book": "english_physician_1652", "source_name": "Mouth", "target_book": "principles_of_psychology_james_1890", "target_name": "mouth", "similarity": 0.985}, {"source_book": "english_physician_1652", "source_name": "Mouth", "target_book": "first_principles_spencer_1862", "target_name": "mouth", "similarity": 0.985}, {"source_book": "origin_of_species_darwin_1859", "source_name": "mouth", "target_book": "principles_of_psychology_james_1890", "target_name": "mouth", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "mouth", "target_book": "first_principles_spencer_1862", "target_name": "mouth", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "mouth", "target_book": "first_principles_spencer_1862", "target_name": "mouth", "similarity": 1.0}], "id": 372, "stable_key": "clu_c701cba32c58677a", "ground_truth": {"modern_name": "Mouth", "confidence": "high", "type": "concept", "note": "'Boca' is the direct translation of 'mouth' in Portuguese and Spanish, referring to the anatomical region.", "wikidata_id": "Q1233637", "wikidata_description": "end of a river or stream"}}, {"canonical_name": "Canafistula", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 4, "total_mentions": 60, "members": [{"entity_id": "ca\u00f1a_fistola", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "ca\u00f1a fistola", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["ca\u00f1a fistola"], "contexts": ["tree resembling chatalhuie, with similar leaves", "plant used as a purgative"]}, {"entity_id": "ca\u00f1afistola", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Ca\u00f1afistola", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Ca\u00f1afistola"], "contexts": ["tree name, also called quauh ayohuachtli"]}, {"entity_id": "ca\u00f1afistola", "book_id": "historia_medicinal_monardes_1574", "name": "Ca\u00f1afistola", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 9, "variants": ["Ca\u00f1afistola", "Ca\u00f1afiltola", "Ca\u00f1afilto\u00eda en c\u00f3lerua", "Ca\u00f1afito"], "contexts": ["plant used for purgative pulp", "plant discussed in the following section"]}, {"entity_id": "canafistola", "book_id": "coloquios_da_orta_1563", "name": "canafistola", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 9, "variants": ["canafistola", "Canafistola", "canajistola", "canefistola", "can\u00e1fistola"], "contexts": ["fruit of the tree", "plant with medicinal pulp"]}, {"entity_id": "canafistula", "book_id": "polyanthea_medicinal", "name": "Canafistula", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 38, "variants": ["Canafistula", "Cana fistula", "Canafiftula", "Canaristula", "canafi", "canafiftula", "canafifula", "canafil tula", "canafistula", "canafistula fre\u017fca", "canafi\u017ftu", "canafi\u017ftula", "canasi\u017ftula", "ca\u017fcasde canafi\u017ftula"], "contexts": ["fresh cassia pulp", "plant used in remedies"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "ca\u00f1a fistola", "target_book": "historia_medicinal_monardes_1574", "target_name": "Ca\u00f1afistola", "similarity": 0.855}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "ca\u00f1a fistola", "target_book": "coloquios_da_orta_1563", "target_name": "canafistola", "similarity": 0.803}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Ca\u00f1afistola", "target_book": "historia_medicinal_monardes_1574", "target_name": "Ca\u00f1afistola", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Ca\u00f1afistola", "target_book": "coloquios_da_orta_1563", "target_name": "canafistola", "similarity": 0.873}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Ca\u00f1afistola", "target_book": "coloquios_da_orta_1563", "target_name": "canafistola", "similarity": 0.873}, {"source_book": "coloquios_da_orta_1563", "source_name": "canafistola", "target_book": "polyanthea_medicinal", "target_name": "Canafistula", "similarity": 0.971}], "id": 373, "stable_key": "clu_5cfc0612d52a9195", "ground_truth": {"modern_name": "Cassia fistula", "confidence": "high", "type": "plant", "linnaean": "Cassia fistula", "family": "Fabaceae", "description": "A flowering plant whose pulp is used medicinally.", "wikipedia_extract": "Cassia fistula, also known as golden shower, purging cassia, Indian laburnum, kani konna, or pudding-pipe tree, is a flowering plant in the family Fabaceae. The species is native to the Indian subcontinent and adjacent regions of Southeast Asia. It is the official state flower of Kerala state and Delhi UT in India, as well as the national tree and flower of Thailand. It is also a popular ornamental plant and is also used in herbal medicine. Cassia fistula* is widely known by local names across the Indian subcontinent and other regions due to its prominent medicinal, cultural, and ornamental importance. The golden shower tree is a medium-sized tree, growing to 10\u201320 m (33\u201366 ft) tall with fast growth."}}, {"canonical_name": "crian\u00e7a", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 4, "total_mentions": 59, "members": [{"entity_id": "children", "book_id": "english_physician_1652", "name": "Children", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 23, "variants": ["Children", "Child", "Childern"], "contexts": ["young individuals", "group affected by worms and incontinence"]}, {"entity_id": "children", "book_id": "principles_of_psychology_james_1890", "name": "children", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["children"], "contexts": ["offspring"]}, {"entity_id": "crian\u00e7a", "book_id": "polyanthea_medicinal", "name": "crian\u00e7a", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 34, "variants": ["crian\u00e7a", "crian\u00e7as", "crian\u00e7asdemama"], "contexts": ["a very thin child", "child"]}, {"entity_id": "child", "book_id": "first_principles_spencer_1862", "name": "child", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["child"], "contexts": ["greater structural modifiability than adult"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Children", "target_book": "principles_of_psychology_james_1890", "target_name": "children", "similarity": 0.997}, {"source_book": "english_physician_1652", "source_name": "Children", "target_book": "polyanthea_medicinal", "target_name": "crian\u00e7a", "similarity": 0.904}, {"source_book": "english_physician_1652", "source_name": "Children", "target_book": "first_principles_spencer_1862", "target_name": "child", "similarity": 0.911}, {"source_book": "principles_of_psychology_james_1890", "source_name": "children", "target_book": "polyanthea_medicinal", "target_name": "crian\u00e7a", "similarity": 0.899}, {"source_book": "principles_of_psychology_james_1890", "source_name": "children", "target_book": "first_principles_spencer_1862", "target_name": "child", "similarity": 0.912}], "id": 374, "stable_key": "clu_f606f6daacccf63d", "ground_truth": {"modern_name": "Child", "confidence": "high", "type": "concept", "note": "This refers to the general concept of a young human, not a specific named person.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Child", "wikipedia_extract": "A child (pl. children) is a human being between the stages of birth and puberty, or between the developmental period of infancy and puberty. The term may also refer to an unborn human being. In English-speaking countries, the legal definition of child generally refers to a minor, in this case as a person younger than the local age of majority (there are exceptions such as, for example, the consumption and purchase of alcoholic beverages even after said age of majority), regardless of their physical, mental and sexual development as biological adults. Children generally have fewer rights and responsibilities than adults. They are generally classed as unable to make serious decisions."}}, {"canonical_name": "sensation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 59, "members": [{"entity_id": "sensation", "book_id": "principles_of_psychology_james_1890", "name": "sensation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 50, "variants": ["Sensation", "sensation"], "contexts": ["effect of attention", "awareness of stimuli"]}, {"entity_id": "sensation", "book_id": "kosmos_humboldt_1845", "name": "sensation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sensation"], "contexts": ["initial response to nature"]}, {"entity_id": "sensation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "sensation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sensation"], "contexts": ["awareness of stimuli"]}, {"entity_id": "sensation", "book_id": "first_principles_spencer_1862", "name": "sensation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["sensation"], "contexts": ["perceptual experience", "ultimately incomprehensible as the conscious something"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "sensation", "target_book": "kosmos_humboldt_1845", "target_name": "sensation", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "sensation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sensation", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "sensation", "target_book": "first_principles_spencer_1862", "target_name": "sensation", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "sensation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sensation", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "sensation", "target_book": "first_principles_spencer_1862", "target_name": "sensation", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "sensation", "target_book": "first_principles_spencer_1862", "target_name": "sensation", "similarity": 1.0}], "id": 375, "stable_key": "clu_3a348fff959c6b82-2", "ground_truth": {"modern_name": "Sensation", "confidence": "high", "type": "concept", "wikidata_id": "Q173253", "wikidata_description": "physiological capacity of organisms that provides data for perception", "wikipedia_url": "https://en.wikipedia.org/wiki/Sense", "wikipedia_extract": "A sense is a biological system used by an organism for sensation, the process of  gathering information about the surroundings through the detection of stimuli. Although, in some cultures, five human senses were traditionally identified as such (namely sight, smell, touch, taste, and hearing), many more are now recognized. Senses used by non-human organisms are even greater in variety and number. During sensation, sense organs collect various stimuli (such as a sound or smell) for transduction, meaning transformation into a form that can be understood by the brain. Sensation and perception are fundamental to nearly every aspect of an organism's cognition, behavior and thought. In organisms, a sensory organ consists of a group of interrelated sensory cells that respond to a specific type of physical stimulus."}}, {"canonical_name": "ventosidades", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 4, "total_mentions": 59, "members": [{"entity_id": "ventosidades", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "ventosidades", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 35, "variants": ["ventosidades"], "contexts": ["flatulence, resolved by the herb", "intestinal gas"]}, {"entity_id": "ventosidades_grossas", "book_id": "coloquios_da_orta_1563", "name": "ventosidades grossas", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["ventosidades grossas"], "contexts": ["thick flatulence"]}, {"entity_id": "vento\u017fidades", "book_id": "polyanthea_medicinal", "name": "vento\u017fidades", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 7, "variants": ["vento\u017fidades", "ventosidades"], "contexts": ["flatulence", "Condition caused by drinking wine too soon"]}, {"entity_id": "ventosidad", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "ventosidad", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["ventosidad"], "contexts": ["condition of flatulence or wind", "wind or gas"]}, {"entity_id": "ventosidades", "book_id": "historia_medicinal_monardes_1574", "name": "ventosidades", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 12, "variants": ["ventosidades", "ventofedad", "ventofedades", "ventoledades", "ventos", "ventosidad", "vento\u017fedades"], "contexts": ["condition resolved by preparation", "intestinal gas"]}, {"entity_id": "ventosidades", "book_id": "coloquios_da_orta_1563", "name": "ventosidades", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["ventosidades"], "contexts": ["condition resolved by galamga"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "ventosidades", "target_book": "coloquios_da_orta_1563", "target_name": "ventosidades grossas", "similarity": 0.932}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "ventosidades", "target_book": "polyanthea_medicinal", "target_name": "vento\u017fidades", "similarity": 0.979}, {"source_book": "coloquios_da_orta_1563", "source_name": "ventosidades grossas", "target_book": "polyanthea_medicinal", "target_name": "vento\u017fidades", "similarity": 0.909}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "ventosidad", "target_book": "historia_medicinal_monardes_1574", "target_name": "ventosidades", "similarity": 0.98}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "ventosidad", "target_book": "coloquios_da_orta_1563", "target_name": "ventosidades", "similarity": 0.98}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "ventosidades", "target_book": "coloquios_da_orta_1563", "target_name": "ventosidades", "similarity": 1.0}], "id": 376, "stable_key": "clu_2fb05bdebccd7438", "ground_truth": {"modern_name": "Flatulence", "confidence": "high", "type": "disease", "description": "Accumulation of gas in the digestive tract; intestinal wind.", "note": "Includes terms for intestinal gas, windiness, and flatulence.", "wikipedia_extract": "Flatulence is the expulsion of gas from the intestines via the anus, commonly referred to as farting. \"Flatus\" is the medical word for gas generated in the stomach or bowels. A proportion of intestinal gas may be swallowed environmental air; hence, flatus is not entirely generated in the stomach or bowels. The scientific study of this area of medicine is termed flatology. Passing gas is a normal bodily process. Flatus is brought to the rectum and pressurized by muscles in the intestines. It is normal to pass flatus (\"to fart\"), though volume and frequency vary greatly among individuals."}}, {"canonical_name": "h\u00famida", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 4, "total_mentions": 58, "members": [{"entity_id": "h\u00famida", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "h\u00famida", "category": "CONCEPT", "subcategory": "QUALITY", "count": 20, "variants": ["h\u00famida"], "contexts": ["temperature quality", "quality of temperature"]}, {"entity_id": "h\u00famidas", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "h\u00famidas", "category": "CONCEPT", "subcategory": "QUALITY", "count": 3, "variants": ["h\u00famidas"], "contexts": ["quality of temperature", "quality of tunas"]}, {"entity_id": "h\u00famida", "book_id": "coloquios_da_orta_1563", "name": "h\u00famida", "category": "CONCEPT", "subcategory": "QUALITY", "count": 11, "variants": ["h\u00famida", "humido", "h\u00famidas", "h\u00famido", "\u00famido"], "contexts": ["quality attributed to camphor", "quality of moisture"]}, {"entity_id": "humida", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "humida", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["humida"], "contexts": ["quality of plant, moist", "quality of nature"]}, {"entity_id": "humida", "book_id": "ricettario_fiorentino_1597", "name": "humida", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["humida"], "contexts": ["quality of an ingredient"]}, {"entity_id": "humida", "book_id": "polyanthea_medicinal", "name": "humida", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 21, "variants": ["humida", "humidade da bexiga", "humidade preci\u017famente nece\u017f\u017faria"], "contexts": ["moist", "quality of lunar rays"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "h\u00famida", "target_book": "coloquios_da_orta_1563", "target_name": "h\u00famida", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "h\u00famidas", "target_book": "coloquios_da_orta_1563", "target_name": "h\u00famida", "similarity": 0.928}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "humida", "target_book": "ricettario_fiorentino_1597", "target_name": "humida", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "humida", "target_book": "polyanthea_medicinal", "target_name": "humida", "similarity": 1.0}, {"source_book": "ricettario_fiorentino_1597", "source_name": "humida", "target_book": "polyanthea_medicinal", "target_name": "humida", "similarity": 1.0}], "id": 377, "stable_key": "clu_44347300323a2c9a", "ground_truth": {"modern_name": "Moisture", "confidence": "high", "type": "concept", "note": "Refers to the humoral quality of moistness in ancient and medieval medicine.", "wikidata_id": "Q6894868", "wikidata_description": "form of abiotic stress that occurs when the moisture of plant tissues is reduced to suboptimal levels", "wikipedia_url": "https://en.wikipedia.org/wiki/Moisture%20stress", "wikipedia_extract": "Moisture stress is a form of abiotic stress that occurs when the moisture of plant tissues is reduced to suboptimal levels. Water stress occurs in response to atmospheric and soil water availability when the transpiration rate exceeds the rate of water uptake by the roots and cells lose turgor pressure. Moisture stress is described by two main metrics, water potential and water content. Moisture stress has an effect on stomatal opening, mainly causing a closure in stomata as to reduce the amount of carbon dioxide assimilation. Closing of the stomata also slows the rate of transpiration, which limits water loss and helps to prevent the wilting effects of moisture stress. This closing can be triggered by the roots sensing dry soil and in response producing the hormone ABA which when transported up the xylem into the leaves will reduce stomatal conductance and wall extensibility of growing cells."}}, {"canonical_name": "Diamante", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 4, "total_mentions": 57, "members": [{"entity_id": "diamond", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Diamond", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 12, "variants": ["Diamond"], "contexts": ["alternative interpretation of crystal", "precious gemstone"]}, {"entity_id": "diamante", "book_id": "coloquios_da_orta_1563", "name": "Diamante", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 33, "variants": ["Diamante", "DiAMAM", "Diam\u00e3o", "diamam", "diamam naife", "diamans", "diamante", "diamante brutOy", "diamantes", "diamantes do sal", "diam\u00e3es", "diam\u00e3o"], "contexts": ["name for diamond", "precious stone"]}, {"entity_id": "diamante", "book_id": "polyanthea_medicinal", "name": "diamante", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["diamante"], "contexts": ["gem that attracts straw", "gemstone"]}, {"entity_id": "diamond", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Diamond", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 7, "variants": ["diamond", "Diamond"], "contexts": ["reflected light is elliptically polarized", "crystalline form of carbon"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Diamond", "target_book": "coloquios_da_orta_1563", "target_name": "Diamante", "similarity": 0.948}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Diamond", "target_book": "polyanthea_medicinal", "target_name": "diamante", "similarity": 0.937}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Diamond", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Diamond", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Diamante", "target_book": "polyanthea_medicinal", "target_name": "diamante", "similarity": 0.975}, {"source_book": "coloquios_da_orta_1563", "source_name": "Diamante", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Diamond", "similarity": 0.948}, {"source_book": "polyanthea_medicinal", "source_name": "diamante", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Diamond", "similarity": 0.937}], "id": 378, "stable_key": "clu_3f295d20ee4888a4", "ground_truth": {"modern_name": "diamond", "confidence": "high", "type": "mineral", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Diamond", "wikipedia_extract": "Diamond is a solid form of the element carbon with its atoms arranged in a crystal structure called diamond cubic. Diamond is tasteless, odorless, strong, brittle solid, colorless in pure form, a poor conductor of electricity, and insoluble in water. Another solid form of carbon known as graphite is the chemically stable form of carbon at room temperature and pressure, but diamond is metastable and converts to it at a negligible rate under those conditions. Diamond has the highest hardness and thermal conductivity of any natural material, properties that are used in major industrial applications such as cutting and polishing tools. Because the arrangement of atoms in diamond is extremely rigid, few types of impurity can contaminate it (two exceptions are boron and nitrogen). Small numbers of defects or impurities (about one per million of lattice atoms) can color a diamond blue (boron), yellow (nitrogen), brown (defects), green (radiation exposure), purple, pink, orange, or red."}}, {"canonical_name": "Monardes", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 4, "total_mentions": 57, "members": [{"entity_id": "monardez", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Monardez", "category": "PERSON", "subcategory": "SCHOLAR", "count": 6, "variants": ["Monardez"], "contexts": ["author discussing sangre de drago", "medical authority from Seville"]}, {"entity_id": "monardes", "book_id": "historia_medicinal_monardes_1574", "name": "Monardes", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 7, "variants": ["Monardes"], "contexts": ["author of the text on Tabaco", "author of the medicinal history"]}, {"entity_id": "monardes", "book_id": "coloquios_da_orta_1563", "name": "Monardes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 10, "variants": ["Monardes"], "contexts": ["celebrated cinnamon from America", "contemporary of Orta, described resins"]}, {"entity_id": "monardes", "book_id": "polyanthea_medicinal", "name": "Monardes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 34, "variants": ["Monardes", "Manard", "Manardes", "Manardus", "Monard"], "contexts": ["cited author on fevers and purging", "author cited for medical advice"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Monardez", "target_book": "coloquios_da_orta_1563", "target_name": "Monardes", "similarity": 0.858}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Monardez", "target_book": "polyanthea_medicinal", "target_name": "Monardes", "similarity": 0.858}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Monardes", "target_book": "coloquios_da_orta_1563", "target_name": "Monardes", "similarity": 0.692}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Monardes", "target_book": "polyanthea_medicinal", "target_name": "Monardes", "similarity": 0.692}, {"source_book": "coloquios_da_orta_1563", "source_name": "Monardes", "target_book": "polyanthea_medicinal", "target_name": "Monardes", "similarity": 1.0}], "id": 379, "stable_key": "clu_5827f161925d2d6e", "ground_truth": {"modern_name": "Nicol\u00e1s Monardes", "confidence": "high", "type": "person", "birth_year": 1512, "death_year": 1588, "description": "Spanish physician and botanist, author on American medicinal plants.", "wikidata_id": "Q950531", "wikidata_description": "Spanish botanist (1508-1588)", "wikipedia_url": "https://en.wikipedia.org/wiki/Nicol%C3%A1s%20Monardes", "wikipedia_extract": "Nicol\u00e1s Bautista Monardes (1493 \u2013 10 October 1588) was a Spanish physician and botanist. Monardes published several books of varying importance. In Di\u00e1logo llamado pharmacodilosis (1536), he examines humanism and suggests studying several classical authors, principally Pedanius Dioscorides. He discusses the importance of Greek and Arab medicine in De Secanda Vena in pleuriti Inter Grecos et Arabes Concordia (1539). De Rosa et partibus eius (1540) is about roses and citrus fruits. It is known that Monardes also believed that tobacco smoke was an infallible panacea."}}, {"canonical_name": "Madrid", "category": "PLACE", "subcategory": "CITY", "book_count": 4, "total_mentions": 55, "members": [{"entity_id": "madrid", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Madrid", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Madrid", "madrid"], "contexts": ["city in Spain", "villa and royal court"]}, {"entity_id": "madrid", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Madrid", "category": "PLACE", "subcategory": "CITY", "count": 45, "variants": ["Madrid"], "contexts": ["city where Portulano was published", "city name"]}, {"entity_id": "madrid", "book_id": "kosmos_humboldt_1845", "name": "Madrid", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Madrid"], "contexts": ["court of Madrid"]}, {"entity_id": "madrid", "book_id": "coloquios_da_orta_1563", "name": "Madrid", "category": "PLACE", "subcategory": "CITY", "count": 5, "variants": ["Madrid"], "contexts": ["city where book was published", "city of publication"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Madrid", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Madrid", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Madrid", "target_book": "kosmos_humboldt_1845", "target_name": "Madrid", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Madrid", "target_book": "coloquios_da_orta_1563", "target_name": "Madrid", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Madrid", "target_book": "kosmos_humboldt_1845", "target_name": "Madrid", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Madrid", "target_book": "coloquios_da_orta_1563", "target_name": "Madrid", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Madrid", "target_book": "coloquios_da_orta_1563", "target_name": "Madrid", "similarity": 1.0}], "id": 380, "stable_key": "clu_873aed685508f355", "ground_truth": {"modern_name": "Madrid", "confidence": "high", "type": "PLACE", "description": "Capital city of Spain, a significant location in historical texts.", "wikipedia_extract": "Madrid is the capital and most populous city of Spain. It had a population of over 3.4 million in the city proper in 2025, and a metropolitan area population of approximately 6.8 million. Madrid is the second-largest city in the European Union (EU), after Berlin, and its metropolitan area is the second-largest in the EU, after Paris. The municipality covers an area of 605.77 km2 (233.89 sq mi). Madrid lies on the River Manzanares in the central part of the Iberian Peninsula at about 660 m (2,170 ft) above mean sea level. The capital city of both Spain and the surrounding autonomous community of Madrid, it is the political, economic and cultural centre of the country."}}, {"canonical_name": "magnetism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 54, "members": [{"entity_id": "magnetisms", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Magnetisms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Magnetisms"], "contexts": ["forces of attraction and repulsion"]}, {"entity_id": "magnetism", "book_id": "kosmos_humboldt_1845", "name": "Magnetism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 11, "variants": ["magnetism", "Magnetism"], "contexts": ["fundamental force of attraction/repulsion", "force of attraction or repulsion"]}, {"entity_id": "magnetism", "book_id": "connexion_physical_sciences_somerville_1858", "name": "magnetism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 41, "variants": ["magnetism", "Magnetism"], "contexts": ["fundamental force and phenomenon", "force of attraction/repulsion"]}, {"entity_id": "magnetization", "book_id": "first_principles_spencer_1862", "name": "magnetization", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["magnetization"], "contexts": ["process of becoming magnetic"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Magnetisms", "target_book": "kosmos_humboldt_1845", "target_name": "Magnetism", "similarity": 0.943}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Magnetisms", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetism", "similarity": 0.915}, {"source_book": "kosmos_humboldt_1845", "source_name": "Magnetism", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetism", "similarity": 0.976}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "magnetism", "target_book": "first_principles_spencer_1862", "target_name": "magnetization", "similarity": 0.881}], "id": 381, "stable_key": "clu_6a02f508eda7b925", "ground_truth": {"modern_name": "magnetism", "confidence": "high", "type": "concept", "wikidata_id": "Q3294789", "wikidata_description": "class of physical phenomena", "wikipedia_url": "https://en.wikipedia.org/wiki/Magnetism", "wikipedia_extract": "Magnetism is the class of physical attributes that occur through a magnetic field, which allows objects to attract or repel each other. Because both electric currents and magnetic moments of elementary particles give rise to a magnetic field, magnetism is one of two aspects of electromagnetism. The most familiar effects occur in ferromagnetic materials, which are strongly attracted by magnetic fields and can be magnetized to become permanent magnets, producing magnetic fields themselves. Demagnetizing a magnet is also possible. Only a few substances are ferromagnetic; the most common ones are iron, cobalt, nickel, and their alloys. All substances exhibit some type of magnetism."}}, {"canonical_name": "Locke", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 4, "total_mentions": 54, "members": [{"entity_id": "locke", "book_id": "principles_of_psychology_james_1890", "name": "Locke", "category": "PERSON", "subcategory": "SCHOLAR", "count": 34, "variants": ["Locke"], "contexts": ["philosopher on consciousness", "philosopher on discrimination"]}, {"entity_id": "hooke", "book_id": "kosmos_humboldt_1845", "name": "Hooke", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Hooke"], "contexts": ["early figure in magnetism studies", "lofty mind, considered chronometry of earth"]}, {"entity_id": "hooker", "book_id": "coloquios_da_orta_1563", "name": "Hooker", "category": "PERSON", "subcategory": "SCHOLAR", "count": 15, "variants": ["Hooker", "Hecker"], "contexts": ["scholar who referenced Flora of British India", "author of Flora of British India"]}, {"entity_id": "locke", "book_id": "first_principles_spencer_1862", "name": "Locke", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Locke"], "contexts": ["philosopher influencing psychology"]}, {"entity_id": "hooke", "book_id": "first_principles_spencer_1862", "name": "Hooke", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Hooke"], "contexts": ["experimenter on spinning tops and motion"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Locke", "target_book": "kosmos_humboldt_1845", "target_name": "Hooke", "similarity": 0.879}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Locke", "target_book": "first_principles_spencer_1862", "target_name": "Locke", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Locke", "target_book": "first_principles_spencer_1862", "target_name": "Hooke", "similarity": 0.879}, {"source_book": "kosmos_humboldt_1845", "source_name": "Hooke", "target_book": "coloquios_da_orta_1563", "target_name": "Hooker", "similarity": 0.902}, {"source_book": "kosmos_humboldt_1845", "source_name": "Hooke", "target_book": "first_principles_spencer_1862", "target_name": "Locke", "similarity": 0.879}, {"source_book": "kosmos_humboldt_1845", "source_name": "Hooke", "target_book": "first_principles_spencer_1862", "target_name": "Hooke", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Hooker", "target_book": "first_principles_spencer_1862", "target_name": "Hooke", "similarity": 0.902}], "id": 382, "stable_key": "clu_fe43adfa2482dce7", "ground_truth": {"modern_name": "John Locke", "confidence": "high", "type": "person", "birth_year": 1632, "death_year": 1704, "description": "Philosopher of consciousness and empiricism, influenced psychology.", "note": "The cluster mentions 'Hooke' and 'Hooker'. John Locke is the primary figure due to the strong association with 'principles_of_psychology_james_1890' and his philosophical significance.", "wikidata_id": "Q9353", "wikidata_description": "English philosopher and physician (1632\u20131704)", "wikipedia_url": "https://en.wikipedia.org/wiki/John%20Locke", "wikipedia_extract": "John Locke (; 29 August 1632 (O.S.) \u2013 28 October 1704 (O.S.)) was an English philosopher and physician, widely regarded as one of the most influential of the Enlightenment thinkers and commonly known as the \"father of liberalism\". His important works include A Letter Concerning Toleration (1689), Two Treatises of Government (1689/90), both published anonymously, and An Essay Concerning Human Understanding (1689/90). His writing on toleration contends that religion is a matter for the individual and that the churches are voluntary associations, ruling out religious coercion and uniformity; these lead to the idea of separation of church and state. His Two Treatises on Government argues for government based on the consent of the governed and the right to revolt against tyrannous government, which has lost consent. The Two Treatises had a direct influence on the language that Thomas Jefferson chose in his drafting the July 1776 Declaration of Independence during the American Revolution. Locke lived through the tumultuous political era of the English Civil War and Commonwealth of England after the execution of Charles I, Restoration of the Stuart monarchy, and the 1688 Glorious Revolution."}}, {"canonical_name": "mal franc\u00e9s", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 4, "total_mentions": 53, "members": [{"entity_id": "french_diseas", "book_id": "english_physician_1652", "name": "French Diseas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 6, "variants": ["French Diseas", "French Disease"], "contexts": ["syphilis", "disease treated by compound syrup"]}, {"entity_id": "mal_franc\u00e9s", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "mal franc\u00e9s", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 38, "variants": ["mal franc\u00e9s"], "contexts": ["disease treated by huitzxochitl bark", "syphilis, a historical disease"]}, {"entity_id": "mal_frances", "book_id": "historia_medicinal_monardes_1574", "name": "mal Frances", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["mal Frances"], "contexts": ["name for the disease"]}, {"entity_id": "mala_franc^os", "book_id": "coloquios_da_orta_1563", "name": "mala Franc^os", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 8, "variants": ["mala Franc^os", "mal dei frangues", "mal france", "mal francei", "malpa francesa"], "contexts": ["name for syphilis meaning French disease", "name for a disease, likely syphilis"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "French Diseas", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "mal franc\u00e9s", "similarity": 0.925}, {"source_book": "english_physician_1652", "source_name": "French Diseas", "target_book": "historia_medicinal_monardes_1574", "target_name": "mal Frances", "similarity": 0.914}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "mal franc\u00e9s", "target_book": "historia_medicinal_monardes_1574", "target_name": "mal Frances", "similarity": 0.948}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "mal franc\u00e9s", "target_book": "coloquios_da_orta_1563", "target_name": "mala Franc^os", "similarity": 0.898}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "mal Frances", "target_book": "coloquios_da_orta_1563", "target_name": "mala Franc^os", "similarity": 0.885}], "id": 383, "stable_key": "clu_e46c17123aad44b4", "ground_truth": {"modern_name": "Syphilis", "confidence": "high", "type": "disease", "modern_term": "Syphilis", "note": "The term 'mala Franc^os' or 'mal Frances' was a common historical name for syphilis, meaning 'French evil'.", "wikidata_id": "Q18966640", "wikidata_description": "human disease", "description": "A sexually transmitted infection caused by the bacterium Treponema pallidum.", "wikipedia_extract": "Syphilis () is a sexually transmitted infection caused by the bacterium Treponema pallidum subspecies pallidum. The signs and symptoms depend on the stage it presents: primary, secondary, latent or tertiary. The primary stage classically presents with a single chancre (a firm, painless, non-itchy skin ulceration usually between 1 cm and 2 cm in diameter), though there may be multiple sores. In secondary syphilis, a diffuse rash occurs, which frequently involves the palms of the hands and soles of the feet. There may also be sores in the mouth or vagina. Latent syphilis has no symptoms and can last years."}}, {"canonical_name": "volcans", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 52, "members": [{"entity_id": "volcans", "book_id": "epoques_nature_buffon_1778", "name": "volcans", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 18, "variants": ["volcans"], "contexts": ["geological phenomena causing earth tremors", "geological formations with eruptions"]}, {"entity_id": "volcans", "book_id": "relation_historique_humboldt_vol3_1825", "name": "volcans", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 31, "variants": ["volcans", "Volcancitos", "Volcans", "Volcans d'air", "Volcans de Guatimala", "Volcans des Antilles", "volcans boueux", "volcans d'air", "volcans de tdrbaco"], "contexts": ["natural phenomena", "natural geological formations"]}, {"entity_id": "terrestrial_volcanoes", "book_id": "kosmos_humboldt_1845", "name": "terrestrial volcanoes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["terrestrial volcanoes"], "contexts": ["volcanic force on Earth", "volcanoes on Earth"]}, {"entity_id": "volcanoes", "book_id": "first_principles_spencer_1862", "name": "volcanoes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["volcanoes"], "contexts": ["vents for molten rock and gases"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "volcans", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "volcans", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "volcans", "target_book": "kosmos_humboldt_1845", "target_name": "terrestrial volcanoes", "similarity": 0.953}, {"source_book": "epoques_nature_buffon_1778", "source_name": "volcans", "target_book": "first_principles_spencer_1862", "target_name": "volcanoes", "similarity": 0.989}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "volcans", "target_book": "kosmos_humboldt_1845", "target_name": "terrestrial volcanoes", "similarity": 0.953}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "volcans", "target_book": "first_principles_spencer_1862", "target_name": "volcanoes", "similarity": 0.989}, {"source_book": "kosmos_humboldt_1845", "source_name": "terrestrial volcanoes", "target_book": "first_principles_spencer_1862", "target_name": "volcanoes", "similarity": 0.959}], "id": 384, "stable_key": "clu_17ddf275cf6420ce", "ground_truth": {"modern_name": "Volcano", "confidence": "high", "type": "place", "wikidata_id": "Q2428769", "wikidata_description": "census-designated place (CDP) in Hawaii County, Hawaii, United States", "wikipedia_url": "https://en.wikipedia.org/wiki/Volcano%2C%20Hawaii", "wikipedia_extract": "Volcano, or Volcano Village, is a census-designated place (CDP) in Hawaii County, Hawaii, United States located in the District of Puna with a small portion of the CDP in the District of Ka\u02bb\u016b. The population was 2,575 at the 2010 census, up from 2,231 at the 2000 census. Volcano is located on the east side of the island of Hawai\u02bbi, on the border of Hawaii Volcanoes National Park and near the northeast rim of K\u012blauea's summit caldera. According to the United States Census Bureau, the CDP has a total area of 58.6 square miles (151.7 km2), all of it land. Hawaii Route 11 passes through the southern part of the community, leading northeast 27 miles (43 km) to Hilo and southwest 37 miles (60 km) to N\u0101\u02bb\u0101lehu. Its altitude ranges from below 2,800 feet (850 m) in the southeast to over 6,200 feet (1,900 m) at its uninhabited northern end."}}, {"canonical_name": "distilled Water", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 4, "total_mentions": 50, "members": [{"entity_id": "distilled_water", "book_id": "english_physician_1652", "name": "distilled Water", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 47, "variants": ["distilled Water", "Distilled Water", "Distilled Waters", "Distilled water", "distilled water", "distil\u2223led Water", "dististilled Water"], "contexts": ["liquid prepared by distillation", "water from plantain used for washing sores"]}, {"entity_id": "distilled_water", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "distilled water", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["distilled water"], "contexts": ["water obtained by distillation"]}, {"entity_id": "agua_destilada", "book_id": "historia_medicinal_monardes_1574", "name": "agua destilada", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["agua destilada"], "contexts": ["distilled water of the herb"]}, {"entity_id": "distilled_water", "book_id": "connexion_physical_sciences_somerville_1858", "name": "distilled water", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["distilled water"], "contexts": ["used for washing the plate"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "distilled Water", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "distilled water", "similarity": 0.871}, {"source_book": "english_physician_1652", "source_name": "distilled Water", "target_book": "historia_medicinal_monardes_1574", "target_name": "agua destilada", "similarity": 0.942}, {"source_book": "english_physician_1652", "source_name": "distilled Water", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "distilled water", "similarity": 0.871}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "distilled water", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "distilled water", "similarity": 1.0}], "id": 385, "stable_key": "clu_55349767f64b3924", "ground_truth": {"modern_name": "distilled water", "confidence": "high", "type": "chemical", "wikidata_id": "Q274959", "wikidata_description": "water that has had many of its impurities removed through distillation", "wikipedia_url": "https://en.wikipedia.org/wiki/Distilled%20water", "wikipedia_extract": "Distilled water is water that has been purified by boiling it into vapor and condensing the vapor back into liquid in a separate container. Any impurities in the original water, such as non-volatile or mineral components, that do not boil below or near the boiling point of water remain in the original container. For example, water escaping as steam from a boiler of heating system or steam engine, leaves behind any dissolved materials, which leads to mineral deposits known as boiler scale. In general, non-purified water can leave behind mineral deposits, or could cause or interfere with chemical reactions. Distillation is a method for removing impurities from water and other fluids. Distilled water has not been proven to be healthier for drinking than hard water."}}, {"canonical_name": "Mesue", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 4, "total_mentions": 50, "members": [{"entity_id": "mesue", "book_id": "english_physician_1652", "name": "Mesue", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Mesue"], "contexts": ["medieval medical authority"]}, {"entity_id": "mesue", "book_id": "coloquios_da_orta_1563", "name": "Mesue", "category": "PERSON", "subcategory": "AUTHORITY", "count": 40, "variants": ["Mesue", "Mesuc", "Mesu\u00e9"], "contexts": ["ancient author criticized", "ancient medical authority"]}, {"entity_id": "mesurunge", "book_id": "coloquios_da_orta_1563", "name": "Mesurunge", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Mesurunge"], "contexts": ["authority for Sarapiam"]}, {"entity_id": "mesue", "book_id": "ricettario_fiorentino_1597", "name": "Mesue", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Mesue"], "contexts": ["medieval medical authority", "ancient medical authority"]}, {"entity_id": "me\u017fues", "book_id": "polyanthea_medicinal", "name": "Me\u017fues", "category": "PERSON", "subcategory": "AUTHORITY", "count": 6, "variants": ["Me\u017fues", "Mesues"], "contexts": ["cited for a book on fevers", "medical authority cited"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Mesue", "target_book": "coloquios_da_orta_1563", "target_name": "Mesue", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Mesue", "target_book": "coloquios_da_orta_1563", "target_name": "Mesurunge", "similarity": 0.88}, {"source_book": "english_physician_1652", "source_name": "Mesue", "target_book": "ricettario_fiorentino_1597", "target_name": "Mesue", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Mesue", "target_book": "polyanthea_medicinal", "target_name": "Me\u017fues", "similarity": 0.89}, {"source_book": "coloquios_da_orta_1563", "source_name": "Mesue", "target_book": "ricettario_fiorentino_1597", "target_name": "Mesue", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Mesue", "target_book": "polyanthea_medicinal", "target_name": "Me\u017fues", "similarity": 0.89}, {"source_book": "coloquios_da_orta_1563", "source_name": "Mesurunge", "target_book": "ricettario_fiorentino_1597", "target_name": "Mesue", "similarity": 0.88}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Mesue", "target_book": "polyanthea_medicinal", "target_name": "Me\u017fues", "similarity": 0.89}], "id": 386, "stable_key": "clu_0b783f1aa98bc174", "ground_truth": {"modern_name": "Mesue the Younger", "confidence": "high", "type": "person", "description": "Influential medieval Arab physician and pharmacologist.", "note": "Multiple spellings suggest the same figure, a prominent medieval medical authority whose works were widely translated and used.", "wikidata_id": "Q3297191", "wikidata_description": "Syrian physician", "wikipedia_url": "https://en.wikipedia.org/wiki/Masawaih%20al-Mardini", "wikipedia_extract": "Masawaih al-Mardini (Yahy\u0101 ibn Masawaih al-Mardini; known as Mesue the Younger) was a physician. He was born in Iraq. After working in Baghdad, he entered the service of the Fatimid caliph Al-Hakim bi-Amr Allah. He died in 1015 in Cairo at the age of ninety. Masawaih al-Mardini was a Syriac Orthodox Christian. He is known due to his books on purgatives and emetics (De medicins laxativis) and on the complete pharmacopoeia in 12 parts called the Antidotarium sive Grabadin medicamentorum, which remained for centuries the standard textbook of pharmacy in the West."}}, {"canonical_name": "feeling", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 50, "members": [{"entity_id": "feeling", "book_id": "english_physician_1652", "name": "Feeling", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Feeling"], "contexts": ["sense of touch"]}, {"entity_id": "feeling", "book_id": "principles_of_psychology_james_1890", "name": "feeling", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 41, "variants": ["feeling", "FEELING", "Feeling"], "contexts": ["emotional state", "emotional experience"]}, {"entity_id": "feeling", "book_id": "kosmos_humboldt_1845", "name": "feeling", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["feeling"], "contexts": ["emotional state"]}, {"entity_id": "feeling", "book_id": "first_principles_spencer_1862", "name": "feeling", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["feeling"], "contexts": ["emotional experience", "an emotional state or sensation"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Feeling", "target_book": "principles_of_psychology_james_1890", "target_name": "feeling", "similarity": 0.956}, {"source_book": "english_physician_1652", "source_name": "Feeling", "target_book": "kosmos_humboldt_1845", "target_name": "feeling", "similarity": 0.956}, {"source_book": "english_physician_1652", "source_name": "Feeling", "target_book": "first_principles_spencer_1862", "target_name": "feeling", "similarity": 0.956}, {"source_book": "principles_of_psychology_james_1890", "source_name": "feeling", "target_book": "kosmos_humboldt_1845", "target_name": "feeling", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "feeling", "target_book": "first_principles_spencer_1862", "target_name": "feeling", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "feeling", "target_book": "first_principles_spencer_1862", "target_name": "feeling", "similarity": 1.0}], "id": 387, "stable_key": "clu_37940425523d6f0f", "ground_truth": {"modern_name": "Feeling", "confidence": "high", "type": "concept", "note": "Refers to the subjective experience of emotions or sensations, particularly touch.", "wikidata_id": "Q205555", "wikidata_description": "conscious subjective experience of emotion", "wikipedia_url": "https://en.wikipedia.org/wiki/Feeling", "wikipedia_extract": "According to the APA Dictionary of Psychology, a feeling is \"a self-contained phenomenal experience\"; feelings are \"subjective, evaluative, and independent of the sensations, thoughts, or images evoking them\". The term feeling is closely related to, but not the same as, emotion. Feeling may, for instance, refer to the conscious subjective experience of emotions. The study of subjective experiences is called phenomenology. Psychotherapy generally involves a therapist helping a client understand, articulate, and learn to effectively regulate the client's own feelings, and ultimately to take responsibility for the client's experience of the world. Feelings are sometimes held to be characteristic of embodied consciousness."}}, {"canonical_name": "fria", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 4, "total_mentions": 49, "members": [{"entity_id": "fria", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "fria", "category": "CONCEPT", "subcategory": "QUALITY", "count": 26, "variants": ["fria"], "contexts": ["quality of cause", "nature of plant"]}, {"entity_id": "frias", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "frias", "category": "CONCEPT", "subcategory": "QUALITY", "count": 4, "variants": ["frias"], "contexts": ["regions where plant grows", "nature cold or somewhat temperate"]}, {"entity_id": "frias", "book_id": "relation_historique_humboldt_vol3_1825", "name": "frias", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["frias"], "contexts": ["classification of lands"]}, {"entity_id": "fria", "book_id": "historia_medicinal_monardes_1574", "name": "fria", "category": "CONCEPT", "subcategory": "QUALITY", "count": 8, "variants": ["fria", "frialdad", "frias"], "contexts": ["quality of illness", "cold quality of a herb"]}, {"entity_id": "fria", "book_id": "coloquios_da_orta_1563", "name": "fria", "category": "CONCEPT", "subcategory": "QUALITY", "count": 10, "variants": ["fria", "Frias", "frialdade"], "contexts": ["quality attributed to camphor", "cold quality of the herb"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "fria", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "frias", "similarity": 0.941}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "fria", "target_book": "historia_medicinal_monardes_1574", "target_name": "fria", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "fria", "target_book": "coloquios_da_orta_1563", "target_name": "fria", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "frias", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "frias", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "frias", "target_book": "historia_medicinal_monardes_1574", "target_name": "fria", "similarity": 0.941}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "frias", "target_book": "coloquios_da_orta_1563", "target_name": "fria", "similarity": 0.941}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "frias", "target_book": "historia_medicinal_monardes_1574", "target_name": "fria", "similarity": 0.941}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "frias", "target_book": "coloquios_da_orta_1563", "target_name": "fria", "similarity": 0.941}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "fria", "target_book": "coloquios_da_orta_1563", "target_name": "fria", "similarity": 1.0}], "id": 388, "stable_key": "clu_06ad6c064ed8b34c-2", "ground_truth": {"modern_name": "cold", "confidence": "high", "type": "concept", "wikidata_id": "Q199804", "wikidata_description": "lung disease involving long-term poor airflow", "wikipedia_url": "https://en.wikipedia.org/wiki/Chronic%20obstructive%20pulmonary%20disease", "note": "Refers to the physical sensation and thermodynamic state of low temperature, as well as its perceived qualities in historical medical contexts.", "wikipedia_extract": "Chronic obstructive pulmonary disease (COPD) is a type of progressive lung disease characterized by chronic respiratory symptoms and airflow limitation. GOLD defines COPD as a heterogeneous lung condition characterized by chronic respiratory symptoms (shortness of breath, cough, sputum production or exacerbations) due to abnormalities of the airways (bronchitis, bronchiolitis) or alveoli (emphysema) that cause persistent, often progressive, airflow obstruction. The main symptoms of COPD include shortness of breath and a cough, which may or may not produce mucus. COPD progressively worsens, with everyday activities such as walking or dressing becoming difficult. While COPD is incurable, it is preventable and treatable. The two most common types of COPD are emphysema and chronic bronchitis, and have been the two classic COPD phenotypes."}}, {"canonical_name": "equilibrium", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 49, "members": [{"entity_id": "equilibrium", "book_id": "principles_of_psychology_james_1890", "name": "equilibrium", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["equilibrium"], "contexts": ["state of balance", "state of balance or stability"]}, {"entity_id": "equilibrium", "book_id": "kosmos_humboldt_1845", "name": "equilibrium", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["equilibrium"], "contexts": ["state of balance", "state disturbed at poles"]}, {"entity_id": "equilibrium", "book_id": "connexion_physical_sciences_somerville_1858", "name": "equilibrium", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 11, "variants": ["equilibrium"], "contexts": ["state of balance", "state of balance in electrical charge"]}, {"entity_id": "equilibrium", "book_id": "first_principles_spencer_1862", "name": "equilibrium", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 19, "variants": ["equilibrium"], "contexts": ["balance between constitution and conditions", "state of balance in forces"]}, {"entity_id": "equilibration", "book_id": "first_principles_spencer_1862", "name": "equilibration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 14, "variants": ["equilibration", "Equilibration"], "contexts": ["process of reaching a stable state", "progress toward balance of forces"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "equilibrium", "target_book": "kosmos_humboldt_1845", "target_name": "equilibrium", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "equilibrium", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "equilibrium", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "equilibrium", "target_book": "first_principles_spencer_1862", "target_name": "equilibrium", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "equilibrium", "target_book": "first_principles_spencer_1862", "target_name": "equilibration", "similarity": 0.937}, {"source_book": "kosmos_humboldt_1845", "source_name": "equilibrium", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "equilibrium", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "equilibrium", "target_book": "first_principles_spencer_1862", "target_name": "equilibrium", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "equilibrium", "target_book": "first_principles_spencer_1862", "target_name": "equilibration", "similarity": 0.937}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "equilibrium", "target_book": "first_principles_spencer_1862", "target_name": "equilibrium", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "equilibrium", "target_book": "first_principles_spencer_1862", "target_name": "equilibration", "similarity": 0.937}], "id": 389, "stable_key": "clu_568176e5600b64c0", "ground_truth": {"modern_name": "Equilibrium", "confidence": "high", "type": "concept", "wikidata_id": "Q1530271", "wikidata_description": "constant solution to a differential equation", "wikipedia_url": "https://en.wikipedia.org/wiki/Equilibrium%20point%20%28mathematics%29", "wikipedia_extract": "In mathematics, specifically in differential equations, an equilibrium point is a constant solution to a differential equation."}}, {"canonical_name": "Faraday", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 4, "total_mentions": 49, "members": [{"entity_id": "faraday", "book_id": "principles_of_psychology_james_1890", "name": "Faraday", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Faraday"], "contexts": ["example of departed spirit"]}, {"entity_id": "faraday", "book_id": "kosmos_humboldt_1845", "name": "Faraday", "category": "PERSON", "subcategory": "SCHOLAR", "count": 9, "variants": ["Faraday"], "contexts": ["scientist known for electromagnetic induction", "scientist mentioned with Melloni"]}, {"entity_id": "faraday", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Faraday", "category": "PERSON", "subcategory": "SCHOLAR", "count": 37, "variants": ["Faraday"], "contexts": ["discovered affinity properties", "reduced gases to liquid state by compression"]}, {"entity_id": "faraday", "book_id": "first_principles_spencer_1862", "name": "Faraday", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Faraday"], "contexts": ["discovered magnetism's effect on polarized light", "scientist studying electricity and magnetism"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Faraday", "target_book": "kosmos_humboldt_1845", "target_name": "Faraday", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Faraday", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Faraday", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Faraday", "target_book": "first_principles_spencer_1862", "target_name": "Faraday", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Faraday", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Faraday", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Faraday", "target_book": "first_principles_spencer_1862", "target_name": "Faraday", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Faraday", "target_book": "first_principles_spencer_1862", "target_name": "Faraday", "similarity": 1.0}], "id": 390, "stable_key": "clu_5f273b6e2aefc44b", "ground_truth": {"modern_name": "Michael Faraday", "confidence": "high", "type": "person", "birth_year": 1791, "death_year": 1867, "description": "English scientist known for electromagnetism and electrochemistry", "wikidata_id": "Q8750", "wikidata_description": "British scientist (1791\u20131867)", "wikipedia_url": "https://en.wikipedia.org/wiki/Michael%20Faraday", "wikipedia_extract": "Michael Faraday ( FAR-uh-day; 22 September 1791 \u2013 25 August 1867) was an English chemist and physicist who contributed to the study of electrochemistry and electromagnetism. His main discoveries include the principles underlying electromagnetic induction, diamagnetism, and electrolysis. Although Faraday received little formal education, as a self-made man, he was one of the most influential scientists in history. It was by his research on the magnetic field around a conductor carrying a direct current that Faraday established the concept of the electromagnetic field in physics. Faraday also established that magnetism could affect rays of light and that there was an underlying relationship between the two phenomena. He similarly discovered the principles of electromagnetic induction, diamagnetism, and the laws of electrolysis."}}, {"canonical_name": "Sugar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 4, "total_mentions": 48, "members": [{"entity_id": "sugar", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Sugar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["Sugar"], "contexts": ["sweet crystalline substance", "congelation that sinks in thin water"]}, {"entity_id": "sugar", "book_id": "english_physician_1652", "name": "Sugar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 38, "variants": ["Sugar"], "contexts": ["sweetener dissolved in remedy", "syrup made of juice and sugar"]}, {"entity_id": "sugar", "book_id": "principles_of_psychology_james_1890", "name": "sugar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["sugar"], "contexts": ["substance applied to tongue", "sweet crystalline substance"]}, {"entity_id": "sugar", "book_id": "connexion_physical_sciences_somerville_1858", "name": "sugar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["sugar"], "contexts": ["absorbs moisture via capillary action", "solid form of grape syrup"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Sugar", "target_book": "english_physician_1652", "target_name": "Sugar", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "sugar", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sugar", "similarity": 1.0}], "id": 391, "stable_key": "clu_e250c7e76f6789aa", "ground_truth": {"modern_name": "Sugar", "confidence": "high", "type": "substance", "description": "Sweet crystalline substance derived from plants, used as a sweetener.", "note": "Refers to the substance itself, distinct from the plant.", "wikipedia_extract": "Sugar () is a class of sweet-tasting, soluble carbohydrates, many of which are used in food. Simple sugars, also called monosaccharides, include glucose, fructose, and galactose. Compound sugars, also called disaccharides or double sugars, are molecules made of two bonded monosaccharides; common examples are sucrose (glucose + fructose), lactose (glucose + galactose), and maltose (two molecules of glucose). White sugar is almost pure sucrose. During digestion, compound sugars are hydrolysed into simple sugars. Longer chains of saccharides are not regarded as sugars, and are called oligosaccharides or polysaccharides."}}, {"canonical_name": "man", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 4, "total_mentions": 47, "members": [{"entity_id": "man", "book_id": "english_physician_1652", "name": "Man", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 11, "variants": ["Man", "Men", "man"], "contexts": ["human being", "used to refer to humans in general"]}, {"entity_id": "man", "book_id": "principles_of_psychology_james_1890", "name": "man", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 21, "variants": ["man"], "contexts": ["human being", "human subject of observation"]}, {"entity_id": "man", "book_id": "connexion_physical_sciences_somerville_1858", "name": "man", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["man"], "contexts": ["human inhabitant of earth", "interferes with quadruped distribution"]}, {"entity_id": "man", "book_id": "first_principles_spencer_1862", "name": "man", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 13, "variants": ["Man", "man"], "contexts": ["human species, recent appearance", "human species"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Man", "target_book": "principles_of_psychology_james_1890", "target_name": "man", "similarity": 0.994}, {"source_book": "english_physician_1652", "source_name": "Man", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "man", "similarity": 0.994}, {"source_book": "english_physician_1652", "source_name": "Man", "target_book": "first_principles_spencer_1862", "target_name": "man", "similarity": 0.994}, {"source_book": "principles_of_psychology_james_1890", "source_name": "man", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "man", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "man", "target_book": "first_principles_spencer_1862", "target_name": "man", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "man", "target_book": "first_principles_spencer_1862", "target_name": "man", "similarity": 1.0}], "id": 392, "stable_key": "clu_e4527c6d10687df7", "ground_truth": {"modern_name": "Human being", "confidence": "high", "type": "concept", "note": "Refers to the general concept of a human