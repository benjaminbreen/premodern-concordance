e_experimentale_bernard_1865", "name": "world", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["world"], "contexts": ["different conditions would create another"]}, {"entity_id": "world", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "World", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["World"], "contexts": ["the Earth and its inhabitants"]}, {"entity_id": "world", "book_id": "origin_of_species_darwin_1859", "name": "World", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["world", "World"], "contexts": ["the Earth", "One quarter of the world"]}, {"entity_id": "world", "book_id": "kosmos_humboldt_1845", "name": "world", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["world"], "contexts": ["the totality of existence", "the universe and its inhabitants"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "world", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "World", "similarity": 0.994}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "world", "target_book": "origin_of_species_darwin_1859", "target_name": "World", "similarity": 0.994}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "world", "target_book": "kosmos_humboldt_1845", "target_name": "world", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "World", "target_book": "origin_of_species_darwin_1859", "target_name": "World", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "World", "target_book": "kosmos_humboldt_1845", "target_name": "world", "similarity": 0.994}, {"source_book": "origin_of_species_darwin_1859", "source_name": "World", "target_book": "kosmos_humboldt_1845", "target_name": "world", "similarity": 0.994}], "id": 655, "stable_key": "clu_b199acae0a826eca", "ground_truth": {"modern_name": "World", "confidence": "high", "type": "place", "wikidata_id": "Q189289", "wikidata_description": "international sport governing body", "wikipedia_url": "https://en.wikipedia.org/wiki/World%20Aquatics", "wikipedia_extract": "World Aquatics, formerly known as FINA (French: F\u00e9d\u00e9ration internationale de natation; English: International Swimming Federation), is the international federation recognised by the International Olympic Committee (IOC) for administering international competitions in water sports. It is one of several international federations which administer a given sport or discipline for both the IOC and the international community. It is based in Lausanne, Switzerland. Founded as FINA (F\u00e9d\u00e9ration internationale de natation; International Swimming Federation) in 1908, the federation was officially renamed World Aquatics in January 2023. World Aquatics currently oversees competition in six aquatics sports: artistic swimming, water polo, and open water swimming. World Aquatics also oversees Masters competition (for competitors aged 18 years and older) in its disciplines and also hosts the World Aquatics Masters Championships (for competitors aged 25 years and older)."}}, {"canonical_name": "organs of motion", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 9, "members": [{"entity_id": "organs_of_motion", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "organs of motion", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["organs of motion"], "contexts": ["body parts for movement", "body parts responsible for movement"]}, {"entity_id": "organs_of_locomotion", "book_id": "origin_of_species_darwin_1859", "name": "organs of locomotion", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["organs of locomotion"], "contexts": ["body parts for movement"]}, {"entity_id": "bodily_motions", "book_id": "principles_of_psychology_james_1890", "name": "bodily motions", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["bodily motions"], "contexts": ["movements of the physical body"]}, {"entity_id": "body_moving", "book_id": "principles_of_psychology_james_1890", "name": "body moving", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["body moving"], "contexts": ["object in motion"]}, {"entity_id": "bodily_movements", "book_id": "principles_of_psychology_james_1890", "name": "bodily movements", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["bodily movements"], "contexts": ["physical actions of the body"]}, {"entity_id": "muscular_movements", "book_id": "first_principles_spencer_1862", "name": "muscular movements", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["muscular movements"], "contexts": ["actions of muscles", "actions performed by muscles"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "organs of motion", "target_book": "origin_of_species_darwin_1859", "target_name": "organs of locomotion", "similarity": 0.959}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "organs of motion", "target_book": "principles_of_psychology_james_1890", "target_name": "bodily motions", "similarity": 0.91}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "organs of motion", "target_book": "principles_of_psychology_james_1890", "target_name": "body moving", "similarity": 0.927}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "organs of motion", "target_book": "principles_of_psychology_james_1890", "target_name": "bodily movements", "similarity": 0.91}, {"source_book": "principles_of_psychology_james_1890", "source_name": "bodily motions", "target_book": "first_principles_spencer_1862", "target_name": "muscular movements", "similarity": 0.952}, {"source_book": "principles_of_psychology_james_1890", "source_name": "body moving", "target_book": "first_principles_spencer_1862", "target_name": "muscular movements", "similarity": 0.925}, {"source_book": "principles_of_psychology_james_1890", "source_name": "bodily movements", "target_book": "first_principles_spencer_1862", "target_name": "muscular movements", "similarity": 0.952}], "id": 656, "stable_key": "clu_fa75a8068e7c9a41", "ground_truth": {"modern_name": "Musculoskeletal System", "confidence": "medium", "type": "concept", "note": "The term 'organs of motion' is archaic and refers broadly to the structures enabling movement, best captured by the musculoskeletal system.", "wikidata_id": "Q4116663", "wikidata_description": "medical condition", "wikipedia_url": "https://en.wikipedia.org/wiki/Musculoskeletal%20disorder", "wikipedia_extract": "Musculoskeletal disorders (MSDs) are injuries or pain in the human musculoskeletal system, including the joints, ligaments, muscles, nerves, tendons, and structures that support limbs, neck and back. MSDs can arise from a sudden exertion (e.g., lifting a heavy object), or they can arise from making the same motions repeatedly (repetitive strain), or from repeated exposure to force, vibration, or awkward posture. Injuries and pain in the musculoskeletal system caused by acute traumatic events like a car accident or fall are not considered musculoskeletal disorders. MSDs can affect many different parts of the body including upper and lower back, neck, shoulders and extremities (arms, legs, feet, and hands). Examples of MSDs include carpal tunnel syndrome, epicondylitis, tendinitis, back pain, tension neck syndrome, and hand-arm vibration syndrome. MSDs can arise from the interaction of physical factors with ergonomic, psychological, social, and occupational factors."}}, {"canonical_name": "Virgil", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 4, "total_mentions": 9, "members": [{"entity_id": "virgil", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Virgil", "category": "PERSON", "subcategory": "AUTHORITY", "count": 5, "variants": ["Virgil"], "contexts": ["Roman poet", "poet, indebted to Homer"]}, {"entity_id": "virgil", "book_id": "english_physician_1652", "name": "Virgil", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Virgil"], "contexts": ["quoted a prince's choice"]}, {"entity_id": "virgil", "book_id": "principles_of_psychology_james_1890", "name": "Virgil", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Virgil"], "contexts": ["author of the \u00c6neid"]}, {"entity_id": "virgil", "book_id": "kosmos_humboldt_1845", "name": "Virgil", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Virgil"], "contexts": ["Roman poet"]}, {"entity_id": "virg_", "book_id": "kosmos_humboldt_1845", "name": "Virg.", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Virg."], "contexts": ["Virgil, ancient Roman poet"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Virgil", "target_book": "english_physician_1652", "target_name": "Virgil", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Virgil", "target_book": "principles_of_psychology_james_1890", "target_name": "Virgil", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Virgil", "target_book": "kosmos_humboldt_1845", "target_name": "Virgil", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Virgil", "target_book": "kosmos_humboldt_1845", "target_name": "Virg.", "similarity": 0.848}, {"source_book": "english_physician_1652", "source_name": "Virgil", "target_book": "principles_of_psychology_james_1890", "target_name": "Virgil", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Virgil", "target_book": "kosmos_humboldt_1845", "target_name": "Virgil", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Virgil", "target_book": "kosmos_humboldt_1845", "target_name": "Virg.", "similarity": 0.848}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Virgil", "target_book": "kosmos_humboldt_1845", "target_name": "Virgil", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Virgil", "target_book": "kosmos_humboldt_1845", "target_name": "Virg.", "similarity": 0.848}], "id": 657, "stable_key": "clu_c4e50e124145f9df", "ground_truth": {"modern_name": "Virgil", "confidence": "high", "type": "person", "description": "Roman poet and author of the Aeneid, cited as authority.", "wikidata_id": "Q13035160", "wikidata_description": "species of plant"}}, {"canonical_name": "compass", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 4, "total_mentions": 9, "members": [{"entity_id": "compass", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "compass", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["compass", "Compass"], "contexts": ["navigational instrument", "instrument for direction"]}, {"entity_id": "compass-points", "book_id": "principles_of_psychology_james_1890", "name": "compass-points", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["compass-points"], "contexts": ["instrument to measure touch sensitivity", "instrument for tactile discrimination experiments"]}, {"entity_id": "compass", "book_id": "kosmos_humboldt_1845", "name": "compass", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 3, "variants": ["compass"], "contexts": ["navigational instrument using magnetic field", "navigational tool"]}, {"entity_id": "compass", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Compass", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["Compass", "compass"], "contexts": ["navigational instrument showing direction", "navigational instrument"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "compass", "target_book": "principles_of_psychology_james_1890", "target_name": "compass-points", "similarity": 0.886}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "compass", "target_book": "kosmos_humboldt_1845", "target_name": "compass", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "compass", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Compass", "similarity": 0.992}, {"source_book": "principles_of_psychology_james_1890", "source_name": "compass-points", "target_book": "kosmos_humboldt_1845", "target_name": "compass", "similarity": 0.886}, {"source_book": "principles_of_psychology_james_1890", "source_name": "compass-points", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Compass", "similarity": 0.885}, {"source_book": "kosmos_humboldt_1845", "source_name": "compass", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Compass", "similarity": 0.992}], "id": 658, "stable_key": "clu_bed6ee3eec4eedbd", "ground_truth": {"modern_name": "compass", "confidence": "high", "type": "object", "wikidata_id": "Q2476036", "wikidata_description": "American independent record label based in Nashville, Tennessee", "wikipedia_url": "https://en.wikipedia.org/wiki/Compass%20Records", "wikipedia_extract": "A compass is a device that shows the cardinal directions used for navigation and geographic orientation. It typically consists of a magnetized needle or another element, such as a compass card or compass rose, that pivots to align itself with magnetic north. Other methods may be used, including gyroscopes, magnetometers, and GPS receivers. Compasses often show angles in degrees: north corresponds to 0\u00b0, and the angles increase clockwise, so east is 90\u00b0, south is 180\u00b0, and west is 270\u00b0. These numbers allow the compass to show azimuths or bearings which are commonly stated in degrees. If local variation between magnetic north and true north is known, then direction of magnetic north also gives direction of true north.", "note": "The term 'boussole' is the French word for compass."}}, {"canonical_name": "Scorpions", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 4, "total_mentions": 9, "members": [{"entity_id": "scorpions", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Scorpions", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Scorpions"], "contexts": ["creatures of higher mischiefs", "arachnids producing higher mischiefs"]}, {"entity_id": "scorpions", "book_id": "english_physician_1652", "name": "Scorpions", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["Scorpions", "Scorpiions"], "contexts": ["venomous creature", "arachnid known for venom"]}, {"entity_id": "escorpiones", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "escorpiones", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["escorpiones"], "contexts": ["scorpion, part of a plant's common name", "scorpions"]}, {"entity_id": "scorpioni", "book_id": "ricettario_fiorentino_1597", "name": "Scorpioni", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Scorpioni"], "contexts": ["scorpions used in preparation"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Scorpions", "target_book": "english_physician_1652", "target_name": "Scorpions", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Scorpions", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "escorpiones", "similarity": 0.923}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Scorpions", "target_book": "ricettario_fiorentino_1597", "target_name": "Scorpioni", "similarity": 0.988}, {"source_book": "english_physician_1652", "source_name": "Scorpions", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "escorpiones", "similarity": 0.923}, {"source_book": "english_physician_1652", "source_name": "Scorpions", "target_book": "ricettario_fiorentino_1597", "target_name": "Scorpioni", "similarity": 0.988}], "id": 659, "stable_key": "clu_c2c1b272b2d168ee", "ground_truth": {"modern_name": "Scorpions", "confidence": "high", "type": "animal", "family": "Scorpiones", "description": "Arachnids known for their venomous sting, used in medicine and folklore.", "wikipedia_extract": "Scorpions (order Scorpiones) are predatory arachnids with eight legs, a pair of grasping pincers and a narrow, segmented tail, often carried in a characteristic forward curve over the back and always ending with a stinger. The evolutionary history of scorpions goes back 435 million years. They mainly live in deserts but have adapted to a wide range of environmental conditions, and can be found on all continents except Antarctica. There are over 2,500 described species, with 22 extant (living) families recognized to date. Their taxonomy is being revised to account for 21st-century genomic studies. Scorpions primarily prey on insects and other invertebrates, but some species hunt vertebrates."}}, {"canonical_name": "Geography", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 9, "members": [{"entity_id": "geography", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Geography", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Geography"], "contexts": ["study of the Earth's features"]}, {"entity_id": "g\u00e9ographie", "book_id": "epoques_nature_buffon_1778", "name": "G\u00e9ographie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["G\u00e9ographie"], "contexts": ["study of Earth's surface"]}, {"entity_id": "geography", "book_id": "origin_of_species_darwin_1859", "name": "Geography", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Geography", "geography"], "contexts": ["study of landforms and regions", "study of Earth's surface"]}, {"entity_id": "geography", "book_id": "kosmos_humboldt_1845", "name": "Geography", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Geography", "geography"], "contexts": ["study of the Earth's surface", "study of Earth's surface"]}, {"entity_id": "geographia", "book_id": "kosmos_humboldt_1845", "name": "Geographia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Geographia"], "contexts": ["study of geographic distribution"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Geography", "target_book": "epoques_nature_buffon_1778", "target_name": "G\u00e9ographie", "similarity": 0.972}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Geography", "target_book": "origin_of_species_darwin_1859", "target_name": "Geography", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Geography", "target_book": "kosmos_humboldt_1845", "target_name": "Geography", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Geography", "target_book": "kosmos_humboldt_1845", "target_name": "Geographia", "similarity": 0.935}, {"source_book": "epoques_nature_buffon_1778", "source_name": "G\u00e9ographie", "target_book": "origin_of_species_darwin_1859", "target_name": "Geography", "similarity": 0.972}, {"source_book": "epoques_nature_buffon_1778", "source_name": "G\u00e9ographie", "target_book": "kosmos_humboldt_1845", "target_name": "Geography", "similarity": 0.972}, {"source_book": "epoques_nature_buffon_1778", "source_name": "G\u00e9ographie", "target_book": "kosmos_humboldt_1845", "target_name": "Geographia", "similarity": 0.94}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Geography", "target_book": "kosmos_humboldt_1845", "target_name": "Geography", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Geography", "target_book": "kosmos_humboldt_1845", "target_name": "Geographia", "similarity": 0.935}], "id": 660, "stable_key": "clu_6ca495a6e5c8b5c8", "ground_truth": {"modern_name": "Geography", "confidence": "high", "type": "concept", "wikidata_id": "Q1071", "wikidata_description": "science that studies the terrestrial surface, the societies that inhabit it and the territories, landscapes, places or regions that form it when interacting with each other", "wikipedia_url": "https://en.wikipedia.org/wiki/Geography", "wikipedia_extract": "Geography (from Ancient Greek \u03b3\u03b5\u03c9\u03b3\u03c1\u03b1\u03c6\u03af\u03b1 ge\u014dgraph\u00eda; combining g\u00ea 'Earth' and gr\u00e1ph\u014d 'write', literally 'Earth writing') is the study of the lands, features, inhabitants, and phenomena of Earth. Geography is an all-encompassing discipline that seeks an understanding of Earth and its human and natural complexities\u2014not merely where objects are, but also how they have changed and come to be. While geography is specific to Earth, many concepts can be applied more broadly to other celestial bodies in the field of planetary science. Geography has been called \"a bridge between natural science and social science disciplines.\" The history of geography as a discipline spans cultures and millennia, being independently developed by multiple groups, and cross-pollinated by trade between these groups. Geography as a discipline dates back to the earliest attempts to understand the world spatially, with the earliest example of an attempted world map dating to the 9th century BC in ancient Babylon. Origins of many of the concepts in geography can be traced to Greek Eratosthenes of Cyrene, who may have coined the term \"geographia\" (c."}}, {"canonical_name": "philosopher", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 4, "total_mentions": 9, "members": [{"entity_id": "philosopher", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Philosopher", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Philosopher"], "contexts": ["unnamed philosopher with a theory"]}, {"entity_id": "philosopher", "book_id": "principles_of_psychology_james_1890", "name": "philosopher", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 6, "variants": ["philosopher"], "contexts": ["person devoted to wisdom and thought", "student of philosophy"]}, {"entity_id": "philosopher", "book_id": "kosmos_humboldt_1845", "name": "philosopher", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["philosopher"], "contexts": ["studies physical phenomena"]}, {"entity_id": "philosophers", "book_id": "connexion_physical_sciences_somerville_1858", "name": "philosophers", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["philosophers"], "contexts": ["speculated about motion of sun and stars"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Philosopher", "target_book": "principles_of_psychology_james_1890", "target_name": "philosopher", "similarity": 0.989}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Philosopher", "target_book": "kosmos_humboldt_1845", "target_name": "philosopher", "similarity": 0.989}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Philosopher", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "philosophers", "similarity": 0.923}, {"source_book": "principles_of_psychology_james_1890", "source_name": "philosopher", "target_book": "kosmos_humboldt_1845", "target_name": "philosopher", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "philosopher", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "philosophers", "similarity": 0.934}, {"source_book": "kosmos_humboldt_1845", "source_name": "philosopher", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "philosophers", "similarity": 0.934}], "id": 661, "stable_key": "clu_27672faf74e05b12", "ground_truth": {"modern_name": "Philosopher", "confidence": "high", "type": "person", "description": "An individual devoted to wisdom, often engaged in abstract thought."}}, {"canonical_name": "Mer du Nord", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 9, "members": [{"entity_id": "mer_du_nord", "book_id": "epoques_nature_buffon_1778", "name": "mer du Nord", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["mer du Nord"], "contexts": ["sea receiving waters from Asia"]}, {"entity_id": "mar_del_norte", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Mar del norte", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Mar del norte"], "contexts": ["sea near where the tree grows", "geographic location"]}, {"entity_id": "mer_du_nord", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Mer du Nord", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["mer du Nord", "Mer du Nord"], "contexts": ["North Sea", "sea"]}, {"entity_id": "north_sea", "book_id": "kosmos_humboldt_1845", "name": "North Sea", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["North Sea"], "contexts": ["sea between Britain and Europe", "sea between Great Britain and Scandinavia"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "mer du Nord", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "Mar del norte", "similarity": 0.899}, {"source_book": "epoques_nature_buffon_1778", "source_name": "mer du Nord", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Mer du Nord", "similarity": 0.987}, {"source_book": "epoques_nature_buffon_1778", "source_name": "mer du Nord", "target_book": "kosmos_humboldt_1845", "target_name":