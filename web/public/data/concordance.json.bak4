ount": 1, "variants": ["Acacia cornigera"], "contexts": ["bush with strong thorns"]}, {"entity_id": "acacia", "book_id": "ricettario_fiorentino_1597", "name": "Acacia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["Acacia", "acacia"], "contexts": ["Acacia, a plant discussed", "a shrub described by Dioscorides"]}, {"entity_id": "acacia", "book_id": "polyanthea_medicinal", "name": "acacia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Acacia", "acacia"], "contexts": ["gum resin", "ingredient in a repercussive plaster"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Acacia", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "acassia", "similarity": 0.907}, {"source_book": "english_physician_1652", "source_name": "Acacia", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Acacia cornigera", "similarity": 0.917}, {"source_book": "english_physician_1652", "source_name": "Acacia", "target_book": "ricettario_fiorentino_1597", "target_name": "Acacia", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Acacia", "target_book": "polyanthea_medicinal", "target_name": "acacia", "similarity": 0.935}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "acassia", "target_book": "ricettario_fiorentino_1597", "target_name": "Acacia", "similarity": 0.907}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "acassia", "target_book": "polyanthea_medicinal", "target_name": "acacia", "similarity": 0.887}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Acacia cornigera", "target_book": "ricettario_fiorentino_1597", "target_name": "Acacia", "similarity": 0.917}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Acacia cornigera", "target_book": "polyanthea_medicinal", "target_name": "acacia", "similarity": 0.898}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Acacia", "target_book": "polyanthea_medicinal", "target_name": "acacia", "similarity": 0.935}], "id": 229, "stable_key": "clu_bd0b56252ec280b4", "ground_truth": {"modern_name": "Acacia", "confidence": "high", "type": "plant", "linnaean": "Acacia Miller", "family": "Fabaceae", "note": "The mentions of 'Acacia', 'Acacia cornigera', and 'ac\u00e1cia' across different texts strongly indicate the genus Acacia, with specific mentions of a species known for its thorns.", "wikidata_id": "Q81666", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Acacia", "wikipedia_extract": "Acacia, commonly known as wattles or acacias, is a genus of about 1,084 species of shrubs and trees in the subfamily Mimosoideae of the pea family Fabaceae. Initially, it comprised a group of plant species native to Africa, South America, and Australasia, but is now reserved for species mainly from Australia, with others from New Guinea, Southeast Asia, and the Indian Ocean. The genus name is Neo-Latin, borrowed from Koine Greek \u1f00\u03ba\u03b1\u03ba\u03af\u03b1 (akakia), a term used in antiquity to describe a preparation extracted from Vachellia nilotica, the original type species. Several species of Acacia have been introduced to various parts of the world, and two million hectares of commercial plantations have been established. Plants in the genus Acacia are shrubs or trees with bipinnate leaves, the mature leaves sometimes reduced to phyllodes or rarely absent. There are 2 small stipules at the base of the leaf, but sometimes fall off as the leaf matures."}}, {"canonical_name": "leaves", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 5, "total_mentions": 15, "members": [{"entity_id": "leaves", "book_id": "origin_of_species_darwin_1859", "name": "leaves", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["leaves"], "contexts": ["part of a plant", "plant part subject to variation"]}, {"entity_id": "leaves", "book_id": "principles_of_psychology_james_1890", "name": "leaves", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["leaves"], "contexts": ["feature of a flower"]}, {"entity_id": "leaves", "book_id": "polyanthea_medicinal", "name": "leaves", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["leaves"], "contexts": ["plant part used in remedies"]}, {"entity_id": "leaves_of_plants", "book_id": "connexion_physical_sciences_somerville_1858", "name": "leaves of plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["leaves of plants"], "contexts": ["objects accurately delineated", "objects for photographic impressions"]}, {"entity_id": "leaves", "book_id": "first_principles_spencer_1862", "name": "leaves", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["leaves"], "contexts": ["part of plant structure", "light plant parts affected by air resistance"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "leaves", "target_book": "principles_of_psychology_james_1890", "target_name": "leaves", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "leaves", "target_book": "polyanthea_medicinal", "target_name": "leaves", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "leaves", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "leaves of plants", "similarity": 0.956}, {"source_book": "origin_of_species_darwin_1859", "source_name": "leaves", "target_book": "first_principles_spencer_1862", "target_name": "leaves", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "leaves", "target_book": "polyanthea_medicinal", "target_name": "leaves", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "leaves", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "leaves of plants", "similarity": 0.956}, {"source_book": "principles_of_psychology_james_1890", "source_name": "leaves", "target_book": "first_principles_spencer_1862", "target_name": "leaves", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "leaves", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "leaves of plants", "similarity": 0.956}, {"source_book": "polyanthea_medicinal", "source_name": "leaves", "target_book": "first_principles_spencer_1862", "target_name": "leaves", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "leaves of plants", "target_book": "first_principles_spencer_1862", "target_name": "leaves", "similarity": 0.956}], "id": 230, "stable_key": "clu_4a8fff43f5805086", "ground_truth": {"modern_name": "Leaves", "confidence": "high", "type": "plant", "note": "General term for a plant organ, not a specific species.", "wikidata_id": "Q33971", "wikidata_description": "main organ of photosynthesis and transpiration in higher plants, usually consisting of a flat green blade attached to the stem directly or by a stalk", "wikipedia_url": "https://en.wikipedia.org/wiki/Leaf", "wikipedia_extract": "A leaf (pl.: leaves) is a principal appendage of the stem of a vascular plant, usually borne laterally above ground and specialized for photosynthesis. Leaves are collectively called foliage, as in \"autumn foliage\", while the leaves, stem, flower, and fruit collectively form the shoot system. In most leaves, the primary photosynthetic tissue is the palisade mesophyll and is located on the upper side of the blade or lamina of the leaf, but in some species, including the mature foliage of Eucalyptus, palisade mesophyll is present on both sides and the leaves are said to be isobilateral. The leaf is an integral part of the stem system, and most leaves are flattened and have distinct upper (adaxial) and lower (abaxial) surfaces that differ in color, hairiness, the number of stomata (pores that intake and output gases), the amount and structure of epicuticular wax, and other features. Leaves are mostly green in color due to the presence of a compound called chlorophyll which is essential for photosynthesis as it absorbs light energy from the Sun. A leaf with lighter-colored or white patches or edges is called a variegated leaf."}}, {"canonical_name": "friction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 15, "members": [{"entity_id": "friction", "book_id": "kosmos_humboldt_1845", "name": "friction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["friction"], "contexts": ["resistance to motion between surfaces", "rubbing surfaces together"]}, {"entity_id": "fric\u00e7\u00e3o", "book_id": "coloquios_da_orta_1563", "name": "fric\u00e7\u00e3o", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["fric\u00e7\u00e3o"], "contexts": ["action that electrizes diamonds"]}, {"entity_id": "frictiones", "book_id": "polyanthea_medicinal", "name": "frictiones", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["frictiones"], "contexts": ["treatment for Angina"]}, {"entity_id": "friction", "book_id": "connexion_physical_sciences_somerville_1858", "name": "friction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["friction"], "contexts": ["interaction causing storm axis bend", "resistance to motion between surfaces"]}, {"entity_id": "friction", "book_id": "first_principles_spencer_1862", "name": "friction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["friction"], "contexts": ["resistance to motion between surfaces", "resistance to motion"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "friction", "target_book": "coloquios_da_orta_1563", "target_name": "fric\u00e7\u00e3o", "similarity": 0.968}, {"source_book": "kosmos_humboldt_1845", "source_name": "friction", "target_book": "polyanthea_medicinal", "target_name": "frictiones", "similarity": 0.95}, {"source_book": "kosmos_humboldt_1845", "source_name": "friction", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "friction", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "friction", "target_book": "first_principles_spencer_1862", "target_name": "friction", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "fric\u00e7\u00e3o", "target_book": "polyanthea_medicinal", "target_name": "frictiones", "similarity": 0.934}, {"source_book": "coloquios_da_orta_1563", "source_name": "fric\u00e7\u00e3o", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "friction", "similarity": 0.968}, {"source_book": "coloquios_da_orta_1563", "source_name": "fric\u00e7\u00e3o", "target_book": "first_principles_spencer_1862", "target_name": "friction", "similarity": 0.968}, {"source_book": "polyanthea_medicinal", "source_name": "frictiones", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "friction", "similarity": 0.95}, {"source_book": "polyanthea_medicinal", "source_name": "frictiones", "target_book": "first_principles_spencer_1862", "target_name": "friction", "similarity": 0.95}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "friction", "target_book": "first_principles_spencer_1862", "target_name": "friction", "similarity": 1.0}], "id": 231, "stable_key": "clu_ae0b8fcd19152897", "ground_truth": {"modern_name": "friction", "confidence": "high", "type": "concept", "wikidata_id": "Q82580", "wikidata_description": "force resisting the relative motion of solid surfaces, fluid layers, and material elements sliding against each other", "wikipedia_url": "https://en.wikipedia.org/wiki/Friction", "wikipedia_extract": "Friction is the force resisting the relative motion of solid surfaces, fluid layers, and material elements sliding or grinding against each other. Types of friction include dry, fluid, lubricated, skin, and internal \u2013 an incomplete list. The study of the processes involved is called tribology, and has a history of more than 2,000 years. Friction can have dramatic consequences, as illustrated by the use of friction created by rubbing pieces of wood together to start a fire. Another important consequence of many types of friction can be wear, which may lead to performance degradation or damage to components. It is known that frictional energy losses account for about 20% of the total energy expenditure of the world."}}, {"canonical_name": "hemispheres", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 5, "total_mentions": 15, "members": [{"entity_id": "hemisphere", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Hemisphere", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Hemisphere"], "contexts": ["half of the Earth"]}, {"entity_id": "hemispheres", "book_id": "kosmos_humboldt_1845", "name": "hemispheres", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["hemispheres"], "contexts": ["halves of the globe", "halves of the Earth"]}, {"entity_id": "hemisphere", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Hemisphere", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["hemisphere", "Hemisphere"], "contexts": ["half of a sphere", "cause of excess cold in southern"]}, {"entity_id": "hemisphere", "book_id": "first_principles_spencer_1862", "name": "hemisphere", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["hemisphere"], "contexts": ["part of the Earth"]}, {"entity_id": "h\u00e9misph\u00e8res", "book_id": "epoques_nature_buffon_1778", "name": "h\u00e9misph\u00e8res", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["h\u00e9misph\u00e8res"], "contexts": ["halves of the globe", "Halves of the Earth"]}, {"entity_id": "hemispheres", "book_id": "connexion_physical_sciences_somerville_1858", "name": "hemispheres", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["hemispheres"], "contexts": ["geographic divisions of Earth", "regions of the earth or sky"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hemisphere", "target_book": "kosmos_humboldt_1845", "target_name": "hemispheres", "similarity": 0.971}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hemisphere", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Hemisphere", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hemisphere", "target_book": "first_principles_spencer_1862", "target_name": "hemisphere", "similarity": 0.995}, {"source_book": "kosmos_humboldt_1845", "source_name": "hemispheres", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Hemisphere", "similarity": 0.971}, {"source_book": "kosmos_humboldt_1845", "source_name": "hemispheres", "target_book": "first_principles_spencer_1862", "target_name": "hemisphere", "similarity": 0.975}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Hemisphere", "target_book": "first_principles_spencer_1862", "target_name": "hemisphere", "similarity": 0.995}, {"source_book": "epoques_nature_buffon_1778", "source_name": "h\u00e9misph\u00e8res", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "hemispheres", "similarity": 0.908}], "id": 232, "stable_key": "clu_c130d45672bfc40a", "ground_truth": {"modern_name": "Hemisphere", "confidence": "high", "type": "concept", "note": "The context describes geographical hemispheres and anatomical hemispheres. 'Hemisphere' is a general term applicable to both.", "wikidata_id": "Q399984", "wikidata_description": "bipartite divisions of Earth", "wikipedia_url": "https://en.wikipedia.org/wiki/Hemispheres%20of%20Earth", "wikipedia_extract": "In geography and cartography, hemispheres of Earth are any division of the globe into two equal halves (hemispheres), typically divided into northern and southern halves by the Equator and into western and eastern halves by the Prime meridian. Hemispheres can be divided geographically or culturally, or based on religion or prominent geographic features. Use of these divisions is applied when studying Earth's geographic distribution, cultural differences, and other geographic, demographic and socioeconomic features. Geographical hemispheres are primarily split by latitudinal (north-south) and longitudinal (east-west) markers: Alternative Earth hemispheres can divide the globe along cultural or religious lines, or be used to maximize the prominence of geographic features. For example: Geographical feature-based hemispheres Alternative hemisphere schemes can divide the planet in a way that maximizes the prominence of one geographic feature or another in each division, such as the land-water division: Land Hemisphere: Centered near 47\u00b0N, 1\u00b0E, near the city of Nantes, France, this hemisphere contains the largest possible area of land, including most of the world's continents and major landmasses. Water Hemisphere: Centered near 47\u00b0S, 179\u00b0W, in the South Pacific Ocean, this hemisphere contains the largest possible area of water, including most of the Indian, Pacific, and Southern Oceans."}}, {"canonical_name": "Arsenic", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 5, "total_mentions": 15, "members": [{"entity_id": "arsenic", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Arsenic", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["Arsenic"], "contexts": ["chemical with attractive quality", "chemical attracts but weakly"]}, {"entity_id": "arsenico", "book_id": "ricettario_fiorentino_1597", "name": "Arsenico", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["Arsenico", "Arfenico"], "contexts": ["Greek name for Orpimento", "arsenic ingredient"]}, {"entity_id": "arsenic", "book_id": "principles_of_psychology_james_1890", "name": "arsenic", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["arsenic"], "contexts": ["remedy compared to phosphorus"]}, {"entity_id": "arsenic", "book_id": "kosmos_humboldt_1845", "name": "arsenic", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["arsenic"], "contexts": ["chemical element in meteoric masses", "metal found in volcanic products"]}, {"entity_id": "arsenic", "book_id": "connexion_physical_sciences_somerville_1858", "name": "arsenic", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["arsenic"], "contexts": ["chemical element with specific properties", "body with low diamagnetic power"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Arsenic", "target_book": "ricettario_fiorentino_1597", "target_name": "Arsenico", "similarity": 0.989}, {"source_book": "principles_of_psychology_james_1890", "source_name": "arsenic", "target_book": "kosmos_humboldt_1845", "target_name": "arsenic", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "arsenic", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "arsenic", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "arsenic", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "arsenic", "similarity": 1.0}], "id": 233, "stable_key": "clu_0324c0e32d5898d3", "ground_truth": {"modern_name": "arsenic", "confidence": "high", "type": "mineral", "description": "A toxic metalloid element used historically in medicine and alchemy.", "wikipedia_extract": "Arsenic is a chemical element; it has the symbol As and atomic number 33. It is a metalloid and one of the pnictogens, and therefore shares many properties with its group 15 neighbors phosphorus and antimony. Arsenic is notoriously toxic. It occurs naturally in many minerals, usually in combination with sulfur and metals, but also as a pure elemental crystal. It has various allotropes, but only the grey form, which has a metallic appearance, is important to industry. The primary use of arsenic is in alloys of lead (for example, in car batteries and ammunition)."}}, {"canonical_name": "Democrito", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 5, "total_mentions": 14, "members": [{"entity_id": "democritus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Democritus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 4, "variants": ["Democritus"], "contexts": ["ancient Greek philosopher, known for laughter", "ancient Greek philosopher"]}, {"entity_id": "democritus", "book_id": "kosmos_humboldt_1845", "name": "Democritus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Democritus"], "contexts": ["ancient Greek philosopher"]}, {"entity_id": "democrito", "book_id": "historia_medicinal_monardes_1574", "name": "Democrito", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Democrito"], "contexts": ["ancient philosopher on metal origins"]}, {"entity_id": "democrito", "book_id": "ricettario_fiorentino_1597", "name": "Democrito", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Democrito"], "contexts": ["ancient philosopher"]}, {"entity_id": "democrito", "book_id": "polyanthea_medicinal", "name": "Democrito", "category": "PERSON", "subcategory": "AUTHORITY", "count": 7, "variants": ["Democrito", "Democrit.", "Democrite", "Democritus"], "contexts": ["ancient philosopher, attributed cause of women's diseases", "ancient philosopher cited"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Democritus", "target_book": "kosmos_humboldt_1845", "target_name": "Democritus", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Democritus", "target_book": "historia_medicinal_monardes_1574", "target_name": "Democrito", "similarity": 0.99}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Democritus", "target_book": "ricettario_fiorentino_1597", "target_name": "Democrito", "similarity": 0.99}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Democritus", "target_book": "polyanthea_medicinal", "target_name": "Democrito", "similarity": 0.99}, {"source_book": "kosmos_humboldt_1845", "source_name": "Democritus", "target_book": "historia_medicinal_monardes_1574", "target_name": "Democrito", "similarity": 0.99}, {"source_book": "kosmos_humboldt_1845", "source_name": "Democritus", "target_book": "ricettario_fiorentino_1597", "target_name": "Democrito", "similarity": 0.99}, {"source_book": "kosmos_humboldt_1845", "source_name": "Democritus", "target_book": "polyanthea_medicinal", "target_name": "Democrito", "similarity": 0.99}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Democrito", "target_book": "ricettario_fiorentino_1597", "target_name": "Democrito", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Democrito", "target_book": "polyanthea_medicinal", "target_name": "Democrito", "similarity": 1.0}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Democrito", "target_book": "polyanthea_medicinal", "target_name": "Democrito", "similarity": 1.0}], "id": 234, "stable_key": "clu_5ccbaa7c29a92e22", "ground_truth": {"modern_name": "Democritus", "confidence": "high", "type": "person", "birth_year": -460, "death_year": -370, "description": "Ancient Greek philosopher, originator of atomism.", "wikidata_id": "Q41980", "wikidata_description": "Greek philosopher (c.\u2009460\u2013c.\u2009370 BC)", "wikipedia_url": "https://en.wikipedia.org/wiki/Democritus", "wikipedia_extract": "Democritus (, dim-OCK-rit-\u0259s; Greek: \u0394\u03b7\u03bc\u03cc\u03ba\u03c1\u03b9\u03c4\u03bf\u03c2, D\u0113m\u00f3kritos, meaning \"chosen of the people\"; c. 460 \u2013 c. 370 BC) was an Ancient Greek pre-Socratic philosopher from Abdera, primarily remembered today for his formulation of an atomic theory of the universe. Democritus wrote extensively on a wide variety of topics. None of Democritus' original work has survived, except through second-hand references. Many of these references come from Aristotle, who viewed him as an important rival in the field of natural philosophy."}}, {"canonical_name": "vall\u00e9es", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 5, "total_mentions": 14, "members": [{"entity_id": "vall\u00e9es", "book_id": "epoques_nature_buffon_1778", "name": "vall\u00e9es", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["vall\u00e9es"], "contexts": ["depressions formed by cooling", "depressions between mountains"]}, {"entity_id": "vall\u00e9es", "book_id": "relation_historique_humboldt_vol3_1825", "name": "vall\u00e9es", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 7, "variants": ["vall\u00e9es", "vall\u00e9e", "vall\u00e9es longitudinales", "vall\u00e9es transversales"], "contexts": ["low-lying areas", "low-lying landforms"]}, {"entity_id": "vales", "book_id": "principles_of_psychology_james_1890", "name": "vales", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["vales"], "contexts": ["valleys"]}, {"entity_id": "valley", "book_id": "connexion_physical_sciences_somerville_1858", "name": "valley", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["valley"], "contexts": ["low area between hills"]}, {"entity_id": "valleys", "book_id": "first_principles_spencer_1862", "name": "valleys", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["valleys"], "contexts": ["low areas between hills or mountains"]}], "edges": [