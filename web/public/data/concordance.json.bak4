target_name": "India", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "India", "target_book": "first_principles_spencer_1862", "target_name": "India", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "India", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "India", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "India", "target_book": "first_principles_spencer_1862", "target_name": "India", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "India", "target_book": "first_principles_spencer_1862", "target_name": "India", "similarity": 1.0}], "id": 34, "stable_key": "clu_3b1f5efc22628429", "ground_truth": {"modern_name": "India", "confidence": "high", "type": "place", "country": "India", "note": "Hindostan is an older Persian name for the Indian subcontinent.", "wikidata_id": "Q668", "wikidata_description": "country in South Asia", "wikipedia_url": "https://en.wikipedia.org/wiki/India", "wikipedia_extract": "India, officially the Republic of India, is a country in South Asia. It is the seventh-largest country by area; the most populous country since 2023; and, since its independence in 1947, the world's most populous democracy. Bounded by the Indian Ocean on the south, the Arabian Sea on the southwest, and the Bay of Bengal on the southeast, it shares land borders with Pakistan to the west; China, Nepal, and Bhutan to the north; and Bangladesh and Myanmar to the east. In the Indian Ocean, India is near Sri Lanka and the Maldives; its Andaman and Nicobar Islands share a maritime border with Myanmar, Thailand, and Indonesia. Modern humans arrived on the Indian subcontinent from Africa no later than 55,000 years ago. Their long occupation, predominantly in isolation as hunter-gatherers, has made the region highly diverse."}}, {"canonical_name": "Himalaya", "category": "PLACE", "subcategory": "REGION", "book_count": 6, "total_mentions": 77, "members": [{"entity_id": "himalaya", "book_id": "origin_of_species_darwin_1859", "name": "Himalaya", "category": "PLACE", "subcategory": "REGION", "count": 7, "variants": ["Himalaya"], "contexts": ["mountain range in India", "mountain range in Asia"]}, {"entity_id": "himalaya", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Himalaya", "category": "PLACE", "subcategory": "REGION", "count": 14, "variants": ["Himalaya"], "contexts": ["mountain chain near a lake", "mountain range distant from the sea"]}, {"entity_id": "himalayas", "book_id": "kosmos_humboldt_1845", "name": "Himalayas", "category": "PLACE", "subcategory": "REGION", "count": 12, "variants": ["Himalayas"], "contexts": ["mountain range in Asia", "mountain range with snow-line"]}, {"entity_id": "himalaya", "book_id": "coloquios_da_orta_1563", "name": "Himalaya", "category": "PLACE", "subcategory": "REGION", "count": 9, "variants": ["Himalaya", "Himalayai"], "contexts": ["region musk arrived through", "mountain range in Asia"]}, {"entity_id": "himalaya", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Himalaya", "category": "PLACE", "subcategory": "REGION", "count": 5, "variants": ["Himalaya"], "contexts": ["mountain range in Asia", "lofty mountain range with specific flora"]}, {"entity_id": "himalaya", "book_id": "kosmos_humboldt_1845", "name": "Himalaya", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 29, "variants": ["Himalaya"], "contexts": ["limits of perpetual snow", "northern and southern chains"]}, {"entity_id": "himalayas", "book_id": "first_principles_spencer_1862", "name": "Himalayas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Himalayas"], "contexts": ["mountain system"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Himalaya", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Himalaya", "similarity": 1.0}, {"source_book": "origin