name": "doce", "category": "CONCEPT", "subcategory": "QUALITY", "count": 4, "variants": ["doce"], "contexts": ["sweet flavor", "quality of the casto"]}, {"entity_id": "doces", "book_id": "coloquios_da_orta_1563", "name": "doces", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["doces"], "contexts": ["final taste quality of the fruits"]}, {"entity_id": "doces", "book_id": "polyanthea_medicinal", "name": "doces", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 19, "variants": ["doces"], "contexts": ["sweet food preparations", "sweet substances"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "doce", "target_book": "polyanthea_medicinal", "target_name": "doces", "similarity": 0.887}, {"source_book": "coloquios_da_orta_1563", "source_name": "doces", "target_book": "polyanthea_medicinal", "target_name": "doces", "similarity": 1.0}], "id": 2362, "stable_key": "clu_65f50b9d2df66c87", "ground_truth": {"modern_name": "Sweets", "confidence": "high", "type": "concept", "wikidata_id": "Q55414087", "wikidata_description": "scientific article"}}, {"canonical_name": "pimpinella", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 24, "members": [{"entity_id": "pimpinella", "book_id": "ricettario_fiorentino_1597", "name": "Pimpinella", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Pimpinella"], "contexts": ["burnet, a medicinal herb"]}, {"entity_id": "pimpinella", "book_id": "polyanthea_medicinal", "name": "pimpinella", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 22, "variants": ["pimpinella", "pimpinela", "pimpinella scabiofe"], "contexts": ["herb used in a diuretic preparation", "herb for sustaining goat"]}, {"entity_id": "pimpinellam", "book_id": "polyanthea_medicinal", "name": "Pimpinellam", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Pimpinellam"], "contexts": ["pimpinella, used to treat fever"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Pimpinella", "target_book": "polyanthea_medicinal", "target_name": "pimpinella", "similarity": 0.591}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Pimpinella", "target_book": "polyanthea_medicinal", "target_name": "Pimpinellam", "similarity": 0.957}], "id": 2363, "stable_key": "clu_587ed1ad3620ef7b", "ground_truth": {"modern_name": "Burnet", "confidence": "high", "type": "plant", "linnaean": "Sanguisorba officinalis", "family": "Rosaceae", "note": "Pimpinella is a genus, but 'pimpinella' in medicinal contexts often refers to Pimpinella anisum (anise) or Pimpinella saxifraga (burnet saxifrage), both used medicinally. Given the context of a 'medicinal herb' and 'burnet', Sanguisorba officinalis (Great Burnet) is a strong candidate, though Pimpinella saxifraga is also plausible."}}, {"canonical_name": "Stibium", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 23, "members": [{"entity_id": "stibium", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Stibium", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["Stibium"], "contexts": ["antimony glass, appears red then yellow", "mineral with attractive quality"]}, {"entity_id": "stibium", "book_id": "polyanthea_medicinal", "name": "Stibium", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 20, "variants": ["Stibium", "Stibij", "Stibio"], "contexts": ["mineral substance used in medicine", "mineral praised by authors"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Stibium", "target_book": "polyanthea_medicinal", "target_name": "Stibium", "similarity": 1.0}], "id": 2364, "stable_key": "clu_157c6ffe199c26c2-2", "ground_truth": {"modern_name": "Antimony", "confidence": "high", "type": "mineral", "wikidata_id": "Q1099", "wikidata_description": "chemical element with symbol Sb and atomic number of 51", "wikipedia_extract": "Antimony potassium tartrate, also known as potassium antimonyl tartrate, potassium antimontarterate, or tartar emetic, has the formula K2Sb2(C4H2O6)2. The compound has long been known as a powerful emetic, and was used in the treatment of schistosomiasis and leishmaniasis. It is used as a resolving agent. It typically is obtained as a hydrate. The first treatment application against trypanosomiasis was tested in 1906, and the compound's use to treat other tropical diseases was researched. The treatment of leishmania with antimony potassium tartrate started in 1913.", "wikipedia_url": "https://en.wikipedia.org/wiki/Antimony", "note": "This likely refers to a distilled preparation containing antimony compounds.", "description": "A metallic element, often prepared and used in alchemical and medicinal contexts."}}, {"canonical_name": "palmiers", "category": "PLANT", "subcategory": "TREE", "book_count": 2, "total_mentions": 23, "members": [{"entity_id": "palmiers_lataniers", "book_id": "epoques_nature_buffon_1778", "name": "palmiers lataniers", "category": "PLANT", "subcategory": "TREE", "count": 2, "variants": ["palmiers lataniers"], "contexts": ["palm trees in marshy areas", "trees in flooded savannas"]}, {"entity_id": "palmiers", "book_id": "relation_historique_humboldt_vol3_1825", "name": "palmiers", "category": "PLANT", "subcategory": "TREE", "count": 21, "variants": ["palmiers", "Palma Real", "Palma rcai", "Palma real", "Palmier de vin", "Palmier royal", "palmier"], "contexts": ["scattered trees in the savanna", "scattered trees in a region"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "palmiers lataniers", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "palmiers", "similarity": 0.887}], "id": 2365, "stable_key": "clu_5e11d6605290ad69", "ground_truth": {"modern_name": "palm trees", "confidence": "high", "type": "plant", "family": "Arecaceae", "wikidata_id": "Q14080", "wikidata_description": "family of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Arecaceae"}}, {"canonical_name": "Breast", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 23, "members": [{"entity_id": "breast", "book_id": "english_physician_1652", "name": "Breast", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 21, "variants": ["Breast", "Breasts"], "contexts": ["part of the upper torso", "part of the body"]}, {"entity_id": "breast", "book_id": "principles_of_psychology_james_1890", "name": "breast", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["breast"], "contexts": ["chest area of the body"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Breast", "target_book": "principles_of_psychology_james_1890", "target_name": "breast", "similarity": 0.986}], "id": 2366, "stable_key": "clu_e444146ac2b866ef", "ground_truth": {"modern_name": "Breast", "confidence": "high", "type": "anatomy", "wikidata_id": "Q9103", "wikidata_description": "one of two prominences located on the region of the torso of a female primate, containing the mammary gland"}}, {"canonical_name": "Dr. Hooker", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 23, "members": [{"entity_id": "dr__hooker", "book_id": "origin_of_species_darwin_1859", "name": "Dr. Hooker", "category": "PERSON", "subcategory": "SCHOLAR", "count": 22, "variants": ["Dr. Hooker", "Hooker"], "contexts": ["read Darwin's sketch of 1844", "aided author for fifteen years"]}, {"entity_id": "dr__hooker", "book_id": "kosmos_humboldt_1845", "name": "Dr. Hooker", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Dr. Hooker"], "contexts": ["author of paper read before British Association"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Dr. Hooker", "target_book": "kosmos_humboldt_1845", "target_name": "Dr. Hooker", "similarity": 1.0}], "id": 2367, "stable_key": "clu_98b44a52b8c7ae95", "ground_truth": {"modern_name": "Joseph Dalton Hooker", "confidence": "high", "type": "person", "birth_year": 1817, "death_year": 1911, "description": "British botanist and explorer, friend of Darwin", "wikidata_id": "Q157501", "wikidata_description": "British botanist, lichenologist, and surgeon (1817\u20131911)", "wikipedia_url": "https://en.wikipedia.org/wiki/Joseph%20Dalton%20Hooker", "wikipedia_extract": "Sir Joseph Dalton Hooker (30 June 1817 \u2013 10 December 1911) was a British botanist and explorer in the 19th century. He was a founder of geographical botany and Charles Darwin's closest friend. For 20 years he served as director of the Royal Botanical Gardens, Kew, succeeding his father, William Jackson Hooker, and was awarded the highest honours of British science. Hooker was born in Halesworth, Suffolk, England. He was the second son of Maria Sarah Turner, eldest daughter of the banker Dawson Turner and sister-in-law of Francis Palgrave, and the famous botanist Sir William Jackson Hooker, Regius Professor of Botany. From the age of seven, Hooker attended his father's lectures at the University of Glasgow, taking an early interest in plant distribution and the voyages of explorers like Captain James Cook."}}, {"canonical_name": "vientre", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 23, "members": [{"entity_id": "vientre", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "vientre", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 18, "variants": ["vientre"], "contexts": ["abdominal region", "abdomen"]}, {"entity_id": "vientre", "book_id": "historia_medicinal_monardes_1574", "name": "Vientre", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["vientre", "Vientre"], "contexts": ["belly or abdomen", "abdominal part of the body"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "vientre", "target_book": "historia_medicinal_monardes_1574", "target_name": "Vientre", "similarity": 0.829}], "id": 2368, "stable_key": "clu_043f5ac8c3082676-2", "ground_truth": {"modern_name": "Abdomen", "confidence": "high", "type": "concept", "note": "While 'pelvis' is mentioned, the dominant term and context clearly point to the general abdominal region as the referent.", "wikidata_id": "Q9597", "wikidata_description": "in humans, region of the body between the thorax at the top and the pelvis at the bottom; in insects, segment at the caudal end of the body, following on from the head and thorax", "wikipedia_url": "https://en.wikipedia.org/wiki/Abdomen", "wikipedia_extract": "An abdomen (also belly or stomach in vertebrates, or metasoma in arthropods)  is the front part of the torso between the thorax (chest) and pelvis in humans and in other vertebrates. The area occupied by the abdomen is called the abdominal cavity. In arthropods, it is the posterior tagma of the body; it follows the thorax or cephalothorax. In humans, the abdomen stretches from the thorax at the thoracic diaphragm to the pelvis at the pelvic brim. The pelvic brim stretches from the lumbosacral joint (the intervertebral disc between L5 and S1) to the pubic symphysis and is the edge of the pelvic inlet. The space above this inlet and under the thoracic diaphragm is termed the abdominal cavity."}}, {"canonical_name": "membro viril", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 23, "members": [{"entity_id": "miembro_viril", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "miembro viril", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["miembro viril"], "contexts": ["genital organ"]}, {"entity_id": "membro_viril", "book_id": "polyanthea_medicinal", "name": "membro viril", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 22, "variants": ["membro viril", "Membro virile", "mem bro viril", "membroviril"], "contexts": ["male reproductive organ", "penis"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "miembro viril", "target_book": "polyanthea_medicinal", "target_name": "membro viril", "similarity": 0.994}], "id": 2369, "stable_key": "clu_b0efaf5c29059edf", "ground_truth": {"modern_name": "penis", "confidence": "high", "type": "object", "wikidata_id": "Q58", "wikidata_description": "primary sexual organ of male animals", "wikipedia_url": "https://en.wikipedia.org/wiki/Penis"}}, {"canonical_name": "diorite", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 23, "members": [{"entity_id": "diorite", "book_id": "relation_historique_humboldt_vol3_1825", "name": "diorite", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 17, "variants": ["diorite", "DIORITE", "dlorite", "dolerites", "dol\u00e9rite", "dol\u00e9rites"], "contexts": ["type of igneous rock", "diorite rock, geological material"]}, {"entity_id": "diorite", "book_id": "kosmos_humboldt_1845", "name": "diorite", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 6, "variants": ["diorite", "Diorite"], "contexts": ["igneous rock type", "compound rock"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "diorite", "target_book": "kosmos_humboldt_1845", "target_name": "diorite", "similarity": 1.0}], "id": 2370, "stable_key": "clu_00cba30e761c42db", "ground_truth": {"modern_name": "Diorite", "confidence": "high", "type": "mineral", "wikidata_id": "Q187408", "wikidata_description": "deep igneous rocks made of equal amounts of alkali feldspar and intermediate plagioclase, the most common stained ingredients are amphibole, biotite and pyroxene, and accessory minerals apatite and sfen; volcanic equivalent: tackle.", "wikipedia_extract": "In geology, a rock (also called a stone) is any naturally occurring solid mass or aggregate of minerals or mineraloid matter. It is categorized by the minerals included, its chemical composition, and the way in which it is formed. Rocks form the Earth's outer solid layer, the crust, and most of its interior, except for the liquid outer core and pockets of magma in the asthenosphere. The study of rocks involves multiple subdisciplines of geology, including petrology and mineralogy. It may be limited to rocks found on Earth, or it may include planetary geology that studies the rocks of other celestial objects. Rocks are usually grouped into three main groups: igneous rocks, sedimentary rocks and metamorphic rocks.", "wikipedia_url": "https://en.wikipedia.org/wiki/Diorite"}}, {"canonical_name": "portuguez", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 23, "members": [{"entity_id": "portugaise", "book_id": "relation_historique_humboldt_vol3_1825", "name": "portugaise", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["portugaise"], "contexts": ["territorial dispute origin", "Portuguese race/language"]}, {"entity_id": "portuguez", "book_id": "coloquios_da_orta_1563", "name": "portuguez", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 20, "variants": ["portuguez", "Portuguez", "portugueza", "portugu\u00eas", "vers\u00e3o portugueza"], "contexts": ["person from Portugal", "person who consumed maju"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "portugaise", "target_book": "coloquios_da_orta_1563", "target_name": "portuguez", "similarity": 0.906}], "id": 2371, "stable_key": "clu_35f73c0448783e4c", "ground_truth": {"modern_name": "Portuguese", "confidence": "high", "type": "person", "description": "A person from or related to Portugal.", "wikipedia_extract": "The Portuguese people (Portuguese: Portugueses \u2013 masculine \u2013 or Portuguesas) are a Romance-speaking ethnic group and nation indigenous to Portugal, a country that occupies the west side of the Iberian Peninsula in south-west Europe, who share culture, ancestry and language. The Portuguese state began with the founding of the County of Portugal in 868. Following the Battle of S\u00e3o Mamede (1128), Portugal gained international recognition as a kingdom through the Treaty of Zamora and the papal bull Manifestis Probatum. This Portuguese state paved the way for the Portuguese people to unite as a nation. The Portuguese explored distant lands previously unknown to Europeans\u2014in the Americas, Africa, Asia and Oceania (southwest Pacific Ocean). In 1415, with the conquest of Ceuta, the Portuguese took a significant role in the Age of Discovery, which culminated in a colonial empire."}}, {"canonical_name": "magnetic force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 23, "members": [{"entity_id": "magnetic_force", "book_id": "kosmos_humboldt_1845", "name": "magnetic force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["magnetic force"], "contexts": ["strength of magnetic field", "fundamental physical force"]}, {"entity_id": "magnetic_forces", "book_id": "kosmos_humboldt_1845", "name": "magnetic forces", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["magnetic forces"], "contexts": ["forces associated with magnetism", "forces related to magnetism"]}, {"entity_id": "magnetic_power", "book_id": "kosmos_humboldt_1845", "name": "magnetic power", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["magnetic power"], "contexts": ["force of magnetism"]}, {"entity_id": "magnetic_force", "book_id": "connexion_physical_sciences_somerville_1858", "name": "magnetic force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 8, "variants": ["magnetic force"], "contexts": ["force exerted by magnets", "force associated with magnetism"]}, {"entity_id": "magnetic_forces", "book_id": "connexion_physical_sciences_somerville_1858", "name": "magnetic forces", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["magnetic forces"], "contexts": ["forces associated with magnetism", "forces related to magnetism"]}, {"entity_id": "magnetic_power", "book_id": "connexion_physical_sciences_somerville_1858", "name": "magnetic power", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["magnetic power"], "contexts": ["strength of magnetic field"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "magnetic force", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic force", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic force", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic forces", "similarity": 0.939}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic force", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic power", "similarity": 0.944}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic forces", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic force", "similarity": 0.939}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic forces", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic forces", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic forces", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic power", "similarity": 0.9}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic power", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic force", "similarity": 0.944}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic power", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic forces", "similarity": 0.9}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic power", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic power", "similarity": 1.0}], "id": 2372, "stable_key": "clu_73fce4e90b09b874", "ground_truth": {"modern_name": "Magnetic force", "confidence": "high", "type": "concept", "wikidata_id": "Q11408", "wikidata_description": "spatial distribution of vectors allowing the calculation of the magnetic force on a test particle", "wikipedia_url": "https://en.wikipedia.org/wiki/Magnetic%20field", "wikipedia_extract": "A magnetic field (sometimes called B-field) is a physical field that describes the magnetic influence on moving electric charges, electric currents, and magnetic materials. A moving charge in a magnetic field experiences a force perpendicular to its own velocity and to the magnetic field. A permanent magnet's magnetic field pulls on ferromagnetic materials such as iron, and attracts or repels other magnets. In addition, a nonuniform magnetic field exerts minuscule forces on \"nonmagnetic\" materials by three other magnetic effects: paramagnetism, diamagnetism, and antiferromagnetism, although these forces are usually so small they can only be detected by laboratory equipment. Magnetic fields surround magnetized materials, electric currents, and electric fields varying in time. Since both strength and direction of a magnetic field may vary with location, it is described mathematically by a function assigning a vector to each point of space, called a vector field (more precisely, a pseudovector field)."}}, {"canonical_name": "papoulas", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 23, "members": [{"entity_id": "papoula", "book_id": "coloquios_da_orta_1563", "name": "papoula", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["papoula"], "contexts": ["plant cultivated for opium"]}, {"entity_id": "papoulas", "book_id": "polyanthea_medicinal", "name": "papoulas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 20, "variants": ["papoulas", "Papoulas", "papoulis"], "contexts": ["remedy for thin humor", "ingredient in a syrup"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "papoula", "target_book": "polyanthea_medicinal", "target_name": "papoulas", "similarity": 0.918}], "id": 2373, "stable_key": "clu_e3c5b4c04bbf88a5-3", "ground_truth": {"modern_name": "Poppy", "confidence": "high", "type": "plant", "linnaean": "Papaver somniferum Linnaeus", "family": "Papaveraceae", "wikidata_id": "Q967457", "wikidata_description": "common name for various plant species of the family Papaveraceae", "wikipedia_url": "https://en.wikipedia.org/wiki/Poppy", "wikipedia_extract": "A poppy is a flowering plant in the subfamily Papaveroideae of the family Papaveraceae. Poppies are herbaceous plants, often grown for their colourful flowers. One species of poppy, Papaver somniferum, is the source of the narcotic drug mixture opium, which contains powerful medicinal alkaloids such as morphine and has been used since ancient times as an analgesic and narcotic medicinal and recreational drug. It also produces edible seeds. Following the trench warfare in the poppy fields of Flanders, Belgium, during World War I, poppies, specifically the red poppy, have become a symbol of remembrance of soldiers who have died during wartime, especially in the UK, Canada, Australia, Africa and other Commonwealth realms. Poppies are herbaceous annual, biennial or short-lived perennial plants.", "description": "A flowering plant, source of opium and other medicinal compounds.", "note": "Likely refers to species of Papaver, particularly Papaver somniferum."}}, {"canonical_name": "Halley\u2019s comet", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 23, "members": [{"entity_id": "halley's_great_comet", "book_id": "kosmos_humboldt_1845", "name": "Halley's great comet", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Halley's great comet"], "contexts": ["specific comet with long orbit"]}, {"entity_id": "comete_de_halley", "book_id": "kosmos_humboldt_1845", "name": "Comete de Halley", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Comete de Halley"], "contexts": ["subject of physical changes"]}, {"entity_id": "halley\u2019s_comet", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Halley\u2019s comet", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 12, "variants": ["Halley\u2019s comet"], "contexts": ["comet whose motion is studied", "comet whose periodicity was established"]}, {"entity_id": "halley's_comet", "book_id": "kosmos_humboldt_1845", "name": "Halley's comet", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 8, "variants": ["Halley's comet"], "contexts": ["comet known from 1456 observation", "comet observed in 1835"]}, {"entity_id": "faye\u2019s_comet", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Faye\u2019s Comet", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Faye\u2019s Comet"], "contexts": ["a specific comet"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Halley's great comet", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Halley\u2019s comet", "similarity": 0.942}, {"source_book": "kosmos_humboldt_1845", "source_name": "Comete de Halley", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Halley\u2019s comet", "similarity": 0.949}, {"source_book": "kosmos_humboldt_1845", "source_name": "Halley's comet", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Faye\u2019s Comet", "similarity": 0.891}], "id": 2374, "stable_key": "clu_fcdde409c9383bca", "ground_truth": {"modern_name": "Halley's Comet", "confidence": "high", "type": "object", "note": "Faye's Comet is a different comet, but mentioned in the same text as Halley's comet, likely for comparison or contextualization.", "wikidata_id": "Q23054", "wikidata_description": "short-period comet visible from Earth every 75\u201376 years", "wikipedia_url": "https://en.wikipedia.org/wiki/Halley%27s%20Comet", "wikipedia_extract": "Halley's Comet is the only known short-period comet that is consistently visible to the naked eye from Earth, appearing every 72\u201380 years, though with the majority of recorded apparitions (25 of 30) occurring after 75\u201377 years. It last appeared in the inner parts of the Solar System in 1986 and will next appear in mid-2061. Officially designated 1P/Halley, it is also commonly called Comet Halley, or sometimes simply Halley. Halley's periodic returns to the inner Solar System have been observed and recorded by astronomers around the world since at least 240 BC, but it was not until 1705 that the English astronomer Edmond Halley understood that these appearances were re-appearances of the same comet. As a result of this discovery, the comet is named after Halley. In March 1986, during its latest visit to the inner Solar System, Halley's Comet became the first comet to be observed in detail by a spacecraft, ESA's Giotto mission, providing the first observational data on the structure of a comet nucleus and the mechanism of coma and tail formation."}}, {"canonical_name": "animales", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 22, "members": [{"entity_id": "mati\u00e8res_animales", "book_id": "epoques_nature_buffon_1778", "name": "mati\u00e8res animales", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["mati\u00e8res animales"], "contexts": ["animal matter as source of earth", "substances derived from animals"]}, {"entity_id": "mati\u00e8re_animale", "book_id": "epoques_nature_buffon_1778", "name": "mati\u00e8re animale", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["mati\u00e8re animale"], "contexts": ["substance derived from animals"]}, {"entity_id": "animales", "book_id": "historia_medicinal_monardes_1574", "name": "animales", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 17, "variants": ["animales", "Animales", "animal"], "contexts": ["animals that hibernate", "animals sacrificed and found"]}, {"entity_id": "an\u00edmales", "book_id": "historia_medicinal_monardes_1574", "name": "an\u00edmales", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["an\u00edmales"], "contexts": ["animals"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "mati\u00e8res animales", "target_book": "historia_medicinal_monardes_1574", "target_name": "animales", "similarity": 0.903}, {"source_book": "epoques_nature_buffon_1778", "source_name": "mati\u00e8res animales", "target_book": "historia_medicinal_monardes_1574", "target_name": "an\u00edmales", "similarity": 0.893}, {"source_book": "epoques_nature_buffon_1778", "source_name": "mati\u00e8re animale", "target_book": "historia_medicinal_monardes_1574", "target_name": "animales", "similarity": 0.922}, {"source_book": "epoques_nature_buffon_1778", "source_name": "mati\u00e8re animale", "target_book": "historia_medicinal_monardes_1574", "target_name": "an\u00edmales", "similarity": 0.899}], "id": 2375, "stable_key": "clu_b22ec8600b303cc3", "ground_truth": {"modern_name": "animal matter", "confidence": "high", "type": "substance"}}, {"canonical_name": "Daubeney", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 22, "members": [{"entity_id": "daubeny", "book_id": "epoques_nature_buffon_1778", "name": "Daubeny", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Daubeny"], "contexts": ["observer of volcanoes"]}, {"entity_id": "daubeney", "book_id": "kosmos_humboldt_1845", "name": "Daubeney", "category": "PERSON", "subcategory": "SCHOLAR", "count": 21, "variants": ["Daubeney"], "contexts": ["author on volcanoes", "author of 'On Volcanoes'"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Daubeny", "target_book": "kosmos_humboldt_1845", "target_name": "Daubeney", "similarity": 0.911}], "id": 2376, "stable_key": "clu_35e9c5daa396b002", "ground_truth": {"modern_name": "Charles Daubeny", "confidence": "high", "type": "person", "birth_year": 1795, "death_year": 1867, "description": "English chemist, botanist, and geologist, studied volcanoes.", "wikidata_id": "Q1064058", "wikidata_description": "English chemist, botanist, and geologist (1795-1867)", "wikipedia_url": "https://en.wikipedia.org/wiki/Charles%20Daubeny"}}, {"canonical_name": "Geology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 22, "members": [{"entity_id": "geology", "book_id": "origin_of_species_darwin_1859", "name": "Geology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 11, "variants": ["geology", "Geology"], "contexts": ["study of Earth's history", "study of the Earth's physical history"]}, {"entity_id": "geology", "book_id": "kosmos_humboldt_1845", "name": "Geology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 11, "variants": ["Geology", "geology"], "contexts": ["science of the Earth's physical structure", "study of the Earth's physical history"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Geology", "target_book": "kosmos_humboldt_1845", "target_name": "Geology", "similarity": 1.0}], "id": 2377, "stable_key": "clu_cca7badc2a4ee24a-2", "ground_truth": {"modern_name": "Geology", "confidence": "high", "type": "concept", "wikidata_id": "Q1069", "wikidata_description": "study of the composition, structure, physical properties, and history of Earth's components, and the processes by which they are shaped", "wikipedia_url": "https://en.wikipedia.org/wiki/Geology", "wikipedia_extract": "Geology is a branch of natural science concerned with the Earth and other astronomical bodies, the rocks of which they are composed, and the processes by which they change over time. The name comes from Ancient Greek  \u03b3\u1fc6 (g\u00ea) 'earth' and  \u03bbo\u03b3\u03af\u03b1 (-log\u00eda) 'study of, discourse'. Modern geology significantly overlaps all other Earth sciences, including hydrology. It is integrated with Earth system science and planetary science. Geology describes the structure of the Earth on and beneath its surface and the processes that have shaped that structure. Geologists study the mineralogical composition of rocks in order to get insight into their history of formation."}}, {"canonical_name": "La Plata", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 22, "members": [{"entity_id": "la_plata", "book_id": "origin_of_species_darwin_1859", "name": "La Plata", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 9, "variants": ["La Plata"], "contexts": ["plains with introduced European plants", "plains where woodpeckers feed on fruit"]}, {"entity_id": "la_plata", "book_id": "relation_historique_humboldt_vol3_1825", "name": "La Plata", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 13, "variants": ["La Plata", "La Palma", "La Platte"], "contexts": ["free government", "city in Bolivia"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "La Plata", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "La Plata", "similarity": 1.0}], "id": 2378, "stable_key": "clu_6e2fceaa37307c04-2", "ground_truth": {"modern_name": "R\u00edo de la Plata", "confidence": "high", "type": "place", "country": "Argentina/Uruguay", "note": "The text likely refers to the estuary, which is often called 'La Plata', and the surrounding regions.", "wikidata_id": "Q35827", "wikidata_description": "estuary formed by the confluence of the Uruguay River and the Paran\u00e1 River on the border between Argentina and Uruguay"}}, {"canonical_name": "Baracoa", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 22, "members": [{"entity_id": "baracoa", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Baracoa", "category": "PLACE", "subcategory": "CITY", "count": 21, "variants": ["Baracoa", "Barracoa", "Barucoa"], "contexts": ["port and oldest European settlement", "port, oldest European settlement"]}, {"entity_id": "baracoa", "book_id": "kosmos_humboldt_1845", "name": "Baracoa", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Baracoa"], "contexts": ["location near fan palm"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Baracoa", "target_book": "kosmos_humboldt_1845", "target_name": "Baracoa", "similarity": 0.86}], "id": 2379, "stable_key": "clu_15b06e82dd92a00c", "ground_truth": {"modern_name": "Baracoa", "confidence": "high", "type": "place", "country": "Cuba"}}, {"canonical_name": "ear", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 22, "members": [{"entity_id": "ear", "book_id": "principles_of_psychology_james_1890", "name": "ear", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 16, "variants": ["ear"], "contexts": ["organ of hearing", "organ of hearing, receives results of piano key action"]}, {"entity_id": "ear", "book_id": "connexion_physical_sciences_somerville_1858", "name": "ear", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 6, "variants": ["ear"], "contexts": ["astonishing acuteness and delicacy of the ear", "organ of hearing"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "ear", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "ear", "similarity": 1.0}], "id": 2380, "stable_key": "clu_d1f6855e7d689294", "ground_truth": {"modern_name": "Ear", "confidence": "high", "type": "object", "wikidata_id": "Q3610875", "wikidata_description": "the hearing and balance organ in humans"}}, {"canonical_name": "Olbers", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 22, "members": [{"entity_id": "olbers", "book_id": "kosmos_humboldt_1845", "name": "Olbers", "category": "PERSON", "subcategory": "SCHOLAR", "count": 19, "variants": ["Olbers"], "contexts": ["astronomer, published in Astr. Nachr.", "discovered comet in 1815"]}, {"entity_id": "olbers", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Olbers", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Olbers"], "contexts": ["determined comet's head radius", "astronomer associated with a comet"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Olbers", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Olbers", "similarity": 1.0}], "id": 2381, "stable_key": "clu_c883325b2428acda", "ground_truth": {"modern_name": "Heinrich Wilhelm Olbers", "confidence": "high", "type": "person", "birth_year": 1758, "death_year": 1840, "description": "German astronomer who discovered asteroids and comets."}}, {"canonical_name": "Parallax", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 22, "members": [{"entity_id": "parallaxes", "book_id": "kosmos_humboldt_1845", "name": "parallaxes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["parallaxes", "Parallaxes"], "contexts": ["measurement for stellar distances", "apparent shift in celestial object position"]}, {"entity_id": "parallax", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Parallax", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 18, "variants": ["parallax", "Parallax"], "contexts": ["apparent shift in celestial object position", "angle for distance measurement"]}, {"entity_id": "parallaxes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "parallaxes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["parallaxes"], "contexts": ["astronomical measurement"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "parallaxes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Parallax", "similarity": 0.934}, {"source_book": "kosmos_humboldt_1845", "source_name": "parallaxes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "parallaxes", "similarity": 1.0}], "id": 2382, "stable_key": "clu_5fd81c623f758bf1", "ground_truth": {"modern_name": "Parallax", "confidence": "high", "type": "concept", "wikidata_id": "Q12129", "wikidata_description": "unit of length used in astronomy", "wikipedia_url": "https://en.wikipedia.org/wiki/Parsec", "wikipedia_extract": "The parsec (symbol: pc) is a unit of length used to measure the large distances to astronomical objects outside the Solar System, approximately equal to 3.26 light-years or 206265 astronomical units (au), i.e. 30.9 trillion kilometres (19.2 trillion miles). The parsec unit is obtained by the use of parallax and trigonometry, and is defined as the distance at which 1 au subtends an angle of one arcsecond (\u20601/3600\u2060 of a degree). The nearest star, Proxima Centauri, is about 1.3 parsecs (4.2 light-years) from the Sun: from that distance, the gap between the Earth and the Sun spans slightly less than one arcsecond. Most stars visible to the naked eye are within a few hundred parsecs of the Sun, with the most distant at a few thousand parsecs, and the Andromeda Galaxy at over 700,000 parsecs. The word parsec is a shortened form of a distance corresponding to a parallax of one arcsecond, coined by the British astronomer Herbert Hall Turner in 1913."}}, {"canonical_name": "Glossary", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 22, "members": [{"entity_id": "glossary", "book_id": "coloquios_da_orta_1563", "name": "Glossary", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 19, "variants": ["Glossary", "Glossaire", "Gloss\u00e1rio"], "contexts": ["reference work", "book title"]}, {"entity_id": "dictionario", "book_id": "coloquios_da_orta_1563", "name": "Dictionario", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Dictionario"], "contexts": ["book by Ant\u00f3nio de Lebrixa", "a vocabulary book"]}, {"entity_id": "dictionario", "book_id": "polyanthea_medicinal", "name": "Dictionario", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Dictionario"], "contexts": ["title of a work"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Glossary", "target_book": "polyanthea_medicinal", "target_name": "Dictionario", "similarity": 0.954}, {"source_book": "coloquios_da_orta_1563", "source_name": "Dictionario", "target_book": "polyanthea_medicinal", "target_name": "Dictionario", "similarity": 1.0}], "id": 2383, "stable_key": "clu_508d3605f4482447", "ground_truth": {"modern_name": "Glossary", "confidence": "high", "type": "object", "description": "Reference work containing definitions of terms.", "wikipedia_extract": "A glossary (from Ancient Greek: \u03b3\u03bb\u1ff6\u03c3\u03c3\u03b1, glossa; language, speech, wording), also known as a vocabulary or clavis, is an alphabetical list of terms in a particular domain of knowledge with the definitions for those terms. Traditionally, a glossary appears at the end of a book and includes terms within that book that are either newly introduced, uncommon, or specialized. While glossaries are most commonly associated with non-fiction books, in some cases, fiction novels sometimes include a glossary for unfamiliar terms. A bilingual glossary is a list of terms in one language defined in a second language or glossed by synonyms (or at least near-synonyms) in another language. In a general sense, a glossary contains explanations of concepts relevant to a certain field of study or action. In this sense, the term is related to the notion of ontology."}}, {"canonical_name": "Alhos", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 22, "members": [{"entity_id": "alhos", "book_id": "coloquios_da_orta_1563", "name": "alhos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["alhos", "alho"], "contexts": ["ingredient for flavoring food", "garlic, mixed with calamus for horses"]}, {"entity_id": "alhos", "book_id": "polyanthea_medicinal", "name": "Alhos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 15, "variants": ["Alhos", "alhas", "alho", "alhoa", "alhos"], "contexts": ["garlic", "flatulent food"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "alhos", "target_book": "polyanthea_medicinal", "target_name": "Alhos", "similarity": 0.989}], "id": 2384, "stable_key": "clu_a3c70b05c715ad37", "ground_truth": {"modern_name": "Garlic", "confidence": "high", "type": "plant", "linnaean": "Allium sativum Linnaeus", "family": "Amaryllidaceae", "wikidata_id": "Q23400", "wikidata_description": "species of plant (for the food, use Q21546392)", "wikipedia_url": "https://en.wikipedia.org/wiki/Garlic", "wikipedia_extract": "Garlic (Allium sativum) is a species of bulbous flowering plants in the genus Allium. Its close relatives include the onion, shallot, leek, chives, Welsh onion, and Chinese onion. Garlic is native to central and western Asia, stretching from the Black Sea through the southern Caucasus, northeastern Iran, and the Hindu Kush. It has naturalized in many other parts of the world, including Mediterranean Europe and China. There are two subspecies and hundreds of varieties of garlic. Garlic has been used for thousands of years as a seasoning, culinary ingredient, and traditional medical remedy.", "description": "A pungent bulbous plant used as food and medicine."}}, {"canonical_name": "castanhas", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 22, "members": [{"entity_id": "castanhas", "book_id": "coloquios_da_orta_1563", "name": "castanhas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["castanhas", "castanha", "castanhas da jaca", "castanho"], "contexts": ["description of a fruit's taste when dry", "chestnuts, used for comparison of taste"]}, {"entity_id": "castanhas", "book_id": "polyanthea_medicinal", "name": "castanhas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 15, "variants": ["castanhas", "Castanhas", "cafcasdecaftanhas", "caftanhas", "castanha", "ca\u017ftanhas"], "contexts": ["nutritious food", "source of powder for treatment"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "castanhas", "target_book": "polyanthea_medicinal", "target_name": "castanhas", "similarity": 1.0}], "id": 2385, "stable_key": "clu_4d6ffa0e20b112d8", "ground_truth": {"modern_name": "Chestnuts", "confidence": "high", "type": "plant", "description": "Edible nuts from trees, used as food and in medicinal preparations.", "wikipedia_extract": "Chestnuts are the deciduous trees and shrubs in the genus Castanea, in the beech family Fagaceae. The name also refers to the edible nuts they produce. They are native to temperate regions of the Northern Hemisphere. Chestnut trees are of moderate growth rate (for the Chinese chestnut tree) to fast growth rate (for American and European species). Their mature heights vary from the smallest species of chinkapins, often shrubby, to the giant of past American forests, C. dentata that could reach 30 metres (98 feet). Between these extremes are found the Japanese chestnut tree (C. crenata) at 10 m average; followed by the Chinese chestnut tree (C. mollissima) at about 15 m, then the European chestnut tree (C. sativa) around 30 m."}}, {"canonical_name": "incenfo", "category": "PLANT", "subcategory": "RESIN", "book_count": 2, "total_mentions": 22, "members": [{"entity_id": "incenfo", "book_id": "ricettario_fiorentino_1597", "name": "incenfo", "category": "PLANT", "subcategory": "RESIN", "count": 14, "variants": ["incenfo", "Inccnfo", "Incenfo", "Incenfomaftio", "incenio"], "contexts": ["gum from the Thurifera tree", "fragrant resin"]}, {"entity_id": "incenfo", "book_id": "polyanthea_medicinal", "name": "incenfo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["incenfo"], "contexts": ["frankincense, plaster ingredient", "incense used in pills"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "incenfo", "target_book": "polyanthea_medicinal", "target_name": "incenfo", "similarity": 0.719}], "id": 2386, "stable_key": "clu_b4c07ea1cafd6b2b-2", "ground_truth": {"modern_name": "Frankincense", "confidence": "high", "type": "plant", "linnaean": "Boswellia sacra", "family": "Burseraceae", "note": " 'Incenso' in early modern Portuguese and Italian texts typically refers to frankincense, derived from Boswellia species.", "wikidata_id": "Q133964", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Boswellia%20sacra", "wikipedia_extract": "Boswellia sacra, also known as Boswellia carteri and others, and commonly called the frankincense tree or the olibanum tree, is a tree in the genus Boswellia, in the Burseraceae family, from which frankincense, a resinous dried sap, is harvested. The olibanum tree is a plant native to the countries of Oman and Yemen, in the south of the Arabian Peninsula, and to Somalia and Ethiopia, in the Horn of Africa. In 2012, it was replanted in Israel in the Middle East, 1,500 years after dying out there. The Boswellia sacra species is a small deciduous tree that grows to a height of 2 to 8 m (6 ft 7 in to 26 ft 3 in), with one or more trunks. The bark has the texture of paper and can be easily removed. The tree has compound leaves and an odd number of leaflets that grow opposite to one another; the small, yellow-white flowers are gathered in axillary clusters composed of five petals, ten stamens, and a cup with five teeth; new leaves feature a downy covering.", "description": "Resinous tree producing aromatic incense, also used medicinally."}}, {"canonical_name": "empirisme", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "empirisme", "book_id": "medecine_experimentale_bernard_1865", "name": "empirisme", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 15, "variants": ["empirisme"], "contexts": ["medical practice based on observation", "approach based on observation and experience"]}, {"entity_id": "empiricism", "book_id": "kosmos_humboldt_1845", "name": "empiricism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["Empiricism", "empiricism"], "contexts": ["philosophical approach based on experience", "philosophy based on experience and observation"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "empirisme", "target_book": "kosmos_humboldt_1845", "target_name": "empiricism", "similarity": 0.976}], "id": 2387, "stable_key": "clu_fde4cd17c1e6d767", "ground_truth": {"modern_name": "empiricism", "confidence": "high", "type": "concept", "wikidata_id": "Q83368", "wikidata_description": "theory that states that knowledge comes only or primarily from sensory experience", "wikipedia_url": "https://en.wikipedia.org/wiki/Empiricism"}}, {"canonical_name": "cura", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "curava", "book_id": "historia_medicinal_monardes_1574", "name": "curava", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["curava"], "contexts": ["illness the Cacique was being treated for"]}, {"entity_id": "cura", "book_id": "polyanthea_medicinal", "name": "cura", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 20, "variants": ["cura", "Cura", "cura , quocumque \u00e0 morfu tempore"], "contexts": ["the act of healing", "process of healing"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "curava", "target_book": "polyanthea_medicinal", "target_name": "cura", "similarity": 0.916}], "id": 2388, "stable_key": "clu_722e84a0e7a72588", "ground_truth": {"modern_name": "Cure", "confidence": "high", "type": "concept", "description": "The process of healing or the act of treating an illness.", "wikipedia_extract": "A cure is a substance or procedure that resolves a medical condition. This may include a medication, a surgical operation, a lifestyle change, or even a philosophical shift that alleviates a person's suffering or achieves a state of healing. The medical condition can be a disease, mental illness or genetic disorder. An incurable disease is not necessarily a terminal illness, and conversely, a curable illness can still be fatal. The cure fraction or cure rate\u2014the proportion of people with a disease who are cured by a given treatment\u2014is determined by comparing disease-free survival in treated individuals against a matched control group without the disease. Another method for determining the cure fraction and/or \"cure time\" involves measuring when the hazard rate in a diseased group returns to the hazard rate observed in the general population."}}, {"canonical_name": "Linschoten", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "linschotten", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Linschotten", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Linschotten"], "contexts": ["diligent enquirer in Oriental Navigations"]}, {"entity_id": "linschoten", "book_id": "coloquios_da_orta_1563", "name": "Linschoten", "category": "PERSON", "subcategory": "SCHOLAR", "count": 20, "variants": ["Linschoten"], "contexts": ["mentioned Anacardium occidentale", "author of Navigatio ac Itinerarium"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Linschotten", "target_book": "coloquios_da_orta_1563", "target_name": "Linschoten", "similarity": 0.983}], "id": 2389, "stable_key": "clu_cda829f8f8741976", "ground_truth": {"modern_name": "Jan Huygen van Linschoten", "confidence": "high", "type": "person", "birth_year": 1563, "death_year": 1611, "description": "Dutch explorer and merchant who wrote extensively on Asia.", "wikidata_id": "Q941383", "wikidata_description": "Dutch Protestant merchant, traveller and historian (1563\u20131611)"}}, {"canonical_name": "Polypo", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "polipus", "book_id": "english_physician_1652", "name": "Polipus", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 6, "variants": ["Polipus"], "contexts": ["stinking sores in the nose", "fleshy growth in the nose"]}, {"entity_id": "polypo", "book_id": "polyanthea_medicinal", "name": "Polypo", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 15, "variants": ["Polypo", "Polipos", "Polypos", "polyp.", "polypo", "polypos"], "contexts": ["medical condition in the nose", "growth in the nose"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Polipus", "target_book": "polyanthea_medicinal", "target_name": "Polypo", "similarity": 0.887}], "id": 2390, "stable_key": "clu_609001a83d19885b", "ground_truth": {"modern_name": "Polyps", "confidence": "high", "type": "disease", "description": "An abnormal growth of tissue, often in the nose or other mucous membranes.", "wikipedia_extract": "A polyp in zoology is one of two forms  found in the phylum Cnidaria, the other being the medusa. Polyps are roughly cylindrical in shape and elongated at the axis of the vase-shaped body. In solitary polyps, the aboral (opposite to oral) end is attached to the substrate by means of a disc-like holdfast called a pedal disc, while in colonies of polyps it is connected to other polyps, either directly or indirectly. The oral end contains the mouth, and is surrounded by a circlet of tentacles. In the class Anthozoa, comprising the sea anemones and corals, the individual is always a polyp; in the class Hydrozoa, however, the individual may be either a polyp or a medusa, with most species undergoing a life cycle with both a polyp stage and a medusa stage. In the class Scyphozoa, the medusa stage is dominant, and the polyp stage may or may not be present, depending on the family."}}, {"canonical_name": "Antigos", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "antiguos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "antiguos", "category": "PERSON", "subcategory": "AUTHORITY", "count": 4, "variants": ["antiguos"], "contexts": ["ancient authorities", "ancient authorities on plants"]}, {"entity_id": "antigos", "book_id": "polyanthea_medicinal", "name": "Antigos", "category": "PERSON", "subcategory": "AUTHORITY", "count": 17, "variants": ["Antigos", "antigos"], "contexts": ["ancient authorities", "ancient people"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "antiguos", "target_book": "polyanthea_medicinal", "target_name": "Antigos", "similarity": 0.905}], "id": 2391, "stable_key": "clu_c311a2444a4db930", "ground_truth": {"modern_name": "Ancient Authorities", "confidence": "high", "type": "concept", "note": "This refers to a general concept of citing past experts, rather than a specific individual or group."}}, {"canonical_name": "palo", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "palo", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "palo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["palo"], "contexts": ["a plant used medicinally", "wood for handles"]}, {"entity_id": "palo_apul", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "palo apul", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["palo apul"], "contexts": ["name for guayacan tree based on color"]}, {"entity_id": "palo", "book_id": "historia_medicinal_monardes_1574", "name": "palo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 18, "variants": ["palo", "Palo", "Palo lan\u00e9to", "Palo \u017fan", "palo Gno feaanejo"], "contexts": ["wood used for medicine", "wood, likely for infusion"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "palo", "target_book": "historia_medicinal_monardes_1574", "target_name": "palo", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "palo apul", "target_book": "historia_medicinal_monardes_1574", "target_name": "palo", "similarity": 0.924}], "id": 2392, "stable_key": "clu_1ad56ee054a4873f", "ground_truth": {"modern_name": "guayacan tree", "confidence": "high", "type": "plant", "family": "Zygophyllaceae", "note": "The term 'palo' is a general Spanish word for 'stick' or 'wood', but in these contexts, especially with 'palo apul' and in medicinal histories, it refers to a specific tree, most likely Guaiacum officinale or sanctum (palo santo), known for its medicinal properties.", "wikidata_id": "Q1028485", "wikidata_description": "type of wood known for being particularly heavy and hard", "wikipedia_url": "https://en.wikipedia.org/wiki/Lignum%20vitae"}}, {"canonical_name": "Veragua", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "veragua", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Veragua", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 20, "variants": ["Veragua", "Varagua", "Veragna"], "contexts": ["city with population 30,000", "province name"]}, {"entity_id": "veragua", "book_id": "historia_medicinal_monardes_1574", "name": "Veragua", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Veragua"], "contexts": ["region near Nata"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Veragua", "target_book": "historia_medicinal_monardes_1574", "target_name": "Veragua", "similarity": 0.802}], "id": 2393, "stable_key": "clu_8a4727988d0cac62", "ground_truth": {"modern_name": "Veragua", "confidence": "high", "type": "place", "country": "Panama", "wikidata_id": "Q27135788", "wikidata_description": "chemical compound"}}, {"canonical_name": "La Condamine", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "la_condamine", "book_id": "relation_historique_humboldt_vol3_1825", "name": "La Condamine", "category": "PERSON", "subcategory": "SCHOLAR", "count": 17, "variants": ["La Condamine", "Condamine", "Fia Condamine", "M. de La Condamine", "M. de La Cundamine", "de la Condamine"], "contexts": ["proposed expedition in 1734", "affirmed absence of stones"]}, {"entity_id": "la_condamine", "book_id": "kosmos_humboldt_1845", "name": "La Condamine", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["La Condamine"], "contexts": ["erected monument at equator", "made observation in Journal du Voyage"]}, {"entity_id": "condamine,_la", "book_id": "kosmos_humboldt_1845", "name": "Condamine, La", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Condamine, La"], "contexts": ["mentioned pendulum use for seconds"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "La Condamine", "target_book": "kosmos_humboldt_1845", "target_name": "La Condamine", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "La Condamine", "target_book": "kosmos_humboldt_1845", "target_name": "Condamine, La", "similarity": 0.949}], "id": 2394, "stable_key": "clu_a5de60d4c29fadec", "ground_truth": {"modern_name": "Charles Marie de La Condamine", "confidence": "high", "type": "person", "birth_year": 1701, "death_year": 1774, "description": "French explorer, scientist, and writer; known for his measurements of the Earth.", "wikidata_id": "Q26681", "wikidata_description": "French explorer, geographer, and mathematician (1701-1774)", "wikipedia_extract": "Fran\u00e7ois-Marie Arouet (French: [f\u0281\u0251\u0303swa ma\u0281i a\u0281w\u025b]; 21 November 1694 \u2013 30 May 1778), known by his pen name Voltaire (, US also ; French: [v\u0254lt\u025b\u02d0\u0281]), was a French Enlightenment writer, philosopher (philosophe), satirist, and historian. Famous for his wit and his criticism of Christianity (especially of the Catholic Church) and of slavery, Voltaire was an advocate of freedom of speech, freedom of religion, and separation of church and state. Voltaire was a versatile and prolific writer, producing works in almost every literary form, including plays, poems, novels, essays, histories, and even scientific expositions. He wrote more than 20,000 letters and 2,000 books and pamphlets. Voltaire was one of the first authors to become renowned and commercially successful internationally. He was an outspoken advocate of civil liberties and was at constant risk from the strict censorship laws of the Catholic French monarchy.", "wikipedia_url": "https://en.wikipedia.org/wiki/Charles_Marie_de_La_Condamine"}}, {"canonical_name": "p\u00f4les magn\u00e9tiques", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "p\u00f4les_magn\u00e9tiques", "book_id": "relation_historique_humboldt_vol3_1825", "name": "p\u00f4les magn\u00e9tiques", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 16, "variants": ["p\u00f4les magn\u00e9tiques", "h\u00e9misph\u00e8res magn\u00e9tiques", "l'\u00e9quateur magn\u00e9tique", "m\u00e9ridien magn\u00e9tique", "p\u00f4le magn\u00e9tique bor\u00e9al", "\u00e9quateur magn\u00e9tique"], "contexts": ["magnetic properties of serpentine", "magnetic poles"]}, {"entity_id": "magnetic_poles", "book_id": "kosmos_humboldt_1845", "name": "Magnetic poles", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["magnetic poles", "Magnetic poles"], "contexts": ["points of zero horizontal magnetic power", "poles of cold"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "p\u00f4les magn\u00e9tiques", "target_book": "kosmos_humboldt_1845", "target_name": "Magnetic poles", "similarity": 0.88}], "id": 2395, "stable_key": "clu_65aa1e1defc8c614", "ground_truth": {"modern_name": "Magnetic poles", "confidence": "high", "type": "concept", "wikidata_id": "Q63245279", "wikidata_description": "wandering point on the Earth where the geomagnetic field lines are directed vertically, either upwards or downwards"}}, {"canonical_name": "61 Cygni", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "61_cygni", "book_id": "kosmos_humboldt_1845", "name": "61 Cygni", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 10, "variants": ["61 Cygni"], "contexts": ["star with a specific designation", "star with considerable motion"]}, {"entity_id": "61_cygni", "book_id": "connexion_physical_sciences_somerville_1858", "name": "61 Cygni", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 11, "variants": ["61 Cygni"], "contexts": ["star with rapid proper motion", "star of the 6th magnitude"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "61 Cygni", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "61 Cygni", "similarity": 1.0}], "id": 2396, "stable_key": "clu_1e1913c3b569bdf0", "ground_truth": {"modern_name": "61 Cygni", "confidence": "high", "type": "object", "note": "This cluster refers to a star, not an animal. The 'subcategory: OTHER_ANIMAL' appears to be an error in the input data.", "wikidata_id": "Q249302", "wikidata_description": "binary star in the Cygnus constellation", "wikipedia_url": "https://en.wikipedia.org/wiki/61%20Cygni"}}, {"canonical_name": "Refraction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "refraction", "book_id": "kosmos_humboldt_1845", "name": "refraction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["refraction"], "contexts": ["bending of light"]}, {"entity_id": "refraction", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Refraction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 19, "variants": ["refraction", "Refraction"], "contexts": ["bending of light", "bending of light through different densities"]}, {"entity_id": "refractions", "book_id": "connexion_physical_sciences_somerville_1858", "name": "refractions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["refractions"], "contexts": ["bending of light"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "refraction", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Refraction", "similarity": 0.983}, {"source_book": "kosmos_humboldt_1845", "source_name": "refraction", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "refractions", "similarity": 0.948}], "id": 2397, "stable_key": "clu_77a381b408428091", "ground_truth": {"modern_name": "Refraction", "confidence": "high", "type": "concept", "wikidata_id": "Q72277", "wikidata_description": "in physics, the change in direction of a wave at the interface between two media", "wikipedia_url": "https://en.wikipedia.org/wiki/Refraction", "wikipedia_extract": "In physics, refraction is the redirection of a wave as it passes from one medium to another. The redirection can be caused by the wave's change in speed or by a change in the medium. Refraction of light is the most commonly observed phenomenon, but other waves such as sound waves and water waves also experience refraction. How much a wave is refracted is determined by the change in wave speed and the initial direction of wave propagation relative to the direction of change in speed. Optical prisms and lenses use refraction to redirect light, as does the human eye. The refractive index of materials varies with the wavelength of light, and thus the angle of the refraction also varies correspondingly."}}, {"canonical_name": "p\u00e1o", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "p\u00e1o", "book_id": "coloquios_da_orta_1563", "name": "p\u00e1o", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 15, "variants": ["p\u00e1o"], "contexts": ["source of camphor", "wood of the camphor tree"]}, {"entity_id": "pa\u00f3", "book_id": "polyanthea_medicinal", "name": "pa\u00f3", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["pa\u00f3"], "contexts": ["bread, can be harmful to nerves", "food item"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "p\u00e1o", "target_book": "polyanthea_medicinal", "target_name": "pa\u00f3", "similarity": 0.921}], "id": 2398, "stable_key": "clu_8a1ea2407ba4f0ee-3", "ground_truth": {"modern_name": "Wood", "confidence": "high", "type": "concept", "note": "The context of 'timber', 'bois', and 'woods' consistently refers to the material derived from trees, used for construction, fuel, or as a habitat.", "wikidata_id": "Q105596644", "wikidata_description": "study of wood as a material and its physical, chemical, and biological characteristics", "wikipedia_url": "https://en.wikipedia.org/wiki/Wood%20science", "description": "The hard fibrous material forming the main substance of the trunk or branches of a tree or shrub.", "wikipedia_extract": "Wood is a structural tissue/material found as xylem in the stems and roots of trees and other woody plants. Being a natural material, it is characterized as an organic material \u2013 a natural composite of cellulosic fibers that are strong in tension and embedded in a matrix of lignin and hemicelluloses that resists compression. Wood is sometimes defined as only the secondary xylem in the stems of trees, or more broadly to include the same type of tissue elsewhere, such as in the roots of trees or shrubs. In a living tree, it performs a mechanical-support function, enabling woody plants to grow large or to stand up by themselves. It also conveys water and nutrients among the leaves, other growing tissues, and the roots. Wood may also refer to other plant materials with comparable properties, and to material engineered from wood, woodchips, or fibers."}}, {"canonical_name": "Bub\u00f5es", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "boubas", "book_id": "coloquios_da_orta_1563", "name": "BOUBAS", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 4, "variants": ["BOUBAS", "boubas", "bubas"], "contexts": ["syphilis or buboes", "name given to a disease in India"]}, {"entity_id": "bub\u00f5es", "book_id": "polyanthea_medicinal", "name": "Bub\u00f5es", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 13, "variants": ["Bub\u00f5es", "Busones", "buboens", "bubones", "bub\u00f5es"], "contexts": ["buboes", "swellings associated with malignant fevers"]}, {"entity_id": "boubas", "book_id": "polyanthea_medicinal", "name": "boubas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 4, "variants": ["boubas"], "contexts": ["a type of ailment, possibly scrofula", "scrofula"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "BOUBAS", "target_book": "polyanthea_medicinal", "target_name": "Bub\u00f5es", "similarity": 0.887}, {"source_book": "coloquios_da_orta_1563", "source_name": "BOUBAS", "target_book": "polyanthea_medicinal", "target_name": "boubas", "similarity": 0.793}], "id": 2399, "stable_key": "clu_ea88bb54a31f8929", "ground_truth": {"modern_name": "Buboes", "confidence": "high", "type": "disease", "modern_term": "Buboes", "wikidata_id": "Q60207334", "wikidata_description": ""}}, {"canonical_name": "comer", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "jejuum", "book_id": "coloquios_da_orta_1563", "name": "jejuum", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["jejuum"], "contexts": ["taking medicine on an empty stomach"]}, {"entity_id": "comer", "book_id": "polyanthea_medicinal", "name": "comer", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 20, "variants": ["comer", "com\u00e9r"], "contexts": ["lack of appetite", "eating"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "jejuum", "target_book": "polyanthea_medicinal", "target_name": "comer", "similarity": 0.902}], "id": 2400, "stable_key": "clu_b122a8dfd857d136", "ground_truth": {"modern_name": "Fasting", "confidence": "high", "type": "concept", "description": "Abstaining from food, sometimes for medical reasons.", "wikipedia_extract": "Fasting is the act of refraining from eating, and sometimes drinking. However, from a purely physiological context, \"fasting\" may refer to the metabolic status of a person who has not eaten overnight (before \"breakfast\"), or to the metabolic state achieved after complete digestion and absorption of a meal. Metabolic changes in the fasting state begin after absorption of a meal (typically 3\u20135 hours after eating). A diagnostic fast is a prolonged fast, from 1\u2013100 hours long (depending on age), conducted under observation, to facilitate the investigation of a health complication (usually hypoglycemia). Many people may also fast as part of a medical procedure or a check-up, such as preceding a colonoscopy or surgery, or before certain medical tests. Intermittent fasting is a technique sometimes used for weight loss or other health benefits that incorporates regular fasting into a person's dietary schedule."}}, {"canonical_name": "doente", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "doente", "book_id": "coloquios_da_orta_1563", "name": "doente", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["doente"], "contexts": ["patient administered ground diamond"]}, {"entity_id": "doente", "book_id": "polyanthea_medicinal", "name": "doente", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 20, "variants": ["doente"], "contexts": ["patient being treated", "the sick person"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "doente", "target_book": "polyanthea_medicinal", "target_name": "doente", "similarity": 1.0}], "id": 2401, "stable_key": "clu_1912a148f56ef022", "ground_truth": {"modern_name": "Patient", "confidence": "high", "type": "concept", "note": "The Spanish/Portuguese term 'enfermo' translates directly to 'sick person' or 'patient'.", "wikidata_id": "Q181600", "wikidata_description": "person who takes a medical treatment or is subject of a case study"}}, {"canonical_name": "mufculos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "mufculos", "book_id": "polyanthea_medicinal", "name": "mufculos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 20, "variants": ["mufculos", "mufculi", "mufculo Esfinter", "mufculos do abdomen", "mufculos do ofofago", "mufculos interco\u017ftaes exteriores", "muscles", "musculos", "mu\u017fculos"], "contexts": ["body parts", "body part affected by paralysis"]}, {"entity_id": "mucous", "book_id": "first_principles_spencer_1862", "name": "mucous", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["mucous"], "contexts": ["embryonic germ layer"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "mufculos", "target_book": "first_principles_spencer_1862", "target_name": "mucous", "similarity": 0.883}], "id": 2402, "stable_key": "clu_df97001aeee63633-3", "ground_truth": {"modern_name": "Muscles", "confidence": "high", "type": "concept", "wikidata_id": "Q7365", "wikidata_description": "contractile soft tissue of animals", "wikipedia_url": "https://en.wikipedia.org/wiki/Muscle", "note": "The early modern term 'mufculos' (or 'mufculofus') is a Latinate form referring to muscles, especially in anatomical contexts. The OCR variant 'mucous' is likely a misreading or a contextually distinct usage if it refers to a bodily fluid, but the overwhelming number of occurrences point to anatomical muscles.", "wikipedia_extract": "Muscle is a specialised soft tissue, one of the four basic types of animal tissues. There are three types of muscle tissues in vertebrates:- skeletal muscle tissue, cardiac muscle tissue, and smooth muscle tissue. Muscle tissue gives skeletal muscles the ability to contract and relax. Muscle tissue contains special contractile proteins called actin and myosin which interact to cause movement. Among many other muscle proteins present are two regulatory proteins, troponin and tropomyosin. Muscle is formed during embryonic development, in a process known as myogenesis."}}, {"canonical_name": "physiologiques", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 20, "members": [{"entity_id": "physiologiques", "book_id": "medecine_experimentale_bernard_1865", "name": "physiologiques", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 16, "variants": ["physiologiques"], "contexts": ["relating to the study of bodily functions", "relating to the study of life functions"]}, {"entity_id": "physiological", "book_id": "principles_of_psychology_james_1890", "name": "physiological", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["physiological"], "contexts": ["relating to the body's functions", "relating to bodily functions"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "physiologiques", "target_book": "principles_of_psychology_james_1890", "target_name": "physiological", "similarity": 0.904}], "id": 2403, "stable_key": "clu_3cf388da36b2bef6", "ground_truth": {"modern_name": "physiological", "confidence": "high", "type": "concept", "wikidata_id": "Q521", "wikidata_description": "science regarding function of organisms or living systems", "wikipedia_url": "https://en.wikipedia.org/wiki/Physiology"}}, {"canonical_name": "vivisection", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 20, "members": [{"entity_id": "vivisection", "book_id": "medecine_experimentale_bernard_1865", "name": "vivisection", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 12, "variants": ["vivisection"], "contexts": ["surgical dissection of living organisms", "dissection of living organisms for study"]}, {"entity_id": "vivisections", "book_id": "medecine_experimentale_bernard_1865", "name": "vivisections", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 6, "variants": ["vivisections"], "contexts": ["dissection of living animals for research", "surgical experiments on living animals"]}, {"entity_id": "vivisection", "book_id": "principles_of_psychology_james_1890", "name": "vivisection", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["vivisection"], "contexts": ["surgical dissection of live animals"]}, {"entity_id": "vivisections", "book_id": "principles_of_psychology_james_1890", "name": "vivisections", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["vivisections"], "contexts": ["surgical experiments on living animals"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "vivisection", "target_book": "principles_of_psychology_james_1890", "target_name": "vivisection", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "vivisection", "target_book": "principles_of_psychology_james_1890", "target_name": "vivisections", "similarity": 0.928}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "vivisections", "target_book": "principles_of_psychology_james_1890", "target_name": "vivisection", "similarity": 0.928}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "vivisections", "target_book": "principles_of_psychology_james_1890", "target_name": "vivisections", "similarity": 1.0}], "id": 2404, "stable_key": "clu_0846f27f939e24c8", "ground_truth": {"modern_name": "vivisection", "confidence": "high", "type": "concept", "wikidata_id": "Q259567", "wikidata_description": "dissection of a living subject", "wikipedia_url": "https://en.wikipedia.org/wiki/Vivisection"}}, {"canonical_name": "argiles", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 20, "members": [{"entity_id": "argiles", "book_id": "epoques_nature_buffon_1778", "name": "argiles", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 18, "variants": ["argiles"], "contexts": ["fine-grained natural rock", "earth type for secondary mines"]}, {"entity_id": "argiles", "book_id": "relation_historique_humboldt_vol3_1825", "name": "argiles", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["argiles"], "contexts": ["a type of fine-grained natural rock or soil", "earth material"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "argiles", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "argiles", "similarity": 1.0}], "id": 2405, "stable_key": "clu_d32307ece9f8a7f8", "ground_truth": {"modern_name": "Argillaceous slate", "confidence": "high", "type": "mineral"}}, {"canonical_name": "Owen", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 20, "members": [{"entity_id": "owen", "book_id": "origin_of_species_darwin_1859", "name": "Owen", "category": "PERSON", "subcategory": "SCHOLAR", "count": 15, "variants": ["Owen"], "contexts": ["naturalist who remarked on bird anomalies", "professor who observed arm length"]}, {"entity_id": "owen", "book_id": "kosmos_humboldt_1845", "name": "Owen", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["Owen"], "contexts": ["scientist describing mylodon", "identified the dinornis"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Owen", "target_book": "kosmos_humboldt_1845", "target_name": "Owen", "similarity": 1.0}], "id": 2406, "stable_key": "clu_43c33b14556c53df-2", "ground_truth": {"modern_name": "Richard Owen", "confidence": "high", "type": "person", "birth_year": 1804, "death_year": 1892, "description": "British biologist, comparative anatomist, and paleontologist.", "wikidata_id": "Q151556", "wikidata_description": "English biologist and paleontologist (1804\u20131892)", "wikipedia_url": "https://en.wikipedia.org/wiki/Richard%20Owen", "wikipedia_extract": "Sir Richard Owen  (20 July 1804 \u2013 18 December 1892) was an English biologist, comparative anatomist and  palaeontologist. Owen is generally considered to have been an outstanding naturalist with a remarkable gift for interpreting fossils. Owen produced a vast array of scientific work, but is probably best remembered today for coining the word Dinosauria (meaning \"Terrible Reptile\" or \"Fearfully Great Reptile\"). An outspoken critic of Charles Darwin's theory of evolution by natural selection, Owen agreed with Darwin that evolution occurred but thought it was more complex than outlined in Darwin's On the Origin of Species.[page range too broad] Owen's approach to evolution can be considered to have anticipated the issues that have gained greater attention with the recent emergence of evolutionary developmental biology. Owen was the first president of the Microscopical Society of London in 1839 and edited many issues of its journal \u2013 then known as The Microscopic Journal. Owen also campaigned for the natural specimens in the British Museum to be given a new home."}}, {"canonical_name": "Silurian", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 20, "members": [{"entity_id": "silurian", "book_id": "origin_of_species_darwin_1859", "name": "Silurian", "category": "PLACE", "subcategory": "REGION", "count": 11, "variants": ["Silurian"], "contexts": ["geological period with fossiliferous rocks", "geological age"]}, {"entity_id": "silurian", "book_id": "kosmos_humboldt_1845", "name": "silurian", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 9, "variants": ["silurian"], "contexts": ["geological formation", "geological period"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Silurian", "target_book": "kosmos_humboldt_1845", "target_name": "silurian", "similarity": 0.728}], "id": 2407, "stable_key": "clu_af8464232ee820f9", "ground_truth": {"modern_name": "Silurian", "confidence": "high", "type": "concept", "note": "Refers to the Silurian geological period and system.", "wikidata_id": "Q62412", "wikidata_description": "third period of the Paleozoic Era", "wikipedia_url": "https://en.wikipedia.org/wiki/Silurian", "wikipedia_extract": "The Silurian ( sih-LURE-ee-\u0259n, sy-) is a geologic period and system spanning 23.5 million years from the end of the Ordovician Period, at 443.1 Ma (million years ago) to the beginning of the Devonian Period, 419.62 Ma. The Silurian is the third and shortest period of the Paleozoic Era, and the third of twelve periods of the Phanerozoic Eon. As with other geologic periods, the rock beds that define the period's start and end are well identified, but the exact dates are uncertain by a few million years. The base of the Silurian is set at a series of major Ordovician\u2013Silurian extinction events when up to 60% of marine genera were wiped out. One important event in this period was the initial establishment of terrestrial life in what is known as the Silurian-Devonian Terrestrial Revolution: vascular plants emerged from more primitive land plants, dikaryan fungi started expanding and diversifying along with glomeromycotan fungi, and three groups of arthropods (myriapods, arachnids and hexapods) became fully terrestrialized. Another significant evolutionary milestone during the Silurian was the diversification of jawed fish, which include placoderms, acanthodians (which gave rise to cartilaginous fish) and osteichthyan (bony fish, further divided into lobe-finned and ray-finned fishes), although this corresponded to sharp decline of jawless fish such as conodonts and ostracoderms."}}, {"canonical_name": "bubas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 20, "members": [{"entity_id": "bubas", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "bubas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 16, "variants": ["bubas"], "contexts": ["boils or swellings", "syphilitic sores treated by salsafrax"]}, {"entity_id": "bub\u00e3o", "book_id": "polyanthea_medicinal", "name": "bub\u00e3o", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 4, "variants": ["bub\u00e3o", "Bubao", "bub\u00e1o"], "contexts": ["condition treated by bloodletting", "swollen gland or tumor"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "bubas", "target_book": "polyanthea_medicinal", "target_name": "bub\u00e3o", "similarity": 0.884}], "id": 2408, "stable_key": "clu_f129edc945fc7090", "ground_truth": {"modern_name": "Bubonic plague", "confidence": "high", "type": "disease", "modern_term": "Bubonic plague", "note": "The term 'bub\u00e3o' could also refer to other conditions causing buboes, but in the context of early modern medicine and its association with significant diseases, bubonic plague is the most likely referent.", "wikidata_id": "Q217519", "wikidata_description": "human and animal disease"}}, {"canonical_name": "Chicoria", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 20, "members": [{"entity_id": "chicoria", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "chicoria", "category": "PLANT", "subcategory": "HERB", "count": 1, "variants": ["chicoria"], "contexts": ["plant with similar leaves to cempoalxochitl"]}, {"entity_id": "chichoria", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "chichoria", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["chichoria"], "contexts": ["used in water for fevers"]}, {"entity_id": "chicoria", "book_id": "polyanthea_medicinal", "name": "Chicoria", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 18, "variants": ["Chicoria", "chicharos", "chichoria", "chicoria", "chicorias", "chicorie"], "contexts": ["herb used in a syrup", "herb for juice"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "chicoria", "target_book": "polyanthea_medicinal", "target_name": "Chicoria", "similarity": 0.759}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "chichoria", "target_book": "polyanthea_medicinal", "target_name": "Chicoria", "similarity": 0.885}], "id": 2409, "stable_key": "clu_111d6de807de9b1d", "ground_truth": {"modern_name": "chicory", "confidence": "high", "type": "plant", "linnaean": "Cichorium intybus Linnaeus", "family": "Asteraceae", "wikidata_id": "Q2544599", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Chicory"}}, {"canonical_name": "Antioquia", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 20, "members": [{"entity_id": "antioquia", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Antioquia", "category": "PLACE", "subcategory": "REGION", "count": 19, "variants": ["Antioquia", "Antiocjuia"], "contexts": ["mountainous district in Spanish America", "city with population 104,000"]}, {"entity_id": "antioquia", "book_id": "kosmos_humboldt_1845", "name": "Antioquia", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Antioquia"], "contexts": ["location of observations"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Antioquia", "target_book": "kosmos_humboldt_1845", "target_name": "Antioquia", "similarity": 1.0}], "id": 2410, "stable_key": "clu_d1ead20f6bcaaec6", "ground_truth": {"modern_name": "Antioquia", "confidence": "high", "type": "place", "country": "Colombia", "wikidata_id": "Q4688300", "wikidata_description": "former regional airline in Colombia, 1987-2019", "wikipedia_url": "https://en.wikipedia.org/wiki/University_of_Antioquia", "wikipedia_extract": "The University of Antioquia (Spanish: Universidad de Antioquia), also called UdeA, is primarily a public research-based university, located in the city of Medell\u00edn, Colombia. With regional campuses in Amalfi, Andes, Caucasia, Carmen de Viboral, Envigado, Puerto Berr\u00edo, Santa Fe de Antioquia, Segovia, Sons\u00f3n, Turbo and Yarumal, it remain one of the oldest university in the region. As of 2024, we can read on their publication site that, more than 272 groups and over 5,000 faculty students, are working on 1,200 collaborative projects. Founded in 1803 after a Royal Decree was issued by King  Charles IV of Spain, under the name Franciscan College (Spanish: Colegio de Franciscanos), they have maintained their accreditation from the Ministry of Education for more than 2 centuries.. Along with the University of the Andes, each institution hold the second longest term behind the National University of Colombia. UdeA and the Tecnol\u00f3gico de Antioquia have the largest number of seats in the department of Antioquia."}}, {"canonical_name": "Arkansas", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 20, "members": [{"entity_id": "arkansas", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Arkansas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 19, "variants": ["Arkansas"], "contexts": ["river in North America", "river banks"]}, {"entity_id": "arkansas", "book_id": "kosmos_humboldt_1845", "name": "Arkansas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Arkansas"], "contexts": ["river valley"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Arkansas", "target_book": "kosmos_humboldt_1845", "target_name": "Arkansas", "similarity": 1.0}], "id": 2411, "stable_key": "clu_553d21bfc0777464", "ground_truth": {"modern_name": "Arkansas River", "confidence": "high", "type": "place", "country": "United States"}}, {"canonical_name": "Cap Codera", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 20, "members": [{"entity_id": "cap_codera", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cap Codera", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 19, "variants": ["Cap Codera", "cap Codera"], "contexts": ["geographical cape", "cape Codera"]}, {"entity_id": "cape_codera", "book_id": "kosmos_humboldt_1845", "name": "Cape Codera", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Cape Codera"], "contexts": ["geographic landmark"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cap Codera", "target_book": "kosmos_humboldt_1845", "target_name": "Cape Codera", "similarity": 0.887}], "id": 2412, "stable_key": "clu_f9b69d5c13700637", "ground_truth": {"modern_name": "Cape Codera", "confidence": "high", "type": "place", "country": "Cape Verde"}}, {"canonical_name": "lignites", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 20, "members": [{"entity_id": "lignites", "book_id": "relation_historique_humboldt_vol3_1825", "name": "lignites", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 12, "variants": ["lignites", "lignites bitumineux"], "contexts": ["type of sedimentary rock", "fossil fuel lignite"]}, {"entity_id": "lignites", "book_id": "kosmos_humboldt_1845", "name": "Lignites", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["Lignites", "lignites"], "contexts": ["combustible matter from forests", "fossil fuel"]}, {"entity_id": "lignite", "book_id": "kosmos_humboldt_1845", "name": "lignite", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["lignite"], "contexts": ["fossil fuel", "coal-like material for power"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "lignites", "target_book": "kosmos_humboldt_1845", "target_name": "Lignites", "similarity": 0.917}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "lignites", "target_book": "kosmos_humboldt_1845", "target_name": "lignite", "similarity": 0.897}], "id": 2413, "stable_key": "clu_3799529d185920ed", "ground_truth": {"modern_name": "lignite", "confidence": "high", "type": "mineral", "wikidata_id": "Q12091026", "wikidata_description": "type of mineral deposit"}}, {"canonical_name": "blue", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 20, "members": [{"entity_id": "blue", "book_id": "principles_of_psychology_james_1890", "name": "blue", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["blue"], "contexts": ["elementary quality of sensation", "a simple quality of matter"]}, {"entity_id": "blue", "book_id": "connexion_physical_sciences_somerville_1858", "name": "blue", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 16, "variants": ["blue"], "contexts": ["colour in the spectrum", "color reflected by blue cloth"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "blue", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "blue", "similarity": 1.0}], "id": 2414, "stable_key": "clu_e713e986f7c330ae", "ground_truth": {"modern_name": "blue", "confidence": "high", "type": "concept", "note": "Refers to the color blue as a quality of sensation or as part of the spectrum, not a specific chemical substance in this context.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Blue", "wikipedia_extract": "Blue is one of the three primary colours in the RGB (additive) colour model, as well as in the RYB colour model (traditional colour theory). It lies between violet and cyan on the spectrum of visible light. The term blue generally describes colours perceived by humans observing light with a dominant wavelength between approximately 450 and 495 nanometres. The clear daytime sky and the deep sea appear blue because of an optical effect known as Rayleigh scattering. An optical effect called the Tyndall effect explains blue eyes. Distant objects appear more blue because of another optical effect called aerial perspective."}}, {"canonical_name": "Iceland spar", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 20, "members": [{"entity_id": "iceland_spar", "book_id": "kosmos_humboldt_1845", "name": "Iceland spar", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Iceland spar"], "contexts": ["small fragment of Iceland spar"]}, {"entity_id": "iceland_spar", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Iceland spar", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 19, "variants": ["Iceland Spar", "Iceland spar"], "contexts": ["double refraction properties", "pure form of calcite"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Iceland spar", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Iceland spar", "similarity": 1.0}], "id": 2415, "stable_key": "clu_75a5d7c60dc1ae7e", "ground_truth": {"modern_name": "Iceland spar", "confidence": "high", "type": "mineral", "wikidata_id": "Q974568", "wikidata_description": "transparent variety of calcite", "wikipedia_url": "https://en.wikipedia.org/wiki/Iceland_spar", "wikipedia_extract": "Iceland spar, formerly called Iceland crystal (Icelandic: silfurberg [\u02c8s\u026alv\u028fr\u02ccp\u025brk], lit. 'silver-rock') and also called optical calcite, is a transparent variety of calcite, a crystallized calcium carbonate, originally brought from Iceland and used in demonstrating the polarization of light. Iceland spar is a colourless, transparent variety of calcium carbonate (CaCO3). It crystallizes in the trigonal system, typically forming rhombohedral crystals. It has a Mohs hardness of 3 and exhibits double refraction, splitting a ray of light into two rays that travel at different speeds and directions. Iceland spar forms in sedimentary environments, mainly limestone and dolomite rocks, but also in hydrothermal veins and evaporite deposits."}}, {"canonical_name": "Cinza", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 20, "members": [{"entity_id": "cinza", "book_id": "coloquios_da_orta_1563", "name": "cinza", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["cinza"], "contexts": ["remains after burning", "used by jogues, applied to forehead and chest"]}, {"entity_id": "cinza", "book_id": "polyanthea_medicinal", "name": "Cinza", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 17, "variants": ["Cinza", "cinza", "cinza de chumbo", "cinzadavide", "cinzade vides", "cinzados", "cinzas"], "contexts": ["ash used for cleaning", "ash used as remedy"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "cinza", "target_book": "polyanthea_medicinal", "target_name": "Cinza", "similarity": 0.986}], "id": 2416, "stable_key": "clu_b8e18b56fb507088-2", "ground_truth": {"modern_name": "Ash", "confidence": "high", "type": "mineral", "wikidata_id": "", "wikidata_description": "family name", "note": "The contexts suggest multiple meanings: residue after burning, bark of the Ash tree, and volcanic ash."}}, {"canonical_name": "coentro", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 20, "members": [{"entity_id": "coentro", "book_id": "coloquios_da_orta_1563", "name": "coentro", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["coentro"], "contexts": ["seed used in preparation", "seed size comparison"]}, {"entity_id": "coentro_seco", "book_id": "coloquios_da_orta_1563", "name": "coentro seco", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["coentro seco"], "contexts": ["herb used for seasoning"]}, {"entity_id": "coentro", "book_id": "polyanthea_medicinal", "name": "coentro", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 15, "variants": ["coentro", "Coentro", "coentro \u017fecco", "coentros", "\u017femente de coentro"], "contexts": ["herb used in confection for headaches", "dried herb used in preparation"]}, {"entity_id": "coentro_seco", "book_id": "polyanthea_medicinal", "name": "coentro seco", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["coentro seco"], "contexts": ["dried coriander", "dried herb used in an electuary"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "coentro", "target_book": "polyanthea_medicinal", "target_name": "coentro", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "coentro", "target_book": "polyanthea_medicinal", "target_name": "coentro seco", "similarity": 0.892}, {"source_book": "coloquios_da_orta_1563", "source_name": "coentro seco", "target_book": "polyanthea_medicinal", "target_name": "coentro", "similarity": 0.892}, {"source_book": "coloquios_da_orta_1563", "source_name": "coentro seco", "target_book": "polyanthea_medicinal", "target_name": "coentro seco", "similarity": 1.0}], "id": 2417, "stable_key": "clu_ced2294c578b6160", "ground_truth": {"modern_name": "Coriander", "confidence": "high", "type": "plant", "linnaean": "Coriandrum sativum", "family": "Apiaceae", "description": "Herb with aromatic seeds and leaves, used in medicine.", "wikipedia_extract": "Coriander (), or Coriandrum sativum, is an annual herb in the family Apiaceae. The leaves are known as cilantro () in the United States (but not in the United Kingdom). Most people perceive the leaves as having a fresh, slightly citrus taste. Due to variations in the gene OR6A2, some people perceive its flavor to be more soaplike or rotten. The species is native to the Mediterranean Basin. All parts of the plant are edible, with the fresh leaves and dried seeds most traditionally used in cooking."}}, {"canonical_name": "Tidal wave", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 20, "members": [{"entity_id": "tidal_wave", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Tidal wave", "category": "CONCEPT", "subcategory": "THEORY", "count": 17, "variants": ["Tidal Wave", "tidal wave", "Tidal wave"], "contexts": ["origin and course of ocean wave", "direction of ocean wave"]}, {"entity_id": "tidal_waves", "book_id": "connexion_physical_sciences_somerville_1858", "name": "tidal waves", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["tidal waves"], "contexts": ["waves originating from Antarctic Ocean", "course down Pacific Ocean"]}, {"entity_id": "tidal_wave", "book_id": "first_principles_spencer_1862", "name": "tidal wave", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["tidal wave"], "contexts": ["wave caused by gravitational pull of celestial bodies"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Tidal wave", "target_book": "first_principles_spencer_1862", "target_name": "tidal wave", "similarity": 0.945}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "tidal waves", "target_book": "first_principles_spencer_1862", "target_name": "tidal wave", "similarity": 0.962}], "id": 2418, "stable_key": "clu_0ed1641ecde1c438", "ground_truth": {"modern_name": "Tsunami", "confidence": "high", "type": "concept", "note": "While 'tidal wave' was used historically, 'tsunami' is the precise modern term for large ocean waves caused by seismic events.", "wikidata_id": "Q963944", "wikidata_description": "human disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Melioidosis", "wikipedia_extract": "Melioidosis is an infectious disease caused by a gram-negative bacterium called Burkholderia pseudomallei. Most people exposed to B. pseudomallei experience no symptoms, but complications can range from fever and skin changes to pneumonia, abscesses, and septic shock, which can be fatal. Approximately 10% of people with melioidosis develop symptoms that last longer than two months, termed \"chronic melioidosis\". Prior to the Vietnam war less than a handful of patients had diagnosed in the United States in the twentieth century. In 1966, Spotnitz discovered that a number of servicemen with delayed onset of pulmonary infections had previously been deployed in Vietnam."}}, {"canonical_name": "th\u00e9rapeutique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 19, "members": [{"entity_id": "th\u00e9rapeutique", "book_id": "medecine_experimentale_bernard_1865", "name": "th\u00e9rapeutique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 18, "variants": ["th\u00e9rapeutique"], "contexts": ["treatment of diseases", "the branch of medicine concerned with treatment"]}, {"entity_id": "therapeutica", "book_id": "coloquios_da_orta_1563", "name": "therapeutica", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["therapeutica"], "contexts": ["study of medicinal uses"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "th\u00e9rapeutique", "target_book": "coloquios_da_orta_1563", "target_name": "therapeutica", "similarity": 0.908}], "id": 2419, "stable_key": "clu_862087ee803917ce", "ground_truth": {"modern_name": "therapeutics", "confidence": "high", "type": "concept", "wikidata_id": "Q4056087", "wikidata_description": "regulatory body for therapeutic goods (including medicines, medical devices, gene technology, and blood products) in Australia", "wikipedia_url": "https://en.wikipedia.org/wiki/Therapeutic%20Goods%20Administration"}}, {"canonical_name": "Gold", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 19, "members": [{"entity_id": "gold", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Gold", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 10, "variants": ["Gold"], "contexts": ["precious metal sought from Ophir", "metal"]}, {"entity_id": "gold", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Gold", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 9, "variants": ["gold", "Gold"], "contexts": ["malleable metal", "metal that can be beaten thin"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Gold", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Gold", "similarity": 1.0}], "id": 2420, "stable_key": "clu_f40ee3060d273874-3", "ground_truth": {"modern_name": "Gold", "confidence": "high", "type": "mineral", "note": "The Spanish word 'oro' directly translates to 'gold'.", "wikidata_id": "Q897", "wikidata_description": "chemical element with symbol Au and atomic number 79", "wikipedia_url": "https://en.wikipedia.org/wiki/Gold", "wikipedia_extract": "Gold is a chemical element; its chemical symbol is Au (from Latin aurum) and atomic number 79. In its pure form, it is a bright-metallic-yellow, dense, soft, malleable, and ductile metal. Chemically, gold is a transition metal, a group 11 element, and one of the noble metals. It is one of the least reactive chemical elements, being the second lowest in the reactivity series, with only platinum ranked as less reactive. Gold is solid under standard conditions. Gold often occurs as the free element (native state), as nuggets or grains, in rocks, veins, and alluvial deposits."}}, {"canonical_name": "Leonardo Fioravanto", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 19, "members": [{"entity_id": "leonardo_fioravanti", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Leonardo Fioravanti", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Leonardo Fioravanti"], "contexts": ["Italian physician"]}, {"entity_id": "leonardo_fioravanto", "book_id": "polyanthea_medicinal", "name": "Leonardo Fioravanto", "category": "PERSON", "subcategory": "SCHOLAR", "count": 18, "variants": ["Leonardo Fioravanto", "Leonardus Fioravantus", "Leonel. Favent."], "contexts": ["Author of 'thesauri'", "author who praised antimony"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Leonardo Fioravanti", "target_book": "polyanthea_medicinal", "target_name": "Leonardo Fioravanto", "similarity": 0.982}], "id": 2421, "stable_key": "clu_4cdb499bc386afdd", "ground_truth": {"modern_name": "Leonardo Fioravanti", "confidence": "high", "type": "person", "description": "Italian physician and alchemist, author of 'Thesauri'.", "note": "The 'Leonardo Fuchsio' member is likely a misattribution or different spelling of Leonardo Fuchs, but given the primary context of Fioravanti's work, this identification is maintained.", "wikipedia_extract": "Leonardo Fioravanti (doctor) (1518\u20131588), Italian doctor Leonardo Fioravanti (engineer) (born 1938), Italian car designer and engineer Leonardo Fioravanti (surfer) (born 1997), Italian surfer"}}, {"canonical_name": "Mercurialis", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 19, "members": [{"entity_id": "mercurialis", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Mercurialis", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Mercurialis"], "contexts": ["author of Gymnasticks"]}, {"entity_id": "mercurialis", "book_id": "polyanthea_medicinal", "name": "Mercurialis", "category": "PERSON", "subcategory": "SCHOLAR", "count": 18, "variants": ["Mercurialis", "Mercurialis,"], "contexts": ["confirms the influence of images during conception", "consil."]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mercurialis", "target_book": "polyanthea_medicinal", "target_name": "Mercurialis", "similarity": 1.0}], "id": 2422, "stable_key": "clu_44b2a601390ceaef", "ground_truth": {"modern_name": "Joannes Messis Mercurialis", "confidence": "high", "type": "person", "birth_year": 1534, "death_year": 1614, "description": "Italian physician, anatomist, and botanist, known for works on gymnastics.", "note": "While the texts mention 'Mercurialis' and a connection to conception, the primary association in early modern texts is with Joannes Messis Mercurialis, an Italian physician and scholar."}}, {"canonical_name": "montagnes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 19, "members": [{"entity_id": "montagnes", "book_id": "epoques_nature_buffon_1778", "name": "montagnes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 18, "variants": ["montagnes"], "contexts": ["large natural elevations of the earth's surface", "elevated landforms formed by cooling"]}, {"entity_id": "mountain", "book_id": "kosmos_humboldt_1845", "name": "mountain", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["mountain"], "contexts": ["large natural elevation"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "montagnes", "target_book": "kosmos_humboldt_1845", "target_name": "mountain", "similarity": 0.947}], "id": 2423, "stable_key": "clu_6195dd804b4497c7", "ground_truth": {"modern_name": "Mountain", "confidence": "high", "type": "concept", "note": "While 'mountain' is a geographical feature, its use as a 'substance' in the context of 'anatomy' or 'physical sciences' likely refers to the material composition or geological aspect of mountains, or metaphorical elevation."}}, {"canonical_name": "Grandes-Indes", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 19, "members": [{"entity_id": "grandes_indes", "book_id": "epoques_nature_buffon_1778", "name": "Grandes Indes", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Grandes Indes"], "contexts": ["region where plants are found"]}, {"entity_id": "grandes-indes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Grandes-Indes", "category": "PLACE", "subcategory": "REGION", "count": 18, "variants": ["Grandes-Indes", "GRANDES INDES", "Grandes Indes", "grandes Indes"], "contexts": ["producer of sugar", "East Indies, a source of sugar"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Grandes Indes", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Grandes-Indes", "similarity": 0.895}], "id": 2424, "stable_key": "clu_576ede755f9d2a40", "ground_truth": {"modern_name": "East Indies", "confidence": "high", "type": "place", "country": "Indonesia", "note": "Historically, 'Grandes Indes' often referred to the broader region of Southeast Asia and the Indian subcontinent.", "wikidata_id": "Q213137", "wikidata_description": "region encompassing South (Em(Indian subcontinent) and Southeast Asia", "wikipedia_url": "https://en.wikipedia.org/wiki/East%20Indies"}}, {"canonical_name": "Somno", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 19, "members": [{"entity_id": "sleep", "book_id": "english_physician_1652", "name": "sleep", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["Sleep", "sleep"], "contexts": ["state procured by a remedy", "lack of it helped by herb application"]}, {"entity_id": "somno", "book_id": "polyanthea_medicinal", "name": "Somno", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 14, "variants": ["Somno", "Somnoque", "somno"], "contexts": ["sleep, a symptom or condition", "sleep"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "sleep", "target_book": "polyanthea_medicinal", "target_name": "Somno", "similarity": 0.911}], "id": 2425, "stable_key": "clu_043b1beb9f8d67e7", "ground_truth": {"modern_name": "Sleep", "confidence": "high", "type": "concept", "description": "A natural periodic state of rest for the body and mind.", "wikipedia_extract": "Sleep is a state of reduced mental and physical activity in which consciousness is altered and certain sensory activity is inhibited. During sleep, there is a marked decrease in muscle activity and interactions with the surrounding environment. While sleep differs from wakefulness in terms of the ability to react to stimuli, it still involves active brain patterns, making it more reactive than a coma or disorders of consciousness. Sleep occurs in repeating periods, during which the body alternates between two distinct modes: rapid eye movement sleep (REM) and non-REM sleep. Although REM stands for \"rapid eye movement\", this mode of sleep has many other aspects, including virtual paralysis of the body. Dreams are a succession of images, ideas, emotions, and sensations that usually occur involuntarily in the mind during certain stages of sleep."}}, {"canonical_name": "humores frios", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 19, "members": [{"entity_id": "cold_humors", "book_id": "english_physician_1652", "name": "cold humors", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["cold humors", "cold Humors", "cold Joynts", "cold Rhewm"], "contexts": ["cause of convulsions and cramps", "humors distilling from the brain"]}, {"entity_id": "humores_frios", "book_id": "polyanthea_medicinal", "name": "humores frios", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 15, "variants": ["humores frios", "humores frigidi"], "contexts": ["cold humors affecting nerves", "body fluids causing sudden paralysis"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "cold humors", "target_book": "polyanthea_medicinal", "target_name": "humores frios", "similarity": 0.983}], "id": 2426, "stable_key": "clu_35dc53f8de450181", "ground_truth": {"modern_name": "Cold humors", "confidence": "high", "type": "substance", "description": "Bodily fluids believed to cause illness and affect nerves.", "note": "A concept from humoral theory in ancient and medieval medicine.", "wikipedia_extract": "Humorism, the humoral theory, or humoralism, was a system of medicine detailing a supposed makeup and workings of the human body, adopted by Ancient Greek and Roman physicians and philosophers. Humorism began to fall out of favor in the 17th century and it was definitively disproved with the discovery of microbes. The concept of \"humors\" may have origins in Ancient Egyptian medicine, or Mesopotamia, though it was not systemized until ancient Greek thinkers. The word humor is a translation of Greek \u03c7\u03c5\u03bc\u03cc\u03c2, chymos (literally 'juice' or 'sap', metaphorically 'flavor'). Early texts on Indian Ayurveda medicine presented a theory of three or four humors (do\u1e63as), which they sometimes linked with the five elements (pa\u00f1ca-bh\u016bta): earth, water, fire, air, and space. The concept of \"humors\" (chemical systems regulating human behaviour) became more prominent from the writing of medical theorist Alcmaeon of Croton (c. 540\u2013500 BC)."}}, {"canonical_name": "Natural history", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 19, "members": [{"entity_id": "natural_history", "book_id": "origin_of_species_darwin_1859", "name": "Natural history", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 12, "variants": ["Natural history", "natural history"], "contexts": ["study of organisms and their environments", "study of the natural world"]}, {"entity_id": "natural_history", "book_id": "kosmos_humboldt_1845", "name": "Natural History", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["natural history", "Natural History"], "contexts": ["study of living organisms", "study of the natural world"]}, {"entity_id": "history_of_nature", "book_id": "kosmos_humboldt_1845", "name": "History of Nature", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["History of Nature"], "contexts": ["term for natural history"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Natural history", "target_book": "kosmos_humboldt_1845", "target_name": "Natural History", "similarity": 0.989}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Natural history", "target_book": "kosmos_humboldt_1845", "target_name": "History of Nature", "similarity": 0.895}], "id": 2427, "stable_key": "clu_0bb3ca8b9f12ccf1-2", "ground_truth": {"modern_name": "Natural history", "confidence": "high", "type": "concept", "wikidata_id": "Q484591", "wikidata_description": "study of organisms including plants or animals in their environment", "wikipedia_url": "https://en.wikipedia.org/wiki/Natural%20history", "wikipedia_extract": "Natural history is a domain of inquiry involving organisms, including animals, fungi, and plants, in their natural environment, leaning more towards observational than experimental methods of study. A person who studies natural history is called a naturalist or natural historian. Natural history encompasses scientific research but is not limited to it. It involves the systematic study of any category of natural objects or organisms, so while it dates from studies in the ancient Greco-Roman world and the mediaeval Arabic world, through to European Renaissance naturalists working in near isolation, today's natural history is a cross-discipline umbrella of many specialty sciences; e.g., geobiology has a strong multidisciplinary nature. The meaning of the English term \"natural history\" (a calque of the Latin historia naturalis) has narrowed progressively with time, while, by contrast, the meaning of the related term \"nature\" has widened (see also History below). In antiquity, \"natural history\" covered essentially anything connected with nature, or  used materials drawn from nature, such as Pliny the Elder's encyclopedia of this title, published c."}}, {"canonical_name": "naranjo", "category": "PLANT", "subcategory": "TREE", "book_count": 2, "total_mentions": 19, "members": [{"entity_id": "naranjo", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "naranjo", "category": "PLANT", "subcategory": "TREE", "count": 17, "variants": ["naranjo"], "contexts": ["tree with orange-like leaves", "orange tree"]}, {"entity_id": "naranjos", "book_id": "historia_medicinal_monardes_1574", "name": "Naranjos", "category": "PLANT", "subcategory": "TREE", "count": 2, "variants": ["Naranjos", "Naranjo"], "contexts": ["trees used for garden decoration", "source of orange blossom water"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "naranjo", "target_book": "historia_medicinal_monardes_1574", "target_name": "Naranjos", "similarity": 0.945}], "id": 2428, "stable_key": "clu_3fbab5198f2a07af", "ground_truth": {"modern_name": "orange tree", "confidence": "high", "type": "plant", "linnaean": "Citrus x sinensis (Linnaeus) Osbeck", "family": "Rutaceae", "note": "While 'naranjo' can refer to any citrus tree bearing oranges, the primary association is with sweet oranges.", "wikidata_id": "Q80582932", "wikidata_description": "pub in Newport, Wales"}}, {"canonical_name": "pimienta", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 19, "members": [{"entity_id": "pimienta", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "pimienta", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["pimienta"], "contexts": ["spice, pepper", "spice whose flower resembles plant's flower"]}, {"entity_id": "pimienta_luenga", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "pimienta luenga", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["pimienta luenga"], "contexts": ["long pepper-like fruit"]}, {"entity_id": "pimienta", "book_id": "historia_medicinal_monardes_1574", "name": "pimienta", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 14, "variants": ["pimienta", "PIMIENTA", "Pimienta", "Pimienta Oriental", "Pimienta comun", "Pimienta luenga", "Pimienta negra", "Pimientos"], "contexts": ["spice from the Moluccas Islands", "spice from the Indies"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "pimienta", "target_book": "historia_medicinal_monardes_1574", "target_name": "pimienta", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "pimienta luenga", "target_book": "historia_medicinal_monardes_1574", "target_name": "pimienta", "similarity": 0.89}], "id": 2429, "stable_key": "clu_220162fb7b9b2be1-2", "ground_truth": {"modern_name": "pepper", "confidence": "high", "type": "plant", "linnaean": "Piper nigrum Linnaeus", "family": "Piperaceae", "note": "Likely refers to black pepper (Piper nigrum), but could also encompass other pungent spices depending on context. 'Pimenta redonda' might refer to a specific variety or another round spice.", "wikidata_id": "Q43084", "wikidata_description": "species of plant"}}, {"canonical_name": "opila\u00e7\u00f5es", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 19, "members": [{"entity_id": "opilaciones_del_b\u00e1po", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "opilaciones del b\u00e1po", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["opilaciones del b\u00e1po"], "contexts": ["blockages treated by tlanoquiloni root"]}, {"entity_id": "opila\u00e7\u00f5es", "book_id": "polyanthea_medicinal", "name": "opila\u00e7\u00f5es", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 18, "variants": ["opila\u00e7\u00f5es", "opila\u00e7a\u00f3", "opila\u00e7oens", "opila\u00e7\u00e3o", "opila\u00e7\u00f5es remas beldes", "oppilados", "oppila\u00e7oens"], "contexts": ["obstructions, a medical condition", "obstructions, medical condition"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "opilaciones del b\u00e1po", "target_book": "polyanthea_medicinal", "target_name": "opila\u00e7\u00f5es", "similarity": 0.911}], "id": 2430, "stable_key": "clu_9f4dde38de90902c", "ground_truth": {"modern_name": "Obstruction", "confidence": "high", "type": "disease", "description": "Blockage or impediment in bodily passages or vessels.", "note": "Refers to the blockage of humors or vessels.", "wikipedia_extract": "Bowel obstruction, also known as intestinal obstruction, is a mechanical or functional obstruction of the intestines that prevents the normal movement of the products of digestion. Either the small bowel or large bowel may be affected. Signs and symptoms include abdominal pain, vomiting, bloating and not passing gas. Mechanical obstruction is the cause of about 5 to 15% of cases of severe abdominal pain of sudden onset requiring admission to hospital. Causes of bowel obstruction include adhesions, hernias, volvulus, endometriosis, inflammatory bowel disease, appendicitis, tumors, diverticulitis, ischemic bowel, tuberculosis and intussusception. Small bowel obstructions are most often due to adhesions and hernias, while large bowel obstructions are most often due to tumors and volvulus."}}, {"canonical_name": "Honda", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 19, "members": [{"entity_id": "honda", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Honda", "category": "PLACE", "subcategory": "CITY", "count": 18, "variants": ["Honda"], "contexts": ["city", "city on the Magdalena river"]}, {"entity_id": "honda", "book_id": "kosmos_humboldt_1845", "name": "Honda", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Honda"], "contexts": ["location where cannon-like noises were heard"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Honda", "target_book": "kosmos_humboldt_1845", "target_name": "Honda", "similarity": 1.0}], "id": 2431, "stable_key": "clu_68c20e1fe2152a74", "ground_truth": {"modern_name": "Honda", "confidence": "high", "type": "place", "country": "Colombia"}}, {"canonical_name": "Cotopaxi", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 19, "members": [{"entity_id": "cotopaxi", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cotopaxi", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 12, "variants": ["Cotopaxi", "Cotocache", "Cotombia"], "contexts": ["volcano in Ecuador", "volcano with similar shape to pic de Tolima"]}, {"entity_id": "cotopaxi", "book_id": "kosmos_humboldt_1845", "name": "Cotopaxi", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 7, "variants": ["Cotopaxi"], "contexts": ["volcano with a great eruption", "active volcano"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cotopaxi", "target_book": "kosmos_humboldt_1845", "target_name": "Cotopaxi", "similarity": 1.0}], "id": 2432, "stable_key": "clu_d8a57b77dff133d3", "ground_truth": {"modern_name": "Cotopaxi", "confidence": "high", "type": "place", "country": "Ecuador", "wikidata_id": "Q5175454", "wikidata_description": "census-designated place in Fremont County, Colorado, United States", "wikipedia_url": "https://en.wikipedia.org/wiki/Cotopaxi%2C%20Colorado", "wikipedia_extract": "Cotopaxi is an unincorporated town, a post office, and a census-designated place (CDP) located in and governed by Fremont County, Colorado, United States. The CDP is a part of the Ca\u00f1on City, CO Micropolitan Statistical Area. The Cotopaxi post office has the ZIP Code 81223. At the United States Census 2020, the population of the Cotopaxi CDP was 44. The Cotopaxi, Colorado, post office opened on May 25, 1880. The town was named after Cotopaxi Volcano, one of the highest active volcanoes in the world, located in Ecuador."}}, {"canonical_name": "Annales de Chimie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 19, "members": [{"entity_id": "annales_dephys__et_de_chimie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Annales dePhys. et de Chimie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Annales dePhys. et de Chimie", "Annales de Chimie et de Physicfue"], "contexts": ["publication where letter appeared", "publication title"]}, {"entity_id": "annales_de_chimie", "book_id": "kosmos_humboldt_1845", "name": "Annales de Chimie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 17, "variants": ["Annales de Chimie", "Annales de chimie"], "contexts": ["scientific publication", "scientific journal"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Annales dePhys. et de Chimie", "target_book": "kosmos_humboldt_1845", "target_name": "Annales de Chimie", "similarity": 0.937}], "id": 2433, "stable_key": "clu_e8afb73207080b76", "ground_truth": {"modern_name": "Annales de Chimie", "confidence": "high", "type": "text", "note": "The context suggests a scientific publication, specifically the 'Annales de Chimie', which often included physics as well.", "wikidata_id": "Q15708679", "wikidata_description": "journal"}}, {"canonical_name": "duration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 19, "members": [{"entity_id": "duration", "book_id": "principles_of_psychology_james_1890", "name": "duration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 16, "variants": ["duration"], "contexts": ["length of time something lasts", "measurement of time in mental processes"]}, {"entity_id": "durations", "book_id": "principles_of_psychology_james_1890", "name": "durations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["durations"], "contexts": ["lengths of time"]}, {"entity_id": "duration", "book_id": "connexion_physical_sciences_somerville_1858", "name": "duration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["duration"], "contexts": ["the extent of time", "length of time"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "duration", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "duration", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "durations", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "duration", "similarity": 0.928}], "id": 2434, "stable_key": "clu_9f59e2ba2222bd0a", "ground_truth": {"modern_name": "duration", "confidence": "high", "type": "concept", "wikidata_id": "Q2341537", "wikidata_description": "theory of time and consciousness posited by the French philosopher Henri Bergson"}}, {"canonical_name": "spiritualists", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 19, "members": [{"entity_id": "spiritualists", "book_id": "principles_of_psychology_james_1890", "name": "spiritualists", "category": "CONCEPT", "subcategory": "OTHER_CONC