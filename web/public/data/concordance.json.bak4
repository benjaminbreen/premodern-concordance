f insects"}}, {"canonical_name": "Konigsberg", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "k\u00f6nigsberg", "book_id": "principles_of_psychology_james_1890", "name": "K\u00f6nigsberg", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["K\u00f6nigsberg"], "contexts": ["academicism of Kant's existence"]}, {"entity_id": "konigsberg", "book_id": "kosmos_humboldt_1845", "name": "Konigsberg", "category": "PLACE", "subcategory": "CITY", "count": 6, "variants": ["Konigsberg"], "contexts": ["city where Kant published his essay", "city where essay was published"]}, {"entity_id": "k\u00f6nigsberg", "book_id": "connexion_physical_sciences_somerville_1858", "name": "K\u00f6nigsberg", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["K\u00f6nigsberg"], "contexts": ["location of Professor Moser's work"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "K\u00f6nigsberg", "target_book": "kosmos_humboldt_1845", "target_name": "Konigsberg", "similarity": 0.851}, {"source_book": "principles_of_psychology_james_1890", "source_name": "K\u00f6nigsberg", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "K\u00f6nigsberg", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Konigsberg", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "K\u00f6nigsberg", "similarity": 0.851}], "id": 1461, "stable_key": "clu_761c181338b174ac", "ground_truth": {"modern_name": "K\u00f6nigsberg", "confidence": "high", "type": "place", "description": "A major city known for its academic importance and barometric observations.", "wikipedia_extract": "K\u00f6nigsberg (, German: [\u02c8k\u00f8\u02d0n\u026a\u00e7sb\u025b\u0281k]  or [\u02c8k\u00f8\u02d0n\u026aksb\u025b\u0281k] ) was the historic German name of the city that is now modern-day Kaliningrad, Russia. The city was founded in 1255 on the site of the small Old Prussian settlement Twangste by the Teutonic Knights during the Baltic Crusades. It was named in honour of King Ottokar II of Bohemia, who led a campaign against the pagan Old Prussians, a Baltic tribe that was native to the area. A Baltic port city, it successively became the capital of the Kr\u00f3lewiec Voivodeship, State of the Teutonic Order, the Duchy of Prussia and the provinces of East Prussia and Prussia. K\u00f6nigsberg remained the coronation city of the Prussian monarchy from 1701 onwards, though the capital was Berlin. From the thirteenth century, it was inhabited by Germans and Old Prussians, then also by Poles, Lithuanians and French from the 14th, 15th and 17th centuries, respectively."}}, {"canonical_name": "mountains", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "mountains", "book_id": "kosmos_humboldt_1845", "name": "mountains", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["mountains", "Mountains"], "contexts": ["locations for density experiments", "geographic features with outlines"]}, {"entity_id": "mountain", "book_id": "connexion_physical_sciences_somerville_1858", "name": "mountain", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["mountain"], "contexts": ["higher elevation with less atmospheric weight"]}, {"entity_id": "mountains", "book_id": "first_principles_spencer_1862", "name": "mountains", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["mountains"], "contexts": ["elevated landforms", "large natural elevation of the earth's surface"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "mountains", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "mountain", "similarity": 0.937}, {"source_book": "kosmos_humboldt_1845", "source_name": "mountains", "target_book": "first_principles_spencer_1862", "target_name": "mountains", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "mountain", "target_book": "first_principles_spencer_1862", "target_name": "mountains", "similarity": 0.937}], "id": 1462, "stable_key": "clu_d2709a74aa27d0c3", "ground_truth": {"modern_name": "Montane", "confidence": "medium", "type": "concept", "note": "The primary usage 'Montan' refers to 'montane' or mountainous regions, not a specific place. The 'mountain' reference further supports this interpretation."}}, {"canonical_name": "precession of the equinoxes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "precession_of_the_equinoxes", "book_id": "kosmos_humboldt_1845", "name": "precession of the equinoxes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["precession of the equinoxes"], "contexts": ["astronomical phenomenon"]}, {"entity_id": "precession_of_the_equinoxes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "precession of the equinoxes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["precession of the equinoxes"], "contexts": ["gradual shift in Earth's axial orientation", "wobble of Earth's axis"]}, {"entity_id": "precession_of_the_equinoxes", "book_id": "first_principles_spencer_1862", "name": "precession of the equinoxes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["precession of the equinoxes"], "contexts": ["slow shift in Earth's axial orientation", "slow shift of Earth's axis"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "precession of the equinoxes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "precession of the equinoxes", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "precession of the equinoxes", "target_book": "first_principles_spencer_1862", "target_name": "precession of the equinoxes", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "precession of the equinoxes", "target_book": "first_principles_spencer_1862", "target_name": "precession of the equinoxes", "similarity": 1.0}], "id": 1463, "stable_key": "clu_c0adf5a2b8a79e9e", "ground_truth": {"modern_name": "Precession of the equinoxes", "confidence": "high", "type": "concept", "wikidata_id": "Q83094", "wikidata_description": "gravity-induced, slow, and continuous change in the orientation of an astronomical body's rotational axis", "wikipedia_url": "https://en.wikipedia.org/wiki/Axial%20precession", "wikipedia_extract": "In astronomy, axial precession is a gravity-induced, slow, and continuous change in the orientation of an astronomical body's rotational axis. In the absence of precession, the astronomical body's orbit would show axial parallelism. In particular, Earth's axial precession is the gradual shift in the orientation of Earth's axis of rotation. It has a cycle of approximately 26,000 years, tracing out a double cone with a half-aperture of about 23.4\u00b0, an angle known as the obliquity of the ecliptic. This is similar to the precession of a spinning top. The term \"precession\" typically refers only to this largest part of the motion; other changes in the alignment of Earth's axis\u2014nutation and polar motion\u2014are much smaller in magnitude."}}, {"canonical_name": "virtudes magneticas", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "magnetic_property", "book_id": "kosmos_humboldt_1845", "name": "magnetic property", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["magnetic property"], "contexts": ["property of magnetism"]}, {"entity_id": "magnetic_properties", "book_id": "kosmos_humboldt_1845", "name": "magnetic properties", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["magnetic properties"], "contexts": ["characteristics of magnetism"]}, {"entity_id": "virtudes_magneticas", "book_id": "polyanthea_medicinal", "name": "virtudes magneticas", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["virtudes magneticas"], "contexts": ["powers of magnets", "magnetic virtues"]}, {"entity_id": "magnetic_properties", "book_id": "connexion_physical_sciences_somerville_1858", "name": "magnetic properties", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["magnetic properties"], "contexts": ["of iron", "characteristics of the ethereal medium"]}, {"entity_id": "magnetic_property", "book_id": "connexion_physical_sciences_somerville_1858", "name": "magnetic property", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["magnetic property"], "contexts": ["characteristic of magnetism"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "magnetic property", "target_book": "polyanthea_medicinal", "target_name": "virtudes magneticas", "similarity": 0.884}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic property", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic properties", "similarity": 0.965}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic property", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic property", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic properties", "target_book": "polyanthea_medicinal", "target_name": "virtudes magneticas", "similarity": 0.895}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic properties", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic properties", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic properties", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic property", "similarity": 0.965}, {"source_book": "polyanthea_medicinal", "source_name": "virtudes magneticas", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic properties", "similarity": 0.895}, {"source_book": "polyanthea_medicinal", "source_name": "virtudes magneticas", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic property", "similarity": 0.884}], "id": 1464, "stable_key": "clu_c70fdfb7062a0803", "ground_truth": {"modern_name": "Magnetic properties", "confidence": "high", "type": "concept", "note": "The Portuguese \"virtudes magneticas\" translates directly to \"magnetic virtues\" or \"magnetic powers\", which is best represented by the modern concept of \"magnetic properties\".", "wikidata_id": "Q128713596", "wikidata_description": "scholarly article"}}, {"canonical_name": "Ritter", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "ritter's", "book_id": "kosmos_humboldt_1845", "name": "Ritter's", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Ritter's"], "contexts": ["author of geography work"]}, {"entity_id": "ritter", "book_id": "coloquios_da_orta_1563", "name": "Ritter", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Ritter"], "contexts": ["wise geographer who supposed name origin", "geographer"]}, {"entity_id": "ritter", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Ritter", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["Ritter"], "contexts": ["discoverer of photographic rays", "discoverer of chemical rays"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Ritter's", "target_book": "coloquios_da_orta_1563", "target_name": "Ritter", "similarity": 0.853}, {"source_book": "kosmos_humboldt_1845", "source_name": "Ritter's", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Ritter", "similarity": 0.853}, {"source_book": "coloquios_da_orta_1563", "source_name": "Ritter", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Ritter", "similarity": 1.0}], "id": 1465, "stable_key": "clu_9a10f7686f4cefa4", "ground_truth": {"modern_name": "Johann Wilhelm Ritter", "confidence": "high", "type": "person", "birth_year": 1776, "death_year": 1810, "description": "German physicist known for early work on ultraviolet light.", "note": "The context clues like \"discoverer of photographic rays\" strongly point to J.W. Ritter, a German chemist and physicist.", "wikidata_id": "Q58868", "wikidata_description": "German chemist, physicist and philosopher"}}, {"canonical_name": "limoens", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "limones", "book_id": "historia_medicinal_monardes_1574", "name": "Limones", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Limones"], "contexts": ["fragrance reminiscent of lemons"]}, {"entity_id": "lim\u00f5es", "book_id": "coloquios_da_orta_1563", "name": "lim\u00f5es", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["lim\u00f5es"], "contexts": ["fruit from the region", "commodity sold with betel"]}, {"entity_id": "limas", "book_id": "coloquios_da_orta_1563", "name": "limas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["limas"], "contexts": ["fruit from the region"]}, {"entity_id": "limoens", "book_id": "polyanthea_medicinal", "name": "limoens", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["limoens", "limas doces", "limoens doces"], "contexts": ["lemons, used in preparation", "sweet lemons"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Limones", "target_book": "coloquios_da_orta_1563", "target_name": "lim\u00f5es", "similarity": 0.936}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Limones", "target_book": "polyanthea_medicinal", "target_name": "limoens", "similarity": 0.91}, {"source_book": "coloquios_da_orta_1563", "source_name": "lim\u00f5es", "target_book": "polyanthea_medicinal", "target_name": "limoens", "similarity": 0.912}, {"source_book": "coloquios_da_orta_1563", "source_name": "limas", "target_book": "polyanthea_medicinal", "target_name": "limoens", "similarity": 0.884}], "id": 1466, "stable_key": "clu_af88437fc51c06cd-2", "ground_truth": {"modern_name": "Citrus limon", "confidence": "high", "type": "plant", "linnaean": "Citrus limon L.", "family": "Rutaceae", "note": "The terms 'limoens', 'lim\u00f5es', and 'limas' all refer to citrus fruits, primarily lemons and limes. 'Limas' can also specifically refer to limes, but in the context of early modern texts and often alongside 'lim\u00f5es', it is a reasonable inclusion under the broader umbrella of citrus commonly known as lemons and limes.", "wikidata_id": "Q500", "wikidata_description": "nothospecies of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Lemon", "wikipedia_extract": "The lemon (Citrus \u00d7 limon) is a species of small evergreen tree in the Citrus genus of the flowering plant family Rutaceae. A true lemon is a hybrid of the citron and the bitter orange. Its origins are uncertain, but some evidence suggests lemons originated during the 1st millennium BC in what is now northeastern India. Some other citrus fruits are called lemon. The yellow fruit of the lemon tree is used throughout the world, primarily for its juice. The pulp and rind are used in cooking and baking."}}, {"canonical_name": "music", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "muzica", "book_id": "polyanthea_medicinal", "name": "Muzica", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Muzica"], "contexts": ["art not necessary for healing"]}, {"entity_id": "music", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Music", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Music", "music"], "contexts": ["theory of musical sounds", "sympathetic notes, sound undulations"]}, {"entity_id": "music", "book_id": "first_principles_spencer_1862", "name": "music", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["music", "Music"], "contexts": ["art form originating from rhythm in sound", "art form"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Muzica", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Music", "similarity": 0.966}, {"source_book": "polyanthea_medicinal", "source_name": "Muzica", "target_book": "first_principles_spencer_1862", "target_name": "music", "similarity": 0.956}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Music", "target_book": "first_principles_spencer_1862", "target_name": "music", "similarity": 0.991}], "id": 1467, "stable_key": "clu_1edb748ac1859f3b", "ground_truth": {"modern_name": "Music", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Music", "wikipedia_extract": "Music is the arrangement of sound to create some combination of form, harmony, melody, rhythm, or otherwise expressive content. Music is generally agreed to be a cultural universal that is present in all human societies. Definitions of music vary widely in substance and approach. While scholars agree that music is defined by a small number of specific elements, there is no consensus as to what these necessary elements are. Music is often characterized as a highly versatile medium for expressing human creativity. Diverse activities are involved in the creation of music, and are often divided into categories of composition, improvisation, and performance."}}, {"canonical_name": "existence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "existence", "book_id": "origin_of_species_darwin_1859", "name": "Existence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Existence"], "contexts": ["state of being"]}, {"entity_id": "existence", "book_id": "first_principles_spencer_1862", "name": "existence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["Existence", "existence"], "contexts": ["state of being", "concept of being or reality"]}, {"entity_id": "existence", "book_id": "principles_of_psychology_james_1890", "name": "existence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["existence"], "contexts": ["state of being real"]}, {"entity_id": "real_existence", "book_id": "first_principles_spencer_1862", "name": "real existence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["real existence"], "contexts": ["actual state of being"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Existence", "target_book": "first_principles_spencer_1862", "target_name": "existence", "similarity": 0.974}, {"source_book": "principles_of_psychology_james_1890", "source_name": "existence", "target_book": "first_principles_spencer_1862", "target_name": "real existence", "similarity": 0.902}], "id": 1468, "stable_key": "clu_82da87fcf7ac989f-2", "ground_truth": {"modern_name": "space", "confidence": "high", "type": "concept", "wikidata_id": "Q1", "wikidata_description": "totality consisting of space, time, matter and energy", "wikipedia_url": "https://en.wikipedia.org/wiki/Universe", "wikipedia_extract": "The universe is all of space and time and their contents. It comprises all of existence, any fundamental interaction, physical process and physical constant, and therefore all forms of matter and energy, and the structures they form, from sub-atomic particles to entire galactic filaments. Since the early 20th century, the field of cosmology establishes that space and time emerged together at the Big Bang 13.787\u00b10.020 billion years ago and that the universe has been expanding since then. The portion of the universe that can be seen by humans is approximately 93 billion light-years in diameter at present, but the total size of the universe is not known. Some of the earliest cosmological models of the universe were geocentric, placing Earth at the center. During the European Scientific Revolution, astronomical observations led to a heliocentric model."}}, {"canonical_name": "vital forces", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "forces_vitales", "book_id": "medecine_experimentale_bernard_1865", "name": "forces vitales", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["forces vitales"], "contexts": ["vital forces given to nature's phenomena", "mysterious energies governing living beings"]}, {"entity_id": "vital_forces", "book_id": "kosmos_humboldt_1845", "name": "vital forces", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["vital forces"], "contexts": ["peculiar forces in every organism", "mythical ideas about organization"]}, {"entity_id": "vital_forces", "book_id": "medecine_experimentale_bernard_1865", "name": "vital forces", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["vital forces"], "contexts": ["hypothetical forces in living beings"]}, {"entity_id": "vital_forces", "book_id": "first_principles_spencer_1862", "name": "vital forces", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["vital forces"], "contexts": ["classed forces connected to physical forces", "forces derived from the sun"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "forces vitales", "target_book": "kosmos_humboldt_1845", "target_name": "vital forces", "similarity": 0.972}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "vital forces", "target_book": "first_principles_spencer_1862", "target_name": "vital forces", "similarity": 1.0}], "id": 1469, "stable_key": "clu_4a6b4cb816813879-2", "ground_truth": {"modern_name": "Vitalism", "confidence": "high", "type": "concept", "note": "The phrases 'vital activity', 'vital actions', and 'life force' are hallmarks of the philosophical concept of vitalism.", "wikidata_id": "Q137271198", "wikidata_description": "nonprofit organisation from the Netherlands"}}, {"canonical_name": "Azores", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "azores", "book_id": "origin_of_species_darwin_1859", "name": "Azores", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Azores"], "contexts": ["origin of European plants", "oceanic islands in Atlantic"]}, {"entity_id": "\u00eeles_azores", "book_id": "relation_historique_humboldt_vol3_1825", "name": "\u00eeles Azores", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["\u00eeles Azores"], "contexts": ["Islands used as a demarcation point"]}, {"entity_id": "azores", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Azores", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Azores"], "contexts": ["island group with compass variation", "islands influencing compass variation"]}, {"entity_id": "the_azores", "book_id": "origin_of_species_darwin_1859", "name": "the Azores", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["the Azores"], "contexts": ["island group for distance comparison"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Azores", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "\u00eeles Azores", "similarity": 0.968}, {"s