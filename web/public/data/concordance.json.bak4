h_physician_1652", "source_name": "September", "target_book": "polyanthea_medicinal", "target_name": "Setembro", "similarity": 0.975}, {"source_book": "english_physician_1652", "source_name": "September", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "September", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "setembro", "target_book": "polyanthea_medicinal", "target_name": "Setembro", "similarity": 0.985}, {"source_book": "coloquios_da_orta_1563", "source_name": "setembro", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "September", "similarity": 0.986}, {"source_book": "polyanthea_medicinal", "source_name": "Setembro", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "September", "similarity": 0.975}], "id": 186, "stable_key": "clu_e014bd11963a8998", "ground_truth": {"modern_name": "September", "confidence": "high", "type": "concept", "note": "Refers to the month of September, often associated with specific agricultural or medical practices in historical texts.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "cheiro", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 21, "members": [{"entity_id": "scent", "book_id": "english_physician_1652", "name": "scent", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["scent"], "contexts": ["quality of the flowers"]}, {"entity_id": "olor", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "olor", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["olor"], "contexts": ["sense of smell", "smell of Atzoyatl"]}, {"entity_id": "olor", "book_id": "historia_medicinal_monardes_1574", "name": "olor", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["olor"], "contexts": ["smell"]}, {"entity_id": "cheiro", "book_id": "coloquios_da_orta_1563", "name": "cheiro", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 12, "variants": ["cheiro", "cheiros"], "contexts": ["Smell or odor", "used to determine quality"]}, {"entity_id": "cheyro", "book_id": "polyanthea_medicinal", "name": "cheyro", "category": "CONCEPT", "subcategory": "QUALITY", "count": 5, "variants": ["cheyro"], "contexts": ["smell", "smell or scent"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "scent", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "olor", "similarity": 0.973}, {"source_book": "english_physician_1652", "source_name": "scent", "target_book": "coloquios_da_orta_1563", "target_name": "cheiro", "similarity": 0.983}, {"source_book": "english_physician_1652", "source_name": "scent", "target_book": "polyanthea_medicinal", "target_name": "cheyro", "similarity": 0.977}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "olor", "target_book": "historia_medicinal_monardes_1574", "target_name": "olor", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "olor", "target_book": "coloquios_da_orta_1563", "target_name": "cheiro", "similarity": 0.985}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "olor", "target_book": "coloquios_da_orta_1563", "target_name": "cheiro", "similarity": 0.985}, {"source_book": "coloquios_da_orta_1563", "source_name": "cheiro", "target_book": "polyanthea_medicinal", "target_name": "cheyro", "similarity": 0.985}], "id": 187, "stable_key": "clu_4d5ee380d75c573b", "ground_truth": {"modern_name": "Scent", "confidence": "high", "type": "concept", "description": "A distinctive smell, especially a pleasant one.", "note": "Refers to smell or odor, and adjectives describing it, used to assess quality or describe something.", "wikipedia_extract": "An odor (American English) or odour (Commonwealth English; see spelling differences) is a smell or a scent caused by one or more volatilized chemical compounds generally found in low concentrations that humans and many animals can perceive via their olfactory system. While smell can refer to pleasant and unpleasant odors, the terms scent, aroma, and fragrance are usually reserved for pleasant-smelling odors and are frequently used in the food and cosmetic industry to describe floral scents or to refer to perfumes. The perception of odors, or sense of smell, is mediated by the olfactory nerve. The olfactory receptor (OR) cells are neurons present in the olfactory epithelium, which is a small patch of tissue at the back of the nasal cavity. There are millions of olfactory receptor neurons that act as sensory signaling cells. Each neuron has cilia in direct contact with the air."}}, {"canonical_name": "reptiles", "category": "ANIMAL", "subcategory": "REPTILE", "book_count": 5, "total_mentions": 21, "members": [{"entity_id": "reptiles", "book_id": "origin_of_species_darwin_1859", "name": "reptiles", "category": "ANIMAL", "subcategory": "REPTILE", "count": 8, "variants": ["Reptiles", "reptiles"], "contexts": ["class of cold-blooded vertebrates", "animals that escape from a broken egg"]}, {"entity_id": "reptiles", "book_id": "principles_of_psychology_james_1890", "name": "reptiles", "category": "ANIMAL", "subcategory": "REPTILE", "count": 1, "variants": ["reptiles"], "contexts": ["cold-blooded vertebrates with scales"]}, {"entity_id": "reptiles", "book_id": "kosmos_humboldt_1845", "name": "reptiles", "category": "ANIMAL", "subcategory": "REPTILE", "count": 1, "variants": ["reptiles"], "contexts": ["animal class"]}, {"entity_id": "reptiles", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Reptiles", "category": "ANIMAL", "subcategory": "REPTILE", "count": 5, "variants": ["Reptiles"], "contexts": ["class of cold-blooded vertebrates", "animals distributed geographically"]}, {"entity_id": "reptiles", "book_id": "first_principles_spencer_1862", "name": "reptiles", "category": "ANIMAL", "subcategory": "REPTILE", "count": 6, "variants": ["Reptiles", "reptiles"], "contexts": ["larger division of animals", "cold-blooded vertebrates"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "reptiles", "target_book": "principles_of_psychology_james_1890", "target_name": "reptiles", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "reptiles", "target_book": "kosmos_humboldt_1845", "target_name": "reptiles", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "reptiles", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Reptiles", "similarity": 0.978}, {"source_book": "origin_of_species_darwin_1859", "source_name": "reptiles", "target_book": "first_principles_spencer_1862", "target_name": "reptiles", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "reptiles", "target_book": "kosmos_humboldt_1845", "target_name": "reptiles", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "reptiles", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Reptiles", "similarity": 0.978}, {"source_book": "principles_of_psychology_james_1890", "source_name": "reptiles", "target_book": "first_principles_spencer_1862", "target_name": "reptiles", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "reptiles", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Reptiles", "similarity": 0.978}, {"source_book": "kosmos_humboldt_1845", "source_name": "reptiles", "target_book": "first_principles_spencer_1862", "target_name": "reptiles", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Reptiles", "target_book": "first_principles_spencer_1862", "target_name": "reptiles", "similarity": 0.978}], "id": 188, "stable_key": "clu_18e4f6e4ef9e0efb", "ground_truth": {"modern_name": "Reptiles", "confidence": "high", "type": "animal", "wikidata_id": "Q10811", "wikidata_description": "class of vertebrate animals (Vertebrata)", "wikipedia_url": "https://en.wikipedia.org/wiki/Reptile", "note": "The Latin 'reptilibus' directly translates to 'reptiles'. The other member 'reptile' further confirms this. 'Invertebrate ones' seems like a misinterpretation or OCR error in its context if it's meant to be linked to 'reptiles'.", "wikipedia_extract": "Reptiles, as commonly defined, are tetrapod vertebrate animals with an ectothermic metabolism and amniotic development. Reptiles traditionally comprise four orders: Testudines (turtles), Crocodilia (crocodiles, alligators and gharials), Squamata (lizards and snakes) and Rhynchocephalia (tuatara), with about 12,000 extant species listed in the Reptile Database. The study of the traditional reptile orders, customarily in combination with the study of modern amphibians, is called herpetology. Reptiles have been subject to several conflicting taxonomic definitions. In classical evolutionary taxonomy, reptiles are gathered together under the class Reptilia ( rep-TIL-ee-\u0259), which corresponds to common usage. Modern cladistic taxonomy regards that group as paraphyletic, since genetic and paleontological evidence has determined that birds (class Aves) are the only surviving group of Dinosauria, a major clade of diapsids that are more closely related to crocodilians than to other living reptiles, and thus birds are nested among reptiles (under the clade Archosauria) from a phylogenetic perspective."}}, {"canonical_name": "resistance", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 21, "members": [{"entity_id": "r\u00e9sistance", "book_id": "relation_historique_humboldt_vol3_1825", "name": "r\u00e9sistance", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["r\u00e9sistance"], "contexts": ["act of opposing"]}, {"entity_id": "resistance", "book_id": "principles_of_psychology_james_1890", "name": "resistance", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["resistance"], "contexts": ["opposition to a force or process", "opposition to motion or force"]}, {"entity_id": "resistance", "book_id": "kosmos_humboldt_1845", "name": "resistance", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["resistance"], "contexts": ["force opposing motion"]}, {"entity_id": "resistance", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Resistance", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["Resistance", "resistance"], "contexts": ["opposition to motion", "opposition to electric current flow"]}, {"entity_id": "resistance", "book_id": "first_principles_spencer_1862", "name": "resistance", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 11, "variants": ["resistance"], "contexts": ["opposition to motion or force", "physical opposition"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "r\u00e9sistance", "target_book": "principles_of_psychology_james_1890", "target_name": "resistance", "similarity": 0.96}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "r\u00e9sistance", "target_book": "kosmos_humboldt_1845", "target_name": "resistance", "similarity": 0.96}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "r\u00e9sistance", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Resistance", "similarity": 0.864}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "r\u00e9sistance", "target_book": "first_principles_spencer_1862", "target_name": "resistance", "similarity": 0.96}, {"source_book": "principles_of_psychology_james_1890", "source_name": "resistance", "target_book": "kosmos_humboldt_1845", "target_name": "resistance", "similarity": 1.0}, {"source_book": "principles_of_p