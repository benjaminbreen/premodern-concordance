l", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["intellectual"], "contexts": ["relating to the intellect", "relating to the intellect or mind"]}, {"entity_id": "intellectuality", "book_id": "principles_of_psychology_james_1890", "name": "intellectuality", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["intellectuality"], "contexts": ["higher development of higher nervous centres"]}, {"entity_id": "intellectual", "book_id": "first_principles_spencer_1862", "name": "intellectual", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["intellectual"], "contexts": ["relating to the intellect"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "intellectual", "target_book": "first_principles_spencer_1862", "target_name": "intellectual", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "intellectuality", "target_book": "first_principles_spencer_1862", "target_name": "intellectual", "similarity": 0.909}], "id": 3454, "stable_key": "clu_c46c456d0dfae381", "ground_truth": {"modern_name": "Intellectual", "confidence": "high", "type": "concept", "note": "Refers to faculties of the mind and the capacity for reasoning and thought, consistent with its modern usage.", "wikidata_id": "Q58968", "wikidata_description": "person who engages in critical thinking and reasoning"}}, {"canonical_name": "nerve-tissue", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "nerve-tissue", "book_id": "principles_of_psychology_james_1890", "name": "nerve-tissue", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["nerve-tissue"], "contexts": ["tissue forming nerve cells and fibers", "tissue with tension property"]}, {"entity_id": "nervous_tissue", "book_id": "principles_of_psychology_james_1890", "name": "nervous tissue", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["nervous tissue"], "contexts": ["organic matter with high plasticity", "tissue of the nervous system"]}, {"entity_id": "nervous_tissues", "book_id": "first_principles_spencer_1862", "name": "nervous tissues", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["nervous tissues"], "contexts": ["tissue involved in molecular movements"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "nerve-tissue", "target_book": "first_principles_spencer_1862", "target_name": "nervous tissues", "similarity": 0.936}, {"source_book": "principles_of_psychology_james_1890", "source_name": "nervous tissue", "target_book": "first_principles_spencer_1862", "target_name": "nervous tissues", "similarity": 0.987}], "id": 3455, "stable_key": "clu_1ad194c9fb3e6502", "ground_truth": {"modern_name": "Nervous tissue", "confidence": "high", "type": "tissue", "note": "This refers to the biological tissue that makes up the nervous system, including neurons and glial cells.", "wikidata_id": "Q56058241", "wikidata_description": "The immediate defensive reaction by neural vertebrate tissue to infection or injury caused by chemical or physical agents"}}, {"canonical_name": "conscious perception", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "conscious_perception", "book_id": "principles_of_psychology_james_1890", "name": "conscious perception", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["conscious perception"], "contexts": ["awareness of sensory input", "awareness of sensory input as a whole"]}, {"entity_id": "conscious_experiences", "book_id": "principles_of_psychology_james_1890", "name": "conscious experiences", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["conscious experiences"], "contexts": ["awareness of mental states and sensations"]}, {"entity_id": "conscious_experience", "book_id": "first_principles_spencer_1862", "name": "conscious experience", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["conscious experience"], "contexts": ["subjective awareness of events", "awareness of internal and external stimuli"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "conscious perception", "target_book": "first_principles_spencer_1862", "target_name": "conscious experience", "similarity": 0.896}, {"source_book": "principles_of_psychology_james_1890", "source_name": "conscious experiences", "target_book": "first_principles_spencer_1862", "target_name": "conscious experience", "similarity": 0.977}], "id": 3456, "stable_key": "clu_fad1e6499454b3ca-4", "ground_truth": {"modern_name": "consciousness", "confidence": "high", "type": "concept", "note": "The overwhelming number of occurrences of 'consciousness' and related terms in William James's work firmly identifies this cluster.", "wikidata_id": "Q4313500", "wikidata_description": "medical condition that inhibits consciousness, sprituality", "wikipedia_url": "https://en.wikipedia.org/wiki/Disorder%20of%20consciousness", "wikipedia_extract": "Consciousness is being aware of something internal to one's self or being conscious of states or objects in one's external environment. It has been the topic of extensive explanations, analyses, and debate among philosophers, scientists, and theologians for millennia. There is no consensus on what exactly needs to be studied, or even if consciousness can be considered a scientific concept. In some explanations, it is synonymous with mind, while in others it is considered an aspect of it. In the past, consciousness meant one's \"inner life\": the world of introspection, private thought, imagination, and volition. Today, it often includes any kind of cognition, experience, feeling, or perception."}}, {"canonical_name": "Comte", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "comte", "book_id": "principles_of_psychology_james_1890", "name": "Comte", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Comte"], "contexts": ["criticized psychological method", "philosopher and sociologist"]}, {"entity_id": "m__comte", "book_id": "principles_of_psychology_james_1890", "name": "M. Comte", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["M. Comte"], "contexts": ["philosopher and sociologist"]}, {"entity_id": "m__comte", "book_id": "first_principles_spencer_1862", "name": "M. Comte", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["M. Comte"], "contexts": ["asserted a principle of progress", "calculated rotation time of Sun"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Comte", "target_book": "first_principles_spencer_1862", "target_name": "M. Comte", "similarity": 0.919}, {"source_book": "principles_of_psychology_james_1890", "source_name": "M. Comte", "target_book": "first_principles_spencer_1862", "target_name": "M. Comte", "similarity": 1.0}], "id": 3457, "stable_key": "clu_67e8b564c48329f7", "ground_truth": {"modern_name": "Auguste Comte", "confidence": "high", "type": "person", "birth_year": 1798, "death_year": 1857, "description": "French philosopher, sociologist, founder of positivism.", "wikidata_id": "Q12718", "wikidata_description": "French philosopher, mathematician and sociologist (1798\u20131857)"}}, {"canonical_name": "Dante", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "dante", "book_id": "principles_of_psychology_james_1890", "name": "Dante", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Dante"], "contexts": ["medieval poet, cited for sorrow of past happiness", "poet mentioned in an example"]}, {"entity_id": "dante", "book_id": "kosmos_humboldt_1845", "name": "Dante", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Dante"], "contexts": ["author of Divina Commedia", "quoted in the text"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Dante", "target_book": "kosmos_humboldt_1845", "target_name": "Dante", "similarity": 0.889}], "id": 3458, "stable_key": "clu_5e9b8e0a9074f068", "ground_truth": {"modern_name": "Dante Alighieri", "confidence": "high", "type": "person", "birth_year": 1265, "death_year": 1321, "description": "Italian poet, author of the Divine Comedy.", "wikidata_id": "Q1067", "wikidata_description": "Florentine poet, writer, and philosopher (c. 1265\u20131321)"}}, {"canonical_name": "motor nerve", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "motor_nerve", "book_id": "principles_of_psychology_james_1890", "name": "motor nerve", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["motor nerve"], "contexts": ["nerve transmitting motor commands"]}, {"entity_id": "motor_nerves", "book_id": "principles_of_psychology_james_1890", "name": "motor nerves", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["motor nerves"], "contexts": ["nerves transmitting motor commands", "nerves that transmit impulses to muscles"]}, {"entity_id": "motor-nerves", "book_id": "first_principles_spencer_1862", "name": "motor-nerves", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["motor-nerves"], "contexts": ["nerves transmitting motor commands"]}, {"entity_id": "motor_nerves", "book_id": "first_principles_spencer_1862", "name": "motor nerves", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["motor nerves"], "contexts": ["nerves transmitting impulses to muscles"]}], "edges": [{"source_book": "principles_of_psycholo