t": 2, "total_mentions": 7, "members": [{"entity_id": "magn\u00e9tiques", "book_id": "epoques_nature_buffon_1778", "name": "magn\u00e9tiques", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["magn\u00e9tiques"], "contexts": ["abstract ideas, theories, mental faculties, and processes"]}, {"entity_id": "magn\u00e9tisme", "book_id": "epoques_nature_buffon_1778", "name": "magn\u00e9tisme", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["magn\u00e9tisme"], "contexts": ["abstract ideas, theories, mental faculties, and processes"]}, {"entity_id": "magn\u00e9tique", "book_id": "relation_historique_humboldt_vol3_1825", "name": "magn\u00e9tique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["magn\u00e9tique"], "contexts": ["property of iron", "related to magnetism"]}, {"entity_id": "magn\u00e9tiques", "book_id": "relation_historique_humboldt_vol3_1825", "name": "magn\u00e9tiques", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["magn\u00e9tiques"], "contexts": ["variations of magnetic forces", "magnetic"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "magn\u00e9tiques", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "magn\u00e9tique", "similarity": 0.847}, {"source_book": "epoques_nature_buffon_1778", "source_name": "magn\u00e9tiques", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "magn\u00e9tiques", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "magn\u00e9tisme", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "magn\u00e9tique", "similarity": 0.899}], "id": 3170, "stable_key": "clu_9a1a9fb7680fc471", "ground_truth": {"modern_name": "Magnetism", "confidence": "high", "type": "concept", "note": "The term 'magn\u00e9tique' is used here in a broader sense, encompassing abstract or intellectual qualities, as well as physical magnetism, depending on the context within these early modern texts.", "wikidata_id": "Q3294789", "wikidata_description": "class of physical phenomena", "wikipedia_url": "https://en.wikipedia.org/wiki/Magnetism"}}, {"canonical_name": "electricities", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "\u00e9lectricit\u00e9s", "book_id": "epoques_nature_buffon_1778", "name": "\u00e9lectricit\u00e9s", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["\u00e9lectricit\u00e9s"], "contexts": ["electrical forces"]}, {"entity_id": "electricities", "book_id": "connexion_physical_sciences_somerville_1858", "name": "electricities", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 6, "variants": ["electricities"], "contexts": ["opposite electrical charges", "fundamental electrical charges"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "\u00e9lectricit\u00e9s", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "electricities", "similarity": 0.95}], "id": 3171, "stable_key": "clu_d45a70567e33ad73-2", "ground_truth": {"modern_name": "electricity", "confidence": "high", "type": "concept", "note": "Refers to the scientific understanding of electrical phenomena and the hypothetical 'electric fluid'.", "wikidata_id": "Q383973", "wikidata_description": "process of generating electrical power", "wikipedia_url": "https://en.wikipedia.org/wiki/Electricity%20generation", "wikipedia_extract": "Electricity generation is the process of generating electric power from sources of primary energy. For utilities in the electric power industry, it is the stage prior to its delivery (transmission, distribution, etc.) to end users or its storage, using for example, the pumped-storage method. Consumable electricity is not freely available in nature, so it must be \"produced\", transforming other forms of energy to electricity. Production is carried out in power stations, also called \"power plants\". Electricity is most often generated at a power plant by electromechanical generators, primarily driven by heat engines fueled by combustion or nuclear fission, but also by other means such as the kinetic energy of flowing water and wind. Other energy sources include solar photovoltaics and geothermal power."}}, {"canonical_name": "roches", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "roches", "book_id": "epoques_nature_buffon_1778", "name": "roches", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["roches"], "contexts": ["solid mineral material forming the earth's crust"]}, {"entity_id": "roches", "book_id": "relation_historique_humboldt_vol3_1825", "name": "roches", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 6, "variants": ["ROCHES", "roches"], "contexts": ["nature of rocks", "geological formations discussed"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "roches", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "roches", "similarity": 1.0}], "id": 3172, "stable_key": "clu_3fc12d6d85cbaddf", "ground_truth": {"modern_name": "Rock", "confidence": "high", "type": "mineral", "wikidata_id": "Q8063", "wikidata_description": "naturally occurring solid aggregate of one or more minerals or mineraloids", "wikipedia_url": "https://en.wikipedia.org/wiki/Rock%20%28geology%29"}}, {"canonical_name": "Docks", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "docks", "book_id": "english_physician_1652", "name": "Docks", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["Docks", "Dock"], "contexts": ["herbs that make meat boil sooner", "herb"]}, {"entity_id": "dock-plant", "book_id": "origin_of_species_darwin_1859", "name": "dock-plant", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["dock-plant"], "contexts": ["plant where aphides are found"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Docks", "target_book": "origin_of_species_darwin_1859", "target_name": "dock-plant", "similarity": 0.892}], "id": 3173, "stable_key": "clu_7ba29931c2fa57ca", "ground_truth": {"modern_name": "Dock", "confidence": "high", "type": "plant", "linnaean": "Rumex L.", "family": "Polygonaceae", "note": "The term 'dock' refers to plants of the genus Rumex. The contexts ('herbs that make meat boil sooner', 'plant where aphides are found') are consistent with common uses and observations of dock plants.", "wikidata_id": "Q157643", "wikidata_description": "species of perennial flowering plant in the family Polygonaceae"}}, {"canonical_name": "Broken Bones", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "broken_bones", "book_id": "english_physician_1652", "name": "Broken Bones", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 6, "variants": ["Broken Bones", "Bones broken", "Broken bones", "broken Bones", "broken bone", "broken-winded"], "contexts": ["condition treated by the plant's poultice", "drawn forth by root"]}, {"entity_id": "huesos_quebrados", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "huesos quebrados", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["huesos quebrados"], "contexts": ["broken bones, healed by the herb"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Broken Bones", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "huesos quebrados", "similarity": 0.936}], "id": 3174, "stable_key": "clu_b99015d2f583c0f0", "ground_truth": {"modern_name": "Fractures", "confidence": "high", "type": "disease", "modern_term": "Fractures", "wikidata_id": "Q54973148", "wikidata_description": "fractures of the short, constricted portion of the thigh bone between the femur head and the trochanters"}}, {"canonical_name": "pains in the sides", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "pains_in_the_sides", "book_id": "english_physician_1652", "name": "pains in the sides", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 6, "variants": ["pains in the sides", "pain in the Sides", "paines in the sides", "pains of the sides"], "contexts": ["discomfort in the flank area", "pain in the flank area"]}, {"entity_id": "dolor_de_los_lados", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "dolor de los lados", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["dolor de los lados"], "contexts": ["pain in the sides"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "pains in the sides", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "dolor de los lados", "similarity": 0.929}], "id": 3175, "stable_key": "clu_ef9ba19d6fa82603", "ground_truth": {"modern_name": "Flank Pain", "confidence": "high", "type": "disease", "modern_term": "Flank pain", "wikidata_id": "Q22269224", "wikidata_description": "medical symptom"}}, {"canonical_name": "palsy", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "palsie", "book_id": "english_physician_1652", "name": "Palsie", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["Palsie"], "contexts": ["paralysis", "loss of sensation or muscle control"]}, {"entity_id": "palsy", "book_id": "principles_of_psychology_james_1890", "name": "palsy", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 4, "variants": ["palsy"], "contexts": ["loss of muscle function", "paralysis or weakness"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Palsie", "target_book": "principles_of_psychology_james_1890", "target_name": "palsy", "similarity": 0.927}], "id": 3176, "stable_key": "clu_6ddf0b9468255db3-4", "ground_truth": {"modern_name": "paralysis", "confidence": "high", "type": "disease", "description": "Loss of muscle function in one or more parts of the body.", "wikipedia_extract": "Paralysis (pl.: paralyses; also known as plegia) is a loss of motor function in one or more muscles. Paralysis can also be accompanied by a loss of feeling (sensory loss) in the affected area if there is sensory damage. In the United States, roughly 1 in 50 people have been diagnosed with some form of permanent or transient paralysis. The word \"paralysis\" derives from the Greek \u03c0\u03b1\u03c1\u03ac\u03bb\u03c5\u03c3\u03b9\u03c2, meaning \"disabling of the nerves\" from \u03c0\u03b1\u03c1\u03ac (para) meaning \"beside, by\" and \u03bb\u03cd\u03c3\u03b9\u03c2 (lysis) meaning \"making loose\". A paralysis accompanied by involuntary tremors is usually called \"palsy\". Paralysis is most often caused by damage in the nervous system, especially the spinal cord.", "note": "Covers general paralysis and related conditions like paralytic dementia.", "modern_term": "Paralysis", "wikidata_id": "Q1788314", "wikidata_description": "human disease"}}, {"canonical_name": "Saxony", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "saxony", "book_id": "english_physician_1652", "name": "Saxony", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Saxony"], "contexts": ["neighbor to Brandenburg in place", "region where Garden Rue is used against Jaundice"]}, {"entity_id": "saxony", "book_id": "kosmos_humboldt_1845", "name": "Saxony", "category": "PLACE", "subcategory": "REGION", "count": 5, "variants": ["Saxony"], "contexts": ["mining districts with temperature data", "mining district in Germany"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Saxony", "target_book": "kosmos_humboldt_1845", "target_name": "Saxony", "similarity": 1.0}], "id": 3177, "stable_key": "clu_c5572a2712115446", "ground_truth": {"modern_name": "Saxony", "confidence": "high", "type": "place", "description": "A historical region in Germany, known for its geography and flora.", "note": "Refers to the geographical region, not a person.", "wikipedia_extract": "Saxony, officially the Free State of Saxony, is a landlocked state of Germany, bordering the states of Brandenburg, Saxony-Anhalt, Thuringia, and Bavaria, as well as the countries of Poland and the Czech Republic. Its capital is Dresden, and its largest city is Leipzig. Saxony is the tenth largest of Germany's sixteen states, with an area of 18,413 square kilometres (7,109 sq mi), and the seventh most populous, with more than 4 million inhabitants. The term Saxony has been in use for more than a millennium. It was used for the medieval Duchy of Saxony, the Electorate of Saxony of the Holy Roman Empire, the Kingdom of Saxony, and twice for a republic. The first Free State of Saxony was established in 1918 as a constituent state of the Weimar Republic."}}, {"canonical_name": "cowslip", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "cowslips", "book_id": "english_physician_1652", "name": "Cowslips", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Cowslips"], "contexts": ["flowering plant", "plant for conserves"]}, {"entity_id": "cowslip", "book_id": "origin_of_species_darwin_1859", "name": "cowslip", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["cowslip"], "contexts": ["plant differing from primrose", "plant used in cross-fertilization experiments"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Cowslips", "target_book": "origin_of_species_darwin_1859", "target_name": "cowslip", "similarity": 0.882}], "id": 3178, "stable_key": "clu_ebe4af27be82e95f", "ground_truth": {"modern_name": "Cowslip", "confidence": "high", "type": "plant", "linnaean": "Primula veris", "family": "Primulaceae", "description": "A common yellow-flowered woodland plant, often used medicinally.", "wikipedia_extract": "Primula veris, the cowslip, common cowslip, or cowslip primrose (syn. Primula officinalis Hill), is a herbaceous perennial  flowering plant in the primrose family Primulaceae. The species is native throughout most of temperate Europe and western Asia, and although absent from more northerly areas including much of northwest Scotland, it reappears in northernmost Sutherland and Orkney and in Scandinavia. This species frequently hybridizes with other Primulas such as the common primrose Primula vulgaris to form false oxlip (Primula \u00d7 polyantha) which is often confused with true oxlip (Primula elatior), a much rarer plant. The common name cowslip may derive from the old English for cow dung, probably because the plant was often found growing amongst the manure in cow pastures. An alternative derivation simply refers to slippery or boggy ground; again, a typical habitat for this plant."}}, {"canonical_name": "Sapa", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "sapa", "book_id": "english_physician_1652", "name": "Sapa", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["Sapa"], "contexts": ["boiled fruit juice for mouth diseases", "preparation for mouth diseases"]}, {"entity_id": "sapa", "book_id": "ricettario_fiorentino_1597", "name": "Sapa", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["Sapa", "sapa"], "contexts": ["reduced grape must, a sweetener", "syrup of grape must, used in preparation"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Sapa", "target_book": "ricettario_fiorentino_1597", "target_name": "Sapa", "similarity": 0.796}], "id": 3179, "stable_key": "clu_55c6d464f37e6db6", "ground_truth": {"modern_name": "Grape must reduction", "confidence": "high", "type": "concept", "description": "Concentrated and reduced grape juice, used as a sweetener and in preparations.", "note": "The term 'sap' in Darwin refers to plant fluid, distinct from the grape must reduction. 'Sapos' in Monardes refers to toads, a different category. 'Sab\u00e3o' (soap) and 'saponis' (of soap) are related to saponification but contextually distinct.", "wikipedia_extract": "Balsamic vinegar (Italian: aceto balsamico) is a dark, concentrated, pungent, intensely flavoured vinegar made wholly or partially from grape must, which is freshly crushed grape juice with all the skins, seeds, and stems. The Italian word balsamico (from Latin balsamum, from Greek \u03b2\u03ac\u03bb\u03c3\u03b1\u03bc\u03bf\u03bd, b\u00e1lsamon) means 'balsam-like' in the sense of \"restorative\" or \"curative\"; cf. English 'balm'. Ultimately from Ancient Hebrew-Phoenician \u05d1\u05e9\u05c2\u05dd (b\u0101\u015b\u0101m or besem, IPA [ba\u02d0\u02c8\u026ca\u02d0m]), the name means 'perfume or spice', with the consonant sequence of the letter '\u03bb' and '\u03c3' deriving from Ancient Greek to pronounce the \u05e9\u05c2 (\u015b) sound, sounding back then as [\u026c]. The term balsamico in \"balsamic vinegar\" originates from the Latin word balsamum and the Greek word \u03b2\u03ac\u03bb\u03c3\u03b1\u03bc\u03bf\u03bd, both conveying the idea of something \"restorative\" or \"curative\". The practice of cooking grapes can be traced back to ancient Roman times, where it was valued both as a medicinal remedy and a sweetener or condiment in cooking."}}, {"canonical_name": "Latini", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "latins", "book_id": "english_physician_1652", "name": "Latins", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Latins"], "contexts": ["called Linctus", "called pultisses Cataplasmata"]}, {"entity_id": "latini", "book_id": "ricettario_fiorentino_1597", "name": "Latini", "category": "PERSON", "subcategory": "AUTHORITY", "count": 5, "variants": ["Latini", "latini"], "contexts": ["ancient Latin term for amphibians", "called amber succinum"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Latins", "target_book": "ricettario_fiorentino_1597", "target_name": "Latini", "similarity": 0.948}], "id": 3180, "stable_key": "clu_f07392e2f8652ce9", "ground_truth": {"modern_name": "Latins", "confidence": "high", "type": "person", "description": "People associated with Latin language, culture, or ancient Rome.", "note": "Can refer to people, authors, or languages.", "wikipedia_extract": "The term Latin has been used to describe several groups of people throughout history, first referring to the inhabitants of the ancient Latium region, then to Catholic Christians of the Latin rite, and most recently to Romance-speaking peoples. The Latins were an ancient Italic people of the Latium region in central Italy (Latium Vetus, \"Old Latium\"), in the 1st millennium BC. Although they lived in independent city-states, they spoke Latin as a common language, held common religious beliefs, and extended common rights of residence and trade to one another. Collectively, these Latin states were known as the Latin League. A rupture between Rome, one of the Latin states, and the rest of the Latin League emerged as a result of the former's territorial ambitions. The Latin League fought against Rome in the Latin War (340\u2013338 BC), which ended in a Roman victory."}}, {"canonical_name": "femen", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "female", "book_id": "english_physician_1652", "name": "Female", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Female"], "contexts": ["one of two kinds of fern"]}, {"entity_id": "femen", "book_id": "polyanthea_medicinal", "name": "femen", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["femen"], "contexts": ["female bodily fluid", "de"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Female", "target_book": "polyanthea_medicinal", "target_name": "femen", "similarity": 0.957}], "id": 3181, "stable_key": "clu_7810e16335dafa8f-2", "ground_truth": {"modern_name": "Fern", "confidence": "medium", "type": "plant", "note": "The term 'fetos' is ambiguous and could refer to various plants, but 'fern' is a plausible interpretation in a medicinal context, especially when referring to fronds or herbs used in pills. However, without more context, a definitive Linnaean classification is not possible.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_extract": "Neonatal alloimmune thrombocytopenia (NAITP, NAIT, NATP or NAT) is a disease that affects babies in which the platelet count is decreased because the mother's immune system attacks her fetus' or newborn's platelets. A low platelet count increases the risk of bleeding in the fetus and newborn. If the bleeding occurs in the brain, there may be long-term effects. Platelet antigens are inherited from both mother and father. NAIT is caused by antibodies specific for platelet antigens inherited from the father but which are absent in the mother. Fetomaternal transfusions (or fetomaternal hemorrhage) results in the recognition of these antigens by the mother's immune system as non-self, with the subsequent generation of allo-reactive antibodies which cross the placenta.", "wikipedia_url": "https://en.wikipedia.org/wiki/Neonatal_alloimmune_thrombocytopenia"}}, {"canonical_name": "Alpin", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "alpinus", "book_id": "english_physician_1652", "name": "Alpinus", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Alpinus"], "contexts": ["affirms use of wood for French Disease"]}, {"entity_id": "alpin", "book_id": "polyanthea_medicinal", "name": "Alpin", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["Alpin", "Alpino"], "contexts": ["author who wrote about a patient", "cited authority on medical cases"]}, {"entity_id": "alpinus", "book_id": "polyanthea_medicinal", "name": "Alpinus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Alpinus"], "contexts": ["cited for medical treatments"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Alpinus", "target_book": "polyanthea_medicinal", "target_name": "Alpin", "similarity": 0.919}, {"source_book": "english_physician_1652", "source_name": "Alpinus", "target_book": "polyanthea_medicinal", "target_name": "Alpinus", "similarity": 0.637}], "id": 3182, "stable_key": "clu_140e35e98742977a", "ground_truth": {"modern_name": "Prospero Alpini", "confidence": "high", "type": "person", "birth_year": 1553, "death_year": 1617, "description": "Italian physician and botanist, author of 'De Plantis Exoticis'.", "wikidata_id": "Q538065", "wikidata_description": "Venetian physician and botanist (1553-1616)"}}, {"canonical_name": "Individuals", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "individuals", "book_id": "origin_of_species_darwin_1859", "name": "Individuals", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["Individuals", "individuals"], "contexts": ["single organisms of a species", "single organisms within a species"]}, {"entity_id": "individual", "book_id": "principles_of_psychology_james_1890", "name": "individual", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["individual"], "contexts": ["a single person"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Individuals", "target_book": "principles_of_psychology_james_1890", "target_name": "individual", "similarity": 0.845}], "id": 3183, "stable_key": "clu_bdb05bb90eaf07a8", "ground_truth": {"modern_name": "Individual organism", "confidence": "high", "type": "concept", "wikidata_id": "Q795052", "wikidata_description": "individual person or organism"}}, {"canonical_name": "Rodents", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "rodents", "book_id": "origin_of_species_darwin_1859", "name": "Rodents", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 6, "variants": ["rodents", "Rodents"], "contexts": ["gnawing mammals", "competing mammals that can immigrate"]}, {"entity_id": "rodents", "book_id": "principles_of_psychology_james_1890", "name": "rodents", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["rodents"], "contexts": ["animals with less brain localization"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Rodents", "target_book": "principles_of_psychology_james_1890", "target_name": "rodents", "similarity": 0.978}], "id": 3184, "stable_key": "clu_f3c84593d1e5eb99", "ground_truth": {"modern_name": "Rodents", "confidence": "high", "type": "animal", "wikidata_id": "Q10850", "wikidata_description": "order of mammals"}}, {"canonical_name": "Nectar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "nectar", "book_id": "origin_of_species_darwin_1859", "name": "Nectar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["nectar", "Nectar"], "contexts": ["sweet juice sought by insects", "sugary liquid produced by flowers"]}, {"entity_id": "n\u00e9ctar", "book_id": "coloquios_da_orta_1563", "name": "n\u00e9ctar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["n\u00e9ctar"], "contexts": ["mythical drink of gods", "food of the gods"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Nectar", "target_book": "coloquios_da_orta_1563", "target_name": "n\u00e9ctar", "similarity": 0.817}], "id": 3185, "stable_key": "clu_36238458d0561d01", "ground_truth": {"modern_name": "Nectar", "confidence": "high", "type": "substance", "description": "Sweet liquid produced by flowers, food of the gods in mythology.", "wikipedia_extract": "Nectar is a viscous, sugar-rich liquid produced by plants in glands called nectaries, either within the flowers with which it attracts pollinating animals, or by extrafloral nectaries, which provide a nutrient source to animal mutualists, which in turn provide herbivore protection. Common nectar-consuming pollinators include mosquitoes, hoverflies, wasps, bees, butterflies and moths, hummingbirds, honeyeaters and bats. Nectar is an economically important substance as it is the sugar source for honey. Nectar is also useful in agriculture and horticulture because the adult stages of some predatory insects feed on nectar. For example, a number of predacious or parasitoid wasps (e.g., the social wasp species Apoica flavissima) rely on nectar as a primary food source. In turn, these wasps then hunt agricultural pest insects as food for their young."}}, {"canonical_name": "Flight", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "flight", "book_id": "origin_of_species_darwin_1859", "name": "Flight", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["Flight", "flight"], "contexts": ["ability to move through air", "movement through the air"]}, {"entity_id": "flight", "book_id": "kosmos_humboldt_1845", "name": "flight", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["flight"], "contexts": ["act of running away"]}, {"entity_id": "flying", "book_id": "kosmos_humboldt_1845", "name": "flying", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["flying"], "contexts": ["ability to move through air"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Flight", "target_book": "kosmos_humboldt_1845", "target_name": "flight", "similarity": 0.978}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Flight", "target_book": "kosmos_humboldt_1845", "target_name": "flying", "similarity": 0.892}], "id": 3186, "stable_key": "clu_8654747e05094694", "ground_truth": {"modern_name": "Flight", "confidence": "high", "type": "concept", "wikipedia_extract": "Falcons Flight is a launched roller coaster located at Six Flags Qiddiya City in Qiddiya City, Riyadh Province, Saudi Arabia. Manufactured by Intamin, the steel coaster opened on December 31, 2025, as the tallest, fastest, and longest roller coaster in the world, surpassing Top Thrill 2, Formula Rossa, and Steel Dragon 2000, respectively. On April 7, 2017, Crown Prince Mohammed bin Salman officially announced the Qiddiya City mega project, an entertainment, sport, and cultural destination designed to diversify Saudi Arabia's economy as part of the Saudi Vision 2030 initiative. Included in the announcement was the involvement of the original Six Flags theme park chain, which at the time was also pursuing the development of international parks in Dubai and China. The Saudi Press Agency reported in October 2018 that the Crown Prince had met with David McKillip \u2013 then Six Flags' senior vice president of international park operations \u2013  at the Future Investment Initiative conference in Riyadh. Details for Six Flags Qiddiya were formally revealed on August 26, 2019, with the park slated to open in early 2023.", "wikipedia_url": "https://en.wikipedia.org/wiki/Falcons_Flight"}}, {"canonical_name": "reproductive system", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "reproductive_system", "book_id": "origin_of_species_darwin_1859", "name": "reproductive system", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["reproductive system"], "contexts": ["biological system for reproduction", "system involved in reproduction"]}, {"entity_id": "reproductive_organs", "book_id": "kosmos_humboldt_1845", "name": "reproductive organs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["reproductive organs"], "contexts": ["organs of liverworts and algae", "plant sexual structures"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "reproductive system", "target_book": "kosmos_humboldt_1845", "target_name": "reproductive organs", "similarity": 0.965}], "id": 3187, "stable_key": "clu_2983679df51a5661", "ground_truth": {"modern_name": "Reproductive system", "confidence": "high", "type": "concept"}}, {"canonical_name": "Silurian epoch", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "silurian_epoch", "book_id": "origin_of_species_darwin_1859", "name": "Silurian epoch", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Silurian epoch", "silurian epoch"], "contexts": ["antecedent to the silurian epoch", "geological time period"]}, {"entity_id": "silurian_epoch", "book_id": "first_principles_spencer_1862", "name": "Silurian epoch", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Silurian epoch"], "contexts": ["geologic epoch with living forms"]}, {"entity_id": "silurian_period", "book_id": "first_principles_spencer_1862", "name": "Silurian period", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Silurian period"], "contexts": ["period with crust subsidences"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Silurian epoch", "target_book": "first_principles_spencer_1862", "target_name": "Silurian epoch", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Silurian epoch", "target_book": "first_principles_spencer_1862", "target_name": "Silurian period", "similarity": 0.972}], "id": 3188, "stable_key": "clu_af8464232ee820f9-2", "ground_truth": {"modern_name": "Silurian", "confidence": "high", "type": "concept", "note": "Refers to the Silurian geological period and system.", "wikidata_id": "Q62412", "wikidata_description": "third period of the Paleozoic Era", "wikipedia_url": "https://en.wikipedia.org/wiki/Silurian", "wikipedia_extract": "The Silurian ( sih-LURE-ee-\u0259n, sy-) is a geologic period and system spanning 23.5 million years from the end of the Ordovician Period, at 443.1 Ma (million years ago) to the beginning of the Devonian Period, 419.62 Ma. The Silurian is the third and shortest period of the Paleozoic Era, and the third of twelve periods of the Phanerozoic Eon. As with other geologic periods, the rock beds that define the period's start and end are well identified, but the exact dates are uncertain by a few million years. The base of the Silurian is set at a series of major Ordovician\u2013Silurian extinction events when up to 60% of marine genera were wiped out. One important event in this period was the initial establishment of terrestrial life in what is known as the Silurian-Devonian Terrestrial Revolution: vascular plants emerged from more primitive land plants, dikaryan fungi started expanding and diversifying along with glomeromycotan fungi, and three groups of arthropods (myriapods, arachnids and hexapods) became fully terrestrialized. Another significant evolutionary milestone during the Silurian was the diversification of jawed fish, which include placoderms, acanthodians (which gave rise to cartilaginous fish) and osteichthyan (bony fish, further divided into lobe-finned and ray-finned fishes), although this corresponded to sharp decline of jawless fish such as conodonts and ostracoderms."}}, {"canonical_name": "organism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "organism", "book_id": "origin_of_species_darwin_1859", "name": "organism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["organism"], "contexts": ["any living thing", "living being"]}, {"entity_id": "organism", "book_id": "kosmos_humboldt_1845", "name": "organism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["organism"], "contexts": ["living being", "living entity in the vegetable world"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "organism", "target_book": "kosmos_humboldt_1845", "target_name": "organism", "similarity": 1.0}], "id": 3189, "stable_key": "clu_ca0577a334c550fb-2", "ground_truth": {"modern_name": "Organism", "confidence": "high", "type": "concept", "wikidata_id": "Q55983715", "wikidata_description": "organisms which have been assigned common names in addition to their taxon name"}}, {"canonical_name": "Westwood", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "westwood", "book_id": "origin_of_species_darwin_1859", "name": "Westwood", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Westwood"], "contexts": ["naturalist remarking on insect differences", "naturalist who remarked on Engidae tarsal joints"]}, {"entity_id": "wedgwood", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Wedgwood", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Wedgwood"], "contexts": ["pioneer of photographic pictures", "produced profiles on prepared surfaces"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Westwood", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Wedgwood", "similarity": 0.883}], "id": 3190, "stable_key": "clu_0b8ea733c71d8f04", "ground_truth": {"modern_name": "John Obadiah Westwood", "confidence": "high", "type": "person", "birth_year": 1805, "death_year": 1893, "description": "Entomologist and natural historian, known for insect studies", "note": "The text mentions 'Westwood' in the context of 'origin_of_species_darwin_1859' and 'Wedgwood' in 'connexion_physical_sciences_somerville_1858'. Given the historical context and the mention of Darwin, John Obadiah Westwood, a prominent entomologist and contemporary of Darwin, is the more likely referent. Wedgwood is less likely in this scientific context, though possibly a reference to Josiah Wedgwood II's association with scientific figures.", "wikidata_id": "Q1236294", "wikidata_description": "English entomologist and archaeologist (1805-1893)"}}, {"canonical_name": "animal kingdom", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "animal_kingdom", "book_id": "origin_of_species_darwin_1859", "name": "animal kingdom", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 4, "variants": ["animal kingdom"], "contexts": ["all animal life", "governed by general laws"]}, {"entity_id": "animal_kingdoms", "book_id": "origin_of_species_darwin_1859", "name": "animal kingdoms", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["animal kingdoms"], "contexts": ["all animal life"]}, {"entity_id": "animal_kingdom", "book_id": "first_principles_spencer_1862", "name": "animal kingdom", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["animal kingdom"], "contexts": ["classification for animals", "kingdom of animals"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "animal kingdom", "target_book": "first_principles_spencer_1862", "target_name": "animal kingdom", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "animal kingdoms", "target_book": "first_principles_spencer_1862", "target_name": "animal kingdom", "similarity": 0.958}], "id": 3191, "stable_key": "clu_2b4b1c46a7820f9d", "ground_truth": {"modern_name": "Animal Kingdom", "confidence": "high", "type": "concept", "wikidata_id": "Q99427839", "wikidata_description": "subject category of the 20th Century Press Archives"}}, {"canonical_name": "Femmes", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "females", "book_id": "origin_of_species_darwin_1859", "name": "females", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["females"], "contexts": ["sex of birds", "object of male competition"]}, {"entity_id": "femmes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Femmes", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 4, "variants": ["Femmes", "FEMMES"], "contexts": ["female population category", "category of people counted"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "females", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Femmes", "similarity": 0.97}], "id": 3192, "stable_key": "clu_601d173e9425a3cb", "ground_truth": {"modern_name": "Female", "confidence": "high", "type": "concept", "note": "The term 'Femmes' in the Humboldt text, alongside 'females' in Darwin's work, clearly refers to the biological sex.", "wikidata_id": "Q2192288", "wikidata_description": "external genital organs of the female mammal"}}, {"canonical_name": "Ireland", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "ireland", "book_id": "origin_of_species_darwin_1859", "name": "Ireland", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Ireland"], "contexts": ["Ireland has few animals", "island for distance comparison"]}, {"entity_id": "ireland", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Ireland", "category": "PLACE", "subcategory": "COUNTRY", "count": 4, "variants": ["Ireland"], "contexts": ["location of base measurement", "island with western coasts"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Ireland", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Ireland", "similarity": 1.0}], "id": 3193, "stable_key": "clu_3d9767a1fab5626a-2", "ground_truth": {"modern_name": "Ireland", "confidence": "high", "type": "place", "description": "An island country with a notable population density.", "wikipedia_extract": "Ireland is an island in the North Atlantic Ocean, in Northwestern Europe. Geopolitically, the island is divided between the Republic of Ireland (officially named Ireland \u2013 a sovereign state covering five-sixths of the island) and Northern Ireland (part of the United Kingdom \u2013 covering the remaining sixth). It is separated from Great Britain to its east by the North Channel, the Irish Sea, and St George's Channel. Ireland is the second-largest island of the British Isles, the third-largest in Europe, and the twentieth-largest in the world. As of 2022, the population of the entire island is just over 7 million, with 5.1 million in the Republic of Ireland and 1.9 million in Northern Ireland, ranking it the second-most populous island in Europe after Great Britain. The geography of Ireland comprises relatively low-lying mountains surrounding a central plain, with several navigable rivers extending inland."}}, {"canonical_name": "British plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "british_plants", "book_id": "origin_of_species_darwin_1859", "name": "British plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["British plants"], "contexts": ["examples of plant varieties", "Mr. Babington on"]}, {"entity_id": "british_flora", "book_id": "kosmos_humboldt_1845", "name": "British flora", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["British flora"], "contexts": ["plants of the British Isles", "plant life of Britain"]}, {"entity_id": "british_plants", "book_id": "kosmos_humboldt_1845", "name": "British Plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["British Plants"], "contexts": ["subject of Watson's remarks"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "British plants", "target_book": "kosmos_humboldt_1845", "target_name": "British flora", "similarity": 0.926}, {"source_book": "origin_of_species_darwin_1859", "source_name": "British plants", "target_book": "kosmos_humboldt_1845", "target_name": "British Plants", "similarity": 0.99}], "id": 3194, "stable_key": "clu_1b6e33fd00f9e5a2", "ground_truth": {"modern_name": "British flora", "confidence": "high", "type": "concept", "note": "This refers to the collective plant life of the British Isles, often studied in the context of natural history and evolution.", "wikidata_id": "Q56651604", "wikidata_description": "plants endemic to Great Britain", "wikipedia_extract": "The flora of India is one of the richest in the world due to the wide range of climate, topology and habitat in the country. Floral Diversity and Medicinal Plant Wealth There are estimated to be over 18,000 species of flowering plants in India, which constitute some 6-7 percent of the total plant species in the world. India is home to more than 50,000  species of plants, including a variety of endemics. The use of plants as a source of medicines has been an integral part of life in India from the earliest times. There are more than 3000 Indian plant species officially documented as possessing  into eight main floristic regions : Western Himalayas, Eastern Himalayas, Assam,  Indus plain, Ganges plain, the Deccan, Malabar and the Andaman Islands. Forest Cover and Vegetation Diversity In 1992, 743,534 km2 of land in the country was forested of which 92 percent was government land.", "wikipedia_url": "https://en.wikipedia.org/wiki/Flora_of_India"}}, {"canonical_name": "Kentucky", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "kentucky", "book_id": "origin_of_species_darwin_1859", "name": "Kentucky", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Kentucky"], "contexts": ["US state", "location of specific caves"]}, {"entity_id": "kentucky", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Kentucky", "category": "PLACE", "subcategory": "COUNTRY", "count": 4, "variants": ["Kentucky"], "contexts": ["region with natural caves", "state in the United States"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Kentucky", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Kentucky", "similarity": 0.923}], "id": 3195, "stable_key": "clu_3a1471d3e2184bda", "ground_truth": {"modern_name": "Kentucky", "confidence": "high", "type": "place", "description": "A state in the United States, known for its natural features.", "wikipedia_extract": "Kentucky (US:  , UK: ), officially the Commonwealth of Kentucky, is a landlocked state in the Southeastern region of the United States. It borders Illinois, Indiana, and Ohio to the north, West Virginia to the northeast, Virginia to the east, Tennessee to the south, and Missouri to the west. Its northern border is defined by the Ohio River. Its capital is Frankfort and its most populous city is Louisville. As of 2024, the state's population was approximately 4.6 million. Previously a part of colonial Virginia, Kentucky was admitted into the Union as the fifteenth state on June 1, 1792."}}, {"canonical_name": "Charles Darwin", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "charles_darwin", "book_id": "origin_of_species_darwin_1859", "name": "Charles Darwin", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Charles Darwin"], "contexts": ["author of 'On the Origin of Species'"]}, {"entity_id": "charles_darwin", "book_id": "kosmos_humboldt_1845", "name": "Charles Darwin", "category": "PERSON", "subcategory": "SCHOLAR", "count": 6, "variants": ["Charles Darwin"], "contexts": ["observed vegetation in travertine", "mentioned in relation to vegetation"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Charles Darwin", "target_book": "kosmos_humboldt_1845", "target_name": "Charles Darwin", "similarity": 1.0}], "id": 3196, "stable_key": "clu_12dc642a90f6e076-2", "ground_truth": {"modern_name": "Charles Darwin", "confidence": "high", "type": "person", "birth_year": 1809, "death_year": 1882, "description": "Naturalist, geologist, and biologist, famous for theory of evolution", "note": "While 'Darwin' is used, the contexts strongly point to Charles Darwin due to 'natural selection' and 'evolution'.", "wikidata_id": "Q1035", "wikidata_description": "English naturalist and biologist (1809\u20131882)", "wikipedia_url": "https://en.wikipedia.org/wiki/Charles%20Darwin", "wikipedia_extract": "Charles Robert Darwin ( DAR-win; 12 February 1809 \u2013 19 April 1882) was an English naturalist, geologist, and biologist, widely known for his contributions to evolutionary biology. His proposition that all species of life have descended from a common ancestor is now generally accepted and considered a fundamental scientific concept. In a joint presentation with Alfred Russel Wallace, he introduced his scientific theory that this branching pattern of evolution resulted from a process he called natural selection, in which the struggle for existence has a similar effect to the artificial selection involved in selective breeding. Darwin has been described as one of the most influential figures in human history and was honoured by burial in Westminster Abbey. Darwin's early interest in nature led him to neglect his medical education at the University of Edinburgh; instead, he helped Robert Edmond Grant to investigate marine invertebrates. His studies at the University of Cambridge's Christ's College from 1828 to 1831 encouraged his passion for natural science."}}, {"canonical_name": "Captain Hutton", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "capt__hutton", "book_id": "origin_of_species_darwin_1859", "name": "Capt. Hutton", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Capt. Hutton"], "contexts": ["judge of cross-bred geese fertility"]}, {"entity_id": "hutton,_captain", "book_id": "origin_of_species_darwin_1859", "name": "Hutton, Captain", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Hutton, Captain"], "contexts": ["on crossed geese"]}, {"entity_id": "captain_hutton", "book_id": "kosmos_humboldt_1845", "name": "Captain Hutton", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Captain Hutton"], "contexts": ["author of paper on Himalayan snow", "observer of mountain snow-lines"]}, {"entity_id": "hutton,_capt__thomas", "book_id": "kosmos_humboldt_1845", "name": "Hutton, Capt. Thomas", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Hutton, Capt. Thomas"], "contexts": ["wrote on the snow-line of the Himalayas", "paper on snow-line of Himalayas"]}, {"entity_id": "captain_thomas_hutton", "book_id": "kosmos_humboldt_1845", "name": "Captain Thomas Hutton", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Captain Thomas Hutton"], "contexts": ["assistant surveyor questioning snow-line"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Capt. Hutton", "target_book": "kosmos_humboldt_1845", "target_name": "Captain Hutton", "similarity": 0.951}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Capt. Hutton", "target_book": "kosmos_humboldt_1845", "target_name": "Hutton, Capt. Thomas", "similarity": 0.896}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Capt. Hutton", "target_book": "kosmos_humboldt_1845", "target_name": "Captain Thomas Hutton", "similarity": 0.93}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Hutton, Captain", "target_book": "kosmos_humboldt_1845", "target_name": "Captain Hutton", "similarity": 0.948}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Hutton, Captain", "target_book": "kosmos_humboldt_1845", "target_name": "Hutton, Capt. Thomas", "similarity": 0.89}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Hutton, Captain", "target_book": "kosmos_humboldt_1845", "target_name": "Captain Thomas Hutton", "similarity": 0.92}], "id": 3197, "stable_key": "clu_7a234772175e54a4", "ground_truth": {"modern_name": "Thomas Hutton", "confidence": "high", "type": "person", "description": "Naturalist and writer, studied geese fertility and Himalayan snow."}}, {"canonical_name": "tercero grado", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "tercero_grado", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "tercero grado", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["tercero grado"], "contexts": ["degree of potency", "degree of heat"]}, {"entity_id": "tercero_grado", "book_id": "historia_medicinal_monardes_1574", "name": "tercero grado", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["tercero grado"], "contexts": ["third degree of quality"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "tercero grado", "target_book": "historia_medicinal_monardes_1574", "target_name": "tercero grado", "similarity": 1.0}], "id": 3198, "stable_key": "clu_ac57d8bcdcc9b9a8", "ground_truth": {"modern_name": "Third Degree", "confidence": "medium", "type": "concept", "note": "This likely refers to a degree of potency or quality in ancient and medieval medical theory, often related to humors or substances."}}, {"canonical_name": "junturas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "junturas", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "junturas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 6, "variants": ["junturas"], "contexts": ["joints where thick humors are located", "pains of joints"]}, {"entity_id": "junturas", "book_id": "historia_medicinal_monardes_1574", "name": "junturas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["junturas"], "contexts": ["joints"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "junturas", "target_book": "historia_medicinal_monardes_1574", "target_name": "junturas", "similarity": 0.779}], "id": 3199, "stable_key": "clu_1cdc076c550e474c-2", "ground_truth": {"modern_name": "Joints", "confidence": "high", "type": "concept", "wikidata_id": "Q33652928", "wikidata_description": "scientific article", "note": "'Articulations' in this context refers to the anatomical structures of joints, where bones connect, allowing for movement. It can also refer to the manner in which things are joined or connected.", "description": "The points where two bones meet; connections in the body.", "wikipedia_extract": "A joint or articulation (or articular surface) is the connection made between bones, ossicles, or other hard structures in the body which link an animal's skeletal system into a functional whole. They are constructed to allow for different degrees and types of movement. Some joints, such as the knee, elbow, and shoulder, are self-lubricating, almost frictionless, and are able to withstand compression and maintain heavy loads while still executing smooth and precise movements. Other joints such as sutures between the bones of the skull permit very little movement (only during birth) in order to protect the brain and the sense organs. The connection between a tooth and the jawbone is also called a joint, and is described as a fibrous joint known as a gomphosis. Joints are classified both structurally and functionally."}}, {"canonical_name": "alumbre", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "alumbre", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "alumbre", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["alumbre"], "contexts": ["mineral used in dye preparation", "substance added to change color"]}, {"entity_id": "alumbre", "book_id": "historia_medicinal_monardes_1574", "name": "Alumbre", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["alumbre", "Alumbre"], "contexts": ["alum", "alum, a substance"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "alumbre", "target_book": "historia_medicinal_monardes_1574", "target_name": "Alumbre", "similarity": 0.813}], "id": 3200, "stable_key": "clu_e0847bbee610c208", "ground_truth": {"modern_name": "Alum", "confidence": "high", "type": "mineral", "wikidata_id": "Q421857", "wikidata_description": "chemical compound", "wikipedia_url": "https://en.wikipedia.org/wiki/Aluminium%20sulfate"}}, {"canonical_name": "pasmo", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "pasmo", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "pasmo", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 5, "variants": ["pasmo"], "contexts": ["condition treated with plant fumigation", "medical condition treated by Huapahualizpatli"]}, {"entity_id": "pasmos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "pasmos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["pasmos"], "contexts": ["cramps or spasms treated by plant"]}, {"entity_id": "pasmo", "book_id": "coloquios_da_orta_1563", "name": "pasmo", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["pasmo"], "contexts": ["shock or dismay"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "pasmo", "target_book": "coloquios_da_orta_1563", "target_name": "pasmo", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "pasmos", "target_book": "coloquios_da_orta_1563", "target_name": "pasmo", "similarity": 0.896}], "id": 3201, "stable_key": "clu_97ccc2d221ee4205", "ground_truth": {"modern_name": "Spasm", "confidence": "high", "type": "disease", "modern_term": "Spasm", "note": " 'Pasmo' can also refer to shock or dismay, but in a medical context, spasm is the primary meaning.", "wikidata_id": "Q6152510", "wikidata_description": "human disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Spasmodic%20torticollis"}}, {"canonical_name": "perles\u00eda", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "perles\u00eda", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "perles\u00eda", "category": "DISEASE", "subcategory": "CHRONIC", "count": 4, "variants": ["perles\u00eda"], "contexts": ["paralysis", "purged and strengthened those suffering from paralysis"]}, {"entity_id": "perlefia", "book_id": "historia_medicinal_monardes_1574", "name": "perlefia", "category": "DISEASE", "subcategory": "CHRONIC", "count": 3, "variants": ["perlefia", "Perlefia", "Perles\u00eda"], "contexts": ["paralysis treated by the water", "paralysis, treated with balm"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "perles\u00eda", "target_book": "historia_medicinal_monardes_1574", "target_name": "perlefia", "similarity": 0.945}], "id": 3202, "stable_key": "clu_ca64549c5a1162bb", "ground_truth": {"modern_name": "Paralysis", "confidence": "high", "type": "disease", "modern_term": "Paralysis", "wikidata_id": "Q1788314", "wikidata_description": "human disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Periodic%20paralysis"}}, {"canonical_name": "heridas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "heridas", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "heridas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 4, "variants": ["heridas"], "contexts": ["wounds treated with oil", "wounds treated by plants"]}, {"entity_id": "heridas", "book_id": "historia_medicinal_monardes_1574", "name": "Heridas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["heridas", "Heridas"], "contexts": ["wounds", "wounds that the balsam is useful for"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "heridas", "target_book": "historia_medicinal_monardes_1574", "target_name": "Heridas", "similarity": 0.995}], "id": 3203, "stable_key": "clu_21f9031feaa2519f-2", "ground_truth": {"modern_name": "Wounds", "confidence": "high", "type": "disease", "description": "An injury to living tissue, typically involving a break in the skin.", "note": "Includes various types of wounds like 'green Wounds' and 'inward Wounds'. 'Contus\u00f5es' (bruises) are also a form of wound.", "wikipedia_extract": "A wound is any disruption of or damage to living tissue, such as skin, mucous membranes, or organs. Wounds can either be the sudden result of direct trauma (mechanical, thermal, chemical), or can develop slowly over time due to underlying disease processes such as diabetes mellitus, venous/arterial insufficiency, or immunologic disease. Wounds can vary greatly in their appearance depending on wound location, injury mechanism, depth of injury, timing of onset (acute vs chronic), and wound sterility, among other factors. Treatment strategies for wounds will vary based on the classification of the wound, therefore it is essential that wounds be thoroughly evaluated by a healthcare professional for proper management. In normal physiology, all wounds will undergo a series of steps collectively known as the wound healing process, which include hemostasis, inflammation, proliferation, and tissue remodeling. Age, tissue oxygenation, stress, underlying medical conditions, and certain medications are just a few of the many factors known to affect the rate of wound healing."}}, {"canonical_name": "Guayacan", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "guayacan", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Guayacan", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["guayacan", "Guayacan"], "contexts": ["tree also called palo santo", "plant used for similar cures"]}, {"entity_id": "guayauas", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "guayauas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["guayauas"], "contexts": ["food source for some people"]}, {"entity_id": "guayauas", "book_id": "historia_medicinal_monardes_1574", "name": "Guayauas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Guayauas", "Guayavas"], "contexts": ["guavas", "fruit from India"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Guayacan", "target_book": "historia_medicinal_monardes_1574", "target_name": "Guayauas", "similarity": 0.908}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "guayauas", "target_book": "historia_medicinal_monardes_1574", "target_name": "Guayauas", "similarity": 0.954}], "id": 3204, "stable_key": "clu_8dae2f13109b1181", "ground_truth": {"modern_name": "Guayac\u00e1n", "confidence": "medium", "type": "plant", "note": "The context suggests 'Guayacan' is a tree. 'Guayauas' and 'guavas' are also present, which are fruits from the guava tree (Psidium guajava). The identification is ambiguous between the tree 'Guayacan' and the fruit 'guava' or its related plant.", "wikidata_id": "Q1028485", "wikidata_description": "type of wood known for being particularly heavy and hard", "wikipedia_url": "https://en.wikipedia.org/wiki/Lignum%20vitae"}}, {"canonical_name": "sabor", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "sabor", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "sabor", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["sabor"], "contexts": ["taste of Atzoyatl", "sensory perception of taste"]}, {"entity_id": "sabor", "book_id": "coloquios_da_orta_1563", "name": "sabor", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["sabor", "saborosa"], "contexts": ["taste", "taste of galanga and a\u00e7oro"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "sabor", "target_book": "coloquios_da_orta_1563", "target_name": "sabor", "similarity": 1.0}], "id": 3205, "stable_key": "clu_8e311801eee7b35f", "ground_truth": {"modern_name": "taste", "confidence": "high", "type": "concept", "wikidata_id": "Q37477789", "wikidata_description": "family name"}}, {"canonical_name": "Caymanes", "category": "ANIMAL", "subcategory": "REPTILE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "caymanes", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Caymanes", "category": "ANIMAL", "subcategory": "REPTILE", "count": 3, "variants": ["CAYMANES", "Caymanes"], "contexts": ["large reptiles", "type of caiman"]}, {"entity_id": "cayman", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Cayman", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Cayman"], "contexts": ["large reptile"]}, {"entity_id": "cay_man", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "cay man", "category": "ANIMAL", "subcategory": "REPTILE", "count": 1, "variants": ["cay man"], "contexts": ["alligator-like reptile"]}, {"entity_id": "cayman", "book_id": "historia_medicinal_monardes_1574", "name": "Cayman", "category": "ANIMAL", "subcategory": "REPTILE", "count": 2, "variants": ["Cayman"], "contexts": ["large lizard-like animals in Tierra Firme", "large lizard or crocodile"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Caymanes", "target_book": "historia_medicinal_monardes_1574", "target_name": "Cayman", "similarity": 0.975}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Cayman", "target_book": "historia_medicinal_monardes_1574", "target_name": "Cayman", "similarity": 0.94}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "cay man", "target_book": "historia_medicinal_monardes_1574", "target_name": "Cayman", "similarity": 0.585}], "id": 3206, "stable_key": "clu_ae1e86add130bbc9", "ground_truth": {"modern_name": "caiman", "confidence": "high", "type": "animal", "wikidata_id": "Q11001288", "wikidata_description": "genus of crocodilians from the alligator family", "wikipedia_url": "https://en.wikipedia.org/wiki/Caiman%20%28genus%29"}}, {"canonical_name": "Indie orientali", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "india_oriental", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "india oriental", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["india oriental"], "contexts": ["Eastern India", "region of origin for ginger"]}, {"entity_id": "indie_orientali", "book_id": "ricettario_fiorentino_1597", "name": "Indie orientali", "category": "PLACE", "subcategory": "REGION", "count": 5, "variants": ["Indie orientali", "Indie Occidentali", "Indie occidentali"], "contexts": ["East Indies, origin of rhubarb", "region where plant parts originate"]}], "edges": [{"