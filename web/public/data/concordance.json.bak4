, "members": [{"entity_id": "oersted", "book_id": "kosmos_humboldt_1845", "name": "Oersted", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["OErsted", "Oersted"], "contexts": ["discovered connection between electricity and magnetism", "discoverer of electricity-magnetism connection"]}, {"entity_id": "oersted", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Oersted", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Oersted"], "contexts": ["Professor of Natural Philosophy at Copenhagen", "scientist remembered for electro-magnetism"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Oersted", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Oersted", "similarity": 1.0}], "id": 3282, "stable_key": "clu_fc976c439f271238", "ground_truth": {"modern_name": "Hans Christian \u00d8rsted", "confidence": "high", "type": "person", "birth_year": 1777, "death_year": 1851, "description": "Danish physicist and chemist, discovered electromagnetism", "wikidata_id": "Q44412", "wikidata_description": "Danish physicist and chemist (1777-1851)"}}, {"canonical_name": "solar heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "solar_heat", "book_id": "kosmos_humboldt_1845", "name": "solar heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["solar heat"], "contexts": ["heat from the sun", "heat from the Sun"]}, {"entity_id": "solar_heat", "book_id": "connexion_physical_sciences_somerville_1858", "name": "solar heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["solar heat"], "contexts": ["heat from the sun", "heat originating from the sun"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "solar heat", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "solar heat", "similarity": 1.0}], "i