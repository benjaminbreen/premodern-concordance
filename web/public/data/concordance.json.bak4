tegory": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "igneo", "book_id": "polyanthea_medicinal", "name": "igneo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["igneo"], "contexts": ["fiery quality"]}, {"entity_id": "ignea", "book_id": "polyanthea_medicinal", "name": "ignea", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["ignea"], "contexts": ["related to fire"]}, {"entity_id": "igneous", "book_id": "first_principles_spencer_1862", "name": "igneous", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["igneous"], "contexts": ["related to fire or heat", "class of geological changes"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "igneo", "target_book": "first_principles_spencer_1862", "target_name": "igneous", "similarity": 0.908}, {"source_book": "polyanthea_medicinal", "source_name": "ignea", "target_book": "first_principles_spencer_1862", "target_name": "igneous", "similarity": 0.907}], "id": 3369, "stable_key": "clu_b0697461a0504831", "ground_truth": {"modern_name": "Igneous", "confidence": "high", "type": "concept", "wikidata_id": "Q498203", "wikidata_description": "processes by which magmas undergo bulk chemical change during the partial melting process, cooling, emplacement, or eruption"}}, {"canonical_name": "Mer Rouge", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "mer_rouge", "book_id": "epoques_nature_buffon_1778", "name": "mer Rouge", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["mer Rouge"], "contexts": ["strait in Arabia"]}, {"entity_id": "mer_rouge", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Mer Rouge", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Mer Rouge"], "contexts": ["sea with a permanent difference in level", "body of water"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "mer Rouge", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Mer Rouge", "similarity": 0.985}], "id": 3370, "stable_key": "clu_8297bc8005964d5d-2", "ground_truth": {"modern_name": "Red Sea", "confidence": "high", "type": "place", "description": "A sea route connecting East and West.", "wikipedia_extract": "The Red Sea is a sea inlet of the Indian Ocean, lying between Africa and Asia. Its connection to the ocean is in the south, through the Bab-el-Mandeb Strait and the Gulf of Aden. To the north of the Red Sea lies the Sinai Peninsula, the Gulf of Aqaba, and the Gulf of Suez, which leads to the Suez Canal. It is underlain by the Red Sea Rift, which is part of the Great Rift Valley. The Red Sea has a surface area of roughly 438,000 km2 (169,000 sq mi), is about 2,250 km (1,400 mi) long, and 355 km (221 mi) across at its widest point. It has an average depth of 490 m (1,610 ft), and in the central Suakin Trough, it reaches its maximum depth of 2,730 m (8,960 ft)."}}, {"canonical_name": "eaux thermales", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "eaux_thermales", "book_id": "epoques_nature_buffon_1778", "name": "eaux thermales", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["eaux thermales"], "contexts": ["hot waters from underground"]}, {"entity_id": "eaux_thermales", "book_id": "relation_historique_humboldt_vol3_1825", "name": "eaux thermales", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["eaux thermales", "eaux chaudes"], "contexts": ["nature of the phenomenon", "hot spring waters"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "eaux thermales", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "eaux thermales", "similarity": 1.0}], "id": 3371, "stable_key": "clu_a936c234cb381b34", "ground_truth": {"modern_name": "hot springs", "confidence": "high", "type": "place", "wikidata_id": "Q3475263", "wikidata_description": "census-designated place in Bath County, Virginia, United States of America", "wikipedia_url": "https://en.wikipedia.org/wiki/Hot%20Springs%2C%20Virginia"}}, {"canonical_name": "h\u00e9misph\u00e8res", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "h\u00e9misph\u00e8re", "book_id": "epoques_nature_buffon_1778", "name": "h\u00e9misph\u00e8re", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["h\u00e9misph\u00e8re"], "contexts": ["half of the Earth"]}, {"entity_id": "h\u00e9misph\u00e8res", "book_id": "relation_historique_humboldt_vol3_1825", "name": "h\u00e9misph\u00e8res", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["h\u00e9misph\u00e8res"], "contexts": ["halves of the Earth", "geographic division of the Earth"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "h\u00e9misph\u00e8re", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "h\u00e9misph\u00e8res", "similarity": 0.929}], "id": 3372, "stable_key": "clu_164d9586cb55dfb5", "ground_truth": {"modern_name": "hemisphere", "confidence": "high", "type": "place", "wikidata_id": "Q399984", "wikidata_description": "bipartite divisions of Earth", "wikipedia_url": "https://en.wikipedia.org/wiki/Hemispheres%20of%20Earth"}}, {"canonical_name": "ch\u00e8vres", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "ch\u00e8vre", "book_id": "epoques_nature_buffon_1778", "name": "ch\u00e8vre", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["ch\u00e8vre"], "contexts": ["domesticated mammal"]}, {"entity_id": "ch\u00e8vres", "book_id": "relation_historique_humboldt_vol3_1825", "name": "ch\u00e8vres", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 5, "variants": ["ch\u00e8vres"], "contexts": ["animals not found in steppes", "animals that died from lack of grass"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "ch\u00e8vre", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "ch\u00e8vres", "similarity": 0.919}], "id": 3373, "stable_key": "clu_0f227cfa5a988b3b", "ground_truth": {"modern_name": "goats", "confidence": "high", "type": "animal", "wikidata_id": "Q45320358", "wikidata_description": "species of mammal"}}, {"canonical_name": "paper", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "paper", "book_id": "english_physician_1652", "name": "paper", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 5, "variants": ["paper", "Paper", "Papers"], "contexts": ["material for covering vessel", "used to bind mouth of container"]}, {"entity_id": "sheet_of_paper", "book_id": "principles_of_psychology_james_1890", "name": "sheet of paper", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["sheet of paper"], "contexts": ["physical object with whiteness"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "paper", "target_book": "principles_of_psychology_james_1890", "target_name": "sheet of paper", "similarity": 0.959}], "id": 3374, "stable_key": "clu_e70dbe8afb85a53a", "ground_truth": {"modern_name": "Paper", "confidence": "high", "type": "object", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "roughness", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "roughness", "book_id": "english_physician_1652", "name": "roughness", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 5, "variants": ["roughness", "Roughness of the skin", "roughness of the Skin", "roughness of the Tongue"], "contexts": ["condition of the skin", "texture of the skin"]}, {"entity_id": "durezas", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "durezas", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["durezas"], "contexts": ["symptom of hardness or swelling"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "roughness", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "durezas", "similarity": 0.902}], "id": 3375, "stable_key": "clu_92c2d3837e338c22", "ground_truth": {"modern_name": "induration", "confidence": "high", "type": "disease", "modern_term": "induration", "wikidata_id": "Q874586", "wikidata_description": "Human disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Peyronie%27s%20disease"}}, {"canonical_name": "Nurses", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "nurses", "book_id": "english_physician_1652", "name": "Nurses", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 5, "variants": ["Nurses"], "contexts": ["people drinking herb-infused drink", "fennel good for them"]}, {"entity_id": "nurcino", "book_id": "polyanthea_medicinal", "name": "Nurcino", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["Nurcino"], "contexts": ["lithotomist surgeon"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Nurses", "target_book": "polyanthea_medicinal", "target_name": "Nurcino", "similarity": 0.85}], "id": 3376, "stable_key": "clu_30496518af680704", "ground_truth": {"modern_name": "Nurses", "confidence": "medium", "type": "person", "description": "Individuals who care for the sick or infirm.", "note": "Includes both general nurses and potentially surgical practitioners like lithotomists.", "wikipedia_extract": "Nursing is a health care profession that \"integrates the art and science of caring and focuses on the protection, promotion, and optimization of health and human functioning; prevention of illness and injury; facilitation of healing; and alleviation of suffering through compassionate presence\". Nurses practice in many specialties with varying levels of certification and responsibility. Nurses comprise the largest component of most healthcare environments. There are shortages of qualified nurses in many countries. Nurses develop a plan of care, working collaboratively with physicians, therapists, patients, patients' families, and other team members that focuses on treating illness to improve quality of life. In the United Kingdom and the United States, clinical nurse specialists and nurse practitioners diagnose health problems and prescribe medications and other therapies, depending on regulations that vary by state."}}, {"canonical_name": "Cachexia", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "cachexia", "book_id": "english_physician_1652", "name": "Cachexia", "category": "DISEASE", "subcategory": "CHRONIC", "count": 5, "variants": ["Cachexia"], "contexts": ["disposition of the whole body", "ill disposition of the whole body"]}, {"entity_id": "cachexia", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "cachexia", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["cachexia"], "contexts": ["illness of the body, often from cold cause"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Cachexia", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "cachexia", "similarity": 0.787}], "id": 3377, "stable_key": "clu_61499a7763b4c0ea", "ground_truth": {"modern_name": "cachexia", "confidence": "high", "type": "disease", "modern_term": "cachexia", "wikidata_id": "Q2932525", "wikidata_description": "animal disease"}}, {"canonical_name": "Radish", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "radish", "book_id": "english_physician_1652", "name": "Radish", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["Radish"], "contexts": ["seed used as remedy", "root vegetable used in medicine"]}, {"entity_id": "radish", "book_id": "origin_of_species_darwin_1859", "name": "radish", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["radish"], "contexts": ["variety of plant discussed for cross-pollination"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Radish", "target_book": "origin_of_species_darwin_1859", "target_name": "radish", "similarity": 0.982}], "id": 3378, "stable_key": "clu_186e2814b40188fe-3", "ground_truth": {"modern_name": "Radish", "confidence": "high", "type": "plant", "linnaean": "Raphanus sativus", "family": "Brassicaceae", "description": "Edible root vegetable with a peppery flavor, commonly consumed raw.", "note": "The term 'rab\u00f4' in one context appears to refer to a specific type of pepper, but the overwhelming evidence points to 'radish' for the other instances.", "wikipedia_extract": "The radish (Raphanus sativus or Raphanus raphanistrum subsp. sativus) is a flowering plant in the mustard family, Brassicaceae. Its large taproot is commonly used as a root vegetable, although the entire plant is edible and its leaves are sometimes used as a leaf vegetable. Originally domesticated in Asia, radishes are now grown and consumed globally. The radish is sometimes considered to form a species complex with the wild radish and instead treated as the subspecies Raphanus raphanistrum subsp. sativus. Radishes are often used raw as a crunchy salad vegetable with a pungent, slightly spicy flavor, varying in intensity depending on its growing environment. There are numerous varieties varying in size, flavor, color, and length of time they take to mature.", "wikidata_id": "Q7224565", "wikidata_description": "species of plant"}}, {"canonical_name": "Maidenhair", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "maidenhair", "book_id": "english_physician_1652", "name": "Maidenhair", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Maidenhair", "Golden Maidenhair"], "contexts": ["herb used with Liquorice", "plant with black fibers and green leaves"]}, {"entity_id": "maidenhair", "book_id": "polyanthea_medicinal", "name": "Maidenhair", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Maidenhair"], "contexts": ["herb for coughs and jaundice"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Maidenhair", "target_book": "polyanthea_medicinal", "target_name": "Maidenhair", "similarity": 1.0}], "id": 3379, "stable_key": "clu_3f3419a136bca0f0", "ground_truth": {"modern_name": "Maidenhair Fern", "confidence": "high", "type": "plant", "linnaean": "Adiantum spp.", "family": "Pteridaceae", "description": "A delicate fern with fan-shaped fronds and black stems.", "note": "Refers to plants in the genus Adiantum.", "wikipedia_extract": "Adiantum (), the maidenhair fern (not to be confused with the similar-looking maidenhair spleenwort fern), is a genus of about 250 species of ferns in the subfamily Vittarioideae of the family Pteridaceae, though some researchers place it in its own family, Adiantaceae. The genus name comes from Greek, meaning \"unwetted\", referring to the fronds' ability to shed water without becoming wet. They are distinctive in appearance, with dark, often black stipes and rachises, and bright green, often delicately cut leaf tissue. The sori are borne submarginally, and are covered by reflexed flaps of leaf tissue which resemble indusia. Dimorphism between sterile and fertile fronds is generally subtle. They generally prefer humus-rich, moist, well-drained sites, ranging from bottomland soils to vertical rock walls."}}, {"canonical_name": "Apothecaries", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "apothecaries", "book_id": "english_physician_1652", "name": "Apothecaries", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 4, "variants": ["Apothecaries"], "contexts": ["sellers of medicines", "dispensers of medicine"]}, {"entity_id": "pharmaciens", "book_id": "relation_historique_humboldt_vol3_1825", "name": "pharmaciens", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 2, "variants": ["pharmaciens", "farmacenticos"], "contexts": ["pharmacy practitioners in Havana"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Apothecaries", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "pharmaciens", "similarity": 0.877}], "id": 3380, "stable_key": "clu_505e6dafb2f1e125-2", "ground_truth": {"modern_name": "Apothecary", "confidence": "high", "type": "person", "description": "Prepares and dispenses medicinal drugs.", "wikidata_id": "Q1131236", "wikidata_description": "historical name for a medical professional now called a pharmacist", "wikipedia_url": "https://en.wikipedia.org/wiki/Apothecary", "wikipedia_extract": "Apothecary () is an archaic English term for a medical professional who formulates and dispenses materia medicacode: lat promoted to code: la  ('medicine') to physicians, surgeons and patients. The modern terms pharmacist and, in British English, chemist have taken over this role. In some languages and regions, terms similar to \"apothecary\" have survived and denote modern pharmacies or pharmacists. Apothecaries' investigation of herbal and chemical ingredients was a precursor to the modern sciences of chemistry and pharmacology. In addition to dispensing herbs and medicine, apothecaries offered general medical advice and a range of services that are now performed by other specialist practitioners, such as surgeons and obstetricians. Apothecary shops sold ingredients and the medicines they prepared wholesale to other medical practitioners, as well as dispensing them to patients."}}, {"canonical_name": "Red Roses", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "red_roses", "book_id": "english_physician_1652", "name": "Red Roses", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["red Roses", "Red Roses"], "contexts": ["added to Lettice water for strengthening", "type of rose with medicinal uses"]}, {"entity_id": "flores_rojas", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "flores rojas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["flores rojas"], "contexts": ["red flowers of the plant", "red flowers"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Red Roses", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "flores rojas", "similarity": 0.905}], "id": 3381, "stable_key": "clu_ff6459e46a4ff791", "ground_truth": {"modern_name": "red rose", "confidence": "high", "type": "plant", "linnaean": "Rosa gallica", "family": "Rosaceae", "note": "Assumed Rosa gallica based on historical use.", "wikidata_id": "Q114518812", "wikidata_description": "episode of Sons of Anarchy (S7 E12)"}}, {"canonical_name": "Smelling", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "smelling", "book_id": "english_physician_1652", "name": "Smelling", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Smelling", "smell"], "contexts": ["sense of smell", "sense of odor"]}, {"entity_id": "smells", "book_id": "principles_of_psychology_james_1890", "name": "Smells", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["smells", "Smells"], "contexts": ["olfactory perceptions", "sensible qualities of experience"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Smelling", "target_book": "principles_of_psychology_james_1890", "target_name": "Smells", "similarity": 0.957}], "id": 3382, "stable_key": "clu_428e4f48dcd827c8", "ground_truth": {"modern_name": "Smell", "confidence": "high", "type": "concept"}}, {"canonical_name": "venemous Beast", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "venemous_beast", "book_id": "english_physician_1652", "name": "venemous Beast", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["venemous Beast", "Venem", "Venemous Beast"], "contexts": ["biting treated with ash-tree parts", "bites treated by the herb"]}, {"entity_id": "venenosa", "book_id": "polyanthea_medicinal", "name": "venenosa", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["venenosa"], "contexts": ["poisonous quality"]}, {"entity_id": "bicho_venenoso", "book_id": "polyanthea_medicinal", "name": "bicho venenoso", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["bicho venenoso"], "contexts": ["venomous creature bite"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "venemous Beast", "target_book": "polyanthea_medicinal", "target_name": "venenosa", "similarity": 0.921}, {"source_book": "english_physician_1652", "source_name": "venemous Beast", "target_book": "polyanthea_medicinal", "target_name": "bicho venenoso", "similarity": 0.907}], "id": 3383, "stable_key": "clu_e8d8fcc657450a34-2", "ground_truth": {"modern_name": "Venomous bite", "confidence": "high", "type": "disease", "modern_term": "Venomous bite", "note": "The context of Monardes, who described New World fauna and their medicinal uses, and the general understanding of 'mordedura' in medical texts of the era, points to bites from venomous animals as the primary referent.", "wikidata_id": "Q39579114", "wikidata_description": "scientific article published on April 24, 2012"}}, {"canonical_name": "Major", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "lord_major", "book_id": "english_physician_1652", "name": "Lord Major", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Lord Major", "Lord"], "contexts": ["audience for a sermon", "when the Lord shall come"]}, {"entity_id": "major", "book_id": "coloquios_da_orta_1563", "name": "Major", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 4, "variants": ["Major"], "contexts": ["editor of a text", "author of India"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Lord Major", "target_book": "coloquios_da_orta_1563", "target_name": "Major", "similarity": 0.89}], "id": 3384, "stable_key": "clu_f8fd0d7405d53eda", "ground_truth": {"modern_name": "Lord Mayor", "confidence": "high", "type": "person", "description": "Title of a chief magistrate, often an audience for texts."}}, {"canonical_name": "Emperadores", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "emperadores", "book_id": "historia_medicinal_monardes_1574", "name": "Emperadores", "category": "PERSON", "subcategory": "PATRON", "count": 2, "variants": ["Emperadores", "Emperador"], "contexts": ["rulers who can be poisoned", "Emperor who took the stone for melancholy"]}, {"entity_id": "emperadores", "book_id": "polyanthea_medicinal", "name": "Emperadores", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 4, "variants": ["Emperadores", "Emperatriz", "Imperatoris"], "contexts": ["Emperors", "Empress"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Emperadores", "target_book": "polyanthea_medicinal", "target_name": "Emperadores", "similarity": 0.757}], "id": 3385, "stable_key": "clu_3929b07a0426a7b6", "ground_truth": {"modern_name": "Emperor", "confidence": "high", "type": "person", "description": "Title of a sovereign ruler, relevant to poisoning and power."}}, {"canonical_name": "Herb. Amb.", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "herbal", "book_id": "english_physician_1652", "name": "Herbal", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Herbal"], "contexts": ["book on plants and their uses"]}, {"entity_id": "herb__amb_", "book_id": "coloquios_da_orta_1563", "name": "Herb. Amb.", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 5, "variants": ["Herb. Amb.", "Herb. amb.", "Herh. amB."], "contexts": ["title of a botanical work", "book title"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Herbal", "target_book": "coloquios_da_orta_1563", "target_name": "Herb. Amb.", "similarity": 0.895}], "id": 3386, "stable_key": "clu_57e18a1c021ac70c", "ground_truth": {"modern_name": "Herbal", "confidence": "high", "type": "object", "description": "A book containing descriptions and illustrations of plants and their uses.", "note": "Refers to specific botanical works and the general category of herbals.", "wikipedia_extract": "A herbal is a book containing the names and descriptions of plants, usually with information on their medicinal, tonic, culinary, toxic, hallucinatory, aromatic, or magical powers, and the legends associated with them. A herbal may also classify the plants it describes, may give recipes for herbal extracts, tinctures, or potions, and sometimes include mineral and animal medicaments in addition to those obtained from plants. Herbals were often illustrated to assist plant identification. Herbals were among the first literature produced in Ancient Egypt, China, India, and Europe as the medical wisdom of the day accumulated by herbalists, apothecaries and physicians. Herbals were also among the first books to be printed in both China and Europe. In Western Europe herbals flourished for two centuries following the introduction of moveable type (c. 1470\u20131670)."}}, {"canonical_name": "caliente y seca", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "hot_and_dry", "book_id": "english_physician_1652", "name": "hot and dry", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["hot and dry"], "contexts": ["qualities of wormwood in the first degree"]}, {"entity_id": "caliente_y_seca", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "caliente y seca", "category": "CONCEPT", "subcategory": "QUALITY", "count": 5, "variants": ["caliente y seca"], "contexts": ["temperature qualities of the tree", "temperament of the palo"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "hot and dry", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "caliente y seca", "similarity": 0.963}], "id": 3387, "stable_key": "clu_15ddec60438ffc32", "ground_truth": {"modern_name": "hot and dry", "confidence": "high", "type": "concept", "note": "Refers to one of the four humoral qualities (hot, cold, wet, dry) and combinations thereof, prevalent in Galenic and humoral medicine, not specific to temperature."}}, {"canonical_name": "seedlings", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "seedlings", "book_id": "origin_of_species_darwin_1859", "name": "seedlings", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["Seedlings", "seedlings"], "contexts": ["young plants from the same fruit", "young plants grown from seeds"]}, {"entity_id": "seed-lobes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Seed-lobes", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Seed-lobes"], "contexts": ["proportion in distribution of plants"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "seedlings", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Seed-lobes", "similarity": 0.923}], "id": 3388, "stable_key": "clu_efd8e778fddb9a95", "ground_truth": {"modern_name": "seedling", "confidence": "high", "type": "plant", "note": "The term 'Seed-lobes' seems to be a misreading or less common variant for 'seedlings' in the given context.", "wikidata_id": "Q1385709", "wikidata_description": "a young seed plant just after germination"}}, {"canonical_name": "offspring", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "offspring", "book_id": "origin_of_species_darwin_1859", "name": "offspring", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 5, "variants": ["offspring"], "contexts": ["progeny of organisms", "progeny of an organism"]}, {"entity_id": "offspring", "book_id": "first_principles_spencer_1862", "name": "offspring", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["offspring"], "contexts": ["progeny of parents"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "offspring", "target_book": "first_principles_spencer_1862", "target_name": "offspring", "similarity": 1.0}], "id": 3389, "stable_key": "clu_c37369838e49d989", "ground_truth": {"modern_name": "offspring", "confidence": "high", "type": "concept", "wikidata_id": "Q239526", "wikidata_description": "in biology, the product of reproduction of an organism", "wikipedia_url": "https://en.wikipedia.org/wiki/Offspring"}}, {"canonical_name": "destruction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "destruction", "book_id": "origin_of_species_darwin_1859", "name": "destruction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["destruction"], "contexts": ["process of elimination", "process of being eliminated"]}, {"entity_id": "destruction", "book_id": "kosmos_humboldt_1845", "name": "destruction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["destruction"], "contexts": ["the act of destroying"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "destruction", "target_book": "kosmos_humboldt_1845", "target_name": "destruction", "similarity": 1.0}], "id": 3390, "stable_key": "clu_68785cabc9e65d5c", "ground_truth": {"modern_name": "destruction", "confidence": "high", "type": "concept", "wikidata_id": "Q552431", "wikidata_description": "state when natural environment becomes unable to support its native species due to human activity"}}, {"canonical_name": "Milne Edwards", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "milne_edwards", "book_id": "origin_of_species_darwin_1859", "name": "Milne Edwards", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["Milne Edwards"], "contexts": ["elucidated physiological division of labour", "naturalist quoted on nature's variety"]}, {"entity_id": "milne-edwards", "book_id": "first_principles_spencer_1862", "name": "Milne-Edwards", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Milne-Edwards"], "contexts": ["described union of homogeneous parts in invertebrata"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Milne Edwards", "target_book": "first_principles_spencer_1862", "target_name": "Milne-Edwards", "similarity": 0.887}], "id": 3391, "stable_key": "clu_3d66298a6da26a39", "ground_truth": {"modern_name": "Henri Milne Edwards", "confidence": "high", "type": "person", "birth_year": 1800, "death_year": 1885, "description": "Zoologist who studied physiological division of labor.", "wikidata_id": "Q505173", "wikidata_description": "French zoologist (1800-1885)", "wikipedia_url": "https://en.wikipedia.org/wiki/Henri_Milne-Edwards", "wikipedia_extract": "Milne-Edwards's sifaka (Propithecus edwardsi), or Milne-Edwards's simpona, is a large arboreal, diurnal lemur endemic to the eastern coastal rainforest of Madagascar. Milne-Edwards's sifaka is characterized by a black body with a light-colored \"saddle\" on the lower part of its back. It is closely related to the diademed sifaka, and was until recently considered a subspecies of it. Like all sifakas, it is a primate in the family Indriidae. The species' name honors French zoologist Henri Milne-Edwards (1800\u20131885). Milne-Edwards's sifaka is categorized as endangered by the IUCN, and is listed in CITES Appendix I."}}, {"canonical_name": "pal\u00e6ontologists", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "pal\u00e6ontologists", "book_id": "origin_of_species_darwin_1859", "name": "pal\u00e6ontologists", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["pal\u00e6ontologists"], "contexts": ["experts in fossils", "scientists studying fossils"]}, {"entity_id": "pal\u00e6ontologists", "book_id": "first_principles_spencer_1862", "name": "pal\u00e6ontologists", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["pal\u00e6ontologists"], "contexts": ["scientists studying fossils"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "pal\u00e6ontologists", "target_book": "first_principles_spencer_1862", "target_name": "pal\u00e6ontologists", "similarity": 1.0}], "id": 3392, "stable_key": "clu_b9f52d228a920156", "ground_truth": {"modern_name": "Paleontologists", "confidence": "high", "type": "concept", "wikidata_id": "Q7205", "wikidata_description": "scientific study of the past of life on Earth through fossils", "wikipedia_url": "https://en.wikipedia.org/wiki/Paleontology", "wikipedia_extract": "Persons of National Historic Significance (National Historic People) (French: Personnes d'importance historique nationale (personnages historiques nationaux)) are people designated by the Canadian government as being nationally significant in the history of the country. Designations are made by the Minister of the Environment on the recommendation of the Historic Sites and Monuments Board of Canada. Approximately 70 nominations are submitted to the board each year. A person is eligible to be listed 25 years after death, but Prime Ministers may be designated any time after death. Parks Canada administers the program, and installs and maintains the federal plaques commonly erected to commemorate each person, usually placed at a site closely associated with them. The intent is generally to honour the person's contribution to the country but is always to educate the public about that person."}}, {"canonical_name": "arctic regions", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "arctic_regions", "book_id": "origin_of_species_darwin_1859", "name": "arctic regions", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["Arctic regions", "arctic regions"], "contexts": ["geographic area with harsh climate", "extreme northern geographical area"]}, {"entity_id": "arctic_regions", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Arctic regions", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Arctic regions"], "contexts": ["regions with polar navigators", "polar geographical area"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "arctic regions", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Arctic regions", "similarity": 0.968}], "id": 3393, "stable_key": "clu_8690a9b3c9e21de8-2", "ground_truth": {"modern_name": "Arctic", "confidence": "high", "type": "place", "country": "International", "wikidata_id": "Q213141", "wikidata_description": "species of mammal in the family Viverridae, native to South and Southeast Asia", "wikipedia_url": "https://en.wikipedia.org/wiki/Binturong", "wikipedia_extract": "The binturong (Arctictis binturong) (; bin-TURE-ong, BIN-ture-ong), also known as the bearcat, is a viverrid native to South and Southeast Asia. It is uncommon in much of its range, and has been assessed as Vulnerable on the IUCN Red List because of a declining population. It is estimated to have declined at least 30% since the mid-1980s. The binturong is the only species in the genus Arctictis. The name \"binturong\" is related to the words benturong and tenturun used in Riau. In the Western Malayo-Polynesian languages spoken in Borneo, the name is related to the root ma-tuRun."}}, {"canonical_name": "Melipona", "category": "ANIMAL", "subcategory": "INSECT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "melipona", "book_id": "origin_of_species_darwin_1859", "name": "Melipona", "category": "ANIMAL", "subcategory": "INSECT", "count": 4, "variants": ["Melipona"], "contexts": ["intermediate bee structure", "bee species that saves wax"]}, {"entity_id": "melipones", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Melipones", "category": "ANIMAL", "subcategory": "INSECT", "count": 2, "variants": ["Melipones"], "contexts": ["genus of bees", "bees producing wax in Mexico"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Melipona", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Melipones", "similarity": 0.894}], "id": 3394, "stable_key": "clu_3024961c168a3269", "ground_truth": {"modern_name": "Melipona bees", "confidence": "high", "type": "animal", "family": "Apidae", "description": "Stingless bees known for producing wax and honey in various regions.", "note": "'Melipona' is a genus of stingless bees. 'Melipona domestica' is a species within this genus.", "wikipedia_extract": "Melipona is a genus of stingless bees, widespread in warm areas of the Neotropics, from Sinaloa and Tamaulipas (M\u00e9xico) to Tucum\u00e1n and Misiones (Argentina). About 70 species are known. The largest producer of honey from Melipona bees in Mexico is in the state of Yucat\u00e1n where bees are studied at an interactive park called \"Bee Planet\" which is within the Cuxtal Ecological Reserve. Several species are kept for honey production, such as in Brazil, where some are well-known enough to have common names, including uru\u00e7u, manda\u00e7aia, janda\u00edra, and manduri. Melipona honey has long been used by humans and now is of minor commercial importance. Research is going on in improved beekeeping techniques."}}, {"canonical_name": "marine animals", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "marine_animals", "book_id": "origin_of_species_darwin_1859", "name": "marine animals", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 4, "variants": ["marine animals"], "contexts": ["animals living in the sea", "animals with analogous distribution facts"]}, {"entity_id": "marine_animals", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Marine animals", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Marine animals", "marine animals"], "contexts": ["creatures living in the sea", "specific localities of"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "marine animals", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Marine animals", "similarity": 0.985}], "id": 3395, "stable_key": "clu_64d7d0a2c803ae18", "ground_truth": {"modern_name": "marine animals", "confidence": "high", "type": "animal", "wikidata_id": "Q100989659", "wikidata_description": "marine animal that is a symbol of an organisation"}}, {"canonical_name": "eyelids", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "eyelids", "book_id": "origin_of_species_darwin_1859", "name": "eyelids", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["eyelids"], "contexts": ["part of pi