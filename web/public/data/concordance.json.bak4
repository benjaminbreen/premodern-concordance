al compound"}}, {"canonical_name": "action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "action", "book_id": "principles_of_psychology_james_1890", "name": "action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["action"], "contexts": ["the process of doing something", "the process of doing"]}, {"entity_id": "action", "book_id": "connexion_physical_sciences_somerville_1858", "name": "action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["action"], "contexts": ["initial confinement of storms"]}, {"entity_id": "action", "book_id": "first_principles_spencer_1862", "name": "action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["action"], "contexts": ["physical movement or deed", "the execution of a decision or impulse"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "action", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "action", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "action", "target_book": "first_principles_spencer_1862", "target_name": "action", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "action", "target_book": "first_principles_spencer_1862", "target_name": "action", "similarity": 1.0}], "id": 1544, "stable_key": "clu_6d2387e9d4561b8c", "ground_truth": {"modern_name": "action", "confidence": "high", "type": "concept", "wikidata_id": "Q2634111", "wikidata_description": "Dutch multinational variety store chain", "note": "Refers to deliberate actions or behaviors rather than just general acts."}}, {"canonical_name": "demon", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "demon", "book_id": "principles_of_psychology_james_1890", "name": "demon", "cate