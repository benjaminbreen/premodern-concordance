rce_name": "Ascension", "target_book": "kosmos_humboldt_1845", "target_name": "Ascension", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Ascension", "target_book": "kosmos_humboldt_1845", "target_name": "Ascension", "similarity": 1.0}], "id": 1896, "stable_key": "clu_2758d91ac7f76e1c", "ground_truth": {"modern_name": "Ascension Island", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q23653813", "wikidata_description": "island in Ays\u00e9n Region, Chile", "wikipedia_extract": "Two Boats, also known as Two Boats Village, is a village at the foot of Green Mountain on Ascension Island. Founded in the early 19th century, it was a originally a resting point for sailors who sought to ascend the mountain. Before the village's establishment, two boats had been stuck in the area, perpendicular to the ground to provide shade for passersby, giving the new settlement the inspiration for its name. It has the island's only school, Two Boats School. Two Boats is located at the foot of Green Mountain, the highest point of Ascension Island. It is one of five settlements on the island.", "wikipedia_url": "https://en.wikipedia.org/wiki/Two_Boats,_Ascension_Island"}}, {"canonical_name": "change", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "change", "book_id": "origin_of_species_darwin_1859", "name": "Change", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Change"], "contexts": ["alteration in form or nature"]}, {"entity_id": "change", "book_id": "principles_of_psychology_james_1890", "name": "change", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["change"], "contexts": ["alteration or transformation", "alteration in state or condition"]}, {"entity_id": "change", "book_id": "first_principles_spencer_1862", "name": "change", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["change"], "contexts": ["alteration in state or condition"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Change", "target_book": "principles_of_psychology_james_1890", "target_name": "change", "similarity": 0.984}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Change", "target_book": "first_principles_spencer_1862", "target_name": "change", "similarity": 0.984}, {"source_book": "principles_of_psychology_james_1890", "source_name": "change", "target_book": "first_principles_spencer_1862", "target_name": "change", "similarity": 1.0}], "id": 1897, "stable_key": "clu_d5c2b05b08067831", "ground_truth": {"modern_name": "change", "confidence": "high", "type": "concept", "wikidata_id": "Q1150070", "wikidata_description": "process, event or action that deviates from the present state", "wikipedia_url": "https://en.wikipedia.org/wiki/Change%20%28philosophy%29"}}, {"canonical_name": "orchidaceous plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "orchidaceous_plants", "book_id": "origin_of_species_darwin_1859", "name": "orchidaceous plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["orchidaceous plants"], "contexts": ["plants requiring moth visits for fertilization"]}, {"entity_id": "orchidean", "book_id": "origin_of_species_darwin_1859", "name": "Orchidean", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Orchidean"], "contexts": ["relating to orchids"]}, {"entity_id": "orchid\u00e9es", "book_id": "relation_historique_humboldt_vol3_1825", "name": "orchid\u00e9es", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["orchid\u00e9es"], "contexts": ["flowers found on tree trunks"]}, {"entity_id": "orchideae", "book_id": "kosmos_humboldt_1845", "name": "Orchideae", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Orchideae"], "contexts": ["orchid family of plants"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "orchidaceous plants", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "orchid\u00e9es", "similarity": 0.886}, {"source_book": "origin_of_species_darwin_1859", "source_name": "orchidaceous plants", "target_book": "kosmos_humboldt_1845", "target_name": "Orchideae", "similarity": 0.908}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Orchidean", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "orchid\u00e9es", "similarity": 0.952}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Orchidean", "target_book": "kosmos_humboldt_1845", "target_name": "Orchideae", "similarity": 0.967}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "orchid\u00e9es", "target_book": "kosmos_humboldt_1845", "target_name": "Orchideae", "similarity": 0.977}], "id": 1898, "stable_key": "clu_4b303473ea50650b", "ground_truth": {"modern_name": "orchids", "confidence": "high", "type": "plant", "linnaean": "Orchidaceae", "family": "Orchidaceae", "wikidata_id": "Q25308", "wikidata_description": "family of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Orchid", "wikipedia_extract": "Orchids are plants that belong to the family Orchidaceae (), a diverse and widespread group of flowering plants with blooms that are often colourful and fragrant. Orchids are cosmopolitan plants, living in diverse habitats on every continent except Antarctica. The world's richest diversity of orchid genera and species is in the tropics. Many species are epiphytes, living on trees. The flowers and their pollination mechanisms are highly specialized, attracting insect pollinators by colour, pattern, scent, pheromones, and sometimes by mimicking female insects. Orchids have very small seeds, relying on fungal partners for germination."}}, {"canonical_name": "crust of the Earth", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "crust_of_the_earth", "book_id": "origin_of_species_darwin_1859", "name": "crust of the earth", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["crust of the earth"], "contexts": ["outer layer of the planet"]}, {"entity_id": "crust_of_the_earth", "book_id": "kosmos_humboldt_1845", "name": "crust of the Earth", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["crust of the Earth"], "contexts": ["outer layer of the planet"]}, {"entity_id": "crust_of_the_earth", "book_id": "connexion_physical_sciences_somerville_1858", "name": "crust of the earth", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["crust of the earth"], "contexts": ["outer layer of the Earth"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "crust of the earth", "target_book": "kosmos_humboldt_1845", "target_name": "crust of the Earth", "similarity": 0.996}, {"source_book": "origin_of_species_darwin_1859", "source_name": "crust of the earth", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "crust of the earth", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "crust of the Earth", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "crust of the earth", "similarity": 0.996}], "id": 1899, "stable_key": "clu_9d264411fec96159-2", "ground_truth": {"modern_name": "Earth's crust", "confidence": "high", "type": "concept"}}, {"canonical_name": "new red sandstone", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "new_red_sandstone", "book_id": "origin_of_species_darwin_1859", "name": "new red sandstone", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["new red sandstone"], "contexts": ["geological formation containing fossils"]}, {"entity_id": "new_red_sandstone", "book_id": "relation_historique_humboldt_vol3_1825", "name": "new red sandstone", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["new red sandstone"], "contexts": ["new red sandstone"]}, {"entity_id": "red_sandstone", "book_id": "kosmos_humboldt_1845", "name": "red sandstone", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["red sandstone"], "contexts": ["geological rock formation"]}, {"entity_id": "new_red_sandstone", "book_id": "kosmos_humboldt_1845", "name": "new red sandstone", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["new red sandstone"], "contexts": ["rock type"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "new red sandstone", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "new red sandstone", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "new red sandstone", "target_book": "kosmos_humboldt_1845", "target_name": "red sandstone", "similarity": 0.908}, {"source_book": "origin_of_species_darwin_1859", "source_name": "new red sandstone", "target_book": "kosmos_humboldt_1845", "target_name": "new red sandstone", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "new red sandstone", "target_book": "kosmos_humboldt_1845", "target_name": "red sandstone", "similarity": 0.908}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "new red sandstone", "target_book": "kosmos_humboldt_1845", "target_name": "new red sandstone", "similarity": 1.0}], "id": 1900, "stable_key": "clu_235e67b677167484", "ground_truth": {"modern_name": "New Red Sandstone", "confidence": "high", "type": "mineral", "wikidata_id": "Q3249277", "wikidata_description": "geological formation in Great Britain laid down from the Permian and the Triassic, consisting mostly of reddish\u2013yellowish sandstones interbedded with evaporite minerals"}}, {"canonical_name": "ferns", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "ferns", "book_id": "origin_of_species_darwin_1859", "name": "ferns", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["ferns"], "contexts": ["plants included in numbers"]}, {"entity_id": "tree_ferns", "book_id": "kosmos_humboldt_1845", "name": "tree ferns", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["tree ferns"], "contexts": ["fern species with tree-like trunks"]}, {"entity_id": "ferns", "book_id": "connexion_physical_sciences_somerville_1858", "name": "ferns", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["ferns"], "contexts": ["plants in the Cryptogamia class", "plants in the class Cryptogamia"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "ferns", "target_book": "kosmos_humboldt_1845", "target_name": "tree ferns", "similarity": 0.961}, {"source_book": "origin_of_species_darwin_1859", "source_name": "ferns", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "ferns", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "tree ferns", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "ferns", "similarity": 0.961}], "id": 1901, "stable_key": "clu_a4206dcdd2990938", "ground_truth": {"modern_name": "Ferns", "confidence": "high", "type": "plant", "family": "Polypodiopsida", "wikidata_id": "Q143628", "wikidata_description": "genus of plants"}}, {"canonical_name": "size", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "size", "book_id": "origin_of_species_darwin_1859", "name": "size", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["size"], "contexts": ["physical dimensions of islands"]}, {"entity_id": "size", "book_id": "principles_of_psychology_james_1890", "name": "size", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["size"], "contexts": ["magnitude of an object", "normal dimension of an object"]}, {"entity_id": "size", "book_id": "kosmos_humboldt_1845", "name": "size", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["size"], "contexts": ["magnitude of celestial bodies"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "size", "target_book": "principles_of_psychology_james_1890", "target_name": "size", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "size", "target_book": "kosmos_humboldt_1845", "target_name": "size", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "size", "target_book": "kosmos_humboldt_1845", "target_name": "size", "similarity": 1.0}], "id": 1902, "stable_key": "clu_cb9e04466b1c9381", "ground_truth": {"modern_name": "Size", "confidence": "high", "type": "concept", "wikidata_id": "Q322481", "wikidata_description": "magnitude or dimension of a thing; concept abstracted from the process of measuring by comparing a longer to a shorter or vice versa"}}, {"canonical_name": "ox", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "ox", "book_id": "origin_of_species_darwin_1859", "name": "ox", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["ox"], "contexts": ["animal with leg bone homologies"]}, {"entity_id": "ox", "book_id": "kosmos_humboldt_1845", "name": "ox", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["ox"], "contexts": ["extant animal found as fossil"]}, {"entity_id": "ox", "book_id": "first_principles_spencer_1862", "name": "ox", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["ox"], "contexts": ["domesticated bovine animal", "animal with fused bone cylinders"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "ox", "target_book": "kosmos_humboldt_1845", "target_name": "ox", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "ox", "target_book": "first_principles_spencer_1862", "target_name": "ox", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "ox", "target_book": "first_principles_spencer_1862", "target_name": "ox", "similarity": 1.0}], "id": 1903, "stable_key": "clu_8b2ca8b66163877b", "ground_truth": {"wikipedia_extract": "An ox (pl.: oxen), also known as a bullock (in British, Australian, and Indian English), is a large bovine, trained and used as a draft animal. Oxen are commonly castrated adult male cattle, because castration inhibits testosterone and aggression, which makes the males docile and safer to work with. Cows (intact females) or bulls (intact males) may also be used in some areas. Oxen are used for ploughing, for transport (pulling carts, hauling wagons and even riding), for threshing grain by trampling, and for powering machines that grind grain or supply irrigation among other purposes. Oxen may be also used to skid logs in forests, particularly in low-impact, select-cut logging. Oxen are usually yoked in pairs."}}, {"canonical_name": "cold climates", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "cold_climates", "book_id": "origin_of_species_darwin_1859", "name": "cold climates", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["cold climates"], "contexts": ["thicker fur in"]}, {"entity_id": "cold_regions_of_the_atmosphere", "book_id": "connexion_physical_sciences_somerville_1858", "name": "cold regions of the atmosphere", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["cold regions of the atmosphere"], "contexts": ["where invisible vapour is condensed"]}, {"entity_id": "torrid_climates", "book_id": "first_principles_spencer_1862", "name": "torrid climates", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["torrid climates"], "contexts": ["climate where life decreases"]}, {"entity_id": "frigid_climates", "book_id": "first_principles_spencer_1862", "name": "frigid climates", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["frigid climates"], "contexts": ["climate where life decreases"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "cold climates", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "cold regions of the atmosphere", "similarity": 0.898}, {"source_book": "origin_of_species_darwin_1859", "source_name": "cold climates", "target_book": "first_principles_spencer_1862", "target_name": "torrid climates", "similarity": 0.902}, {"source_book": "origin_of_species_darwin_1859", "source_name": "cold climates", "target_book": "first_principles_spencer_1862", "target_name": "frigid climates", "similarity": 0.986}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "cold regions of the atmosphere", "target_book": "first_principles_spencer_1862", "target_name": "frigid climates", "similarity": 0.888}], "id": 1904, "stable_key": "clu_98f9d964f1bc21eb", "ground_truth": {"modern_name": "Climate zones", "confidence": "high", "type": "place", "note": "This cluster encompasses a range of climate descriptions, including cold, torrid, and frigid, as well as atmospheric regions where condensation occurs. 'Climate zones' is the most appropriate modern concept.", "wikidata_id": "Q58330355", "wikidata_description": "scholarly article"}}, {"canonical_name": "peonia", "category": "PLANT", "subcategory": "HERB", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "peonia", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "peonia", "category": "PLANT", "subcategory": "HERB", "count": 2, "variants": ["peonia"], "contexts": ["root similar to peony root", "herb with a specific odor"]}, {"entity_id": "peonia", "book_id": "historia_medicinal_monardes_1574", "name": "Peonia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Peonia"], "contexts": ["plant whose seed is used for comparison"]}, {"entity_id": "peonia", "book_id": "ricettario_fiorentino_1597", "name": "Peonia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Peonia"], "contexts": ["ingredient in a preparation"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "peonia", "target_book": "historia_medicinal_monardes_1574", "target_name": "Peonia", "similarity": 0.806}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "peonia", "target_book": "ricettario_fiorentino_1597", "target_name": "Peonia", "similarity": 0.806}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Peonia", "target_book": "ricettario_fiorentino_1597", "target_name": "Peonia", "similarity": 1.0}], "id": 1905, "stable_key": "clu_0be15bbfdf5b085b", "ground_truth": {"modern_name": "Peony", "confidence": "high", "type": "plant", "linnaean": "Paeonia lactiflora", "family": "Paeoniaceae", "note": "The Linnaean binomial is an educated guess as multiple species of Paeonia exist, and early modern texts often referred to the genus broadly. However, Paeonia lactiflora is a well-known medicinal peony.", "wikidata_id": "Q147105", "wikidata_description": "genus of flowering plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Peony", "wikipedia_extract": "The peony or paeony () is any flowering plant in the genus Paeonia, the only genus in the family Paeoniaceae. Peonies are native to Asia, Europe, and Western North America. Scientists differ on the number of species that can be distinguished, ranging from 25 to 40, although the current consensus describes 33 known species. The relationships between the species need to be further clarified. Most are herbaceous perennial plants 0.25\u20131 metre (1\u20133 ft) tall, but some are woody shrubs 0.25\u20133.5 metres (1\u201311 ft) tall. They have compound, deeply lobed leaves and large, often fragrant flowers, in colors ranging from purple and pink to red, white or yellow, in late spring and early summer."}}, {"canonical_name": "enfermidades velhas", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "enfermedades_viejas_y_reueldes", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "enfermedades viejas y reueldes", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["enfermedades viejas y reueldes"], "contexts": ["old and rebellious diseases"]}, {"entity_id": "enfermidades_velhas", "book_id": "coloquios_da_orta_1563", "name": "enfermidades velhas", "category": "DISEASE", "subcategory": "CHRONIC", "count": 2, "variants": ["enfermidades velhas", "doen\u00e7as velhas"], "contexts": ["old illnesses treated with the stone", "old diseases, chronic conditions"]}, {"entity_id": "doen\u00e7as_velhas", "book_id": "polyanthea_medicinal", "name": "doen\u00e7as velhas", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["doen\u00e7as velhas"], "contexts": ["chronic illnesses"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "enfermedades viejas y reueldes", "target_book": "coloquios_da_orta_1563", "target_name": "enfermidades velhas", "similarity": 0.952}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "enfermedades viejas y reueldes", "target_book": "polyanthea_medicinal", "target_name": "doen\u00e7as velhas", "similarity": 0.944}, {"source_book": "coloquios_da_orta_1563", "source_name": "enfermidades velhas", "target_book": "polyanthea_medicinal", "target_name": "doen\u00e7as velhas", "similarity": 0.993}], "id": 1906, "stable_key": "clu_b08a9d59cb8506c2-2", "ground_truth": {"modern_name": "Chronic diseases", "confidence": "high", "type": "disease", "modern_term": "Chronic diseases", "wikidata_id": "Q383126", "wikidata_description": "human health condition or disease that is persistent or otherwise long-lasting in its effects"}}, {"canonical_name": "fuentes", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "fuente", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "fuente", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["fuente"], "contexts": ["or spring water"]}, {"entity_id": "fuentes", "book_id": "historia_medicinal_monardes_1574", "name": "fuentes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["fuentes"], "contexts": ["fountains created with artifice", "springs, sources of water"]}, {"entity_id": "sources", "book_id": "connexion_physical_sciences_somerville_1858", "name": "sources", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["sources"], "contexts": ["origin points of rivers"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "fuente", "target_book": "historia_medicinal_monardes_1574", "target_name": "fuentes", "similarity": 0.95}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "fuente", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sources", "similarity": 0.94}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "fuentes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sources", "similarity": 0.979}], "id": 1907, "stable_key": "clu_ded853f50da531aa-2", "ground_truth": {"modern_name": "Spring", "confidence": "high", "type": "place", "description": "A source of water, often from underground.", "note": "Encompasses natural water sources and the concept of a source.", "wikipedia_extract": "Geography (from Ancient Greek \u03b3\u03b5\u03c9\u03b3\u03c1\u03b1\u03c6\u03af\u03b1 ge\u014dgraph\u00eda; combining g\u00ea 'Earth' and gr\u00e1ph\u014d 'write', literally 'Earth writing') is the study of the lands, features, inhabitants, and phenomena of Earth. Geography is an all-encompassing discipline that seeks an understanding of Earth and its human and natural complexities\u2014not merely where objects are, but also how they have changed and come to be. While geography is specific to Earth, many concepts can be applied more broadly to other celestial bodies in the field of planetary science. Geography has been called \"a bridge between natural science and social science disciplines.\" The history of geography as a discipline spans cultures and millennia, being independently developed by multiple groups, and cross-pollinated by trade between these groups. Geography as a discipline dates back to the earliest attempts to understand the world spatially, with the earliest example of an attempted world map dating to the 9th century BC in ancient Babylon. Origins of many of the concepts in geography can be traced to Greek Eratosthenes of Cyrene, who may have coined the term \"geographia\" (c.\u2009276 BC \u2013 c.\u2009195/194 BC)."}}, {"canonical_name": "Bolarmen\u00edco", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "boloarmeuico", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "boloarmeuico", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["boloarmeuico"], "contexts": ["material found in abundance"]}, {"entity_id": "bolarmen\u00edco", "book_id": "historia_medicinal_monardes_1574", "name": "Bolarmen\u00edco", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Bolarmen\u00edco", "Bolarmenico"], "contexts": ["earth substance, Terra lemn\u00eda", "prepared substance, likely arsenic"]}, {"entity_id": "bolarmenico", "book_id": "coloquios_da_orta_1563", "name": "bolarmenico", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["bolarmenico"], "contexts": ["earth used for comparison"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "boloarmeuico", "target_book": "historia_medicinal_monardes_1574", "target_name": "Bolarmen\u00edco", "similarity": 0.887}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Bolarmen\u00edco", "target_book": "coloquios_da_orta_1563", "target_name": "bolarmenico", "similarity": 0.946}], "id": 1908, "stable_key": "clu_4aa22359dc944442", "ground_truth": {"modern_name": "bolarm\u00e9nico", "confidence": "high", "type": "mineral", "note": "A terrestrial substance, likely a type of ochre or Bole, used medicinally. Related to Terra Lemnia."}}, {"canonical_name": "superstitions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "supersticiones", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "supersticiones", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["supersticiones"], "contexts": ["superstitions"]}, {"entity_id": "superstitions", "book_id": "principles_of_psychology_james_1890", "name": "superstitions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["superstitions"], "contexts": ["irrational beliefs"]}, {"entity_id": "superstitions", "book_id": "first_principles_spencer_1862", "name": "superstitions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["superstitions"], "contexts": ["beliefs not based on reason or knowledge", "irrational beliefs"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "supersticiones", "target_book": "principles_of_psychology_james_1890", "target_name": "superstitions", "similarity": 0.996}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "supersticiones", "target_book": "first_principles_spencer_1862", "target_name": "superstitions", "similarity": 0.996}, {"source_book": "principles_of_psychology_james_1890", "source_name": "superstitions", "target_book": "first_principles_spencer_1862", "target_name": "superstitions", "similarity": 1.0}], "id": 1909, "stable_key": "clu_73ebd8033e52f89b-2", "ground_truth": {"modern_name": "Superstition", "confidence": "high", "type": "concept", "wikidata_id": "Q133182", "wikidata_description": "belief in irrational supernatural causality", "wikipedia_url": "https://en.wikipedia.org/wiki/Superstition", "wikipedia_extract": "A superstition is any belief or practice considered by non-practitioners to be irrational or supernatural. It is commonly applied to beliefs and practices surrounding luck, fate, magic, amulets, astrology, fortune telling, spirits, and certain paranormal entities, particularly the belief that future events can be foretold by specific unrelated prior events. The word superstition is also used to refer to a religion not practiced by the majority of a given society regardless of whether the prevailing religion contains alleged superstitions or to all religions by the antireligious. Definitions of the term vary, but superstitions are commonly described as irrational beliefs at odds with scientific knowledge of the world. Stuart Vyse proposes that a superstition's \"presumed mechanism of action is inconsistent with our understanding of the physical world\", with Jane Risen adding that these beliefs are not merely scientifically wrong but impossible. Similarly, Lysann Damisch defines superstition as \"irrational  beliefs that an object, action, or circumstance that is not logically related to a course of events influences its outcome.\" Dale Martin says that superstitions \"presuppose an erroneous understanding about cause and effect, that have been rejected by modern science.\" The Oxford English Dictionary describes them as \"irrational, unfounded\", Merriam-Webster as \"a false conception about causation or belief or practice\", and the Cambridge Dictionary as \"sans grounding in human reason or scientific knowledge\"."}}, {"canonical_name": "mer int\u00e9rieure", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "mer_int\u00e9rieure", "book_id": "relation_historique_humboldt_vol3_1825", "name": "mer int\u00e9rieure", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["mer int\u00e9rieure", "mers int\u00e9rieures"], "contexts": ["sea with multiple outlets", "inland bodies of water"]}, {"entity_id": "inland_seas", "book_id": "kosmos_humboldt_1845", "name": "inland seas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["inland seas"], "contexts": ["large bodies of water within land"]}, {"entity_id": "internal_seas", "book_id": "connexion_physical_sciences_somerville_1858", "name": "internal seas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["internal seas"], "contexts": ["separates botanical districts"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "mer int\u00e9rieure", "target_book": "kosmos_humboldt_1845", "target_name": "inland seas", "similarity": 0.931}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "mer int\u00e9rieure", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "internal seas", "similarity": 0.942}, {"source_book": "kosmos_humboldt_1845", "source_name": "inland seas", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "internal seas", "similarity": 0.942}], "id": 1910, "stable_key": "clu_f2616d716ed568dd", "ground_truth": {"modern_name": "Inland seas", "confidence": "high", "type": "place", "wikidata_id": "Q231312", "wikidata_description": "Interisland Sea in the Pacific Ocean", "wikipedia_url": "https://en.wikipedia.org/wiki/Seto%20Inland%20Sea", "wikipedia_extract": "The Seto Inland Sea (\u702c\u6238\u5185\u6d77, Seto Naikai),    sometimes shortened to the Inland Sea, is the body of water separating Honshu, Shikoku, and Kyushu, three of the four main islands of Japan. It serves as a waterway connecting the Pacific Ocean to the Sea of Japan. It connects to Osaka Bay and provides a sea transport link to industrial centers in the Kansai region, including Osaka and Kobe. Before the construction of the San'y\u014d Main Line, it was the main transportation link between Kansai and Ky\u016bsh\u016b. Yamaguchi, Hiroshima, Okayama, Hy\u014dgo, Osaka, Wakayama, Kagawa, Ehime, Tokushima, Fukuoka, and \u014cita prefectures have coastlines on the Seto Inland Sea; the cities of Hiroshima, Iwakuni, Takamatsu, and Matsuyama are also located on it. The Setouchi region encompasses the sea and surrounding coastal areas."}}, {"canonical_name": "intensit\u00e9s", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "intensit\u00e9s", "book_id": "relation_historique_humboldt_vol3_1825", "name": "intensit\u00e9s", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["intensit\u00e9s", "INTESIT\u00c9"], "contexts": ["magnetic intensity", "intensity"]}, {"entity_id": "intensities", "book_id": "principles_of_psychology_james_1890", "name": "intensities", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["intensities"], "contexts": ["degrees of strength or magnitude"]}, {"entity_id": "intensities", "book_id": "first_principles_spencer_1862", "name": "intensities", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["intensities"], "contexts": ["levels of strength or magnitude"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "intensit\u00e9s", "target_book": "principles_of_psychology_james_1890", "target_name": "intensities", "similarity": 0.992}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "intensit\u00e9s", "target_book": "first_principles_spencer_1862", "target_name": "intensities", "similarity": 0.992}, {"source_book": "principles_of_psychology_james_1890", "source_name": "intensities", "target_book": "first_principles_spencer_1862", "target_name": "intensities", "similarity": 1.0}], "id": 1911, "stable_key": "clu_5c48ff711904eab5-2", "ground_truth": {"modern_name": "intensity", "confidence": "high", "type": "concept", "wikidata_id": "Q1061524", "wikidata_description": "power transferred per unit area, where the area is measured on the plane perpendicular to the direction of propagation of the energy", "note": "The contexts clearly point to the general concept of intensity or degree of strength."}}, {"canonical_name": "t.", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "t_", "book_id": "relation_historique_humboldt_vol3_1825", "name": "t.", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["t."], "contexts": ["unit of measurement abbreviation"]}, {"entity_id": "p_", "book_id": "polyanthea_medicinal", "name": "p.", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["p."], "contexts": ["page"]}, {"entity_id": "t_t", "book_id": "connexion_physical_sciences_somerville_1858", "name": "T t", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["T t"], "contexts": ["tangent line to the ellipse at point m"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "t.", "target_book": "polyanthea_medicinal", "target_name": "p.", "similarity": 0.916}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "t.", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "T t", "similarity": 0.958}], "id": 1912, "stable_key": "clu_0489df64c36c222a", "ground_truth": {"modern_name": "units of measurement", "confidence": "medium", "type": "concept", "note": "The abbreviation 't.' is ambiguous and could refer to various units of measurement, a typographical error, or 'tangent' in a mathematical context. Without further context from the specific texts, a definitive identification is difficult. 'T t' likely refers to 'tangent tangent' or similar mathematical notation. 'p.' is also ambiguous, potentially 'page' or a specific quantity.", "wikidata_id": "Q47574", "wikidata_description": "real scalar quantity, defined and adopted by convention, with which any other quantity of the same kind can be compared to express the ratio of the two quantities as a number (VIM)", "wikipedia_url": "https://en.wikipedia.org/wiki/Unit%20of%20measurement"}}, {"canonical_name": "Turin", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "turin", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Turin", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Turin"], "contexts": ["location of observation", "city in Italy"]}, {"entity_id": "turin", "book_id": "kosmos_humboldt_1845", "name": "Turin", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Turin"], "contexts": ["city in Italy"]}, {"entity_id": "turin", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Turin", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Turin"], "contexts": ["location of M. Botto's experiments"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Turin", "target_book": "kosmos_humboldt_1845", "target_name": "Turin", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Turin", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Turin", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Turin", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Turin", "similarity": 1.0}], "id": 1913, "stable_key": "clu_fd497e8a05e4538a", "ground_truth": {"modern_name": "Turin", "confidence": "high", "type": "place", "country": "Italy", "wikidata_id": "Q495", "wikidata_description": "city and commune in Italy", "wikipedia_url": "https://en.wikipedia.org/wiki/Turin", "wikipedia_extract": "Turin is a city and an important business and cultural centre in northern Italy. It is the capital city of the Piedmont region and of the Metropolitan City of Turin. From 1861 to 1865, it was the first capital of the Kingdom of Italy. The city is mainly on the western bank of the River Po, below its Susa Valley, and is surrounded by the western Alpine arch and Superga hill. The population of the city proper is 853,196 as of 2025, while the population of the urban area is estimated by Eurostat to be 1.7 million inhabitants. The Turin metropolitan area is estimated by the OECD to have a population of 2.2 million."}}, {"canonical_name": "indiana", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "indiana", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Indiana", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Indiana"], "contexts": ["state north of the Obio river"]}, {"entity_id": "indiana", "book_id": "historia_medicinal_monardes_1574", "name": "Indiana", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Indiana"], "contexts": ["origin of a seed"]}, {"entity_id": "indiana", "book_id": "coloquios_da_orta_1563", "name": "indiana", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["indiana"], "contexts": ["referring to Indian medicine", "people who use a corrupted name for the stone"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Indiana", "target_book": "historia_medicinal_monardes_1574", "target_name": "Indiana", "similarity": 0.844}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Indiana", "target_book": "coloquios_da_orta_1563", "target_name": "indiana", "similarity": 0.714}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Indiana", "target_book": "coloquios_da_orta_1563", "target_name": "indiana", "similarity": 0.912}], "id": 1914, "stable_key": "clu_3b1f5efc22628429-3", "ground_truth": {"modern_name": "India", "confidence": "high", "type": "place", "country": "India", "note": "Hindostan is an older Persian name for the Indian subcontinent.", "wikidata_id": "Q668", "wikidata_description": "country in South Asia", "wikipedia_url": "https://en.wikipedia.org/wiki/India", "wikipedia_extract": "India, officially the Republic of India, is a country in South Asia. It is the seventh-largest country by area; the most populous country since 2023; and, since its independence in 1947, the world's most populous democracy. Bounded by the Indian Ocean on the south, the Arabian Sea on the southwest, and the Bay of Bengal on the southeast, it shares land borders with Pakistan to the west; China, Nepal, and Bhutan to the north; and Bangladesh and Myanmar to the east. In the Indian Ocean, India is near Sri Lanka and the Maldives; its Andaman and Nicobar Islands share a maritime border with Myanmar, Thailand, and Indonesia. Modern humans arrived on the Indian subcontinent from Africa no later than 55,000 years ago. Their long occupation, predominantly in isolation as hunter-gatherers, has made the region highly diverse."}}, {"canonical_name": "Moorcroft", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "moorcroft", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Moorcroft", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Moorcroft"], "contexts": ["measurer of mountain heights"]}, {"entity_id": "moorcroft", "book_id": "kosmos_humboldt_1845", "name": "Moorcroft", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Moorcroft"], "contexts": ["provided data on mountain elevations"]}, {"entity_id": "moorcroft", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Moorcroft", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Moorcroft"], "contexts": ["collected herbarium in Chinese Tartary", "collected a herbarium"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Moorcroft", "target_book": "kosmos_humboldt_1845", "target_name": "Moorcroft", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Moorcroft", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Moorcroft", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Moorcroft", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Moorcroft", "similarity": 1.0}], "id": 1915, "stable_key": "clu_d1c90199556392ee", "ground_truth": {"modern_name": "William Moorcroft", "confidence": "high", "type": "person", "birth_year": 1765, "death_year": 1825, "description": "British physician, veterinary surgeon, and explorer in India", "wikidata_id": "Q8015764", "wikidata_description": "British potter (1872\u20131945)", "wikipedia_url": "https://en.wikipedia.org/wiki/William_Moorcroft_%28potter%29", "wikipedia_extract": "The following is a list of notable deaths in January 2026. Entries for each day are listed alphabetically by surname. A typical entry lists information in the following sequence: Name, age, country of citizenship at birth, subsequent country of citizenship (if applicable), reason for notability, cause of death (if known), and reference. Stuart Altman, 88, American economist. Marat Amankulov, 55, Kyrgyz politician, MP (2015\u20132021). Yvan Aumont, 87, French engineer and journalist (Lys rouge)."}}, {"canonical_name": "Nepaul", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "nepaul", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Nepaul", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Nepaul"], "contexts": ["plateau region for observations"]}, {"entity_id": "nepaul", "book_id": "kosmos_humboldt_1845", "name": "Nepaul", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Nepaul"], "contexts": ["region in the Himalaya"]}, {"entity_id": "nepaul", "book_id": "coloquios_da_orta_1563", "name": "Nepaul", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Nepaul"], "contexts": ["region near Khasya mountains"]}, {"entity_id": "ne_paul", "book_id": "coloquios_da_orta_1563", "name": "Ne paul", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Ne paul"], "contexts": ["region between India and China"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Nepaul", "target_book": "kosmos_humboldt_1845", "target_name": "Nepaul", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Nepaul", "target_book": "coloquios_da_orta_1563", "target_name": "Nepaul", "similarity": 0.911}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Nepaul", "target_book": "coloquios_da_orta_1563", "target_name": "Ne paul", "similarity": 0.596}, {"source_book": "kosmos_humboldt_1845", "source_name": "Nepaul", "target_book": "coloquios_da_orta_1563", "target_name": "Nepaul", "similarity": 0.911}, {"source_book": "kosmos_humboldt_1845", "source_name": "Nepaul", "target_book": "coloquios_da_orta_1563", "target_name": "Ne paul", "similarity": 0.596}], "id": 1916, "stable_key": "clu_1fd54532195c74f1", "ground_truth": {"modern_name": "Nepal", "confidence": "high", "type": "place", "country": "Nepal", "wikipedia_extract": "Kathmandu (Nepali: [\u02c8ka\u0288\u02b0ma\u0273\u0256u]) is the capital and largest city of Nepal, situated in the central part of the country within the Kathmandu Valley. As per the 2021 Nepal census, it has a population of 845,767 residing in 105,649 households, with approximately 4 million people in the surrounding metropolitan area. The city stands at an elevation of 1,324 metres (4,344 ft) above sea level. Recognized as one of the oldest continuously inhabited places in the world, Kathmandu's history dates back to the 2nd century AD. Historically known as the Nepal Mandala, the valley has been the cultural and political hub for the Newar people, a significant urban civilization in the Himalayan region. Kathmandu served as the royal capital of the Kingdom of Nepal and is home to numerous palaces, temples, and gardens reflecting its rich heritage.", "wikipedia_url": "https://en.wikipedia.org/wiki/Kathmandu"}}, {"canonical_name": "Daubuisson", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "daubuisson", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Daubuisson", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Daubuisson"], "contexts": ["author in 'Journ. de phys.'"]}, {"entity_id": "d'aubuisson", "book_id": "kosmos_humboldt_1845", "name": "D'Aubuisson", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["D'Aubuisson"], "contexts": ["scientist publishing in Journal de Physique"]}, {"entity_id": "daubuisson", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Daubuisson", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Daubuisson"], "contexts": ["observed mine temperatures", "made observations in mines"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Daubuisson", "target_book": "kosmos_humboldt_1845", "target_name": "D'Aubuisson", "similarity": 0.811}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Daubuisson", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Daubuisson", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "D'Aubuisson", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Daubuisson", "similarity": 0.811}], "id": 1917, "stable_key": "clu_5996ec03c2e6909a", "ground_truth": {"modern_name": "Jean-Fran\u00e7ois d'Aubuisson", "confidence": "high", "type": "person", "birth_year": 1771, "death_year": 1841, "description": "French geologist and mining engineer, known for earth temperature studies.", "wikidata_id": "Q1303613", "wikidata_description": "French engineer", "wikipedia_url": "https://en.wikipedia.org/wiki/Jean-Fran%C3%A7ois%20d%27Aubuisson%20de%20Voisins", "wikipedia_extract": "Jean-Fran\u00e7ois d\u2019Aubuisson de Voisins (19 April 1769 \u2013 20 August 1841) was a French geologist and mining engineer who also contributed studies in hydrodynamics and hydrology. D'Aubuisson was born in Toulouse, the son of a namesake squire and his wife Jeanne-Francoise Dassi\u00e9. His early education was at the Benedictine College of Sor\u00e9ze from 1779. He moved to the Artillery School, Metz in 1786 and joined military service in 1791, serving six years in Spain. After the war he retired to Freiberg where he taught mathematics and simultaneously studied at the Bergakademie under Abraham Gottlob Werner. He translated Werner's work into French with annotations."}}, {"canonical_name": "M. Biot", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "mm__biot", "book_id": "relation_historique_humboldt_vol3_1825", "name": "MM. Biot", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["MM. Biot"], "contexts": ["noticed magnetic force differences"]}, {"entity_id": "m__biot", "book_id": "kosmos_humboldt_1845", "name": "M. Biot", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["M. Biot"], "contexts": ["contributed mathematical portion of memoir", "contributed to scientific facts"]}, {"entity_id": "biot,_m_", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Biot, M.", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Biot, M."], "contexts": ["balloon ascent, sound transmission, polarization"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "MM. Biot", "target_book": "kosmos_humboldt_1845", "target_name": "M. Biot", "similarity": 0.915}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "MM. Biot", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Biot, M.", "similarity": 0.889}, {"source_book": "kosmos_humboldt_1845", "source_name": "M. Biot", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Biot, M.", "similarity": 0.932}], "id": 1918, "stable_key": "clu_faf7e98415c2d8ff-2", "ground_truth": {"modern_name": "Jean-Baptiste Biot", "confidence": "high", "type": "person", "birth_year": 1774, "death_year": 1862, "description": "French physicist, astronomer, and mathematician. Investigated polarization and magnetic equator.", "wikidata_id": "Q58328", "wikidata_description": "French scientist (1774-1862)", "wikipedia_url": "https://en.wikipedia.org/wiki/Jean-Baptiste%20Biot", "wikipedia_extract": "Jean-Baptiste Biot (; French: [\u0292\u0251\u0303 batist bjo]; 21 April 1774 \u2013 3 February 1862) was a French physicist, astronomer, and mathematician who co-discovered the Biot\u2013Savart law of magnetostatics with F\u00e9lix Savart, established the reality of meteorites, made an early balloon flight, and studied the polarization of light. The biot (a CGS unit of electrical current), the mineral biotite, and Cape Biot in eastern Greenland were named in his honour. Jean-Baptiste Biot was born in Paris on 21 April 1774 the son of Joseph Biot, a treasury official. He was educated at Lyceum Louis-le-Grand and \u00c9cole Polytechnique in 1794. Biot served in the artillery before he was appointed professor of mathematics at Beauvais in 1797. He later went on to become a professor of physics at the Coll\u00e8ge de France around 1800, and three years later was elected as a member of the French Academy of Sciences."}}, {"canonical_name": "tropic of Cancer", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "tropique_du_cancer", "book_id": "relation_historique_humboldt_vol3_1825", "name": "tropique du Cancer", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["tropique du Cancer"], "contexts": ["northern limit for sugar production mentioned"]}, {"entity_id": "tropic_of_cancer", "book_id": "kosmos_humboldt_1845", "name": "tropic of Cancer", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["tropic of Cancer"], "contexts": ["latitude line in the Northern Hemisphere"]}, {"entity_id": "tropic_of_cancer", "book_id": "connexion_physical_sciences_somerville_1858", "name": "tropic of Cancer", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["tropic of Cancer"], "contexts": ["northernmost latitude where sun is directly overhead", "limit of trade-winds north of equator"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "tropique du Cancer", "target_book": "kosmos_humboldt_1845", "target_name": "tropic of Cancer", "similarity": 0.971}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "tropique du Cancer", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "tropic of Cancer", "similarity": 0.971}, {"source_book": "kosmos_humboldt_1845", "source_name": "tropic of Cancer", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "tropic of Cancer", "similarity": 1.0}], "id": 1919, "stable_key": "clu_ccceef0aa71f3a85", "ground_truth": {"modern_name": "Tropic of Cancer", "confidence": "high", "type": "place", "country": "Global", "wikidata_id": "Q176635", "wikidata_description": "line of northernmost latitude at which the Sun can be directly overhead", "wikipedia_url": "https://en.wikipedia.org/wiki/Tropic%20of%20Cancer", "wikipedia_extract": "The Tropic of Cancer, also known as the Northern Tropic, is the Earth's northernmost circle of latitude where the Sun can be seen directly overhead. This occurs on the June solstice, when the Northern Hemisphere is tilted toward the Sun to its maximum extent. It also reaches 90 degrees below the horizon at solar midnight on the December solstice. Using a continuously updated formula, the circle is currently 23\u00b026\u203209.2\u2033 (or 23.4359\u00b0) north of the Equator. Its Southern Hemisphere counterpart, marking the most southerly position at which the Sun can be seen directly overhead, is the Tropic of Capricorn. These tropics are two of the seven major circles of latitude that mark maps of Earth, the others being the Arctic and Antarctic circles, the Equator, and the Poles (which are degenerate circles)."}}, {"canonical_name": "chimie v\u00e9g\u00e9tale", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "chimie_v\u00e9g\u00e9tale", "book_id": "relation_historique_humboldt_vol3_1825", "name": "chimie v\u00e9g\u00e9tale", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["chimie v\u00e9g\u00e9tale"], "contexts": ["field of chemistry concerning plants"]}, {"entity_id": "organische_chemie", "book_id": "kosmos_humboldt_1845", "name": "Organische Chemie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Organische Chemie"], "contexts": ["scientific publication"]}, {"entity_id": "organic_chemistry", "book_id": "kosmos_humboldt_1845", "name": "organic chemistry", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["organic chemistry"], "contexts": ["chemistry of carbon compounds"]}, {"entity_id": "organic_chemistry", "book_id": "first_principles_spencer_1862", "name": "organic chemistry", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["organic chemistry"], "contexts": ["facts supporting derivation of vital forces"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "chimie v\u00e9g\u00e9tale", "target_book": "kosmos_humboldt_1845", "target_name": "Organische Chemie", "similarity": 0.903}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "chimie v\u00e9g\u00e9tale", "target_book": "kosmos_humboldt_1845", "target_name": "organic chemistry", "similarity": 0.905}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "chimie v\u00e9g\u00e9tale", "target_book": "first_principles_spencer_1862", "target_name": "organic chemistry", "similarity": 0.905}, {"source_book": "kosmos_humboldt_1845", "source_name": "Organische Chemie", "target_book": "first_principles_spencer_1862", "target_name": "organic chemistry", "similarity": 0.96}, {"source_book": "kosmos_humboldt_1845", "source_name": "organic chemistry", "target_book": "first_principles_spencer_1862", "target_name": "organic chemistry", "similarity": 1.0}], "id": 1920, "stable_key": "clu_8746a6cd9513dd10", "ground_truth": {"modern_name": "organic chemistry", "confidence": "high", "type": "concept", "note": "The early modern German term 'Organische Chemie' directly translates to 'organic chemistry', and the French 'chimie v\u00e9g\u00e9tale' refers to the chemistry of plants, which is a historical precursor and part of organic chemistry.", "wikidata_id": "Q11351", "wikidata_description": "subdiscipline within chemistry involving the scientific study of carbon-based compounds, hydrocarbons, and their derivatives", "wikipedia_url": "https://en.wikipedia.org/wiki/Organic%20chemistry", "wikipedia_extract": "Organic chemistry is a subdiscipline within chemistry involving the scientific study of the structure, properties, and reactions of organic compounds and organic materials, i.e., matter in its various forms that contain carbon atoms. Study of structure determines their structural formula. Study of properties includes physical and chemical properties, and evaluation of chemical reactivity to understand their behavior. The study of organic reactions includes the chemical synthesis of natural products, drugs, and polymers, and study of individual organic molecules in the laboratory and via theoretical (in silico) study. The range of chemicals studied in organic chemistry includes hydrocarbons (compounds containing only carbon and hydrogen) as well as compounds based on carbon, but also containing other elements, especially oxygen, nitrogen, sulfur, phosphorus (included in many biochemicals) and the halogens. Organometallic chemistry is the study of compounds containing carbon\u2013metal bonds."}}, {"canonical_name": "Canary Islands", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "canar__inseln", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Canar. Inseln", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Canar. Inseln"], "contexts": ["location in book title"]}, {"entity_id": "canary_islands", "book_id": "kosmos_humboldt_1845", "name": "Canary Islands", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Canary Islands"], "contexts": ["archipelago where Lancerote is", "islands with luxuriant fruit"]}, {"entity_id": "canariis", "book_id": "coloquios_da_orta_1563", "name": "Canariis", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Canariis"], "contexts": ["people who call coconut Narle"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Canar. Inseln", "target_book": "kosmos_humboldt_1845", "target_name": "Canary Islands", "similarity": 0.935}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Canar. Inseln", "target_book": "coloquios_da_orta_1563", "target_name": "Canariis", "similarity": 0.903}, {"source_book": "kosmos_humboldt_1845", "source_name": "Canary Islands", "target_book": "coloquios_da_orta_1563", "target_name": "Canariis", "similarity": 0.943}], "id": 1921, "stable_key": "clu_b9c46e2d74e40ec3", "ground_truth": {"modern_name": "Canary Islands", "confidence": "high", "type": "place", "country": "Spain", "wikidata_id": "Q5813", "wikidata_description": "autonomous community of Spain, and archipelago in the Atlantic Ocean", "wikipedia_url": "https://en.wikipedia.org/wiki/Canary%20Islands"}}, {"canonical_name": "Arabian Gulf", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "gulf-shvain", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Gulf-shvain", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Gulf-shvain"], "contexts": ["ocean current"]}, {"entity_id": "arabian_gulf", "book_id": "kosmos_humboldt_1845", "name": "Arabian Gulf", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Arabian Gulf"], "contexts": ["region with monsoon knowledge"]}, {"entity_id": "arabian_gulf", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Arabian Gulf", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Arabian Gulf"], "contexts": ["sea with prevailing monsoons", "location of monsoons"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Gulf-shvain", "target_book": "kosmos_humboldt_1845", "target_name": "Arabian Gulf", "similarity": 0.889}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Gulf-shvain", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Arabian Gulf", "similarity": 0.889}, {"source_book": "kosmos_humboldt_1845", "source_name": "Arabian Gulf", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Arabian Gulf", "similarity": 1.0}], "id": 1922, "stable_key": "clu_9423ccae0934f643", "ground_truth": {"modern_name": "Persian Gulf", "confidence": "high", "type": "place", "country": "Iran", "note": "The 'Arabian Gulf' is a modern political term, while 'Gulf-shvain' and the contexts point to the historical and geographical entity known as the Persian Gulf.", "wikidata_id": "Q37643", "wikidata_description": "1990\u20131991 conflict between Iraq and a 42-country coalition", "wikipedia_url": "https://en.wikipedia.org/wiki/Gulf%20War", "wikipedia_extract": "The Gulf War was an armed conflict between Iraq and a 42-country coalition led by the United States. The coalition's efforts were in two phases: Operation Desert Shield, which marked the military buildup from August 1990 to January 1991; and Operation Desert Storm, from the bombing campaign against Iraq on 17 January until the American-led liberation of Kuwait on 28 February. On 2 August 1990, Iraq, governed by Saddam Hussein, invaded neighboring Kuwait and occupied the country within two days. The invasion was primarily over Kuwait's alleged slant drilling in Iraq's Rumaila oil field, and Iraq's large debt to Kuwait from the recently ended Iran\u2013Iraq War. After a brief rump puppet government known as the Republic of Kuwait, Iraq split Kuwait's territory, absorbing the north into Basra Governorate, and establishing Kuwait Governorate in the south. The invasion of Kuwait was met with immediate international condemnation."}}, {"canonical_name": "th\u00e9orie de la chaleur", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "th\u00e9orie_de_la_chaleur", "book_id": "relation_historique_humboldt_vol3_1825", "name": "th\u00e9orie de la chaleur", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["th\u00e9orie de la chaleur"], "contexts": ["theory of heat"]}, {"entity_id": "theorie_mathematique_de_la_chaleur", "book_id": "kosmos_humboldt_1845", "name": "Theorie Mathematique de la Chaleur", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Theorie Mathematique de la Chaleur"], "contexts": ["book on mathematical theory of heat"]}, {"entity_id": "theorie_math__de_la_chaleur", "book_id": "kosmos_humboldt_1845", "name": "Theorie Math. de la Chaleur", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Theorie Math. de la Chaleur"], "contexts": ["book on mathematical theory of heat"]}, {"entity_id": "theory_of_heat", "book_id": "connexion_physical_sciences_somerville_1858", "name": "theory of heat", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["theory of heat"], "contexts": ["fundamental principle of heat"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "th\u00e9orie de la chaleur", "target_book": "kosmos_humboldt_1845", "target_name": "Theorie Mathematique de la Chaleur", "similarity": 0.904}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "th\u00e9orie de la chaleur", "target_book": "kosmos_humboldt_1845", "target_name": "Theorie Math. de la Chaleur", "similarity": 0.908}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "th\u00e9orie de la chaleur", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "theory of heat", "similarity": 0.973}, {"source_book": "kosmos_humboldt_1845", "source_name": "Theorie Mathematique de la Chaleur", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "theory of heat", "similarity": 0.891}, {"source_book": "kosmos_humboldt_1845", "source_name": "Theorie Math. de la Chaleur", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "theory of heat", "similarity": 0.898}], "id": 1923, "stable_key": "clu_fd9dc3d0aa93f893", "ground_truth": {"modern_name": "theory of heat", "confidence": "high", "type": "concept", "wikidata_id": "Q61029696", "wikidata_description": "scholarly article"}}, {"canonical_name": "lichens", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "lichens", "book_id": "relation_historique_humboldt_vol3_1825", "name": "lichens", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["lichens"], "contexts": ["organisms collected on the shore"]}, {"entity_id": "lichens", "book_id": "kosmos_humboldt_1845", "name": "lichens", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["lichens"], "contexts": ["inferior plants on mountain plateaux"]}, {"entity_id": "lichens", "book_id": "connexion_physical_sciences_somerville_1858", "name": "lichens", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["lichens"], "contexts": ["composite organisms of fungi and algae", "low order of vegetable creation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "lichens", "target_book": "kosmos_humboldt_1845", "target_name": "lichens", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "lichens", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "lichens", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "lichens", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "lichens", "similarity": 1.0}], "id": 1924, "stable_key": "clu_00a7bf01f2d39f02", "ground_truth": {"modern_name": "Lichen", "confidence": "high", "type": "plant", "family": "Lecanoraceae", "note": "The term 'lichen' in early modern texts refers to the composite organism, not a single species. While many specific species and genera were described, the cluster refers to lichens in general. The family Lecanoraceae is a common example, but not exhaustive.", "wikidata_id": "Q567898", "wikidata_description": "genus of insects", "wikipedia_url": "https://en.wikipedia.org/wiki/Lichenaula", "wikipedia_extract": "Lichenaula is a genus of Australian moth of the family Xyloryctidae. The genus was first published by amateur entomologist Edward Meyrick in 1890. Lichenaula afflictella (Walker, 1864) Lichenaula appropinquans T.P. Lucas, 1901 Lichenaula calligrapha Meyrick, 1890 Lichenaula circumsignata T.P. Lucas, 1900 Lichenaula comparella (Walker, 1864) Lichenaula neboissi F.G. Neumann, 1970 Lichenaula petulans T.P."}}, {"canonical_name": "lizards", "category": "ANIMAL", "subcategory": "REPTILE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "lizards", "book_id": "principles_of_psychology_james_1890", "name": "lizards", "category": "ANIMAL", "subcategory": "REPTILE", "count": 2, "variants": ["lizards"], "contexts": ["animals where vision persists after hemisphere removal", "animals studied for vision after hemisphere removal"]}, {"entity_id": "lizards", "book_id": "kosmos_humboldt_1845", "name": "lizards", "category": "ANIMAL", "subcategory": "REPTILE", "count": 1, "variants": ["lizards"], "contexts": ["small scaled reptiles"]}, {"entity_id": "lizard", "book_id": "connexion_physical_sciences_somerville_1858", "name": "lizard", "category": "ANIMAL", "subcategory": "REPTILE", "count": 1, "variants": ["lizard"], "contexts": ["reptilian creature"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "lizards", "target_book": "kosmos_humboldt_1845", "target_name": "lizards", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "lizards", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "lizard", "similarity": 0.936}, {"source_book": "kosmos_humboldt_1845", "source_name": "lizards", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "lizard", "similarity": 0.936}], "id": 1925, "stable_key": "clu_a1b423c0d9756181", "ground_truth": {"modern_name": "lizards", "confidence": "high", "type": "animal", "description": "Reptiles, including references to the Cayman.", "note": "Spanish term for lizards.", "wikipedia_extract": "Lizard is the common name used for all squamate reptiles other than snakes (and to a lesser extent amphisbaenians), encompassing over 7,000 species, ranging across all continents except Antarctica, as well as most oceanic island chains. The grouping is paraphyletic as some lizards are more closely related to snakes than they are to other lizards. Lizards range in size from chameleons and geckos a few centimeters long to the 3-meter-long Komodo dragon. Most lizards are quadrupedal, running with a strong side-to-side motion. Some lineages (known as \"legless lizards\") have secondarily lost their legs, and have long snake-like bodies. Some lizards, such as the forest-dwelling Draco, are able to glide."}}, {"canonical_name": "Intellectual Powers", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "intellectual_powers", "book_id": "principles_of_psychology_james_1890", "name": "Intellectual Powers", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Intellectual Powers"], "contexts": ["work by Reid", "book title"]}, {"entity_id": "intellectual_forces", "book_id": "kosmos_humboldt_1845", "name": "intellectual forces", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["intellectual forces"], "contexts": ["mental and cognitive capabilities"]}, {"entity_id": "intellectual_faculties", "book_id": "first_principles_spencer_1862", "name": "intellectual faculties", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["intellectual faculties"], "contexts": ["mental powers for thinking"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Intellectual Powers", "target_book": "kosmos_humboldt_1845", "target_name": "intellectual forces", "similarity": 0.934}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Intellectual Powers", "target_book": "first_principles_spencer_1862", "target_name": "intellectual faculties", "similarity": 0.894}, {"source_book": "kosmos_humboldt_1845", "source_name": "intellectual forces", "target_book": "first_principles_spencer_1862", "target_name": "intellectual faculties", "similarity": 0.907}], "id": 1926, "stable_key": "clu_2deccffb9da4d316-2", "ground_truth": {"modern_name": "cognition", "confidence": "high", "type": "concept", "wikidata_id": "Q3065932", "wikidata_description": "disease of mental health that affects cognitive functions including memory processing, perception and problem solving", "wikipedia_url": "https://en.wikipedia.org/wiki/Neurocognitive%20disorder", "note": "Early modern concepts of 'intellectual powers' encompassed reasoning, memory, perception, and understanding, aligning with modern cognitive science.", "wikipedia_extract": "Neurocognitive disorders (NCDs), also known as cognitive disorders (CDs), are a category of mental health disorders that primarily affect cognitive abilities including learning, memory, perception, and problem-solving. Neurocognitive disorders include delirium, mild neurocognitive disorders, and major neurocognitive disorder (also known as dementia). They are defined by deficits in cognitive ability that are acquired (as opposed to developmental), typically represent decline, and may have an underlying brain pathology. The DSM-5 defines six key domains of cognitive function: executive function, learning and memory, perceptual-motor function, language, complex attention, and social cognition. Although Alzheimer's disease accounts for the majority of cases of neurocognitive disorders, there are various medical conditions that affect mental functions such as memory, thinking, and the ability to reason, including frontotemporal degeneration, Huntington's disease, dementia with Lewy bodies, traumatic brain injury (TBI), Parkinson's disease, prion disease, and dementia/neurocognitive issues due to HIV infection. Neurocognitive disorders are diagnosed as mild and major based on the severity of their symptoms."}}, {"canonical_name": "sentence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "sentence", "book_id": "principles_of_psychology_james_1890", "name": "sentence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["sentence"], "contexts": ["grammatical unit of expression"]}, {"entity_id": "sentences", "book_id": "connexion_physical_sciences_somerville_1858", "name": "sentences", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sentences"], "contexts": ["grammatical units of language"]}, {"entity_id": "sentence", "book_id": "first_principles_spencer_1862", "name": "sentence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sentence"], "contexts": ["grammatical unit of speech"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "sentence", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sentences", "similarity": 0.823}, {"source_book": "principles_of_psychology_james_1890", "source_name": "sentence", "target_book": "first_principles_spencer_1862", "target_name": "sentence", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "sentences", "target_book": "first_principles_spencer_1862", "target_name": "sentence", "similarity": 0.823}], "id": 1927, "stable_key": "clu_c8821e1f65a6f1f1", "ground_truth": {"modern_name": "Sentence (linguistics)", "confidence": "high", "type": "concept", "note": "Refers to the grammatical unit of language."}}, {"canonical_name": "thread", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "thread", "book_id": "principles_of_psychology_james_1890", "name": "thread", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["thread"], "contexts": ["fine strand of material", "marker in telescope view"]}, {"entity_id": "thread", "book_id": "kosmos_humboldt_1845", "name": "thread", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["thread"], "contexts": ["material for suspension"]}, {"entity_id": "thread", "book_id": "connexion_physical_sciences_somerville_1858", "name": "thread", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["thread"], "contexts": ["material for twisting into a spiral"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "thread", "target_book": "kosmos_humboldt_1845", "target_name": "thread", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "thread", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "thread", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "thread", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "thread", "similarity": 1.0}], "id": 1928, "stable_key": "clu_27c036b9d787624e", "ground_truth": {"modern_name": "thread", "confidence": "high", "type": "object", "wikidata_id": "Q244111", "wikidata_description": "species of worm", "wikipedia_url": "https://en.wikipedia.org/wiki/Thread-local_storage", "wikipedia_extract": "In computer programming, thread-local storage (TLS) is a memory management method that uses static or global memory local to a thread. The concept allows storage of data that appears to be global in a system with separate threads. Many systems impose restrictions on the size of the thread-local memory block, in fact often rather tight limits. On the other hand, if a system can provide at least a memory address (pointer) sized variable thread-local, then this allows the use of arbitrarily sized memory blocks in a thread-local manner, by allocating such a memory block dynamically and storing the memory address of that block in the thread-local variable. On RISC machines, the calling convention often reserves a thread pointer register for this use. While the use of global variables is generally discouraged in modern programming, some older operating systems such as UNIX were originally designed for uniprocessor hardware and often use global variables to store important values."}}, {"canonical_name": "magnitude", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "magnitude", "book_id": "principles_of_psychology_james_1890", "name": "magnitude", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["magnitude"], "contexts": ["size or extent"]}, {"entity_id": "magnitudine", "book_id": "polyanthea_medicinal", "name": "magnitudine", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["magnitudine"], "contexts": ["size"]}, {"entity_id": "magnitude", "book_id": "connexion_physical_sciences_somerville_1858", "name": "magnitude", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["magnitude"], "contexts": ["measure of star brightness", "size or extent of an object"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "magnitude", "target_book": "polyanthea_medicinal", "target_name": "magnitudine", "similarity": 0.98}, {"source_book": "principles_of_psychology_james_1890", "source_name": "magnitude", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnitude", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "magnitudine", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnitude", "similarity": 0.98}], "id": 1929, "stable_key": "clu_12c2ff6336dd7296", "ground_truth": {"modern_name": "Magnitude", "confidence": "high", "type": "concept", "note": "The contexts provided (size, extent, measure of star brightness) clearly point to the general concept of magnitude.", "wikidata_id": "Q2091629", "wikidata_description": "mathematical concept related to comparison and ordering", "wikipedia_url": "https://en.wikipedia.org/wiki/Magnitude%20%28mathematics%29", "wikipedia_extract": "In mathematics, the magnitude or size of a mathematical object is a property which determines whether the object is larger or smaller than other objects of the same kind. More formally, an object's magnitude is the displayed result of an ordering (or ranking) of the class of objects to which it belongs. Magnitude as a concept dates to Ancient Greece and has been applied as a measure of distance from one object to another. For numbers, the absolute value of a number is commonly applied as the measure of units between a number and zero. In vector spaces, the Euclidean norm is a measure of magnitude used to define a distance between two points in space. In physics, magnitude can be defined as quantity or distance."}}, {"canonical_name": "irritation", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "irritation", "book_id": "principles_of_psychology_james_1890", "name": "irritation", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["irritation"], "contexts": ["stimulation causing a reaction"]}, {"entity_id": "irritations", "book_id": "principles_of_psychology_james_1890", "name": "irritations", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["irritations"], "contexts": ["state of being stimulated or inflamed"]}, {"entity_id": "irrita\u00e7\u00e3o", "book_id": "polyanthea_medicinal", "name": "irrita\u00e7\u00e3o", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["irrita\u00e7\u00e3o"], "contexts": ["cause of tears"]}, {"entity_id": "irritability", "book_id": "first_principles_spencer_1862", "name": "irritability", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["irritability"], "contexts": ["tendency to be easily annoyed"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "irritation", "target_book": "polyanthea_medicinal", "target_name": "irrita\u00e7\u00e3o", "similarity": 0.897}, {"source_book": "principles_of_psychology_james_1890", "source_name": "irritation", "target_book": "first_principles_spencer_1862", "target_name": "irritability", "similarity": 0.959}, {"source_book": "principles_of_psychology_james_1890", "source_name": "irritations", "target_book": "polyanthea_medicinal", "target_name": "irrita\u00e7\u00e3o", "similarity": 0.883}, {"source_book": "principles_of_psychology_james_1890", "source_name": "irritations", "target_book": "first_principles_spencer_1862", "target_name": "irritability", "similarity": 0.949}, {"source_book": "polyanthea_medicinal", "source_name": "irrita\u00e7\u00e3o", "target_book": "first_principles_spencer_1862", "target_name": "irritability", "similarity": 0.886}], "id": 1930, "stable_key": "clu_4cf4194737f3c249", "ground_truth": {"wikipedia_extract": "Irritation, in biology and physiology, is a state of inflammation or painful reaction to allergy or cell-lining damage. A stimulus or agent which induces the state of irritation is an irritant. Irritants are typically thought of as chemical agents (for example phenol and capsaicin) but mechanical, thermal (heat), and radiative stimuli (for example ultraviolet light or ionising radiations) can also be irritants. Irritation also has non-clinical usages referring to bothersome physical or psychological pain or discomfort. Irritation can also be induced by some allergic response due to exposure of some allergens for example contact dermatitis, irritation of mucosal membranes and pruritus. Mucosal membrane is the most common site of irritation because it contains secretory glands that release mucus which attracts the allergens due to its sticky nature."}}, {"canonical_name": "mechanical laws", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "mechanical_laws", "book_id": "principles_of_psychology_james_1890", "name": "mechanical laws", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["mechanical laws"], "contexts": ["laws governing physical systems"]}, {"entity_id": "physical_laws", "book_id": "kosmos_humboldt_1845", "name": "physical laws", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["physical laws"], "contexts": ["fundamental principles governing the universe"]}, {"entity_id": "mechanical_natural_law", "book_id": "kosmos_humboldt_1845", "name": "mechanical natural law", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["mechanical natural law"], "contexts": ["law governing planetary motion"]}, {"entity_id": "physical_laws", "book_id": "first_principles_spencer_1862", "name": "physical laws", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["physical laws"], "contexts": ["fundamental principles governing the universe"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "mechanical laws", "target_book": "kosmos_humboldt_1845", "target_name": "physical laws", "similarity": 0.909}, {"source_book": "principles_of_psychology_james_1890", "source_name": "mechanical laws", "target_book": "kosmos_humboldt_1845", "target_name": "mechanical natural law", "similarity": 0.925}, {"source_book": "principles_of_psychology_james_1890", "source_name": "mechanical laws", "target_book": "first_principles_spencer_1862", "target_name": "physical laws", "similarity": 0.909}, {"source_book": "kosmos_humboldt_1845", "source_name": "physical laws", "target_book": "first_principles_spencer_1862", "target_name": "physical laws", "similarity": 1.0}], "id": 1931, "stable_key": "clu_e621a6d0da04efe6", "ground_truth": {"modern_name": "Physical Laws", "confidence": "high", "type": "concept", "note": "The terms 'mechanical laws', 'physical laws', and 'mechanical natural law' all refer to the fundamental principles governing the physical universe.", "wikidata_id": "Q214070", "wikidata_description": "scientific law of physics", "wikipedia_url": "https://en.wikipedia.org/wiki/Physical%20law"}}, {"canonical_name": "sparrow", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "sparrow", "book_id": "principles_of_psychology_james_1890", "name": "sparrow", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["sparrow"], "contexts": ["animal used as example"]}, {"entity_id": "sparrow", "book_id": "connexion_physical_sciences_somerville_1858", "name": "sparrow", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["sparrow"], "contexts": ["common, has a wide range"]}, {"entity_id": "sparrow", "book_id": "first_principles_spencer_1862", "name": "sparrow", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["sparrow"], "contexts": ["small to medium-sized bird", "bird whose changing relations of position are noted"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "sparrow", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sparrow", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "sparrow", "target_book": "first_principles_spencer_1862", "target_name": "sparrow", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "sparrow", "target_book": "first_principles_spencer_1862", "target_name": "sparrow", "similarity": 1.0}], "id": 1932, "stable_key": "clu_92cf8eaf4a327412", "ground_truth": {"modern_name": "Sparrow", "confidence": "high", "type": "animal", "note": "While 'spteryx' is unusual, in the context of 'sparrow' and 'bird', it is likely a misspelling or variant. 'Dinornis' refers to extinct moa, but 'sparrow' is the clear primary referent.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Sparrow", "wikipedia_extract": "Old World sparrows, family Passeridae New World sparrows, family Passerellidae Two species in the Passerine family Estrildidae: Hedge sparrow, also known as the dunnock or hedge accentor in the family Prunellidae Sparrow (American poet) (born 1953), American poet, activist, musician, and rabble-rouser Robert Brown (footballer) (born 1856), Scottish footballer known by the nickname 'Sparrow' The Sparrow (1914 film), a 1914 French silent film Sparrows (1926 film), starring Mary Pickford The Sparrow (1972 film), Arabic title Al Asfour, a 1972 Egyptian film by director Youssef Chahine Sparrow (1993 film), a 1993 Italian drama film directed by Franco Zeffirelli Sparrow (2008 film), a Hong Kong film Sparrow (2010 film), a horror film directed by Shaun Troke Sparrows (2015 film), an Icelandic film directed by R\u00fanar R\u00fanarsson The Sparrow (novel), a 1996 science fiction novel by Mary Doria Russell The Sparrow (1967 play), by Alan Ayckbourn The Sparrow (2007 play), about a teenage girl with a troubled past Sparrows (album), by Anathallo, 2002 Sparrow (album), by Ashley Monroe, 2018 The Sparrows (band), a predecessor band to Steppenwolf that included John Kay Sparrows (band), a Canadian post hardcore trio Sparrow Quartet, American acoustic music group \"Sparrow\", by The Boo Radleys from Everything's Alright Forever \"Sparrow\", by Charlotte Church from Three \"Sparrow\", by Mo-dettes from The Story So Far \"Sparrow\", by Simon & Garfunkel from Wednesday Morning, 3 A.M."}}, {"canonical_name": "molecule", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "molecule", "book_id": "principles_of_psychology_james_1890", "name": "molecule", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["molecule"], "contexts": ["basic unit of matter"]}, {"entity_id": "molecule", "book_id": "kosmos_humboldt_1845", "name": "molecule", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["molecule"], "contexts": ["ultimate portion of matter"]}, {"entity_id": "molecule", "book_id": "connexion_physical_sciences_somerville_1858", "name": "molecule", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["molecule"], "contexts": ["basic unit of matter", "basic unit of matter with power"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "molecule", "target_book": "kosmos_humboldt_1845", "target_name": "molecule", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "molecule", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "molecule", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "molecule", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "molecule", "similarity": 1.0}], "id": 1933, "stable_key": "clu_3c30126c22acdd43-2", "ground_truth": {"modern_name": "molecules", "confidence": "high", "type": "concept", "wikidata_id": "Q11369", "wikidata_description": "smallest possibile amount of a chemical substance", "wikipedia_url": "https://en.wikipedia.org/wiki/Molecule", "note": "The descriptions 'basic unit of matter' and 'ultimate portion of matter' are consistent with the modern understanding of a molecule.", "wikipedia_extract": "A molecule is a group of two or more atoms that are held together by attractive forces known as chemical bonds; depending on context, the term may or may not include ions that satisfy this criterion. In quantum physics, organic chemistry, and biochemistry, the distinction from ions is dropped and molecule is often used when referring to polyatomic ions. A molecule may be homonuclear, that is, it consists of atoms of one chemical element, e.g. two atoms in the oxygen molecule (O2); or it may be heteronuclear, a chemical compound composed of more than one element, e.g. water (two hydrogen atoms and one oxygen atom; H2O). In the kinetic theory of gases, the term molecule is often used for any gaseous particle regardless of its composition."}}, {"canonical_name": "mechanical power", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "mechanical_energies", "book_id": "principles_of_psychology_james_1890", "name": "mechanical energies", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mechanical energies"], "contexts": ["energy related to motion and force"]}, {"entity_id": "mechanical_power", "book_id": "connexion_physical_sciences_somerville_1858", "name": "mechanical power", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["mechanical power"], "contexts": ["power derived from mechanical systems", "force from motion"]}, {"entity_id": "mechanical_powers", "book_id": "first_principles_spencer_1862", "name": "mechanical powers", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mechanical powers"], "contexts": ["fundamental forces in mechanics"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "mechanical energies", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "mechanical power", "similarity": 0.917}, {"source_book": "principles_of_psychology_james_1890", "source_name": "mechanical energies", "target_book": "first_principles_spencer_1862", "target_name": "mechanical powers", "similarity": 0.889}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "mechanical power", "target_book": "first_principles_spencer_1862", "target_name": "mechanical powers", "similarity": 0.956}], "id": 1934, "stable_key": "clu_b31fea10cb7ed765", "ground_truth": {"modern_name": "Mechanical Energy", "confidence": "high", "type": "concept", "note": "The terms 'mechanical energies', 'mechanical power', and 'mechanical powers' all relate to the concept of energy associated with motion and forces.", "wikidata_id": "Q184550", "wikidata_description": "potential and kinetic energy associated with the position and movement of a physical object"}}, {"canonical_name": "savages", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "savages", "book_id": "principles_of_psychology_james_1890", "name": "savages", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["savages"], "contexts": ["indigenous peoples studied for psychological comparison"]}, {"entity_id": "american_savages", "book_id": "connexion_physical_sciences_somerville_1858", "name": "American savages", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["American savages"], "contexts": ["indigenous peoples of America, with refined grammar"]}, {"entity_id": "savages", "book_id": "first_principles_spencer_1862", "name": "savages", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["savages"], "contexts": ["term for uncivilized people", "people with simple chants"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "savages", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "American savages", "similarity": 0.881}, {"source_book": "principles_of_psychology_james_1890", "source_name": "savages", "target_book": "first_principles_spencer_1862", "target_name": "savages", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "American savages", "target_book": "first_principles_spencer_1862", "target_name": "savages", "similarity": 0.881}], "id": 1935, "stable_key": "clu_70398c52bacd8046", "ground_truth": {"modern_name": "Indigenous peoples", "confidence": "high", "type": "concept", "note": "The term 'savages' was historically used to refer to indigenous peoples, often in a derogatory manner, but in scientific and philosophical texts, it frequently referred to groups studied for comparative anthropology or psychology.", "wikidata_id": "Q1363781", "wikidata_description": "descendants of the population that lived in the territory of modern Brazil before the Portuguese colonization", "wikipedia_url": "https://en.wikipedia.org/wiki/Indigenous%20peoples%20in%20Brazil", "description": "Original inhabitants of a region or continent", "wikipedia_extract": "Indigenous peoples in Brazil or Native Brazilians (Portuguese: Brasileiros nativos) are the peoples whose ancestors lived in Brazil before European contact around 1500 and those pre-Columbian forebears. Indigenous peoples once comprised an estimated 2,000 distinct tribes and nations inhabiting what is now Brazil. The 2010 Brazil census recorded 305 Indigenous ethnic groups. Historically, many Indigenous peoples of Brazil were semi-nomadic and combined hunting, fishing, and gathering with migratory agriculture. Many tribes were massacred by European settlers, and others assimilated into the growing Brazilian population. The Indigenous population was decimated by European diseases, declining from a pre-Columbian high of 2 million to 3 million to approximately 300,000 by 1997, distributed among 200 tribes."}}, {"canonical_name": "human race", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "human_race", "book_id": "principles_of_psychology_james_1890", "name": "human race", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["human race"], "contexts": ["collective agreement on perception"]}, {"entity_id": "human_race", "book_id": "connexion_physical_sciences_somerville_1858", "name": "human race", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["human race"], "contexts": ["all of humanity", "classification of people"]}, {"entity_id": "human_race", "book_id": "first_principles_spencer_1862", "name": "human race", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["human race"], "contexts": ["distinct groups within humanity"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "human race", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "human race", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "human race", "target_book": "first_principles_spencer_1862", "target_name": "human race", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "human race", "target_book": "first_principles_spencer_1862", "target_name": "human race", "similarity": 1.0}], "id": 1936, "stable_key": "clu_d0ad0d299c171cfc-2", "ground_truth": {"modern_name": "humanity", "confidence": "high", "type": "concept", "note": "The term 'manking' and 'manhans' likely refer to humanity, with 'manhans' also potentially referring to a specific period for medication.", "wikidata_id": "Q1575029", "wikidata_description": "International aid organization with headquarter in France", "wikipedia_url": "https://en.wikipedia.org/wiki/Human", "wikipedia_extract": "Humans (Homo sapiens, meaning \"thinking man\" or \"wise man\") are the most common and widespread species of primate, and the only extant species of the genus Homo. They are great apes characterized by hairlessness, obligate bipedality, manual dexterity with opposable thumbs, precision grip, and high intelligence. Humans have large brains compared to body size (a high encephalization quotient), enabling more advanced cognitive skills that facilitate successful adaptation to varied environments, development of sophisticated tools, and formation of complex social structures and civilizations. Humans possess a disproportionately larger volume of both cerebral white matter and gray matter present in the prefrontal cortex (PFC) than any other primate species, which facilitated the expansion of higher-order executive functions. Humans are highly social, with individual humans tending to belong to a multi-layered network of distinct social groups \u2013 from families and peer groups to corporations and political states. As such, social interactions between humans have established a wide variety of values, social norms, languages, and traditions (collectively termed institutions), each of which bolsters human society.", "linnaean": "Trichechus manatus", "family": "Trichechidae", "description": "Large, aquatic marine mammal with paddle-like flippers."}}, {"canonical_name": "ship", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "navio", "book_id": "polyanthea_medicinal", "name": "navio", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["navio"], "contexts": ["vessel for sea travel"]}, {"entity_id": "ship", "book_id": "connexion_physical_sciences_somerville_1858", "name": "ship", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["ship"], "contexts": ["vessel for water transport", "vessel for sea travel"]}, {"entity_id": "ship", "book_id": "first_principles_spencer_1862", "name": "ship", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["ship"], "contexts": ["vessel for sea travel"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "navio", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "ship", "similarity": 0.958}, {"source_book": "polyanthea_medicinal", "source_name": "navio", "target_book": "first_principles_spencer_1862", "target_name": "ship", "similarity": 0.958}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "ship", "target_book": "first_principles_spencer_1862", "target_name": "ship", "similarity": 1.0}], "id": 1937, "stable_key": "clu_88082e6e804c3eda", "ground_truth": {"modern_name": "ship", "confidence": "high", "type": "object", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_extract": "A ship  is a large watercraft designed for travel across the surface of a body of water, carrying cargo or passengers, or in support of specialized tasks such as warfare, oceanography and fishing. Ships are generally distinguished from boats, based on size, shape, load capacity and purpose. Ships have supported exploration, trade, warfare, migration, colonization, and science. Ship transport is responsible for the largest portion of world commerce. The word ship has meant, depending on era and context, either simply a large vessel or specifically a full-rigged ship with three or more masts, each of which is square rigged. The earliest historical evidence of boats is found in Egypt during the 4th millennium BC."}}, {"canonical_name": "measurement", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "measurement", "book_id": "principles_of_psychology_james_1890", "name": "measurement", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["measurement"], "contexts": ["process of quantifying magnitudes"]}, {"entity_id": "measurement", "book_id": "connexion_physical_sciences_somerville_1858", "name": "measurement", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["measurement"], "contexts": ["act of determining quantity", "inaccuracy from local attraction"]}, {"entity_id": "measure", "book_id": "first_principles_spencer_1862", "name": "measure", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["measure"], "contexts": ["determination of size or quantity"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "measurement", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "measurement", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "measurement", "target_book": "first_principles_spencer_1862", "target_name": "measure", "similarity": 0.954}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "measurement", "target_book": "first_principles_spencer_1862", "target_name": "measure", "similarity": 0.954}], "id": 1938, "stable_key": "clu_987585922aca1b1d", "ground_truth": {"modern_name": "Measurement", "confidence": "high", "type": "concept", "wikidata_id": "Q12453", "wikidata_description": "process of assigning quantities to objects or events", "wikipedia_extract": "Measurement is the quantification of attributes of an object or event, which can be used to compare with other objects or events. In other words, measurement is a process of determining how large or small a physical quantity is as compared to a basic reference quantity of the same kind. The scope and application of measurement are dependent on the context and discipline. In natural sciences and engineering, measurements do not apply to nominal properties of objects or events, which is consistent with the guidelines of the International Vocabulary of Metrology (VIM) published by the International Bureau of Weights and Measures (BIPM). However, in other fields such as statistics as well as the social and behavioural sciences, measurements can have multiple levels, which would include nominal, ordinal, interval and ratio scales. Measurement is a cornerstone of trade, science, technology and quantitative research in many disciplines.", "wikipedia_url": "https://en.wikipedia.org/wiki/Measurement"}}, {"canonical_name": "distances", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "distances", "book_id": "principles_of_psychology_james_1890", "name": "DISTANCES", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["DISTANCES"], "contexts": ["space between points"]}, {"entity_id": "distances", "book_id": "kosmos_humboldt_1845", "name": "distances", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["distances"], "contexts": ["spatial separation between celestial bodies"]}, {"entity_id": "distances", "book_id": "connexion_physical_sciences_somerville_1858", "name": "distances", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["distances"], "contexts": ["space between objects", "computed from parallax"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "DISTANCES", "target_book": "kosmos_humboldt_1845", "target_name": "distances", "similarity": 0.92}, {"source_book": "principles_of_psychology_james_1890", "source_name": "DISTANCES", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "distances", "similarity": 0.92}, {"source_book": "kosmos_humboldt_1845", "source_name": "distances", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "distances", "similarity": 1.0}], "id": 1939, "stable_key": "clu_28e00374dfdc6ae5-2", "ground_truth": {"modern_name": "distance", "confidence": "high", "type": "concept", "note": "The contexts provided (spatial separation, space between celestial bodies/points) strongly indicate the concept of spatial distance.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "aromoticos", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "aromatic", "book_id": "principles_of_psychology_james_1890", "name": "aromatic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["aromatic"], "contexts": ["objective fact of quality"]}, {"entity_id": "aromoticos", "book_id": "historia_medicinal_monardes_1574", "name": "aromoticos", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["aromoticos", "aromaticos"], "contexts": ["misspelling in errata", "correction in errata"]}, {"entity_id": "aromatic", "book_id": "polyanthea_medicinal", "name": "aromatic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["aromatic"], "contexts": ["fragrant quality of substances"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "aromatic", "target_book": "historia_medicinal_monardes_1574", "target_name": "aromoticos", "similarity": 0.941}, {"source_book": "principles_of_psychology_james_1890", "source_name": "aromatic", "target_book": "polyanthea_medicinal", "target_name": "aromatic", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "aromoticos", "target_book": "polyanthea_medicinal", "target_name": "aromatic", "similarity": 0.941}], "id": 1940, "stable_key": "clu_a801eb7a7b8aa88e", "ground_truth": {"modern_name": "Aromatic", "confidence": "high", "type": "concept", "wikidata_id": "Q14864889", "wikidata_description": "The chemical reactions and pathways involving aromatic compounds, any organic compound characterized by one or more planar rings, each of which contains conjugated double bonds and delocalized pi electrons, as carried out by individual cells."}}, {"canonical_name": "motions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "motions", "book_id": "principles_of_psychology_james_1890", "name": "motions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["motions"], "contexts": ["internal physical processes"]}, {"entity_id": "motions", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Motions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Motions"], "contexts": ["movement of celestial bodies"]}, {"entity_id": "motions", "book_id": "first_principles_spencer_1862", "name": "motions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["motions"], "contexts": ["movements impressed on units", "movements from one place to another"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "motions", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Motions", "similarity": 0.966}, {"source_book": "principles_of_psychology_james_1890", "source_name": "motions", "target_book": "first_principles_spencer_1862", "target_name": "motions", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Motions", "target_book": "first_principles_spencer_1862", "target_name": "motions", "similarity": 0.966}], "id": 1941, "stable_key": "clu_63aa0520937b163f-2", "ground_truth": {"modern_name": "Motion", "confidence": "high", "type": "concept", "wikidata_id": "Q79782", "wikidata_description": "change in position of an object over time; a body is said to be in motion if it changes its position or orientation with respect to its immediate surroundings", "wikipedia_url": "https://en.wikipedia.org/wiki/Motion", "wikipedia_extract": "In physics, motion is when an object changes its position with respect to a reference point in a given time. Motion is mathematically described in terms of displacement, distance, velocity, acceleration, speed, and frame of reference to an observer, measuring the change in position of the body relative to that frame with a change in time. The branch of physics describing the motion of objects without reference to their cause is called kinematics, while the branch studying forces and their effect on motion is called dynamics. If an object is not in motion relative to a given frame of reference, it is said to be at rest, motionless, immobile, stationary, or to have a constant or time-invariant position with reference to its surroundings. Modern physics holds that, as there is no absolute frame of reference, Isaac Newton's concept of absolute motion cannot be determined. Everything in the universe can be considered to be in motion.", "note": "While 'motet' is a musical term, the context of 'first principles' and physical sciences strongly suggests 'motion' as the primary concept. 'Motus' is Latin for motion."}}, {"canonical_name": "beats", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "beats", "book_id": "principles_of_psychology_james_1890", "name": "beats", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["beats"], "contexts": ["discrete units of time or sensation"]}, {"entity_id": "beats", "book_id": "connexion_physical_sciences_somerville_1858", "name": "beats", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["beats"], "contexts": ["intervals of silence and intensity in sound", "audible pulses in sound"]}, {"entity_id": "beat", "book_id": "first_principles_spencer_1862", "name": "beat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["beat"], "contexts": ["rhythmic pulse in music"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "beats", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "beats", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "beats", "target_book": "first_principles_spencer_1862", "target_name": "beat", "similarity": 0.871}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "beats", "target_book": "first_principles_spencer_1862", "target_name": "beat", "similarity": 0.871}], "id": 1942, "stable_key": "clu_9593e5340f4dae37", "ground_truth": {"modern_name": "beats", "confidence": "high", "type": "concept", "note": "Refers to rhythmic or temporal units, can be in music, sensation, or time."}}, {"canonical_name": "physical astronomy", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "physical_astronomy", "book_id": "kosmos_humboldt_1845", "name": "physical astronomy", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Physical astronomy", "physical astronomy"], "contexts": ["study of celestial bodies and forces", "branch of astronomy"]}, {"entity_id": "physical_astronomy", "book_id": "connexion_physical_sciences_somerville_1858", "name": "physical astronomy", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["physical astronomy"], "contexts": ["science comparing laws of motion on earth and heavens"]}, {"entity_id": "physical_astronomy", "book_id": "first_principles_spencer_1862", "name": "physical astronomy", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["physical astronomy"], "contexts": ["astronomy based on physical laws"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "physical astronomy", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "physical astronomy", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "physical astronomy", "target_book": "first_principles_spencer_1862", "target_name": "physical astronomy", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "physical astronomy", "target_book": "first_principles_spencer_1862", "target_name": "physical astronomy", "similarity": 1.0}], "id": 1943, "stable_key": "clu_08df31decee32d5e", "ground_truth": {"modern_name": "Physical astronomy", "confidence": "high", "type": "concept"}}, {"canonical_name": "Lemnos", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "lemnos", "book_id": "kosmos_humboldt_1845", "name": "Lemnos", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Lemnos"], "contexts": ["island with volcanic history", "island with a chart"]}, {"entity_id": "lemnos", "book_id": "historia_medicinal_monardes_1574", "name": "Lemnos", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Lemnos"], "contexts": ["island, source of Terra Lemnia"]}, {"entity_id": "lemno", "book_id": "ricettario_fiorentino_1597", "name": "Lemno", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Lemno"], "contexts": ["island associated with medicinal earth"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Lemnos", "target_book": "historia_medicinal_monardes_1574", "target_name": "Lemnos", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Lemnos", "target_book": "ricettario_fiorentino_1597", "target_name": "Lemno", "similarity": 0.89}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Lemnos", "target_book": "ricettario_fiorentino_1597", "target_name": "Lemno", "similarity": 0.89}], "id": 1944, "stable_key": "clu_50babbe7ed807281", "ground_truth": {"wikipedia_extract": "Lemnos (Ancient Greek: \u039b\u1fc6\u03bc\u03bd\u03bf\u03c2 [\u02c8l\u025b\u0302\u02d0mnos]) or Limnos (Modern Greek: \u039b\u03ae\u03bc\u03bd\u03bf\u03c2 [\u02c8limnos]) is a Greek island in the northern Aegean Sea. Administratively the island forms a separate municipality within the Lemnos regional unit, which is part of the North Aegean region. The principal town of the island and seat of the municipality is Myrina. At 477.583 square kilometres (184.396 sq mi), it is the 8th-largest island of Greece. Lemnos is primarily a flat island, but the western region, particularly the northwest, is rocky and mountainous. At 430 meters above sea level, Mount Skopia is the highest point."}}, {"canonical_name": "Persian Gulf", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "persian_gulf", "book_id": "kosmos_humboldt_1845", "name": "Persian Gulf", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Persian Gulf"], "contexts": ["gulf in ancient geography", "body of water connected to fissures"]}, {"entity_id": "persian_gulf", "book_id": "coloquios_da_orta_1563", "name": "Persian Gulf", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Persian Gulf"], "contexts": ["sea region for pearl fishing"]}, {"entity_id": "persian_gulf", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Persian Gulf", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Persian Gulf"], "contexts": ["inlet of the Indian Ocean"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Persian Gulf", "target_book": "coloquios_da_orta_1563", "target_name": "Persian Gulf", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Persian Gulf", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Persian Gulf", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Persian Gulf", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Persian Gulf", "similarity": 1.0}], "id": 1945, "stable_key": "clu_9423ccae0934f643-2", "ground_truth": {"modern_name": "Persian Gulf", "confidence": "high", "type": "place", "country": "Iran", "note": "The 'Arabian Gulf' is a modern political term, while 'Gulf-shvain' and the contexts point to the historical and geographical entity known as the Persian Gulf.", "wikidata_id": "Q37643", "wikidata_description": "1990\u20131991 conflict between Iraq and a 42-country coalition", "wikipedia_url": "https://en.wikipedia.org/wiki/Gulf%20War", "wikipedia_extract": "The Gulf War was an armed conflict between Iraq and a 42-country coalition led by the United States. The coalition's efforts were in two phases: Operation Desert Shield, which marked the military buildup from August 1990 to January 1991; and Operation Desert Storm, from the bombing campaign against Iraq on 17 January until the American-led liberation of Kuwait on 28 February. On 2 August 1990, Iraq, governed by Saddam Hussein, invaded neighboring Kuwait and occupied the country within two days. The invasion was primarily over Kuwait's alleged slant drilling in Iraq's Rumaila oil field, and Iraq's large debt to Kuwait from the recently ended Iran\u2013Iraq War. After a brief rump puppet government known as the Republic of Kuwait, Iraq split Kuwait's territory, absorbing the north into Basra Governorate, and establishing Kuwait Governorate in the south. The invasion of Kuwait was met with immediate international condemnation."}}, {"canonical_name": "Newtonian", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "newtonian_law", "book_id": "kosmos_humboldt_1845", "name": "Newtonian law", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["Newtonian law"], "contexts": ["laws of motion and universal gravitation"]}, {"entity_id": "newtonian_theory", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Newtonian theory", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["Newtonian theory"], "contexts": ["theory of light velocity"]}, {"entity_id": "newtonian", "book_id": "first_principles_spencer_1862", "name": "Newtonian", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Newtonian"], "contexts": ["supposition about matter and forces", "related to Isaac Newton's physics"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Newtonian law", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Newtonian theory", "similarity": 0.896}, {"source_book": "kosmos_humboldt_1845", "source_name": "Newtonian law", "target_book": "first_principles_spencer_1862", "target_name": "Newtonian", "similarity": 0.882}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Newtonian theory", "target_book": "first_principles_spencer_1862", "target_name": "Newtonian", "similarity": 0.888}], "id": 1946, "stable_key": "clu_690e741bff09b9e4", "ground_truth": {"modern_name": "Newtonian mechanics", "confidence": "high", "type": "concept", "note": "Refers to the foundational principles of physics established by Isaac Newton, encompassing his laws of motion and universal gravitation.", "wikidata_id": "Q11397", "wikidata_description": "sub-field of mechanics, which is concerned with the set of physical laws describing the motion of bodies under the action of a system of forces", "wikipedia_url": "https://en.wikipedia.org/wiki/Classical%20mechanics", "wikipedia_extract": "Newton's laws of motion are three physical laws that describe the relationship between the motion of an object and the forces acting on it. These laws, which provide the basis for Newtonian mechanics, can be paraphrased as follows: A body remains at rest, or in motion at a constant speed in a straight line, unless it is acted upon by a force. At any instant of time, the net force on a body is equal to the body's acceleration multiplied by its mass or, equivalently, the rate at which the body's momentum is changing with time. If two bodies exert forces on each other, these forces have the same magnitude but opposite directions. The three laws of motion were first stated by Isaac Newton in his Philosophi\u00e6 Naturalis Principia Mathematica (Mathematical Principles of Natural Philosophy), originally published in 1687. Newton used them to investigate and explain the motion of many physical objects and systems."}}, {"canonical_name": "orbits", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "orbits", "book_id": "kosmos_humboldt_1845", "name": "orbits", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["orbits"], "contexts": ["paths of celestial bodies"]}, {"entity_id": "celestial_orbits", "book_id": "connexion_physical_sciences_somerville_1858", "name": "celestial orbits", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["celestial orbits"], "contexts": ["paths of celestial bodies"]}, {"entity_id": "circular_orbits", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Circular orbits", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Circular orbits"], "contexts": ["of planets distinguished from elliptical"]}, {"entity_id": "orbits", "book_id": "first_principles_spencer_1862", "name": "orbits", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["orbits"], "contexts": ["paths of celestial bodies"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "orbits", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "celestial orbits", "similarity": 0.918}, {"source_book": "kosmos_humboldt_1845", "source_name": "orbits", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Circular orbits", "similarity": 0.923}, {"source_book": "kosmos_humboldt_1845", "source_name": "orbits", "target_book": "first_principles_spencer_1862", "target_name": "orbits", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "celestial orbits", "target_book": "first_principles_spencer_1862", "target_name": "orbits", "similarity": 0.918}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Circular orbits", "target_book": "first_principles_spencer_1862", "target_name": "orbits", "similarity": 0.923}], "id": 1947, "stable_key": "clu_0433d338422e6e30", "ground_truth": {"modern_name": "Orbit", "confidence": "high", "type": "concept", "wikidata_id": "Q7100035", "wikidata_description": "medical journal focusing on orbital disorders"}}, {"canonical_name": "homogeneous mass", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "homogeneous_mass", "book_id": "kosmos_humboldt_1845", "name": "homogeneous mass", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["homogeneous mass"], "contexts": ["uniform material composition"]}, {"entity_id": "homogeneous_matter", "book_id": "connexion_physical_sciences_somerville_1858", "name": "homogeneous matter", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["homogeneous matter"], "contexts": ["matter with uniform composition"]}, {"entity_id": "homogeneous_fluid", "book_id": "connexion_physical_sciences_somerville_1858", "name": "homogeneous fluid", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["homogeneous fluid"], "contexts": ["fluid of uniform density"]}, {"entity_id": "uniform_mass", "book_id": "first_principles_spencer_1862", "name": "uniform mass", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["uniform mass"], "contexts": ["a uniform mass loses its uniformity"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "homogeneous mass", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "homogeneous matter", "similarity": 0.967}, {"source_book": "kosmos_humboldt_1845", "source_name": "homogeneous mass", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "homogeneous fluid", "similarity": 0.921}, {"source_book": "kosmos_humboldt_1845", "source_name": "homogeneous mass", "target_book": "first_principles_spencer_1862", "target_name": "uniform mass", "similarity": 0.955}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "homogeneous matter", "target_book": "first_principles_spencer_1862", "target_name": "uniform mass", "similarity": 0.91}], "id": 1948, "stable_key": "clu_fb6df5b393f4b7af", "ground_truth": {"modern_name": "Homogeneous matter", "confidence": "high", "type": "concept", "note": "Refers to matter with uniform composition and properties throughout."}}, {"canonical_name": "Marcet", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "marcet", "book_id": "kosmos_humboldt_1845", "name": "Marcet", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Marcet"], "contexts": ["researcher at Pregny"]}, {"entity_id": "marquiz", "book_id": "polyanthea_medicinal", "name": "Marquiz", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Marquiz"], "contexts": ["doctor cited"]}, {"entity_id": "marcet", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Marcet", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Marcet"], "contexts": ["observed temperature increase with depth", "calculated temperature increase below earth's surface"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Marcet", "target_book": "polyanthea_medicinal", "target_name": "Marquiz", "similarity": 0.857}, {"source_book": "kosmos_humboldt_1845", "source_name": "Marcet", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Marcet", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "Marquiz", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Marcet", "similarity": 0.857}], "id": 1949, "stable_key": "clu_669cf890c5652bfa", "ground_truth": {"modern_name": "Jane Marcet", "confidence": "high", "type": "person", "birth_year": 1769, "death_year": 1858, "description": "Chemist and scientific writer, author of 'Conversations on Chemistry'.", "note": "The 'Marquiz' in 'polyanthea_medicinal' is likely a misspelling or variant of Marcet, given the context of scientific citations.", "wikidata_id": "Q433093", "wikidata_description": "British writer of scientific books", "wikipedia_url": "https://en.wikipedia.org/wiki/Jane%20Marcet", "wikipedia_extract": "Jane Marcet (; n\u00e9e Haldimand; 1 January 1769 \u2013 28 June 1858) was an English salonni\u00e8re of Republic of Geneva descent, and an innovative writer of popular, explanatory science books. She also broke ground with Conversations on Political Economy (1816), which explain the ideas of Adam Smith, Malthus and David Ricardo. Jane Marcet was born in London on 1 January 1769, one of twelve children of a wealthy Genevan merchant and banker, Anthony Francis Haldimand (1740/41\u20131817), and his wife Jane (died 1785). She was educated at home with her brothers. Her studies included Latin (essential for the sciences), chemistry, biology and history, as well as topics more usual for young ladies in England. She took over the running of the family at age 15, after her mother's death, managing the house and helping to bring up her younger siblings."}}, {"canonical_name": "Angola", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "angola", "book_id": "kosmos_humboldt_1845", "name": "Angola", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Angola"], "contexts": ["location of magnetic zone"]}, {"entity_id": "angola", "book_id": "coloquios_da_orta_1563", "name": "Angola", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Angola"], "contexts": ["place where a plant is common"]}, {"entity_id": "angola", "book_id": "polyanthea_medicinal", "name": "Angola", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Angola"], "contexts": ["place of origin", "place mentioned for verification of creatures"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Angola", "target_book": "coloquios_da_orta_1563", "target_name": "Angola", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Angola", "target_book": "polyanthea_medicinal", "target_name": "Angola", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Angola", "target_book": "polyanthea_medicinal", "target_name": "Angola", "similarity": 1.0}], "id": 1950, "stable_key": "clu_ce43600962a378d5", "ground_truth": {"wikipedia_extract": "Angola, officially the Republic of Angola, is a country on the western coast of Southern Africa. It is the second-largest Portuguese-speaking (Lusophone) country after Brazil in both total area and population and is the seventh-largest country in Africa. It is bordered by Namibia to the south, the Democratic Republic of the Congo to the north, Zambia to the east, and the Atlantic Ocean to the west. Angola has an exclave province, the province of Cabinda, that borders the Republic of the Congo and the Democratic Republic of the Congo. The capital and most populous city is Luanda. Angola has been inhabited since the Palaeolithic Age."}}, {"canonical_name": "stability", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "stability", "book_id": "kosmos_humboldt_1845", "name": "stability", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["stability"], "contexts": ["resistance to change"]}, {"entity_id": "stability", "book_id": "connexion_physical_sciences_somerville_1858", "name": "stability", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["stability"], "contexts": ["of the solar system"]}, {"entity_id": "stability", "book_id": "first_principles_spencer_1862", "name": "stability", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["stability"], "contexts": ["state of being stable", "resistance to decomposition"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "stability", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "stability", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "stability", "target_book": "first_principles_spencer_1862", "target_name": "stability", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "stability", "target_book": "first_principles_spencer_1862", "target_name": "stability", "similarity": 1.0}], "id": 1951, "stable_key": "clu_19acbe85db436e71", "ground_truth": {"modern_name": "Stability", "confidence": "high", "type": "concept"}}, {"canonical_name": "lago", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "lake", "book_id": "kosmos_humboldt_1845", "name": "lake", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["lake"], "contexts": ["body of water formed by springs"]}, {"entity_id": "lago", "book_id": "polyanthea_medicinal", "name": "lago", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["lago"], "contexts": ["lizard's dung used in remedy", "lake"]}, {"entity_id": "lake", "book_id": "connexion_physical_sciences_somerville_1858", "name": "lake", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["lake"], "contexts": ["body of water surrounded by land"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "lake", "target_book": "polyanthea_medicinal", "target_name": "lago", "similarity": 0.944}, {"source_book": "kosmos_humboldt_1845", "source_name": "lake", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "lake", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "lago", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "lake", "similarity": 0.944}], "id": 1952, "stable_key": "clu_f3f783e0a40c5560", "ground_truth": {"modern_name": "Lake", "confidence": "high", "type": "place", "country": "Global", "note": "The context 'lizard's dung used in remedy' is unusual for 'lake' as a geographical feature. However, the overwhelming context points to a body of water.", "wikidata_id": "Q26736952", "wikidata_description": "island in Taliabu Island Regency, North Maluku Province, Indonesia"}}, {"canonical_name": "geological changes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "geological_changes", "book_id": "kosmos_humboldt_1845", "name": "geological changes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["geological changes"], "contexts": ["alterations to the Earth's surface"]}, {"entity_id": "geological_changes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Geological changes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Geological changes"], "contexts": ["probable cause discussed"]}, {"entity_id": "geologic_changes", "book_id": "first_principles_spencer_1862", "name": "geologic changes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["geologic changes"], "contexts": ["alterations in Earth's geological features"]}, {"entity_id": "geological_changes", "book_id": "first_principles_spencer_1862", "name": "geological changes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["geological changes"], "contexts": ["igneous and aqueous types"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "geological changes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Geological changes", "similarity": 0.996}, {"source_book": "kosmos_humboldt_1845", "source_name": "geological changes", "target_book": "first_principles_spencer_1862", "target_name": "geologic changes", "similarity": 0.997}, {"source_book": "kosmos_humboldt_1845", "source_name": "geological changes", "target_book": "first_principles_spencer_1862", "target_name": "geological changes", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Geological changes", "target_book": "first_principles_spencer_1862", "target_name": "geologic changes", "similarity": 0.99}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Geological changes", "target_book": "first_principles_spencer_1862", "target_name": "geological changes", "similarity": 0.996}], "id": 1953, "stable_key": "clu_bb264167ef63ab0f", "ground_truth": {"modern_name": "Geological change", "confidence": "high", "type": "concept", "wikidata_id": "Q28600987", "wikidata_description": "scientific article"}}, {"canonical_name": "Etiope", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "ethiopians", "book_id": "kosmos_humboldt_1845", "name": "Ethiopians", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Ethiopians"], "contexts": ["people whose color was discussed"]}, {"entity_id": "etiope", "book_id": "coloquios_da_orta_1563", "name": "Etiope", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Etiope"], "contexts": ["person to ask about beire", "meaning of Zangue zmcui"]}, {"entity_id": "ethiopes", "book_id": "polyanthea_medicinal", "name": "Ethiopes", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Ethiopes"], "contexts": ["people from Ethiopia"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Ethiopians", "target_book": "coloquios_da_orta_1563", "target_name": "Etiope", "similarity": 0.891}, {"source_book": "kosmos_humboldt_1845", "source_name": "Ethiopians", "target_book": "polyanthea_medicinal", "target_name": "Ethiopes", "similarity": 0.879}, {"source_book": "coloquios_da_orta_1563", "source_name": "Etiope", "target_book": "polyanthea_medicinal", "target_name": "Ethiopes", "similarity": 0.933}], "id": 1954, "stable_key": "clu_caedb77ad25cd2e8", "ground_truth": {"modern_name": "Ethiopian people", "confidence": "high", "type": "person", "description": "Inhabitants of the historical region of Ethiopia and surrounding areas."}}, {"canonical_name": "relaxacion de miem", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "relaxacion_de_miem", "book_id": "historia_medicinal_monardes_1574", "name": "relaxacion de miem", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 2, "variants": ["relaxacion de miem", "relaxaciones del eftomago"], "contexts": ["symptom caused by coldness", "loosening of the stomach"]}, {"entity_id": "relaxa\u00e7am", "book_id": "coloquios_da_orta_1563", "name": "relaxa\u00e7am", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["relaxa\u00e7am"], "contexts": ["condition of the gums"]}, {"entity_id": "relaxados", "book_id": "polyanthea_medicinal", "name": "relaxados", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["relaxados"], "contexts": ["limbs lacking tone"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "relaxacion de miem", "target_book": "coloquios_da_orta_1563", "target_name": "relaxa\u00e7am", "similarity": 0.916}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "relaxacion de miem", "target_book": "polyanthea_medicinal", "target_name": "relaxados", "similarity": 0.891}, {"source_book": "coloquios_da_orta_1563", "source_name": "relaxa\u00e7am", "target_book": "polyanthea_medicinal", "target_name": "relaxados", "similarity": 0.928}], "id": 1955, "stable_key": "clu_a1bf0384f07df285", "ground_truth": {"modern_name": "flaccidity", "confidence": "high", "type": "disease", "modern_term": "flaccidity", "note": "'Relaxacion de miem' translates to 'relaxation of members' or flaccidity. 'Relaxa\u00e7am' and 'relaxados' also refer to a loss of tone or flaccidity.", "wikidata_id": "Q102186557", "wikidata_description": "symptom", "wikipedia_extract": "Flaccid paralysis is a neurological condition characterized by weakness or paralysis and reduced muscle tone without other obvious cause (e.g., trauma). This abnormal condition may be caused by disease or by trauma affecting the nerves associated with the involved muscles. For example, if the somatic nerves to a skeletal muscle are severed, then the muscle will exhibit flaccid paralysis. When muscles enter this state, they become limp and cannot contract. This condition can become fatal if it affects the respiratory muscles, posing the threat of suffocation. It also occurs in the spinal shock stage in complete transection of the spinal cord occurring in injuries such as gunshot wounds."}}, {"canonical_name": "dieta", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "dieta", "book_id": "historia_medicinal_monardes_1574", "name": "dieta", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["dieta"], "contexts": ["necessary regimen for healing"]}, {"entity_id": "dieta", "book_id": "coloquios_da_orta_1563", "name": "dieta", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["dieta"], "contexts": ["medical regimen"]}, {"entity_id": "dieta", "book_id": "polyanthea_medicinal", "name": "dieta", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["dieta"], "contexts": ["diet", "medical practice for fevers"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "dieta", "target_book": "coloquios_da_orta_1563", "target_name": "dieta", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "dieta", "target_book": "polyanthea_medicinal", "target_name": "dieta", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "dieta", "target_book": "polyanthea_medicinal", "target_name": "dieta", "similarity": 1.0}], "id": 1956, "stable_key": "clu_f9b1226a044060b6", "ground_truth": {"modern_name": "dietary regimen", "confidence": "high", "type": "concept", "description": "A prescribed course of eating for health or medical treatment.", "note": "Encompasses diet, medical regimen, and the practice of dieting.", "wikipedia_extract": "Dieting is the practice of eating food in a regulated way to decrease, maintain, or increase body weight, or to prevent and treat diseases such as diabetes and obesity. As weight loss depends on calorie intake, different kinds of calorie-reduced diets, such as those emphasising particular macronutrients (low-fat, low-carbohydrate, etc.), have been shown to be no more effective than one another. As weight regain is common, diet success is best predicted by long-term adherence. Regardless, the outcome of a diet can vary widely depending on the individual. The first popular diet was \"Banting\", named after English undertaker William Banting. In his 1863 pamphlet, Letter on Corpulence, Addressed to the Public, he outlined the details of a particular low-carbohydrate, low-calorie diet that led to his own dramatic weight loss."}}, {"canonical_name": "conforta", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "conforta", "book_id": "historia_medicinal_monardes_1574", "name": "conforta", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["conforta"], "contexts": ["effect of Sulfur"]}, {"entity_id": "confortativo", "book_id": "coloquios_da_orta_1563", "name": "confortativo", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["confortativo"], "contexts": ["comforting quality"]}, {"entity_id": "confortao", "book_id": "coloquios_da_orta_1563", "name": "confortao", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["confortao"], "contexts": ["effect of benjuy on stomach"]}, {"entity_id": "confortantes", "book_id": "polyanthea_medicinal", "name": "confortantes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["confortantes"], "contexts": ["type of medical treatment"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "conforta", "target_book": "coloquios_da_orta_1563", "target_name": "confortativo", "similarity": 0.913}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "conforta", "target_book": "coloquios_da_orta_1563", "target_name": "confortao", "similarity": 0.925}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "conforta", "target_book": "polyanthea_medicinal", "target_name": "confortantes", "similarity": 0.89}, {"source_book": "coloquios_da_orta_1563", "source_name": "confortativo", "target_book": "polyanthea_medicinal", "target_name": "confortantes", "similarity": 0.894}, {"source_book": "coloquios_da_orta_1563", "source_name": "confortao", "target_book": "polyanthea_medicinal", "target_name": "confortantes", "similarity": 0.896}], "id": 1957, "stable_key": "clu_8e67ad6806c3b885", "ground_truth": {"modern_name": "Comforting property", "confidence": "medium", "type": "concept", "note": "The term 'conforta'/'confortativo' in early modern texts referred to a general property of providing comfort or strength, not a specific modern concept."}}, {"canonical_name": "David", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "david", "book_id": "coloquios_da_orta_1563", "name": "David", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["David"], "contexts": ["praised fragrant things"]}, {"entity_id": "david", "book_id": "polyanthea_medicinal", "name": "David", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["David"], "contexts": ["Biblical figure, psalmist"]}, {"entity_id": "rey_david", "book_id": "polyanthea_medicinal", "name": "Rey David", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Rey David"], "contexts": ["Biblical king cited for advice"]}, {"entity_id": "david", "book_id": "first_principles_spencer_1862", "name": "David", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["David"], "contexts": ["danced before the ark"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "David", "target_book": "polyanthea_medicinal", "target_name": "David", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "David", "target_book": "polyanthea_medicinal", "target_name": "Rey David", "similarity": 0.856}, {"source_book": "coloquios_da_orta_1563", "source_name": "David", "target_book": "first_principles_spencer_1862", "target_name": "David", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "David", "target_book": "first_principles_spencer_1862", "target_name": "David", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "Rey David", "target_book": "first_principles_spencer_1862", "target_name": "David", "similarity": 0.856}], "id": 1958, "stable_key": "clu_b1ded90e9665c7cf", "ground_truth": {"modern_name": "David", "confidence": "high", "type": "person", "description": "Biblical king and psalmist, cited as authority.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/David", "wikipedia_extract": "David (; Biblical Hebrew: \u05d3\u05b8\u05bc\u05d5\u05b4\u05d3\u200e, romanized: D\u0101w\u012b\u1e0f, \"beloved one\") was a king of ancient Israel and Judah, according to the Hebrew Bible and Old Testament. David's reign may have occurred around the 9th century BC, although the timeframe of his reign and geographical boundaries of his kingdom are disputed. Most of what is known of David comes from biblical literature, the historicity of which has been extensively challenged, and there is little detail about David that is concrete and undisputed. Debates persist over several controversial issues: whether the story serves as a political defense of David's dynasty against accusations of tyranny, murder and regicide; the homoerotic relationship between David and Jonathan; whether the text is a Homer-like heroic tale adopting elements from its Ancient Near East parallels; and whether elements of the text date as late as the Hasmonean period. In the biblical narrative of the Books of Samuel, David is described as a young shepherd and harpist whose heart is devoted to Yahweh, the one true God. He gains fame and becomes a hero by killing Goliath."}}, {"canonical_name": "curvature", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "curvatos", "book_id": "polyanthea_medicinal", "name": "curvatos", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["curvatos"], "contexts": ["curved"]}, {"entity_id": "curvature", "book_id": "connexion_physical_sciences_somerville_1858", "name": "curvature", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["curvature"], "contexts": ["degree of bending or curving"]}, {"entity_id": "curvature", "book_id": "first_principles_spencer_1862", "name": "curvature", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["curvature"], "contexts": ["property of being curved", "bending or curving"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "curvatos", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "curvature", "similarity": 0.88}, {"source_book": "polyanthea_medicinal", "source_name": "curvatos", "target_book": "first_principles_spencer_1862", "target_name": "curvature", "similarity": 0.88}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "curvature", "target_book": "first_principles_spencer_1862", "target_name": "curvature", "similarity": 1.0}], "id": 1959, "stable_key": "clu_981d3480ce115e5a", "ground_truth": {"modern_name": "Curvature", "confidence": "high", "type": "concept", "wikidata_id": "Q214881", "wikidata_description": "inverse of the radius of curvature", "wikipedia_url": "https://en.wikipedia.org/wiki/Curvature", "wikipedia_extract": "In mathematics, curvature is any of several strongly related concepts in geometry that intuitively measure the amount by which a curve deviates from being a straight line or by which a surface deviates from being a plane. If a curve or surface is contained in a larger space, curvature can be defined extrinsically relative to the ambient space. Curvature of Riemannian manifolds of dimension at least two can be defined intrinsically without reference to a larger space. For curves, curvature describes how sharply the curve bends. The canonical examples are circles: smaller circles bend more sharply and hence have higher curvature. For a point on a general curve, the direction of the curve is described by its  tangent line."}}, {"canonical_name": "journal", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "journal", "book_id": "medecine_experimentale_bernard_1865", "name": "journal", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["journal"], "contexts": ["publication of findings"]}, {"entity_id": "journal", "book_id": "kosmos_humboldt_1845", "name": "Journal", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Journal"], "contexts": ["Darwin's publication on geological observations"]}, {"entity_id": "journal", "book_id": "first_principles_spencer_1862", "name": "journal", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["journal"], "contexts": ["publication for scientific articles"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "journal", "target_book": "kosmos_humboldt_1845", "target_name": "Journal", "similarity": 0.891}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "journal", "target_book": "first_principles_spencer_1862", "target_name": "journal", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Journal", "target_book": "first_principles_spencer_1862", "target_name": "journal", "similarity": 0.891}], "id": 1960, "stable_key": "clu_9fb0883213c37163", "ground_truth": {"modern_name": "Scientific journal", "confidence": "high", "type": "text", "wikidata_id": "Q5633421", "wikidata_description": "periodical journal publishing scientific research"}}, {"canonical_name": "recherche scientifique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "recherche_scientifique", "book_id": "medecine_experimentale_bernard_1865", "name": "recherche scientifique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["recherche scientifique"], "contexts": ["the process of scientific inquiry"]}, {"entity_id": "scientific_research", "book_id": "principles_of_psychology_james_1890", "name": "scientific research", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["scientific research"], "contexts": ["systematic investigation for knowledge"]}, {"entity_id": "scientific_researches", "book_id": "kosmos_humboldt_1845", "name": "Scientific researches", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Scientific researches"], "contexts": ["frequent result, knowledge requirement"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "recherche scientifique", "target_book": "principles_of_psychology_james_1890", "target_name": "scientific research", "similarity": 0.954}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "recherche scientifique", "target_book": "kosmos_humboldt_1845", "target_name": "Scientific researches", "similarity": 0.887}, {"source_book": "principles_of_psychology_james_1890", "source_name": "scientific research", "target_book": "kosmos_humboldt_1845", "target_name": "Scientific researches", "similarity": 0.935}], "id": 1961, "stable_key": "clu_fe89fd9cd26992a6", "ground_truth": {"modern_name": "Scientific Research", "confidence": "high", "type": "concept", "note": "The term has been in continuous use with a consistent meaning."}}, {"canonical_name": "la th\u00e9ologie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "la_th\u00e9ologie", "book_id": "medecine_experimentale_bernard_1865", "name": "la th\u00e9ologie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["la th\u00e9ologie"], "contexts": ["study of the nature of God"]}, {"entity_id": "th\u00e9ologie", "book_id": "epoques_nature_buffon_1778", "name": "th\u00e9ologie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["th\u00e9ologie"], "contexts": ["study of God and religion"]}, {"entity_id": "th\u00e9ologie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "th\u00e9ologie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["th\u00e9ologie"], "contexts": ["study of religious doctrines"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "la th\u00e9ologie", "target_book": "epoques_nature_buffon_1778", "target_name": "th\u00e9ologie", "similarity": 0.962}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "la th\u00e9ologie", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "th\u00e9ologie", "similarity": 0.962}, {"source_book": "epoques_nature_buffon_1778", "source_name": "th\u00e9ologie", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "th\u00e9ologie", "similarity": 1.0}], "id": 1962, "stable_key": "clu_c84b5a51279bb7ac", "ground_truth": {"modern_name": "Theology", "confidence": "high", "type": "concept", "wikidata_id": "Q34178", "wikidata_description": "study of the nature of deities and religious beliefs", "wikipedia_url": "https://en.wikipedia.org/wiki/Theology", "wikipedia_extract": "Theology is the study of religious belief from a religious perspective, with a focus on the nature of divinity and the history behind religion. It is taught as an academic discipline, typically in universities and seminaries. It occupies itself with the unique content of analyzing the supernatural, but also deals with religious epistemology, asks and seeks to answer the question of revelation. Revelation pertains to the acceptance of God, gods, or deities, as not only transcendent or above the natural world, but also willing and able to interact with the natural world and to reveal themselves to humankind. Theologians use various forms of analysis and argument (experiential, philosophical, ethnographic, historical, and others) to help understand, explain, test, critique, defend or promote any myriad of religious topics. As in philosophy of ethics and case law, arguments often assume the existence of previously resolved questions, and develop by making analogies from them to draw new inferences in new situations."}}, {"canonical_name": "observations directes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "observations_directes", "book_id": "medecine_experimentale_bernard_1865", "name": "observations directes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["observations directes"], "contexts": ["direct empirical observations"]}, {"entity_id": "observa\u00e7\u00f5es_directas", "book_id": "coloquios_da_orta_1563", "name": "observa\u00e7\u00f5es directas", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["observa\u00e7\u00f5es directas"], "contexts": ["direct observations"]}, {"entity_id": "direct_observation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Direct Observation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Direct Observation"], "contexts": ["method of parallax measurement"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "observations directes", "target_book": "coloquios_da_orta_1563", "target_name": "observa\u00e7\u00f5es directas", "similarity": 0.969}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "observations directes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Direct Observation", "similarity": 0.911}], "id": 1963, "stable_key": "clu_258de18cd2fd0dd4", "ground_truth": {"modern_name": "direct observation", "confidence": "high", "type": "concept", "wikidata_id": "Q29616032", "wikidata_description": "scientific article (publication date: December 2006)"}}, {"canonical_name": "sceptique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "sceptique", "book_id": "medecine_experimentale_bernard_1865", "name": "sceptique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sceptique"], "contexts": ["one who doubts everything"]}, {"entity_id": "sceptic", "book_id": "principles_of_psychology_james_1890", "name": "sceptic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sceptic"], "contexts": ["philosophical stance of doubt"]}, {"entity_id": "sceptic", "book_id": "first_principles_spencer_1862", "name": "sceptic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sceptic"], "contexts": ["philosophical position doubting knowledge"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "sceptique", "target_book": "principles_of_psychology_james_1890", "target_name": "sceptic", "similarity": 0.934}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "sceptique", "target_book": "first_principles_spencer_1862", "target_name": "sceptic", "similarity": 0.934}, {"source_book": "principles_of_psychology_james_1890", "source_name": "sceptic", "target_book": "first_principles_spencer_1862", "target_name": "sceptic", "similarity": 1.0}], "id": 1964, "stable_key": "clu_b47507f65e6453a6-2", "ground_truth": {"modern_name": "Skepticism", "confidence": "high", "type": "concept", "wikidata_id": "Q1395219", "wikidata_description": "questioning attitude or doubt toward knowledge claims that are seen as mere belief or dogma", "wikipedia_url": "https://en.wikipedia.org/wiki/Skepticism", "wikipedia_extract": "Skepticism (US) or scepticism (UK) is a questioning attitude or doubt toward knowledge claims that are seen as mere belief or dogma. For example, if a person is skeptical about claims made by their government about an ongoing war then the person doubts that these claims are accurate. In such cases, skeptics normally recommend not disbelief but suspension of belief, i.e. maintaining a neutral attitude that neither affirms nor denies the claim. This attitude is often motivated by the impression that the available evidence is insufficient to support the claim. Formally, skepticism is a topic of interest in philosophy, particularly epistemology."}}, {"canonical_name": "inspiration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "inspiration", "book_id": "medecine_experimentale_bernard_1865", "name": "inspiration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["inspiration"], "contexts": ["sudden creative or divine impulse"]}, {"entity_id": "inspiration", "book_id": "kosmos_humboldt_1845", "name": "inspiration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["inspiration"], "contexts": ["mysterious revelation of laws"]}, {"entity_id": "inspira\u00e7\u00e3o", "book_id": "polyanthea_medicinal", "name": "inspira\u00e7\u00e3o", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["inspira\u00e7\u00e3o"], "contexts": ["act of breathing in"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "inspiration", "target_book": "kosmos_humboldt_1845", "target_name": "inspiration", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "inspiration", "target_book": "polyanthea_medicinal", "target_name": "inspira\u00e7\u00e3o", "similarity": 0.958}, {"source_book": "kosmos_humboldt_1845", "source_name": "inspiration", "target_book": "polyanthea_medicinal", "target_name": "inspira\u00e7\u00e3o", "similarity": 0.958}], "id": 1965, "stable_key": "clu_5b6bdc39f6f2a83c", "ground_truth": {"modern_name": "inspiration", "confidence": "high", "type": "concept"}}, {"canonical_name": "principe vital", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "principe_vital", "book_id": "medecine_experimentale_bernard_1865", "name": "principe vital", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["principe vital"], "contexts": ["hypothetical vital force in living bodies"]}, {"entity_id": "vital_principle", "book_id": "principles_of_psychology_james_1890", "name": "vital principle", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["vital principle"], "contexts": ["principle presiding over body formation"]}, {"entity_id": "vital_principle", "book_id": "first_principles_spencer_1862", "name": "vital principle", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["vital principle"], "contexts": ["hypothetical force animating life"]}], "edges": [{"source_book": "medecine_experimentale_