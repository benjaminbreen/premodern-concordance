 a concept, it is generally applicable.", "wikidata_id": "Q681708", "wikidata_description": "city in and county seat of Shelby County, Texas, United States"}}, {"canonical_name": "mechanical force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 10, "members": [{"entity_id": "mechanical_force", "book_id": "principles_of_psychology_james_1890", "name": "mechanical force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["mechanical force"], "contexts": ["single peculiarity of moving power", "force used in machines"]}, {"entity_id": "physical_force", "book_id": "principles_of_psychology_james_1890", "name": "physical force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["physical force"], "contexts": ["energy associated with physical phenomena"]}, {"entity_id": "mechanical_force", "book_id": "connexion_physical_sciences_somerville_1858", "name": "mechanical force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["mechanical force"], "contexts": ["force exerted by mechanical systems", "force causing motion or work"]}, {"entity_id": "mechanical_force", "book_id": "first_principles_spencer_1862", "name": "mechanical force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["mechanical force"], "contexts": ["external force applied to an aggregate", "force from collision"]}, {"entity_id": "physical_force", "book_id": "first_principles_spencer_1862", "name": "physical force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["physical force"], "contexts": ["fundamental force in nature"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "mechanical force", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "mechanical force", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "mecha