": 947, "members": [{"entity_id": "humor", "book_id": "english_physician_1652", "name": "Humor", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["humor", "Humor"], "contexts": ["bodily fluid in ancient medicine", "bodily fluid"]}, {"entity_id": "humor", "book_id": "historia_medicinal_monardes_1574", "name": "humor", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 20, "variants": ["humor", "humor malo", "humores", "humores cholericos", "humores mixtos", "humores mugicalientes", "humorescholericos"], "contexts": ["bodily fluid to be evacuated", "body fluid in humoral theory"]}, {"entity_id": "humor_adusto", "book_id": "coloquios_da_orta_1563", "name": "humor adusto", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["humor adusto"], "contexts": ["burnt humor, a bodily fluid"]}, {"entity_id": "humor", "book_id": "ricettario_fiorentino_1597", "name": "humor", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["humor", "humori"], "contexts": ["fluid in which infusions are made", "bodily fluids, humors"]}, {"entity_id": "humores", "book_id": "polyanthea_medicinal", "name": "humores", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 920, "variants": ["humores", "Humorce", "acrimoniados humores", "azedume dos humores", "humor", "humor Aqueo", "humor Vitreo", "humor acido", "humor acidus", "humor acre", "humor aqueo", "humor azedo", "humor benigno", "humor delgado", "humor forein", "humor peccantis", "humor seroso", "humor visco\u017fo", "humor vitreo", "humoraquo\u017fo", "humorcolerico", "humordelgado", "humores ... feculentos", "humores Aqueo", "humores a quo\u017fos", "humores accidos", "humores acido-falinos", "humores acido-ponticos", "humores acidos", "humores acres", "humores acres, & delgados", "humores acrimoniados", "humores acrimoniofos", "humores adustos", "humores aquofos", "humores aquosos", "humores atros", "humores au\u017fteros", "humores azedos", "humores bons", "humores bumidi", "humores cacochimicos", "humores cacochymicos", "humores colericos", "humores colericos , ou forofos", "humores corrosivos", "humores crus", "humores cruscaufados", "humores cr\u00f9s", "humores danofos", "humores delgados", "humores depravados", "humores errantes", "humores exaltados", "humores excrementicios", "humores extrava\u017fados", "humores falgados", "humores fal\u017fuginofos", "humores fa\u00f5acres", "humores feculentos", "humores feminaes", "humores fer", "humores ferofos", "humores ferolos", "humores ferotos", "humores fixos", "humores flcymaticos", "humores fleymaticos", "humores fl\u00e9ymaticos", "humores forofos", "humores groffos", "humores grofios", "humores groflos", "humores grossos", "humores gro\u017flos", "humores gro\u017f\u017fos", "humores gumofos", "humores laudaveis", "humores leymaticos", "humores lymphaticos", "humores malignos", "humores mordazes", "humores narcoticos", "humores nocivos", "humores picantes", "humores podres", "humores podridos,y corruptos", "humores putres", "humores quentes", "humores salgados", "humores salgados, tenues, & serosos", "humores se coz\u00e3o", "humores serofos", "humores superfluos", "humores tartareos", "humores tenues", "humores terrestres", "humores turgentes", "humores venenosos", "humores veneno\u017fi\u017fimos", "humores viciosos", "humores vifcofos", "humores viscolos", "humores viscosos", "humores vi\u017fcolos", "humores vi\u017fco\u017fos", "humores \u017feccos", "humores \u017ferofos", "humores.corruptos", "humoresdelcogados", "humoresdelgados", "humoresgro\u017fios", "humorfit", "humorgro\u017f\u017fo", "humoribus", "humoris", "humorum", "humor\u00e9s", "venenofos humores"], "contexts": ["bodily fluids in humoral theory", "chapter title about humors"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Humor", "target_book": "historia_medicinal_monardes_1574", "target_name": "humor", "similarity": 0.945}, {"source_book": "english_physician_1652", "source_name": "Humor", "target_book": "coloquios_da_orta_1563", "target_name": "humor adusto", "similarity": 0.887}, {"source_book": "english_physician_1652", "source_name": "Humor", "target_book": "ricettario_fiorentino_1597", "target_name": "humor", "similarity": 0.945}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "humor", "target_book": "coloquios_da_orta_1563", "target_name": "humor adusto", "similarity": 0.937}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "humor", "target_book": "ricettario_fiorentino_1597", "target_name": "humor", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "humor", "target_book": "polyanthea_medicinal", "target_name": "humores", "similarity": 0.924}, {"source_book": "coloquios_da_orta_1563", "source_name": "humor adusto", "target_book": "ricettario_fiorentino_1597", "target_name": "humor", "similarity": 0.937}, {"source_book": "ricettario_fiorentino_1597", "source_name": "humor", "target_book": "polyanthea_medicinal", "target_name": "humores", "similarity": 0.924}], "id": 47, "stable_key": "clu_1f51272bced1601a", "ground_truth": {"modern_name": "Humors", "confidence": "high", "type": "concept", "description": "Bodily fluids central to humoral theory, believed to influence health and temperament.", "note": "Includes specific types like 'humor adusto' and 'humor phleugmatico'.", "wikipedia_extract": "Humorism, the humoral theory, or humoralism, was a system of medicine detailing a supposed makeup and workings of the human body, adopted by Ancient Greek and Roman physicians and philosophers. Humorism began to fall out of favor in the 17th century and it was definitively disproved with the discovery of microbes. The concept of \"humors\" may have origins in Ancient Egyptian medicine, or Mesopotamia, though it was not systemized until ancient Greek thinkers. The word humor is a translation of Greek \u03c7\u03c5\u03bc\u03cc\u03c2, chymos (literally 'juice' or 'sap', metaphorically 'flavor'). Early texts on Indian Ayurveda medicine presented a theory of three or four humors (do\u1e63as), which they sometimes linked with the five elements (pa\u00f1ca-bh\u016bta): earth, water, fire, air, and space. The concept of \"humors\" (chemical systems regulating human behaviour) became more prominent from the writing of medical theorist Alcmaeon of Croton (c. 540\u2013500 BC)."}}, {"canonical_name": "Galen", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 5, "total_mentions": 501, "members": [{"entity_id": "galen", "book_id": "medecine_experimentale_bernard_1865", "name": "Galen", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Galen"], "contexts": ["ancient medical authority"]}, {"entity_id": "galen", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Galen", "category": "PERSON", "subcategory": "AUTHORITY", "count": 18, "variants": ["Galen"], "contexts": ["ancient Greek physician and philosopher", "ancient Roman physician"]}, {"entity_id": "galen", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Galen", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Galen"], "contexts": ["ancient medical authority"]}, {"entity_id": "galen", "book_id": "kosmos_humboldt_1845", "name": "Galen", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Galen"], "contexts": ["attests Pythagoras named Cosmos"]}, {"entity_id": "galen", "book_id": "polyanthea_medicinal", "name": "Galen", "category": "PERSON", "subcategory": "AUTHORITY", "count": 478, "variants": ["Galen", "Gale", "Galem", "Galen.", "Galen. de cur. Ieteri", "Galen.inMeth. ibi", "Galeni", "Galenicos", "Galeni\u017ftas", "Galeno", "Galenum", "Galenus", "Galenuslib", "Galia", "Galieno", "Galon"], "contexts": ["ancient medical authority", "ancient medical authority cited multiple times"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "Galen", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Galen", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Galen", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Galen", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Galen", "target_book": "kosmos_humboldt_1845", "target_name": "Galen", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Galen", "target_book": "polyanthea_medicinal", "target_name": "Galen", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Galen", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Galen", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Galen", "target_book": "kosmos_humboldt_1845", "target_name": "Galen", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Galen", "target_book": "polyanthea_medicinal", "target_name": "Galen", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Galen", "target_book": "kosmos_humboldt_1845", "target_name": "Galen", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Galen", "target_book": "polyanthea_medicinal", "target_name": "Galen", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Galen", "target_book": "polyanthea_medicinal", "target_name": "Galen", "similarity": 1.0}], "id": 48, "stable_key": "clu_57c0f703d572d61a", "ground_truth": {"modern_name": "Galen", "confidence": "high", "type": "person", "description": "Ancient Greek physician and highly influential medical authority.", "note": "Refers to the ancient physician, not the planet or musician.", "wikipedia_extract": "Aelius Galenus or Claudius Galenus (Greek: \u039a\u03bb\u03b1\u03cd\u03b4\u03b9\u03bf\u03c2 \u0393\u03b1\u03bb\u03b7\u03bd\u03cc\u03c2; September 129 \u2013 c.\u2009216 CE), often anglicized as Galen () or Galen of Pergamon, was a Roman and Greek physician, surgeon, and philosopher. Considered to be one of the most accomplished of all medical researchers of antiquity, Galen influenced the development of various scientific disciplines, including anatomy, physiology, pathology, pharmacology, and neurology, as well as philosophy and logic. The son of Aelius Nicon, a wealthy Greek architect with scholarly interests, Galen received a comprehensive education that prepared him for a successful career as a physician and philosopher. Born in the ancient city of Pergamon (present-day Bergama, Turkey), Galen traveled extensively, exposing himself to a wide variety of medical theories and discoveries before settling in Rome, where he served prominent members of Roman society and eventually was given the position of personal physician to several emperors. Galen's understanding of anatomy and medicine was principally influenced by the contemporary theory of the four humors: black bile, yellow bile, blood, and phlegm, as first advanced by the author of On the Nature of Man in the Hippocratic corpus. Galen's views dominated and influenced Western medical science for more than 1,300 years."}}, {"canonical_name": "consciousness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 439, "members": [{"entity_id": "consciousness", "book_id": "medecine_experimentale_bernard_1865", "name": "consciousness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["consciousness"], "contexts": ["awareness of mental states"]}, {"entity_id": "consciousness", "book_id": "principles_of_psychology_james_1890", "name": "consciousness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 314, "variants": ["Consciousness", "CONSCIOUSNESS", "consciousness"], "contexts": ["awareness of mental states", "personal form, constant change"]}, {"entity_id": "consciousness", "book_id": "kosmos_humboldt_1845", "name": "consciousness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["consciousness"], "contexts": ["awareness of universality of life"]}, {"entity_id": "consciousness", "book_id": "connexion_physical_sciences_somerville_1858", "name": "consciousness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["consciousness"], "contexts": ["awareness of sensory fallacy"]}, {"entity_id": "consciousness", "book_id": "first_principles_spencer_1862", "name": "consciousness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 122, "variants": ["consciousness"], "contexts": ["succession of mental states", "awareness of mental states"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "consciousness", "target_book": "principles_of_psychology_james_1890", "target_name": "consciousness", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "consciousness", "target_book": "kosmos_humboldt_1845", "target_name": "consciousness", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "consciousness", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "consciousness", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "consciousness", "target_book": "first_principles_spencer_1862", "target_name": "consciousness", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "consciousness", "target_book": "kosmos_humboldt_1845", "target_name": "consciousness", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "consciousness", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "consciousness", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "consciousness", "target_book": "first_principles_spencer_1862", "target_name": "consciousness", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "consciousness", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "consciousness", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "consciousness", "target_book": "first_principles_spencer_1862", "target_name": "consciousness", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "consciousness", "target_book": "first_principles_spencer_1862", "target_name": "consciousness", "similarity": 1.0}], "id": 49, "stable_key": "clu_fad1e6499454b3ca", "ground_truth": {"modern_name": "consciousness", "confidence": "high", "type": "concept", "note": "The overwhelming number of occurrences of 'consciousness' and related terms in William James's work firmly identifies this cluster.", "wikidata_id": "Q4313500", "wikidata_description": "medical condition that inhibits consciousness, sprituality", "wikipedia_url": "https://en.wikipedia.org/wiki/Disorder%20of%20consciousness", "wikipedia_extract": "Consciousness is being aware of something internal to one's self or being conscious of states or objects in one's external environment. It has been the topic of extensive explanations, analyses, and debate among philosophers, scientists, and theologians for millennia. There is no consensus on what exactly needs to be studied, or even if consciousness can be considered a scientific concept. In some explanations, it is synonymous with mind, while in others it is considered an aspect of it. In the past, consciousness meant one's \"inner life\": the world of introspection, private thought, imagination, and volition. Today, it often includes any kind of cognition, experience, feeling, or perception."}}, {"canonical_name": "Hippocrates", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 5, "total_mentions": 264, "members": [{"entity_id": "hippocrates", "book_id": "medecine_experimentale_bernard_1865", "name": "Hippocrates", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Hippocrates"], "contexts": ["ancient Greek physician"]}, {"entity_id": "hippocrates", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Hippocrates", "category": "PERSON", "subcategory": "AUTHORITY", "count": 6, "variants": ["Hippocrates"], "contexts": ["ancient Greek physician", "ancient physician, source for Aristotle"]}, {"entity_id": "hippocrates", "book_id": "kosmos_humboldt_1845", "name": "Hippocrates", "category": "PERSON", "subcategory": "AUTHORITY", "count": 4, "variants": ["Hippocrates"], "contexts": ["ancient Greek physician", "ancient physician"]}, {"entity_id": "hippocrates", "book_id": "coloquios_da_orta_1563", "name": "Hippocrates", "category": "PERSON", "subcategory": "AUTHORITY", "count": 7, "variants": ["Hippocrates", "Hipocras", "Hypocras", "H\u00edppocrates"], "contexts": ["ancient medical authority", "Ancient Greek physician"]}, {"entity_id": "hippocrates", "book_id": "polyanthea_medicinal", "name": "Hippocrates", "category": "PERSON", "subcategory": "AUTHORITY", "count": 246, "variants": ["Hippocrates", "Hip-poci.", "Hipocrates", "Hippo", "Hippoc", "Hippoc.", "Hippocr", "Hippocr.", "Hippocrat", "Hippocrat.", "Hippocrate", "Hippocrates loco fupracitato", "Hippocrati", "Hippocratica", "Hippocratis", "Hippocratos", "Idem Hippocrates"], "contexts": ["ancient physician who wrote in Greek", "ancient physician cited"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "Hippocrates", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Hippocrates", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Hippocrates", "target_book": "kosmos_humboldt_1845", "target_name": "Hippocrates", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Hippocrates", "target_book": "coloquios_da_orta_1563", "target_name": "Hippocrates", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "Hippocrates", "target_book": "polyanthea_medicinal", "target_name": "Hippocrates", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hippocrates", "target_book": "kosmos_humboldt_1845", "target_name": "Hippocrates", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hippocrates", "target_book": "coloquios_da_orta_1563", "target_name": "Hippocrates", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hippocrates", "target_book": "polyanthea_medicinal", "target_name": "Hippocrates", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Hippocrates", "target_book": "coloquios_da_orta_1563", "target_name": "Hippocrates", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Hippocrates", "target_book": "polyanthea_medicinal", "target_name": "Hippocrates", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Hippocrates", "target_book": "polyanthea_medicinal", "target_name": "Hippocrates", "similarity": 1.0}], "id": 50, "stable_key": "clu_64199b595f01a3f7", "ground_truth": {"modern_name": "Hippocrates", "confidence": "high", "type": "person", "description": "Ancient Greek physician, father of medicine", "wikidata_id": "Q5264", "wikidata_description": "Greek physician (c.\u2009460 \u2013 c.\u2009370 BC)", "wikipedia_url": "https://en.wikipedia.org/wiki/Hippocrates", "wikipedia_extract": "Hippocrates of Kos (; Ancient Greek: \u1f39\u03c0\u03c0\u03bf\u03ba\u03c1\u03ac\u03c4\u03b7\u03c2 \u1f41 \u039a\u1ff7\u03bf\u03c2, romanized: Hippokr\u00e1t\u0113s ho K\u00f4ios; c. 460 \u2013 c. 370 BC), also known as Hippocrates II, was a Greek physician and philosopher of the classical period who is considered one of the most outstanding figures in the history of medicine. He is traditionally referred to as the \"Father of Medicine\" in recognition of his lasting contributions to the field, such as the use of prognosis and clinical observation, the systematic categorization of diseases, and the (later discredited) formulation of humoral theory. His studies set out the basic ideas of modern-day specialties, including surgery, urology, neurology, acute medicine and orthopedics, and advanced the systematic study of clinical medicine. The Hippocratic school of medicine revolutionized ancient Greek medicine, establishing it as a discipline distinct from other fields with which it had traditionally been associated (theurgy and philosophy), thus establishing medicine as a profession."}}, {"canonical_name": "calor", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 5, "total_mentions": 233, "members": [{"entity_id": "chaleur", "book_id": "epoques_nature_buffon_1778", "name": "chaleur", "category": "CONCEPT", "subcategory": "QUALITY", "count": 24, "variants": ["chaleur"], "contexts": ["cause of fluidity", "internal heat of the earth"]}, {"entity_id": "calor", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "calor", "category": "CONCEPT", "subcategory": "QUALITY", "count": 24, "variants": ["calor"], "contexts": ["quality of leaves", "quality associated with fevers"]}, {"entity_id": "chaleur", "book_id": "relation_historique_humboldt_vol3_1825", "name": "chaleur", "category": "CONCEPT", "subcategory": "QUALITY", "count": 15, "variants": ["chaleur"], "contexts": ["physical property of temperature", "heat"]}, {"entity_id": "calor", "book_id": "coloquios_da_orta_1563", "name": "calor", "category": "CONCEPT", "subcategory": "QUALITY", "count": 8, "variants": ["calor", "calor e secura"], "contexts": ["quality of heat", "implied quality of substances"]}, {"entity_id": "calor", "book_id": "polyanthea_medicinal", "name": "calor", "category": "CONCEPT", "subcategory": "QUALITY", "count": 162, "variants":