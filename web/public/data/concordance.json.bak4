MAL", "book_count": 6, "total_mentions": 95, "members": [{"entity_id": "viande", "book_id": "relation_historique_humboldt_vol3_1825", "name": "viande", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["viande"], "contexts": ["food product from animals", "meat whose fried smell is characteristic"]}, {"entity_id": "meats", "book_id": "principles_of_psychology_james_1890", "name": "meats", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["meats"], "contexts": ["food source with flavor"]}, {"entity_id": "carni", "book_id": "ricettario_fiorentino_1597", "name": "carni", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["carni"], "contexts": ["animal flesh for cooking"]}, {"entity_id": "carne", "book_id": "polyanthea_medicinal", "name": "carne", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 81, "variants": ["carne", "CARNE", "Carne", "Carneiro", "Carneyro", "Carneyros", "carne assada", "carne crua de C\u00e1gados", "carne de porco", "carne de vaca", "carne de vacca", "carne de vacca crua", "carne de vacca fresca", "carne de vitela", "carne debode", "carne devacca", "carne devacca mal a\u017f\u017fada", "carne fre\u017fca", "carnede vacca", "carnede vacca fre\u017fca", "carnedeVacca", "carnedeVitela", "carneiro", "carnes", "carneyro", "cevode carneiro", "cevode carneyro", "figado de carneiro"], "contexts": ["flesh", "bodily tissue"]}, {"entity_id": "meat", "book_id": "polyanthea_medicinal", "name": "meat", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["meat"], "contexts": ["cooked and squeezed"]}, {"entity_id": "carne", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "carne", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 7, "variants": ["carne"], "contexts": ["flesh from which thorns are extracted", "animal flesh for consumption"]}, {"entity_id": "carnes", "book_id": "historia_medicinal_monardes_1574", "name": "carne