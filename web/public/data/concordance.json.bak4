ences", "confidence": "high", "type": "concept", "note": "This cluster clearly refers to the Acad\u00e9mie des sciences in France, a prominent scientific institution in the early modern period. The recurring French name and English translation confirm this.", "wikidata_id": "Q188771", "wikidata_description": "learned society, founded in 1666 by Louis XIV at the suggestion of Jean-Baptiste Colbert, to encourage and protect the spirit of French scientific research", "wikipedia_url": "https://en.wikipedia.org/wiki/French%20Academy%20of%20Sciences"}}, {"canonical_name": "d\u00e9duction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "d\u00e9duction", "book_id": "medecine_experimentale_bernard_1865", "name": "d\u00e9duction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["d\u00e9duction"], "contexts": ["reasoning from general to specific", "scientific method of reasoning"]}, {"entity_id": "deduction", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Deduction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Deduction"], "contexts": ["process of reasoning from general to specific"]}, {"entity_id": "deduction", "book_id": "principles_of_psychology_james_1890", "name": "deduction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["deduction"], "contexts": ["reasoning from general to specific"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "d\u00e9duction", "target_book": "pseudodoxia_epidemica_browne_1646", "target_name": "Deduction", "similarity": 0.956}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "d\u00e9duction", "target_book": "principles_of_psychology_james_1890", "target_name": "deduction", "similarity": 0.972}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Deduction", "target_book": "principles_of_psychol