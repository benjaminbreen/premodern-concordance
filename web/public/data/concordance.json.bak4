urce_book": "principles_of_psychology_james_1890", "source_name": "effect", "target_book": "first_principles_spencer_1862", "target_name": "effect", "similarity": 1.0}], "id": 4166, "stable_key": "clu_36d7ecd45914c681", "ground_truth": {"modern_name": "effect", "confidence": "high", "type": "concept"}}, {"canonical_name": "Palermo", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "palermo", "book_id": "kosmos_humboldt_1845", "name": "Palermo", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Palermo"], "contexts": ["city where measurements were taken", "city in Italy"]}, {"entity_id": "palermo", "book_id": "polyanthea_medicinal", "name": "Palermo", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Palermo"], "contexts": ["City where a patient was treated"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Palermo", "target_book": "polyanthea_medicinal", "target_name": "Palermo", "similarity": 1.0}], "id": 4167, "stable_key": "clu_5a00a2ac01187c3a", "ground_truth": {"modern_name": "Palermo", "confidence": "high", "type": "place", "country": "Italy", "wikidata_id": "Q2656", "wikidata_description": "Italian city, capital of Sicily"}}, {"canonical_name": "birches", "category": "PLANT", "subcategory": "TREE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "birches", "book_id": "kosmos_humboldt_1845", "name": "birches", "category": "PLANT", "subcategory": "TREE", "count": 3, "variants": ["birches"], "contexts": ["tree species in Himalaya", "dwarf and tall stemmed trees"]}, {"entity_id": "birch", "book_id": "connexion_physical_sciences_somerville_1858", "name": "birch", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["birch"], "contexts": ["deciduous tree with distinctive bark"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "birches", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "birch", "similarity": 0.926}], "id": 4168, "stable_key": "clu_6e7d9c7303035b13", "ground_truth": {"modern_name": "Birch", "confidence": "high", "type": "plant", "linnaean": "Betula L.", "family": "Betulaceae", "wikidata_id": "Q25243", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Birch", "wikipedia_extract": "A birch is a thin-leaved deciduous hardwood tree of the genus Betula (), in the family Betulaceae, which also includes alders, hazels, and hornbeams. It is closely related to the beech-oak family Fagaceae. The genus Betula contains 30 to 60 known taxa of which 11 are on the IUCN 2011 Red List of Threatened Species. They are typically short-lived pioneer species and are widespread in the Northern Hemisphere, particularly in northern areas of temperate climates and in boreal climates. Birch wood is used for a wide range of purposes. Birch species are generally small to medium-sized trees or shrubs, mostly of northern temperate and boreal climates."}}, {"canonical_name": "Lassen", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "lassen", "book_id": "kosmos_humboldt_1845", "name": "Lassen", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Lassen"], "contexts": ["author of Indische Alterthumskunde", "scholar who interpreted Eugubine Tables"]}, {"entity_id": "lassen", "book_id": "coloquios_da_orta_1563", "name": "Lassen", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Lassen"], "contexts": ["investigator of Indian antiquities"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Lassen", "target_book": "coloquios_da_orta_1563", "target_name": "Lassen", "similarity": 1.0}], "id": 4169, "stable_key": "clu_cd569aa2fddfe028", "ground_truth": {"modern_name": "Christian Lassen", "confidence": "high", "type": "person", "birth_year": 1800, "death_year": 1876, "description": "German philologist and historian, specialist in Sanskrit and Indian studies.", "note": "The 'coloquios_da_orta_1563' reference is anomalous given Lassen's lifespan. It might be an anachronistic attribution or a separate person with the same surname.", "wikidata_id": "Q84861", "wikidata_description": "Norwegian-German orientalist (1800-1876)"}}, {"canonical_name": "physical philosophy", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "physical_philosophy", "book_id": "kosmos_humboldt_1845", "name": "physical philosophy", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["physical philosophy"], "contexts": ["study of nature based on scientific principles", "system of imperfect dogmas and prejudices"]}, {"entity_id": "physical_philosophy", "book_id": "first_principles_spencer_1862", "name": "physical philosophy", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["physical philosophy"], "contexts": ["early natural philosophy"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "physical philosophy", "target_book": "first_principles_spencer_1862", "target_name": "physical philosophy", "similarity": 1.0}], "id": 4170, "stable_key": "clu_dc6b7284fcd174a1-2", "ground_truth": {"modern_name": "natural philosophy", "confidence": "high", "type": "concept", "wikidata_id": "Q17791731", "wikidata_description": "university building in City of Edinburgh, Scotland, UK"}}, {"canonical_name": "vegetable kingdom", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "vegetable_kingdom", "book_id": "kosmos_humboldt_1845", "name": "vegetable kingdom", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["vegetable kingdom"], "contexts": ["all plant life forms", "all plant life"]}, {"entity_id": "vegetal_kingdoms", "book_id": "first_principles_spencer_1862", "name": "vegetal kingdoms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["vegetal kingdoms"], "contexts": ["classification for plants"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "vegetable kingdom", "target_book": "first_principles_spencer_1862", "target_name": "vegetal kingdoms", "similarity": 0.9}], "id": 4171, "stable_key": "clu_023ecb8934131cba", "ground_truth": {"modern_name": "Plant kingdom", "confidence": "high", "type": "concept"}}, {"canonical_name": "Baron Humboldt", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "baron_humboldt", "book_id": "kosmos_humboldt_1845", "name": "Baron Humboldt", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Baron Humboldt"], "contexts": ["author of a work on planets", "visited Jorullo volcano"]}, {"entity_id": "baron_humboldt", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Baron Humboldt", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Baron Humboldt"], "contexts": ["naturalist observing plant growth"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Baron Humboldt", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Baron Humboldt", "similarity": 1.0}], "id": 4172, "stable_key": "clu_baf9b5edab0f7714-4", "ground_truth": {"modern_name": "Alexander von Humboldt", "confidence": "high", "type": "person", "birth_year": 1769, "death_year": 1859, "description": "Prussian explorer and naturalist, key figure in biogeography", "wikidata_id": "Q6694", "wikidata_description": "Prussian geographer, naturalist and explorer (1769\u20131859)", "wikipedia_url": "https://en.wikipedia.org/wiki/Alexander%20von%20Humboldt", "wikipedia_extract": "Friedrich Wilhelm Heinrich Alexander von Humboldt (14 September 1769 \u2013 6 May 1859) was a German polymath, geographer, naturalist, explorer, and proponent of Romantic philosophy and science. He was the younger brother of the Prussian minister, philosopher, and linguist Wilhelm von Humboldt (1767\u20131835). Humboldt's quantitative work on botanical geography laid the foundation for the field of biogeography, while his advocacy of long-term systematic geophysical measurement pioneered modern geomagnetic and meteorological monitoring. Humboldt and Carl Ritter are both regarded as the founders of modern geography as they established it as an independent scientific discipline. Between 1799 and 1804, Humboldt travelled extensively in the Americas, exploring and describing them for the first time from a non-Spanish European scientific point of view. On these travels, along with French explorer Aim\u00e9 Bonpland, he traversed thousands of miles through some of the most difficult and little-known places on Earth, to include identifying the source of the Orinoco River and in 1802 climbing the highest mountain in Ecuador to a height of 19,286 feet, at the time a world record altitude for a Westerner.", "note": "While 'Long' and 'Lange' are the exact OCR, context strongly suggests Humboldt's exploration of the Rocky Mountains and his scientific writings."}}, {"canonical_name": "sun's disk", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "sun's_disk", "book_id": "kosmos_humboldt_1845", "name": "sun's disk", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["sun's disk"], "contexts": ["celestial body's visible surface", "visible surface of the sun"]}, {"entity_id": "solar_disc", "book_id": "connexion_physical_sciences_somerville_1858", "name": "solar disc", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["solar disc"], "contexts": ["visible surface of the sun"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "sun's disk", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "solar disc", "similarity": 0.934}], "id": 4173, "stable_key": "clu_462d255579fbb8fe", "ground_truth": {"modern_name": "Sun's disk", "confidence": "high", "type": "object", "note": "Refers to the visible surface of the sun, a celestial object.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "magnetic intensity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "magnetic_intensity", "book_id": "kosmos_humboldt_1845", "name": "magnetic intensity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["magnetic intensity"], "contexts": ["measure of magnetic force", "measure of magnetic force strength"]}, {"entity_id": "magnetic_intensity", "book_id": "connexion_physical_sciences_somerville_1858", "name": "magnetic intensity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["magnetic intensity"], "contexts": ["strength of the magnetic field"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "magnetic intensity", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic intensity", "similarity": 1.0}], "id": 4174, "stable_key": "clu_0ecad8102ca74f30", "ground_truth": {"modern_name": "Magnetic field strength", "confidence": "high", "type": "concept", "wikidata_id": "Q126946588", "wikidata_description": "unit for reporting measurement of magnetic field strength"}}, {"canonical_name": "Walter", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "walter", "book_id": "kosmos_humboldt_1845", "name": "Walter", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Walter"], "contexts": ["author on volcanic activity", "author on volcanic activity decrease"]}, {"entity_id": "walterus", "book_id": "polyanthea_medicinal", "name": "Walterus", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Walterus"], "contexts": ["author of medicinal text"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Walter", "target_book": "polyanthea_medicinal", "target_name": "Walterus", "similarity": 0.914}], "id": 4175, "stable_key": "clu_88ceb918e7844549", "ground_truth": {"modern_name": "Walter", "confidence": "medium", "type": "person", "description": "Author on volcanic activity and medicinal texts", "note": "Ambiguity exists between different historical figures named Walter who wrote on these topics.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Old World", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "old_world", "book_id": "kosmos_humboldt_1845", "name": "Old World", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Old World"], "contexts": ["geographical term for Europe, Asia, Africa", "geographic region"]}, {"entity_id": "velho_mundo", "book_id": "coloquios_da_orta_1563", "name": "Velho Mundo", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Velho Mundo"], "contexts": ["region where syphilis existed"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Old World", "target_book": "coloquios_da_orta_1563", "target_name": "Velho Mundo", "similarity": 0.926}], "id": 4176, "stable_key": "clu_448222932668ac69-3", "ground_truth": {"modern_name": "Old World", "confidence": "high", "type": "place", "country": "Global", "wikidata_id": "Q46871", "wikidata_description": "species of plant"}}, {"canonical_name": "Copenhagen", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "copenhagen", "book_id": "kosmos_humboldt_1845", "name": "Copenhagen", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Copenhagen"], "contexts": ["capital of Denmark", "city further north than Pekin"]}, {"entity_id": "copenhagen", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Copenhagen", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Copenhagen"], "contexts": ["location of Oersted's professorship"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Copenhagen", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Copenhagen", "similarity": 1.0}], "id": 4177, "stable_key": "clu_d385c9ed12386741", "ground_truth": {"modern_name": "Copenhagen", "confidence": "high", "type": "place", "country": "Denmark", "wikidata_id": "Q1748", "wikidata_description": "capital and largest city of Denmark", "wikipedia_url": "https://en.wikipedia.org/wiki/Copenhagen", "wikipedia_extract": "Copenhagen (Danish: K\u00f8benhavn [k\u02b0\u00f8pm\u0329\u02c8h\u0251w\u02c0n] ) is the capital and most populous city of both the country of Denmark and the wider Kingdom of Denmark, with a population of 667,000 people in the municipality and 1.4 million in the urban area. The city is situated mainly on the island of Zealand (Sj\u00e6lland), with a smaller part on the island of Amager. Copenhagen is separated from Malm\u00f6, Sweden, by the \u00d8resund strait. The \u00d8resund Bridge connects the two cities by rail and road. Originally a Viking fishing village established in the 10th century in the vicinity of what is now Gammel Strand, Copenhagen became the capital of Denmark in the early 15th century. During the 16th century, the city served as the de facto capital of the Kalmar Union and the seat of the Union's monarchy, which governed most of the modern-day Nordic region as part of a Danish confederation with Sweden and Norway."}}, {"canonical_name": "Coraboeuf", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "coraboeuf", "book_id": "kosmos_humboldt_1845", "name": "Coraboeuf", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Coraboeuf"], "contexts": ["geodetic operations, no level difference", "involved in geodetic operations"]}, {"entity_id": "corva", "book_id": "polyanthea_medicinal", "name": "Corva", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Corva"], "contexts": ["nickname of a patient's mother"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Coraboeuf", "target_book": "polyanthea_medicinal", "target_name": "Corva", "similarity": 0.852}], "id": 4178, "stable_key": "clu_646e0cb63ed60815", "ground_truth": {"modern_name": "Coraboeuf", "confidence": "low", "type": "person", "description": "Individual associated with geodetic operations or patient's mother", "note": "Significant ambiguity between the references, potentially different individuals or misinterpretations.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Mr. Hind", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "mr__hind", "book_id": "kosmos_humboldt_1845", "name": "Mr. Hind", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Mr. Hind"], "contexts": ["literary and scientific friend", "discoverer of Flora and Iris"]}, {"entity_id": "mr__hind", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Mr. Hind", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Mr. Hind"], "contexts": ["computed comet's orbit", "observed spiral convolutions in tail"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Mr. Hind", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mr. Hind", "similarity": 1.0}], "id": 4179, "stable_key": "clu_ee95ead4cd2655a7", "ground_truth": {"modern_name": "John Hind", "confidence": "high", "type": "person", "birth_year": 1789, "death_year": 1856, "description": "British astronomer and mathematician, friend of Mary Somerville"}}, {"canonical_name": "hot steam", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "hot_steam", "book_id": "kosmos_humboldt_1845", "name": "hot steam", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["hot steam"], "contexts": ["gaseous water at high temperature", "vapor mixed in atmosphere"]}, {"entity_id": "hot_air", "book_id": "connexion_physical_sciences_somerville_1858", "name": "hot air", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["hot air"], "contexts": ["heated gaseous mixture", "medium causing refraction"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "hot steam", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "hot air", "similarity": 0.893}], "id": 4180, "stable_key": "clu_e770353762c0d79a-4", "ground_truth": {"modern_name": "Steam", "confidence": "high", "type": "chemical", "wikidata_id": "Q190120", "wikidata_description": "gaseous phase of water; unlike other forms of water, water vapor is invisible", "wikipedia_url": "https://en.wikipedia.org/wiki/Water%20vapor", "wikipedia_extract": "Water vapor, water vapour, or aqueous vapor is the gaseous phase of water. It is one state of water within the hydrosphere. Water vapor can be produced from the evaporation or boiling of liquid water or from the sublimation of ice. Water vapor is transparent, like most constituents of the atmosphere. Under typical atmospheric conditions, water vapor is continuously generated by evaporation and removed by condensation. It is less dense than most of the other constituents of air and triggers convection currents that can lead to clouds and fog."}}, {"canonical_name": "Bonpland", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "bonpland", "book_id": "kosmos_humboldt_1845", "name": "Bonpland", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Bonpland"], "contexts": ["found pelagic shells with author", "observer and describer of star fall"]}, {"entity_id": "bonpland", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Bonpland", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Bonpland"], "contexts": ["naturalist who studied species diversity", "found identical productions of Old and New World"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Bonpland", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bonpland", "similarity": 1.0}], "id": 4181, "stable_key": "clu_363353acc096f815-2", "ground_truth": {"modern_name": "Aim\u00e9 Bonpland", "confidence": "high", "type": "person", "birth_year": 1773, "death_year": 1858, "description": "French botanist, explorer, and physician associated with Humboldt.", "wikidata_id": "Q405702", "wikidata_description": "French physician, botanist and explorer (1773-1858)", "wikipedia_url": "https://en.wikipedia.org/wiki/Aim%C3%A9%20Bonpland", "wikipedia_extract": "Aim\u00e9 Jacques Alexandre Bonpland (French: [\u025bme b\u0254\u0303pl\u0251\u0303]; 22 August 1773 \u2013 11 May 1858) was a French explorer and botanist who traveled with Alexander von Humboldt in Latin America from 1799 to 1804. He co-authored volumes of the scientific results of their expedition. The standard author abbreviation Bonpl. is used to indicate this person as the author when citing a botanical name. Bonpland was born as Aim\u00e9 Jacques Alexandre Goujaud in La Rochelle, France, on 22, 28, or 29 August 1773. His father was a physician and, around 1790, he joined his brother Michael in Paris, where they both studied medicine."}}, {"canonical_name": "vegetable tissues", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "vegetable_tissues", "book_id": "kosmos_humboldt_1845", "name": "vegetable tissues", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["vegetable tissues"], "contexts": ["structures animated by forces", "plant structural material"]}, {"entity_id": "vegetal_tissues", "book_id": "first_principles_spencer_1862", "name": "vegetal tissues", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["vegetal tissues"], "contexts": ["structural components of plants", "biological material from plants"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "vegetable tissues", "target_book": "first_principles_spencer_1862", "target_name": "vegetal tissues", "similarity": 0.977}], "id": 4182, "stable_key": "clu_e651ca5c80fcc2f8", "ground_truth": {"modern_name": "Plant tissues", "confidence": "high", "type": "concept", "wikidata_id": "Q2707831", "wikidata_description": "any type of tissue in plants"}}, {"canonical_name": "disks", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "disks", "book_id": "kosmos_humboldt_1845", "name": "disks", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["disks"], "contexts": ["round or elliptical shapes of nebulae", "apparent circular surface of planets"]}, {"entity_id": "disc", "book_id": "connexion_physical_sciences_somerville_1858", "name": "disc", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["disc"], "contexts": ["circular surface of the planet", "circular surface"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "disks", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "disc", "similarity": 0.922}], "id": 4183, "stable_key": "clu_0bb4ae494d903297", "ground_truth": {"modern_name": "Disks", "confidence": "high", "type": "concept"}}, {"canonical_name": "Hencke", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "hencke", "book_id": "kosmos_humboldt_1845", "name": "Hencke", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Hencke"], "contexts": ["discoverer of Astrea and Hebe", "planets discovered by"]}, {"entity_id": "tencke", "book_id": "polyanthea_medicinal", "name": "Tencke", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Tencke"], "contexts": ["author cited on acidic substances", "cited for point on acids and remedies"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Hencke", "target_book": "polyanthea_medicinal", "target_name": "Tencke", "similarity": 0.877}], "id": 4184, "stable_key": "clu_d4c062c1a5cf167e", "ground_truth": {"modern_name": "Philipp Hencke", "confidence": "high", "type": "person", "birth_year": 1778, "death_year": 1843, "description": "German physician and astronomer, discovered asteroids.", "note": "The text references Hencke's astronomical discoveries, fitting Philipp Hencke. The spelling 'Tencke' is likely a transcription error or variant spelling.", "wikidata_id": "Q133351737", "wikidata_description": ""}}, {"canonical_name": "Virginia", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "virginia", "book_id": "kosmos_humboldt_1845", "name": "Virginia", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Virginia"], "contexts": ["state where fall of stars observed", "state in southeastern United States"]}, {"entity_id": "virginia", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Virginia", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Virginia"], "contexts": ["location where solar spectrum image was obtained", "location for spectral image"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Virginia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Virginia", "similarity": 0.787}], "id": 4185, "stable_key": "clu_8af8590e00827069", "ground_truth": {"modern_name": "Virginia", "confidence": "high", "type": "place", "country": "United States", "wikipedia_extract": "Park Place is a neighborhood in the western half of Norfolk, Virginia. Its boundaries are roughly Granby Street on the east, Colley Avenue on the west, 23rd Street on the south and up to (and including the southern half of) 38th Street to the north. Within these boundaries Park Place is made up of 4 historic subdivisions; Virginia Place, East Kensington, Park Place, and East Old Dominion Place. The Park Place Historic District is a national historic district listed on the National Register of Historic Places in 2005 and enlarged in 2017. It encompasses 1,525 contributing buildings, 2 contributing sites, and 5 contributing structures in the Park Place neighborhood of Norfolk. It is an example of streetcar suburban development in Norfolk during the late 19th and early 20th centuries.", "wikipedia_url": "https://en.wikipedia.org/wiki/Park_Place_Historic_District_(Norfolk,_Virginia)"}}, {"canonical_name": "Cygnus", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "cygnus", "book_id": "kosmos_humboldt_1845", "name": "Cygnus", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Cygnus"], "contexts": ["constellation with a star", "constellation where new star appeared"]}, {"entity_id": "cygnus", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Cygnus", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Cygnus"], "contexts": ["constellation in northern sky", "constellation containing part of Milky Way"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Cygnus", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cygnus", "similarity": 1.0}], "id": 4186, "stable_key": "clu_929be6abe876674b", "ground_truth": {"modern_name": "Cygnus", "confidence": "high", "type": "concept", "wikipedia_extract": "Swans are birds of the genus Cygnus within the family Anatidae. The swans' closest relatives include geese and ducks. Swans are grouped with the closely related geese in the subfamily Anserinae, forming the tribe Cygnini. Sometimes, they are considered a distinct subfamily, Cygninae. They are the largest waterfowl and are often among the largest flighted birds in their range. There are six living and many extinct species of swan; in addition, there is a species known as the coscoroba swan, which is no longer considered one of the true swans.", "wikipedia_url": "https://en.wikipedia.org/wiki/Swan"}}, {"canonical_name": "intellectual progress", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "intellectual_progress", "book_id": "kosmos_humboldt_1845", "name": "intellectual progress", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["intellectual progress"], "contexts": ["advancement in knowledge and understanding", "advancement of human intellect"]}, {"entity_id": "intellectual_progress", "book_id": "first_principles_spencer_1862", "name": "Intellectual Progress", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Intellectual Progress"], "contexts": ["growth of classifications and science"]}, {"entity_id": "progressing_intelligence", "book_id": "first_principles_spencer_1862", "name": "progressing intelligence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["progressing intelligence"], "contexts": ["advancement of cognitive abilities over time"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "intellectual progress", "target_book": "first_principles_spencer_1862", "target_name": "Intellectual Progress", "similarity": 0.971}, {"source_book": "kosmos_humboldt_1845", "source_name": "intellectual progress", "target_book": "first_principles_spencer_1862", "target_name": "progressing intelligence", "similarity": 0.897}], "id": 4187, "stable_key": "clu_67f67581c7d33b97", "ground_truth": {"modern_name": "Intellectual progress", "confidence": "high", "type": "concept", "wikidata_id": "Q58505798", "wikidata_description": ""}}, {"canonical_name": "lunar inequalities", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "lunar_inequalities", "book_id": "kosmos_humboldt_1845", "name": "lunar inequalities", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["lunar inequalities"], "contexts": ["variations in moon's orbit"]}, {"entity_id": "lunar_inequalities", "book_id": "connexion_physical_sciences_somerville_1858", "name": "lunar inequalities", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["lunar inequalities"], "contexts": ["astronomical variations affecting earth's shape", "variations in moon's orbit"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "lunar inequalities", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "lunar inequalities", "similarity": 1.0}], "id": 4188, "stable_key": "clu_8884979ddade5b1e", "ground_truth": {"modern_name": "Lunar inequalities", "confidence": "high", "type": "concept"}}, {"canonical_name": "black rays", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "black_rays", "book_id": "kosmos_humboldt_1845", "name": "black rays", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["black rays"], "contexts": ["feature of northern lights", "resembling dark smoke"]}, {"entity_id": "dark_rays", "book_id": "kosmos_humboldt_1845", "name": "dark rays", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["dark rays"], "contexts": ["observed in northern lights"]}, {"entity_id": "dark_rays", "book_id": "connexion_physical_sciences_som