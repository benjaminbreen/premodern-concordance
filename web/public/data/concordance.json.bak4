es": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Anghiera", "target_book": "kosmos_humboldt_1845", "target_name": "Anghiera", "similarity": 0.629}], "id": 2963, "stable_key": "clu_a37254071871d883", "ground_truth": {"modern_name": "Peter Martyr d'Anghiera", "confidence": "high", "type": "person", "birth_year": 1457, "death_year": 1526, "description": "Italian Renaissance historian and humanist, chronicler of the New World."}}, {"canonical_name": "rain", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "rain", "book_id": "polyanthea_medicinal", "name": "rain", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["rain"], "contexts": ["environmental factor"]}, {"entity_id": "rain", "book_id": "first_principles_spencer_1862", "name": "rain", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 8, "variants": ["rain"], "contexts": ["water falling from clouds", "precipitation from the atmosphere"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "rain", "target_book": "first_principles_spencer_1862", "target_name": "rain", "similarity": 1.0}], "id": 2964, "stable_key": "clu_eab348fd05777b90", "ground_truth": {"modern_name": "Rain", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Caxamarca", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "caxamarca", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Caxamarca", "category": "PLACE", "subcategory": "CITY", "count": 6, "variants": ["Caxamarca", "Catamarca"], "contexts": ["location in the Andes", "region in the Andes"]}, {"entity_id": "caxamarca", "book_id": "kosmos_humboldt_1845", "name": "Caxamarca", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Caxamarca"], "contexts": ["location in Peruvian Andes", "location in South America"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Caxamarca", "target_book": "kosmos_humboldt_1845", "target_name": "Caxamarca", "similarity": 1.0}], "id": 2965, "stable_key": "clu_9407cb2814463b5e", "ground_truth": {"modern_name": "Cajamarca", "confidence": "high", "type": "place", "country": "Peru", "wikidata_id": "Q205119", "wikidata_description": "capital city of Cajamarca, Peru", "wikipedia_url": "https://en.wikipedia.org/wiki/Cajamarca", "wikipedia_extract": "Cajamarca (Spanish pronunciation: [kaxa\u02c8ma\u027eka]), also known by the Quechua name, Kashamarka, is the capital and largest city of the Cajamarca Region as well as an important cultural and commercial center in the northern Andes. It is located in the northern highlands of Peru at approximately 2,750 m (8,900 ft) above sea level in the valley of the Mashcon river. Cajamarca had an estimated population of about 226,031 inhabitants in 2015, making it the 13th largest city in Peru. Cajamarca has a mild highland climate, and the area has very fertile soil. The city is well known for its dairy products and mining activity in the surroundings. Among its tourist attractions, Cajamarca has numerous examples of Spanish colonial religious architecture, beautiful landscapes, pre-Hispanic archeological sites and hot springs at the nearby town of Ba\u00f1os del Inca (Baths of the Inca)."}}, {"canonical_name": "Rodriguez", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "rodriguez", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Rodriguez", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 6, "variants": ["Rodriguez", "Jos\u00e9 Rodriguez", "Rodrigue\u00ef"], "contexts": ["Spanish traveler", "traveler"]}, {"entity_id": "rodriguez", "book_id": "polyanthea_medicinal", "name": "Rodriguez", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Rodriguez", "Luis Rodriguez"], "contexts": ["a servant who experienced a faint", "person who fainted after drinking cold water"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Rodriguez", "target_book": "polyanthea_medicinal", "target_name": "Rodriguez", "similarity": 1.0}], "id": 2966, "stable_key": "clu_a9d6f9f4d44f5633", "ground_truth": {"modern_name": "\u00c1lvar N\u00fa\u00f1ez Cabeza de Vaca", "confidence": "medium", "type": "person", "birth_year": 1490, "death_year": 1558, "description": "Spanish explorer and conquistador, survived shipwreck in Florida.", "note": "The context 'Spanish traveler' and 'a servant who experienced a faint' strongly suggests Cabeza de Vaca, given his extensive travels and detailed accounts. However, 'Rodriguez' is a common surname, and without more specific context, direct attribution is difficult.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Climatologie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "climatologie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Climatologie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["Climatologie", "Climatologie de l'Oc\u00e9an", "climat", "climats"], "contexts": ["study of climate", "study of climates"]}, {"entity_id": "climatology", "book_id": "kosmos_humboldt_1845", "name": "Climatology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Climatology"], "contexts": ["study of climate patterns", "study of climate"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Climatologie", "target_book": "kosmos_humboldt_1845", "target_name": "Climatology", "similarity": 0.991}], "id": 2967, "stable_key": "clu_7c93c896e757bdf0", "ground_truth": {"modern_name": "Climatology", "confidence": "high", "type": "concept", "wikidata_id": "Q112951336", "wikidata_description": "2020 master's thesis by Morgan Bennet at University of Otago"}}, {"canonical_name": "Hansteen", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "hansteen", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Hansteen", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["Hansteen"], "contexts": ["noticed magnetic force differences", "author of 'Untersuchungen \u00fcber den Magnetismus der Erde'"]}, {"entity_id": "hansteen", "book_id": "kosmos_humboldt_1845", "name": "Hansteen", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Hansteen"], "contexts": ["observer of declination lines in Northern Asia", "author of 'Magnet. der Erde'"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Hansteen", "target_book": "kosmos_humboldt_1845", "target_name": "Hansteen", "similarity": 1.0}], "id": 2968, "stable_key": "clu_33afaca3a6840509", "ground_truth": {"modern_name": "Christoph Heinrich Friedrich Henrichsen", "confidence": "high", "type": "person", "birth_year": 1784, "death_year": 1841, "description": "Norwegian scientist, geophysicist, astronomer, and meteorologist", "note": "The provided text spells the name as 'Hansteen', which is a correct form of the scientist's name.", "wikidata_id": "Q19372291", "wikidata_description": "street in Oslo, Norway"}}, {"canonical_name": "pyroxene", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "pyrox\u00e8ne", "book_id": "relation_historique_humboldt_vol3_1825", "name": "pyrox\u00e8ne", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["pyrox\u00e8ne"], "contexts": ["mineral found in volcanic rocks", "mineral found in rocks"]}, {"entity_id": "pyrox\u00e8nes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "pyrox\u00e8nes", "category": "SUBS