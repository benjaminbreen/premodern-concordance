bcategory": "CITY", "count": 3, "variants": ["Alexandria"], "contexts": ["city from which turbith is brought", "origin of escamonio"]}, {"entity_id": "alexandria", "book_id": "historia_medicinal_monardes_1574", "name": "Alexandria", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Alexandria"], "contexts": ["city receiving Ca\u00f1afistola", "city in Egypt"]}, {"entity_id": "alexandria", "book_id": "coloquios_da_orta_1563", "name": "Alexandria", "category": "PLACE", "subcategory": "CITY", "count": 22, "variants": ["Alexandria"], "contexts": ["port city on the Nile", "port city for trade and distribution"]}, {"entity_id": "alexandria", "book_id": "ricettario_fiorentino_1597", "name": "Alexandria", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Alexandria"], "contexts": ["source of best ammi", "city where Cassia is imported"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Alexandria", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "Alexandria", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Alexandria", "target_book": "historia_medicinal_monardes_1574", "target_name": "Alexandria", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Alexandria", "target_book": "coloquios_da_orta_1563", "target_name": "Alexandria", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Alexandria", "target_book": "ricettario_fiorentino_1597", "target_name": "Alexandria", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Alexandria", "target_book": "historia_medicinal_monardes_1574", "target_name": "Alexandria", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Alexandria", "target_book": "coloquios_da_orta_1563", "target_name": "Alexandria", "similarity": 1.0}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Alexandria", "target_book": "ricettario_fiorentino_1597", "target_name": "Alexandria", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Alexandria", "target_book": "coloquios_da_orta_1563", "target_name": "Alexandria", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Alexandria", "target_book": "ricettario_fiorentino_1597", "target_name": "Alexandria", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Alexandria", "target_book": "ricettario_fiorentino_1597", "target_name": "Alexandria", "similarity": 1.0}], "id": 146, "stable_key": "clu_7f1ff70a462d04db", "ground_truth": {"modern_name": "Alexandria", "confidence": "high", "type": "place", "description": "Major ancient Egyptian port city, a hub of trade, learning, and culture.", "wikipedia_extract": "Alexandria is a major city in Egypt. Lying at the western edge of the Nile River Delta, it extends about 40 km (25 mi) along the country's northern coast. It is Egypt's principal seaport, the second largest city after Cairo, and the largest city on the Mediterranean coast. Founded in 331 BC by Alexander the Great, Alexandria is one of the largest and most important cities of antiquity and a leading hub for science, culture, and scholarship. Nicknamed the \"Bride of the Mediterranean\" and \"Pearl of the Mediterranean Coast\", the city is a popular tourist destination and a major industrial centre. It is the sixth-largest city in the Arab world and in the Middle East, and the eleventh-largest city and urban area in Africa."}}, {"canonical_name": "Face", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 5, "total_mentions": 30, "members": [{"entity_id": "face", "book_id": "english_physician_1652", "name": "Face", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 20, "variants": ["Face", "Faces", "face"], "contexts": ["body part, can have ulcers", "body part, can have redness"]}, {"entity_id": "face", "book_id": "principles_of_psychology_james_1890", "name": "face", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 7, "variants": ["face"], "contexts": ["part of the head", "front part of the head"]}, {"entity_id": "face", "book_id": "coloquios_da_orta_1563", "name": "face", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["face"], "contexts": ["body part that swelled"]}, {"entity_id": "face", "book_id": "connexion_physical_sciences_somerville_1858", "name": "face", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["face"], "contexts": ["part of the body touched by wire"]}, {"entity_id": "face", "book_id": "first_principles_spencer_1862", "name": "face", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["face"], "contexts": ["part of the body affected by stooping"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Face", "target_book": "principles_of_psychology_james_1890", "target_name": "face", "similarity": 0.996}, {"source_book": "english_physician_1652", "source_name": "Face", "target_book": "coloquios_da_orta_1563", "target_name": "face", "similarity": 0.996}, {"source_book": "english_physician_1652", "source_name": "Face", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "face", "similarity": 0.996}, {"source_book": "english_physician_1652", "source_name": "Face", "target_book": "first_principles_spencer_1862", "target_name": "face", "similarity": 0.996}, {"source_book": "principles_of_psychology_james_1890", "source_name": "face", "target_book": "coloquios_da_orta_1563", "target_name": "face", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "face", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "face", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "face", "target_book": "first_principles_spencer_1862", "target_name": "face", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "face", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "face", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "face", "target_book": "first_principles_spencer_1862", "target_name": "face", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "face", "target_book": "first_principles_spencer_1862", "target_name": "face", "similarity": 1.0}], "id": 147, "stable_key": "clu_b2515a3339a96dc9", "ground_truth": {"modern_name": "Face", "confidence": "high", "type": "substance", "description": "The front part of a person's head, from the forehead to the chin.", "wikipedia_extract": "The face is the front of the head in humans and many other animals that features most of the sense organs including the eyes, nose and mouth. Many animals may express emotions through their face. Sense organs in the faces of different animals are varied such as the snout, and the proboscis. Many animals are flat-faced (brachycephalic) such as the pug dog. The human face is crucial for identity, and damage such as scarring or developmental deformities may adversely affect the psyche. The front of the human head is called the face.", "wikidata_id": "Q355", "wikidata_description": "American online social media and social networking service"}}, {"canonical_name": "Brasil", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 5, "total_mentions": 30, "members": [{"entity_id": "brazil", "book_id": "origin_of_species_darwin_1859", "name": "Brazil", "category": "PLACE", "subcategory": "COUNTRY", "count": 5, "variants": ["Brazil"], "contexts": ["caves with fossil bones and birds", "country with caves containing fossils"]}, {"entity_id": "brazil", "book_id": "kosmos_humboldt_1845", "name": "Brazil", "category": "PLACE", "subcategory": "COUNTRY", "count": 4, "variants": ["Brazil"], "contexts": ["South American country", "country with coast near magnetic equator"]}, {"entity_id": "brasil", "book_id": "coloquios_da_orta_1563", "name": "Brasil", "category": "PLACE", "subcategory": "COUNTRY", "count": 13, "variants": ["Brasil", "BraziL", "Brazil", "Braz\u00edl", "brasil"], "contexts": ["country where amber is found", "destination mentioned by Sultan"]}, {"entity_id": "brasil", "book_id": "polyanthea_medicinal", "name": "Brasil", "category": "PLACE", "subcategory": "COUNTRY", "count": 6, "variants": ["Brasil"], "contexts": ["Estado do Brasil", "origin of almecega"]}, {"entity_id": "brazil", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Brazil", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Brazil"], "contexts": ["country with mountain groups", "southern part of America"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Brazil", "target_book": "kosmos_humboldt_1845", "target_name": "Brazil", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Brazil", "target_book": "coloquios_da_orta_1563", "target_name": "Brasil", "similarity": 0.975}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Brazil", "target_book": "polyanthea_medicinal", "target_name": "Brasil", "similarity": 0.975}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Brazil", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Brazil", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Brazil", "target_book": "coloquios_da_orta_1563", "target_name": "Brasil", "similarity": 0.975}, {"source_book": "kosmos_humboldt_1845", "source_name": "Brazil", "target_book": "polyanthea_medicinal", "target_name": "Brasil", "similarity": 0.975}, {"source_book": "kosmos_humboldt_1845", "source_name": "Brazil", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Brazil", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Brasil", "target_book": "polyanthea_medicinal", "target_name": "Brasil", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Brasil", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Brazil", "similarity": 0.975}, {"source_book": "polyanthea_medicinal", "source_name": "Brasil", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Brazil", "similarity": 0.975}], "id": 148, "stable_key": "clu_2d2c2b3926e4e7b5", "ground_truth": {"modern_name": "Brazil", "confidence": "high", "type": "place", "description": "A country in South America.", "wikipedia_extract": "Brazil, officially the Federative Republic of Brazil, is the largest country in South America. It is also the world's fifth-largest country by area and the seventh-largest by population, with over 213 million people. The country is a federation composed of 26 states and a Federal District, which hosts the capital, Bras\u00edlia. Its most populous city is S\u00e3o Paulo, followed by Rio de Janeiro. Brazil has the most Portuguese speakers in the world and is the only country in the Americas where Portuguese is an official language. Bounded by the Atlantic Ocean on the east, Brazil has a coastline of 7,491 kilometers (4,655 mi).", "country": "Brazil", "note": "The term 'Brasilia' or 'Brazils' in early modern texts likely referred to the region of Brazil, not the modern city of Bras\u00edlia.", "wikidata_id": "Q155", "wikidata_description": "country in South America"}}, {"canonical_name": "Meridian", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 30, "members": [{"entity_id": "meridian", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Meridian", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["Meridian"], "contexts": ["line connecting north and south poles", "line of longitude for direction"]}, {"entity_id": "meridian", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Meridian", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 15, "variants": ["Meridian", "meridian"], "contexts": ["line passing through both poles", "line of longitude on earth"]}, {"entity_id": "meridians", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Meridians", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Meridians", "meridians"], "contexts": ["lines of longitude", "lines used for earth measurement and lunar observation"]}, {"entity_id": "meridians", "book_id": "relation_historique_humboldt_vol3_1825", "name": "meridians", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["meridians"], "contexts": ["lines of longitude"]}, {"entity_id": "meridian", "book_id": "kosmos_humboldt_1845", "name": "meridian", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["meridian"], "contexts": ["line of longitude on the globe", "line of longitude on Earth"]}, {"entity_id": "meridiano", "book_id": "coloquios_da_orta_1563", "name": "meridiano", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["meridiano"], "contexts": ["Line of demarcation", "line of longitude"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Meridian", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Meridian", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Meridian", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Meridians", "similarity": 0.879}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "meridians", "target_book": "kosmos_humboldt_1845", "target_name": "meridian", "similarity": 0.909}, {"source_book": "kosmos_humboldt_1845", "source_name": "meridian", "target_book": "