ity": 0.885}], "id": 2769, "stable_key": "clu_53b6b8f27d6a69f4", "ground_truth": {"modern_name": "Woman", "confidence": "high", "type": "person", "description": "Refers to female individuals, often in a general or societal context.", "note": "The Spanish terms 'muger' and 'mugeres' are direct translations of 'woman' and 'women'.", "wikidata_id": "Q6581072", "wikidata_description": "to be used in \"sex or gender\" (P21) to indicate that the human subject is a female or \"semantic gender\" (P10339) to indicate that a word refers to a female person", "wikipedia_url": "https://en.wikipedia.org/wiki/Female%20%28gender%29"}}, {"canonical_name": "romas", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "romana", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Romana", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Romana"], "contexts": ["Roman plant, likely rhubarb", "a type of plant found in gardens"]}, {"entity_id": "romanea", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "romanea", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["romanea"], "contexts": ["plant with leaves like romanea"]}, {"entity_id": "romas", "book_id": "polyanthea_medicinal", "name": "romas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["romas", "romao", "romas azedas"], "contexts": ["cascas used in baths", "ingredient for astringents"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Romana", "target_book": "polyanthea_medicinal", "target_name": "romas", "similarity": 0.908}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "romanea", "target_book": "polyanthea_medicinal", "target_name": "romas", "similarity": 0.883}], "id": 2770, "stable_key": "clu_116a9cd8915c298c", "ground_truth": {"modern_name": "Rhubarb", "confidence": "medium", "type": "plant", "linnaean": "Rheum L.", "family": "Polygonaceae", "note": "The terms 'romas', 'Romana', and 'romanea' are ambiguous. 'Romana' could refer to Roman origin, and 'romanea' might be a variation or misreading. However, in the context of 'cascas used in baths' and the association with medicinal properties, rhubarb (particularly Rheum officinale or Rheum palmatum) is a strong candidate. 'Roman plant' might be a poetic or historical descriptor rather than a strict botanical classification. Given the context and potential for variation in spelling/naming, confidence is medium.", "wikidata_id": "Q20767168", "wikidata_description": "herbaceous perennial plant in the family Polygonaceae"}}, {"canonical_name": "leche", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "mana_leche", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "mana leche", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["mana leche"], "contexts": ["cold, binding substance from flowers"]}, {"entity_id": "leche", "book_id": "historia_medicinal_monardes_1574", "name": "leche", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 10, "variants": ["leche", "Leche", "Leche quajada", "leche de Cabras", "leche de cabras"], "contexts": ["milk", "milky substance from plant"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "mana leche", "target_book": "historia_medicinal_monardes_1574", "target_name": "leche", "similarity": 0.9}], "id": 2771, "stable_key": "clu_1d484f1a5dd1d5ec", "ground_truth": {"modern_name": "Milk", "confidence": "high", "type": "substance", "note": "The Spanish term 'leche' directly translates to 'milk'. The mention of 'mana leche' suggests a specific type or preparation, but the core referent is milk.", "wikidata_id": "Q157184", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Astragalus%20%28plant%29"}}, {"canonical_name": "faltas de respira\u00e7\u00e3o", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "dificultad_de_la_respiraci\u00f3n", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "dificultad de la respiraci\u00f3n", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["dificultad de la respiraci\u00f3n"], "contexts": ["condition treated by root"]}, {"entity_id": "faltas_de_respira\u00e7\u00e3o", "book_id": "polyanthea_medicinal", "name": "faltas de respira\u00e7\u00e3o", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 10, "variants": ["faltas de respira\u00e7\u00e3o", "falta de re\u017fpira\u00e7a\u00f3", "falta de tran\u017fpira\u00e7\u00e3o", "faltas de re\u017fpira\u00e7ao", "faltasde re\u017fpira\u00e7\u00e3o"], "contexts": ["shortness of breath", "difficulty breathing"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "dificultad de la respiraci\u00f3n", "target_book": "polyanthea_medicinal", "target_name": "faltas de respira\u00e7\u00e3o", "similarity": 0.93}], "id": 2772, "stable_key": "clu_c03486523d890930", "ground_truth": {"modern_name": "Dyspnea", "confidence": "high", "type": "disease", "modern_term": "Dyspnea", "note": "'Faltas de respira\u00e7\u00e3o' and 'dificultad de la respiraci\u00f3n' are clear descriptions of shortness of breath, which corresponds to the medical term dyspnea.", "wikidata_id": "Q188008", "wikidata_description": "feelings associated with impaired breathing", "wikipedia_url": "https://en.wikipedia.org/wiki/Shortness%20of%20breath"}}, {"canonical_name": "Vidro", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "vidro", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "vidro", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["vidro"], "contexts": ["glass vessels for distillation"]}, {"entity_id": "vidro", "book_id": "polyanthea_medicinal", "name": "Vidro", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 10, "variants": ["Vidro", "vidro"], "contexts": ["glass container", "glass used for a bottle"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "vidro", "target_book": "polyanthea_medicinal", "target_name": "Vidro", "similarity": 0.914}], "id": 2773, "stable_key": "clu_e839f2b32a35e93b", "ground_truth": {"modern_name": "Glass", "confidence": "high", "type": "mineral", "wikidata_id": "Q16870200", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Glass%20%28surname%29"}}, {"canonical_name": "Dio", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "dio", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Dio", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Dio"], "contexts": ["place where plant grows"]}, {"entity_id": "dio", "book_id": "coloquios_da_orta_1563", "name": "Dio", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 10, "variants": ["Dio"], "contexts": ["location where a man was cured", "place where spice was bought"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "Dio", "target_book": "coloquios_da_orta_1563", "target_name": "Dio", "similarity": 1.0}], "id": 2774, "stable_key": "clu_c89a5176aef8ea35", "ground_truth": {"modern_name": "Di\u00f3", "confidence": "medium", "type": "place", "country": "Greece", "note": "The specific 'Dio' mentioned in historical botanical and medicinal texts likely refers to a location in Greece, given its association with plant growth and healing, rather than a more general geographical term. Further context from the original texts would be needed for absolute certainty."}}, {"canonical_name": "rock-salt", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "rock_salt", "book_id": "kosmos_humboldt_1845", "name": "rock salt", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["rock salt"], "contexts": ["mineral found in secondary strata"]}, {"entity_id": "rock-salt", "book_id": "connexion_physical_sciences_somerville_1858", "name": "rock-salt", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 9, "variants": ["Rock-salt", "rock-salt"], "contexts": ["transmits heat, opaque to light", "transmits heat"]}, {"entity_id": "rock_salt", "book_id": "connexion_physical_sciences_somerville_1858", "name": "rock salt", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["rock salt"], "contexts": ["substance with light rotation property"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "rock salt", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "rock-salt", "similarity": 0.973}, {"source_book": "kosmos_humboldt_1845", "source_name": "rock salt", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "rock salt", "similarity": 1.0}], "id": 2775, "stable_key": "clu_96314c24dbe24596-2", "ground_truth": {"modern_name": "Rock salt", "confidence": "high", "type": "mineral", "wikidata_id": "Q5314", "wikidata_description": "mineral form of sodium chloride", "wikipedia_url": "https://en.wikipedia.org/wiki/Halite", "wikipedia_extract": "Halite ( HAL-yte, HAY-lyte), commonly known as rock salt, is a type of salt, the mineral (natural) form of sodium chloride (NaCl). Halite forms isometric crystals. The mineral is typically colorless or white, but may also be light blue, dark blue, purple, pink, red, orange, yellow or gray depending on inclusion of other materials, impurities, and structural or isotopic abnormalities in the crystals. It commonly occurs with  other evaporite deposit minerals such as several of the sulfates, halides, and borates. The name halite is derived from the Ancient Greek word for \"salt\", \u1f05\u03bb\u03c2 (h\u00e1ls). Halite dominantly occurs within sedimentary rocks where it has formed from the evaporation of seawater or salty lake water."}}, {"canonical_name": "Churruca", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "churruca", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Churruca", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 10, "variants": ["Churruca", "Churruea", "Clitirruca"], "contexts": ["person involved in geographical operations", "source of published observations"]}, {"entity_id": "churruca", "book_id": "kosmos_humboldt_1845", "name": "Churruca", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Churruca"], "contexts": ["navigator of Magellan Strait"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Churruca", "target_book": "kosmos_humboldt_1845", "target_name": "Churruca", "similarity": 0.717}], "id": 2776, "stable_key": "clu_761a58b98e880deb", "ground_truth": {"modern_name": "Cosme Churruca", "confidence": "high", "type": "person", "birth_year": 1761, "death_year": 1814, "description": "Spanish naval officer and scientist, participated in scientific expeditions.", "note": "Identified as a navigator based on Humboldt's context."}}, {"canonical_name": "Santa Maria", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "santa_maria", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Santa Maria", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 10, "variants": ["Santa Maria", "San Martin", "Sant Roman", "Santa Maria Angola", "Santa Martha"], "contexts": ["mountains in Venezuela", "location in the Parime region"]}, {"entity_id": "santa_maria", "book_id": "ricettario_fiorentino_1597", "name": "Santa Maria", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Santa Maria"], "contexts": ["location of medicinal baths"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Santa Maria", "target_book": "ricettario_fiorentino_1597", "target_name": "Santa Maria", "similarity": 1.0}], "id": 2777, "stable_key": "clu_a312ca61566724fc", "ground_truth": {"modern_name": "Santa Mar\u00eda", "confidence": "high", "type": "place", "country": "Venezuela"}}, {"canonical_name": "p\u00e9trole", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "p\u00e9trole", "book_id": "relation_historique_humboldt_vol3_1825", "name": "p\u00e9trole", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 10, "variants": ["p\u00e9trole"], "contexts": ["oil, a natural substance", "a flammable liquid found in certain formations"]}, {"entity_id": "petroleo", "book_id": "historia_medicinal_monardes_1574", "name": "Petroleo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Petroleo"], "contexts": ["substance flowing from springs"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "p\u00e9trole", "target_book": "historia_medicinal_monardes_1574", "target_name": "Petroleo", "similarity": 0.954}], "id": 2778, "stable_key": "clu_150b0b4a83af6d80", "ground_truth": {"modern_name": "Petroleum", "confidence": "high", "type": "chemical", "wikidata_id": "Q50812134", "wikidata_description": "Academic journal published by Elsevier , covering the subjects: Technology: Chemical technology: Oils, fats, and waxes: Petroleum refining. Petroleum products | Technology: Engineering (General). Civil engineering (General): Engineering ge", "note": "The term 'petro' in early modern texts often referred to naphtha or bitumen, which are types of petroleum products, particularly in alchemical contexts."}}, {"canonical_name": "Washington", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "washington", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Washington", "category": "PLACE", "subcategory": "CITY", "count": 10, "variants": ["Washington"], "contexts": ["location of a presidential message", "location of a treaty signing"]}, {"entity_id": "washington", "book_id": "principles_of_psychology_james_1890", "name": "Washington", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Washington"], "contexts": ["location of National College"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Washington", "target_book": "principles_of_psychology_james_1890", "target_name": "Washington", "similarity": 1.0}], "id": 2779, "stable_key": "clu_d0fb4647b151fa9f", "ground_truth": {"modern_name": "Washington D.C.", "confidence": "high", "type": "place", "description": "The capital city of the United States.", "note": "Refers to Washington D.C., the capital of the USA, not the state.", "wikipedia_extract": "Washington, D.C., officially the District of Columbia and commonly known as simply Washington or D.C., is the capital city and federal district of the United States. The city is on the Potomac River across from Virginia and shares land borders with Maryland to its north and east. It was named after George Washington, a Founding Father and the first president of the United States. The district is named for Columbia, the female personification of the nation. The U.S. Constitution in 1789 called for the creation of a federal district under exclusive jurisdiction of the U.S."}}, {"canonical_name": "Borda", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "borda", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Borda", "category": "PERSON", "subcategory": "SCHOLAR", "count": 10, "variants": ["Borda"], "contexts": ["inventor of magnetic compass", "inventor of inclinometer"]}, {"entity_id": "borda", "book_id": "kosmos_humboldt_1845", "name": "Borda", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Borda"], "contexts": ["interested in scientific expedition success"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Borda", "target_book": "kosmos_humboldt_1845", "target_name": "Borda", "similarity": 1.0}], "id": 2780, "stable_key": "clu_090c5e79a6b79445", "ground_truth": {"modern_name": "Borda", "confidence": "low", "type": "person", "description": "Inventor of magnetic compass, associated with scientific expedition", "note": "The historical figure associated with the compass invention is likely a confusion with other individuals or a misattribution. The context is vague for a definitive identification.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Barbade", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "barbade", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Barbade", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 9, "variants": ["Barbade", "Barbado9", "Barbados"], "contexts": ["Barbade, Martinique and Saint-Thomas", "island name"]}, {"entity_id": "barbadoes", "book_id": "kosmos_humboldt_1845", "name": "Barbadoes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Barbadoes"], "contexts": ["island where earthquake was felt", "island in the Antilles"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Barbade", "target_book": "kosmos_humboldt_1845", "target_name": "Barbadoes", "similarity": 0.951}], "id": 2781, "stable_key": "clu_65fab1444d4b9396", "ground_truth": {"modern_name": "Barbados", "confidence": "high", "type": "place", "country": "Barbados"}}, {"canonical_name": "zechstein", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "zechstein", "book_id": "relation_historique_humboldt_vol3_1825", "name": "zechstein", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 8, "variants": ["zechstein", "Zechstein"], "contexts": ["geological formation", "geological rock formation"]}, {"entity_id": "zechstein", "book_id": "kosmos_humboldt_1845", "name": "Zechstein", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["Zechstein", "zechstein"], "contexts": ["geological formation", "geological rock formation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "zechstein", "target_book": "kosmos_humboldt_1845", "target_name": "Zechstein", "similarity": 0.879}], "id": 2782, "stable_key": "clu_f79946c64f8fbf58", "ground_truth": {"modern_name": "Zechstein Formation", "confidence": "high", "type": "mineral", "note": "Zechstein refers to a significant geological period and the associated rock strata, particularly relevant in European geology. 'zechslein', 'zechstone', and 'zeckstein' are variations of this term.", "wikidata_id": "Q98436573", "wikidata_description": "street in the city district of Davenstedt in Hanover, Germany", "wikipedia_extract": "The Zechstein Limestone Formation is a geologic formation in Germany. It preserves fossils dating back to the Permian period. List of fossiliferous stratigraphic units in Germany Various Contributors to the Paleobiology Database. \"Fossilworks: Gateway to the Paleobiology Database\". Archived from the original on 19 August 2022. Retrieved 17 December 2021.", "wikipedia_url": "https://en.wikipedia.org/wiki/Zechstein_Limestone_Formation"}}, {"canonical_name": "euphotide", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "euphotide", "book_id": "relation_historique_humboldt_vol3_1825", "name": "euphotide", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 7, "variants": ["euphotide", "euphotides"], "contexts": ["rock type", "rock type in Cuba"]}, {"entity_id": "euphotide", "book_id": "kosmos_humboldt_1845", "name": "euphotide", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["Euphotide", "euphotide"], "contexts": ["endogenous rock type", "type of rock"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "euphotide", "target_book": "kosmos_humboldt_1845", "target_name": "euphotide", "similarity": 0.775}], "id": 2783, "stable_key": "clu_360444d892c155c5", "ground_truth": {"modern_name": "Nepheline", "confidence": "high", "type": "mineral", "note": "Euphotide is an archaic term for Nepheline, often encountered in older geological literature, especially in relation to Humboldt's travels. 'Uepheline' is a probable misspelling.", "wikidata_id": "Q407339", "wikidata_description": "tectosilicate mineral", "wikipedia_url": "https://en.wikipedia.org/wiki/Nepheline", "wikipedia_extract": "Nepheline (from Ancient Greek  \u03bd\u03b5\u03c6\u03ad\u03bb\u03b7 (neph\u00e9l\u0113) 'cloud'), also called nephelite, is a rock-forming mineral in the feldspathoid group \u2013 a silica-undersaturated aluminosilicate (Na3KAl4Si4O16) that occurs in intrusive and volcanic rocks with low silica, and in their associated pegmatites. It is used in glass and ceramic manufacturing and other industries, and has been investigated as an ore of aluminium. Nepheline crystals are rare and belong to the hexagonal system, usually having the form of a short, six-sided prism terminated by the basal plane. The crystals appear to have more symmetry than they actually possess, but unsymmetrical etched figures produced artificially on the prism faces indicate that the crystals are hemimorphic and tetartohedral, the only element of symmetry being a polar hexad axis. Nepheline is found in compact, granular aggregates, and can be white, yellow, gray, green, or reddish. Its hardness on the Mohs scale is 5.5 to 6, and its specific gravity 2.60\u20132.65."}}, {"canonical_name": "malabares", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "malapert", "book_id": "kosmos_humboldt_1845", "name": "Malapert", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Malapert"], "contexts": ["described annular mountain", "annular mountain"]}, {"entity_id": "malabares", "book_id": "coloquios_da_orta_1563", "name": "malabares", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 9, "variants": ["malabares", "Malabares", "Malavres"], "contexts": ["people who name the coconut tree and fruit", "people who call coquo 'tenga'"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Malapert", "target_book": "coloquios_da_orta_1563", "target_name": "malabares", "similarity": 0.873}], "id": 2784, "stable_key": "clu_e266fc35225ded22", "ground_truth": {"modern_name": "Malabar people", "confidence": "high", "type": "person", "description": "Indigenous people of the Malabar Coast, known for their naming conventions.", "note": "The term 'malabares' refers to the people of the Malabar region, not a specific individual. The mention of 'Malapert' is likely a misspelling or misinterpretation in the source text."}}, {"canonical_name": "Lombardie", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "lombardie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Lombardie", "category": "PLACE", "subcategory": "REGION", "count": 6, "variants": ["Lombardie"], "contexts": ["region with cultivated fields", "region lacking primitive blocks"]}, {"entity_id": "lombardy", "book_id": "kosmos_humboldt_1845", "name": "Lombardy", "category": "PLACE", "subcategory": "REGION", "count": 5, "variants": ["Lombardy"], "contexts": ["Italian region", "plain in Italy"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Lombardie", "target_book": "kosmos_humboldt_1845", "target_name": "Lombardy", "similarity": 0.979}], "id": 2785, "stable_key": "clu_df39d021e9b41ec6", "ground_truth": {"modern_name": "Lombardy", "confidence": "high", "type": "place", "country": "Italy", "wikipedia_extract": "Desiderius, also known as Daufer or Dauferius (born c. 720 \u2013 died c. 786), was king of the Lombards in northern Italy, ruling from 756 to 774. The Frankish king of renown, Charlemagne, married Desiderius's daughter and subsequently conquered his realm. Desiderius is remembered for this connection to Charlemagne and for being the last Lombard ruler to exercise regional kingship. Born in Brescia, Desiderius was originally a royal officer, the dux of Tuscia and he became king after the death of Aistulf in 756.", "wikipedia_url": "https://en.wikipedia.org/wiki/Desiderius"}}, {"canonical_name": "Mathieu", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "mathieu", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Mathieu", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Mathieu", "M. Mathieu"], "contexts": ["member of the Academy of Sciences", "collaborator in magnetic inclination measurement"]}, {"entity_id": "mathieu", "book_id": "kosmos_humboldt_1845", "name": "Mathieu", "category": "PERSON", "subcategory": "SCHOLAR", "count": 7, "variants": ["Mathieu"], "contexts": ["author of note in Delambre's work", "author of note on astronomy history"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Mathieu", "target_book": "kosmos_humboldt_1845", "target_name": "Mathieu", "similarity": 1.0}], "id": 2786, "stable_key": "clu_d16f9802271fd627", "ground_truth": {"modern_name": "Claude Fran\u00e7ois Geoffroy", "confidence": "medium", "type": "person", "birth_year": 1751, "death_year": 1831, "description": "French chemist and botanist, member of the Academy of Sciences.", "note": "The context 'author of note in Delambre's work' and 'member of the Academy of Sciences' points strongly to a prominent scientist. Claude Fran\u00e7ois Geoffroy fits this description and is historically associated with botanical and chemical studies which could be referenced in scientific texts. The name 'Mathieu' is a common one and could refer to other individuals, but given the context, this is a strong possibility."}}, {"canonical_name": "Santa Cruz", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "santa_cruz", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Santa Cruz", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Santa Cruz"], "contexts": ["province in the first category of census", "city in Audiencia de Charcas"]}, {"entity_id": "santa-cruz", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Santa-Cruz", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Santa-Cruz"], "contexts": ["city in Bolivia", "mountain range in Santa Cruz"]}, {"entity_id": "santa_cruz", "book_id": "coloquios_da_orta_1563", "name": "Santa Cruz", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Santa Cruz", "Santa Cruz de Cochiro"], "contexts": ["original name of Brazil", "island owned by Jorge Vas de Magalh\u00e3es"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Santa Cruz", "target_book": "coloquios_da_orta_1563", "target_name": "Santa Cruz", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Santa-Cruz", "target_book": "coloquios_da_orta_1563", "target_name": "Santa Cruz", "similarity": 0.927}], "id": 2787, "stable_key": "clu_e594c13e8bc7e6f8", "ground_truth": {"modern_name": "Santa Cruz", "confidence": "high", "type": "place", "country": "Bolivia", "note": "While Santa Cruz can refer to multiple places, the context of Humboldt and its mention as a city in Bolivia strongly suggests Santa Cruz de la Sierra.", "wikidata_id": "Q170688", "wikidata_description": "city in eastern Bolivia", "wikipedia_url": "https://en.wikipedia.org/wiki/Santa%20Cruz%20de%20la%20Sierra", "wikipedia_extract": "Santa Cruz de la Sierra (Spanish: [\u02c8santa \u02c8k\u027eus \u00f0e la \u02c8sjera]; lit. 'Holy Cross of the Mountain Range'), commonly known as Santa Cruz, is the largest city in Bolivia and the capital of the Santa Cruz department. Situated on the Pirai River in the eastern Tropical Lowlands of Bolivia, the Santa Cruz de la Sierra Metropolitan Region is the most populous urban agglomeration in Bolivia with an estimated population of 2.4 million in 2020. It is formed out of a conurbation of seven Santa Cruz municipalities: Santa Cruz de la Sierra, La Guardia, Warnes, Cotoca, El Torno, Porongo, and Montero. The city was first founded in 1561 by Spanish explorer \u00d1uflo de Chavez about 200 km (124 mi) east of its current location, and was moved several times until it was finally established on the Pirai River in the late 16th century. For much of its history, Santa Cruz was mostly a small outpost town, and even after Bolivia gained its independence in 1825 there was little attention from the authorities or the population in general to settle the region."}}, {"canonical_name": "Beguino", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "bupin", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bupin", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Bupin"], "contexts": ["author on French and English infrastructure", "author of memoirs on French and English infrastructure"]}, {"entity_id": "beguino", "book_id": "polyanthea_medicinal", "name": "Beguino", "category": "PERSON", "subcategory": "SCHOLAR", "count": 9, "variants": ["Beguino", "Beguinus", "Biguinus"], "contexts": ["physician and chief smelter", "described as minister of nature"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bupin", "target_book": "polyanthea_medicinal", "target_name": "Beguino", "similarity": 0.861}], "id": 2788, "stable_key": "clu_492d79a9887071e4", "ground_truth": {"modern_name": "Beguinus", "confidence": "high", "type": "person", "description": "Physician and alchemist, associated with alchemy and medicine.", "note": "The name 'Beguino' and 'Bupin' likely refer to Beguinus, a known alchemist and physician."}}, {"canonical_name": "Riobamba", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 11, "members": [{"entity_id": "riobamba", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Riobamba", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Riobamba"], "contexts": ["city near Andes", "city with 'Pampa' in name"]}, {"entity_id": "riobamba_nuevo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Riobamba Nuevo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Riobamba Nuevo"], "contexts": ["lieu"]}, {"entity_id": "riobamba", "book_id": "kosmos_humboldt_1845", "name": "Riobamba", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 8, "variants": ["Riobamba"], "contexts": ["location of earthquake", "town overthrown by earthquake in 1797"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Riobamba", "target_book": "kosmos_humboldt_1845", "target_name": "Riobamba", "similarity": 0.878}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Riobamba Nuevo", "target_book": "kosmos_humboldt_1845", "target_name": "Riobamba", "similarity": 0.921}], "id": 2789, "stable_key": "clu_76e8f3c533c057f3", "ground_truth": {"modern_name": "Riobamba", "confidence": "high", "type": "place", "country": 