target_book": "polyanthea_medicinal", "target_name": "Hesiod", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Hesiod", "target_book": "polyanthea_medicinal", "target_name": "Hesiod", "similarity": 1.0}], "id": 1482, "stable_key": "clu_dba358d0a04ab50d", "ground_truth": {"modern_name": "Hesiod", "confidence": "high", "type": "person", "description": "Ancient Greek poet and author of Theogony", "wikidata_id": "Q40372668", "wikidata_description": "genus of annelids"}}, {"canonical_name": "Anaxagoras", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "anaxagoras", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Anaxagoras", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Anaxagoras"], "contexts": ["philosopher whose assertions were rejected by Aristotle", "ancient philosopher who affirmed snow is black"]}, {"entity_id": "anaxagoras", "book_id": "kosmos_humboldt_1845", "name": "Anaxagoras", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Anaxagoras"], "contexts": ["ancient philosopher who predicted a\u00ebrolites", "ancient philosopher on aerolites and ether"]}, {"entity_id": "anaxagoras_the_clazomenian", "book_id": "kosmos_humboldt_1845", "name": "Anaxagoras the Clazomenian", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Anaxagoras the Clazomenian"], "contexts": ["philosopher with doctrine on celestial bodies"]}, {"entity_id": "anaxagoras", "book_id": "historia_medicinal_monardes_1574", "name": "Anaxagoras", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Anaxagoras"], "contexts": ["ancient philosopher on metal duality"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Anaxagoras", "target_book": "kosmos_humboldt_1845", "target_name": "Anaxagoras", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Anaxagoras", "target_book": "kosmos_humboldt_1845", "target_name": "Anaxagoras the Clazomenian", "similarity": 0.856}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Anaxagoras", "target_book": "historia_medicinal_monardes_1574", "target_name": "Anaxagoras", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Anaxagoras", "target_book": "historia_medicinal_monardes_1574", "target_name": "Anaxagoras", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Anaxagoras the Clazomenian", "target_book": "historia_medicinal_monardes_1574", "target_name": "Anaxagoras", "similarity": 0.856}], "id": 1483, "stable_key": "clu_b666b0a42853029d", "ground_truth": {"modern_name": "Anaxagoras", "confidence": "high", "type": "person", "birth_year": -500, "death_year": -428, "description": "Ancient Greek philosopher and early cosmologist", "wikidata_id": "Q83041", "wikidata_description": "5th-century BC Greek philosopher", "wikipedia_url": "https://en.wikipedia.org/wiki/Anaxagoras", "wikipedia_extract": "Anaxagoras (; Ancient Greek: \u1f08\u03bd\u03b1\u03be\u03b1\u03b3\u03cc\u03c1\u03b1\u03c2, Anaxag\u00f3ras, 'lord of the assembly'; c. 500 BC \u2013 c. 428 BC) was a Pre-Socratic Greek philosopher. Born in Clazomenae at a time when Asia Minor was under the control of the Persian Empire, Anaxagoras came to Athens. In later life he was charged with impiety and went into exile in Lampsacus. Responding to the claims of Parmenides on the impossibility of change, Anaxagoras introduced the concept of Nous (Cosmic Mind) as an ordering force."}}, {"canonical_name": "Gunpowder", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "gunpowder", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Gunpowder", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["Gunpowder"], "contexts": ["explosive mixture", "discovered causes of meteors"]}, {"entity_id": "gunpowder", "book_id": "connexion_physical_sciences_somerville_1858", "name": "gunpowder", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["gunpowder"], "contexts": ["used by miners, source of heat"]}, {"entity_id": "gunpowder", "book_id": "first_principles_spencer_1862", "name": "gunpowder", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["gunpowder"], "contexts": ["substance that explodes", "explosion causes propulsion of a bullet"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Gunpowder", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "gunpowder", "similarity": 0.994}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Gunpowder", "target_book": "first_principles_spencer_1862", "target_name": "gunpowder", "similarity": 0.994}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "gunpowder", "target_book": "first_principles_spencer_1862", "target_name": "gunpowder", "similarity": 1.0}], "id": 1484, "stable_key": "clu_b6990047befd8e58", "ground_truth": {"modern_name": "Gunpowder", "confidence": "high", "type": "chemical", "wikidata_id": "Q12861", "wikidata_description": "explosive most commonly used as propellant in firearms", "wikipedia_url": "https://en.wikipedia.org/wiki/Gunpowder", "wikipedia_extract": "Gunpowder, commonly referred to as black powder to distinguish it from modern smokeless powder, is the earliest known chemical explosive. It consists of a mixture of sulfur, charcoal (which is mostly carbon), and potassium nitrate (saltpeter). The sulfur and charcoal act as fuels, while the saltpeter is an oxidizer. Gunpowder has been widely used as a propellant in firearms, artillery, rocketry, and pyrotechnics, including use as a blasting agent for explosives in quarrying, mining, building pipelines, tunnels, and roads. Gunpowder is classified as a low explosive because of its relatively slow decomposition rate, low ignition temperature and consequently low brisance (breaking/shattering). Low explosives deflagrate\u2014burning at subsonic speeds\u2014whereas high explosives detonate, producing a supersonic shockwave."}}, {"canonical_name": "Willow", "category": "PLANT", "subcategory": "TREE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "willow", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Willow", "category": "PLANT", "subcategory": "TREE", "count": 3, "variants": ["Willow"], "contexts": ["wood used for small-coal", "tree used in gunpowder composition"]}, {"entity_id": "willow", "book_id": "english_physician_1652", "name": "Willow", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Willow", "Willow-Hearb"], "contexts": ["tree where the herb grows", "or Willow Leavs"]}, {"entity_id": "willows", "book_id": "kosmos_humboldt_1845", "name": "willows", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["willows"], "contexts": ["tree species in Himalaya"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Willow", "target_book": "english_physician_1652", "target_name": "Willow", "similarity": 0.904}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Willow", "target_book": "kosmos_humboldt_1845", "target_name": "willows", "similarity": 0.919}], "id": 1485, "stable_key": "clu_087f818ec4bd4fc5", "ground_truth": {"modern_name": "Willow", "confidence": "high", "type": "plant", "linnaean": "Salix L.", "family": "Salicaceae", "wikidata_id": "Q36050", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Willow", "wikipedia_extract": "Willows, also called sallows and osiers, of the genus Salix, comprise around 350 species (plus numerous hybrids) of typically deciduous trees and shrubs. They are primarily found on moist soils in cold and temperate regions. Most species are known as willow, but some narrow-leaved shrub species are called osier, and some broader-leaved species are referred to as sallow (from Old English sealh, related to the Latin word salix, willow). Some willows (particularly arctic and alpine species) are low-growing or creeping shrubs; for example, the dwarf willow (Salix herbacea) rarely exceeds 6 centimetres (2+1\u20442 in) in height, though it spreads widely across the ground. Willows have watery bark sap rich in salicin, soft, usually pliant, tough wood, slender branches, and large, fibrous roots that are often stoloniferous. The roots are remarkable for their toughness, size, and tenacity to live, and roots readily sprout from aerial parts of the plant."}}, {"canonical_name": "Oak", "category": "PLANT", "subcategory": "TREE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "oaks", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Oaks", "category": "PLANT", "subcategory": "TREE", "count": 2, "variants": ["Oaks"], "contexts": ["large deciduous tree", "type of tree"]}, {"entity_id": "oak", "book_id": "origin_of_species_darwin_1859", "name": "Oak", "category": "PLANT", "subcategory": "TREE", "count": 3, "variants": ["oak", "Oak"], "contexts": ["common tree studied", "tree from which seeds were found"]}, {"entity_id": "oaks", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Oaks", "category": "PLANT", "subcategory": "TREE", "count": 2, "variants": ["oaks", "Oaks"], "contexts": ["flourish at high altitudes near equator", "trees near the equator"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Oaks", "target_book": "origin_of_species_darwin_1859", "target_name": "Oak", "similarity": 0.964}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Oaks", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Oaks", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Oak", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Oaks", "similarity": 0.964}], "id": 1486, "stable_key": "clu_363000d95e00cbb0", "ground_truth": {"modern_name": "Oak", "confidence": "high", "type": "plant", "family": "Fagaceae", "note": "'pedunculated oaks' refers to Quercus robur.", "wikidata_id": "Q12004", "wikidata_description": "genus of plants", "linnaean": "Quercus", "description": "A large tree known for its wood and acorns, with medicinal uses.", "wikipedia_extract": "An oak is a hardwood tree or shrub in the genus Quercus of the beech family. They have spirally arranged leaves, often with lobed edges, and a nut called an acorn, borne within a cup. The genus is widely distributed in the Northern Hemisphere, with some 500 species, both deciduous and evergreen. Fossil oaks date back to the Middle Eocene. Molecular phylogeny shows that the genus is divided into Old World and New World clades, but many oak species hybridise freely, making the genus's history difficult to resolve. Ecologically, oaks are keystone species in habitats from Mediterranean semi-desert to subtropical rainforest."}}, {"canonical_name": "circle", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "circle", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Circle", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["circle", "Circle"], "contexts": ["geometric shape with all points equidistant", "geometric shape with one center"]}, {"entity_id": "circle", "book_id": "principles_of_psychology_james_1890", "name": "circle", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["circle"], "contexts": ["geometric shape with a real form", "geometric shape for imagination"]}, {"entity_id": "circles", "book_id": "principles_of_psychology_james_1890", "name": "circles", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["circles"], "contexts": ["round shapes in a diagram"]}, {"entity_id": "great_circle", "book_id": "connexion_physical_sciences_somerville_1858", "name": "great circle", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["great circle"], "contexts": ["circle on sphere with same center"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Circle", "target_book": "principles_of_psychology_james_1890", "target_name": "circle", "similarity": 0.974}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Circle", "target_book": "principles_of_psychology_james_1890", "target_name": "circles", "similarity": 0.933}, {"source_book": "principles_of_psychology_james_1890", "source_name": "circle", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "great circle", "similarity": 0.886}], "id": 1487, "stable_key": "clu_215c6938db8dd9ab", "ground_truth": {"modern_name": "Circle", "confidence": "high", "type": "concept"}}, {"canonical_name": "Taprobana", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "taprobana", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Taprobana", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Taprobana"], "contexts": ["supposed location of Ophir", "supposed location in the Indies"]}, {"entity_id": "taprobane", "book_id": "epoques_nature_buffon_1778", "name": "Taprobane", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Taprobane"], "contexts": ["submerged island near torrid zone"]}, {"entity_id": "taprobana", "book_id": "coloquios_da_orta_1563", "name": "Taprobana", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Taprobana"], "contexts": ["ancient name for island", "island identified with Sumatra or Ceylon"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Taprobana", "target_book": "epoques_nature_buffon_1778", "target_name": "Taprobane", "similarity": 0.991}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Taprobana", "target_book": "coloquios_da_orta_1563", "target_name": "Taprobana", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Taprobane", "target_book": "coloquios_da_orta_1563", "target_name": "Taprobana", "similarity": 0.991}], "id": 1488, "stable_key": "clu_6550a75f6677960d", "ground_truth": {"modern_name": "Sri Lanka", "confidence": "high", "type": "place", "country": "Sri Lanka", "wikidata_id": "Q2002951", "wikidata_description": "ancient Greco-Roman name of Sri Lanka, also wrongly identified as Sumatra", "wikipedia_url": "https://en.wikipedia.org/wiki/Taprobana", "wikipedia_extract": "Sri Lanka, officially the Democratic Socialist Republic of Sri Lanka, formerly known as Ceylon, is an island country in South Asia. It is located in the Indian Ocean, southwest of the Bay of Bengal, and is separated from India by the Gulf of Mannar and the Palk Strait. Sri Lanka shares a maritime border with the Maldives to the southwest and India to the northwest, and lies across the Bay of Bengal from Bangladesh and Myanmar to the northeast and the Andaman and Nicobar Islands of India to the east. Its capital is Sri Jayawardenepura Kotte, while Colombo is its largest city and the political, financial and cultural centre. Sri Lanka's population is 22 million; with the Sinhalese people, who speak the Sinhala language, forming the vast majority\u2014while Tamil is spoken by the large Tamil minority. Other long-established ethnic groups include the Moors, Indian Tamils, Burghers, Malays, Chinese, and Vedda."}}, {"canonical_name": "Moss", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "moss", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Moss", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Moss"], "contexts": ["small flowerless plants", "plant mentioned alongside Polypody"]}, {"entity_id": "moss", "book_id": "english_physician_1652", "name": "Moss", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Moss"], "contexts": ["description of Lungwort's growth", "fresh moss steeped in oil of roses"]}, {"entity_id": "ground-moss", "book_id": "english_physician_1652", "name": "Ground-Moss", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Ground-Moss"], "contexts": ["type of moss"]}, {"entity_id": "tree-moss", "book_id": "english_physician_1652", "name": "Tree-Moss", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Tree-Moss"], "contexts": ["type of moss"]}, {"entity_id": "moss", "book_id": "kosmos_humboldt_1845", "name": "moss", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["moss"], "contexts": ["small, non-flowering plant"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Moss", "target_book": "english_physician_1652", "target_name": "Moss", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Moss", "target_book": "english_physician_1652", "target_name": "Ground-Moss", "similarity": 0.928}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Moss", "target_book": "english_physician_1652", "target_name": "Tree-Moss", "similarity": 0.948}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Moss", "target_book": "kosmos_humboldt_1845", "target_name": "moss", "similarity": 0.976}, {"source_book": "english_physician_1652", "source_name": "Moss", "target_book": "kosmos_humboldt_1845", "target_name": "moss", "similarity": 0.976}, {"source_book": "english_physician_1652", "source_name": "Ground-Moss", "target_book": "kosmos_humboldt_1845", "target_name": "moss", "similarity": 0.93}, {"source_book": "english_physician_1652", "source_name": "Tree-Moss", "target_book": "kosmos_humboldt_1845", "target_name": "moss", "similarity": 0.926}], "id": 1489, "stable_key": "clu_4b4f8a942df93fe1", "ground_truth": {"modern_name": "moss", "confidence": "high", "type": "plant", "note": "Early modern texts often referred to mosses collectively without specific taxonomic classification.", "wikidata_id": "Q25347", "wikidata_description": "division of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Moss", "wikipedia_extract": "Mosses are small, non-vascular flowerless plants in the taxonomic division Bryophyta (, ) sensu stricto. Bryophyta (sensu lato, Schimp. 1879) may also refer to the parent group bryophytes, which comprise liverworts, mosses, and hornworts. Mosses typically form dense green clumps or mats, often in damp or shady locations. The individual plants are usually composed of simple leaves that are generally only one cell thick, attached to a stem that may be branched or unbranched and has only a limited role in conducting water and nutrients. Although some species have conducting tissues, these are generally poorly developed and structurally different from similar tissue found in vascular plants. Mosses do not have seeds and after fertilisation develop sporophytes with unbranched stalks topped with single capsules containing spores."}}, {"canonical_name": "Beans", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "beans", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Beans", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Beans"], "contexts": ["food enjoined abstinence from"]}, {"entity_id": "beans", "book_id": "english_physician_1652", "name": "Beans", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["Beans", "Bean"], "contexts": ["vegetable with virtues", "vegetable with various medicinal uses"]}, {"entity_id": "beans", "book_id": "origin_of_species_darwin_1859", "name": "beans", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["beans"], "contexts": ["plant with seeds providing nutriment"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Beans", "target_book": "english_physician_1652", "target_name": "Beans", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Beans", "target_book": "origin_of_species_darwin_1859", "target_name": "beans", "similarity": 0.91}, {"source_book": "english_physician_1652", "source_name": "Beans", "target_book": "origin_of_species_darwin_1859", "target_name": "beans", "similarity": 0.91}], "id": 1490, "stable_key": "clu_d2679ee743a40994", "ground_truth": {"modern_name": "Bananas", "confidence": "low", "type": "plant", "description": "Tropical fruit-bearing plants.", "note": "The mention of 'beans' in the Darwin context seems an outlier and likely a misattribution or a secondary example. The dominant context is 'bananes'.", "wikipedia_extract": "A banana is an elongated, edible fruit\u2014botanically a berry\u2014produced by several kinds of large treelike herbaceous flowering plants in the genus Musa. In some countries, cooking bananas are called plantains, distinguishing them from dessert bananas. The fruit is variable in size, color and firmness, but is usually elongated and curved, with soft flesh rich in starch covered with a peel, which may have a variety of colors when ripe. It grows upward in clusters near the top of the plant. Almost all modern edible seedless (parthenocarp) cultivated bananas come from two wild species \u2013 Musa acuminata and Musa balbisiana, or their hybrids. Musa species are native to tropical Indomalaya and Australia; they were probably domesticated in New Guinea."}}, {"canonical_name": "education", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "education", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "education", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["education"], "contexts": ["process of teaching and learning"]}, {"entity_id": "education", "book_id": "principles_of_psychology_james_1890", "name": "education", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["education", "Education"], "contexts": ["process of learning and training", "journal on education"]}, {"entity_id": "education", "book_id": "first_principles_spencer_1862", "name": "education", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["education", "Education"], "contexts": ["book by Herbert Spencer", "process of learning"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "education", "target_book": "principles_of_psychology_james_1890", "target_name": "education", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "education", "target_book": "first_principles_spencer_1862", "target_name": "education", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "education", "target_book": "first_principles_spencer_1862", "target_name": "education", "similarity": 1.0}], "id": 1491, "stable_key": "clu_18f6833f37ea72ae", "ground_truth": {"modern_name": "Education", "confidence": "high", "type": "concept", "wikidata_id": "Q7922", "wikidata_description": "theory and practice of education"}}, {"canonical_name": "Ibrahim", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "abraham", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Abraham", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Abraham"], "contexts": ["biblical figure"]}, {"entity_id": "ibrahim_ben_ahmed", "book_id": "kosmos_humboldt_1845", "name": "Ibrahim ben Ahmed", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Ibrahim ben Ahmed"], "contexts": ["King who died during meteor shower"]}, {"entity_id": "ibrahim", "book_id": "coloquios_da_orta_1563", "name": "Ibrahim", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 5, "variants": ["Ibrahim", "Abraham", "Abrah\u00e3o"], "contexts": ["brother and successor of MuU\u00fa", "son of Ali, reigned during Orta's time"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Abraham", "target_book": "coloquios_da_orta_1563", "target_name": "Ibrahim", "similarity": 0.942}, {"source_book": "kosmos_humboldt_1845", "source_name": "Ibrahim ben Ahmed", "target_book": "coloquios_da_orta_1563", "target_name": "Ibrahim", "similarity": 0.892}], "id": 1492, "stable_key": "clu_e45e49e60a7670b8", "ground_truth": {"modern_name": "Abraham", "confidence": "medium", "type": "person", "description": "Biblical patriarch, founder of Abrahamic religions.", "note": "The cluster includes both the biblical Abraham and a figure named Ibrahim ben Ahmed, and another Ibrahim. Given the 'Abraham' mention, this is the most likely referent, but with some ambiguity.", "wikidata_id": "", "wikidata_description": "family name"}}, {"canonical_name": "Bosphore", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "bosphore", "book_id": "epoques_nature_buffon_1778", "name": "Bosphore", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Bosphore"], "contexts": ["strait connecting Black Sea to Sea of Marmara", "strait connecting Black Sea and Sea of Marmara"]}, {"entity_id": "b\u00f3sforo", "book_id": "coloquios_da_orta_1563", "name": "B\u00f3sforo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["B\u00f3sforo"], "contexts": ["location associated with cardamomo origin"]}, {"entity_id": "bosphoro", "book_id": "ricettario_fiorentino_1597", "name": "Bosphoro", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Bosphoro", "Bofphoro"], "contexts": ["place where Cardamomo is said to come from", "place of origin for a substance"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Bosphore", "target_book": "coloquios_da_orta_1563", "target_name": "B\u00f3sforo", "similarity": 0.913}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Bosphore", "target_book": "ricettario_fiorentino_1597", "target_name": "Bosphoro", "similarity": 0.992}, {"source_book": "coloquios_da_orta_1563", "source_name": "B\u00f3sforo", "target_book": "ricettario_fiorentino_1597", "target_name": "Bosphoro", "similarity": 0.923}], "id": 1493, "stable_key": "clu_14bdb57479db3ea5", "ground_truth": {"modern_name": "Strait of Istanbul", "confidence": "high", "type": "place", "country": "Turkey", "note": "Bosphorus is a well-known strait and a historical trade route, making it a plausible origin for spices like Cardamomo.", "wikidata_id": "Q35958", "wikidata_description": "narrow strait in northwestern Turkey", "wikipedia_url": "https://en.wikipedia.org/wiki/Dardanelles", "wikipedia_extract": "The Dardanelles ( DAR-d\u0259-NELZ; Turkish: \u00c7anakkale Bo\u011faz\u0131, lit. 'Strait of \u00c7anakkale'; Greek: \u0394\u03b1\u03c1\u03b4\u03b1\u03bd\u03ad\u03bb\u03bb\u03b9\u03b1, romanized: Dardan\u00e9llia), also known as the Strait of Gallipoli (after the Gallipoli peninsula), is a narrow, natural strait and internationally significant waterway in northwestern Turkey that forms part of the continental boundary between Asia and Europe and separates Asian Turkey from European Turkey. Together with the Bosporus, the Dardanelles forms the Turkish Straits. One of the world's narrowest straits used for international navigation, the Dardanelles connects the Sea of Marmara with the Aegean and Mediterranean seas while also allowing passage to the Black Sea by extension via the Bosporus. The Dardanelles is 61 kilometres (38 mi) long and 1.2 to 6 kilometres (0.75 to 3.73 mi) wide. It has an average depth of 55 metres (180 ft) with a maximum depth of 103 metres (338 ft) at its narrowest point abreast the city of \u00c7anakkale."}}, {"canonical_name": "surface de la terre", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "surface_de_la_terre", "book_id": "epoques_nature_buffon_1778", "name": "surface de la terre", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["surface de la terre"], "contexts": ["outer layer of the planet", "earth's surface"]}, {"entity_id": "terrestrial_surface", "book_id": "kosmos_humboldt_1845", "name": "terrestrial surface", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["terrestrial surface"], "contexts": ["Gothic meaning of 'mundus'", "surface of the Earth"]}, {"entity_id": "surface_of_the_globe", "book_id": "connexion_physical_sciences_somerville_1858", "name": "surface of the globe", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["surface of the globe"], "contexts": ["area covered by storm vortex"]}, {"entity_id": "surface_of_the_earth", "book_id": "connexion_physical_sciences_somerville_1858", "name": "surface of the earth", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["surface of the earth"], "contexts": ["outer layer of the planet"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "surface de la terre", "target_book": "kosmos_humboldt_1845", "target_name": "terrestrial surface", "similarity": 0.973}, {"source_book": "epoques_nature_buffon_1778", "source_name": "surface de la terre", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "surface of the globe", "similarity": 0.938}, {"source_book": "epoques_nature_buffon_1778", "source_name": "surface de la terre", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "surface of the earth", "similarity": 0.985}, {"source_book": "kosmos_humboldt_1845", "source_name": "terrestrial surface", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "surface of the globe", "similarity": 0.921}, {"source_book": "kosmos_humboldt_1845", "source_name": "terrestrial surface", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "surface of the earth", "similarity": 0.962}], "id": 1494, "stable_key": "clu_aa65d61a2aba89db", "ground_truth": {"modern_name": "Earth's surface", "confidence": "high", "type": "place"}}, {"canonical_name": "Sicile", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "sicile", "book_id": "epoques_nature_buffon_1778", "name": "Sicile", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Sicile"], "contexts": ["island region of Italy", "Mediterranean island"]}, {"entity_id": "sicily", "book_id": "origin_of_species_darwin_1859", "name": "Sicily", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Sicily"], "contexts": ["island where a species was found fossil", "island with marine inhabitants"]}, {"entity_id": "sicilae", "book_id": "kosmos_humboldt_1845", "name": "Sicilae", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Sicilae"], "contexts": ["Latin for Sicily"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Sicile", "target_book": "origin_of_species_darwin_1859", "target_name": "Sicily", "similarity": 0.892}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Sicile", "target_book": "kosmos_humboldt_1845", "target_name": "Sicilae", "similarity": 0.894}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Sicily", "target_book": "kosmos_humboldt_1845", "target_name": "Sicilae", "similarity": 0.979}], "id": 1495, "stable_key": "clu_13aa74a4c5872a8c-2", "ground_truth": {"modern_name": "Sicily", "confidence": "high", "type": "place", "country": "Italy", "note": "The reference to Hybla, an ancient city in Sicily, and its Mediterranean location firmly identifies this island.", "wikidata_id": "Q1460", "wikidata_description": "island in the Mediterranean, region of Italy", "wikipedia_url": "https://en.wikipedia.org/wiki/Sicily", "wikipedia_extract": "Sicily (Italian and Sicilian: Sicilia) is an island in the central Mediterranean Sea and one of the twenty regions of Italy, situated south of the Italian Peninsula in continental Europe. With 4.7 million inhabitants, including 1.2 million in and around the capital city of Palermo, it is both the largest and most populous island in the Mediterranean Sea. Sicily's namesake is the Sicels, who inhabited the eastern part of the island during the Iron Age. Sicily has a rich and unique culture in arts, music, literature, cuisine, and architecture. Its most prominent landmark is Mount Etna, the tallest active volcano in Europe, and one of the most active in the world, currently 3,403 m (11,165 ft) high. The island has a typical Mediterranean climate."}}, {"canonical_name": "Elements", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "\u00e9l\u00e9ments", "book_id": "epoques_nature_buffon_1778", "name": "\u00e9l\u00e9ments", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["\u00e9l\u00e9ments"], "contexts": ["fundamental constituents of matter", "fundamental components"]}, {"entity_id": "elements", "book_id": "english_physician_1652", "name": "Elements", "category": "CONCEPT", "subcategory": "THEORY", "count": 4, "variants": ["Elements"], "contexts": ["world formed of a composition of contrary elements", "components extracted from the herb"]}, {"entity_id": "elementos", "book_id": "historia_medicinal_monardes_1574", "name": "elementos", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["elementos"], "contexts": ["proposed origin of metals"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "\u00e9l\u00e9ments", "target_book": "english_physician_1652", "target_name": "Elements", "similarity": 0.912}, {"source_book": "epoques_nature_buffon_1778", "source_name": "\u00e9l\u00e9ments", "target_book": "historia_medicinal_monardes_1574", "target_name": "elementos", "similarity": 0.971}, {"source_book": "english_physician_1652", "source_name": "Elements", "target_book": "historia_medicinal_monardes_1574", "target_name": "elementos", "similarity": 0.899}], "id": 1496, "stable_key": "clu_9e081c25539364f4", "ground_truth": {"modern_name": "Classical elements", "confidence": "high", "type": "concept", "note": "Refers to the classical philosophical concept of earth, air, fire, and water, not chemical elements.", "wikidata_id": "Q188520", "wikidata_description": "group of constituent basic elements of matter (water, earth, fire, air and sometimes aether), used to explain nature patterns since ancient times"}}, {"canonical_name": "Mexicaine", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "mexico", "book_id": "epoques_nature_buffon_1778", "name": "Mexico", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Mexico"], "contexts": ["city where Cordilleras curve west and then east", "geographic location in America"]}, {"entity_id": "mexicos", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "mexicos", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["mexicos"], "contexts": ["Mexicans"]}, {"entity_id": "mexicaine", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Mexicaine", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Mexicaine", "Mexicaines", "mexicain"], "contexts": ["referring to Mexico", "race of people"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Mexico", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "mexicos", "similarity": 0.93}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Mexico", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Mexicaine", "similarity": 0.881}, {"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "mexicos", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Mexicaine", "similarity": 0.889}], "id": 1497, "stable_key": "clu_c2fad7d485d1c97d", "ground_truth": {"modern_name": "Mexico", "confidence": "high", "type": "place", "country": "Mexico", "note": "The various spellings and context clearly point to the country of Mexico and its people.", "wikidata_id": "Q6826187", "wikidata_description": "genus of insects", "wikipedia_url": "https://en.wikipedia.org/wiki/Mexico%20%28beetle%29"}}, {"canonical_name": "Perseus", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "perses", "book_id": "epoques_nature_buffon_1778", "name": "Perses", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Perses"], "contexts": ["people who may have received knowledge", "people who received distorted ideas"]}, {"entity_id": "perseus", "book_id": "kosmos_humboldt_1845", "name": "Perseus", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Perseus"], "contexts": ["constellation near meteor origin point", "point of origin for meteors"]}, {"entity_id": "perseus", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Perseus", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Perseus"], "contexts": ["constellation through which circle would pass", "constellation with a variable star"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "Perses", "target_book": "kosmos_humboldt_1845", "target_name": "Perseus", "similarity": 0.912}, {"source_book": "epoques_nature_buffon_1778", "source_name": "Perses", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Perseus", "similarity": 0.912}, {"source_book": "kosmos_humboldt_1845", "source_name": "Perseus", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Perseus", "similarity": 1.0}], "id": 1498, "stable_key": "clu_1cb27a4ea7d15b43", "ground_truth": {"modern_name": "Perseus", "confidence": "high", "type": "place", "note": "While 'Perseus' can refer to a mythological figure or a language, its context in scientific texts (astronomy, physical sciences) strongly suggests the constellation.", "wikipedia_extract": "In Greek mythology, Perseus (US:  , UK: ; Greek: \u03a0\u03b5\u03c1\u03c3\u03b5\u03cd\u03c2, translit. Perse\u00fas) is the legendary founder of the Perseid dynasty. He was, alongside Cadmus and Bellerophon, the greatest Greek hero and slayer of monsters before the days of Heracles. He beheaded the Gorgon Medusa for Polydectes and saved Andromeda from the sea monster Cetus. He was a demigod, being the son of Zeus and the mortal Dana\u00eb, as well as the half-brother and great-grandfather of Heracles (as they were both children of Zeus, and Heracles's mother was Perseus's granddaughter). Because of the obscurity of the name \"Perseus\" and the legendary character of its bearer, most etymologists presume that it might be pre-Greek; however, the name of Perseus's native city was Greek and so were the names of his wife and relatives."}}, {"canonical_name": "solar heat", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "la_chaleur_envoy\u00e9e_par_le_soleil", "book_id": "epoques_nature_buffon_1778", "name": "la chaleur envoy\u00e9e par le soleil", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["la chaleur envoy\u00e9e par le soleil"], "contexts": ["heat from the sun"]}, {"entity_id": "sun\u2019s_heat", "book_id": "connexion_physical_sciences_somerville_1858", "name": "sun\u2019s heat", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["sun\u2019s heat"], "contexts": ["heat radiated by the Sun"]}, {"entity_id": "solar_heat", "book_id": "first_principles_spencer_1862", "name": "solar heat", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["solar heat"], "contexts": ["absorbed by ocean, drives currents", "indirect effect on geological changes"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "la chaleur envoy\u00e9e par le soleil", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sun\u2019s heat", "similarity": 0.923}, {"source_book": "epoques_nature_buffon_1778", "source_name": "la chaleur envoy\u00e9e par le soleil", "target_book": "first_principles_spencer_1862", "target_name": "solar heat", "similarity": 0.921}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "sun\u2019s heat", "target_book": "first_principles_spencer_1862", "target_name": "solar heat", "similarity": 0.934}], "id": 1499, "stable_key": "clu_518acb13d5b64204", "ground_truth": {"modern_name": "Solar heat", "confidence": "high", "type": "concept", "wikidata_id": "Q7556096", "wikidata_description": "solar collection system which provides both heating and cooling"}}, {"canonical_name": "boussole", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "boussole", "book_id": "epoques_nature_buffon_1778", "name": "boussole", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["boussole"], "contexts": ["navigational instrument indicating direction"]}, {"entity_id": "boussole", "book_id": "relation_historique_humboldt_vol3_1825", "name": "boussole", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 5, "variants": ["boussole", "boussole de Borda", "boussole de Gambey"], "contexts": ["instrument for taking bearings", "instrument for navigation"]}, {"entity_id": "boussole", "book_id": "kosmos_humboldt_1845", "name": "Boussole", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["Boussole"], "contexts": ["French for compass"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "boussole", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "boussole", "similarity": 1.0}, {"source_book": "epoques_nature_buffon_1778", "source_name": "boussole", "target_book": "kosmos_humboldt_1845", "target_name": "Boussole", "similarity": 0.893}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "boussole", "target_book": "kosmos_humboldt_1845", "target_name": "Boussole", "similarity": 0.893}], "id": 1500, "stable_key": "clu_bed6ee3eec4eedbd-2", "ground_truth": {"modern_name": "compass", "confidence": "high", "type": "object", "wikidata_id": "Q2476036", "wikidata_description": "American independent record label based in Nashville, Tennessee", "wikipedia_url": "https://en.wikipedia.org/wiki/Compass%20Records", "wikipedia_extract": "A compass is a device that shows the cardinal directions used for navigation and geographic orientation. It typically consists of a magnetized needle or another element, such as a compass card or compass rose, that pivots to align itself with magnetic north. Other methods may be used, including gyroscopes, magnetometers, and GPS receivers. Compasses often show angles in degrees: north corresponds to 0\u00b0, and the angles increase clockwise, so east is 90\u00b0, south is 180\u00b0, and west is 270\u00b0. These numbers allow the compass to show azimuths or bearings which are commonly stated in degrees. If local variation between magnetic north and true north is known, then direction of magnetic north also gives direction of true north.", "note": "The term 'boussole' is the French word for compass."}}, {"canonical_name": "sol