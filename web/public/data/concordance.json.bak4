nt": 8, "variants": ["Alkalies", "alkalies"], "contexts": ["go to the negative wire", "substances that go to the negative wire"]}, {"entity_id": "alkalies", "book_id": "kosmos_humboldt_1845", "name": "alkalies", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["alkalies"], "contexts": ["in the alkalies, metals discovered", "chemical compounds in Earth's nucleus"]}, {"entity_id": "alkali", "book_id": "connexion_physical_sciences_somerville_1858", "name": "alkali", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["alkali"], "contexts": ["solid substance in water producing negative electricity", "solid substance in vapour producing negative electricity"]}, {"entity_id": "alkalies", "book_id": "first_principles_spencer_1862", "name": "alkalies", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["alkalies"], "contexts": ["basic chemical compounds"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "alcalo\u00efdes", "target_book": "polyanthea_medicinal", "target_name": "alcalicos", "similarity": 0.956}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "alcalo\u00efdes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "alkalies", "similarity": 0.922}, {"source_book": "polyanthea_medicinal", "source_name": "alcalicos", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "alkalies", "similarity": 0.936}, {"source_book": "kosmos_humboldt_1845", "source_name": "alkalies", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "alkali", "similarity": 0.946}, {"source_book": "kosmos_humboldt_1845", "source_name": "alkalies", "target_book": "first_principles_spencer_1862", "target_name": "alkalies", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "alkali", "target_book": "first_principles_spencer_1862", "target_name": "alkalies", "similarity": 0.946}], "id": 180, "stable_key": "clu_8707201a32d5e475", "ground_truth": {"modern_name": "Alkali", "confidence": "high", "type": "chemical", "wikidata_id": "Q11193", "wikidata_description": "chemical substance that can react with an acid, accepting hydrogen ions (protons) or more generally, donating a pair of valence electrons", "wikipedia_url": "https://en.wikipedia.org/wiki/Base%20%28chemistry%29", "wikipedia_extract": "In chemistry, there are three definitions in common use of the word \"base\": Arrhenius bases, Br\u00f8nsted bases, and Lewis bases. All definitions agree that bases are substances that react with acids, as originally proposed by G.-F. Rouelle in the mid-18th century. In 1884, Svante Arrhenius proposed that a base is a substance which dissociates in aqueous solution to form hydroxide ions OH\u2212. These ions can react with hydrogen ions (H+ according to Arrhenius) from the dissociation of acids to form water in an acid\u2013base reaction. A base was therefore a metal hydroxide such as NaOH or Ca(OH)2."}}, {"canonical_name": "Tree", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 5, "total_mentions": 23, "members": [{"entity_id": "tree", "book_id": "english_physician_1652", "name": "Tree", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 11, "variants": ["Tree", "Trees"], "contexts": ["plant associated with the sun", "description of Birch-Tree"]}, {"entity_id": "tree", "book_id": "principles_of_psychology_james_1890", "name": "tree", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["tree"], "contexts": ["woody perennial plant", "large woody plant"]}, {"entity_id": "arbusto", "book_id": "coloquios_da_orta_1563", "name": "arbusto", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["arbusto"], "contexts": ["type of plant"]}, {"entity_id": "tree", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Tree", "category": "PLANT", "subcategory": "TREE", "count": 4, "variants": ["Tree"], "contexts": ["shape observed in fern root", "general term for spice-bearing plants"]}, {"entity_id": "tree", "book_id": "kosmos_humboldt_1845", "name": "tree", "category": "PLANT", "subcategory": "TREE", "count": 3, "variants": ["tree"], "contexts": ["woody perennial plant"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Tree", "target_book": "principles_of_psychology_james_1890", "target_name": "tree", "similarity": 0.993}, {"source_book": "english_physician_1652", "source_name": "Tree", "target_book": "coloquios_da_orta_1563", "target_name": "arbusto", "similarity": 0.952}, {"source_book": "principles_of_psychology_james_1890", "source_name": "tree", "target_book": "coloquios_da_orta_1563", "target_name": "arbusto", "similarity": 0.953}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Tree", "target_book": "kosmos_humboldt_1845", "target_name": "tree", "similarity": 0.99}], "id": 181, "stable_key": "clu_c3c188d2ab77cd00", "ground_truth": {"modern_name": "Tree", "confidence": "high", "type": "plant", "note": "This cluster refers to the general category of 'tree' rather than a specific species. 'Arbusto' (shrub) is a related but distinct botanical term.", "wikidata_id": "Q10884", "wikidata_description": "perennial woody plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Tree", "wikipedia_extract": "In botany, a tree is a perennial plant with an elongated stem, or trunk, usually supporting branches and leaves. In some usages, the definition of a tree may be narrower, e.g., including only woody plants with secondary growth, only plants that are usable as lumber, or only plants above a specified height. Wider definitions include taller palms, tree ferns, bananas, and bamboos. Trees are not a monophyletic taxonomic group but consist of a wide variety of plant species that have independently evolved a trunk and branches as a way to tower above other plants to compete for sunlight. The majority of tree species are angiosperms or hardwoods; of the rest, many are gymnosperms or softwoods. Trees tend to be long-lived, some trees reaching several thousand years old.", "description": "A woody perennial plant, typically having a single stem or trunk."}}, {"canonical_name": "fibres", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 5, "total_mentions": 22, "members": [{"entity_id": "fibres", "book_id": "medecine_experimentale_bernard_1865", "name": "fibres", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["fibres"], "contexts": ["elongated cells or structures", "histological elements, thread-like structures"]}, {"entity_id": "mati\u00e8re_fibreuse", "book_id": "relation_historique_humboldt_vol3_1825", "name": "mati\u00e8re fibreuse", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["mati\u00e8re fibreuse"], "contexts": ["fibrous substance"]}, {"entity_id": "fibres", "book_id": "principles_of_psychology_james_1890", "name": "fibres", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 15, "variants": ["fibres"], "contexts": ["nerve fibers transmitting signals", "nerve or muscle components"]}, {"entity_id": "fibres", "book_id": "connexion_physical_sciences_somerville_1858", "name": "fibres", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["fibres"], "contexts": ["elongated cellular structures"]}, {"entity_id": "fibres", "book_id": "first_principles_spencer_1862", "name": "fibres", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["fibres"], "contexts": ["minute components of tissue", "rupture of nerve fibres"]}], "edges": [{"source_book": "medecine_experimentale_bernard_1865", "source_name": "fibres", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "mati\u00e8re fibreuse", "similarity": 0.919}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "fibres", "target_book": "principles_of_psychology_james_1890", "target_name": "fibres", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "fibres", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "fibres", "similarity": 1.0}, {"source_book": "medecine_experimentale_bernard_1865", "source_name": "fibres", "target_book": "first_principles_spencer_1862", "target_name": "fibres", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "mati\u00e8re fibreuse", "target_book": "principles_of_psychology_james_1890", "target_name": "fibres", "similarity": 0.919}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "mati\u00e8re fibreuse", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "fibres", "similarity": 0.919}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "mati\u00e8re fibreuse", "target_book": "first_principles_spencer_1862", "target_name": "fibres", "similarity": 0.919}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fibres", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "fibres", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fibres", "target_book": "first_principles_spencer_1862", "target_name": "fibres", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "fibres", "target_book": "first_principles_spencer_1862", "target_name": "fibres", "similarity": 1.0}], "id": 182, "stable_key": "clu_3f08fece8148d209", "ground_truth": {"modern_name": "fibers", "confidence": "high", "type": "concept", "note": "Refers to elongated structures, which can be cellular (like nerve fibers) or general fibrous substances, fitting a conceptual rather than specific biological entity.", "wikidata_id": "Q215210", "wikidata_description": "indigestible portion of food derived from plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Dietary%20fiber", "wikipedia_extract": "Dietary fiber, fibre, or roughage is the portion of plant-derived food that cannot be completely broken down by human digestive enzymes. Dietary fibers are diverse in chemical composition and can be grouped generally by their solubility, viscosity and fermentability which affect how fibers are processed in the body. Dietary fiber has two main subtypes: soluble fiber and insoluble fiber which are components of plant-based foods such as legumes, whole grains, cereals, vegetables, fruits, nuts, and seeds. A diet high in regular fiber consumption is generally associated with supporting health and lowering the risk of several diseases. Dietary fiber consists of non-starch polysaccharides and other plant components such as cellulose, resistant starch, resistant dextrins, inulins, lignins, chitins, pectins, beta-glucans, and oligosaccharides. Food sources of dietary fiber have traditionally been divided according to whether they provide soluble or insoluble fiber."}}, {"canonical_name": "metals", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 5, "total_mentions": 22, "members": [{"entity_id": "metals", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Metals", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["Metals"], "contexts": ["elemental substances", "metallic elements"]}, {"entity_id": "metals", "book_id": "principles_of_psychology_james_1890", "name": "metals", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["metals"], "contexts": ["substance applied to transfer paralysis", "used to remove nervous disorder"]}, {"entity_id": "metals", "book_id": "kosmos_humboldt_1845", "name": "metals", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["metals"], "contexts": ["contact of two heterogeneous metals", "alkalies, metals of a silvery luster"]}, {"entity_id": "metals", "book_id": "connexion_physical_sciences_somerville_1858", "name": "metals", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 9, "variants": ["metals", "Metals"], "contexts": ["elements with metallic properties", "class of elements with metallic properties"]}, {"entity_id": "metals", "book_id": "first_principles_spencer_1862", "name": "metals", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["metals"], "contexts": ["apparently unalterable substances affected by light", "elements like iron, gold, etc."]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Metals", "target_book": "principles_of_psychology_james_1890", "target_name": "metals", "similarity": 0.992}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Metals", "target_book": "kosmos_humboldt_1845", "target_name": "metals", "similarity": 0.992}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Metals", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "metals", "similarity": 0.992}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Metals", "target_book": "first_principles_spencer_1862", "target_name": "metals", "similarity": 0.992}, {"source_book": "principles_of_psychology_james_1890", "source_name": "metals", "target_book": "kosmos_humboldt_1845", "target_name": "metals", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "metals", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "metals", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "metals", "target_book": "first_principles_spencer_1862", "target_name": "metals", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "metals", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "metals", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "metals", "target_book": "first_principles_spencer_1862", "target_name": "metals", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "metals", "target_book": "first_principles_spencer_1862", "target_name": "metals", "similarity": 1.0}], "id": 183, "stable_key": "clu_7907da80da20d2e2-2", "ground_truth": {"modern_name": "Metal", "confidence": "high", "type": "mineral", "wikidata_id": "Q11426", "wikidata_description": "element, compound, or alloy that is a good conductor of both electricity and heat", "wikipedia_url": "https://en.wikipedia.org/wiki/Metal", "note": "The Latin 'rerum metallicarum' directly translates to 'of metallic things' or 'metallic substances'. The context of electrical conductivity reinforces this.", "wikipedia_extract": "A metal (from Ancient Greek  \u03bc\u03ad\u03c4\u03b1\u03bb\u03bb\u03bf\u03bd (m\u00e9tallon) 'mine, quarry, metal') is a material that, when polished or fractured, shows a lustrous appearance, and conducts electricity and heat relatively well. These properties are all associated with having electrons available at the Fermi level, as opposed to nonmetallic materials which do not. Metals are typically ductile (can be drawn into a wire) and malleable (can be shaped via hammering or pressing). A metal may be a chemical element, such as iron, an alloy, such as stainless steel, or a molecular compound, such as polymeric sulfur nitride. The general science of metals is called metallurgy, a subtopic of materials science; aspects of their electronic and thermal properties are also within the scope of condensed matter physics and solid-state chemistry, as it is a multidisciplinary topic. In colloquial use, materials such as steel alloys are referred to as metals, while others, such as polymers, wood, or ceramics are nonmetallic materials."}}, {"canonical_name": "eyes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 5, "total_mentions": 22, "members": [{"entity_id": "eyes", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "eyes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["eyes"], "contexts": ["organs of sight"]}, {"entity_id": "eyes", "book_id": "origin_of_species_darwin_1859", "name": "eyes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["eyes"], "contexts": ["organs of sight", "sensory organs for sight"]}, {"entity_id": "eyes", "book_id": "principles_of_psychology_james_1890", "name": "eyes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 13, "variants": ["eyes"], "contexts": ["organs of sight", "sensory organs for vision"]}, {"entity_id": "eyes", "book_id": "kosmos_humboldt_1845", "name": "eyes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["eyes"], "contexts": ["preserved organ of Cephalopodes", "organs of sight"]}, {"entity_id": "eyes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "eyes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["eyes"], "contexts": ["sensory organs for sight", "sense organ perceiving light"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "eyes", "target_book": "origin_of_species_darwin_1859", "target_name": "eyes", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "eyes", "target_book": "principles_of_psychology_james_1890", "target_name": "eyes", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "eyes", "target_book": "kosmos_humboldt_1845", "target_name": "eyes", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "eyes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "eyes", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "eyes", "target_book": "principles_of_psychology_james_1890", "target_name": "eyes", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "eyes", "target_book": "kosmos_humboldt_1845", "target_name": "eyes", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "eyes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "eyes", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "eyes", "target_book": "kosmos_humboldt_1845", "target_name": "eyes", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "eyes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "eyes", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "eyes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "eyes", "similarity": 1.0}], "id": 184, "stable_key": "clu_f407d4f32f9232a2-2", "ground_truth": {"modern_name": "Eye", "confidence": "high", "type": "object", "wikidata_id": "Q7364", "wikidata_description": "organ that detects light and converts it into electro-chemical impulses in neurons", "wikipedia_url": "https://en.wikipedia.org/wiki/Eye", "note": "While 'eyes' can refer to a part of an animal, the contexts and the general usage in natural philosophy lean towards the organ of sight as an object of study rather than the animal itself.", "wikipedia_extract": "An eye is a sensory organ that allows an organism to perceive visual information. It detects light and converts it into electro-chemical impulses in neurons (neurones). It is part of an organism's visual system. In higher organisms, the eye is a complex optical system that collects light from the surrounding environment, regulates its intensity through a diaphragm, focuses it through an adjustable assembly of lenses to form an image, converts this image into a set of electrical signals, and transmits these signals to the brain through neural pathways that connect the eye via the optic nerve to the visual cortex and other areas of the brain. Eyes with resolving power have come in ten fundamentally different forms, classified into compound eyes and non-compound eyes. Compound eyes are made up of multiple small visual units, and are common on insects and crustaceans."}}, {"canonical_name": "Romans", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 5, "total_mentions": 21, "members": [{"entity_id": "romans", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Romans", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Romans"], "contexts": ["people of Rome"]}, {"entity_id": "romans", "book_id": "english_physician_1652", "name": "Romans", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Romans", "Roman"], "contexts": ["the Romans cannot be very free from maintaining so many Baudy Houses", "ancient people associated with authority"]}, {"entity_id": "romans", "book_id": "origin_of_species_darwin_1859", "name": "Romans", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Romans"], "contexts": ["ancient civilization"]}, {"entity_id": "romans", "book_id": "kosmos_humboldt_1845", "name": "Romans", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 10, "variants": ["Romans"], "contexts": ["ancient civilization interpreting nature", "ancient interpreters of concepts"]}, {"entity_id": "romanos", "book_id": "historia_medicinal_monardes_1574", "name": "romanos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 5, "variants": ["romanos", "Romanos"], "contexts": ["ancient people who esteemed iron", "people who made coins of gold and silver"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Romans", "target_book": "english_physician_1652", "target_name": "Romans", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Romans", "target_book": "origin_o