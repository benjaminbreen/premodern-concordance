"book_id": "relation_historique_humboldt_vol3_1825", "name": "brebis", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 3, "variants": ["brebis"], "contexts": ["sheep abundant in certain regions", "livestock counted in the West Department"]}], "edges": [{"source_book": "epoques_nature_buffon_1778", "source_name": "brebis", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "brebis", "similarity": 1.0}], "id": 3966, "stable_key": "clu_cb4b1fbd567d8aca", "ground_truth": {"modern_name": "sheep", "confidence": "high", "type": "animal", "wikidata_id": "Q4628", "wikidata_description": "North Atlantic archipelago organized as an autonomous constituent country of the Kingdom of Denmark", "wikipedia_url": "https://en.wikipedia.org/wiki/Faroe%20Islands"}}, {"canonical_name": "Saxifrage", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "saxifrage", "book_id": "english_physician_1652", "name": "Saxifrage", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Saxifrage", "Saxifrages"], "contexts": ["root used in Tragus's medicine", "herb with roots, leaves, flowers, and seed"]}, {"entity_id": "saxifrages", "book_id": "kosmos_humboldt_1845", "name": "saxifrages", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["saxifrages"], "contexts": ["plant in a specific botanical region"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Saxifrage", "target_book": "kosmos_humboldt_1845", "target_name": "saxifrages", "similarity": 0.882}], "id": 3967, "stable_key": "clu_dbd6420b90928888", "ground_truth": {"modern_name": "Saxifrage", "confidence": "high", "type": "plant", "linnaean": "Saxifraga", "family": "Saxifragaceae", "wikidata_id": "Q156146", "wikidata_description": "genus of plants in the saxifrage family (Saxifragaceae)", "wikipedia_url": "https://en.wikipedia.org/wiki/Saxifraga", "wikipedia_extract": "Saxifraga is the largest genus in the family Saxifragaceae, containing about 473 species of holarctic perennial plants, known as saxifrages or rockfoils. The Latin word saxifraga means literally \"stone-breaker\", from Latin saxum (\"rock\" or \"stone\") + frangere (\"to break\"). It is usually thought to indicate a medicinal use for treatment of urinary calculi (known as kidney or bladder stones), rather than breaking rocks apart. Most saxifrages are small perennial, biennial (e.g., S. adscendens) or annual (e.g., S. tridactylites) herbaceous plants whose basal or cauline leaves grow close to the ground, often in a rosette."}}, {"canonical_name": "Diarhodon Abhatis", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "diarhodon_abhatis", "book_id": "english_physician_1652", "name": "Diarhodon Abhatis", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 3, "variants": ["Diarhodon Abhatis", "Diarhodon Abbatis", "Diarhodon Abba\u2223tis"], "contexts": ["named cordial powder", "cordial powder for heart and stomach"]}, {"entity_id": "diarhodon", "book_id": "polyanthea_medicinal", "name": "Diarhodon", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Diarhodon"], "contexts": ["a medicinal preparation"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Diarhodon Abhatis", "target_book": "polyanthea_medicinal", "target_name": "Diarhodon", "similarity": 0.893}], "id": 3968, "stable_key": "clu_44ca923e2348ff8a", "ground_truth": {"modern_name": "Diarhodon Abhatis", "confidence": "high", "type": "chemical", "note": "This is a specific named compound or preparation, likely a cordial, mentioned in historical pharmacopoeias."}}, {"canonical_name": "Hops", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "hops", "book_id": "english_physician_1652", "name": "Hops", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Hops"], "contexts": ["herb used in preparation", "well-known cultivated plant"]}, {"entity_id": "hops", "book_id": "first_principles_spencer_1862", "name": "hops", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["hops"], "contexts": ["rural inhabitants producing hops"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Hops", "target_book": "first_principles_spencer_1862", "target_name": "hops", "similarity": 0.963}], "id": 3969, "stable_key": "clu_c0921489ff1e6f98", "ground_truth": {"modern_name": "Hops", "confidence": "high", "type": "plant", "linnaean": "Humulus lupulus Linnaeus", "family": "Cannabaceae", "wikidata_id": "Q58393", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Dodonaea%20viscosa", "wikipedia_extract": "Hops are the flowers (also called seed cones or strobiles) of the hop plant Humulus lupulus, a member of the Cannabaceae family of flowering plants. They are used primarily as a bittering, flavouring, and stability agent in beer, to which, in addition to bitterness, they impart floral, fruity, or citrus flavours and aromas. Hops are also used for various purposes in other beverages and herbal medicine. The hops plants have separate female and male plants, and only female plants are used for commercial production. The hop plant is a vigorous climbing herbaceous perennial, usually trained to grow up strings in a field called a hopfield, hop garden (in the South of England), or hop yard (in the West Country and United States) when grown commercially. Many different varieties of hops are grown by farmers around the world, with different types used for particular styles of beer."}}, {"canonical_name": "Dutch", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "dutch", "book_id": "english_physician_1652", "name": "Dutch", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Dutch"], "contexts": ["fashion of cooking", "people who eat the herb"]}, {"entity_id": "dutch", "book_id": "origin_of_species_darwin_1859", "name": "Dutch", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Dutch"], "contexts": ["eager about pigeons"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Dutch", "target_book": "origin_of_species_darwin_1859", "target_name": "Dutch", "similarity": 1.0}], "id": 3970, "stable_key": "clu_a99bce3a969653c3", "ground_truth": {"modern_name": "Dutch people", "confidence": "high", "type": "person", "description": "People from the Netherlands.", "wikidata_id": "Q200569", "wikidata_description": "citizens or residents of The Netherlands"}}, {"canonical_name": "Scab", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "scab", "book_id": "english_physician_1652", "name": "Scab", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["Scab"], "contexts": ["skin condition", "skin condition cured by Beech water"]}, {"entity_id": "scab", "book_id": "polyanthea_medicinal", "name": "Scab", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Scab"], "contexts": ["condition treated with goat's milk"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Scab", "target_book": "polyanthea_medicinal", "target_name": "Scab", "similarity": 1.0}], "id": 3971, "stable_key": "clu_fba14b53dda3486d-4", "ground_truth": {"modern_name": "Scabies", "confidence": "high", "type": "disease", "modern_term": "Scabies", "wikidata_id": "Q167178", "wikidata_description": "human disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Scabies", "note": "The early modern term 'itch' encompassed both the symptom of itching and specific conditions like scabies. Given the context of skin conditions and affections, scabies is the most likely specific disease referent.", "wikipedia_extract": "Scabies (, SKAY-beez; also sometimes known as the seven-year itch) is a contagious human skin infestation by the tiny (0.2\u20130.45 mm) mite Sarcoptes scabiei, variety hominis. The word is from Latin: scabere, lit. 'to scratch'. It is a particular public health problem in crowded settings such as care homes, schools, refugee camps, prisons, and hospitals. The most common symptoms are severe itchiness and a pimple-like rash. Occasionally, tiny burrows may appear on the skin from eggs that are about to hatch."}}, {"canonical_name": "malady", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "malady", "book_id": "english_physician_1652", "name": "malady", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["Malady", "malady"], "contexts": ["offending condition", "general term for illness"]}, {"entity_id": "malady", "book_id": "principles_of_psychology_james_1890", "name": "malady", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["malady"], "contexts": ["illness or sickness"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "malady", "target_book": "principles_of_psychology_james_1890", "target_name": "malady", "similarity": 1.0}], "id": 3972, "stable_key": "clu_66e9b8104ca0ed8c-3", "ground_truth": {"modern_name": "Illness", "confidence": "high", "type": "disease", "modern_term": "Illness", "wikidata_id": "Q3052614", "wikidata_description": "specific phobia that involves an irrational fear of contracting a disease", "note": "While 'enfermidade' can also mean sickness or infirmity, in the context of early modern medical texts, it broadly refers to a state of ill health or disease. 'Illness' is a suitable modern equivalent covering this range."}}, {"canonical_name": "fibres", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "fibres", "book_id": "english_physician_1652", "name": "fibres", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["fibres", "Fibres"], "contexts": ["part of Crosswort root", "part of the plant's root"]}, {"entity_id": "vegetable_fibers", "book_id": "kosmos_humboldt_1845", "name": "vegetable fibers", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["vegetable fibers"], "contexts": ["component of coal"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "fibres", "target_book": "kosmos_humboldt_1845", "target_name": "vegetable fibers", "similarity": 0.954}], "id": 3973, "stable_key": "clu_75915e00471d05b0", "ground_truth": {"modern_name": "Plant fibers", "confidence": "high", "type": "plant"}}, {"canonical_name": "Poppy Seed", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "poppy_seed", "book_id": "english_physician_1652", "name": "Poppy Seed", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Poppy Seed"], "contexts": ["seed used for comparison", "added to Melilot preparations"]}, {"entity_id": "poppi", "book_id": "ricettario_fiorentino_1597", "name": "Poppi", "category": "PLANT", "subcategory": "SEED", "count": 1, "variants": ["Poppi"], "contexts": ["ingredient in a recipe"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Poppy Seed", "target_book": "ricettario_fiorentino_1597", "target_name": "Poppi", "similarity": 0.885}], "id": 3974, "stable_key": "clu_a7456c60739c8ccd", "ground_truth": {"wikipedia_extract": "Poppy seed is an oilseed obtained from the poppy plant (Papaver somniferum). The tiny, kidney-shaped seeds have been harvested from dried seed pods by various civilizations for thousands of years. It is still widely used in many countries, especially in Central Europe and South Asia, where it is legally grown, used in food products and sold in shops. The seeds are used whole or ground into meal as an ingredient in many foods \u2013 especially in pastry and bread \u2013 and they are pressed to yield poppyseed oil. The poppy seed is mentioned in ancient medical texts from many civilizations. For instance, the Egyptian Ebers Papyrus, written c. 1550 BCE, lists the poppy seed as a sedative."}}, {"canonical_name": "Dimness of Sight", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "dimness_of_sight", "book_id": "english_physician_1652", "name": "Dimness of Sight", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 3, "variants": ["Dimness of Sight", "dimness of Sight"], "contexts": ["reduced visual acuity", "helped by willow water"]}, {"entity_id": "dimness_of_sight", "book_id": "principles_of_psychology_james_1890", "name": "dimness of sight", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["dimness of sight"], "contexts": ["reduced visual acuity"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Dimness of Sight", "target_book": "principles_of_psychology_james_1890", "target_name": "dimness of sight", "similarity": 0.982}], "id": 3975, "stable_key": "clu_f67bd5f40a13b4e8", "ground_truth": {"modern_name": "Blurred vision", "confidence": "high", "type": "disease", "modern_term": "Blurred vision", "wikidata_id": "Q4930803", "wikidata_description": "symptom, lack of sharpness of vision resulting in the inability to see fine detail"}}, {"canonical_name": "Chicken", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "chicken", "book_id": "english_physician_1652", "name": "Chicken", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Chicken", "Chickens"], "contexts": ["animal used for broth in medicine", "animals treated with herb"]}, {"entity_id": "chickens", "book_id": "polyanthea_medicinal", "name": "chickens", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["chickens"], "contexts": ["animal", "animal substance used in remedies"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Chicken", "target_book": "polyanthea_medicinal", "target_name": "chickens", "similarity": 0.973}], "id": 3976, "stable_key": "clu_d0a78a6a466f8e82-4", "ground_truth": {"modern_name": "Chicken", "confidence": "high", "type": "animal", "note": "The cluster contains 'Hens'/'Hen' clearly referring to chickens, but also 'Heron'/'Herons' referring to the bird family Ardeidae. Given the dominance of 'Hens', the primary referent is likely chicken, with 'heron' being a secondary or potentially misidentified term within the same cluster.", "wikidata_id": "Q780", "wikidata_description": "domesticated bird kept by humans primarily as a food source", "wikipedia_url": "https://en.wikipedia.org/wiki/Chicken", "wikipedia_extract": "The chicken (Gallus gallus domesticus) is a domesticated form of the red junglefowl (Gallus gallus), originally native to Southeast Asia. It was first domesticated around 8,000 years ago and is one of the most common and widespread domesticated animals in the world. Chickens are primarily kept for their meat and eggs, though they are also kept as pets. As of 2023, the global chicken population exceeds 26.5 billion, with more than 50 billion birds produced annually for consumption. Specialized breeds such as broilers and laying hens have been developed for meat and egg production, respectively. A hen bred for laying can produce over 300 eggs per year.", "linnaean": "Gallus gallus domesticus", "family": "Phasianidae", "description": "Common domestic fowl, source of meat and broth."}}, {"canonical_name": "Turnip", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "turnip", "book_id": "english_physician_1652", "name": "Turnip", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Turnip", "Turnep"], "contexts": ["root vegetable", "Turnep Leavs"]}, {"entity_id": "turnip", "book_id": "origin_of_species_darwin_1859", "name": "Turnip", "category": "PLANT", "subcategory": "HERB", "count": 2, "variants": ["turnip", "Turnip"], "contexts": ["domestic variety with thickened stems", "analogous variations"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Turnip", "target_book": "origin_of_species_darwin_1859", "target_name": "Turnip", "similarity": 0.777}], "id": 3977, "stable_key": "clu_f6d85d56e878359a-2", "ground_truth": {"modern_name": "Turnips", "confidence": "high", "type": "plant", "linnaean": "Brassica rapa subsp. rapa", "family": "Brassicaceae", "description": "A root vegetable widely cultivated and used in food and remedies.", "wikipedia_extract": "The turnip or white turnip (Brassica rapa subsp. rapa) is a root vegetable commonly grown in temperate climates worldwide for its white, fleshy taproot. Small, tender varieties are grown for human consumption, while larger varieties are grown as feed for livestock. The name turnip \u2013 used in many regions \u2013 may also be used to refer to rutabaga (or neep or swede), which is a different but related vegetable. The origin of the word turnip is uncertain, though it is hypothesised that it could be a compound of turn as in turned/rounded on a lathe and neep, derived from Latin napus, the word for the plant. According to An Universal Etymological English Dictionary (1721), turn refers to \"round napus to distinguish it from the napi, which were generally long\". The most common type of turnip is mostly white-skinned except for the upper 1 to 6 centimetres (1\u20442 to 2+1\u20442 inches)."}}, {"canonical_name": "Bavaria", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "bavaria", "book_id": "english_physician_1652", "name": "Bavaria", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Bavaria"], "contexts": ["region of Dukes", "Dukes of Bavaria"]}, {"entity_id": "baviera", "book_id": "polyanthea_medicinal", "name": "Baviera", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Baviera"], "contexts": ["region of Duke Frederico I", "region where an author is from"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Bavaria", "target_book": "polyanthea_medicinal", "target_name": "Baviera", "similarity": 0.967}], "id": 3978, "stable_key": "clu_09b65e032aa8df17", "ground_truth": {"modern_name": "Bavaria", "confidence": "high", "type": "place", "country": "Germany", "wikidata_id": "Q154195", "wikidata_description": "kingdom in Central Europe between 1806 and 1918, from January 1871 part of the German Empire"}}, {"canonical_name": "Beets", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "beets", "book_id": "english_physician_1652", "name": "Beets", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Beets"], "contexts": ["vegetable with two main sorts", "plant with similar leaves to Blites"]}, {"entity_id": "beet", "book_id": "origin_of_species_darwin_1859", "name": "beet", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["beet"], "contexts": ["seed that germinated after bird digestion", "plant whose seeds were tested"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Beets", "target_book": "origin_of_species_darwin_1859", "target_name": "beet", "similarity": 0.919}], "id": 3979, "stable_key": "clu_75229e484d3dc603", "ground_truth": {"modern_name": "Beet", "confidence": "high", "type": "plant", "linnaean": "Beta vulgaris Linnaeus", "family": "Amaranthaceae", "wikidata_id": "Q165437", "wikidata_description": "cultivar group of the beet plant (no colour indication)"}}, {"canonical_name": "pains of the Head", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "pains_of_the_head", "book_id": "english_physician_1652", "name": "pains of the Head", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 2, "variants": ["pains of the Head"], "contexts": ["headache", "headache from hot chollerick humors"]}, {"entity_id": "dolor_de_la_cabeza", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "dolor de la cabeza", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["dolor de la cabeza"], "contexts": ["headache"]}, {"entity_id": "dolor_de_la_cabeca", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "dolor de la cabeca", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["dolor de la cabeca"], "contexts": ["headache treated with serpent parts"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "pains of the Head", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "dolor de la cabeza", "similarity": 0.948}, {"source_book": "english_physician_1652", "source_name": "pains of the Head", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "dolor de la cabeca", "similarity": 0.945}], "id": 3980, "stable_key": "clu_4cb14193bd996043-2", "ground_truth": {"modern_name": "Headache", "confidence": "high", "type": "disease", "description": "A common symptom characterized by pain in the head.", "wikipedia_extract": "A headache, also known as cephalalgia, is the symptom of pain in the face, head, or neck. It can occur as a migraine, tension-type headache, or cluster headache. There is an increased risk of depression in those with severe headaches. Headaches can occur as a result of many conditions. There are a number of different classification systems for headaches. The most well-recognized is that of the International Headache Society, which classifies it into more than 150 types of primary and secondary headaches.", "modern_term": "Headache", "note": "The terms refer to the symptom of pain in the head, commonly known as headache.", "wikidata_id": "Q67841409", "wikidata_description": "various conditions with the symptom of headache"}}, {"canonical_name": "Bristol", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "bristol", "book_id": "english_physician_1652", "name": "Bristol", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Bristol"], "contexts": ["port city where plant is found", "place where the plant grows"]}, {"entity_id": "bristol", "book_id": "kosmos_humboldt_1845", "name": "Bristol", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Bristol"], "contexts": ["location of fossil discoveries"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Bristol", "target_book": "kosmos_humboldt_1845", "target_name": "Bristol", "similarity": 1.0}], "id": 3981, "stable_key": "clu_c79cd679709b1400", "ground_truth": {"modern_name": "Bristol", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q23154", "wikidata_description": "city in South West England, United Kingdom", "wikipedia_url": "https://en.wikipedia.org/wiki/Bristol", "wikipedia_extract": "Bristol ( ) is a city and ceremonial county in South West England. It is located on the River Avon, and bordered by Gloucestershire to the north and Somerset to the south with a short coastline on the Bristol Channel to the west. The county includes the majority of the Bristol conurbation, however, the urban area of the city extends into the neighbouring districts of South Gloucestershire, Bath and North East Somerset, and North Somerset. The county is almost entirely urbanised and had an estimated population of 494,399 in 2024, making Bristol the most populous city in the region. For local government purposes the county is a unitary authority area governed by Bristol City Council. The council is a member of the West of England Combined Authority, which allows it to collaborate with South Gloucestershire Council and Bath and North East Somerset Council."}}, {"canonical_name": "coltello", "category": "OBJECT", "subcategory": "TOOL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "scalpel", "book_id": "relation_historique_humboldt_vol3_1825", "name": "scalpel", "category": "OBJECT", "subcategory": "TOOL", "count": 1, "variants": ["scalpel"], "contexts": ["surgical knife"]}, {"entity_id": "coltello", "book_id": "ricettario_fiorentino_1597", "name": "coltello", "category": "OBJECT", "subcategory": "TOOL", "count": 3, "variants": ["coltello"], "contexts": ["knife used for scraping roots", "knife for removing membranes"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "scalpel", "target_book": "ricettario_fiorentino_1597", "target_name": "coltello", "similarity": 0.935}], "id": 3982, "stable_key": "clu_57dffb3506dd4150", "ground_truth": {"modern_name": "Scalpel", "confidence": "high", "type": "object", "note": "Both 'coltello' (Italian for knife) and 'scalpel' refer to a surgical knife or a knife used for cutting and scraping."}}, {"canonical_name": "Buthler", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "butler", "book_id": "english_physician_1652", "name": "Butler", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Butler"], "contexts": ["author of a manuscript"]}, {"entity_id": "buthler", "book_id": "polyanthea_medicinal", "name": "Buthler", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Buthler"], "contexts": ["artificial stone remedy", "cited in relation to a remedy"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Butler", "target_book": "polyanthea_medicinal", "target_name": "Buthler", "similarity": 0.844}], "id": 3983, "stable_key": "clu_61ebe183d62a04b9", "ground_truth": {"modern_name": "Butler", "confidence": "medium", "type": "person", "description": "Author of medicinal texts, likely a physician or apothecary.", "note": "The exact identity of 'Buthler' or 'Butler' is unclear without further context. Assuming it refers to a specific author named Butler known for medical writings."}}, {"canonical_name": "lesion", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "contussion", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "contussion", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["contussion"], "contexts": ["bruise or injury"]}, {"entity_id": "lesion", "book_id": "principles_of_psychology_james_1890", "name": "lesion", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["lesion"], "contexts": ["damage to tissue"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "contussion", "target_book": "principles_of_psychology_james_1890", "target_name": "lesion", "similarity": 0.924}], "id": 3984, "stable_key": "clu_d571bb6e6379de73", "ground_truth": {"modern_name": "lesion", "confidence": "high", "type": "disease", "modern_term": "lesion", "note": "The term 'contussion' is a specific type of lesion.", "wikidata_id": "Q102186750", "wikidata_description": "symptom"}}, {"canonical_name": "Alembic", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "alembic", "book_id": "english_physician_1652", "name": "Alembic", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["Alembic"], "contexts": ["distillation apparatus"]}, {"entity_id": "alembic", "book_id": "ricettario_fiorentino_1597", "name": "Alembic", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 3, "variants": ["Alembic", "alembic"], "contexts": ["instrument for distillation", "implied in distillation"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Alembic", "target_book": "ricettario_fiorentino_1597", "target_name": "Alembic", "similarity": 1.0}], "id": 3985, "stable_key": "clu_1acf142c10587a48-2", "ground_truth": {"modern_name": "Alambic", "confidence": "high", "type": "object", "description": "A type of distillation apparatus used for separating liquids.", "wikipedia_extract": "An alembic (from Arabic: \u0627\u0644\u0625\u0646\u0628\u064a\u0642, romanized: al-inb\u012bq, originating from Ancient Greek: \u1f04\u03bc\u03b2\u03b9\u03be, romanized: ambix, 'cup, beaker') is an alchemical still consisting of two vessels connected by a tube, used for distillation of liquids. The complete distilling apparatus consists of three parts: the \"cucurbit\" (Arabic: \u1e33ar\u02bfa; Greek: \u03b2\u1fd6\u03ba\u03bf\u03c2, b\u00eekos), the still pot containing the liquid to be distilled, which is heated by a flame the \"head\" or \"cap\" (\u0625\u0650\u0646\u0652\u0628\u0650\u064a\u0642\u200e, \u02beinb\u012bq; Greek \u1f04\u03bc\u03b2\u03b9\u03be, ambix) which fits over the mouth of the cucurbit to receive the vapors, with an attached downward-sloping \"tube\" (\u03c3\u03c9\u03bb\u03ae\u03bd, s\u014dl\u0113n) the \"receiver\" (\u0642\u064e\u0627\u0628\u0650\u0644\u064e\u0629, q\u0101bila; \u1f04\u03b3\u03b3\u03bf\u03c2, angos or \u03c6\u03b9\u03ac\u03bb\u03b7, phial\u0113) container In the case of another distilling vessel, the retort, the \"cap\" and the \"cucurbit\" have been combined to form a single vessel. The anbik is also called the ra\u02bes (the Arabic word ra\u02bes means \"head\") of the cucurbit. The liquid in the cucurbit is heated or boiled; the vapour rises into the anbik, where it cools by contact with the walls and condenses, running down the spout into the receiver. A modern descendant of the alembic is the pot still, used to produce distilled beverages. Dioscorides's ambix, described in his De materia medica (c. 50 C.E.), is a helmet-shaped lid for gathering condensed mercury."}}, {"canonical_name": "corrup\u00e7ao", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "corruption", "book_id": "english_physician_1652", "name": "Corruption", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Corruption"], "contexts": ["much Rhewm and Corruption"]}, {"entity_id": "corrup\u00e7ao", "book_id": "polyanthea_medicinal", "name": "corrup\u00e7ao", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["corrup\u00e7ao"], "contexts": ["free from corruption", "corruption"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Corruption", "target_book": "polyanthea_medicinal", "target_name": "corrup\u00e7ao", "similarity": 0.971}], "id": 3986, "stable_key": "clu_533fa5688473a316", "ground_truth": {"modern_name": "Corruption", "confidence": "medium", "type": "disease", "modern_term": "Infection or putrefaction", "note": "The term 'corrup\u00e7ao'/'Corruption' in early modern texts often referred to a general sense of decay, putrefaction, or infection within the body, rather than a specific disease."}}, {"canonical_name": "materias", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "matter", "book_id": "english_physician_1652", "name": "matter", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["matter"], "contexts": ["discharge from the ears"]}, {"entity_id": "materias", "book_id": "polyanthea_medicinal", "name": "materias", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["materias", "materia \u017fero\u017fa"], "contexts": ["bodily discharge", "matters, to be drained"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "matter", "target_book": "polyanthea_medicinal", "target_name": "materias", "similarity": 0.952}], "id": 3987, "stable_key": "clu_346188b84b5c6fd4", "ground_truth": {"modern_name": "Bodily Discharge", "confidence": "high", "type": "concept", "note": "The term 'materias'/'matter' in this context refers to bodily fluids or substances expelled from the body.", "wikipedia_extract": "Heroic medicine can either refer to heroic therapy or to heroic drugs. Heroic therapy, also referred to as heroic depletion theory, was a therapeutic method advocating for rigorous treatment of bloodletting, purging, and sweating to shock the body back to health after an illness caused by a humoral imbalance. Rising to the front of orthodox medical practice in North America in the \"Age of Heroic Medicine\" (1780\u20131850), it fell out of favor in the mid-19th century as gentler treatments were shown to be more effective and the idea of palliative treatment began to develop. Heroic drugs, also called in English potent medicaments, was also a term used in Europe from the 18th to the 20th century to refer to certain potent pharmaceutical drugs. Pockets of medical methodology that can be classified as \"heroic\" appear in the early 17th century with Parisian physician Guy Patin and French anatomist Jean Riolan the Younger. Patin, nicknamed \"Le Grand Saigneur\" (the Grand Bloodletter), was infamous for his rigorous procedure plans, which included intensive courses of bloodletting and application of senna.", "wikipedia_url": "https://en.wikipedia.org/wiki/Heroic_medicine"}}, {"canonical_name": "chymicamente", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "chimi\u2223cally", "book_id": "english_physician_1652", "name": "Chimi\u2223cally", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["Chimi\u2223cally"], "contexts": ["method of drawing spirit from herb"]}, {"entity_id": "chymicamente", "book_id": "polyanthea_medicinal", "name": "chymicamente", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Chymicamente", "chymicamente"], "contexts": ["method of preparing tin", "chemical preparation method"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Chimi\u2223cally", "target_book": "polyanthea_medicinal", "target_name": "chymicamente", "similarity": 0.897}], "id": 3988, "stable_key": "clu_79be077d6be38fdc-2", "ground_truth": {"modern_name": "alchemy", "confidence": "high", "type": "concept", "description": "Ancient practice involving chemical transformation and medicine.", "note": "Also encompasses the chemical art and practice.", "wikipedia_extract": "Alchemy (from the Arabic word al-k\u012bm\u012b\u0101, \u0627\u0644\u0643\u06cc\u0645\u06cc\u0627\u0621) is an ancient branch of natural philosophy, a philosophical and protoscientific tradition that was historically practised in China, India, the Muslim world, and Europe. In its Western form, alchemy is first attested in a number of pseudepigraphical texts written in Greco-Roman Egypt during the first few centuries AD. Greek-speaking alchemists often referred to their craft as \"the Art\" (\u03c4\u03ad\u03c7\u03bd\u03b7) or \"Knowledge\" (\u1f10\u03c0\u03b9\u03c3\u03c4\u03ae\u03bc\u03b7), and it was often characterised as mystic (\u03bc\u03c5\u03c3\u03c4\u03b9\u03ba\u03ae), sacred (\u1f31\u025b\u03c1\u03ac), or divine (\u03b8\u025b\u00ed\u03b1). Alchemists attempted to purify, mature, and perfect certain materials. Common aims were chrysopoeia, the transmutation of \"base metals\" (e.g., lead) into \"noble metals\" (particularly gold); the creation of an elixir of immortality; and the creation of panaceas able to cure any disease. The perfection of the human body and soul was thought to result from the alchemical magnum opus (\"Great Work\")."}}, {"canonical_name": "Sandaracha", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "sandarack", "book_id": "english_physician_1652", "name": "Sandarack", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Sandarack"], "contexts": ["substance mixed with birdlime for nails"]}, {"entity_id": "sandaracha", "book_id": "ricettario_fiorentino_1597", "name": "Sandaracha", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["Sandaracha", "SANDARACHA"], "contexts": ["mineral found in metal mines", "name of the mineral"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Sandarack", "target_book": "ricettario_fiorentino_1597", "target_name": "Sandaracha", "similarity": 0.896}], "id": 3989, "stable_key": "clu_ecb26343e8f280a5", "ground_truth": {"modern_name": "Sandarac", "confidence": "high", "type": "mineral", "note": "Sandaracha refers to Sandarac, a resinous substance derived from juniper trees, often used in historical contexts for various purposes including in medicine and as a varnish."}}, {"canonical_name": "Canaries", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "canaries", "book_id": "english_physician_1652", "name": "Canaries", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Canaries"], "contexts": ["location for obtaining medicine"]}, {"entity_id": "canaries", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Canaries", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Canaries"], "contexts": ["islands off the coast of Africa", "islands with plants belonging to African coast"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Canaries", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Canaries", "similarity": 1.0}], "id": 3990, "stable_key": "clu_b569efb86286465f-2", "ground_truth": {"modern_name": "Canary Islands", "confidence": "high", "type": "place", "country": "Spain", "note": "Direct translation of the German name for the archipelago.", "wikidata_id": "Q5813", "wikidata_description": "autonomous community of Spain, and archipelago in the Atlantic Ocean", "wikipedia_url": "https://en.wikipedia.org/wiki/Canary%20Islands", "wikipedia_extract": "The Canary Islands ( ; Spanish: Canarias [ka\u02c8na\u027ejas] ) or Canaries are an archipelago in the Atlantic Ocean and the southernmost autonomous community of Spain, located about 100 kilometres (60 mi) off the northwest coast of Africa. The archipelago has a population of approximately 2.27 million inhabitants, making it the most populous overseas special territory of the European Union. The seven main islands, listed from largest to smallest by area, are Tenerife, Fuerteventura, Gran Canaria, Lanzarote, La Palma, La Gomera, and El Hierro. The only other inhabited island is La Graciosa, which is administratively dependent on Lanzarote. The archipelago also includes numerous smaller islands and islets, such as Alegranza, Isla de Lobos, Monta\u00f1a Clara, Roque del Oeste, and Roque del Este, as well as various rocks, including Garachico and Anaga. Historically, the island chain was referred to as \"the Fortunate Isles\"."}}, {"canonical_name": "heartsease", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "heartsease", "book_id": "english_physician_1652", "name": "Heartsease", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Heartsease"], "contexts": ["herb with properties like violets"]}, {"entity_id": "heartsease", "book_id": "origin_of_species_darwin_1859", "name": "heartsease", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["heartsease"], "contexts": ["plant with distinct flowers and leaves", "plant variety showing improvement"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Heartsease", "target_book": "origin_of_species_darwin_1859", "target_name": "heartsease", "similarity": 0.98}], "id": 3991, "stable_key": "clu_5dd101c1ffab6fc7", "ground_truth": {"wikipedia_extract": "Viola tricolor is a common European wild flower, growing as an annual or short-lived perennial. The species is also known as wild pansy, Johnny Jump up (though this name is also applied to similar species such as the yellow pansy), heartsease, heart's ease, heart's delight, tickle-my-fancy, Jack-jump-up-and-kiss-me, come-and-cuddle-me, three faces in a hood, love-in-idleness, and pink of my john. It has been introduced into North America, where it has spread. It is the progenitor of the cultivated pansy, and is therefore sometimes called wild pansy; before the cultivated pansies were developed, \"pansy\" was an alternative name for the wild form. It can produce up to 50 seeds at a time. The flowers can be purple, blue, yellow or white."}}, {"canonical_name": "lamp", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "lamp", "book_id": "english_physician_1652", "name": "Lamp", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Lamp"], "contexts": ["device for light"]}, {"entity_id": "lamp", "book_id": "connexion_physical_sciences_somerville_1858", "name": "lamp", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["lamp"], "contexts": ["used to raise the temperature of surfaces", "source of heat"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Lamp", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "lamp", "similarity": 0.993}], "id": 3992, "stable_key": "clu_23872f66b456acde-2", "ground_truth": {"modern_name": "lamp", "confidence": "medium", "type": "object", "note": "The term 'candil' can refer to a candle or a lamp. Given the context of 'heating' and 'unit of weight', 'lamp' is a more encompassing modern referent. However, 'tallow-candle' suggests a more specific interpretation related to candles.", "wikidata_id": "Q2110", "wikidata_description": "province of Indonesia, on the island of Sumatra"}}, {"canonical_name": "groups", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "groups", "book_id": "origin_of_species_darwin_1859", "name": "groups", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["groups"], "contexts": ["collections of similar entities", "whole groups would tend slowly to disappear"]}, {"entity_id": "groups", "book_id": "principles_of_psychology_james_1890", "name": "groups", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["groups"], "contexts": ["collections of people whose opinions matter"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "groups", "target_book": "principles_of_psychology_james_1890", "target_name": "groups", "similarity": 1.0}], "id": 3993, "stable_key": "clu_b04842855661b834", "ground_truth": {"modern_name": "group", "confidence": "high", "type": "concept"}}, {"canonical_name": "fur", "category": "ANIMAL", "subcategory": "PRODUCT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "fur", "book_id": "origin_of_species_darwin_1859", "name": "fur", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 3, "variants": ["fur"], "contexts": ["thickness influenced by climate", "hair covering of mammals"]}, {"entity_id": "fur", "book_id": "first_principles_spencer_1862", "name": "fur", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 1, "variants": ["fur"], "contexts": ["thick hair covering of mammals"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "fur", "target_book": "first_principles_spencer_1862", "target_name": "fur", "similarity": 1.0}], "id": 3994, "stable_key": "clu_2029fc047ef77057", "ground_truth": {"modern_name": "fur", "confidence": "high", "type": "animal", "note": "Referring to the hair covering of mammals, not a separate animal.", "wikidata_id": "Q197204", "wikidata_description": "thick growth of hair that covers the skin of many different animals, particularly mammals", "wikipedia_url": "https://en.wikipedia.org/wiki/Fur"}}, {"canonical_name": "domestic breeds", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "domestic_breeds", "book_id": "origin_of_species_darwin_1859", "name": "domestic breeds", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["domestic breeds"], "contexts": ["animals selectively bred by humans", "distinct varieties of domesticated animals"]}, {"entity_id": "ra\u00e7as_domesticas", "book_id": "coloquios_da_orta_1563", "name": "ra\u00e7as domesticas", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["ra\u00e7as domesticas"], "contexts": ["domestic animal breeds, source of bezoars"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "domestic breeds", "target_book": "coloquios_da_orta_1563", "target_name": "ra\u00e7as domesticas", "similarity": 0.953}], "id": 3995, "stable_key": "clu_607c5b9b707bc92f", "ground_truth": {"modern_name": "Domesticated animals", "confidence": "high", "type": "animal", "note": "Refers to animal species that have been selectively bred by humans for specific traits. 'Domestic breeds' in Darwin's context and 'ra\u00e7as domesticas' in a Portuguese text both point to this concept. The mention of 'source of bezoars' is a specific historical use of certain domestic animal products.", "wikidata_id": "Q622852", "wikidata_description": "animal that has been biologically changed by human intervention", "wikipedia_url": "https://en.wikipedia.org/wiki/Domesticated%20animal"}}, {"canonical_name": "bull-dog", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "bull-dog", "book_id": "origin_of_species_darwin_1859", "name": "bull-dog", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 3, "variants": ["bull-dog"], "contexts": ["domesticated dog breed", "breed of dog"]}, {"entity_id": "pug-dog", "book_id": "principles_of_psychology_james_1890", "name": "pug-dog", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["pug-dog"], "contexts": ["dog feared by children"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "bull-dog", "target_book": "principles_of_psychology_james_1890", "target_name": "pug-dog", "similarity": 0.927}], "id": 3996, "stable_key": "clu_bf5dfaca77d88e03", "ground_truth": {"modern_name": "Bulldog", "confidence": "high", "type": "animal", "note": "The text mentions both 'bull-dog' and 'pug-dog', but 'bull-dog' is more prevalent and clearly refers to the breed.", "wikidata_id": "Q1999293", "wikidata_description": "1927 fighter aircraft family by Bristol"}}, {"canonical_name": "skulls", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "skulls", "book_id": "origin_of_species_darwin_1859", "name": "skulls", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["skulls"], "contexts": ["part of pigeon anatomy", "bony framework of the head"]}, {"entity_id": "skulls", "book_id": "kosmos_humboldt_1845", "name": "skulls", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["skulls"], "contexts": ["part of bird skeletons"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "skulls", "target_book": "kosmos_humboldt_1845", "target_name": "skulls", "similarity": 1.0}], "id": 3997, "stable_key": "clu_74248dcfe2ba8492-2", "ground_truth": {"modern_name": "skull", "confidence": "high", "type": "object", "wikidata_id": "", "wikidata_description": "family name", "note": "The term 'skulls' in a medical/scientific context refers to the bony framework of the head. 'Part of pigeon anatomy' and 'part of bird skeletons' reinforce this."}}, {"canonical_name": "Plumage", "category": "ANIMAL", "subcategory": "PRODUCT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "plumage", "book_id": "origin_of_species_darwin_1859", "name": "Plumage", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 3, "variants": ["plumage", "Plumage"], "contexts": ["bird's feathers collectively", "feathers of birds"]}, {"entity_id": "plumage", "book_id": "first_principles_spencer_1862", "name": "plumage", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 1, "variants": ["plumage"], "contexts": ["feathers of a bird"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Plumage", "target_book": "first_principles_spencer_1862", "target_name": "plumage", "similarity": 0.935}], "id": 3998, "stable_key": "clu_8c9a2894d451a848", "ground_truth": {"modern_name": "Feathers", "confidence": "high", "type": "animal", "note": "Both 'Plumage' in English and 'plumage' in Spencer's work refer to the collective feathers of a bird, a common topic in natural history and descriptive texts.", "wikidata_id": "Q50998618", "wikidata_description": "animal material consisting of the keratinous plumage of birds"}}, {"canonical_name": "fanciers", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "fanciers", "book_id": "origin_of_species_darwin_1859", "name": "fanciers", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["fanciers"], "contexts": ["enthusiasts of animal breeds", "breeders of domestic animals"]}, {"entity_id": "fanciulla", "book_id": "ricettario_fiorentino_1597", "name": "fanciulla", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["fanciulla"], "contexts": ["maiden, source of milk for preparation"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "fanciers", "target_book": "ricettario_fiorentino_1597", "target_name": "fanciulla", "similarity": 0.866}], "id": 3999, "stable_key": "clu_648488087053727d", "ground_truth": {"modern_name": "Enthusiast", "confidence": "medium", "type": "person", "description": "Someone with a strong interest in a particular subject, especially animal breeds.", "note": "The term 'fanciers' clearly refers to enthusiasts of animal breeds. 'Fanciulla' is Italian for maiden and seems out of context with the other mentions, suggesting a potential OCR error or multiple disparate uses of a similar-sounding word. However, the primary context is 'fanciers' of breeds."}}, {"canonical_name": "birds of prey", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "birds_of_prey", "book_id": "origin_of_species_darwin_1859", "name": "birds of prey", "category": "ANIMAL", "subcategory": "BIRD", "count": 3, "variants": ["birds of prey"], "contexts": ["predatory bird species", "birds whose stomachs retained seeds"]}, {"entity_id": "bird_of_prey", "book_id": "principles_of_psychology_james_1890", "name": "bird of prey", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["bird of prey"], "contexts": ["predatory bird"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "birds of prey", "target_book": "principles_of_psychology_james_1890", "target_name": "bird of prey", "similarity": 0.958}], "id": 4000, "stable_key": "clu_f3d156d100263307", "ground_truth": {"modern_name": "Bird of prey", "confidence": "high", "type": "animal", "note": "This refers to any bird that hunts and feeds on other animals.", "wikidata_id": "Q48428", "wikidata_description": "any species of bird that primarily hunts and feeds on relatively large vertebrates"}}, {"canonical_name": "New World", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "new_world", "book_id": "origin_of_species_darwin_1859", "name": "New World", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["New World"], "contexts": ["traditional term for Americas", "geographic region for comparison"]}, {"entity_id": "new_world", "book_id": "connexion_physical_sciences_somerville_1858", "name": "New World", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["New World"], "contexts": ["hemisphere containing Americas"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "New World", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "New World", "similarity": 1.0}], "id": 4001, "stable_key": "clu_681342a31cb797c0-3", "ground_truth": {"modern_name": "The Americas", "confidence": "high", "type": "place", "note": "The term 'Nouveau-Continent' and 'New Continent' clearly refer to the Americas in the context of exploration and geography.", "wikidata_id": "Q25398978", "wikidata_description": "genus of fishes"}}, {"canonical_name": "swim-bladder", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "swim-bladder", "book_id": "origin_of_species_darwin_1859", "name": "swim-bladder", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["swim-bladder"], "contexts": ["organ in fish for buoyancy", "organ in fish"]}, {"entity_id": "swimming_bladders", "book_id": "kosmos_humboldt_1845", "name": "swimming bladders", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["swimming bladders"], "contexts": ["buoyancy organs in fish"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "swim-bladder", "target_book": "kosmos_humboldt_1845", "target_name": "swimming bladders", "similarity": 0.916}], "id": 4002, "stable_key": "clu_6935164821822075", "ground_truth": {"modern_name": "swim bladder", "confidence": "high", "type": "animal", "wikidata_id": "Q22298342", "wikidata_description": "The process in which the anatomical structure of the swim bladder is generated and organized. The swim bladder is used by some fishes to maintain buoyancy and may function in addition as a sound producing organ, a sound receptor, and a respiratory or"}}, {"canonical_name": "mental qualities", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "mental_qualities", "book_id": "origin_of_species_darwin_1859", "name": "mental qualities", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["mental qualities"], "contexts": ["diversities of animal cognitive traits", "characteristics of the mind"]}, {"entity_id": "mental_faculties", "book_id": "principles_of_psychology_james_1890", "name": "mental faculties", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mental faculties"], "contexts": ["cognitive abilities of the mind"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "mental qualities", "target_book": "principles_of_psychology_james_1890", "target_name": "mental faculties", "similarity": 0.911}], "id": 4003, "stable_key": "clu_b93ab2022232e785-3", "ground_truth": {"modern_name": "Mental Faculties", "confidence": "high", "type": "concept", "note": "Refers to the innate powers or capacities of the mind, a significant concept in psychology and philosophy of mind."}}, {"canonical_name": "natural instincts", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "natural_instincts", "book_id": "origin_of_species_darwin_1859", "name": "natural instincts", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["natural instincts", "Natural instincts"], "contexts": ["innate behaviors in wild animals", "innate behavioral patterns"]}, {"entity_id": "pure_instincts", "book_id": "principles_of_psychology_james_1890", "name": "pure instincts", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["pure instincts"], "contexts": ["innate, unlearned behavioral drives"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "natural instincts", "target_book": "principles_of_psychology_james_1890", "target_name": "pure instincts", "similarity": 0.893}], "id": 4004, "stable_key": "clu_a76d4c90e69b981a-4", "ground_truth": {"modern_name": "Instinct", "confidence": "high", "type": "concept", "wikidata_id": "Q18237", "wikidata_description": "inherent inclination of a living organism"}}, {"canonical_name": "Thuret", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "thuret", "book_id": "origin_of_species_darwin_1859", "name": "Thuret", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Thuret"], "contexts": ["observed fact with sea-weeds", "experiments on Fuci"]}, {"entity_id": "thuret", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Thuret", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Thuret"], "contexts": ["consul general of the King of the Netherlands"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Thuret", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Thuret", "similarity": 0.691}], "id": 4005, "stable_key": "clu_9a45cec1942b0215", "ground_truth": {"modern_name": "Gustave Thuret", "confidence": "high", "type": "person", "birth_year": 1817, "death_year": 1875, "description": "French botanist specializing in algae, corresponded with Darwin."}}, {"canonical_name": "Fuci", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "fuci", "book_id": "origin_of_species_darwin_1859", "name": "Fuci", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Fuci"], "contexts": ["sea-weeds observed in cross-breeding", "seaweed genus studied in experiments"]}, {"entity_id": "fuci", "book_id": "kosmos_humboldt_1845", "name": "Fuci", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Fuci"], "contexts": ["fossil plant species"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Fuci", "target_book": "kosmos_humboldt_1845", "target_name": "Fuci", "similarity": 1.0}], "id": 4006, "stable_key": "clu_9ba07951e940a728", "ground_truth": {"modern_name": "Seaweeds", "confidence": "high", "type": "plant", "note": "Early modern texts often used 'fuci' to refer broadly to seaweeds, particularly those of the Fucus genus, but also more generally."}}, {"canonical_name": "organic remains", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "organic_remains", "book_id": "origin_of_species_darwin_1859", "name": "organic remains", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["organic remains"], "contexts": ["remains of living organisms", "fossils of living organisms"]}, {"entity_id": "organic_remains", "book_id": "first_principles_spencer_1862", "name": "organic remains", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["organic remains"], "contexts": ["fossilized remains of organisms"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "organic remains", "target_book": "first_principles_spencer_1862", "target_name": "organic remains", "similarity": 1.0}], "id": 4007, "stable_key": "clu_6d57eeaee7e50379", "ground_truth": {"modern_name": "Organic remains", "confidence": "high", "type": "concept"}}, {"canonical_name": "area", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "area", "book_id": "origin_of_species_darwin_1859", "name": "area", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["area"], "contexts": ["geographic region", "geographic location"]}, {"entity_id": "zone", "book_id": "kosmos_humboldt_1845", "name": "zone", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["zone"], "contexts": ["geographic belt or area"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "area", "target_book": "kosmos_humboldt_1845", "target_name": "zone", "similarity": 0.907}], "id": 4008, "stable_key": "clu_5119bda0ad7d1c6c", "ground_truth": {"modern_name": "Geographical region", "confidence": "high", "type": "place", "note": "The terms 'area' and 'zone' in the given contexts, particularly with Darwin and Humboldt, refer to distinct geographical or ecological regions, not abstract areas.", "wikidata_id": "Q1071", "wikidata_description": "science that studies the terrestrial surface, the societies that inhabit it and the territories, landscapes, places or regions that form it when interacting with each other", "wikipedia_url": "https://en.wikipedia.org/wiki/Geography"}}, {"canonical_name": "fossiliferous", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "fossiliferous", "book_id": "origin_of_species_darwin_1859", "name": "fossiliferous", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["fossiliferous"], "contexts": ["containing fossils", "containing fossils, describing rocks"]}, {"entity_id": "fossilized", "book_id": "first_principles_spencer_1862", "name": "fossilized", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fossilized"], "contexts": ["preserved in rock form"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "fossiliferous", "target_book": "first_principles_spencer_1862", "target_name": "fossilized", "similarity": 0.901}], "id": 4009, "stable_key": "clu_4ada3d9eec557555", "ground_truth": {"modern_name": "Fossiliferous", "confidence": "high", "type": "concept", "wikidata_id": "Q99656226", "wikidata_description": "scholarly article by I. G. Speden published in 1962"}}, {"canonical_name": "flowering plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "flowering_plants", "book_id": "origin_of_species_darwin_1859", "name": "flowering plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["flowering plants"], "contexts": ["plants that produce flowers", "plants on oceanic islands"]}, {"entity_id": "flowering_plants", "book_id": "kosmos_humboldt_1845", "name": "flowering plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["flowering plants"], "contexts": ["plants that produce flowers"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "flowering plants", "target_book": "kosmos_humboldt_1845", "target_name": "flowering plants", "similarity": 1.0}], "id": 4010, "stable_key": "clu_46cab0ba19b7c00b", "ground_truth": {"modern_name": "Flowering plants", "confidence": "high", "type": "plant", "linnaean": "Angiospermae", "family": "Angiospermae", "note": "This refers to the botanical group Angiospermae.", "wikidata_id": "Q25314", "wikidata_description": "clade of seed plants that produce flowers"}}, {"canonical_name": "Manatee", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "manatee", "book_id": "origin_of_species_darwin_1859", "name": "Manatee", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 3, "variants": ["manatee", "Manatee"], "contexts": ["aquatic marine mammal", "animal with rudimentary nails on fin"]}, {"entity_id": "manat\u00ed", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "Manat\u00ed", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Manat\u00ed"], "contexts": ["marine mammal"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Manatee", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "Manat\u00ed", "similarity": 0.921}], "id": 4011, "stable_key": "clu_6719d6bf709a75ac", "ground_truth": {"modern_name": "Manatee", "confidence": "high", "type": "animal", "note": "Direct translation of 'Manatee' and 'Manat\u00ed' across English and Spanish texts clearly refers to the aquatic mammal.", "wikidata_id": "Q40261", "wikidata_description": "species of mammal", "wikipedia_url": "https://en.wikipedia.org/wiki/West%20Indian%20manatee"}}, {"canonical_name": "entomologists", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "entomologists", "book_id": "origin_of_species_darwin_1859", "name": "entomologists", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 2, "variants": ["entomologists"], "contexts": ["experts in insect classification", "scientists who study insects"]}, {"entity_id": "entomologist", "book_id": "principles_of_psychology_james_1890", "name": "entomologist", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 2, "variants": ["entomologist"], "contexts": ["one who studies insects", "scientist studying insects"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "entomologists", "target_book": "principles_of_psychology_james_1890", "target_name": "entomologist", "similarity": 0.943}], "id": 4012, "stable_key": "clu_0874db1fa3d21be4", "ground_truth": {"wikipedia_extract": "Entomology, from Ancient Greek \u1f14\u03bd\u03c4\u03bf\u03bc\u03bf\u03bd (\u00e9ntomon), meaning \"insect\", and \u03bb\u03cc\u03b3\u03bf\u03c2 (l\u00f3gos), meaning \"study\", is the branch of zoology that focuses on insects. Those who study entomology are known as entomologists. In the past, the term insect was less specific, and historically the definition of entomology would also include the study of animals in other arthropod groups, such as arachnids, myriapods, and crustaceans. The field is also referred to as insectology in American English, while in British English insectology implies the study of the relationships between insects and humans. Over 1.3 million insect species have been described by entomology. Entomology is rooted in nearly all human cultures from prehistoric times, primarily in the context of agriculture (especially biological control and beekeeping)."}}, {"canonical_name": "Alligators", "category": "ANIMAL", "subcategory": "REPTILE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "alligators", "book_id": "origin_of_species_darwin_1859", "name": "Alligators", "category": "ANIMAL", "subcategory": "REPTILE", "count": 2, "variants": ["alligators", "Alligators"], "contexts": ["example of male fighting behavior", "large semi-aquatic reptiles"]}, {"entity_id": "alligators", "book_id": "relation_historique_humboldt_vol3_1825", "name": "alligators", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["alligators", "alligator"], "contexts": ["alligators similar to those of Florida", "also called cayman"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Alligators", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "alligators", "similarity": 0.936}], "id": 4013, "stable_key": "clu_ae6eab4c4f8c8de2", "ground_truth": {"modern_name": "alligators", "confidence": "high", "type": "animal", "family": "Alligatoridae", "description": "Large, semi-aquatic reptiles with blunt snouts and smooth legs.", "wikipedia_extract": "An alligator, or colloquially gator, is a large reptile in the genus Alligator of the family Alligatoridae in the order Crocodilia. The two extant species are the American alligator (A. mississippiensis) and the Chinese alligator (A. sinensis). Additionally, several extinct species of alligator are known from fossil remains. Alligators first appeared during the late Eocene epoch about 37 million years ago. The term \"alligator\" is likely an anglicized form of el lagarto, Spanish for \"the lizard\", which early Spanish explorers and settlers in Florida called the alligator. Early English spellings of the name included allagarta and alagarto."}}, {"canonical_name": "Schi\u00f6dte", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "schi\u00f6dte", "book_id": "origin_of_species_darwin_1859", "name": "Schi\u00f6dte", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Schi\u00f6dte"], "contexts": ["naturalist who studied cave insects", "researcher on blind insects"]}, {"entity_id": "schleiden", "book_id": "kosmos_humboldt_1845", "name": "Schleiden", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Schleiden"], "contexts": ["scholar regarding mucilaginous deposits", "author on plant cell development"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Schi\u00f6dte", "target_book": "kosmos_humboldt_1845", "target_name": "Schleiden", "similarity": 0.86}], "id": 4014, "stable_key": "clu_720a6befb0a14adc", "ground_truth": {"modern_name": "Hermann Burmeister", "confidence": "high", "type": "person", "birth_year": 1807, "death_year": 1892, "description": "German entomologist and zoologist, studied cave insects.", "note": "Schi\u00f6dte is likely a typo or misattribution within the text for Hermann Burmeister, who is known for his work on insects, including those from caves. Schleiden refers to Matthias Schleiden, a botanist, but the context 'mucilaginous deposits' fits Burmeister's broader zoological work more closely, or potentially a different scholar entirely. Given the strong association with 'cave insects' for Schi\u00f6dte and the presence of Burmeister in similar scientific circles, he is the most probable referent.", "wikidata_id": "Q100703296", "wikidata_description": "street in Halle (Saale), Saxony-Anhalt, Germany"}}, {"canonical_name": "Mozart", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "mozart", "book_id": "origin_of_species_darwin_1859", "name": "Mozart", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Mozart"], "contexts": ["musician who played pianoforte at three years old", "musical powers of"]}, {"entity_id": "mozart", "book_id": "principles_of_psychology_james_1890", "name": "Mozart", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Mozart"], "contexts": ["example of departed spirit", "composer describing his creative process"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Mozart", "target_book": "principles_of_psychology_james_1890", "target_name": "Mozart", "similarity": 0.806}], "id": 4015, "stable_key": "clu_f01de8ba92152cf0", "ground_truth": {"modern_name": "Wolfgang Amadeus Mozart", "confidence": "high", "type": "person", "birth_year": 1756, "death_year": 1791, "description": "Austrian composer, child prodigy.", "wikidata_id": "Q254", "wikidata_description": "Austrian composer of the Classical period (1756\u20131791)"}}, {"canonical_name": "Sir R. Murchison", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "sir_r__murchison", "book_id": "origin_of_species_darwin_1859", "name": "Sir R. Murchison", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Sir R. Murchison"], "contexts": ["author of work on Russia", "eminent geologist"]}, {"entity_id": "sir_roderick_murchison", "book_id": "kosmos_humboldt_1845", "name": "Sir Roderick Murchison", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Sir Roderick Murchison"], "contexts": ["observer on the bounds of Asia"]}, {"entity_id": "murchison,_sir_r_", "book_id": "kosmos_humboldt_1845", "name": "Murchison, Sir R.", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Murchison, Sir R."], "contexts": ["described melaphyre ejection and strata"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Sir R. Murchison", "target_book": "kosmos_humboldt_1845", "target_name": "Sir Roderick Murchison", "similarity": 0.939}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Sir R. Murchison", "target_book": "kosmos_humboldt_1845", "target_name": "Murchison, Sir R.", "similarity": 0.955}], "id": 4016, "stable_key": "clu_d81fc403b9155676-2", "ground_truth": {"modern_name": "Roderick Impey Murchison", "confidence": "high", "type": "person", "birth_year": 1792, "death_year": 1871, "description": "British geologist, known for work on Silurian system.", "wikidata_id": "Q361900", "wikidata_description": "British geologist (1792-1871)", "wikipedia_url": "https://en.wikipedia.org/wiki/Roderick%20Murchison", "wikipedia_extract": "Sir Roderick Impey Murchison, 1st Baronet (19 February 1792 \u2013 22 October 1871) was a Scottish geologist who served as director-general of the British Geological Survey from 1855 until his death in 1871. He is noted for investigating and describing the Silurian, Devonian and Permian systems. Murchison was born at Tarradale House, Muir of Ord, Ross-shire, the son of Barbara and Kenneth Murchison. His wealthy father died in 1796, when Roderick was four years old, and he was sent to Durham School three years later and then to the Royal Military College, Great Marlow, to be trained for the army. In 1808, under Wellesley, he landed in Portugal, and was present at the actions of Roli\u00e7a and Vimeiro in the Peninsular War as an ensign in the 36th Regt of Foot. Subsequently, under Sir John Moore, he took part in the retreat to Corunna and the final battle there."}}, {"canonical_name": "Philippi", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "philippi", "book_id": "origin_of_species_darwin_1859", "name": "Philippi", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Philippi"], "contexts": ["observations of marine inhabitants in Sicily", "scientist discussing tertiary species"]}, {"entity_id": "philippi", "book_id": "kosmos_humboldt_1845", "name": "Philippi", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Philippi"], "contexts": ["published geography of AEtna plants", "author of geography of plants"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Philippi", "target_book": "kosmos_humboldt_1845", "target_name": "Philippi", "similarity": 1.0}], "id": 4017, "stable_key": "clu_c76e03d34b41476c", "ground_truth": {"modern_name": "Rudolf Albert von Koelliker", "confidence": "medium", "type": "person", "birth_year": 1817, "death_year": 1905, "description": "Swiss anatomist and biologist, pioneering cell theory and histology", "note": "The name 'Philippi' appears in contexts mentioning Darwin and Humboldt. While there was a botanist named Philippi who studied plants in South America, the specific texts cited (Darwin's *Origin of Species* and Humboldt's *Kosmos*) do not prominently feature him. Rudolf Albert von Koelliker, a prominent Swiss anatomist and biologist whose work on cells and tissues was influential, is a more likely referent given the broad scientific context, though the direct link to 'Philippi' is tenuous. Further investigation of these specific editions might clarify."}}, {"canonical_name": "metamorphic schists", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "metamorphic_schists", "book_id": "origin_of_species_darwin_1859", "name": "metamorphic schists", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["metamorphic schists"], "contexts": ["transformed rock type", "rock type forming mountain-summits"]}, {"entity_id": "metamorphic_rocks", "book_id": "kosmos_humboldt_1845", "name": "Metamorphic Rocks", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["metamorphic rocks", "Metamorphic Rocks"], "contexts": ["rocks transformed by heat/pressure", "type of rock"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "metamorphic schists", "target_book": "kosmos_humboldt_1845", "target_name": "Metamorphic Rocks", "similarity": 0.898}], "id": 4018, "stable_key": "clu_9958b501c1f3c02f", "ground_truth": {"modern_name": "Metamorphic rocks", "confidence": "high", "type": "mineral"}}, {"canonical_name": "Alpine plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "alpine_plants", "book_id": "origin_of_species_darwin_1859", "name": "Alpine plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Alpine plants"], "contexts": ["plants found in South America", "plants from alpine regions"]}, {"entity_id": "alpine_flora", "book_id": "kosmos_humboldt_1845", "name": "Alpine flora", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Alpine flora"], "contexts": ["plant life of high mountains"]}, {"entity_id": "alpine_floras", "book_id": "kosmos_humboldt_1845", "name": "Alpine floras", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Alpine floras"], "contexts": ["flora found in high mountain regions"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Alpine plants", "target_book": "kosmos_humboldt_1845", "target_name": "Alpine flora", "similarity": 0.947}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Alpine plants", "target_book": "kosmos_humboldt_1845", "target_name": "Alpine floras", "similarity": 0.948}], "id": 4019, "stable_key": "clu_705a740023b75ef4", "ground_truth": {"modern_name": "Alpine flora", "confidence": "high", "type": "plant", "wikidata_id": "Q2582662", "wikidata_description": "plants that grow at high elevation"}}, {"canonical_name": "cuttle-fish", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 4, "membe