ariants": ["moths"], "contexts": ["pollinate orchidaceous plants"]}, {"entity_id": "hormigas", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "hormigas", "category": "ANIMAL", "subcategory": "INSECT", "count": 3, "variants": ["hormigas"], "contexts": ["dung of ants used in remedy", "insects producing harmful bites"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Moths", "target_book": "origin_of_species_darwin_1859", "target_name": "moths", "similarity": 0.959}, {"source_book": "origin_of_species_darwin_1859", "source_name": "moths", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "hormigas", "similarity": 0.893}], "id": 1720, "stable_key": "clu_3f8ffcdad96208c7", "ground_truth": {"modern_name": "Beetles", "confidence": "high", "type": "animal", "note": "The cluster includes 'moths' but the primary term and most references point to 'beetles'. Beetles are insects with elytra. Moths are also insects but are typically winged and lack hardened forewings (elytra). The contexts also align more with beetles (e.g., 'soldered elytra').", "wikidata_id": "Q22671", "wikidata_description": "order of insects whose wings serve as a protective shell"}}, {"canonical_name": "attraction mutuelle", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "attraction_mutuelle", "book_id": "epoques_nature_buffon_1778", "name": "attraction mutuelle", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["attraction mutuelle"], "contexts": ["mutual pull between matter", "mutual pull between objects"]}, {"entity_id": "mutual_attraction", "book_id": "kosmos_humboldt_1845", "name": "mutual attraction", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["mutual attraction"], "contexts": ["force between celestial bodies"]}, {"entity_id": "mutual_attraction", "book_id": "first_principles_spencer_1862", "name": "mu