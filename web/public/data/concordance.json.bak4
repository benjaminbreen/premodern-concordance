rom water", "adheres to bird feet, contains seeds"]}, {"entity_id": "argillaceous_mud", "book_id": "kosmos_humboldt_1845", "name": "argillaceous mud", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["argillaceous mud"], "contexts": ["flows from mud volcano basins"]}, {"entity_id": "mud", "book_id": "kosmos_humboldt_1845", "name": "mud", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["mud"], "contexts": ["wet earth"]}, {"entity_id": "mud", "book_id": "first_principles_spencer_1862", "name": "mud", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["mud"], "contexts": ["fine particles of earth and water", "sediment in still water"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "mud", "target_book": "kosmos_humboldt_1845", "target_name": "argillaceous mud", "similarity": 0.896}, {"source_book": "origin_of_species_darwin_1859", "source_name": "mud", "target_book": "kosmos_humboldt_1845", "target_name": "mud", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "mud", "target_book": "first_principles_spencer_1862", "target_name": "mud", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "argillaceous mud", "target_book": "first_principles_spencer_1862", "target_name": "mud", "similarity": 0.896}, {"source_book": "kosmos_humboldt_1845", "source_name": "mud", "target_book": "first_principles_spencer_1862", "target_name": "mud", "similarity": 1.0}], "id": 1620, "stable_key": "clu_95f635ba115c29e4", "ground_truth": {"modern_name": "Mud", "confidence": "high", "type": "concept", "wikidata_id": "Q967446", "wikidata_description": "town and district of Bolu Province, Turkey", "wikipedia_url": "https://en.wikipedia.org/wiki/Mudurnu", "wikipedia_extract": "Mudurnu is a small town in Bolu Province in the Black Sea region of Turkey, 52 km south-west of the city of Bolu. It is the seat of Mudurnu District. Its population is 5,379 (2021). The mayor is Necdet T\u00fcrker (MHP), elected in 2019. The town has a long history and the name Mudurnu comes from the Byzantine princess Modrene (\u039c\u03c9\u03b4\u03c1\u03b7\u03bd\u03ae in Byzantine Greek), and the ruins of the Byzantine castle can still be seen above the town. In the 8th century AD, the forces of the Byzantine usurper Artabasdos, commanded by his son Niketas, were defeated at or near this location by the army of the legitimate emperor Constantine V, before being defeated again at Chrysopolis, the same location where Constantine the Great defeated his Eastern rival Licinius."}}, {"canonical_name": "partes interiores", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "internal_parts", "book_id": "origin_of_species_darwin_1859", "name": "internal parts", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["internal parts"], "contexts": ["body structures not externally visible"]}, {"entity_id": "partes_interiores", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "partes interiores", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["partes interiores"], "contexts": ["internal body parts"]}, {"entity_id": "miembros_interiores", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "miembros interiores", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["miembros interiores"], "contexts": ["internal limbs"]}, {"entity_id": "partes_interiores", "book_id": "polyanthea_medicinal", "name": "partes interiores", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["partes interiores"], "contexts": ["internal body parts", "inner parts of the body"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "internal parts", "target_book": "quatro_libros_naturaleza_hernandez_1615", "target_name": "partes interio