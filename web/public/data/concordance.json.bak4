H", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tiburones", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "TIBURONES", "category": "ANIMAL", "subcategory": "FISH", "count": 2, "variants": ["tiburones", "TIBURONES"], "contexts": ["fish that hunt in groups", "type of shark"]}, {"entity_id": "tiburones", "book_id": "relation_historique_humboldt_vol3_1825", "name": "tiburones", "category": "ANIMAL", "subcategory": "FISH", "count": 1, "variants": ["tiburones"], "contexts": ["Spanish word for sharks"]}], "edges": [{"source_book": "quatro_libros_naturaleza_hernandez_1615", "source_name": "TIBURONES", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "tiburones", "similarity": 0.923}], "id": 4628, "stable_key": "clu_b91dbcaddfc56818", "ground_truth": {"wikipedia_extract": "\"Tiburones\" (transl.\u2009\"Sharks\") is a song recorded by Puerto Rican singer Ricky Martin for his first extended play, Pausa (2020). The song was written by Oscar Hernandez and Pablo Preciado, while the production was handled by Julio Reyes Copello. The song was released for digital download and streaming by Sony Music Latin on January 23, 2020, as the second single from the extended play. A Spanish language ballad and Latin pop song, it is about the importance of peace, love and unity. It received positive reviews from music critics, who complimented its lyrics. \"Tiburones\" was nominated for Song of the Year at the 21st Annual Latin Grammy Awards. The song was commercially successful in Latin America, reaching number one in Argentina and Puerto Rico, as well as the top 10 in eight other Latin American countries."}}, {"canonical_name": "cuero", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "cuero", "book_id": "quatro_libros_naturaleza_hernandez_1615", "name": "cuero", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["cuero"], "con