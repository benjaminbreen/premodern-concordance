, "target_cluster_name": "Central America", "source_book": "llm_generated", "evidence_snippet": "Central America shares a border with the Caribbean Sea and is culturally and geographically linked to the Caribbean region.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Central America shares a border with the Caribbean Sea and is culturally and geographically linked to the Caribbean region.", "is_reverse": true}, {"found_name": "Trinidad", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1511, "target_cluster_name": "Trinidad", "source_book": "llm_generated", "evidence_snippet": "Trinidad is the southernmost island in the Caribbean and lies within the Caribbean region.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Trinidad is the southernmost island in the Caribbean and lies within the Caribbean region.", "is_reverse": true}, {"found_name": "Honduras", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2113, "target_cluster_name": "Honduras", "source_book": "llm_generated", "evidence_snippet": "Honduras is bordered to the north by the Gulf of Honduras, a large inlet of the Caribbean Sea. The Caribbean region is geographically proximate and historically interconnected with Honduras.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Honduras is bordered to the north by the Gulf of Honduras, a large inlet of the Caribbean Sea. The Caribbean region is geographically proximate and historically interconnected with Honduras.", "is_reverse": true}, {"found_name": "Antilles", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1487, "target_cluster_name": "Antilles", "source_book": "llm_generated", "evidence_snippet": "The Antilles are a major island group within the historical Caribbean region.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Antilles are a major