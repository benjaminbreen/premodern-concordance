rce for fossil animals, plants, and microorganisms", "wikipedia_url": "https://en.wikipedia.org/wiki/Fossilworks", "wikipedia_extract": "Fossilworks was a portal which provides query, download, and analysis tools to facilitate access to the Paleobiology Database, a large relational database assembled by hundreds of paleontologists from around the world. Fossilworks was created in 1998 by John Alroy and housed at Macquarie University. It included many analysis and data visualization tools formerly included in the Paleobiology Database. Fossilworks was shut down around 2022 and now links to the Paleobiology Database."}, "cross_references": [{"found_name": "botany", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1098, "target_cluster_name": "botany", "source_book": "llm_generated", "evidence_snippet": "Paleobotany, a branch of botany, studies fossilized plants.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Paleobotany, a branch of botany, studies fossilized plants.", "is_reverse": true}, {"found_name": "discoveries", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 505, "target_cluster_name": "discoveries", "source_book": "llm_generated", "evidence_snippet": "Fossils can lead to discoveries about past life.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Fossils can lead to discoveries about past life.", "is_reverse": true}, {"found_name": "Extinct species", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3360, "target_cluster_name": "extinct species", "source_book": "llm_generated", "evidence_snippet": "Fossils are the preserved remains or traces of extinct species.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Fossils are the preserved remains or traces of extinct species."}, {"found_name": "Palaeontology", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1