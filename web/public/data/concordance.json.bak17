total_mentions": 2, "members": [{"entity_id": "catalanes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "catalanes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["catalanes"], "contexts": ["people from Catalonia"]}, {"entity_id": "catalan", "book_id": "historia_medicinal_monardes_1574", "name": "Catalan", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Catalan"], "contexts": ["origin of a physician"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "catalanes", "target_book": "historia_medicinal_monardes_1574", "target_name": "Catalan", "similarity": 0.905}], "id": 4104, "stable_key": "clu_b20e484019766235", "ground_truth": {"modern_name": "Catalonia", "confidence": "high", "type": "place", "country": "Spain", "wikidata_id": "Q90400112", "wikidata_description": "Administrative entity of the Kingdom of Spain created to replace the Principality of Catalonia after the Nueva Planta decrees and which lost its civil powers with the reforms of 1835, maintaining the military until its dissolution in 1931"}, "cross_references": []}, {"canonical_name": "piezas", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "piezas", "book_id": "relation_historique_humboldt_vol3_1825", "name": "piezas", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["piezas"], "contexts": ["unit of equipment"]}, {"entity_id": "peças", "book_id": "coloquios_da_orta_1563", "name": "peças", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["peças"], "contexts": ["chess pieces"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "piezas", "target_book": "coloquios_da_orta_1563", "target_name": "peças", "similarity": 0.971}], "id": 4105, "stable_key": "clu_d8cc2aa1af1ee37c", "ground_truth": {"modern_name": "pieces", "confidence": "high", "type": "object", "note": "The context of 'chess pieces' is specific, but 'pieces' is a general term that can refer to various units or parts of equipment in a scientific context.", "wikidata_id": "Q18593264", "wikidata_description": "defines an item, such as an object or document, that is a member of a collection or part of a repository"}, "cross_references": [{"found_name": "sucre terré", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "relation_historique_humboldt_vol3_1825", "evidence_snippet": "Saint-Domingue , sous les auspices de Don Nicolas Calvo), 3 clarificadoras , 3 peilas et 2 tratJies de tachos (chaque train a 3 piezas), en tout \\i fondas. On dit vulgairement que 3 arrobas de sucre t", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of sugar"}]}, {"canonical_name": "mine", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "mine", "book_id": "relation_historique_humboldt_vol3_1825", "name": "mine", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["mine"], "contexts": ["place for extracting minerals"]}, {"entity_id": "mine", "book_id": "connexion_physical_sciences_somerville_1858", "name": "mine", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["mine"], "contexts": ["excavation for extracting minerals"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "mine", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "mine", "similarity": 1.0}], "id": 4106, "stable_key": "clu_12f87ca4d30ff1c0", "ground_truth": {"modern_name": "mine", "confidence": "high", "type": "place", "country": "global"}, "cross_references": []}, {"canonical_name": "grammes", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "grammes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "grammes", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["grammes"], "contexts": ["unit of mass"]}, {"entity_id": "grams", "book_id": "principles_of_psychology_james_1890", "name": "grams", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["grams"], "contexts": ["unit of mass used in experiments"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "grammes", "target_book": "principles_of_psychology_james_1890", "target_name": "grams", "similarity": 0.898}], "id": 4107, "stable_key": "clu_bd7ec5be32db5437", "ground_truth": {"wikipedia_extract": "The gram (originally gramme; SI unit symbol g) is a unit of mass in the International System of Units (SI) equal to one thousandth of a kilogram. Originally defined in 1795 as \"the absolute weight of a volume of pure water equal to the cube of the hundredth part of a metre [1 cm3], and at the temperature of melting ice\", the defining temperature (0 °C) was later changed to the temperature of maximum density of water (approximately 4 °C). Subsequent redefinitions agree with this original definition to within 30 parts per million (0.003%), with the maximum density of water remaining very close to 1 g/cm3, as shown by modern measurements. By the late 19th century, there was an effort to make the base unit the kilogram and the gram a derived unit. In 1960, the new International System of Units defined a gram as one thousandth of a kilogram (i.e., one gram is 1×10−3 kg). The kilogram, as of 2019, is defined by the International Bureau of Weights and Measures from the metre, the second, and from the fixed numerical value of the Planck constant (h)."}, "cross_references": []}, {"canonical_name": "procédés chimiques", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "procédés_chimiques", "book_id": "relation_historique_humboldt_vol3_1825", "name": "procédés chimiques", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["procédés chimiques"], "contexts": ["chemical processes"]}, {"entity_id": "chemical_processes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "chemical processes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["chemical processes"], "contexts": ["energy generation on the sun's surface"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "procédés chimiques", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "chemical processes", "similarity": 0.894}], "id": 4108, "stable_key": "clu_159dc61f51ca1074", "ground_truth": {"modern_name": "chemical processes", "confidence": "high", "type": "concept"}, "cross_references": []}, {"canonical_name": "substances alcalines", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "substances_alcalines", "book_id": "relation_historique_humboldt_vol3_1825", "name": "substances alcalines", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["substances alcalines"], "contexts": ["alkaline substances"]}, {"entity_id": "alkaline", "book_id": "principles_of_psychology_james_1890", "name": "alkaline", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["alkaline"], "contexts": ["type of phosphate discussed"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "substances alcalines", "target_book": "principles_of_psychology_james_1890", "target_name": "alkaline", "similarity": 0.921}], "id": 4109, "stable_key": "clu_58560106eca9a584", "ground_truth": {"modern_name": "Alkaline substances", "confidence": "high", "type": "chemical"}, "cross_references": [{"found_name": "venenos", "link_type": "conceptual_overlap", "link