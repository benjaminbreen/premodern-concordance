": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 166, "target_cluster_name": "generation", "source_book": "llm_generated", "evidence_snippet": "Descent refers to the process of passing traits from one generation to the next, making 'generation' a closely related concept.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Descent refers to the process of passing traits from one generation to the next, making 'generation' a closely related concept."}, {"found_name": "Heredity", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1233, "target_cluster_name": "innate", "source_book": "llm_generated", "evidence_snippet": "Descent is the mechanism by which hereditary traits are passed from parents to offspring.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Descent is the mechanism by which hereditary traits are passed from parents to offspring."}, {"found_name": "parent-species", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2723, "target_cluster_name": "parent-species", "source_book": "llm_generated", "evidence_snippet": "Ancestor species directly relates to the concept of descent, as it is the progenitor from which descendants arise.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Ancestor species directly relates to the concept of descent, as it is the progenitor from which descendants arise.", "is_reverse": true}]}, {"canonical_name": "Tierra del Fuego", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "tierra_del_fuego", "book_id": "origin_of_species_darwin_1859", "name": "Tierra del Fuego", "category": "PLACE", "subcategory": "REGION", "count": 11, "variants": ["Tierra del Fuego"], "contexts": ["location of indigenous peoples with dogs", "geographic location with savages"]}, {"entity_id": "tierra_del_fuego", "book_id": "kosmos_humboldt_1845", "name": "Tierra del Fuego", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Tierra del Fuego"], "contexts": ["archipelago in southern hemisphere"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Tierra del Fuego", "target_book": "kosmos_humboldt_1845", "target_name": "Tierra del Fuego", "similarity": 0.811}], "id": 1974, "stable_key": "clu_97f6c0e130c560b2", "ground_truth": {"modern_name": "Tierra del Fuego", "confidence": "high", "type": "place", "description": "Archipelago at the southern tip of South America.", "wikipedia_extract": "Tierra del Fuego (; Spanish: [ˈtjera ðel ˈfweɣo]; Spanish for 'Land of Fire') is an archipelago off the southernmost tip of the South American mainland, across the Strait of Magellan. The archipelago consists of the main island, Isla Grande de Tierra del Fuego, with an area of 73,746 km2 (28,473 sq mi), along with numerous smaller islands, including Cape Horn and Diego Ramírez Islands. The western part of the Tierra del Fuego archipelago, about two-thirds including its many islands, is part of Chile, and the eastern part is part of Argentina. The southernmost extent of the archipelago, Cape Horn, lies just north of 56° south. The earliest-known human settlement in Tierra del Fuego dates to c. 8,000 BC. Europeans first explored the islands during Ferdinand Magellan's expedition of 1520."}, "cross_references": []}, {"canonical_name": "Struggle for Life", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "struggle_for_life", "book_id": "origin_of_species_darwin_1859", "name": "Struggle for Life", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 11, "variants": ["Struggle for Life", "struggle for life"], "contexts": ["competition for survival", "competition for survival and reproduction"]}, {"entity_id": "struggle_for_life", "book_id": "principles_of_psychology_james_1890", "name": "struggle for lif