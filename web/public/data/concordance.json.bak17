ter_id": 3159, "target_cluster_name": "interference of light", "source_book": "llm_generated", "evidence_snippet": "Interference of light is a phenomenon that, along with diffraction and polarization, is a key characteristic behavior of light waves, and understanding these phenomena often involves related concepts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Interference of light is a phenomenon that, along with diffraction and polarization, is a key characteristic behavior of light waves, and understanding these phenomena often involves related concepts."}, {"found_name": "polarization", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2264, "target_cluster_name": "polarization", "source_book": "llm_generated", "evidence_snippet": "Circular polarization is a specific type of polarization, indicating a direct and hierarchical relationship within the concept of polarization.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Circular polarization is a specific type of polarization, indicating a direct and hierarchical relationship within the concept of polarization.", "is_reverse": true}, {"found_name": "polarization of light", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2854, "target_cluster_name": "polarization of light", "source_book": "llm_generated", "evidence_snippet": "Circular polarization is a specific type of polarization of light, directly related to the broader concept.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Circular polarization is a specific type of polarization of light, directly related to the broader concept.", "is_reverse": true}]}, {"canonical_name": "ellipsoid of revolution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "ellipsoid_of_revolution", "book_id": "kosmos_humboldt_1845", "name": "ellipsoid of revolution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["ellipsoid of revolution"], "contexts": ["shape of a rotated ellipse"]}, {"entity_id": "elliptical_spheriod_of_revolution", "book_id": "kosmos_humboldt_1845", "name": "elliptical spheriod of revolution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["elliptical spheriod of revolution"], "contexts": ["mathematical shape of the Earth"]}, {"entity_id": "ellipsoid_of_revolution", "book_id": "connexion_physical_sciences_somerville_1858", "name": "ellipsoid of revolution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 11, "variants": ["Ellipsoid of Revolution", "ellipsoid of revolution"], "contexts": ["spheroid formed by rotating an ellipse", "geometric shape of Earth"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "ellipsoid of revolution", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "ellipsoid of revolution", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "elliptical spheriod of revolution", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "ellipsoid of revolution", "similarity": 0.899}], "id": 1953, "stable_key": "clu_e469b110349810a4", "ground_truth": {"modern_name": "Ellipsoid of revolution", "confidence": "high", "type": "concept", "wikidata_id": "Q208395", "wikidata_description": "volume formed by rotating an ellipse around one of its axes; special case of ellipsoid"}, "cross_references": [{"found_name": "ellipse", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1812, "target_cluster_name": "ellipse", "source_book": "llm_generated", "evidence_snippet": "An ellipsoid of revolution is a three-dimensional shape generated by rotating an ellipse around one of its axes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: An ellipsoid of revolution is a three-dimensional shape generated by rotating an ellipse around one of its axes.", "is_reverse": true}, {"found_name": "volume", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2219, "target_cluster_name": "volume", "source_book": "llm_generated", "evidence_snippet": "An ellipsoid of revolution is a three-dimensional shape whose volume can be calculated using its dimensions, and is a specific geometric form.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: An ellipsoid of revolution is a three-dimensional shape whose volume can be calculated using its dimensions, and is a specific geometric form.", "is_reverse": true}, {"found_name": "ellipticity", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2847, "target_cluster_name": "ellipticity", "source_book": "llm_generated", "evidence_snippet": "An ellipsoid of revolution is a 3D shape that can be generated by rotating an ellipse around one of its axes. Ellipticity is a measure of how much a shape deviates from being a perfect circle or sphere, and an ellipsoid of revolution is a specific geometric form that exhibits ellipticity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: An ellipsoid of revolution is a 3D shape that can be generated by rotating an ellipse around one of its axes. Ellipticity is a measure of how much a shape deviates from being a perfect circle or sphere, and an ellipsoid of revolution is a specific geometric form that exhibits ellipticity.", "is_reverse": true}]}, {"canonical_name": "Aden", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "aden", "book_id": "kosmos_humboldt_1845", "name": "Aden", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Aden"], "contexts": ["location for monsoon naming"]}, {"entity_id": "aden", "book_id": "coloquios_da_orta_1563", "name": "Aden", "category": "PLACE", "subcategory": "CITY", "count": 12, "variants": ["Aden"], "contexts": ["port of call", "origin of goods to Diu"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Aden", "target_book": "coloquios_da_orta_1563", "target_name": "Aden", "similarity": 1.0}], "id": 1954, "stable_key": "clu_50e50dc7b3394572", "ground_truth": {"modern_name": "Aden", "confidence": "high", "type": "place", "country": "Yemen", "wikidata_id": "Q131694", "wikidata_description": "port city and temporary capital of Yemen", "wikipedia_url": "https://en.wikipedia.org/wiki/Aden_Colony", "wikipedia_extract": "Aden Colony (Arabic: مُسْتْعَمَرَةْ عَدَنْ, romanized: Musta'marat 'Adan) was a crown colony of the United Kingdom from 1937 to 1963 located in the southern part of modern-day Yemen. It consisted of the port city of Aden and also included the outlying islands of Kamaran, Perim and the Khuria Muria archipelago with a total area of 192 km2 (74 sq mi). Initially a key port for the British East India Company, it was annexed by the British in 1839 to secure maritime routes and prevent piracy in the Arabian Sea. Its strategic position at the entrance to the Red Sea made it a vital stopover for ships traveling between Europe, India, and the Far East, especially after the opening of the Suez Canal in 1869. Aden quickly became a major coaling station and transit hub for British shipping, and its significance to the British Empire grew throughout the 19th and early 20th centuries. Prior to 1937, Aden had been governed as part of British India (originally as the Aden Settlement subordinate to the Bombay Presidency, and then as a Chief Commissioner's province)."}, "cross_references": [{"found_name": "Mer Rouge", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 370, "target_cluster_name": "Mer Rouge", "source_book": "llm_generated", "evidence_snippet": "Aden is a port city located at the entrance of the Red Sea, making it geographically significant to the Red Sea's maritime traffic and historical context.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Aden is a port city located at the entrance of the Red Sea, making it geographically significant to the Red Sea's maritime traffic and historical context.", "is_reverse": true}, {"found_name": "Arabia", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 169, "target_cluster_name": "Arabia", "source_book": "llm_generated", "evidence_snippet": "Aden is a port city located in modern-day Yemen, which is part of the Arabian Peninsula.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Aden is a port city located in modern-day Yemen, which is part of the Arabian Peninsula."}, {"found_name": "East Indies", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 497, "target_cluster_name": "East Indies", "source_book": "llm_generated", "evidence_snippet": "Aden was a significant port on the trade routes between Europe and the East Indies.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Aden was a significant port on the trade routes between Europe and the East Indies."}]}, {"canonical_name": "ventosidades", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "ventosidades", "book_id": "historia_medicinal_monardes_1574", "name": "ventosidades", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 12, "variants": ["ventosidades", "ventofedad", "ventofedades", "ventoledades", "ventos", "ventosidad", "ventoſedades"], "contexts": ["condition resolved by preparation", "intestinal gas"]}, {"entity_id": "ventosidades", "book_id": "coloquios_da_orta_1563", "name": "ventosidades", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["ventosidades"], "contexts": ["condition resolved by galamga"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "ventosidades", "target_book": "coloquios_da_orta_1563", "target_name": "ventosidades", "similarity": 1.0}], "id": 1955, "stable_key": "clu_79892e6f67f603a1", "ground_truth": {"modern_name": "Flatulence", "confidence": "high", "type": "disease", "description": "Accumulation of gas in the digestive tract; intestinal wind.", "note": "Includes terms for intestinal gas, windiness, and flatulence.", "wikipedia_extract": "Flatulence is the expulsion of gas from the intestines via the anus, commonly referred to as farting. \"Flatus\" is the medical word for gas generated in the stomach or bowels. A proportion of intestinal gas may be swallowed environmental air; hence, flatus is not entirely generated in the stomach or bowels. The scientific study of this area of medicine is termed flatology. Passing gas is a normal bodily process. Flatus is brought to the rectum and pressurized by muscles in the intestines. It is normal to pass flatus (\"to fart\"), though volume and frequency vary greatly among individuals."}, "cross_references": []}, {"canonical_name": "gota coral", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 3, "total_mentions": 29, "members": [{"entity_id": "gota_coral", "book_id": "historia_medicinal_monardes_1574", "name": "gota coral", "category": "DISEASE", "subcategory": "CHRONIC", "count": 12, "variants": ["gota coral", "Gota Coral", "Gota corak", "Gota coral", "gota"], "contexts": ["gout, a disease", "strong and almost incurable disease"]}, {"entity_id": "gota_coral", "book_id": "coloquios_da_orta_1563", "name": "gota coral", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["gota coral"], "contexts": ["gout, treated with coconut"]}, {"entity_id": "podagra", "book_id": "coloquios_da_orta_1563", "name": "podagra", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["podagra"], "contexts": ["gout of the foot"]}, {"entity_id": "podagra", "book_id": "polyanthea_medicinal", "name": "podagra", "category": "DISEASE", "subcategory": "CHRONIC", "count": 12, "variants": ["podagra", "Podagra", "podagre", "podagricos", "podagris"], "contexts": ["gout in the foot", "medical condition, likely gout"]}, {"entity_id": "artetica", "book_id": "coloquios_da_orta_1563", "name": "artetica", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["artetica"], "contexts": ["gout"]}, {"entity_id": "artetica", "book_id": "polyanthea_medicinal", "name": "Artetica", "category": "DISEASE", "subcategory": "CHRONIC", "count": 2, "variants": ["Artetica", "artetica"], "contexts": ["herb added to artificial baths", "disease affecting all joints"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "gota coral", "target_book": "coloquios_da_orta_1563", "target_name": "gota coral", "similarity": 1.0}], "id": 1956, "stable_key": "clu_4c4650fe92ff30dc", "ground_truth": {"modern_name": "Gout", "confidence": "high", "type": "disease", "modern_term": "Gout", "wikidata_id": "Q133087", "wikidata_description": "medical condition that results in recurrent pain and swelling of joints", "wikipedia_url": "https://en.wikipedia.org/wiki/Gout", "wikipedia_extract": "Gout ( GOWT) is a form of inflammatory arthritis characterized by recurrent attacks of pain in a red, tender, hot, and swollen joint, caused by the deposition of needle-shaped crystals of the monosodium salt of uric acid. Pain typically comes on rapidly, reaching maximal intensity in less than 12 hours. In about half of cases, the joint at the base of the big toe is affected (Podagra). It may also result in tophi, kidney stones, or kidney damage. Gout is due to persistently elevated levels of uric acid (urate) in the blood (hyperuricemia). This occurs from a combination of diet, other health problems, and genetic factors.", "note": "The term 'gota coral' appears to be an early modern descriptor for gout, possibly with specific regional or contextual nuances, as suggested by the mention of 'coconut' in the context of treatment. However, the core disease is gout."}, "member_count": 6, "cross_references": [{"found_name": "gora", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 234, "target_cluster_name": "Gout", "source_book": "historia_medicinal_monardes_1574", "evidence_snippet": "Las enfer todo genero de mal de Buuas, todas llagas viejas, medades uFccrds,desháterofódone anribuos, quicalos do Tf lores delas juncturas,que llaman gota artherica, y agua dela aró qualquier gengso d", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of gout"}, {"found_name": "sciati ca", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1501, "target_cluster_name": "Ciatica", "source_book": "historia_medicinal_monardes_1574", "evidence_snippet": "Las enfer todo genero de mal de Buuas, todas llagas viejas, medades uFccrds,desháterofódone anribuos, quicalos do Tf lores delas juncturas,que llaman gota artherica, y agua dela aró qualquier gengso d", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "specific type of gout"}, {"found_name": "GotaCoral", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "historia_medicinal_monardes_1574", "evidence_snippet": "ciadefte.dizequefe toma finguarda,mas que mié. . — trastomaren el agua,o peluos, tengan buena or»: - -. den y regimiento en el comer y en todo lo de mas.. En gota. Enmorbum.caducum,que llaman GotaCora", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "also known as Enmorbum caducum"}, {"found_name": "Enmorbum caducum", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "historia_medicinal_monardes_1574", "evidence_snippet": "ciadefte.dizequefe toma finguarda,mas que mié. . — trastomaren el agua,o peluos, tengan buena or»: - -. den y regimiento en el com