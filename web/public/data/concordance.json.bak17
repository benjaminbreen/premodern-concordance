iment"]}, {"entity_id": "scientific", "book_id": "first_principles_spencer_1862", "name": "scientific", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["scientific"], "contexts": ["relating to scientific knowledge and belief"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "scientific", "target_book": "first_principles_spencer_1862", "target_name": "scientific", "similarity": 1.0}], "id": 4246, "stable_key": "clu_a6e709f400648d55", "ground_truth": {"modern_name": "Scientific", "confidence": "high", "type": "concept"}, "cross_references": [{"found_name": "spiritualism", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "principles_of_psychology_james_1890", "evidence_snippet": "body, whether it shall have one after the latter's decease, are questions to be decided by my general philosophy or theology rather than by what we call 'scientific facts'--I leave out the facts of so", "confidence": 0.65, "auto_label": "contested_identity", "found_relationship": "example of disputed facts"}]}, {"canonical_name": "telescopic field of view", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "telescopic_field_of_view", "book_id": "principles_of_psychology_james_1890", "name": "telescopic field of view", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["telescopic field of view"], "contexts": ["visual area in telescope"]}, {"entity_id": "telescopic_field_of_view", "book_id": "kosmos_humboldt_1845", "name": "telescopic field of view", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["telescopic field of view"], "contexts": ["area seen through a telescope"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "telescopic field of view", "target_book": "kosmos_humboldt_1845", "target_name": "t