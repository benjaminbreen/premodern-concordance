d Vil"], "contexts": ["king addressed by Columbus", "King to whom wax was presented"]}, {"entity_id": "ferdinand_the_catholic", "book_id": "kosmos_humboldt_1845", "name": "Ferdinand the Catholic", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Ferdinand the Catholic"], "contexts": ["ruler and employer of Anghiera"]}, {"entity_id": "ferdinando", "book_id": "polyanthea_medicinal", "name": "Ferdinando", "category": "PERSON", "subcategory": "PATRON", "count": 2, "variants": ["Ferdinando"], "contexts": ["patient of Epifanio", "Emperor's physician"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Ferdinand the Emperor", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Ferdinand", "similarity": 0.94}, {"source_book": "english_physician_1652", "source_name": "Ferdinand the Emperor", "target_book": "kosmos_humboldt_1845", "target_name": "Ferdinand the Catholic", "similarity": 0.867}, {"source_book": "english_physician_1652", "source_name": "Ferdinand the Emperor", "target_book": "polyanthea_medicinal", "target_name": "Ferdinando", "similarity": 0.916}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Ferdinand", "target_book": "kosmos_humboldt_1845", "target_name": "Ferdinand the Catholic", "similarity": 0.864}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Ferdinand", "target_book": "polyanthea_medicinal", "target_name": "Ferdinando", "similarity": 0.962}, {"source_book": "kosmos_humboldt_1845", "source_name": "Ferdinand the Catholic", "target_book": "polyanthea_medicinal", "target_name": "Ferdinando", "similarity": 0.912}], "id": 445, "stable_key": "clu_e45329e9d526a57b", "ground_truth": {"modern_name": "Ferdinand II, Holy Roman Emperor", "confidence": "high", "type": "person", "birth_year": 1578, "death_year": 1637, "description": "Holy Roman Emperor and patron of scientific endeavors.", "note": "While \"Ferdinand the Emperor\" could refer to others (e.g., Ferdinand I), the context of patronage for Mathioli's work strongly points to Ferdinand II, who was a known patron. Ferdinand the Catholic is a distinct historical figure."}, "cross_references": [{"found_name": "Ferdinand I, Holy Roman Emperor", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3197, "target_cluster_name": "Dom Fernando", "source_book": "llm_generated", "evidence_snippet": "Ferdinand I was the paternal uncle of Ferdinand II and was Holy Roman Emperor before him. They are related through dynastic succession and family ties within the Habsburg dynasty.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Ferdinand I was the paternal uncle of Ferdinand II and was Holy Roman Emperor before him. They are related through dynastic succession and family ties within the Habsburg dynasty."}, {"found_name": "Carlos V.", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 771, "target_cluster_name": "Carlos V.", "source_book": "llm_generated", "evidence_snippet": "Both were Holy Roman Emperors, ruling over vast territories and playing crucial roles in European politics and religious conflicts of their respective eras.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were Holy Roman Emperors, ruling over vast territories and playing crucial roles in European politics and religious conflicts of their respective eras.", "is_reverse": true}, {"found_name": "Emperadores", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2523, "target_cluster_name": "Emperadores", "source_book": "llm_generated", "evidence_snippet": "Ferdinand II was a Holy Roman Emperor, a specific historical instance of the entity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Ferdinand II was a Holy Roman Emperor, a specific historical instance of the entity.", "is_reverse": true}]}, {"canonical_name": "Pallas", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "pallas", "book_id": "origin_of_species_darwin_1859", "name": "Pallas", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Pallas"], "contexts": ["mentioned koulan description", "naturalist who originated a doctrine"]}, {"entity_id": "pallas", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Pallas", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Pallas"], "contexts": ["encountered celestial spirits among Mongols", "described mud volcano"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Pallas", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Pallas", "similarity": 1.0}], "id": 446, "stable_key": "clu_3df2a056a5d3be28", "ground_truth": {"modern_name": "Peter Simon Pallas", "confidence": "high", "type": "person", "birth_year": 1741, "death_year": 1811, "description": "German zoologist, botanist, and explorer.", "note": "The references to \"Pallas\" in Darwin's and Humboldt's works, especially concerning descriptions and encounters, align with Pallas's extensive travels and scientific contributions. 'Platina' is likely a misreading or variant spelling of Pallas.", "wikidata_id": "Q155914", "wikidata_description": "German zoologist and botanist (1741–1811)", "wikipedia_url": "https://en.wikipedia.org/wiki/Peter%20Simon%20Pallas", "wikipedia_extract": "Peter Simon Pallas FRS FRSE (22 September 1741 – 8 September 1811) was a Prussian zoologist, botanist, ethnographer, explorer, geographer, geologist, natural historian, and taxonomist. He studied natural sciences at various universities in early modern Germany and worked primarily in the Russian Empire between 1767 and 1810. Peter Simon Pallas was born in Berlin, Kingdom of Prussia, the son of Professor of Surgery Simon Pallas. He studied with private tutors and took an interest in natural history, later attending the University of Halle and the University of Göttingen. In 1760, he moved to the University of Leiden and passed his doctor's degree at the age of 19. Pallas travelled throughout the Dutch Republic and to London, improving his medical and surgical knowledge."}, "cross_references": [{"found_name": "Alexander von Humboldt", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 42, "target_cluster_name": "Humboldt", "source_book": "llm_generated", "evidence_snippet": "Both were prominent naturalists and explorers active in the late 18th and early 19th centuries, undertaking extensive scientific expeditions and contributing significantly to the understanding of geography, zoology, and botany.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were prominent naturalists and explorers active in the late 18th and early 19th centuries, undertaking extensive scientific expeditions and contributing significantly to the understanding of geography, zoology, and botany."}, {"found_name": "Carl Linnaeus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2721, "target_cluster_name": "Linnæus", "source_book": "llm_generated", "evidence_snippet": "Pallas was a student and follower of Linnaeus's taxonomic system, applying it to his extensive collections and descriptions of flora and fauna, particularly from Siberia.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Pallas was a student and follower of Linnaeus's taxonomic system, applying it to his extensive collections and descriptions of flora and fauna, particularly from Siberia."}, {"found_name": "Georges Cuvier", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 119, "target_cluster_name": "Cuvier", "source_book": "llm_generated", "evidence_snippet": "Both were leading figures in zoology and natural history during the late 18th and early 19th centuries. Cuvier's work on paleontology and comparative anatomy built upon the descriptive zoological work of naturalists like Pallas.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were leading figures in zoology and natural history during the late 18th and early 19th centuries. Cuvier's work on paleontology and comparative anatomy built upon the descriptive zoological work of naturalists like Pallas."}]}, {"canonical_name": "Mississippi", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 8, "members": [{"entity_id": "mississippi", "book_id": "origin_of_species_darwin_1859", "name": "Mississippi", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Mississippi"], "contexts": ["river mouth where sediment accumulates", "rate of deposition at mouth"]}, {"entity_id": "mississippi_river", "book_id": "origin_of_species_darwin_1859", "name": "Mississippi river", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Mississippi river"], "contexts": ["river with sediment deposition"]}, {"entity_id": "mississippi", "book_id": "principles_of_psychology_james_1890", "name": "Mississippi", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Mississippi"], "contexts": ["river used in an analogy for urine measurement"]}, {"entity_id": "mississippi", "book_id": "kosmos_humboldt_1845", "name": "Mississippi", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Mississippi"], "contexts": ["river valley", "river mouth with drift-wood"]}, {"entity_id": "mississippi", "book_id": "first_principles_spencer_1862", "name": "Mississippi", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Mississippi"], "contexts": ["great river with trees held by current", "river mouth with sinking strata"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Mississippi", "target_book": "principles_of_psychology_james_1890", "target_name": "Mississippi", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Mississippi", "target_book": "kosmos_humboldt_1845", "target_name": "Mississippi", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Mississippi", "target_book": "first_principles_spencer_1862", "target_name": "Mississippi", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Mississippi river", "target_book": "principles_of_psychology_james_1890", "target_name": "Mississippi", "similarity": 0.883}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Mississippi river", "target_book": "kosmos_humboldt_1845", "target_name": "Mississippi", "similarity": 0.883}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Mississippi river", "target_book": "first_principles_spencer_1862", "target_name": "Mississippi", "similarity": 0.883}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Mississippi", "target_book": "kosmos_humboldt_1845", "target_name": "Mississippi", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Mississippi", "target_book": "first_principles_spencer_1862", "target_name": "Mississippi", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Mississippi", "target_book": "first_principles_spencer_1862", "target_name": "Mississippi", "similarity": 1.0}], "id": 447, "stable_key": "clu_8ea4c9d30ad10b23", "ground_truth": {"modern_name": "Mississippi River", "confidence": "high", "type": "place", "description": "A major river in the central United States.", "note": "Also refers to the historical territory associated with the river.", "wikipedia_extract": "The Mississippi River is the primary river of the largest drainage basin in the United States. It is the second-longest river in the United States, behind only the Missouri. From its traditional source of Lake Itasca in northern Minnesota, it flows generally south for 2,340 mi (3,770 km) to the Mississippi River Delta in the Gulf of Mexico. With its many tributaries, the Mississippi's watershed drains all or parts of 32 U.S. states and two Canadian provinces between the Rocky and Appalachian mountains. The river either borders or passes through the states of Minnesota, Wisconsin, Iowa, Illinois, Missouri, Kentucky, Tennessee, Arkansas, Mississippi, and Louisiana. The main stem is entirely within the United States; the total drainage basin is 1,151,000 mi2 (2,980,000 km2), of which only about one percent is in Canada."}, "cross_references": []}, {"canonical_name": "dispersion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 8, "members": [{"entity_id": "dispersal", "book_id": "origin_of_species_darwin_1859", "name": "dispersal", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["dispersal"], "contexts": ["spreading of species over wide areas"]}, {"entity_id": "dispersion", "book_id": "kosmos_humboldt_1845", "name": "dispersion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["dispersion"], "contexts": ["scattering of species"]}, {"entity_id": "dispersion", "book_id": "connexion_physical_sciences_somerville_1858", "name": "dispersion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["dispersion"], "contexts": ["spreading or separation of coloured rays", "spreading of light into spectrum"]}, {"entity_id": "diffusion", "book_id": "first_principles_spencer_1862", "name": "diffusion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["diffusion"], "contexts": ["spreading of substances or energy", "spreading of particles"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "dispersal", "target_book": "kosmos_humboldt_1845", "target_name": "dispersion", "similarity": 0.916}, {"source_book": "origin_of_spe