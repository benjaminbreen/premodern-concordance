 {"found_name": "labradoritic augite", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "kosmos_humboldt_1845", "evidence_snippet": "are justy termed in many languages \"fire-emitting mountains,\" mountains of this kind are not formed by the gradual accumulation of ejected currents of lava, but their origin seems rather to be a gener", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of ejected material"}]}, {"canonical_name": "pimpinella", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 24, "members": [{"entity_id": "pimpinella", "book_id": "ricettario_fiorentino_1597", "name": "Pimpinella", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Pimpinella"], "contexts": ["burnet, a medicinal herb"]}, {"entity_id": "pimpinella", "book_id": "polyanthea_medicinal", "name": "pimpinella", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 22, "variants": ["pimpinella", "pimpinela", "pimpinella scabiofe"], "contexts": ["herb used in a diuretic preparation", "herb for sustaining goat"]}, {"entity_id": "pimpinellam", "book_id": "polyanthea_medicinal", "name": "Pimpinellam", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Pimpinellam"], "contexts": ["pimpinella, used to treat fever"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Pimpinella", "target_book": "polyanthea_medicinal", "target_name": "pimpinella", "similarity": 0.591}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Pimpinella", "target_book": "polyanthea_medicinal", "target_name": "Pimpinellam", "similarity": 0.957}], "id": 1715, "stable_key": "clu_587ed1ad3620ef7b", "ground_truth": {"modern_name": "Burnet", "confidence": "high", "type": "plant", "linnaean": "Sanguisorba officinalis", "family": "Rosaceae", "note": "Pimpinella is a genus, but 'pimpinella' in medicinal contexts often refers to Pimpinella anisum (anise) or Pimpinella saxifraga (burnet saxifrage), both used medicinally. Given the context of a 'medicinal herb' and 'burnet', Sanguisorba officinalis (Great Burnet) is a strong candidate, though Pimpinella saxifraga is also plausible."}, "cross_references": []}, {"canonical_name": "Dr. Hooker", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 23, "members": [{"entity_id": "dr__hooker", "book_id": "origin_of_species_darwin_1859", "name": "Dr. Hooker", "category": "PERSON", "subcategory": "SCHOLAR", "count": 22, "variants": ["Dr. Hooker", "Hooker"], "contexts": ["read Darwin's sketch of 1844", "aided author for fifteen years"]}, {"entity_id": "dr__hooker", "book_id": "kosmos_humboldt_1845", "name": "Dr. Hooker", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Dr. Hooker"], "contexts": ["author of paper read before British Association"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Dr. Hooker", "target_book": "kosmos_humboldt_1845", "target_name": "Dr. Hooker", "similarity": 1.0}], "id": 1716, "stable_key": "clu_98b44a52b8c7ae95", "ground_truth": {"modern_name": "Joseph Dalton Hooker", "confidence": "high", "type": "person", "birth_year": 1817, "death_year": 1911, "description": "British botanist and explorer, friend of Darwin", "wikidata_id": "Q157501", "wikidata_description": "British botanist, lichenologist, and surgeon (1817–1911)", "wikipedia_url": "https://en.wikipedia.org/wiki/Joseph%20Dalton%20Hooker", "wikipedia_extract": "Sir Joseph Dalton Hooker (30 June 1817 – 10 December 1911) was a British botanist and explorer in the 19th century. He was a founder of geographical botany and Charles Darwin's closest friend. For 20 years he served as director of the Royal Botanical Gardens, Kew, succeeding his father, William Jackson Hooker, and was awarded the highest honours of British science. Hooker was born in Halesworth, Suffolk, England. He was the second son of Maria Sarah Turner, eldest daughter of the banker Dawson Turner and sister-in-law of Francis Palgrave, and the famous botanist Sir William Jackson Hooker, Regius Professor of Botany. From the age of seven, Hooker attended his father's lectures at the University of Glasgow, taking an early interest in plant distribution and the voyages of explorers like Captain James Cook."}, "cross_references": [{"found_name": "Charles Darwin", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 118, "target_cluster_name": "Darwin", "source_book": "llm_generated", "evidence_snippet": "Charles Darwin was Joseph Dalton Hooker's closest friend and collaborator in botany.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Charles Darwin was Joseph Dalton Hooker's closest friend and collaborator in botany."}, {"found_name": "Alexander von Humboldt", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 42, "target_cluster_name": "Humboldt", "source_book": "llm_generated", "evidence_snippet": "Alexander von Humboldt was a significant figure in geographical botany, a field Hooker helped found.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Alexander von Humboldt was a significant figure in geographical botany, a field Hooker helped found."}, {"found_name": "Alfred Russel Wallace", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2104, "target_cluster_name": "Wallace", "source_book": "llm_generated", "evidence_snippet": "Alfred Russel Wallace was a contemporary naturalist and explorer, often associated with Darwin and Hooker in the context of 19th-century biological discovery.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Alfred Russel Wallace was a contemporary naturalist and explorer, often associated with Darwin and Hooker in the context of 19th-century biological discovery."}]}, {"canonical_name": "diorite", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 23, "members": [{"entity_id": "diorite", "book_id": "relation_historique_humboldt_vol3_1825", "name": "diorite", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 17, "variants": ["diorite", "DIORITE", "dlorite", "dolerites", "dolérite", "dolérites"], "contexts": ["type of igneous rock", "diorite rock, geological material"]}, {"entity_id": "diorite", "book_id": "kosmos_humboldt_1845", "name": "diorite", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 6, "variants": ["diorite", "Diorite"], "contexts": ["igneous rock type", "compound rock"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "diorite", "target_book": "kosmos_humboldt_1845", "target_name": "diorite", "similarity": 1.0}], "id": 1717, "stable_key": "clu_393a707765d65a59", "ground_truth": {"modern_name": "Diorite", "confidence": "high", "type": "mineral", "wikidata_id": "Q187408", "wikidata_description": "deep igneous rocks made of equal amounts of alkali feldspar and intermediate plagioclase, the most common stained ingredients are amphibole, biotite and pyroxene, and accessory minerals apatite and sfen; volcanic equivalent: tackle.", "wikipedia_extract": "In geology, a rock (also called a stone) is any naturally occurring solid mass or aggregate of minerals or mineraloid matter. It is categorized by the minerals included, its chemical composition, and the way in which it is formed. Rocks form the Earth's outer solid layer, the crust, and most of its interior, except for the liquid outer core and pockets of magma in the asthenosphere. The study of rocks involves multiple subdisciplines of geology, including petrology and mineralogy. It may be limited to rocks found on Earth, or it may include planetary geology that studies the rocks of other celestial objects. Rocks are usually grouped into three main groups: igneous rocks, sedimentary rocks and metamorphic rocks.", "wikipedia_url": "https://en.wikipedia.org/wiki/Diorite"}, "cross_references": [{"found_name": "earth", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 533, "target_cluster_name": "earth", "source_book": "llm_generated", "evidence_snippet": "Diorite is an intrusive igneous rock intermediate in composition between volcanic and plutonic rocks. It is found in the Earth's crust.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Diorite is an intrusive igneous rock intermediate in composition between volcanic and plutonic rocks. It is found in the Earth's crust.", "is_reverse": true}, {"found_name": "trachyte", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1626, "target_cluster_name": "trachyte", "source_book": "llm_generated", "evidence_snippet": "Diorite is an intrusive igneous rock, and trachyte is its extrusive equivalent. They share similar mineral compositions.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Diorite is an intrusive igneous rock, and trachyte is its extrusive equivalent. They share similar mineral compositions.", "is_reverse": true}, {"found_name": "granite", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1634, "target_cluster_name": "granite", "source_book": "llm_generated", "evidence_snippet": "Both are types of igneous rock, often compared and contrasted in petrology.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both are types of igneous rock, often compared and contrasted in petrology.", "is_reverse": true}, {"found_name": "basalt", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1665, "target_cluster_name": "basalt", "source_book": "llm_generated", "evidence_snippet": "Diorite is an igneous rock that is compositionally similar to basalt, often found in similar geological contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Diorite is an igneous rock that is compositionally similar to basalt, often found in similar geological contexts.", "is_reverse": true}, {"found_name": "Lava", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1714, "target_cluster_name": "lava", "source_book": "llm_generated", "evidence_snippet": "Diorite is an intrusive igneous rock, formed from solidified magma, which is closely related to lava, the extrusive equivalent.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Diorite is an intrusive igneous rock, formed from solidified magma, which is closely related to lava, the extrusive equivalent."}, {"found_name": "Metamorphic rocks", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2992, "target_cluster_name": "metamorphic schists", "source_book": "llm_generated", "evidence_snippet": "Diorite is an igneous rock, and metamorphic rocks are another major category of rocks, often discussed in relation to igneous rocks in geological classifications.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Diorite is an igneous rock, and metamorphic rocks are another major category of rocks, often discussed in relation to igneous rocks in geological classifications."}, {"found_name": "Rock", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 383, "target_cluster_name": "rock", "source_book": "llm_generated", "evidence_snippet": "Diorite is a specific type of rock.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Diorite is a specific type of rock."}, {"found_name": "Stone", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 132, "target_cluster_name": "stone", "source_book": "llm_generated", "evidence_snippet": "Diorite is a specific type of stone.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Diorite is a specific type of stone."}, {"found_name": "Volcanic rocks", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2771, "target_cluster_name": "roches volcaniques", "source_book": "llm_generated", "evidence_snippet": "Diorite is an igneous rock, and volcanic rocks are a subcategory of igneous rocks, often discussed in relation to each other.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Diorite is an igneous rock, and volcanic rocks are a subcategory of igneous rocks, often discussed in relation to each other."}, {"found_name": "feldspar", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1948, "target_cluster_name": "feldspar", "source_book": "llm_generated", "evidence_snippet": "Diorite is an intrusive igneous rock composed mainly of plagioclase feldspar, biotite, hornblende, and pyroxene.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Diorite is an intrusive igneous rock composed mainly of plagioclase feldspar, biotite, hornblende, and pyroxene.", "is_reverse": true}, {"found_name": "olivine", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1989, "target_cluster_name": "olivine", "source_book": "llm_generated", "evidence_snippet": "Olivine can be found in some diorites, which are intermediate igneous rocks.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Olivine can be found in some diorites, which are intermediate igneous rocks.", "is_reverse": true}, {"found_name": "grünstein", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2781, "target_cluster_name": "grünstein", "source_book": "llm_generated", "evidence_snippet": "Grünstein is a type of diorite, an intrusive igneous rock.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Grünstein is a type of diorite, an intrusive igneous rock.", "is_reverse": true}]}, {"canonical_name": "portuguez", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 23, "members": [{"entity_id": "portugaise", "book_id": "relation_historique_humboldt_vol3_1825", "name": "portugaise", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["portugaise"], "contexts": ["territorial dispute origin", "Portuguese race/language"]}, {"entity_id": "portuguez", "book_id": "coloquios_da_orta_1563", "name": "portuguez", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 20, "variants": ["portuguez", "Portuguez", "portugueza", "português", "versão portugueza"], "contexts": ["person from Portugal", "person who consumed maju"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "portugaise", "target_book": "coloquios_da_orta_1563", "target_name": "portuguez", "similarity": 0.906}], "id": 1718, "stable_key": "clu_35f73c0448783e4c", "ground_truth": {"modern_name": "Portuguese", "confidence": "high", "type": "person", "description": "A person from or related to Portugal.", "wikipedia_extract": "The Portuguese people (Portuguese: Portugueses – masculine – or Portuguesas) are a Romance-speaking ethnic group and nation indigenous to Portugal, a country that occupies the west side of the Iberian Peninsula in south-west Europe, who share culture, ancestry and language. The Portuguese state began with the founding of the County of Portugal in 868. Following the Battle of São Mamede (1128), Portugal gained international recognition as a kingdom through the Treaty of Zamora and the papal bull Manifestis Probatum. This Portuguese state paved the way for the Portuguese people to unite as a nation. The Portuguese explored distant lands previously unknown to Europeans—in the Americas, Africa, Asia and Oceania (southwest Pacific Ocean). In 1415, with the conquest of Ceuta, the Portuguese took a significant role in the Age of Discovery, which culminated in a colonial empire."}, "cross_references": [{"found_name": "calecomer", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "desta fralda do mar) o chamão calecomer, e os Cas- telhanos acibar, e os Portuguezes a^etTe: fazse de çumo de huma hcrva depois de seco, e he chamada em portuguez herva-babosa, da qual herva ay muita ", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "alternative name for the substance"}, {"found_name": "acibar", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "desta fralda do mar) o chamão calecomer, e os Cas- telhanos acibar, e os Portuguezes a^etTe: fazse de çumo de huma hcrva depois de seco, e he chamada em portuguez herva-babosa, da qual herva ay muita ", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "alternative name for the substance"}, {"found_name": "maju", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "ditas, a que chamão maju (3). RUANO Faz esses effeitos de prazer em todos? ORTA Pôde ser que nos acustumados a elle, que os fará assi; mas eu vi hum portuguez choquareiro, que comigo foy ao Balagate h", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "alternative name for the substance"}, {"found_name": "canje", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "arroz com pimenta e cominhos (a que chamão canje^); cautirizamlhe os pés, como • Como se vê, a palavra canje ou canja ainda então nSo tinha foros de portugueza. Do Cosio 265 mandei fazer áquelle fidal", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "alternative name for the dish"}, {"found_name": "djamán", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "do íinicto é ^j^^a. djamán; e em Bombaim chamam- lhe também y^hnM/, parecendo que o nome átjam^ balãa — pelo menos na sua desinência — seria um arranjo português i. Este fructo, que comem na índia ape", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym of known entity"}, {"found_name": "hacchic", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "comprimento de seis palmos. A este ar- vore chamam, na terra donde nace, hacchic**: e pode ser que por eu não saber a lingoa desta terra tam bem como a portugueza, não pude saber a rezam porque lhe ch", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym of known entity"}, {"found_name": "cate", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "comprimento de seis palmos. A este ar- vore chamam, na terra donde nace, hacchic**: e pode ser que por eu não saber a lingoa desta terra tam bem como a portugueza, não pude saber a rezam porque lhe ch", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym of known entity"}, {"found_name": "ladrão", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "está muyto coalhado; e asi he branca, e ás vezes he muyta, e ás vezes pouca, como a que nasce dentro das canas de escrever, a que os moços, em linguoa portugueza, chamam ladrão, E por o que vos dixe v", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym of known entity"}, {"found_name": "BananaSf", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "Muse d'Egitto e di Soria, A ultima parte da phrase pôde ser uma intercala- ção do erudito italiano Pigafetta, que escreveu a relação verbal do via- jante português; mas a primeira, que chamam BananaSf", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "local name from Africa"}]}, {"canonical_name": "Society", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 23, "members": [{"entity_id": "society", "book_id": "principles_of_psychology_james_1890", "name": "society", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["society"], "contexts": ["group of people living together"]}, {"entity_id": "society", "book_id": "first_principles_spencer_1862", "name": "Society", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 22, "variants": ["Society", "society"], "contexts": ["complex conditions arising from social interaction", "human collective organization and its conditions"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "society", "target_book": "first_principles_spencer_1862", "target_name": "Society", "similarity": 0.944}], "id": 1719, "stable_key": "clu_62e3211bdf20bafe", "ground_truth": {"modern_name": "Society", "confidence": "high", "type": "concept", "wikidata_id": "Q829080", "wikidata_description": "mission-driven organization seeking to further a particular profession", "wikipedia_url": "https://en.wikipedia.org/wiki/Professional%20association", "wikipedia_extract": "A professional association (also called  a professional body, professional organization, or professional society) is a group that usually seeks to further a particular profession, the interests of individuals and organisations engaged in that profession, and the public interest. In the United States, such an association is typically a nonprofit business league for tax purposes. In the UK, they may take a variety of legal forms. The roles of professional associations have been variously defined: \"A group of people in a learned occupation who are entrusted with maintaining control or oversight of the legitimate practice of the occupation;\" also a body acting \"to safeguard the public interest;\" organizations which \"represent the interest of the professional practitioners,\" and so \"act to maintain their own privileged and powerful position as a controlling body.\" Professional associations are ill defined although often have commonality in purpose and activities. In the UK the Science Council defines a professional body as \"an organisation with individual members practicing a profession or occupation in which the organisation maintains an oversight of the knowledge, skills, conduct and practice of that profession or occupation\". The Quality Assurance Agency distinguishes between statutory bodies and regulators that \"have powers mandated by Parliament to regulate a profession or group of professions and protect the use of professional titles\" and professional bodies that \"are independent membership organisations that oversee the activities of a particular profession and represent the interests of [their] members\" and which \"may offer registration or certification of unregulated occupations on a voluntary basis.\" Many professional bodies are involved in accrediting degrees, defining and examining the skills and competencies necessary to practice, and granting professional certifications to indicate that a person is qualified in the subject area."}, "cross_references": [{"found_name": "Association of Ideas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1992, "target_cluster_name": "association of ideas", "source_book": "llm_generated", "evidence_snippet": "The description of 'Society' as a professional association that further seeks to advance a profession and its interests strongly relates to the concept of 'Association of Ideas', as professional societies are built upon shared ideas and collective action.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The description of 'Society' as a professional association that further seeks to advance a profession and its interests strongly relates to the concept of 'Association of Ideas', as professional societies are built upon shared ideas and collective action."}, {"found_name": "Organization", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 340, "target_cluster_name": "organisation", "source_book": "llm_generated", "evidence_snippet": "The description of 'Society' as a professional association directly implies an organized structure and purpose, making 'Organization' a closely related concept.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The description of 'Society' as a professional association directly implies an organized structure and purpose, making 'Organization' a closely related concept."}]}, {"canonical_name": "earthquakes", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 28, "members": [{"entity_id": "earthquakes", "book_id": "kosmos_humboldt_1845", "name": "earthquakes", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 18, "variants": ["earthquakes", "Earthquakes"], "contexts": ["shaking of the Earth's surface", "sudden violent shaking of the ground"]}, {"entity_id": "earthquakes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "earthquakes", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 5, "variants": ["Earthquakes", "earthquakes"], "contexts": ["geological events causing subterranean noises", "tremors propagated through the ground"]}, {"entity_id": "earthquake_shocks", "book_id": "kosmos_humboldt_1845", "name": "earthquake shocks", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["earthquake shocks"], "contexts": ["ground tremors", "geological disturbances"]}, {"entity_id": "earthquake", "book_id": "connexion_physical_sciences_somerville_1858", "name": "earthquake", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["earthquake"], "contexts": ["natural disaster causing destruction", "causing land elevation in Chile"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "earthquakes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "earthquakes", "similarity": 1.0}], "id": 1720, "stable_key": "clu_f0086a8c4b9ecae8", "ground_truth": {"modern_name": "Earthquake", "confidence": "high", "type": "concept", "note": "While earthquakes are geological events, they were sometimes discussed in early modern texts in relation to their perceived physical or even 'unnatural' causes, sometimes grouped loosely with phenomena that could affect health or the environment, hence the 'disease' categorization in the prompt's format.", "wikidata_id": "Q7944", "wikidata_description": "result of a sudden release of energy in the Earth's crust that creates seismic waves", "wikipedia_url": "https://en.wikipedia.org/wiki/Earthquake", "modern_term": "Earthquake", "wikipedia_extract": "An earthquake, also called a quake, tremor, or temblor, is the shaking of the Earth's surface resulting from a sudden release of energy in the lithosphere that creates seismic waves. Earthquakes can range in intensity, from those so weak they cannot be felt, to those violent enough to propel objects and people into the air, damage critical infrastructure, and wreak destruction across entire cities. The seismic activity of an area is the frequency, type, and size of earthquakes experienced over a particular time. The seismicity at a particular location in the Earth is the average rate of seismic energy release per unit volume. In its most general sense, the word earthquake is used to describe any seismic event that generates seismic waves. Earthquakes can occur naturally or be induced by human activities, such as mining, fracking, and nuclear weapons testing."}, "member_count": 4, "cross_references": [{"found_name": "Tremor", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1480, "target_cluster_name": "tremor", "source_book": "llm_generated", "evidence_snippet": "Tremor is a direct synonym for earthquake, referring to the shaking motion.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Tremor is a direct synonym for earthquake, referring to the shaking motion."}, {"found_name": "magnetic storms", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2003, "target_cluster_name": "magnetic storms", "source_book": "llm_generated", "evidence_snippet": "Both 'magnetic storms' and 'earthquakes' are powerful natural events that can cause widespread disruption. Historically, they might have been grouped as significant, potentially destructive forces of nature.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both 'magnetic storms' and 'earthquakes' are powerful natural events that can cause widespread disruption. Historically, they might have been grouped as significant, potentially destructive forces of nature.", "is_reverse": true}]}, {"canonical_name": "magnetic force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 23, "members": [{"entity_id": "magnetic_force", "book_id": "kosmos_humboldt_1845", "name": "magnetic force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["magnetic force"], "contexts": ["strength of magnetic field", "fundamental physical force"]}, {"entity_id": "magnetic_forces", "book_id": "kosmos_humboldt_1845", "name": "magnetic forces", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["magnetic forces"], "contexts": ["forces associated with magnetism", "forces related to magnetism"]}, {"entity_id": "magnetic_power", "book_id": "kosmos_humboldt_1845", "name": "magnetic power", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["magnetic power"], "contexts": ["force of magnetism"]}, {"entity_id": "magnetic_force", "book_id": "connexion_physical_sciences_somerville_1858", "name": "magnetic force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 8, "variants": ["magnetic force"], "contexts": ["force exerted by magnets", "force associated with magnetism"]}, {"entity_id": "magnetic_forces", "book_id": "connexion_physical_sciences_somerville_1858", "name": "magnetic forces", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["magnetic forces"], "contexts": ["forces associated with magnetism", "forces related to magnetism"]}, {"entity_id": "magnetic_power", "book_id": "connexion_physical_sciences_somerville_1858", "name": "magnetic power", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["magnetic power"], "contexts": ["strength of magnetic field"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "magnetic force", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic force", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic force", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic forces", "similarity": 0.939}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic force", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic power", "similarity": 0.944}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic forces", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic force", "similarity": 0.939}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic forces", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic forces", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic forces", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic power", "similarity": 0.9}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic power", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic force", "similarity": 0.944}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic power", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic forces", "similarity": 0.9}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic power", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic power", "similarity": 1.0}], "id": 1721, "stable_key": "clu_73fce4e90b09b874", "ground_truth": {"modern_name": "Magnetic force", "confidence": "high", "type": "concept", "wikidata_id": "Q11408", "wikidata_description": "spatial distribution of vectors allowing the calculation of the magnetic force on a test particle", "wikipedia_url": "https://en.wikipedia.org/wiki/Magnetic%20field", "wikipedia_extract": "A magnetic field (sometimes called B-field) is a physical field that describes the magnetic influence on moving electric charges, electric currents, and magnetic materials. A moving charge in a magnetic field experiences a force perpendicular to its own velocity and to the magnetic field. A permanent magnet's magnetic field pulls on ferromagnetic materials such as iron, and attracts or repels other magnets. In addition, a nonuniform magnetic field exerts minuscule forces on \"nonmagnetic\" materials by three other magnetic effects: paramagnetism, diamagnetism, and antiferromagnetism, although these forces are usually so small they can only be detected by laboratory equipment. Magnetic fields surround magnetized materials, electric currents, and electric fields varying in time. Since both strength and direction of a magnetic field may vary with location, it is described mathematically by a function assigning a vector to each point of space, called a vector field (more precisely, a pseudovector field)."}, "cross_references": [{"found_name": "pôles magnétiques", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1742, "target_cluster_name": "pôles magnétiques", "source_book": "llm_generated", "evidence_snippet": "Magnetic poles are the source of magnetic forces.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Magnetic poles are the source of magnetic forces.", "is_reverse": true}, {"found_name": "Attractive force", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1111, "target_cluster_name": "attractive force", "source_book": "llm_generated", "evidence_snippet": "Magnetic force is a specific type of attractive force, and historical texts frequently discuss these concepts together.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Magnetic force is a specific type of attractive force, and historical texts frequently discuss these concepts together."}, {"found_name": "Electric force", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2849, "target_cluster_name": "electric force", "source_book": "llm_generated", "evidence_snippet": "Historical understanding of electricity and magnetism were often intertwined, with 'magnetic force' being discussed alongside 'electric force' as fundamental forces.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Historical understanding of electricity and magnetism were often intertwined, with 'magnetic force' being discussed alongside 'electric force' as fundamental forces."}, {"found_name": "Force", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 59, "target_cluster_name": "Force", "source_book": "llm_generated", "evidence_snippet": "Magnetic force is a fundamental concept within the broader category of 'force' as understood in physics.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Magnetic force is a fundamental concept within the broader category of 'force' as understood in physics."}, {"found_name": "Galvanism", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3585, "target_cluster_name": "galvanism", "source_book": "llm_generated", "evidence_snippet": "Galvanism, the study of electricity produced by chemical reactions, was historically linked to the study of magnetism and electromagnetism.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Galvanism, the study of electricity produced by chemical reactions, was historically linked to the study of magnetism and electromagnetism."}, {"found_name": "Induction", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 280, "target_cluster_name": "Induction", "source_book": "llm_generated", "evidence_snippet": "Electromagnetic induction, the production of an electromotive force across an electrical conductor in a changing magnetic field, is a key phenomenon linking electricity and magnetism.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Electromagnetic induction, the production of an electromotive force across an electrical conductor in a changing magnetic field, is a key phenomenon linking electricity and magnetism."}]}, {"canonical_name": "doces", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 23, "members": [{"entity_id": "doce", "book_id": "coloquios_da_orta_1563", "name": "doce", "category": "CONCEPT", "subcategory": "QUALITY", "count": 4, "variants": ["doce"], "contexts": ["sweet flavor", "quality of the casto"]}, {"entity