_cluster_name": "breed", "source_book": "llm_generated", "evidence_snippet": "Sexual selection can lead to the divergence of populations and the formation of distinct breeds or species.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Sexual selection can lead to the divergence of populations and the formation of distinct breeds or species."}, {"found_name": "Animal Kingdom", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2373, "target_cluster_name": "animal kingdom", "source_book": "llm_generated", "evidence_snippet": "Sexual selection is a phenomenon observed across the Animal Kingdom, influencing the diversity of species.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Sexual selection is a phenomenon observed across the Animal Kingdom, influencing the diversity of species."}, {"found_name": "Attraction", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 82, "target_cluster_name": "attraction", "source_book": "llm_generated", "evidence_snippet": "Sexual selection often involves mate choice based on perceived attractiveness.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Sexual selection often involves mate choice based on perceived attractiveness."}, {"found_name": "Desire", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 925, "target_cluster_name": "desire", "source_book": "llm_generated", "evidence_snippet": "Sexual selection is fundamentally linked to reproductive drives and desires.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Sexual selection is fundamentally linked to reproductive drives and desires."}, {"found_name": "Sexes", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2515, "target_cluster_name": "Sexes", "source_book": "llm_generated", "evidence_snippet": "'Sexual selection' is a specific evolutionary mechanism directly related to 'Sexes' and their role in reproduction and mate choice.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: 'Sexual selection' is a specific evolutionary mechanism directly related to 'Sexes' and their role in reproduction and mate choice.", "is_reverse": true}]}, {"canonical_name": "Agassiz", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "agassiz", "book_id": "origin_of_species_darwin_1859", "name": "Agassiz", "category": "PERSON", "subcategory": "SCHOLAR", "count": 8, "variants": ["Agassiz"], "contexts": ["remarked on blind fish", "palæontologist arguing against transmutation"]}, {"entity_id": "agassiz", "book_id": "kosmos_humboldt_1845", "name": "Agassiz", "category": "PERSON", "subcategory": "SCHOLAR", "count": 8, "variants": ["Agassiz"], "contexts": ["author of work on fossil fishes", "ichthyologist and paleontologist"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Agassiz", "target_book": "kosmos_humboldt_1845", "target_name": "Agassiz", "similarity": 1.0}], "id": 1842, "stable_key": "clu_c3a81ea3802e7904", "ground_truth": {"modern_name": "Louis Agassiz", "confidence": "high", "type": "person", "description": "Swiss-born naturalist, geologist, and paleontologist.", "wikipedia_extract": "Jean Louis Rodolphe Agassiz  ( AG-ə-see; French: [aɡasi]; May 28, 1807 – December 14, 1873) was a Swiss-born American biologist and geologist who is recognized as a scholar of Earth's natural history. Spending his early life in Switzerland, he received a PhD at Erlangen and a medical degree in Munich. After studying with Georges Cuvier and Alexander von Humboldt in Paris, Agassiz was appointed professor of natural history at the University of Neuchâtel. He emigrated to the United States in 1847 after visiting Harvard University. He went on to become professor of zoology and geology at Harvard, to head its Lawrence Scientific School, and to found its Museum of Comparative Zoology. Agassiz is known for observational data gathering and analysis."}, "cross_references": [{"found_name": "Charles Lyell", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1710, "target_cluster_name": "Lyell", "source_book": "llm_generated", "evidence_snippet": "Both were prominent geologists who significantly contributed to the understanding of Earth's history and geological processes. Lyell's work on uniformitarianism influenced Agassiz's theories on ice ages.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were prominent geologists who significantly contributed to the understanding of Earth's history and geological processes. Lyell's work on uniformitarianism influenced Agassiz's theories on ice ages."}, {"found_name": "Alexander von Humboldt", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 42, "target_cluster_name": "Humboldt", "source_book": "llm_generated", "evidence_snippet": "Humboldt was a towering figure in natural history and exploration, and his extensive work and writings inspired and influenced many scientists, including Agassiz, particularly in the fields of geology and zoology.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Humboldt was a towering figure in natural history and exploration, and his extensive work and writings inspired and influenced many scientists, including Agassiz, particularly in the fields of geology and zoology."}, {"found_name": "Georges Cuvier", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 119, "target_cluster_name": "Cuvier", "source_book": "llm_generated", "evidence_snippet": "Cuvier was a highly influential naturalist and zoologist whose work on comparative anatomy and paleontology laid groundwork that Agassiz built upon, especially in his studies of fossil fishes and his theory of successive creations.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Cuvier was a highly influential naturalist and zoologist whose work on comparative anatomy and paleontology laid groundwork that Agassiz built upon, especially in his studies of fossil fishes and his theory of successive creations."}, {"found_name": "Charles Darwin", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 118, "target_cluster_name": "Darwin", "source_book": "llm_generated", "evidence_snippet": "While their scientific views diverged significantly (Agassiz rejected Darwin's theory of evolution by natural selection), they were contemporaries and major figures in natural history, and their work and debates are historically linked.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "While their scientific views diverged significantly (Agassiz rejected Darwin's theory of evolution by natural selection), they were contemporaries and major figures in natural history, and their work and debates are historically linked."}, {"found_name": "Geologists", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 956, "target_cluster_name": "geologists", "source_book": "llm_generated", "evidence_snippet": "Agassiz was a prominent geologist, and this entry represents the broader professional category to which he belonged and contributed.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Agassiz was a prominent geologist, and this entry represents the broader professional category to which he belonged and contributed."}]}, {"canonical_name": "Sicily", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 5, "total_mentions": 24, "members": [{"entity_id": "sicily", "book_id": "origin_of_species_darwin_1859", "name": "Sicily", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Sicily"], "contexts": ["island where a species was found fossil", "island with marine inhabitants"]}, {"entity_id": "sicily", "book_id": "kosmos_humboldt_1845", "name": "Sicily", "category": "PLACE", "subcategory": "COUNTRY", "count": 13, "variants": ["Sicily"], "contexts": ["location where a comet was discovered", "southern Italian island"]}, {"entity_id": "sicilia", "book_id": "english_physician_1652", "name": "Sicilia", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Sicilia"], "contexts": ["island where Hybla is located"]}, {"entity_id": "sicile", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Sicile", "category": "PLACE", "subcategory": "COUNTRY", "count": 6, "variants": ["Sicile"], "contexts": ["island in the Mediterranean", "island in Italy"]}, {"entity_id": "sicilia", "book_id": "coloquios_da_orta_1563", "name": "Sicilia", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Sicilia"], "contexts": ["island where anacardo was introduced"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Sicily", "target_book": "kosmos_humboldt_1845", "target_name": "Sicily", "similarity": 0.865}], "id": 1843, "stable_key": "clu_981c41db4ebf4c99", "ground_truth": {"modern_name": "Sicily", "confidence": "high", "type": "place", "country": "Italy", "note": "The reference to Hybla, an ancient city in Sicily, and its Mediterranean location firmly identifies this island.", "wikidata_id": "Q1460", "wikidata_description": "island in the Mediterranean, region of Italy", "wikipedia_url": "https://en.wikipedia.org/wiki/Sicily", "wikipedia_extract": "Sicily (Italian and Sicilian: Sicilia) is an island in the central Mediterranean Sea and one of the twenty regions of Italy, situated south of the Italian Peninsula in continental Europe. With 4.7 million inhabitants, including 1.2 million in and around the capital city of Palermo, it is both the largest and most populous island in the Mediterranean Sea. Sicily's namesake is the Sicels, who inhabited the eastern part of the island during the Iron Age. Sicily has a rich and unique culture in arts, music, literature, cuisine, and architecture. Its most prominent landmark is Mount Etna, the tallest active volcano in Europe, and one of the most active in the world, currently 3,403 m (11,165 ft) high. The island has a typical Mediterranean climate."}, "member_count": 5, "cross_references": [{"found_name": "Calabria", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2315, "target_cluster_name": "Calabria", "source_book": "llm_generated", "evidence_snippet": "Calabria is a peninsula in Southern Italy, directly north of Sicily, and historically and geographically closely linked to the island.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Calabria is a peninsula in Southern Italy, directly north of Sicily, and historically and geographically closely linked to the island."}]}, {"canonical_name": "Santa Marta", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "santa_marta", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Santa Marta", "category": "PLACE", "subcategory": "CITY", "count": 15, "variants": ["Santa Marta", "San Mateo"], "contexts": ["city with population 62,000", "city in Colombia"]}, {"entity_id": "santa_marta", "book_id": "kosmos_humboldt_1845", "name": "Santa Marta", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Santa Marta"], "contexts": ["location of subterranean thunder"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Santa Marta", "target_book": "kosmos_humboldt_1845", "target_name": "Santa Marta", "similarity": 1.0}], "id": 1844, "stable_key": "clu_53a307ca784da248", "ground_truth": {"modern_name": "Santa Marta", "confidence": "high", "type": "place", "country": "Colombia", "wikidata_id": "Q1629459", "wikidata_description": "municipality in the province of Badajoz, Spain", "wikipedia_url": "https://en.wikipedia.org/wiki/Santa_Marta%2C_Extremadura", "wikipedia_extract": "Santa Marta is a municipality (population 4,157) in the Spanish province of Badajoz, in the autonomous community of Extremadura."}, "cross_references": []}, {"canonical_name": "Callao", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 18, "members": [{"entity_id": "callao", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Callao", "category": "PLACE", "subcategory": "CITY", "count": 15, "variants": ["Callao", "Callao de Lima"], "contexts": ["port city near Lima", "port with hourly variations"]}, {"entity_id": "callao", "book_id": "kosmos_humboldt_1845", "name": "Callao", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Callao"], "contexts": ["port city experiencing earthquake"]}, {"entity_id": "caliaode_lima", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Caliaode Lima", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Caliaode Lima"], "contexts": ["part of a voyage route"]}, {"entity_id": "callao_de_lima", "book_id": "kosmos_humboldt_1845", "name": "Callao de Lima", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Callao de Lima"], "contexts": ["harbor in Peru"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Callao", "target_book": "kosmos_humboldt_1845", "target_name": "Callao", "similarity": 1.0}], "id": 1845, "stable_key": "clu_cee5743ebc5c4122", "ground_truth": {"modern_name": "Callao", "confidence": "high", "type": "place", "country": "Peru", "wikidata_id": "Q105037", "wikidata_description": "city ​​and main seaport of Peru", "wikipedia_url": "https://en.wikipedia.org/wiki/Callao", "wikipedia_extract": "Callao (Spanish pronunciation: [kaˈʝa.o]) is a seaside city and constitutional province in Peru. Located next to the Pacific Ocean, it forms part of the Lima metropolitan area alongside Lima province. Its autonomous status dates back to 1836, when it was declared a Littoral Province of the Peru–Bolivian Confederation, after which it was declared a Constitutional Province by the government of Ramón Castilla in 1857. Callao is Peru's chief seaport and home to its main airport, Jorge Chávez International Airport. Founded in 1537 by the Spaniards, the city has a long naval history as one of the main ports in Spanish America and the Pacific, having been a vital Spanish town of the Viceroyalty of Peru. Central Callao is about 15 km (9.3 mi) west of the Historic Centre of Lima."}, "member_count": 4, "cross_references": [{"found_name": "Andes", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 207, "target_cluster_name": "Andes", "source_book": "llm_generated", "evidence_snippet": "Callao is a port city in Peru, and the Andes mountains run through Peru, significantly influencing its geography and history.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Callao is a port city in Peru, and the Andes mountains run through Peru, significantly influencing its geography and history."}, {"found_name": "Arica", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2384, "target_cluster_name": "Arica", "source_book": "llm_generated", "evidence_snippet": "Arica is a port city in Chile, historically significant in the region and often discussed in relation to other South American ports like Callao.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Arica is a port city in Chile, historically significant in the region and often discussed in relation to other South American ports like Callao."}, {"found_name": "Equatorial America", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1437, "target_cluster_name": "equatorial America", "source_book": "llm_generated", "evidence_snippet": "Callao is located in Peru, which falls within the broader geographical region of Equatorial America.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Callao is located in Peru, which falls within the broader geographical region of Equatorial America."}, {"found_name": "South America", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 63, "target_cluster_name": "South America", "source_book": "llm_generated", "evidence_snippet": "Callao is a major port city in Peru, which is part of the continent of South America.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Callao is a major port city in Peru, which is part of the continent of South America."}, {"found_name": "Payta", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1982, "target_cluster_name": "Payta", "source_book": "llm_generated", "evidence_snippet": "Paita is a leading seaport in Peru, and Callao is another major port city in Peru.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Paita is a leading seaport in Peru, and Callao is another major port city in Peru.", "is_reverse": true}]}, {"canonical_name": "Calcaire de transition", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "calcaire_de_transition", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Calcaire de transition", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 15, "variants": ["Calcaire de transition", "Schiste de transition", "calcaire de transition", "granités de transition", "roches de transition", "schiste de transition", "schistes de transition", "terrain de transition"], "contexts": ["type of rock", "type of limestone"]}, {"entity_id": "transition_limestone", "book_id": "kosmos_humboldt_1845", "name": "transition limestone", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["transition limestone"], "contexts": ["geological formation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Calcaire de transition", "target_book": "kosmos_humboldt_1845", "target_name": "transition limestone", "similarity": 0.914}], "id": 1846, "stable_key": "clu_b8c16b7be06ca2ab", "ground_truth": {"modern_name": "Transition limestone", "confidence": "medium", "type": "mineral", "note": "An older geological term likely referring to rocks of the Silurian and Devonian periods. 'Calcaire de transition' is French for transition limestone.", "wikipedia_extract": "The Midyat Limestone is located in the Midyat Group dominates the surface geology of the anticlinal structures of the Mardin High of southeastern Turkey. This Eocene aged light yellowish marly chalk was formed in a marine depositional environment near the continental shelf. Fossils such as echinoids and nummulites can be seen in the different sections of this limestone formation which can have a thickness between 300 and 400 meters. In the few areas that have exposed Cretaceous rocks, there is a transitional layer known as the Gercus, which separates the younger Eocene limestone. This transitional layer consists of  red sandy gypsum bearing beds interbedded with marl and limestone. Exposed areas of the older Cretaceous Germav Formation can be seen in small areas of the Mardin High.", "wikipedia_url": "https://en.wikipedia.org/wiki/Midyat_Limestone"}, "cross_references": [{"found_name": "Limestone", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 259, "target_cluster_name": "Calcaire", "source_book": "llm_generated", "evidence_snippet": "Transition limestone is a specific type of limestone.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Transition limestone is a specific type of limestone."}, {"found_name": "Calcareous formations", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1162, "target_cluster_name": "formations calcaires", "source_book": "llm_generated", "evidence_snippet": "Transition limestone is a type of calcareous formation.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Transition limestone is a type of calcareous formation."}, {"found_name": "Fossiliferous strata", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 913, "target_cluster_name": "fossiliferous strata", "source_book": "llm_generated", "evidence_snippet": "The description mentions fossils found within the Midyat Limestone, indicating it is a fossiliferous stratum.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The description mentions fossils found within the Midyat Limestone, indicating it is a fossiliferous stratum."}, {"found_name": "muschelkalk", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1936, "target_cluster_name": "muschelkalk", "source_book": "llm_generated", "evidence_snippet": "Muschelkalk is a geological period and rock formation, and Transition limestone is another geological period and rock formation from a similar geological era.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Muschelkalk is a geological period and rock formation, and Transition limestone is another geological period and rock formation from a similar geological era.", "is_reverse": true}, {"found_name": "Jura limestone", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1987, "target_cluster_name": "Jura limestone", "source_book": "llm_generated", "evidence_snippet": "Jura limestone is often associated with or considered a type of transition limestone in geological contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Jura limestone is often associated with or considered a type of transition limestone in geological contexts.", "is_reverse": true}, {"found_name": "transition formation", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2774, "target_cluster_name": "transition formation", "source_book": "ll