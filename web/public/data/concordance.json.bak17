hison", "book_id": "origin_of_species_darwin_1859", "name": "Murchison", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Murchison"], "contexts": ["great geologist", "geologist who gave up catastrophe theory"]}, {"entity_id": "murchison", "book_id": "kosmos_humboldt_1845", "name": "Murchison", "category": "PERSON", "subcategory": "SCHOLAR", "count": 6, "variants": ["Murchison"], "contexts": ["author of 'The Silurian System'", "author of 'Silurian System'"]}, {"entity_id": "sir_r__murchison", "book_id": "origin_of_species_darwin_1859", "name": "Sir R. Murchison", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Sir R. Murchison"], "contexts": ["author of work on Russia", "eminent geologist"]}, {"entity_id": "sir_roderick_murchison", "book_id": "kosmos_humboldt_1845", "name": "Sir Roderick Murchison", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Sir Roderick Murchison"], "contexts": ["observer on the bounds of Asia"]}, {"entity_id": "murchison,_sir_r_", "book_id": "kosmos_humboldt_1845", "name": "Murchison, Sir R.", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Murchison, Sir R."], "contexts": ["described melaphyre ejection and strata"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Murchison", "target_book": "kosmos_humboldt_1845", "target_name": "Murchison", "similarity": 1.0}], "id": 2183, "stable_key": "clu_fd900de46cc53b79", "ground_truth": {"modern_name": "Roderick Impey Murchison", "confidence": "high", "type": "person", "birth_year": 1792, "death_year": 1871, "description": "British geologist, known for work on Silurian system.", "wikidata_id": "Q361900", "wikidata_description": "British geologist (1792-1871)", "wikipedia_url": "https://en.wikipedia.org/wiki/Roderick%20Murchison", "wikipedia_extract": "Sir Roderick Impey Murchison, 1st Baronet (19 February 1792 – 22 October 1871) was a Scottish geologist who served as director-general of the British Geological Survey from 1855 until his death in 1871. He is noted for investigating and describing the Silurian, Devonian and Permian systems. Murchison was born at Tarradale House, Muir of Ord, Ross-shire, the son of Barbara and Kenneth Murchison. His wealthy father died in 1796, when Roderick was four years old, and he was sent to Durham School three years later and then to the Royal Military College, Great Marlow, to be trained for the army. In 1808, under Wellesley, he landed in Portugal, and was present at the actions of Roliça and Vimeiro in the Peninsular War as an ensign in the 36th Regt of Foot. Subsequently, under Sir John Moore, he took part in the retreat to Corunna and the final battle there."}, "member_count": 5, "cross_references": [{"found_name": "Charles Lyell", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1710, "target_cluster_name": "Lyell", "source_book": "llm_generated", "evidence_snippet": "Both were prominent geologists in the 19th century, and Lyell's work on stratigraphy and uniformitarianism was foundational to the geological periodization Murchison contributed to.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were prominent geologists in the 19th century, and Lyell's work on stratigraphy and uniformitarianism was foundational to the geological periodization Murchison contributed to."}, {"found_name": "Geologists", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 956, "target_cluster_name": "geologists", "source_book": "llm_generated", "evidence_snippet": "Murchison was a leading figure in the field of geology, and this entry represents the broader professional category he belonged to.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Murchison was a leading figure in the field of geology, and this entry represents the broader professional category he belonged to."}, {"found_name": "Mr. Lyell", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3139, "target_cluster_name": "Mr. Lyell", "source_book": "llm_generated", "evidence_snippet": "Roderick Impey Murchison was a prominent geologist and contemporary of Charles Lyell. They were colleagues and sometimes rivals in the geological community, both contributing significantly to the understanding of geological strata and time scales.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Roderick Impey Murchison was a prominent geologist and contemporary of Charles Lyell. They were colleagues and sometimes rivals in the geological community, both contributing significantly to the understanding of geological strata and time scales.", "is_reverse": true}]}, {"canonical_name": "Leguminosa", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "leguminosæ", "book_id": "origin_of_species_darwin_1859", "name": "Leguminosæ", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Leguminosæ"], "contexts": ["plant family with glands at stipule base", "plant family with manipulation difficulties"]}, {"entity_id": "leguminosa", "book_id": "coloquios_da_orta_1563", "name": "Leguminosa", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["Leguminosa", "Leguminosae", "Leguminosas", "Leguminosce", "Leguminosie", "Leguminosé", "leguminosa"], "contexts": ["seed of a leguminous plant", "Family of plants"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Leguminosæ", "target_book": "coloquios_da_orta_1563", "target_name": "Leguminosa", "similarity": 0.98}], "id": 2184, "stable_key": "clu_ea9e79dde45933b1", "ground_truth": {"modern_name": "Fabaceae", "confidence": "high", "type": "plant", "family": "Fabaceae", "description": "A large and economically important family of flowering plants.", "note": "Also known as Leguminosae.", "wikipedia_extract": "Fabaceae or Leguminosae, commonly known as the legume, pea, or bean family, is a large and agriculturally important family of flowering plants. It includes trees, shrubs, and perennial or annual herbaceous plants, which are easily recognized by their fruit (legume) and their compound, stipulate leaves. The family is widely distributed, and is the third-largest land plant family in number of species, behind only the Orchidaceae and Asteraceae, with about 765 genera and nearly 20,000 known species. The five largest genera of the family are Astragalus (over 3,000 species), Acacia (over 1,000 species), Indigofera (around 700 species), Crotalaria (around 700 species), and Mimosa (around 400 species), which constitute about a quarter of all legume species. The c. 19,000 known legume species amount to about 7% of flowering plant species. Fabaceae is the most common family found in tropical rainforests and dry forests of the Americas and Africa."}, "cross_references": [{"found_name": "Peas", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2708, "target_cluster_name": "Peas", "source_book": "llm_generated", "evidence_snippet": "Peas are members of the Fabaceae family (also known as Leguminosa), which is characterized by plants that produce pods containing seeds.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Peas are members of the Fabaceae family (also known as Leguminosa), which is characterized by plants that produce pods containing seeds.", "is_reverse": true}, {"found_name": "Acacia", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 153, "target_cluster_name": "Acacia", "source_book": "llm_generated", "evidence_snippet": "Acacia is a genus within the pea family, Fabaceae.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Acacia is a genus within the pea family, Fabaceae.", "is_reverse": true}, {"found_name": "Tamarindos", "link_type": "concep