ldt_1845", "source_name": "navigation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Navigation", "similarity": 0.969}], "id": 1158, "stable_key": "clu_7965e94587f4a5ae", "ground_truth": {"modern_name": "navigation", "confidence": "high", "type": "concept", "wikidata_id": "Q102066", "wikidata_description": "process of monitoring and directing the movement of a person, craft or vehicle from one place to another", "wikipedia_url": "https://en.wikipedia.org/wiki/Navigation", "wikipedia_extract": "Navigation is a field of study that focuses on the process of monitoring and controlling the movement of a craft or vehicle from one place to another. The field of navigation includes four general categories: land navigation, marine navigation, aeronautic navigation, and space navigation. It is also the term of art used for the specialized knowledge used by navigators to perform navigation tasks. All navigational techniques involve locating the navigator's position compared to known locations or patterns. Navigation, in a broader sense, can refer to any skill or study that involves the determination of position and direction. In this sense, navigation includes orienteering and pedestrian navigation."}, "cross_references": [{"found_name": "Astronomy", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 276, "target_cluster_name": "astronomy", "source_book": "llm_generated", "evidence_snippet": "Astronomy is fundamental to celestial navigation, providing the understanding of celestial bodies and their movements.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Astronomy is fundamental to celestial navigation, providing the understanding of celestial bodies and their movements."}, {"found_name": "Calculation", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1380, "target_cluster_name": "calculation", "source_book": "llm_generated", "evidence_snippet": "Navigation heav