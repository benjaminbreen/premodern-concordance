d_truth": {"modern_name": "shrubs", "confidence": "high", "type": "plant", "wikidata_id": "Q1096635", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Lantana", "wikipedia_extract": "Lantana () is a genus of about 150 species of perennial flowering plants in the verbena family, Verbenaceae. They are native to tropical regions of the Americas and Africa but exist as an introduced species in numerous areas, especially in the Australian-Pacific region, South and Northeastern part of India. The genus includes both herbaceous plants and shrubs growing to 0.5–2 m (1.6–6.6 ft) tall. Their common names are shrub verbenas or lantanas. The generic name originated in Late Latin, where it refers to the unrelated Viburnum lantana. Lantana's aromatic flower clusters (called umbels) are a mix of red, orange, yellow, or blue and white florets."}, "cross_references": [{"found_name": "Cistus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4305, "target_cluster_name": "cistus", "source_book": "llm_generated", "evidence_snippet": "Both Cistus and Lantana are genera within the order Lamiales, and are often found in similar Mediterranean or warm temperate climates. Historically, they might have been grouped or compared due to their shrubby habit and flowering characteristics.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both Cistus and Lantana are genera within the order Lamiales, and are often found in similar Mediterranean or warm temperate climates. Historically, they might have been grouped or compared due to their shrubby habit and flowering characteristics."}, {"found_name": "Gorse", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3861, "target_cluster_name": "Furz", "source_book": "llm_generated", "evidence_snippet": "Both Gorse and Lantana are known for their shrubby, often dense growth habit and their ability to thrive in challenging or disturbed environments. They can be considered related in terms of their ecological niche and general appearance as hardy shrubs.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both Gorse and Lantana are known for their shrubby, often dense growth habit and their ability to thrive in challenging or disturbed environments. They can be considered related in terms of their ecological niche and general appearance as hardy shrubs."}, {"found_name": "Chamaerops", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4039, "target_cluster_name": "Chamaerops", "source_book": "llm_generated", "evidence_snippet": "While Chamaerops is a genus of palms, and Lantana is a genus of flowering shrubs, both are tropical/subtropical plants and might be discussed together in contexts comparing different types of woody or flowering vegetation from warm regions. Chamaerops represents a different form of woody plant from similar geographical origins.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "While Chamaerops is a genus of palms, and Lantana is a genus of flowering shrubs, both are tropical/subtropical plants and might be discussed together in contexts comparing different types of woody or flowering vegetation from warm regions. Chamaerops represents a different form of woody plant from similar geographical origins."}, {"found_name": "tropical plants", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2853, "target_cluster_name": "tropical plants", "source_book": "llm_generated", "evidence_snippet": "Lantana is explicitly stated to be native to tropical regions of the Americas and Africa, making 'tropical plants' a relevant broader category that encompasses Lantana.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Lantana is explicitly stated to be native to tropical regions of the Americas and Africa, making 'tropical plants' a relevant broader category that encompasses Lantana."}, {"found_name": "café", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 642, "target_cluster_name": "café", "source_book": "llm_generated", "evidence_snippet": "Coffee plants are botanically classified as shrubs or small trees.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Coffee plants are botanically classified as shrubs or small trees.", "is_reverse": true}, {"found_name": "Branches", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 806, "target_cluster_name": "Branches", "source_book": "llm_generated", "evidence_snippet": "Shrubs have branches, similar to trees but typically smaller.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Shrubs have branches, similar to trees but typically smaller.", "is_reverse": true}, {"found_name": "Willow", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1059, "target_cluster_name": "Willow", "source_book": "llm_generated", "evidence_snippet": "Willow is a type of shrub, and 'Shrubs' is a broader category encompassing it.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Willow is a type of shrub, and 'Shrubs' is a broader category encompassing it.", "is_reverse": true}, {"found_name": "herbaceous Plant", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1217, "target_cluster_name": "herbaceous Plant", "source_book": "llm_generated", "evidence_snippet": "Herbaceous plants are distinguished from shrubs by their lack of persistent woody stems above ground.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Herbaceous plants are distinguished from shrubs by their lack of persistent woody stems above ground.", "is_reverse": true}]}, {"canonical_name": "Buffon", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 6, "members": [{"entity_id"