t_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "Turquia, e Pérsia. RUANO E se esta mezinha he da índia, como se chama nestas partes? ORTA A gente, onde a ha, a chama sacarmambum, que quer dizer, açucare de mambum, porque áquellas canas daquella arv", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "alternative name for sugar source"}, {"found_name": "achar", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "muyto estítíca, e os fisicos Guzarates usam desta fruta, sendo dles novos e tenros, em conserva de vinagre (a que elies chamam achar) e em conserva de açucare, como nós usamos; e sempre aquelle sabor ", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for preserved fruit in vinegar"}, {"found_name": "palhade Meca", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "polyanthea_medicinal", "evidence_snippet": "onças ,faça-ſe em cellada muyto miuda , & em hum gral de pedra ſepize tanto tempo , atè que fique como mafia, & então lhe ajuntem trinta ,& ſeis onças de aſſucar fino , duas onças de pò de eſquinanto ", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for esquintam"}]}, {"canonical_name": "Turbit", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 4, "total_mentions": 45, "members": [{"entity_id": "turbith", "book_id": "english_physician_1652", "name": "Turbith", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Turbith"], "contexts": ["used for phlegm"]}, {"entity_id": "turbit", "book_id": "coloquios_da_orta_1563", "name": "Turbit", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 31, "variants": ["Turbit", "turbit", "turbith"], "contexts": ["plant substance", "a purgative root"]}, {"entity_id"