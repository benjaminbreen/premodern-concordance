], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Voltaic electricity", "target_book": "first_principles_spencer_1862", "target_name": "voltaic electricity", "similarity": 0.98}], "id": 1694, "stable_key": "clu_03d0c906a62af598", "ground_truth": {"modern_name": "Voltaic electricity", "confidence": "high", "type": "concept", "wikidata_id": "Q114262127", "wikidata_description": "current of electricity generated by chemical action between metals and different liquids as arranged in a voltaic battery"}, "cross_references": [{"found_name": "Galvanic electricity", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2342, "target_cluster_name": "galvanic electricity", "source_book": "llm_generated", "evidence_snippet": "Voltaic electricity is a specific type of galvanic electricity, generated by voltaic piles.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Voltaic electricity is a specific type of galvanic electricity, generated by voltaic piles."}]}, {"canonical_name": "Arroz", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 26, "members": [{"entity_id": "aroz", "book_id": "coloquios_da_orta_1563", "name": "aroz", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["aroz"], "contexts": ["used for cleaning pearls", "grain eaten in Balagate"]}, {"entity_id": "arroz", "book_id": "polyanthea_medicinal", "name": "Arroz", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 16, "variants": ["Arroz", "arroz"], "contexts": ["rice, an ingredient", "grain used as food"]}, {"entity_id": "arroz", "book_id": "coloquios_da_orta_1563", "name": "arroz", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["arroz"], "contexts": ["commodity transported", "ingredient in medicine"]}, {"entity_id": "arroztorrado", "book_id": "polyanthea_medicinal", "name": "arroztorrado", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["arroztorrado"], "contexts": ["toasted rice"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "aroz", "target_book": "polyanthea_medicinal", "target_name": "Arroz", "similarity": 0.96}, {"source_book": "coloquios_da_orta_1563", "source_name": "arroz", "target_book": "polyanthea_medicinal", "target_name": "arroztorrado", "similarity": 0.909}], "id": 1695, "stable_key": "clu_10ada8ed1aacd6f4", "ground_truth": {"modern_name": "Rice", "confidence": "high", "type": "plant", "linnaean": "Oryza sativa", "family": "Poaceae", "description": "A staple cereal grain, widely cultivated and consumed globally.", "wikipedia_extract": "Oryza sativa, having the common name Asian cultivated rice, is the much more common of the two rice species cultivated as a cereal, the other species being O. glaberrima, African rice. It was first domesticated in the Yangtze River basin in China 13,500 to 8,200 years ago. Oryza sativa belongs to the genus Oryza and the BOP clade in the grass family Poaceae. With a genome consisting of 430 Mbp across 12 chromosomes, it is renowned for being easy to genetically modify and is a model organism for the study of the biology of cereals and monocots. O. sativa has an erect stalk stem that grows 80–120 cm (30–45 in) tall, with a smooth surface. The leaf is lanceolate, 15–30 cm (5+7⁄8–11+3⁄4 in) long, and grows from a ligule 10–20 mm (3⁄8–3⁄4 in) long."}, "cross_references": [{"found_name": "Corn", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 426, "target_cluster_name": "Corn", "source_book": "llm_generated", "evidence_snippet": "Rice and corn are both staple cereal grains, frequently compared and contrasted in historical texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Rice and corn are both staple cereal grains, frequently compared and contrasted in historical texts.", "is_reverse": true}, {"found_name": "Cevada", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1570, "target_cluster_name": "Cevada", "source_book": "llm_generated", "evidence_snippet": "Barley, wheat, and rice are all staple cereal grains.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Barley, wheat, and rice are all staple cereal grains.", "is_reverse": true}, {"found_name": "trigo", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1828, "target_cluster_name": "trigo", "source_book": "llm_generated", "evidence_snippet": "Rice is a major cereal grain, and like wheat, it has been a staple food for large populations throughout history, leading to its frequent mention in similar contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Rice is a major cereal grain, and like wheat, it has been a staple food for large populations throughout history, leading to its frequent mention in similar contexts.", "is_reverse": true}, {"found_name": "pulai", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "necessário que de novo me deis licença pêra isto. ORTA Vós a tendes já, escusado he pedila de novo, porque an- tes me fozeis grande mercê nisso. DIMAS Do arroz que comemos, vos quero dizer que vem de ", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of rice"}]}, {"canonical_name": "herbe", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 25, "members": [{"entity_id": "green_herb", "book_id": "english_physician_1652", "name": "green Herb", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["green Herb"], "contexts": ["form of herb for application", "fresh Thoroughwax plant"]}, {"entity_id": "herbe", "book_id": "ricettario_fiorentino_1597", "name": "herbe", "category": "PLANT", "subcategory": "OT