e": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4027, "target_cluster_name": "economy", "source_book": "llm_generated", "evidence_snippet": "Government plays a significant role in managing and regulating the economy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Government plays a significant role in managing and regulating the economy."}, {"found_name": "General laws", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3235, "target_cluster_name": "Laws in general", "source_book": "llm_generated", "evidence_snippet": "Government is responsible for creating and enforcing general laws that apply to its citizens.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Government is responsible for creating and enforcing general laws that apply to its citizens."}]}, {"canonical_name": "Errors", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "errors", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Errors", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 5, "variants": ["errors", "Errors"], "contexts": ["mistakes or incorrect beliefs", "mistakes in reasoning or computation"]}, {"entity_id": "errors", "book_id": "principles_of_psychology_james_1890", "name": "errors", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["errors"], "contexts": ["mistakes in judgment or perception"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Errors", "target_book": "principles_of_psychology_james_1890", "target_name": "errors", "similarity": 0.992}], "id": 2490, "stable_key": "clu_55acdfece1a1d52f", "ground_truth": {"wikipedia_extract": "An error (from the Latin errāre, meaning 'to wander') is an inaccurate or incorrect action, thought, or judgement. In statistics, \"error\" refers to the difference between the value which has been computed and the correct value. An error could result in failure or in a deviation from the intended performance or behavior. One reference differentiates between \"error\" and \"mistake\" as follows: An 'error' is a deviation from accuracy or correctness. A 'mistake' is an error caused by a fault: the fault being misjudgment, carelessness, or forgetfulness. Now, say that I run a stop sign because I was in a hurry, and wasn't concentrating, and the police stop me, that is a mistake."}, "cross_references": [{"found_name": "deformities", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2096, "target_cluster_name": "deformities", "source_book": "llm_generated", "evidence_snippet": "Congenital malformations can be viewed as errors in development.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Congenital malformations can be viewed as errors in development.", "is_reverse": true}]}, {"canonical_name": "Ctesias", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "ctesias", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Ctesias", "category": "PERSON", "subcategory": "AUTHORITY", "count": 5, "variants": ["Ctesias"], "contexts": ["physician and historian", "ancient writer of fabulous relations"]}, {"entity_id": "ctesias", "book_id": "kosmos_humboldt_1845", "name": "Ctesias", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Ctesias"], "contexts": ["ancient Greek physician and historian"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ctesias", "target_book": "kosmos_humboldt_1845", "target_name": "Ctesias", "similarity": 1.0}], "id": 2491, "stable_key": "clu_c250e6e7561301a0", "ground_truth": {"modern_name": "Ctesias", "confidence": "high", "type": "person", "description": "Ancient Greek physician and historian, author of Indica.", "wikidata_id": "Q5191748", "wikidata_description": "g