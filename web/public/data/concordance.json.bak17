: ["Météorologie", "météorologie"], "contexts": ["work from which observations were borrowed", "study of weather and climate"]}, {"entity_id": "meteorologie", "book_id": "kosmos_humboldt_1845", "name": "Meteorologie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Meteorologie"], "contexts": ["publication by Martins", "book title"]}, {"entity_id": "meteors", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Meteors", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Meteors"], "contexts": ["Aristotle's work on natural phenomena", "atmospheric phenomena"]}, {"entity_id": "meteor_", "book_id": "kosmos_humboldt_1845", "name": "Meteor.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["Meteor."], "contexts": ["Aristotle's work on meteorology", "meteorological publication"]}, {"entity_id": "meteorology", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Meteorology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Meteorology"], "contexts": ["study of weather phenomena"]}, {"entity_id": "meteorology", "book_id": "kosmos_humboldt_1845", "name": "Meteorology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["Meteorology", "meteorology"], "contexts": ["study of atmospheric phenomena", "science dealing with the atmosphere"]}, {"entity_id": "meteorological", "book_id": "kosmos_humboldt_1845", "name": "meteorological", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["meteorological"], "contexts": ["relating to weather phenomena"]}, {"entity_id": "meteorologic", "book_id": "first_principles_spencer_1862", "name": "meteorologic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["meteorologic"], "contexts": ["relating to weather", "relating to weather phenomena"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Météorologie", "target_book": "kosmos_humboldt_1845", "target_name": "Meteorologie", "similarity": 0.935}], "id": 1868, "stable_key": "clu_c2a0c6792a67a116", "ground_truth": {"modern_name": "Meteorology", "confidence": "high", "type": "concept", "wikidata_id": "Q25261", "wikidata_description": "branch of science dealing with the study of atmospheric phenomena and the short term variation of weather conditions including wind, precipitation, temperature, humidity, cloud cover, and air pressure", "wikipedia_url": "https://en.wikipedia.org/wiki/Meteorology", "note": "Refers to Aristotle's work on atmospheric phenomena.", "wikipedia_extract": "Meteorology is the scientific study of the Earth's atmosphere and short-term atmospheric phenomena (i.e., weather), with a focus on weather forecasting. It has applications in the military, aviation, energy production, transport, agriculture, construction, weather warnings, and disaster management. Along with climatology, atmospheric physics, atmospheric chemistry, and aeronomy, meteorology forms the broader field of the atmospheric sciences. The interactions between Earth's atmosphere and its oceans (notably El Niño and La Niña) are studied in the interdisciplinary field of hydrometeorology. Other interdisciplinary areas include biometeorology, space weather, and planetary meteorology. Marine weather forecasting relates meteorology to maritime and coastal safety, based on atmospheric interactions with large bodies of water."}, "member_count": 8, "cross_references": [{"found_name": "Atmospheric", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4409, "target_cluster_name": "atmospheric", "source_book": "llm_generated", "evidence_snippet": "Meteorology is the study of the atmosphere, making 'Atmospheric' a directly related adjective.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Meteorology is the study of the atmosphere, making 'Atmospheric' a directly related adjective."}, {"found_name": "Atmospheric currents", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1184, "target_cluster_name": "atmospheric currents", "source_book": "llm_generated", "evidence_snippet": "Atmospheric currents are a key component studied within meteorology.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Atmospheric currents are a key component studied within meteorology."}, {"found_name": "Atmospheric electricity", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3166, "target_cluster_name": "atmospheric electricity", "source_book": "llm_generated", "evidence_snippet": "Atmospheric electricity is a phenomenon studied in meteorology.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Atmospheric electricity is a phenomenon studied in meteorology."}, {"found_name": "Climate", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 613, "target_cluster_name": "climate", "source_book": "llm_generated", "evidence_snippet": "Climate is a long-term pattern of weather, a core concept within meteorology.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Climate is a long-term pattern of weather, a core concept within meteorology."}, {"found_name": "Climatology", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2199, "target_cluster_name": "Climatologie", "source_book": "llm_generated", "evidence_snippet": "Climatology is a sub-discipline of meteorology focused on climate.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Climatology is a sub-discipline of meteorology focused on climate."}, {"found_name": "Dew point", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3137, "target_cluster_name": "dew point", "source_book": "llm_generated", "evidence_snippet": "Dew point is a specific measurement and concept used in meteorology.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Dew point is a specific measurement and concept used in meteorology."}, {"found_name": "Evaporation", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2390, "target_cluster_name": "évaporation", "source_book": "llm_generated", "evidence_snippet": "Evaporation is a key process in the water cycle and atmospheric phenomena studied in meteorology.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Evaporation is a key process in the water cycle and atmospheric phenomena studied in meteorology."}, {"found_name": "Climatologie", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2199, "target_cluster_name": "Climatologie", "source_book": "llm_generated", "evidence_snippet": "Climatology is closely related to Meteorology, often considered a sub-discipline or a related field focusing on long-term weather patterns rather than short-term phenomena.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Climatology is closely related to Meteorology, often considered a sub-discipline or a related field focusing on long-term weather patterns rather than short-term phenomena.", "is_reverse": true}, {"found_name": "lunar eclipses", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2293, "target_cluster_name": "lunar eclipses", "source_book": "llm_generated", "evidence_snippet": "Both meteors and lunar eclipses are observable celestial phenomena, though mechanistically distinct.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both meteors and lunar eclipses are observable celestial phenomena, though mechanistically distinct.", "is_reverse": true}]}, {"canonical_name": "Sweden", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "suède", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Suède", "category": "PLACE", "subcategory": "COUNTRY", "count": 7, "variants": ["Suède"], "contexts": ["country", "country with population data"]}, {"entity_id": "sweden", "book_id": "kosmos_humboldt_1845", "name": "Sweden", "category": "PLACE", "subcategory": "COUNTRY", "count": 8, "variants": ["Sweden"], "contexts": ["country where instruments were distributed", "coast where earthquake was felt"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Suède", "target_book": "kosmos_humboldt_1845", "target_name": "Sweden", "similarity": 0.931}], "id": 1869, "stable_key": "clu_bc61cbe1070abd90", "ground_truth": {"modern_name": "Sweden", "confidence": "high", "type": "place", "country": "Sweden", "note": "'Suède' is the French name for Sweden.", "wikidata_id": "Q34", "wikidata_description": "country in Northern Europe", "wikipedia_extract": "Sweden, formally the Kingdom of Sweden, is a Nordic country located on the Scandinavian Peninsula in Northern Europe. It borders Norway to the west and north, and Finland to the east. At 450,295 square kilometres (173,860 sq mi), Sweden is the largest Nordic country by both area and population, and is the fifth-largest country in Europe. Its capital and largest city is Stockholm. Sweden has a population of 10.6 million, and a low population density of 25.5 inhabitants per square kilometre (66/sq mi); 88% of Swedes reside in urban areas. They are mostly in the central and southern half of the country.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sweden"}, "cross_references": [{"found_name": "Scandinave", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 810, "target_cluster_name": "Scandinave", "source_book": "llm_generated", "evidence_snippet": "Sweden is a core constituent country of Scandinavia.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Sweden is a core constituent country of Scandinavia.", "is_reverse": true}]}, {"canonical_name": "porco", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 7, "total_mentions": 29, "members": [{"entity_id": "porco", "book_id": "ricettario_fiorentino_1597", "name": "porco", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["porco"], "contexts": ["fresh pig fat used in ointment"]}, {"entity_id": "porco", "book_id": "polyanthea_medicinal", "name": "porco", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 14, "variants": ["porco", "Porco Efpim", "porco Eſpim", "porco varraó", "porcoEspim"], "contexts": ["animal meat", "animal used in a remedy for drowsiness"]}, {"entity_id": "porcos", "book_id": "coloquios_da_orta_1563", "name": "porcos", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 4, "variants": ["Porcos", "porcos"], "contexts": ["animals found in abundance", "pigs found in large quantities"]}, {"entity_id": "porçovejos", "book_id": "polyanthea_medicinal", "name": "porçovejos", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["porçovejos", "porçocozido"], "contexts": ["fumes inhaled for treatment", "animal product used in remedies"]}, {"entity_id": "swine", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Swine", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Swine"], "contexts": ["animals that terrify elephants"]}, {"entity_id": "swine", "book_id": "english_physician_1652", "name": "Swine", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Swine"], "contexts": ["animal fattened by Beech", "animals fattened in various places"]}, {"entity_id": "swine", "book_id": "kosmos_humboldt_1845", "name": "swine", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["swine"], "contexts": ["domesticated pig animals"]}, {"entity_id": "boar", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Boar", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Boar"], "contexts": ["animal absent in Africa"]}, {"entity_id": "boar", "book_id": "origin_of_species_darwin_1859", "name": "boar", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["boar"], "contexts": ["example of sexual selection for defense", "animal with shoulder-pads"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "porco", "target_book": "polyanthea_medicinal", "target_name": "porco", "similarity": 0.864}], "id": 1870, "stable_key": "clu_f82a06ab386a71f2", "ground_truth": {"modern_name": "Pigs", "confidence": "medium", "type": "animal", "note": "The term 'porcos' is clearly pigs. 'Porpoces' could refer to porpoises, and 'porçovejos' is unclear but potentially a misspelling or regional term. However, the context of gall presence for medicinal use often involved domestic animals like pigs.", "wikidata_id": "Q58697", "wikidata_description": "omnivore species of mammal", "wikipedia_url": "https://en.wikipedia.org/wiki/Wild%20boar", "wikipedia_extract": "The wild boar (Sus scrofa), also known as the wild swine, common wild pig, Eurasian wild pig, or simply wild pig, is a suid native to much of Eurasia and North Africa, and has been introduced to the Americas and Oceania. The species is now one of the widest-ranging mammals in the world, as well as the most widespread suiform. It has been assessed as least concern on the IUCN Red List due to its wide range, high numbers, and adaptability to a diversity of habitats. It has become an invasive species in part of its introduced range. Wild boars probably originated in Southeast Asia during the Early Pleistocene and outcompeted other suid species as they spread throughout the Old World. As of 2005, up to 16 subspecies are recognized, which are divided into four regional groupings based on skull height and lacrimal bone length."}, "member_count": 9, "cross_references": [{"found_name": "insects", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 4, "target_cluster_name": "insects", "source_book": "llm_generated", "evidence_snippet": "Portuguese for 'pig', a mammal, not an insect. This is an error in the candidate list.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "reverse: Portuguese for 'pig', a mammal, not an insect. This is an error in the candidate list.", "is_reverse": true}]}, {"canonical_name": "Gustav Rose", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "gustave_rose", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Gustave Rose", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Gustave Rose"], "contexts": ["researcher involved in barometric measurements"]}, {"entity_id": "gustav_rose", "book_id": "kosmos_humboldt_1845", "name": "Gustav Rose", "category": "PERSON", "subcategory": "SCHOLAR", "count": 14, "variants": ["Gustav Rose"], "contexts": ["companion on scientific journey", "author of travelogue"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Gustave Rose", "target_book": "kosmos_humboldt_1845", "target_name": "Gustav Rose", "similarity": 0.973}], "id": 1871, "stable_key": "clu_16d5115156ec058a", "ground_truth": {"modern_name": "Gustav Rose", "confidence": "high", "type": "person", "birth_year": 1794, "death_year": 1873, "description": "German mineralogist and geologist, associated with Humboldt.", "wikidata_id": "Q64561", "wikidata_description": "German mineralogist and university teacher (1798-1873)", "wikipedia_url": "https://en.wikipedia.org/wiki/Gustav%20Rose", "wikipedia_extract": "Prof Gustavus (\"Gustav\") Rose FRSFor HFRSE (18 March 1798 – 15 July 1873) was a German mineralogist who was a native of Berlin. He was President of the German Geological Society from 1863 to 1873. He was born in Berlin the son of pharmacologist Valentin Rose. Rose was a graduate of the University of Berlin, where he was a student of mineralogist Christian Samuel Weiss (1780–1856). He also studied under Swedish physical chemist Jöns Jakob Berzelius (1779–1848) in Stockholm. While studying with Berzelius, Rose met German chemist Eilhard Mitscherlich (1794–1863), with whom he maintained a lifelong friendship."}, "cross_references": []}, {"canonical_name": "movements", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "movements", "book_id": "principles_of_psychology_james_1890", "name": "movements", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 14, "variants": ["movements"], "contexts": ["actions of changing position", "physical actions or displacements"]}, {"entity_id": "movements", "book_id": "first_principles_spencer_1862", "name": "movements", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["movements"], "contexts": ["physical displacements"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "movements", "target_book": "first_principles_spencer_1862", "target_name": "movements", "similarity": 1.0}], "id": 1872, "stable_key": "clu_daf2c029e8953f9a", "ground_truth": {"modern_name": "Movement", "confidence": "high", "type": "concept", "wikidata_id": "Q49773", "wikidata_description": "loosely organized effort by a large group of people to achieve a particular set of goals"}, "cross_references": [{"found_name": "locomotion", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 463, "target_cluster_name": "locomotion", "source_book": "llm_generated", "evidence_snippet": "Locomotion is a specific form of movement, often implying self-propulsion or change of position.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Locomotion is a specific form of movement, often implying self-propulsion or change of position.", "is_reverse": true}, {"found_name": "Action and reaction", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 961, "target_cluster_name": "Action and reaction", "source_book": "llm_generated", "evidence_snippet": "Movement is a direct consequence of action and reaction.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Movement is a direct consequence of action and reaction."}, {"found_name": "Bodily action", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3565, "target_cluster_name": "bodily action", "source_book": "llm_generated", "evidence_snippet": "Bodily action is a specific type of movement.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Bodily action is a specific type of movement."}, {"found_name": "Conflict", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3582, "target_cluster_name": "conflict", "source_book": "llm_generated", "evidence_snippet": "Conflict often involves opposing movements.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Conflict often involves opposing movements."}, {"found_name": "Development", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 960, "target_cluster_name": "development", "source_book": "llm_generated", "evidence_snippet": "Development implies a series of movements or changes over time.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Development implies a series of movements or changes over time."}]}, {"canonical_name": "integration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "integration", "book_id": "principles_of_psychology_james_1890", "name": "integration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["integration"], "contexts": ["process of compounding units of feeling", "process of combining into a whole"]}, {"entity_id": "integration", "book_id": "first_principles_spencer_1862", "name": "integration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 11, "variants": ["integration"], "contexts": ["combining elements into a whole", "process of combining or uniting"]}, {"entity_id": "integrations", "book_id": "first_principles_spencer_1862", "name": "integrations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["integrations"], "contexts": ["fusion or unification of parts"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "integration", "target_book": "first_principles_spencer_1862", "target_name": "integration", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "integration", "target_book": "first_principles_spencer_1862", "target_name": "integrations", "similarity": 0.873}], "id": 1873, "stable_key": "clu_348a4ea4c7873acc", "ground_truth": {"modern_name": "Integration", "confidence": "high", "type": "concept", "wikidata_id": "Q10536146", "wikidata_description": "process of social integration of immigrants or immigrated persons", "wikipedia_url": "https://en.wikipedia.org/wiki/Integration%20of%20immigrants", "wikipedia_extract": "The integration of immigrants, or migrant integration, is primarily the process of socioeconomic integration of immigrants and their descendants into a society through emancipatory and collective care values of the host country. Secondarily, it involves the gradual access to equal opportunities with other residents in terms of community duties and political participation. Central aspects of socioeconomic integration include overcoming barriers related to language, education, labour market participation, and identification with social values and the host country. The topic covers both the individual affairs of immigrants in their everyday lives and the socio-cultural phenomena of the host society. Social discourse about the integration of immigrants has often not only been about immigrants themselves (first-generation migrants, \"foreigner integration\" in the narrower sense), but also about the integration of the future generation(s), who are usually already naturalized or born as citizens, the \"integration of people with a migration background\" or \"with an immigration history\". Special cases of group-specific integration include the integration of linguistic, cultural or ethnic minorities who immigrated a long time ago."}, "cross_references": [{"found_name": "Emigration", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3481, "target_cluster_name": "emigration", "source_book": "llm_generated", "evidence_snippet": "Emigration is the inverse process of immigration, and both are integral to the concept of migrant integration.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Emigration is the inverse process of immigration, and both are integral to the concept of migrant integration."}, {"found_name": "Immigration", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3345, "target_cluster_name": "immigration", "source_book": "llm_generated", "evidence_snippet": "Immigration is the precursor to migrant integration, as it is the act of people entering a new country.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Immigration is the precursor to migrant integration, as it is the act of people entering a new country."}, {"found_name": "Adaptation", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1294, "target_cluster_name": "adaptation", "source_book": "llm_generated", "evidence_snippet": "Adaptation is a key component of integration, as immigrants must adapt to the host society and the host society may adapt to immigrants.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Adaptation is a key component of integration, as immigrants must adapt to the host society and the host society may adapt to immigrants."}, {"found_name": "Civilization", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 756, "target_cluster_name": "civilisation", "source_book": "llm_generated", "evidence_snippet": "Integration is a process that occurs within and contributes to the development of a civilization.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Integration is a process that occurs within and contributes to the development of a civilization."}, {"found_name": "Education", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1064, "target_cluster_name": "education", "source_book": "llm_generated", "evidence_snippet": "Education is a crucial mechanism for the integration of immigrants into a society.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Education is a crucial mechanism for the integration of immigrants into a society."}, {"found_name": "timbre", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3519, "target_cluster_name": "timbre", "source_book": "principles_of_psychology_james_1890", "evidence_snippet": "with the chief series of recurrent noises. So that while the unlikenesses of feeling known as differences of pitch in tones are due to differences of integration among the recurrent noises of one seri", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of feeling difference related to integration"}]}, {"canonical_name": "prism", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "prism", "book_id": "principles_of_psychology_james_1890", "name": "prism", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["prism"], "contexts": ["optical instrument used in experiments", "optical device to alter light path"]}, {"entity_id": "prism", "book_id": "connexion_physical_sciences_somerville_1858", "name": "prism", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 11, "variants": ["prism"], "contexts": ["used for light decomposition", "optical instrument for dispersion"]}, {"entity_id": "prisms", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Prisms", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Prisms", "prisms"], "contexts": ["optical instruments for light dispersion", "optical instruments for spectrum analysis"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "prism", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "prism", "similarity": 0.831}, {"source_book": "principles_of_psychology_james_1890", "source_name": "prism", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Prisms", "similarity": 0.944}], "id": 1874, "stable_key": "clu_a2e677644afe063c", "ground_truth": {"modern_name": "Prism", "confidence": "high", "type": "object", "wikidata_id": "Q165896", "wikidata_description": "transparent optical element with flat, polished surfaces that refract light", "wikipedia_url": "https://en.wikipedia.org/wiki/Prism%20%28optics%29", "wikipedia_extract": "An optical prism is a transparent optical element with flat, polished surfaces that are designed to refract light. At least one surface must be angled—elements with only two parallel surfaces are windows, not prisms. The most familiar type of optical prism is the triangular prism, which has a triangular base and rectangular sides. Not all optical prisms are geometric prisms, and not all geometric prisms would count as an optical prism. Prisms can be made from any material that is transparent to the wavelengths for which they are designed. Typical materials include glass, acrylic and fluorite."}, "cross_references": [{"found_name": "Glass", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 22, "target_cluster_name": "Glass", "source_book": "llm_generated", "evidence_snippet": "Prisms are typically made of glass and are used for optical experiments.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Prisms are typically made of glass and are used for optical experiments.", "is_reverse": true}, {"found_name": "espelho", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1097, "target_cluster_name": "espelho", "source_book": "llm_generated", "evidence_snippet": "Both mirrors and prisms are optical components that interact with light, often used in conjunction in optical instruments.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both mirrors and prisms are optical components that interact with light, often used in conjunction in optical instruments.", "is_reverse": true}, {"found_name": "prismatic micrometer", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4309, "target_cluster_name": "prismatic micrometer", "source_book": "llm_generated", "evidence_snippet": "A prismatic micrometer is an instrument that utilizes a prism for measurement.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "A prismatic micrometer is an instrument that utilizes a prism for measurement."}, {"found_name": "Lens", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2485, "target_cluster_name": "lens", "source_book": "llm_generated", "evidence_snippet": "Both lenses and prisms are optical elements that manipulate light, often discussed together in optics.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both lenses and prisms are optical elements that manipulate light, often discussed together in optics."}, {"found_name": "Triangle", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1405, "target_cluster_name": "Triangle", "source_book": "llm_generated", "evidence_snippet": "The most common type of optical prism is a triangular prism, making the geometric shape closely related.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The most common type of optical prism is a triangular prism, making the geometric shape closely related."}]}, {"canonical_name": "yellow", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "yellow", "book_id": "principles_of_psychology_james_1890", "name": "yellow", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["yellow"], "contexts": ["color perceived from combined lights"]}, {"entity_id": "yellow", "book_id": "connexion_physical_sciences_somerville_1858", "name": "yellow", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 14, "variants": ["yellow"], "contexts": ["colour in the spectrum", "color reflected by yellow cloth"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "yellow", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "yellow", "similarity": 1.0}], "id": 1875, "stable_key": "clu_006fa2c6e40ba6aa", "ground_truth": {"modern_name": "Yellow", "confidence": "high", "type": "chemical", "note": "Refers to the color yellow, often discussed in optics and perception.", "wikidata_id": "Q1148004", "wikidata_description": "mosquito species, a vector for diseases including yellow fever and Zika fever"}, "cross_references": []}, {"canonical_name": "cranium", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "cranium", "book_id": "principles_of_psychology_james_1890", "name": "cranium", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["cranium"], "contexts": ["skull enclosing the brain"]}, {"entity_id": "cranium", "book_id": "polyanthea_medicinal", "name": "cranium", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 14, "variants": ["cranium", "Craneo", "cra