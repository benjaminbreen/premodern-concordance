exts": ["group of islands"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "archipelago", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Archipel", "similarity": 0.937}, {"source_book": "origin_of_species_darwin_1859", "source_name": "archipelago", "target_book": "kosmos_humboldt_1845", "target_name": "Archipelago", "similarity": 0.983}, {"source_book": "origin_of_species_darwin_1859", "source_name": "archipelago", "target_book": "coloquios_da_orta_1563", "target_name": "archipelago", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "archipelago", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "archipelago", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Archipel", "target_book": "kosmos_humboldt_1845", "target_name": "Archipelago", "similarity": 0.961}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Archipel", "target_book": "coloquios_da_orta_1563", "target_name": "archipelago", "similarity": 0.937}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Archipel", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "archipelago", "similarity": 0.937}, {"source_book": "kosmos_humboldt_1845", "source_name": "Archipelago", "target_book": "coloquios_da_orta_1563", "target_name": "archipelago", "similarity": 0.983}, {"source_book": "kosmos_humboldt_1845", "source_name": "Archipelago", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "archipelago", "similarity": 0.983}, {"source_book": "coloquios_da_orta_1563", "source_name": "archipelago", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "archipelago", "similarity": 1.0}], "id": 175, "stable_key": "clu_9c5245d83f6f2df7", "ground_truth": {"modern_name": "Archipelago", "confidence": "high", "type": "place", "wikidata_id": "Q33837", "wikidata_description": "collection of islands including the water around them; use island group (Q1402592) for a collection of islands excluding neighbouring water", "wikipedia_url": "https://en.wikipedia.org/wiki/Archipelago", "wikipedia_extract": "An archipelago (  AR-kə-PEL-ə-goh), sometimes called an island group or island chain, is a chain, cluster, or collection of islands. An archipelago may be in an ocean, a sea, or a smaller body of water. Examples of archipelagos include the Aegean Islands (the origin of the term), the Canadian Arctic Archipelago, the Stockholm Archipelago, the Malay Archipelago (which includes the Indonesian and Philippine Archipelagos), the Lucayan (Bahamian) Archipelago, the Japanese archipelago, and the Hawaiian Archipelago. The word archipelago is derived from the Italian arcipelago, used as a proper name for the Aegean Sea, itself perhaps a deformation of the Greek Αιγαίον Πέλαγος. Later, usage shifted to refer to the Aegean Islands (since the sea has a large number of islands). The erudite paretymology, deriving the word from Ancient Greek ἄρχι- (arkhi-, \"chief\") and πέλαγος (pélagos, \"sea\"), proposed by Buondelmonti, can still be found."}, "cross_references": [{"found_name": "Chonos Archipelago", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4070, "target_cluster_name": "archipel des Chonos", "source_book": "llm_generated", "evidence_snippet": "The Chonos Archipelago is an example of an archipelago, and the term 'archipelago' itself originates from the Aegean Islands, which are also an archipelago.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Chonos Archipelago is an example of an archipelago, and the term 'archipelago' itself originates from the Aegean Islands, which are also an archipelago."}, {"found_name": "atolls", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 487, "target_cluster_name": "atolls", "source_book": "llm_generated", "evidence_snippet": "An archipelago is a group of islands, and 'Island' is a singular form of this geographical feature. 'Atolls' specifically refers to a type of island, often found in archipelagos.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: An archipelago is a group of islands, and 'Island' is a singular form of this geographical feature. 'Atolls' specifically refers to a type of island, often found in archipelagos.", "is_reverse": true}, {"found_name": "Galapagos Archipelago", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 789, "target_cluster_name": "Galapagos Archipelago", "source_book": "llm_generated", "evidence_snippet": "The Galapagos Archipelago is a specific instance of an archipelago.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Galapagos Archipelago is a specific instance of an archipelago.", "is_reverse": true}, {"found_name": "Filipinas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 887, "target_cluster_name": "Filipinas", "source_book": "llm_generated", "evidence_snippet": "The Philippines is a major archipelago.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Philippines is a major archipelago.", "is_reverse": true}, {"found_name": "Bahama", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 918, "target_cluster_name": "Bahama", "source_book": "llm_generated", "evidence_snippet": "The Bahamas are an archipelago, consisting of over 3,000 islands, cays, and islets.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Bahamas are an archipelago, consisting of over 3,000 islands, cays, and islets.", "is_reverse": true}, {"found_name": "villages", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1250, "target_cluster_name": "villages", "source_book": "llm_generated", "evidence_sn