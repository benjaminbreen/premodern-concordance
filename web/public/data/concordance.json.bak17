", "book_count": 3, "total_mentions": 43, "members": [{"entity_id": "granitc", "book_id": "relation_historique_humboldt_vol3_1825", "name": "granitc", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["granitc"], "contexts": ["rock type in Vallées d'Aragua"]}, {"entity_id": "granite", "book_id": "kosmos_humboldt_1845", "name": "granite", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 32, "variants": ["granite", "Granite"], "contexts": ["endogenous rock type", "igneous rock"]}, {"entity_id": "granite", "book_id": "origin_of_species_darwin_1859", "name": "granite", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["granite"], "contexts": ["igneous rock", "rock type forming mountain-summits"]}, {"entity_id": "granitique", "book_id": "relation_historique_humboldt_vol3_1825", "name": "granitique", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 4, "variants": ["granitique"], "contexts": ["type of rock", "rock formation type"]}, {"entity_id": "granites", "book_id": "kosmos_humboldt_1845", "name": "granites", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["granites"], "contexts": ["rock crumbling into gravel"]}, {"entity_id": "granitic", "book_id": "relation_historique_humboldt_vol3_1825", "name": "granitic", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["granitic"], "contexts": ["rock type at Teptipano"]}, {"entity_id": "granit_blocks", "book_id": "kosmos_humboldt_1845", "name": "granit blocks", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["granit blocks"], "contexts": ["stone blocks from river cataracts"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "granitc", "target_book": "kosmos_humboldt_1845", "target_name": "granite", "similarity": 0.942}], "id": 1634, "stable_key": "clu_5ad08813b51071c9", "ground_truth": {"modern_name": "Granite", "confidence": "high", "type": "mineral", "wikidata_id": "Q36405", "wikidata_description": "city in Scotland, United Kingdom", "wikipedia_url": "https://en.wikipedia.org/wiki/Aberdeen", "wikipedia_extract": "Aberdeen (  AB-ər-DEEN;  locally [ˌeːbərˈdin]  or [ˈeːbərdin] ; Scottish Gaelic: Obar Dheathain [ˈopəɾ ˈʝɛ.ɪɲ]) is a port city in North East Scotland, and is the third most populous Scottish city. Historically, Aberdeen was within the historic county of Aberdeenshire, but is now separate from the council area of Aberdeenshire. Aberdeen City Council is one of Scotland's 32 local authorities (commonly referred to as councils). Aberdeen has a population of 198,590 (2020) for the main urban area and 220,690 (2020) for the wider settlement including outlying localities, making it the United Kingdom's 39th most populous built-up area. Aberdeen has a long, sandy coastline and features an oceanic climate, with cool summers and mild, rainy winters. Aberdeen received royal burgh status from David I of Scotland (1124–1153), which transformed the city economically."}, "member_count": 7, "cross_references": [{"found_name": "Lava", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1714, "target_cluster_name": "lava", "source_book": "llm_generated", "evidence_snippet": "Granite is an intrusive igneous rock, formed from solidified magma, which is related to extrusive igneous rock like lava.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Granite is an intrusive igneous rock, formed from solidified magma, which is related to extrusive igneous rock like lava."}, {"found_name": "rock", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 383, "target_cluster_name": "rock", "source_book": "llm_generated", "evidence_snippet": "Granite is a common type of felsic intrusive igneous rock.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Granite is a common type of felsic intrusive igneous rock.", "is_reve