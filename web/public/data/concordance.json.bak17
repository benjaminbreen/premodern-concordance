y": 0.669}], "id": 2915, "stable_key": "clu_5db6092025ede168", "ground_truth": {"modern_name": "Ophir", "confidence": "high", "type": "place", "country": "Unknown", "note": "Legendary biblical location, precise modern country is unknown.", "wikidata_id": "Q914073", "wikidata_description": "Biblical port famous for its wealth", "wikipedia_url": "https://en.wikipedia.org/wiki/Ophir", "wikipedia_extract": "Ophir (; Hebrew: אוֹפִיר, Modern: ʼŌfīr, Tiberian: ʼŌp̄īr) is a port or region mentioned in the Bible, famous for its wealth. Its existence is attested to by an inscribed pottery shard found at Tell Qasile (in modern-day Tel Aviv) in 1946, dating to the eighth century BC, which reads \"gold of Ophir to/for Beth-Horon [...] 30 shekels\". The location of Ophir is unknown, though the find confirms it as a real place which exported gold. Ophir in Genesis 10 (the Table of Nations) is said to be the name of one of the sons of Joktan. The Books of Kings and Chronicles tell of a joint expedition to Ophir by King Solomon and the Tyrian king Hiram I from Ezion-Geber, a port on the Red Sea, that brought back large amounts of gold, precious stones and 'algum wood' and of a later failed expedition by king Jehoshaphat of Judah. The famous 'gold of Ophir' is referenced in several other books of the Hebrew Bible, in particular Isaiah 13:12 refers to the \"golden wedge of Ophir\"."}, "cross_references": [{"found_name": "Arabia", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 169, "target_cluster_name": "Arabia", "source_book": "llm_generated", "evidence_snippet": "Ophir is frequently identified with regions in Arabia due to its historical association with trade routes and precious goods.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Ophir is frequently identified with regions in Arabia due to its historical association with trade routes and precious goods."}, {"found_name": "East Indies", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 497, "target_cluster_name": "East Indies", "source_book": "llm_generated", "evidence_snippet": "The biblical descriptions of Ophir's wealth and exotic goods align with early European conceptions of the East Indies as a source of riches.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The biblical descriptions of Ophir's wealth and exotic goods align with early European conceptions of the East Indies as a source of riches."}, {"found_name": "India", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 17, "target_cluster_name": "India", "source_book": "llm_generated", "evidence_snippet": "Ophir's association with gold and precious commodities has led to its identification with regions in India, particularly in historical trade contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Ophir's association with gold and precious commodities has led to its identification with regions in India, particularly in historical trade contexts."}, {"found_name": "Persia", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 168, "target_cluster_name": "Persia", "source_book": "llm_generated", "evidence_snippet": "The geographical proximity and historical trade connections between Persia and the regions associated with Ophir make it a plausible, though debated, identification or related region.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The geographical proximity and historical trade connections between Persia and the regions associated with Ophir make it a plausible, though debated, identification or related region."}]}, {"canonical_name": "State", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "state", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "State", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["State"], "contexts": ["governance and political affairs", "political entity or governance"]}, {"entity_id": "state", "book_id": "first_principles_spencer_1862", "name": "State", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["State"], "contexts": ["entity with governmental power", "secular part of government"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "State", "target_book": "first_principles_spencer_1862", "target_name": "State", "similarity": 1.0}], "id": 2916, "stable_key": "clu_a873e2f762832f26", "ground_truth": {"modern_name": "State", "confidence": "high", "type": "concept"}, "cross_references": [{"found_name": "Constitution", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1128, "target_cluster_name": "Constitution", "source_book": "llm_generated", "evidence_snippet": "The constitution defines the structure and powers of a state.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The constitution defines the structure and powers of a state."}, {"found_name": "Government", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2489, "target_cluster_name": "Government", "source_book": "llm_generated", "evidence_snippet": "Government is the system of rule that operates within a state.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Government is the system of rule that operates within a state."}, {"found_name": "Absolute power", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4263, "target_cluster_name": "absolute power", "source_book": "llm_generated", "evidence_snippet": "Absolute power is a characteristic or form of state.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Absolute power is a characteristic or form of state."}, {"found_name": "Authority", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 355, "target_cluster_name": "Authority", "source_book": "llm_generated", "evidence_snippet": "Authority is a fundamental component of the state.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Authority is a fundamental component of the state."}, {"found_name": "Civil", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3939, "target_cluster_name": "Civil", "source_book": "llm_generated", "evidence_snippet": "The term 'civil' is closely associated with the organization and functioning of a state.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The term 'civil' is closely associated with the organization and functioning of a state."}]}, {"canonical_name": "Scammony", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "scammony", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Scammony", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Scammony"], "contexts": ["laxative plant product", "plant with purging virtues"]}, {"entity_id": "scammony", "book_id": "english_physician_1652", "name": "Scammony", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Scammony"], "contexts": ["herb used in learned receipts", "used for watery humors"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Scammony", "target_book": "english_physician_1652", "target_name": "Scammony", "similarity": 1.0}], "id": 2917, "stable_key": "clu_2ef90a29d2c08d6f-2", "ground_truth": {"modern_name": "Scammony", "confidence": "high", "type": "plant", "linnaean": "Convolvulus scammonia", "family": "Convolvulaceae", "description": "Resinous purgative obtained from the root of a bindweed plant.", "wikipedia_extract": "Convolvulus scammonia, commonly known as scammony, is a bindweed native to the countries of the eastern part of the Mediterranean basin; it grows in bushy waste places, from Syria in the south to Crimea in the north, its range extending westward to the Greek islands, but not to northern Africa or Italy. It is a twining perennial, bearing flowers like those of Convolvulus arvensis, and having irregularly arrow-shaped leaves and a thick fleshy root. A cathartic resinous tincture known as scammoniae resina, which is obtained from the dried root by digestion with ethanol has been used as a traditional medicine. Upon consumption, the resin is inert until it has passed from the stomach into the duodenum, where it meets the bile. A chemical reaction occurs between it and taurocholate and glycocholate in the bile, whereby it is converted into a powerful purgative which in high doses becomes a violent gastrointestinal irritant. Scammony kills both roundworm and tapeworm, especially the former, and it was therefore used as an anthelmintic."}, "cross_references": [{"found_name": "Ivy", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2693, "target_cluster_name": "Ivy", "source_book": "llm_generated", "evidence_snippet": "Both Scammony and Ivy are climbing plants, and their growth habits and potential medicinal uses might lead to them being discussed in similar contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both Scammony and Ivy are climbing plants, and their growth habits and potential medicinal uses might lead to them being discussed in similar contexts."}]}, {"canonical_name": "Ginger", "category": "PLANT", "subcategory": "ROOT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "ginger", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Ginger", "category": "PLANT", "subcategory": "ROOT", "count": 2, "variants": ["Ginger"], "contexts": ["spice from a plant", "root of an herbaceous plant"]}, {"entity_id": "ginger", "book_id": "english_physician_1652", "name": "Ginger", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Ginger"], "contexts": ["spice used in a powder", "aromatic root"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ginger", "target_book": "english_physician_1652", "target_name": "Ginger", "similarity": 0.863}], "id": 2918, "stable_key": "clu_c56e9a36c14c14b7", "ground_truth": {"modern_name": "Ginger", "confidence": "high", "type": "plant", "linnaean": "Zingiber officinale Roscoe", "family": "Zingiberaceae", "wikidata_id": "Q35625", "wikidata_description": "plant species", "wikipedia_extract": "Modern ginger beer is a sweetened and carbonated, usually non-alcoholic beverage, a type of soft drink. Historically it was a type of beer brewed by the natural fermentation of prepared ginger spice, yeast and sugar. Modern ginger beers are often manufactured rather than brewed, frequently with flavour and colour additives, with artificial carbonation. The related ginger ales also are not brewed. Ginger beer is still produced at home using a type of symbiotic colony of yeast and Lactobacillus bacteria (SCOBY) known as a \"ginger beer plant\", or from a \"ginger bug\" starter created from fermenting ginger, sugar, and water. Brewed ginger beer originated in Yorkshire in England in the mid-18th century and became popular throughout Britain, the United States, Ireland, South Africa, the Caribbean and Canada, reaching a peak of popularity in the early 20th century.", "wikipedia_url": "https://en.wikipedia.org/wiki/Ginger_beer"}, "cross_references": [{"found_name": "gengibre", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 1688, "target_cluster_name": "gengibre", "source_book": "llm_generated", "evidence_snippet": "This is the Portuguese equivalent of 'ginger'.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "This is the Portuguese equivalent of 'ginger'."}, {"found_name": "Cardamom", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 636, "target_cluster_name": "Cardamomo", "source_book": "llm_generated", "evidence_snippet": "Both ginger and cardamom are prominent spices derived from rhizomes or seeds, often used together in culinary and medicinal contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both ginger and cardamom are prominent spices derived from rhizomes or seeds, often used together in culinary and medicinal contexts."}, {"found_name": "Cinnamon", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 44, "target_cluster_name": "Canela", "source_book": "llm_generated", "evidence_snippet": "Ginger and cinnamon are both widely used aromatic spices, frequently appearing together in historical recipes and medicinal preparations.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Ginger and cinnamon are both widely used aromatic spices, frequently appearing together in historical recipes and medicinal preparations."}, {"found_name": "Turmeric", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1807, "target_cluster_name": "Curcuma", "source_book": "llm_generated", "evidence_snippet": "Ginger and turmeric are closely related rhizomatous plants from the Zingiberaceae family, often used interchangeably or in conjunction as spices and in traditional medicine.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Ginger and turmeric are closely related rhizomatous plants from the Zingiberaceae family, often used interchangeably or in conjunction as spices and in traditional medicine."}, {"found_name": "Galangal", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 270, "target_cluster_name": "Galbano", "source_book": "llm_generated", "evidence_snippet": "Galangal is another rhizomatous spice from the Zingiberaceae family, closely related to ginger and often used in similar culinary applications, particularly in Southeast Asian cuisine.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Galangal is another rhizomatous spice from the Zingiberaceae family, closely related to ginger and often used in similar culinary applications, particularly in Southeast Asian cuisine."}, {"found_name": "Zedoary", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 767, "target_cluster_name": "zedoaria", "source_book": "llm_generated", "evidence_snippet": "Zedoary is another rhizomatous spice from the Zingiberaceae family, related to ginger and used in traditional medicine and as a spice.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Zedoary is another rhizomatous spice from the Zingiberaceae family, related to ginger and used in traditional medicine and as a spice."}, {"found_name": "Spices", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2144, "target_cluster_name": "especiarias", "source_book": "llm_generated", "evidence_snippet": "Ginger is a primary example of a spice, and this term represents the broader category to which it belongs.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Ginger is a primary example of a spice, and this term represents the broader category to which it belongs."}, {"found_name": "Amomum", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2029, "target_cluster_name": "Amomum", "source_book": "llm_generated", "evidence_snippet": "Amomum and Zingiber (the genus for ginger) are both genera within the family Zingiberaceae, commonly known as the ginger family. They are closely related and often confused or grouped together in historical texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Amomum and Zingiber (the genus for ginger) are both genera within the family Zingiberaceae, commonly known as the ginger family. They are closely related and often confused or grouped together in historical texts."}, {"found_name": "nutmeg", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2692, "target_cluster_name": "Nutmeg", "source_book": "llm_generated", "evidence_snippet": "Nutmeg and mace are derived from the same fruit (Myristica fragrans), and ginger is also a spice derived from a rhizome. These are all common spices often found together in historical pharmacopoeias and culinary texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Nutmeg and mace are derived from the same fruit (Myristica fragrans), and ginger is also a spice derived from a rhizome. These are all common spices often found together in historical pharmacopoeias and culinary texts."}, {"found_name": "mace", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 734, "target_cluster_name": "mace", "source_book": "llm_generated", "evidence_snippet": "Mace is the aril of the nutmeg fruit, and ginger is a spice from a rhizome. Both are common spices often found together in historical pharmacopoeias and culinary texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Mace is the aril of the nutmeg fruit, and ginger is a spice from a rhizome. Both are common spices often found together in historical pharmacopoeias and culinary texts."}]}, {"canonical_name": "Misseltoe", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 4, "total_mentions": 8, "members": [{"entity_id": "misseltoe", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Misseltoe", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Misseltoe"], "contexts": ["plant found on some trees", "parasitic plant growing on trees"]}, {"entity_id": "misseltoe", "book_id": "origin_of_species_darwin_1859", "name": "Misseltoe", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Misseltoe", "misseltoe"], "contexts": ["parasitic plant with specific needs", "complex relations of"]}, {"entity_id": "vifco_di_quercia", "book_id": "ricettario_fiorentino_1597", "name": "Vifco di quercia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Vifco di quercia", "Vifco quercino"], "contexts": ["oak mistletoe", "oak mistletoe used in preparations"]}, {"entity_id": "viſco_quercino", "book_id": "polyanthea_medicinal", "name": "viſco quercino", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["viſco quercino", "Viſco quercedo"], "contexts": ["mistletoe, used in remedies", "powder ingredient"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Misseltoe", "target_book": "origin_of_species_darwin_1859", "target_name": "Misseltoe", "similarity": 1.0}], "id": 2919, "stable_key": "clu_1e2930e87b04dc1b", "ground_truth": {"modern_name": "Mistletoe", "confidence": "high", "type": "plant", "linnaean": "Viscum album Linnaeus", "family": "Santalaceae", "wikidata_id": "Q144940", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Viscum%20album", "wikipedia_extract": "Mistletoe is the common name for obligate hemiparasitic plants in the order Santalales. They are attached to their host tree or shrub by a structure called the haustorium, through which they extract water and nutrients from the host plant. There are hundreds of species which mostly live in tropical regions. The name mistletoe originally referred to the species Viscum album (European mistletoe, of the family Santalaceae in the order Santalales); it is the only species native to the British Isles and much of Europe. A related species with red fruits, rather than white, Viscum cruciatum, occurs in Southwest Spain and Southern Portugal, as well as in Morocco in North Africa and in southern Africa. There is also a wide variety of species in Australia.", "note": "The primary referent is likely Viscum album, with 'quercino' indicating association with oak."}, "member_count": 4, "cross_references": [{"found_name": "Cuscuta", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2248, "target_cluster_name": "Cufcuta", "source_book": "llm_generated", "evidence_snippet": "Both Cuscuta and Mistletoe are parasitic plants, though Cuscuta is a holoparasite while Mistletoe is a hemiparasite.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both Cuscuta and Mistletoe are parasitic plants, though Cuscuta is a holoparasite while Mistletoe is a hemiparasite."}, {"found_name": "Parasitic plants", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3859, "target_cluster_name": "parasitical Plants", "source_book": "llm_generated", "evidence_snippet": "Mistletoe is a hemiparasitic plant, a specific type of parasitic plant.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Mistletoe is a hemiparasitic plant, a specific type of parasitic plant."}]}, {"canonical_name": "Spider", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "spider", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Spider", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Spider"], "contexts": ["arachnid creature", "venemous creature signifying pestilence"]}, {"entity_id": "snake", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Snake", "category": "ANIMAL", "subcategory": "REPTILE", "count": 1, "variants": ["Snake"], "contexts": ["animal that avoids Ash shade"]}, {"entity_id": "snake", "book_id": "polyanthea_medicinal", "name": "snake", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["snake"], "contexts": ["venomous creature"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Spider", "target_book": "polyanthea_medicinal", "target_name": "snake", "similarity": 0.902}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Snake", "target_book": "polyanthea_medicinal", "target_name": "snake", "similarity": 0.889}], "id": 2920, "stable_key": "clu_5f00f67bc5e475b3-2", "ground_truth": {"wikipedia_extract": "Spiders (order Araneae) are air-breathing arthropods that have eight limbs, chelicerae with fangs generally able to inject venom, and spinnerets that extrude silk. They are the largest order of arachnids and rank seventh in total species diversity among all orders of organisms. Spiders are found worldwide on every continent except Antarctica, and have become established in nearly every land habitat. As of January 2026, 53,680 spider species in 139 families have been recorded by taxonomists. However, there has been debate among scientists about how families should be classified, with over 20 different classifications proposed since 1900. Anatomically, spiders (as with all arachnids) differ from other arthropods in that the usual body segments are fused into two tagmata, the cephalothorax or prosoma, and the opisthosoma, or abdomen, and joined by a small, cylindrical pedicel."}, "cross_references": []}, {"canonical_name": "roots", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "roots", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "roots", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["roots"], "contexts": ["plant part planted in a garden", "sap of Trees runs down to the roots"]}, {"entity_id": "root", "book_id": "first_principles_spencer_1862", "name": "root", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["root"], "contexts": ["underlying source or basis", "plant organ growing through soil"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "roots", "target_book": "first_principles_spencer_1862", "target_name": "root", "similarity": 0.936}], "id": 2921, "stable_key": "clu_f44de2881b345810", "ground_truth": {"modern_name": "Root", "confidence": "high", "type": "plant"}, "cross_references": []}, {"canonical_name": "Acorns", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "acorns", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "acorns", "category": "PLANT", "subcategory": "SEED", "count": 1, "variants": ["acorns"], "contexts": ["seed of an oak tree"]}, {"entity_id": "acorns", "book_id": "english_physician_1652", "name": "Acorns", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Acorns", "Acorus"], "contexts": ["Hogs eat Acorns", "fruit of the oak tree, used medicinally"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "acorns", "target_book": "english_physician_1652", "target_name": "Acorns", "similarity": 0.761}], "id": 2922, "stable_key": "clu_4df975d9c80e155e", "ground_truth": {"modern_name": "Acorn", "confidence": "medium", "type": "plant", "linnaean": "Quercus spp.", "family": "Fagaceae", "note": "The term 'Acorus' appears in one source and refers to a different plant (sweet flag). Given the context 'seed of an oak tree' and 'Hogs eat Acorns', 'Acorn' is the primary identification, but 'Acorus' introduces ambiguity.", "wikidata_id": "Q3914781", "wikidata_description": "fruit/nut of the oak tree", "wikipedia_url": "https://en.wikipedia.org/wiki/Acorn", "wikipedia_extract": "The acorn  is the nut of the oaks and their close relatives (genera Quercus, Notholithocarpus and Lithocarpus, in the family Fagaceae); alternatively known as glans. It usually contains a seedling surrounded by two cotyledons (seedling leaves), enclosed in a tough shell known as the pericarp, and borne in a cup-shaped cupule. Acorns are 1–6 cm (1⁄2–2+1⁄2 in) long and 0.8–4 cm (3⁄8–1+5⁄8 in) on the fat side. Acorns take between 5 and 24 months (depending on the species) to mature; see the list of Quercus species for details of oak classification, in which acorn morphology and phenology are important factors. The word acorn (earlier akerne, and acharn) is related to the Gothic name akran, which had the sense of \"fruit of the unenclosed land\". The word was applied to the most important forest produce, that of the oak."}, "cross_references": [{"found_name": "oaks", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2185, "target_cluster_name": "oaks", "source_book": "llm_generated", "evidence_snippet": "Acorns are the fruit of oak trees.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Acorns are the fruit of oak trees.", "is_reverse": true}, {"found_name": "arvore", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1632, "target_cluster_name": "arvore", "source_book": "llm_generated", "evidence_snippet": "Acorns are the fruit of oak trees.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Acorns are the fruit of oak trees.", "is_reverse": true}, {"found_name": "Oak", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1060, "target_cluster_name": "Oak", "source_book": "llm_generated", "evidence_snippet": "Acorns are the nuts of oak trees.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Acorns are the nuts of oak trees."}, {"found_name": "Tree", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 24, "target_cluster_name": "Tree", "source_book": "llm_generated", "evidence_snippet": "Acorns are produced by trees.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Acorns are produced by trees."}, {"found_name": "Seed", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 211, "target_cluster_name": "Seed", "source_book": "llm_generated", "evidence_snippet": "Acorns contain a seedling and are a form of seed dispersal.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Acorns contain a seedling and are a form of seed dispersal."}]}, {"canonical_name": "Thomas Brown", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "thomas_brown", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "THOMAS BROWN", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["THOMAS BROWN"], "contexts": ["author of the text"]}, {"entity_id": "thomas_brown", "book_id": "principles_of_psychology_james_1890", "name": "Thomas Brown", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Thomas Brown"], "contexts": ["philosopher quoted on consciousness", "philosopher quoted on mental states"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "THOMAS BROWN", "target_book": "principles_of_psychology_james_1890", "target_name": "Thomas Brown", "similarity": 0.87}], "id": 2923, "stable_key": "clu_47c2fd67eb292cf4", "ground_truth": {"modern_name": "Thomas Browne", "confidence": "high", "type": "person", "birth_year": 1605, "death_year": 1682, "description": "English physician, writer, and early scientist, author of Pseudodoxia Epidemica.", "note": "William James quotes Thomas Browne, but the primary association in the cluster is with the author of Pseudodoxia Epidemica.", "wikidata_id": "Q313925", "wikidata_description": "English polymath and author (1605–1682)"}, "cross_references": []}, {"canonical_name": "opinions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "opinions", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "opinions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["opinions"], "contexts": ["beliefs or judgments"]}, {"entity_id": "opinions", "book_id": "first_principles_spencer_1862", "name": "opinions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["opinions"], "contexts": ["beliefs or judgments", "beliefs or judgments he