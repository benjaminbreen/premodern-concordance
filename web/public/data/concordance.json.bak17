ss_references": [{"found_name": "Johann Hieronymus Schrader", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 522, "target_cluster_name": "Planer", "source_book": "llm_generated", "evidence_snippet": "Johann Hieronymus Schrader is listed as 'Planer', and Wilhelm Heinrich Sebastian Schrader is listed as 'Schroderus'. The similarity in surnames and the presence of 'Schrader' in both suggests a potential familial or professional connection, though not a direct synonymy or identity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Johann Hieronymus Schrader is listed as 'Planer', and Wilhelm Heinrich Sebastian Schrader is listed as 'Schroderus'. The similarity in surnames and the presence of 'Schrader' in both suggests a potential familial or professional connection, though not a direct synonymy or identity."}]}, {"canonical_name": "July", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 70, "members": [{"entity_id": "july", "book_id": "english_physician_1652", "name": "July", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 65, "variants": ["July", "July 25"], "contexts": ["month for flowering", "month when Arrach flowers"]}, {"entity_id": "juillet", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Juillet", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["juillet", "Juillet"], "contexts": ["month, July", "month of observation start"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "July", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Juillet", "similarity": 0.899}], "id": 1523, "stable_key": "clu_16a222ff41b2d1ec", "ground_truth": {"modern_name": "July", "confidence": "high", "type": "concept", "wikidata_id": "Q121", "wikidata_description": "seventh month of the year in the Julian and Gregorian calendars", "wikipedia_url": "https://en.wikipedia.org/wiki/July", "wikipedia_extract": "July is the seventh month of the year in the Julian and Gregorian calendars. Its length is 31 days. It was named by the Roman Senate in honour of Roman general and statesman Julius Caesar in 44 B.C., being the month of his birth. Before then it was called Quintilis, being the fifth month of the calendar that started with March. It is on average the warmest month in most of the Northern Hemisphere, where it is the second month of summer, and the coldest month in much of the Southern Hemisphere, where it is the second month of winter. The second half of the year commences in July."}, "cross_references": [{"found_name": "June", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 69, "target_cluster_name": "June", "source_book": "llm_generated", "evidence_snippet": "July and June are consecutive months in the Gregorian calendar, and their temporal proximity often leads to discussions of seasonal changes and agricultural cycles.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: July and June are consecutive months in the Gregorian calendar, and their temporal proximity often leads to discussions of seasonal changes and agricultural cycles.", "is_reverse": true}, {"found_name": "August", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2557, "target_cluster_name": "August", "source_book": "llm_generated", "evidence_snippet": "August and July are consecutive months in the Gregorian calendar.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "August and July are consecutive months in the Gregorian calendar."}, {"found_name": "Summer", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 93, "target_cluster_name": "Summer", "source_book": "llm_generated", "evidence_snippet": "July is a month that falls within the season of Summer in the Northern Hemisphere.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "July is a month that falls within the season of Summer in the Northern Hemisphere."}]}, {"canonical_name": "Varieties", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 70, "members": [{"entity_id": "varieties", "book_id": "origin_of_species_darwin_1859", "name": "Varieties", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 66, "variants": ["varieties", "Varieties"], "contexts": ["subdivisions within a species", "subgroups within a species"]}, {"entity_id": "varieties", "book_id": "first_principles_spencer_1862", "name": "varieties", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["varieties"], "contexts": ["different forms within a species", "distinct groups within a species"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Varieties", "target_book": "first_principles_spencer_1862", "target_name": "varieties", "similarity": 0.991}], "id": 1524, "stable_key": "clu_8ef8c323cd6fa300", "ground_truth": {"modern_name": "Varieties", "confidence": "high", "type": "concept", "note": "In the context of Darwin, 'varieties' can refer to what are now called subspecies or distinct populations."}, "cross_references": [{"found_name": "Classification", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1977, "target_cluster_name": "classification", "source_book": "llm_generated", "evidence_snippet": "The concept of 'Varieties' is intrinsically linked to the process of 'Classification', as identifying and naming varieties is a fundamental aspect of organizing and understanding groups of things.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The concept of 'Varieties' is intrinsically linked to the process of 'Classification', as identifying and naming varieties is a fundamental aspect of organizing and understanding groups of things."}, {"found_name": "Genus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 263, "target_cluster_name": "genus", "source_book": "llm_generated", "evidence_snippet": "In biological and other classification systems, 'Varieties' are often subdivisions within a 'Genus' or species, representing distinct forms or types.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "In biological and other classification systems, 'Varieties' are often subdivisions within a 'Genus' or species, representing distinct forms or types."}, {"found_name": "Species", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 32, "target_cluster_name": "species", "source_book": "llm_generated", "evidence_snippet": "In biological classification, 'Varieties' are typically subdivisions of a 'Species', denoting distinct forms within that species.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "In biological classification, 'Varieties' are typically subdivisions of a 'Species', denoting distinct forms within that species."}]}, {"canonical_name": "Diabetica", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 2, "total_mentions": 68, "members": [{"entity_id": "diabets", "book_id": "english_physician_1652", "name": "Diabets", "category": "DISEASE", "subcategory": "CHRONIC", "count": 2, "variants": ["Diabets", "Diabetes"], "contexts": ["diabetes mellitus", "metabolic disorder"]}, {"entity_id": "diabetica", "book_id": "polyanthea_medicinal", "name": "Diabetica", "category": "DISEASE", "subcategory": "CHRONIC", "count": 66, "variants": ["Diabetica", "Diabe", "Diabete", "Diabetem", "Diabeticas", "Diabeticos", "Diabética", "diabetica", "fedas Diabeticas"], "contexts": ["medical condition related to urine", "diabetic disease"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Diabets", "target_book": "polyanthea_medicinal", "target_name": "Diabetica", "similarity": 0.953}], "id": 1525, "stable_key": "clu_d983e8a9452bfdb8", "ground_truth": {"modern_name": "Diabetes", "confidence": "high", "type": "disease", "description": "A metabolic disease characterized by high blood sugar levels.", "wikipedia_extract": "Diabetes mellitus, commonly known as diabetes, is a group of common endocrine diseases characterized by sustained high blood sugar levels. Diabetes tends to progress in severity, and is due to either a reduced production of the hormone insulin by the pancreas or unresponsiveness of bodily cells to insulin's effects. Classic symptoms include the three Ps: polydipsia (excessive thirst), polyuria (excessive urination), and polyphagia (excessive hunger), together with weight loss and blurred vision. If left untreated, the disease can lead to many health complications, including disorders of the cardiovascular system, eye, kidney, and nerves. The major types of diabetes are type 1 and type 2. The most common type is type 2."}, "cross_references": []}, {"canonical_name": "Fernelius", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 68, "members": [{"entity_id": "fernelius", "book_id": "english_physician_1652", "name": "Fernelius", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Fernelius"], "contexts": ["cited for explanation of melancholic vapor"]}, {"entity_id": "fernelius", "book_id": "polyanthea_medicinal", "name": "Fernelius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 67, "variants": ["Fernelius", "Fernel", "Fernelio", "Ferrel"], "contexts": ["early modern physician and author", "author on parts of diseases and symptoms"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Fernelius", "target_book": "polyanthea_medicinal", "target_name": "Fernelius", "similarity": 0.663}], "id": 1526, "stable_key": "clu_78d149ceb659b752", "ground_truth": {"modern_name": "Jean Fernel", "confidence": "high", "type": "person", "birth_year": 1497, "death_year": 1558, "description": "French physician and mathematician, known for his medical writings.", "wikidata_id": "Q741189", "wikidata_description": "French physician (*1497 – †1558)", "wikipedia_url": "https://en.wikipedia.org/wiki/Jean%20Fernel", "wikipedia_extract": "Jean François Fernel (Latinized as Ioannes Fernelius; 1497 – 26 April 1558) was a French physician who introduced the term \"physiology\" to describe the study of the body's function. He was the first person to describe the spinal canal. The lunar crater Fernelius is named after him. Fernel suggested that taste buds are sensitive to fat, an idea which research in the early 21st century proved to be correct. He was born in Montdidier and, after receiving his early education at Clermont, he entered the College of Sainte-Barbe, Paris. At first he devoted himself to mathematical and astronomical studies; but from 1534 he gave himself up entirely to medicine, in which he graduated in 1530."}, "cross_references": [{"found_name": "Ambroise Paré", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2093, "target_cluster_name": "Pareus", "source_book": "llm_generated", "evidence_snippet": "Both were prominent French physicians of the 16th century, contemporaries who likely knew of each other's work.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were prominent French physicians of the 16th century, contemporaries who likely knew of each other's work."}, {"found_name": "Andreas Vesalius", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1395, "target_cluster_name": "Andreas", "source_book": "llm_generated", "evidence_snippet": "Both were highly influential physicians and anatomists of the Renaissance, revolutionizing medical understanding.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were highly influential physicians and anatomists of the Renaissance, revolutionizing medical understanding."}, {"found_name": "Galen", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 29, "target_cluster_name": "Galen", "source_book": "llm_generated", "evidence_snippet": "Fernel's work built upon and, in some cases, challenged the long-standing medical theories of Galen, a foundational figure in ancient medicine.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Fernel's work built upon and, in some cases, challenged the long-standing medical theories of Galen, a foundational figure in ancient medicine."}, {"found_name": "Hippocrates", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 31, "target_cluster_name": "Hippocrates", "source_book": "llm_generated", "evidence_snippet": "As a physician, Fernel was part of the intellectual tradition that traced its roots back to Hippocrates, the 'father of medicine'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "As a physician, Fernel was part of the intellectual tradition that traced its roots back to Hippocrates, the 'father of medicine'."}, {"found_name": "Dioscorides", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 33, "target_cluster_name": "Dioscorides", "source_book": "llm_generated", "evidence_snippet": "Both Fernel and Dioscorides were significant figures in the study of materia medica and pharmacology, though from different eras.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both Fernel and Dioscorides were significant figures in the study of materia medica and pharmacology, though from different eras."}, {"found_name": "Physician", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 527, "target_cluster_name": "Medicos", "source_book": "llm_generated", "evidence_snippet": "Fernel was a physician, and this term represents his professional category.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Fernel was a physician, and this term represents his professional category."}]}, {"canonical_name": "baço", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 68, "members": [{"entity_id": "baço", "book_id": "coloquios_da_orta_1563", "name": "baço", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["baço"], "contexts": ["organ of the body"]}, {"entity_id": "baço", "book_id": "polyanthea_medicinal", "name": "baço", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 67, "variants": ["baço", "Baço"], "contexts": ["spleen", "organ near the stomach"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "baço", "target_book": "polyanthea_medicinal", "target_name": "baço", "similarity": 1.0}], "id": 1527, "stable_key": "clu_49b583195698559d", "ground_truth": {"modern_name": "Spleen", "confidence": "high", "type": "organ", "wikidata_id": "Q9371", "wikidata_description": "organ recycling old red blood cells and also housing lymphocytes", "wikipedia_url": "https://en.wikipedia.org/wiki/Spleen", "wikipedia_extract": "The spleen (from Anglo-Norman  espleen; ult. from Ancient Greek σπλήν, splḗn) is an organ found in almost all vertebrates. Similar in structure to a large lymph node, it acts primarily as a blood filter. The spleen plays important roles in regard to red blood cells (erythrocytes) and the immune system. It removes old red blood cells and holds a reserve of blood, which can be valuable in case of hemorrhagic shock, and also recycles iron. As a part of the mononuclear phagocyte system, it metabolizes hemoglobin removed from senescent red blood cells."}, "cross_references": [{"found_name": "Gall", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 650, "target_cluster_name": "Gall", "source_book": "llm_generated", "evidence_snippet": "The spleen is closely associated with the production and circulation of bile in humoral theory.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The spleen is closely associated with the production and circulation of bile in humoral theory."}, {"found_name": "bile", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 454, "target_cluster_name": "bilis", "source_book": "llm_generated", "evidence_snippet": "The spleen is closely associated with the production and circulation of bile in humoral theory.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The spleen is closely associated with the production and circulation of bile in humoral theory."}, {"found_name": "fel", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1921, "target_cluster_name": "fel", "source_book": "llm_generated", "evidence_snippet": "The spleen is closely associated with the production and circulation of bile in humoral theory.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The spleen is closely associated with the production and circulation of bile in humoral theory."}, {"found_name": "sangue", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1488, "target_cluster_name": "sangue", "source_book": "llm_generated", "evidence_snippet": "The spleen filters blood and plays a role in red blood cell management.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The spleen filters blood and plays a role in red blood cell management."}, {"found_name": "Blood", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1488, "target_cluster_name": "sangue", "source_book": "llm_generated", "evidence_snippet": "The spleen filters blood and plays a role in red blood cell management.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The spleen filters blood and plays a role in red blood cell management."}, {"found_name": "humores", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 28, "target_cluster_name": "humores", "source_book": "llm_generated", "evidence_snippet": "In humoral theory, the spleen was considered a source of melancholic humor.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "In humoral theory, the spleen was considered a source of melancholic humor."}, {"found_name": "Humors", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 28, "target_cluster_name": "humores", "source_book": "llm_generated", "evidence_snippet": "In humoral theory, the spleen was considered a source of melancholic humor.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "In humoral theory, the spleen was considered a source of melancholic humor."}, {"found_name": "Internal organs", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1428, "target_cluster_name": "internal organ", "source_book": "llm_generated", "evidence_snippet": "The spleen is an internal organ.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The spleen is an internal organ."}, {"found_name": "Organs", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 141, "target_cluster_name": "organs", "source_book": "llm_generated", "evidence_snippet": "The spleen is an organ.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The spleen is an organ."}, {"found_name": "Choleric humor", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 601, "target_cluster_name": "Choller", "source_book": "llm_generated", "evidence_snippet": "The spleen was historically associated with the production or regulation of humors, particularly choleric humor.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The spleen was historically associated with the production or regulation of humors, particularly choleric humor."}]}, {"canonical_name": "solar system", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 75, "members": [{"entity_id": "solar_system", "book_id": "kosmos_humboldt_1845", "name": "solar system", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 24, "variants": ["solar system", "Solar system"], "contexts": ["our star and its planets", "region observed by astronomers"]}, {"entity_id": "solar_system", "book_id": "connexion_physical_sciences_somerville_1858", "name": "solar system", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 42, "variants": ["Solar system", "Solar System", "solar system"], "contexts": ["planets orbiting the Sun", "our planetary system"]}, {"entity_id": "solar_systems", "book_id": "connexion_physical_sciences_somerville_1858", "name": "solar systems", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["solar systems"], "contexts": ["systems analogous to our own"]}, {"entity_id": "sol", "book_id": "english_physician_1652", "name": "Sol", "category": "CONCEPT", "subcategory": "THEORY", "count": 4, "variants": ["Sol"], "contexts": ["celestial body influencing herb gathering", "astrological influence on diseases"]}, {"entity_id": "sole", "book_id": "ricettario_fiorentino_1597", "name": "sole", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["sole"], "contexts": ["used for dissolving and heating substances", "sun used for drying/heating"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "solar system", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "solar system", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "solar system", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "solar systems", "similarity": 0.938}], "id": 1528, "stable_key": "clu_8cf0fcb0bbb47075", "ground_truth": {"modern_name": "Sun", "confidence": "high", "type": "concept", "note": "The term 'Sol' refers to the Sun, both as a celestial body and in its influence on natural phenomena, as well as in a broader metaphorical sense of 'solar systems'.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_extract": "The Sun is the star at the centre of the Solar System. It is a massive, nearly perfect sphere of hot plasma, heated to incandescence by nuclear fusion reactions in its core, radiating the energy from its surface mainly as visible light and infrared radiation with 10% at ultraviolet energies. It is the main source of energy for life on Earth. The Sun has been an object of veneration in many cultures and a central subject for astronomical research since antiquity. The Sun orbits the Galactic Center at a distance of 24,000 to 28,000 light-years. Its mean distance from Earth is about 1.496×108 kilometres or about 8 light-minutes."}, "member_count": 5, "cross_references": [{"found_name": "Aphelion", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 864, "target_cluster_name": "Aphelion", "source_book": "llm_generated", "evidence_snippet": "Aphelion is the point in the orbit of a planet or other celestial body at which it is furthest from the Sun. It is directly related to the Sun's gravitational influence on orbiting bodies.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Aphelion is the point in the orbit of a planet or other celestial body at which it is furthest from the Sun. It is directly related to the Sun's gravitational influence on orbiting bodies."}, {"found_name": "Ecliptic", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1541, "target_cluster_name": "ecliptic", "source_book": "llm_generated", "evidence_snippet": "The ecliptic is the plane of the Earth's orbit around the Sun, and is therefore directly related to the Sun's apparent path in the sky.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The ecliptic is the plane of the Earth's orbit around the Sun, and is therefore directly related to the Sun's apparent path in the sky."}, {"found_name": "Celestial body", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3227, "target_cluster_name": "celestial body", "source_book": "llm_generated", "evidence_snippet": "The Sun is the central celestial body of our solar system.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Sun is the central celestial body of our solar system."}]}, {"canonical_name": "piastres", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 66, "members": [{"entity_id": "piastres", "book_id": "relation_historique_humboldt_vol3_1825", "name": "piastres", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 65, "variants": ["piastres", "piast", "piast.", "piastre", "piastre forte", "piastres fortes"], "contexts": ["monetary unit for indigo value", "monetary unit"]}, {"entity_id": "piasters", "book_id": "kosmos_humboldt_1845", "name": "piasters", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["piasters"], "contexts": ["currency unit"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "piastres", "target_book": "kosmos_humboldt_1845", "target_name": "piasters", "similarity": 0.918}], "id": 1529, "stable_key": "clu_bdd1982d539d349b", "ground_truth": {"modern_name": "piastre", "confidence": "low", "type": "object", "description": "A monetary unit, historically used in various regions.", "note": "While 'piastres' is a monetary unit, 'plaster' is a material. The contexts are disparate.", "wikipedia_extract": "The piastre or piaster (English:  ) is any of a number of units of currency. The term originates from the Italian for \"thin metal plate\". The name was applied to Spanish and Hispanic American pieces of eight, or pesos, by Venetian traders in the Levant in the 16th century. These pesos, minted continually for centuries, were readily accepted by traders in many parts of the world. After the countries of Latin America had gained independence, pesos of Mexico began flowing in through the trade routes, and became prolific in the Far East, taking the place of the Spanish pieces of eight which had been introduced by the Spanish at Manila, and by the Portuguese at Malacca. When the French colonised Indochina, they began issuing the new French Indochinese piastre (piastre de commerce), which was equal in value to the familiar Spanish and Mexican pesos."}, "cross_references": [{"found_name": "Plata", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 290, "target_cluster_name": "Plata", "source_book": "llm_generated", "evidence_snippet": "The term 'piastre' originates from the Italian word for 'thin metal plate', and was applied to Spanish and Hispanic American pieces of eight, or pesos. 'Plata' is Spanish for silver, and the Spanish peso was a silver coin, making 'Plata' a related concept in the context of currency and coinage.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The term 'piastre' originates from the Italian word for 'thin metal plate', and was applied to Spanish and Hispanic American pieces of eight, or pesos. 'Plata' is Spanish for silver, and the Spanish peso was a silver coin, making 'Plata' a related concept in the context of currency and coinage."}]}, {"canonical_name": "natureza", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 66, "members": [{"entity_id": "natureza", "book_id": "coloquios_da_orta_1563", "name": "natureza", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["natureza"], "contexts": ["bodily vital force", "essential quality of things"]}, {"entity_id": "natureza", "book_id": "polyanthea_medicinal", "name": "natureza", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 64, "variants": ["natureza", "Natur facult.", "Natura", "natura", "natural", "nature", "natureza humana", "naturezas"], "contexts": ["force left to patients", "natural processes of the body"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "natureza", "target_book": "polyanthea_medicinal", "target_name": "natureza", "similarity": 1.0}], "id": 1530, "stable_key": "clu_284d2840dbe6a530", "ground_truth": {"modern_name": "Vital force", "confidence": "high", "type": "concept", "note": "Early modern concept of inherent life force, akin to anima or vis vitae.", "wikidata_id": "Q274574", "wikidata_description": "hypothetical explanation for evolution and development of organisms", "wikipedia_url": "https://en.wikipedia.org/wiki/%C3%89lan%20vital", "wikipedia_extract": "Élan vital (French pronunciation: [elɑ̃ vital]) is a term coined by French philosopher Henri Bergson in his 1907 book Creative Evolution, in which he addresses the question of self-organisation and spontaneous morphogenesis of things in an increasingly complex manner. Élan vital was translated in the English edition as \"vital impetus\", but is usually translated by his detractors as \"vital force\". It is a hypothetical explanation for evolution and development of organisms, which Bergson linked closely with consciousness – the intuitive perception of experience and the flow of inner time. Distant anticipations of Bergson can be found in the work of the pre-Christian Stoic philosopher Posidonius, who postulated a \"vital force\" emanated by the sun to all living creatures on the Earth's surface, and in that of Zeno of Elea. The concept of élan vital is also similar to Baruch Spinoza's concept of conatus as well as Arthur Schopenhauer's concept of the will-to-live and the Sanskrit āyus or \"life principle\". The French philosopher Gilles Deleuze attempted to recoup the novelty of Bergson's idea in his book Bergsonism, though Deleuze substantially modified the meaning of the term."}, "cross_references": [{"found_name": "Life", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 89, "target_cluster_name": "Life", "source_book": "llm_generated", "evidence_snippet": "Vital force is a concept closely associated with the animating principle of life.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Vital force is a concept closely associated with the animating principle of life."}, {"found_name": "Spirit", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 476, "target_cluster_name": "spirit", "source_book": "llm_generated", "evidence_snippet": "Vital force is often discussed in conjunction with, or as a component of, the spirit.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Vital force is often discussed in conjunction with, or as a component of, the spirit."}, {"found_name": "Generation", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 166, "target_cluster_name": "generation", "source_book": "llm_generated", "evidence_snippet": "Vital force is intrinsically linked to the process of generation and reproduction.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Vital force is intrinsically linked to the process of generation and reproduction."}, {"found_name": "Humoral theory", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 64, "target_cluster_name": "humoral theory", "source_book": "llm_generated", "evidence_snippet": "Historical understandings of vital force were often intertwined with humoral theories of the body.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Historical understandings of vital force were often intertwined with humoral theories of the body."}, {"found_name": "Inspiration", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4306, "target_cluster_name": "inspiration", "source_book": "llm_generated", "evidence_snippet": "The concept of vital force can be related to the idea of inspiration, both in a physiological and metaphorical sense.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The concept of vital force can be related to the idea of inspiration, both in a physiological and metaphorical sense."}]}, {"canonical_name": "Chymica", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 7, "total_mentions": 73, "members": [{"entity_id": "chimie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Chimie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Chimie", "chimie", "chimique"], "contexts": ["scientific discipline", "science of chemistry"]}, {"entity_id": "chymica", "book_id": "polyanthea_medicinal", "name": "Chymica", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 61, "variants": ["Chymica", "CHYMICAS", "Chymiaper", "Chymicas"], "contexts": ["alchemy", "art of preparing medicines"]}, {"entity_id": "chimi∣cally", "book_id": "english_physician_1652", "name": "Chimi∣cally", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["Chimi∣cally"], "contexts": ["method of drawing spirit from herb"]}, {"entity_id": "chymicamente", "book_id": "polyanthea_medicinal", "name": "chymicamente", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Chymicamente", "chymicamente"], "contexts": ["method of preparing tin", "chemical preparation method"]}, {"entity_id": "alquimia", "book_id": "historia_medicinal_monardes_1574", "name": "Alquimia", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["Alquimia"], "contexts": ["field of study concerning metal generation"]}, {"entity_id": "alchemy", "book_id": "first_principles_spencer_1862", "name": "alchemy", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["alchemy"], "contexts": ["hope of private benefit disclosure"]}, {"entity_id": "chimica", "book_id": "coloquios_da_orta_1563", "name": "chimica", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["chimica"], "contexts": ["science of composition of substances"]}, {"entity_id": "chimica", "book_id": "ricettario_fiorentino_1597", "name": "chimica", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["chimica"], "contexts": ["chemical art or practice"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Chimie", "target_book": "polyanthea_medicinal", "target_name": "Chymica", "similarity": 0.966}], "id": 1531, "stable_key": "clu_ff0c48a438052ae3", "ground_truth": {"modern_name": "alchemy", "confidence": "high", "type": "concept", "description": "Ancient practice involving chemical transformation and medicine.", "note": "Also encompasses the chemical art and practice.", "wikipedia_extract": "Alchemy (from the Arabic word al-kīmīā, الكیمیاء) is an ancient branch of natural philosophy, a philosophical and protoscientific tradition that was historically practised in China, India, the Muslim world, and Europe. In its Western form, alchemy is first attested in a number of pseudepigraphical texts written in Greco-Roman Egypt during the first few centuries AD. Greek-speaking alchemists often referred to their craft as \"the Art\" (τέχνη) or \"Knowledge\" (ἐπιστήμη), and it was often characterised as mystic (μυστική), sacred (ἱɛρά), or divine (θɛíα). Alchemists attempted to purify, mature, and perfect certain materials. Common aims were chrysopoeia, the transmutation of \"base metals\" (e.g., lead) into \"noble metals\" (particularly gold); the creation of an elixir of immortality; and the creation of panaceas able to cure any disease. The perfection of the human body and soul was thought to result from the alchemical magnum opus (\"Great Work\")."}, "member_count": 8, "cross_references": [{"found_name": "Chemistry", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 304, "target_cluster_name": "Chemistry", "source_book": "llm_generated", "evidence_snippet": "Alchemy is a protoscientific precursor to modern chemistry.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Alchemy is a protoscientific precursor to modern chemistry."}, {"found_name": "Astrology", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 1840, "target_cluster_name": "Astrology", "source_book": "llm_generated", "evidence_snippet": "Alchemy and astrology were closely intertwined in historical practice, often sharing practitioners and theoretical frameworks.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Alchemy and astrology were closely intertwined in historical practice, often sharing practitioners and theoretical frameworks."}, {"found_name": "Natural philosophy", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 2165, "target_cluster_name": "natural philosophy", "source_book": "llm_generated", "evidence_snippet": "Alchemy was considered a branch of natural philosophy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Alchemy was considered a branch of natural philosophy."}, {"found_name": "Classical elements", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 2703, "target_cluster_name": "Elements", "source_book": "llm_generated", "evidence_snippet": "Alchemy heavily relied on the concept of the four classical elements (earth, air, fire, water).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Alchemy heavily relied on the concept of the four classical elements (earth, air, fire, water)."}, {"found_name": "Corpuscular theory", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 1460, "target_cluster_name": "corpuscular philosophy", "source_book": "llm_generated", "evidence_snippet": "Some alchemical theories, particularly later ones, engaged with corpuscular ideas about matter.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Some alchemical theories, particularly later ones, engaged with corpuscular ideas about matter."}, {"found_name": "Archidoxis", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 3821, "target_cluster_name": "Archidoxis", "source_book": "llm_generated", "evidence_snippet": "Archidoxis refers to a specific alchemical text or body of knowledge.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Archidoxis refers to a specific alchemical text or body of knowledge."}, {"found_name": "Anatomia Sambuci", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 3867, "target_cluster_name": "Anatomia Sambuci", "source_book": "llm_generated", "evidence_snippet": "Anatomia Sambuci is a specific alchemical text.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Anatomia Sambuci is a specific alchemical text."}, {"found_name": "khachkhasch", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "diremos que árabes e deckanis chamam á papoula do ópio i^JLsr\\Là^, khaschkhasch, o «caxcax» de Orta. Tudo quanto diz respeito ao ópio, á sua composição chimica e ás suas applicações meãicinaes, á cult", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "vernacular name for poppy of opium"}, {"found_name": "caxcax", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "diremos que árabes e deckanis chamam á papoula do ópio i^JLsr\\Là^, khaschkhasch, o «caxcax» de Orta. Tudo quanto diz respeito ao ópio, á sua composição chimica e ás suas applicações meãicinaes, á cult", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "vernacular name for poppy of opium"}]}, {"canonical_name": "peſte", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 63, "members": [{"entity_id": "peſte", "book_id": "historia_medicinal_monardes_1574", "name": "peſte", "category": "DISEASE", "subcategory": "ACUTE", "count": 2, "variants": ["peſte"], "contexts": ["highly contagious epidemic disease", "plague"]}, {"entity_id": "peſte", "book_id": "polyanthea_medicinal", "name": "peſte", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 59, "variants": ["peſte", "Pefte", "Pette", "Peſte", "pefte", "peftes", "pette", "petti", "peſtis"], "contexts": ["contagious disease", "disease treated with antimony"]}, {"entity_id": "peſté", "book_id": "polyanthea_medicinal", "name": "peſté", "category": "DISEASE", "subcategory": "ACUTE", "count": 2, "variants": ["peſté"], "contexts": ["plague", "epidemic disease"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "peſte", "target_book": "polyanthea_medicinal", "target_name": "peſte", "similarity": 0.704}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "peſte", "target_book": "polyanthea_medicinal", "target_name": "peſté", "similarity": 0.926}], "id": 1532, "stable_key": "clu_a736c0e1d27e6a27", "ground_truth": {"modern_name": "Plague", "confidence": "high", "type": "disease", "modern_term": "Plague", "wikidata_id": "Q133780", "wikidata_description": "specific contagious and frequently fatal human disease caused by Yersinia pestis", "wikipedia_extract": "Plague is an infectious disease caused by the bacterium Yersinia pestis. Symptoms include fever, weakness, headache and black lips. Usually, this begins one to seven days after exposure. There are three forms of plague, each affecting a different part of the body and causing associated symptoms. Pneumonic plague infects the lungs, causing shortness of breath, coughing and chest pain; bubonic plague affects the lymph nodes, making them swell; and septicemic plague infects the blood and can cause tissues to turn black and die. The bubonic and septicemic forms are generally spread by flea bites or handling an infected animal, whereas pneumonic plague is generally spread between people through the air via infectious droplets.", "wikipedia_url": "https://en.wikipedia.org/wiki/Plague_(disease)"}, "cross_references": [{"found_name": "Buboes", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1751, "target_cluster_name": "Bubões", "source_book": "llm_generated", "evidence_snippet": "Buboes are swollen lymph nodes, a hallmark symptom of bubonic plague. They are directly related as a key clinical sign of the disease.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Buboes are swollen lymph nodes, a hallmark symptom of bubonic plague. They are directly related as a key clinical sign of the disease."}]}, {"canonical_name": "Erysipelas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 62, "members": [{"entity_id": "erysipelas", "book_id": "polyanthea_medicinal", "name": "Erysipelas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 61, "variants": ["Erysipelas", "AEryfipela", "AErytipela", "Eryfip las", "Eryfipe la", "Eryfipeladas", "Eryfipelate", "Eryfipola", "Erylipela", "Erysipel", "Erysipelamorreo", "Erysipelare", "Erysipelas baſtardas", "Erysipelas interiores", "Erysipelas legitimas", "Erysipelat", "Erysipelata", "Erysipex", "eryfipelata", "erysipelas", "erysipelate", "erysipellam"], "contexts": ["erysipelas, treated by looking at a turtle", "skin infection"]}, {"entity_id": "erysipelas", "book_id": "first_principles_spencer_1862", "name": "erysipelas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["erysipelas"], "contexts": ["bacterial skin infection"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Erysipelas", "target_book": "first_principles_spencer_1862", "target_name": "erysipelas", "similarity": 0.993}], "id": 1533, "stable_key": "clu_a06ebbbd7ca23526", "ground_truth": {"modern_name": "Erysipelas", "confidence": "high", "type": "disease", "description": "A bacterial skin infection, often on the face or legs.", "note": "Includes 'Erofulas' which is likely a misspelling or related condition.", "wikipedia_extract": "Erysipelas () is a relatively common bacterial infection of the superficial layer of the skin (upper dermis), extending to the superficial lymphatic vessels within the skin, characterized by a raised, well-defined, tender, bright-red rash, typically on the face or legs, but which can occur anywhere on the skin. It is a form of cellulitis and is potentially serious. Erysipelas is usually caused by the bacterium Streptococcus pyogenes, also known as group A, β-hemolytic streptococci, which enters the body through a break in the skin, such as a scratch or an insect bite. It is more superficial than cellulitis and is typically more raised and demarcated. The term comes from the Greek ἐρυσίπελας (erysípelas), meaning red skin. In animals, erysipelas is a disease caused by infection with the bacterium Erysipelothrix rhusiopathiae."}, "cross_references": [{"found_name": "Inflamations", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 581, "target_cluster_name": "Inflamations", "source_book": "llm_generated", "evidence_snippet": "Erysipelas is a specific type of bacterial skin infection characterized by inflammation.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Erysipelas is a specific type of bacterial skin infection characterized by inflammation.", "is_reverse": true}]}, {"canonical_name": "Quinaquina", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 61, "members": [{"entity_id": "quinquina", "book_id": "relation_historique_humboldt_vol3_1825", "name": "quinquina", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 13, "variants": ["quinquina", "Quinquina", "quinquas", "quinquinas"], "contexts": ["bark exported from the New World", "fever-reducing plant, also called cascarillas"]}, {"entity_id": "quinaquina", "book_id": "polyanthea_medicinal", "name": "Quinaquina", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 48, "variants": ["Quinaquina", "AQuinaquina", "Aquinaquin", "Qui-naquina", "Quinaqui", "quinaquina"], "contexts": ["cinchona bark", "remedy for fevers"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "quinquina", "target_book": "polyanthea_medicinal", "target_name": "Quinaquina", "similarity": 0.924}], "id": 1534, "stable_key": "clu_6683bab135541bd5", "ground_truth": {"wikipedia_extract": "Cinchona (pronounced  or ) is a genus of flowering plants in the family Rubiaceae containing at least 23 species of trees and shrubs. All are native to the tropical Andean forests of western South America. A few species are reportedly naturalized in Central America, Jamaica, French Polynesia, Sulawesi, Saint Helena in the South Atlantic, and São Tomé and Príncipe off the coast of tropical Africa, and others have been cultivated in India and Java, where they have formed hybrids. Cinchona has been historically sought after for its medicinal value, as the bark of several species yields quinine and other alkaloids. These were the only effective treatments against malaria during the height of European colonialism, which made them of great economic and political importance. Trees in the genus are also known as fever trees because of their antimalarial properties."}, "cross_references": [{"found_name": "Cinchona", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2284, "target_cluster_name": "Cinchona", "source_book": "llm_generated", "evidence_snippet": "Quinaquina is an older name for Cinchona, referring to the bark used to treat fevers.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Quinaquina is an older name for Cinchona, referring to the bark used to treat fevers.", "is_reverse": true}]}, {"canonical_name": "cobras", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 9, "total_mentions": 108, "members": [{"entity_id": "cobras", "book_id": "coloquios_da_orta_1563", "name": "cobras", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 8, "variants": ["cobras", "cobra", "cobras de capello", "cobras de capelo"], "contexts": ["creatures whose venom is treated", "reptiles that bite"]}, {"entity_id": "cobras", "book_id": "polyanthea_medicinal", "name": "cobras", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 53, "variants": ["cobras", "Cabra", "Cabras", "Cobra", "cabra", "cabras", "cobra", "cobradoBrasil"], "contexts": ["snakes", "type of snake"]}, {"entity_id": "serpents", "book_id": "english_physician_1652", "name": "Serpents", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 26, "variants": ["Serpents", "Serpent"], "contexts": ["herb good against their stinging and biting", "creatures whose bites are helped"]}, {"entity_id": "serpentes", "book_id": "coloquios_da_orta_1563", "name": "serpentes", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["serpentes", "serpentes venenosas"], "contexts": ["creatures whose venom is treated", "guardians of diamonds in Tâmara's account"]}, {"entity_id": "serpenti", "book_id": "ricettario_fiorentino_1597", "name": "serpenti", "category": "ANIMAL", "subcategory": "REPTILE", "count": 1, "variants": ["serpenti"], "contexts": ["serpents"]}, {"entity_id": "serpentes", "book_id": "polyanthea_medicinal", "name": "serpentes", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["Serpentes", "serpentes"], "contexts": ["animal used in medicine", "type of animal used in medicine"]}, {"entity_id": "serpent", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Serpent", "category": "ANIMAL", "subcategory": "REPTILE", "count": 6, "variants": ["Serpent"], "contexts": ["form of Satan's apparition", "initiated deceit"]}, {"entity_id": "serpientes", "book_id": "historia_medicinal_monardes_1574", "name": "serpientes", "category": "ANIMAL", "subcategory": "REPTILE", "count": 1, "variants": ["serpientes"], "contexts": ["venomous animals"]}, {"entity_id": "serpentarius", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Serpentarius", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Serpentarius"], "contexts": ["constellation where a star appeared", "star in, vanishing"]}, {"entity_id": "snakes", "book_id": "origin_of_species_darwin_1859", "name": "snakes", "category": "ANIMAL", "subcategory": "REPTILE", "count": 3, "variants": ["snakes"], "contexts": ["reptiles with specific body and swallowing shapes", "reptiles with rudimentary lung lobes or pelvis"]}, {"entity_id": "snakes", "book_id": "kosmos_humboldt_1845", "name": "snakes", "category": "ANIMAL", "subcategory": "REPTILE", "count": 1, "variants": ["snakes"], "contexts": ["animals suffocated by gas"]}, {"entity_id": "snakes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "snakes", "category": "ANIMAL", "subcategory": "REPTILE", "count": 1, "variants": ["snakes"], "contexts": ["venomous, specifically different in localities"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "cobras", "target_book": "polyanthea_medicinal", "target_name": "cobras", "similarity": 1.0}], "id": 1535, "stable_key": "clu_9e1fb94271015ad5", "ground_truth": {"modern_name": "Snakes", "confidence": "high", "type": "animal", "wikidata_id": "Q2102", "wikidata_description": "limbless, scaly, elongate reptile", "wikipedia_url": "https://en.wikipedia.org/wiki/Snake", "wikipedia_extract": "Snakes are elongated limbless reptiles of the suborder Serpentes. Cladistically squamates, snakes are ectothermic, amniote vertebrates covered in overlapping scales much like other members of the group. Many species of snakes have skulls with several more joints than their lizard ancestors and relatives, enabling them to swallow prey much larger than their heads (cranial kinesis). To accommodate their narrow bodies, snakes' paired organs (such as kidneys) appear one in front of the other instead of side by side, and most only have one functional lung. Some species retain a pelvic girdle with a pair of vestigial claws on either side of the cloaca. Lizards have independently evolved elongate bodies without limbs or with greatly reduced limbs at least twenty-five times via convergent evolution, leading to many lineages of legless lizards."}, "member_count": 12, "cross_references": [{"found_name": "Kings evil", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 3223, "target_cluster_name": "feffo", "source_book": "english_physician_1652", "evidence_snippet": "applied outwardly, helpeth the Kernels of the Throat, commonly called the Kings evil; or taken inwardly and applied to the place stung or bitten by any Serpent, healeth it speedily. If the Roots be br", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for Kernels of the Throat"}, {"found_name": "Rattlesnake", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2999, "target_cluster_name": "rattlesnake", "source_book": "llm_generated", "evidence_snippet": "Rattlesnakes are a specific type of venomous snake, often discussed in historical texts alongside general descriptions of snakes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Rattlesnakes are a specific type of venomous snake, often discussed in historical texts alongside general descriptions of snakes."}, {"found_name": "Viper", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 821, "target_cluster_name": "Viper", "source_book": "llm_generated", "evidence_snippet": "Vipers are a family of venomous snakes, frequently mentioned in historical contexts concerning snakes.", "confidence": 0.85, "auto_label": "llm_r