y": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Aretéo"], "contexts": ["ancient physician who studied cholera"]}, {"entity_id": "areteus", "book_id": "polyanthea_medicinal", "name": "Areteus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Areteus"], "contexts": ["ancient medical authority", "author on Cachexia"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Aretéo", "target_book": "polyanthea_medicinal", "target_name": "Areteus", "similarity": 0.919}], "id": 3204, "stable_key": "clu_c7fb94ee34ab15c9", "ground_truth": {"modern_name": "Aretaeus of Cappadocia", "confidence": "high", "type": "person", "description": "Ancient Greek physician known for his work on diseases.", "wikidata_id": "Q505931", "wikidata_description": "2nd century Greek physician"}, "cross_references": [{"found_name": "Galen", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 29, "target_cluster_name": "Galen", "source_book": "llm_generated", "evidence_snippet": "Aretaeus was a contemporary or near-contemporary of Galen, and both were significant physicians of the Roman Empire, with Aretaeus's work often compared to Galen's.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Aretaeus was a contemporary or near-contemporary of Galen, and both were significant physicians of the Roman Empire, with Aretaeus's work often compared to Galen's.", "is_reverse": true}, {"found_name": "Ætius", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1573, "target_cluster_name": "Ætius", "source_book": "llm_generated", "evidence_snippet": "Both were significant Greek physicians whose works were influential in later medical traditions.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were significant Greek physicians whose works were influential in later medical traditions.", "is_reverse": true}, {"found_name": "Medicos