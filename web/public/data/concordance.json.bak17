Y", "count": 3, "variants": ["Pétersbourg"], "contexts": ["city in Russia", "to Petersburg"]}, {"entity_id": "st__pétersbourg", "book_id": "kosmos_humboldt_1845", "name": "St. Pétersbourg", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["St. Pétersbourg"], "contexts": ["city of the Academy", "city of imperial academy"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "St. Petersburg", "target_book": "kosmos_humboldt_1845", "target_name": "St. Petersburg", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "St. Petersburg", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "St. Petersburg", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "St. Petersburg", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Petersburgh", "similarity": 0.902}, {"source_book": "principles_of_psychology_james_1890", "source_name": "St. Petersburg", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Petersburg", "similarity": 0.943}, {"source_book": "kosmos_humboldt_1845", "source_name": "St. Petersburg", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "St. Petersburg", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "St. Petersburg", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Petersburgh", "similarity": 0.902}, {"source_book": "kosmos_humboldt_1845", "source_name": "St. Petersburg", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Petersburg", "similarity": 0.943}], "id": 1181, "stable_key": "clu_330dc43f36d4acc5", "ground_truth": {"modern_name": "Saint Petersburg", "confidence": "high", "type": "place", "country": "Russia", "wikidata_id": "Q656", "wikidata_description": "federal city and former capital of Russia", "wikipedia_url": "https://en.wikipedia.org/wiki/Saint%20Petersburg", "wikipedia_extract": "Saint Petersburg, formerly known as Petrograd (Петроград) and later Leningrad (Ленинград), is the second-largest city in Russia, after Moscow, the nation's capital. It is situated on the River Neva, at the head of the Gulf of Finland on the Baltic Sea. With an area of 1,439 square kilometers (556 square miles), Saint Petersburg is the smallest administrative division of Russia by area. The city had a population of 5,601,911 residents as of 2021, with more than 6.4 million people living in the metropolitan area. Saint Petersburg is the fourth-most populous city in Europe, the most populous city on the Baltic Sea, and the world's northernmost city of more than 1 million residents. As the former capital of the Russian Empire, and a historically strategic port, it is governed as a federal city."}, "member_count": 7, "cross_references": [{"found_name": "Baltic Sea", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 319, "target_cluster_name": "Baltic", "source_book": "llm_generated", "evidence_snippet": "Saint Petersburg is situated at the head of the Gulf of Finland on the Baltic Sea.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Saint Petersburg is situated at the head of the Gulf of Finland on the Baltic Sea."}]}, {"canonical_name": "surface", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "surface", "book_id": "principles_of_psychology_james_1890", "name": "surface", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["surface"], "contexts": ["outer layer of a structure"]}, {"entity_id": "superficie_do_corpo", "book_id": "polyanthea_medicinal", "name": "superficie do corpo", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["superficie do corpo"], "contexts": ["surface of the body", "body part affected by acids"]}, {"entity_id": "surface", "book_id