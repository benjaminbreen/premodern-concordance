unt": 2, "total_mentions": 4, "members": [{"entity_id": "heartsease", "book_id": "english_physician_1652", "name": "Heartsease", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Heartsease"], "contexts": ["herb with properties like violets"]}, {"entity_id": "heartsease", "book_id": "origin_of_species_darwin_1859", "name": "heartsease", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["heartsease"], "contexts": ["plant with distinct flowers and leaves", "plant variety showing improvement"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Heartsease", "target_book": "origin_of_species_darwin_1859", "target_name": "heartsease", "similarity": 0.98}], "id": 2971, "stable_key": "clu_5dd101c1ffab6fc7", "ground_truth": {"wikipedia_extract": "Viola tricolor is a common European wild flower, growing as an annual or short-lived perennial. The species is also known as wild pansy, Johnny Jump up (though this name is also applied to similar species such as the yellow pansy), heartsease, heart's ease, heart's delight, tickle-my-fancy, Jack-jump-up-and-kiss-me, come-and-cuddle-me, three faces in a hood, love-in-idleness, and pink of my john. It has been introduced into North America, where it has spread. It is the progenitor of the cultivated pansy, and is therefore sometimes called wild pansy; before the cultivated pansies were developed, \"pansy\" was an alternative name for the wild form. It can produce up to 50 seeds at a time. The flowers can be purple, blue, yellow or white."}, "cross_references": [{"found_name": "Viole", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 1644, "target_cluster_name": "Viole", "source_book": "llm_generated", "evidence_snippet": "Heartsease is a common name for certain species within the genus Viola, which is the genus for Violet.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Heartsease is a common name for certain species within the genus Viola, which is the genus for Violet.", "is_reverse": true}]}, {"canonical_name": "groups", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "groups", "book_id": "origin_of_species_darwin_1859", "name": "groups", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["groups"], "contexts": ["collections of similar entities", "whole groups would tend slowly to disappear"]}, {"entity_id": "groups", "book_id": "principles_of_psychology_james_1890", "name": "groups", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["groups"], "contexts": ["collections of people whose opinions matter"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "groups", "target_book": "principles_of_psychology_james_1890", "target_name": "groups", "similarity": 1.0}], "id": 2972, "stable_key": "clu_b04842855661b834", "ground_truth": {"modern_name": "group", "confidence": "high", "type": "concept"}, "cross_references": []}, {"canonical_name": "fur", "category": "SUBSTANCE", "subcategory": "PRODUCT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "fur", "book_id": "origin_of_species_darwin_1859", "name": "fur", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 3, "variants": ["fur"], "contexts": ["thickness influenced by climate", "hair covering of mammals"]}, {"entity_id": "fur", "book_id": "first_principles_spencer_1862", "name": "fur", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 1, "variants": ["fur"], "contexts": ["thick hair covering of mammals"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "fur", "target_book": "first_principles_spencer_1862", "target_name": "fur", "similarity": 1.0}], "id": 2973, "stable_key": "clu_2029fc047ef77057", "ground_truth": {"modern_name": "Fur", "confidence": "high", "type": "concept", "note": "Refers to the thick hair covering of mammals.", "wikidata_id": "Q197204", "wikidata_description": "thick growth of hair that covers the skin of many different animals, particularly mammals", "wikipedia_extract": "A fur is a soft, thick growth of hair that covers the skin of almost all mammals. It consists of a combination of oily guard hair on top and thick underfur beneath. The guard hair keeps moisture from reaching the skin; the underfur acts as an insulating blanket that keeps the animal warm. The fur of mammals has many purposes: protection, sensory, waterproofing, and camouflaging, with the primary purpose being thermoregulation. The types of hair include definitive, which may be shed after reaching a certain length; vibrissae, which are sensory hairs and are most commonly whiskers; pelage, which consists of guard hairs, under-fur, and awn hair; spines, which are a type of stiff guard hair used for defense in, for example, porcupines; bristles, which are long hairs usually used in visual signals, such as the mane of a lion; velli, often called \"down fur\", which insulates newborn mammals; and wool, which is long, soft, and often curly. Hair length is unimportant in thermoregulation, as some tropical mammals, such as sloths, have the same fur length as some arctic mammals but with less insulation; and, conversely, other tropical mammals with short hair have the same insulating value as arctic mammals.", "wikipedia_url": "https://en.wikipedia.org/wiki/Fur"}, "cross_references": []}, {"canonical_name": "domestic breeds", "category": "CONCEPT", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "domestic_breeds", "book_id": "origin_of_species_darwin_1859", "name": "domestic breeds", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["domestic breeds"], "contexts": ["animals selectively bred by humans", "distinct varieties of domesticated animals"]}, {"entity_id": "raças_domesticas", "book_id": "coloquios_da_orta_1563", "name": "raças domesticas", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["raças domesticas"], "contexts": ["domestic animal breeds, source of bezoars"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "domestic breeds", "target_book": "coloquios_da_orta_1563", "target_name": "raças domesticas", "similarity": 0.953}], "id": 2974, "stable_key": "clu_607c5b9b707bc92f", "ground_truth": {"modern_name": "domestic breeds", "confidence": "high", "type": "animal"}, "cross_references": []}, {"canonical_name": "bull-dog", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "bull-dog", "book_id": "origin_of_species_darwin_1859", "name": "bull-dog", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 3, "variants": ["bull-dog"], "contexts": ["domesticated dog breed", "breed of dog"]}, {"entity_id": "pug-dog", "book_id": "principles_of_psychology_james_1890", "name": "pug-dog", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["pug-dog"], "contexts": ["dog feared by children"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "bull-dog", "target_book": "principles_of_psychology_james_1890", "target_name": "pug-dog", "similarity": 0.927}], "id": 2975, "stable_key": "clu_bf5dfaca77d88e03", "ground_truth": {"modern_name": "Bulldog", "confidence": "high", "type": "animal", "note": "The text mentions both 'bull-dog' and 'pug-dog', but 'bull-dog' is more prevalent and clearly refers to the breed.", "wikidata_id": "Q1999293", "wikidata_description": "1927 fighter aircraft family by Bristol"}, "cross_references": []}, {"canonical_name": "skulls", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "skulls", "book_id": "origin_of_species_darwin_1859", "name": "skulls", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["skull