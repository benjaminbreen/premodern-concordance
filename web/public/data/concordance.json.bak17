911}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Male", "target_book": "origin_of_species_darwin_1859", "target_name": "male", "similarity": 0.994}], "id": 1858, "stable_key": "clu_82b1e1573626b441", "ground_truth": {"modern_name": "Human male", "confidence": "high", "type": "concept", "note": "The cluster encompasses discussions of 'man', 'Male', and 'male' in the context of biological sex and the human species.", "wikidata_id": "Q6581097", "wikidata_description": "to be used in \"sex or gender\" (P21) to indicate that the human subject is a male or \"semantic gender\" (P10339) to indicate that a word refers to a male person"}, "cross_references": []}, {"canonical_name": "arsenicum", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 5, "total_mentions": 20, "members": [{"entity_id": "arsenico", "book_id": "ricettario_fiorentino_1597", "name": "Arsenico", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["Arsenico", "Arfenico"], "contexts": ["Greek name for Orpimento", "arsenic ingredient"]}, {"entity_id": "arsenicum", "book_id": "polyanthea_medicinal", "name": "arsenicum", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 10, "variants": ["arsenicum", "Arfeni", "Arfenico", "Arfenicum", "Arsenicum", "arseni", "arsenico"], "contexts": ["mineral used in medicine", "applied to the heart region"]}, {"entity_id": "arsenic", "book_id": "principles_of_psychology_james_1890", "name": "arsenic", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["arsenic"], "contexts": ["remedy compared to phosphorus"]}, {"entity_id": "arsenic", "book_id": "kosmos_humboldt_1845", "name": "arsenic", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["arsenic"], "contexts": ["chemical element in meteoric masses", "metal found in volcanic products"]}, {"entity_id": "arsenic", "book_id": "connexion_physical_sciences_somerville_1858", "name": "arsenic", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["arsenic"], "contexts": ["chemical element with specific properties", "body with low diamagnetic power"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Arsenico", "target_book": "polyanthea_medicinal", "target_name": "arsenicum", "similarity": 0.915}], "id": 1859, "stable_key": "clu_acfd9a3bf9f1e319-2", "ground_truth": {"modern_name": "arsenic", "confidence": "high", "type": "mineral", "description": "A toxic metalloid element used historically in medicine and alchemy.", "wikipedia_extract": "Arsenic is a chemical element; it has the symbol As and atomic number 33. It is a metalloid and one of the pnictogens, and therefore shares many properties with its group 15 neighbors phosphorus and antimony. Arsenic is notoriously toxic. It occurs naturally in many minerals, usually in combination with sulfur and metals, but also as a pure elemental crystal. It has various allotropes, but only the grey form, which has a metallic appearance, is important to industry. The primary use of arsenic is in alloys of lead (for example, in car batteries and ammunition)."}, "member_count": 5, "cross_references": [{"found_name": "epithimas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1914, "target_cluster_name": "epithimas", "source_book": "llm_generated", "evidence_snippet": "Arsenic, like antimony, was a substance frequently employed in alchemical and medicinal preparations, and epithyme could be found in similar contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Arsenic, like antimony, was a substance frequently employed in alchemical and medicinal preparations, and epithyme could be found in similar contexts.", "is_reverse": true}]}, {"canonical_name": "ber", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 4, "total_mentions": 22, "members": [{"entity_id": "beril", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Beril", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Beril"], "contexts": ["mineral with attractive quality"]}, {"entity_id": "ber", "book_id": "coloquios_da_orta_1563", "name": "ber", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 14, "variants": ["ber", "Ber"], "contexts": ["Fruit name in Decam", "location mentioned in passage"]}, {"entity_id": "beryls", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Beryls", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["Beryls"], "contexts": ["gemstone", "stones subject to fusion in fire"]}, {"entity_id": "beryls", "book_id": "kosmos_humboldt_1845", "name": "beryls", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["beryls"], "contexts": ["magnificent crystals"]}, {"entity_id": "beryl", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Beryl", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Beryl"], "contexts": ["gem"]}, {"entity_id": "beryl", "book_id": "connexion_physical_sciences_somerville_1858", "name": "beryl", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["beryl"], "contexts": ["negative crystal with two optic axes", "crystal with optical properties"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Beril", "target_book": "coloquios_da_orta_1563", "target_name": "ber", "similarity": 0.904}], "id": 1860, "stable_key": "clu_b4d3dd044c7755fe", "ground_truth": {"modern_name": "beryl", "confidence": "high", "type": "mineral", "wikidata_id": "Q569", "wikidata_description": "chemical element with symbol Be and atomic number 4", "wikipedia_url": "https://en.wikipedia.org/wiki/Beryllium", "wikipedia_extract": "Beryl ( BERR-əl) is a mineral composed of beryllium aluminium silicate with the chemical formula Be3Al2(SiO3)6. Well-known varieties of beryl include emerald and aquamarine. Naturally occurring  hexagonal crystals of beryl can be up to several meters in size, but terminated crystals are relatively rare. Pure beryl is colorless, but it is frequently tinted by impurities; possible colors are green, blue, yellow, pink, and red (the rarest). It is an ore source of beryllium. The word beryl – Middle English: beril – is borrowed, via Old French: beryl and Latin: beryllus, from Ancient Greek βήρυλλος bḗryllos, which referred to various blue-green stones, from Prakrit veruḷiya, veḷuriya 'beryl' which is ultimately of Dravidian origin, maybe from the name of Belur or Velur, a town in Karnataka, southern India."}, "member_count": 6, "cross_references": [{"found_name": "emerald", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 107, "target_cluster_name": "esmeralda", "source_book": "llm_generated", "evidence_snippet": "Emerald is a well-known variety of beryl.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Emerald is a well-known variety of beryl."}]}, {"canonical_name": "Meadows", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "meadows", "book_id": "english_physician_1652", "name": "Meadows", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 14, "variants": ["Meadows", "Meadowes"], "contexts": ["habitat for Ladies-Bedstraw", "natural habitat for plants"]}, {"entity_id": "meadows", "book_id": "connexion_physical_sciences_somerville_1858", "name": "meadows", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["meadows"], "contexts": ["grasslands often near water"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Meadows", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "meadows", "similarity": 0.936}], "id": 1861, "stable_key": "clu_b3235b8f2e7b13e9", "ground_truth": {"modern_name": "Meadow", "confidence": "high", "type": "place", "wikidata_id": "Q25062", "wikidata_description": "species of plant in the Rutaceae family"}, "cross_references": [{"found_name": "Springs", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3927, "target_cluster_name": "Springs", "source_book": "llm_generated", "evidence_snippet": "Springs are often found within or are the source of water for meadows, creating a close geographical and ecological relationship.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Springs are often found within or are the source of water for meadows, creating a close geographical and ecological relationship."}, {"found_name": "sargassa", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "connexion_physical_sciences_somerville_1858", "evidence_snippet": "that accumulation known as the sargassa or grassy sea is so great, that the early navigators, Columbus and Lerius, compared it to extensively inundated meadows: it impeded their ships, and alarmed the", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for grassy sea"}, {"found_name": "grassy sea", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "connexion_physical_sciences_somerville_1858", "evidence_snippet": "that accumulation known as the sargassa or grassy sea is so great, that the early navigators, Columbus and Lerius, compared it to extensively inundated meadows: it impeded their ships, and alarmed the", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "alternative name for sargassa"}]}, {"canonical_name": "tormentilla", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "tormentil", "book_id": "english_physician_1652", "name": "Tormentil", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Tormentil"], "contexts": ["plant with reddish branches and yellow flowers", "herb with medicinal properties"]}, {"entity_id": "tormentilla", "book_id": "polyanthea_medicinal", "name": "tormentilla", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 12, "variants": ["tormentilla", "Tormentila", "tormen"], "contexts": ["used in ointment", "tormentil used in unguent"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Tormentil", "target_book": "polyanthea_medicinal", "target_name": "tormentilla", "similarity": 0.937}], "id": 1862, "stable_key": "clu_e279a63e24e7c7fa", "ground_truth": {"modern_name": "Tormentil", "confidence": "high", "type": "plant", "linnaean": "Potentilla erecta", "family": "Rosaceae", "description": "A herbaceous perennial plant with medicinal properties, used in ointments.", "note": "Includes variations in Spanish and English.", "wikipedia_extract": "Potentilla erecta (syn. Tormentilla erecta, Potentilla laeta, Potentilla tormentilla, known as the (common) tormentil, septfoil or erect cinquefoil ) is a herbaceous perennial plant belonging to the rose family (Rosaceae). Potentilla erecta is a low, clump-forming plant with slender, procumbent to arcuately upright stalks, growing 10–30 centimetres (3.9–11.8 in) tall and with non-rooting runners. It grows wild predominantly in Europe and western Asia[1], mostly on acid soils and in a wide variety of habitats such as mountains, heaths, meadows, sandy soils and dunes. This plant flowers from May to August/September. There is one yellow, 7–11 millimetres (0.28–0.43 in) wide flower, growing at the tip of a long stalk."}, "cross_references": [{"found_name": "equiceto", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 4506, "target_cluster_name": "Cauda equina", "source_book": "polyanthea_medicinal", "evidence_snippet": "vezes. Secom afebre houver fluxo de almorreymas , ou de mezes, ou houver ſangue pelaboca ,poderemos ajuntar ao cozimento das Tizanas huma oytavade naiz de tormentilla , huma pouca Tratado II. Cap. СХ.", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for polygonum"}, {"found_name": "wild rose", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 3315, "target_cluster_name": "wild Roses", "source_book": "llm_generated", "evidence_snippet": "Tormentil (Potentilla erecta) is a species within the rose family (Rosaceae), and 'wild rose' is a related common name for plants in the same family.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Tormentil (Potentilla erecta) is a species within the rose family (Rosaceae), and 'wild rose' is a related common name for plants in the same family."}, {"found_name": "rabo de cavallo", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 4506, "target_cluster_name": "Cauda equina", "source_book": "polyanthea_medicinal", "evidence_snippet": "vezes. Secom afebre houver fluxo de almorreymas , ou de mezes, ou houver ſangue pelaboca ,poderemos ajuntar ao cozimento das Tizanas huma oytavade naiz de tormentilla , huma pouca Tratado II. Cap. СХ.", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "vernacular name for equiceto"}, {"found_name": "ervä chamada rabo de cavallo", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 4506, "target_cluster_name": "Cauda equina", "source_book": "polyanthea_medicinal", "evidence_snippet": "virgem ,& deſtes uſem , que lao excellentiffimos. 12. Outrosſedeytãopara conſolidar ,& ſe chamão Confolidantes , & fe preparãoderaizes de verbafco, &de tormentilla , de cada coufa destas huma onça, de", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "vernacular name for an unnamed herb"}, {"found_name": "rabo de cavallo", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": null, "target_cluster_name": null, "source_book": "polyanthea_medicinal", "evidence_snippet": "algumas vezes. Secom afebre houver fluxo de almorreymas , ou de mezes, ou houver ſangue pelaboca ,poderemos ajuntar ao cozimento das Tizanas huma oytavade naiz de tormentilla , huma pouca Tratado II. ", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "vernacular name for equiceto"}]}, {"canonical_name": "Pistil", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "pistil", "book_id": "origin_of_species_darwin_1859", "name": "Pistil", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["pistil", "Pistil"], "contexts": ["female reproductive part of a flower", "female reproductive organ of a flower"]}, {"entity_id": "pistils", "book_id": "origin_of_species_darwin_1859", "name": "pistils", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["pistils"], "contexts": ["female reproductive part of a flower", "female reproductive organs of a flower"]}, {"entity_id": "pistil", "book_id": "first_principles_spencer_1862", "name": "pistil", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["pistil"], "contexts": ["part of a flower"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Pistil", "target_book": "first_principles_spencer_1862", "target_name": "pistil", "similarity": 0.793}, {"source_book": "origin_of_species_darwin_1859", "source_name": "pistils", "target_book": "first_principles_spencer_1862", "target_name": "pistil", "similarity": 0.915}], "id": 1863, "stable_key": "clu_a5d24fc2cfdb918d", "ground_truth": {"modern_name": "Pistil", "confidence": "high", "type": "plant", "family": "N/A", "note": "One instance of 'pith' is likely an OCR or transcription error given the strong context of 'pistil' and its plural.", "wikidata_id": "Q108226839", "wikidata_description": "species of fungi in the genus Pistillaria", "wikipedia_extract": "Gynoecium (; from Ancient Greek  γυνή (gunḗ) 'woman, female' and  οἶκος (oîkos) 'house', pl. gynoecia) is most commonly used as a collective term for the parts of a flower that produce ovules and ultimately develop into the fruit and seeds. The gynoecium is the innermost whorl of a flower; it consists of (one or more) pistils and is typically surrounded by the pollen-producing reproductive organs, the stamens, collectively called the androecium. The gynoecium is often referred to as the \"female\" portion of the flower, although rather than directly producing female gametes (i.e. egg cells), the gynoecium produces megaspores, each of which develops into a female gametophyte which then produces egg cells. The term gynoecium is also used by botanists to refer to a cluster of archegonia and any associated modified leaves or stems present on a gametophyte shoot in mosses, liverworts, and hornworts. The corresponding terms for the male parts of those plants are clusters of antheridia within the androecium. Flowers that bear a gynoecium but no stamens are called pistillate or carpellate."}, "cross_references": [{"found_name": "flower", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 150, "target_cluster_name": "flower", "source_book": "llm_generated", "evidence_snippet": "The pistil is the female reproductive part of a flower.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The pistil is the female reproductive part of a flower.", "is_reverse": true}, {"found_name": "Corolla", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4453, "target_cluster_name": "corollas", "source_book": "llm_generated", "evidence_snippet": "The pistil is a part of a flower, and the corolla is another part of the flower.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The pistil is a part of a flower, and the corolla is another part of the flower."}, {"found_name": "petals", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2726, "target_cluster_name": "petals", "source_book": "llm_generated", "evidence_snippet": "The pistil is a part of a flower, and petals are another part of the flower.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The pistil is a part of a flower, and petals are another part of the flower."}]}, {"canonical_name": "Potosi", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "potosi", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Potosi", "category": "PLACE", "subcategory": "CITY", "count": 14, "variants": ["Potosi"], "contexts": ["city in South America", "city in Bolivia"]}, {"entity_id": "potosi", "book_id": "kosmos_humboldt_1845", "name": "Potosi", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Potosi"], "contexts": ["town with causeway"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Potosi", "target_book": "kosmos_humboldt_1845", "target_name": "Potosi", "similarity": 1.0}], "id": 1864, "stable_key": "clu_1e5edf8639026d87", "ground_truth": {"modern_name": "Potosí", "confidence": "high", "type": "place", "country": "Bolivia", "wikidata_id": "Q378135", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Potos%C3%AD", "wikipedia_extract": "Potosí, known as Villa Imperial de Potosí in the colonial period, is the capital city and a municipality of the Department of Potosí in Bolivia. It is one of the highest cities in the world at a nominal 4,067 m (13,343 ft). Diego Huallpa, an indigenous prospector, is traditionally credited with the discovery of the Cerro Rico in 1545, which led to the founding and rapid growth of Potosí due to its extraordinary silver wealth. For centuries, it was the location of the Spanish colonial silver mint. A considerable amount of the city's colonial architecture has been preserved in the historic center of the city, which—along with the globally important Cerro Rico de Potosí—are part of a designated UNESCO World Heritage Site. Potosí lies at the foot of the Cerro de Potosí—sometimes referred to as the Cerro Rico (\"rich mountain\")—a mountain popularly conceived of as being \"made of\" silver ore that dominates the city."}, "cross_references": [{"found_name": "Andes", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 207, "target_cluster_name": "Andes", "source_book": "llm_generated", "evidence_snippet": "Potosí is located in the Andes mountain range, a significant geographical feature of South America.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Potosí is located in the Andes mountain range, a significant geographical feature of South America."}]}, {"canonical_name": "Maniquarez", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "maniquarez", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Maniquarez", "category": "PLACE", "subcategory": "CITY", "count": 14, "variants": ["Maniquarez"], "contexts": ["schistose cordillera where alum mine might be", "village near Laguna chica"]}, {"entity_id": "maniquarez", "book_id": "kosmos_humboldt_1845", "name": "Maniquarez", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Maniquarez"], "contexts": ["peninsula with mica slate rocks"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Maniquarez", "target_book": "kosmos_humboldt_1845", "target_name": "Maniquarez", "similarity": 0.867}], "id": 1865, "stable_key": "clu_71f712456b457f28", "ground_truth": {"modern_name": "Manicuare", "confidence": "high", "type": "place", "country": "Venezuela", "note": "The spelling varies slightly between Maniquarez and Manicuare, but Manicuare is the modern and geographically recognized name for the peninsula."}, "cross_references": []}, {"canonical_name": "Pasto", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "pasto", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Pasto", "category": "PLACE", "subcategory": "CITY", "count": 12, "variants": ["Pasto"], "contexts": ["mountainous population center in Colombia", "city serving southern missions"]}, {"entity_id": "pasto", "book_id": "kosmos_humboldt_1845", "name": "Pasto", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Pasto"], "contexts": ["part of a mountain chain", "volcano in South America"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pasto", "target_book": "kosmos_humboldt_1845", "target_name": "Pasto", "similarity": 1.0}], "id": 1866, "stable_key": "clu_7f865827b551ac4f", "ground_truth": {"modern_name": "Pasto", "confidence": "high", "type": "place", "country": "Colombia", "wikipedia_extract": "Pashto (, PASH-toh; پښتو, Pəx̌tó, [pəʂˈto, pʊxˈto, pəʃˈto, pəçˈto]) is an eastern Iranian language in the Indo-European language family, natively spoken in northwestern Pakistan and  southern and eastern Afghanistan. It has official status in Afghanistan. It is known in historical Persian literature as Afghani (افغانی, Afghāni). Spoken as a native language mostly by ethnic Pashtuns, it is one of the two official languages of Afghanistan alongside Dari, and it is spoken as the second-largest provincial language in Pakistan, spoken mainly in Khyber Pakhtunkhwa and the northern districts of Balochistan. Likewise, it is the primary language of the Pashtun diaspora around the world. The total number of Pashto-speakers is at least 40 million, although some estimates place it as high as 60 million.", "wikipedia_url": "https://en.wikipedia.org/wiki/Pashto"}, "cross_references": []}, {"canonical_name": "Antisana", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "antisana", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Antisana", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 11, "variants": ["Antisana", "Antimano", "Antimauo"], "contexts": ["snowy peak in Cordillera Oriental", "mountain height"]}, {"entity_id": "antisana", "book_id": "kosmos_humboldt_1845", "name": "Antisana", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Antisana"], "contexts": ["specific high point on the Andes", "mountain with significant elevation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Antisana", "target_book": "kosmos_humboldt_1845", "target_name": "Antisana", "similarity": 1.0}], "id": 1867, "stable_key": "clu_7adc7bc7ba781344", "ground_truth": {"modern_name": "Antisana", "confidence": "high", "type": "place", "country": "Ecuador", "wikidata_id": "Q4742194", "wikidata_description": "a protected area in Ecuador situated in the Napo Province, Quijos Canton and Archidona Canton", "wikipedia_url": "https://en.wikipedia.org/wiki/Antisana_Ecological_Reserve", "wikipedia_extract": "Antisana Ecological Reserve (Spanish: Reserva Ecológica Antisana) is a protected area in Ecuador situated in the Napo Province, Quijos Canton and Archidona Canton. Rare animals and plants found in or near the reserve include: White-fronted spider monkey (Ateles belzebuth) – Endangered Northern pudu (Pudu mephistophiles) – Vulnerable Mountain tapir (Tapirus pinchaque) – Endangered Spectacled bear (\"Tremarctos ornatus\") – Vulnerable Oncilla (Leopardus tigrinus) – Vulnerable Bush dog (Speothos venaticus) – Near Threatened Wattled guan (Aburria aburri) – Near Threatened Fuegian snipe (Gallinago stricklandii) – Near Threatened Andean condor (Vultur gryphus) – Near Threatened Spot-winged parrotlet (Touit stictopterus) – Vulnerable Greater scythebill (Campylorhamphus pucherani) – Near Threatened Southeastern giant antpitta, Grallaria gigantea gigantea – Vulnerable Giant conebill (Oreomanes fraseri) – Near Threatened Napo plump toad (Osornophryne antisana) – Endangered Senecio antisanae / Senecio iscoensis (= Aetheolaena senecioides?) – Data Deficient Other notable flora and fauna of the park are, for example: Silvery grebe (Podiceps occipitalis) Black-faced ibis (Theristicus melanopis) www.enjoyecuador.net / Antisana Ecological Reserve (Spanish) www.ambiente.gov."}, "cross_references": [{"found_name": "Andes", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 207, "target_cluster_name": "Andes", "source_book": "llm_generated", "evidence_snippet": "Antisana is a stratovolcano in the Andes mountain range.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Antisana is a stratovolcano in the Andes mountain range.", "is_reverse": true}, {"found_name": "Quito", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 210, "target_cluster_name": "Quito", "source_book": "llm_generated", "evidence_snippet": "Antisana is a volcano located east of Quito, Ecuador. It is a prominent geographical feature in the region and often mentioned in relation to Quito's landscape and environment.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Antisana is a volcano located east of Quito, Ecuador. It is a prominent geographical feature in the region and often mentioned in relation to Quito's landscape and environment.", "is_reverse": true}, {"found_name": "volcans", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 602, "target_cluster_name": "volcans", "source_book": "llm_generated", "evidence_snippet": "Antisana is a volcano in Ecuador, and Volcano is a CDP in Hawaii known for its proximity to Kīlauea, an active volcano. Both entities are related to the geological phenomenon of volcanoes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Antisana is a volcano in Ecuador, and Volcano is a CDP in Hawaii known for its proximity to 