id": "polyanthea_medicinal", "name": "Sarna", "category": "DISEASE", "subcategory": "CHRONIC", "count": 5, "variants": ["Sarna", "Sarna antiga", "sarna"], "contexts": ["severe skin condition", "skin disease, scabies"]}, {"entity_id": "ſarna", "book_id": "historia_medicinal_monardes_1574", "name": "ſarna", "category": "DISEASE", "subcategory": "CHRONIC", "count": 3, "variants": ["ſarna"], "contexts": ["skin disease", "skin disease cured by sulphur"]}, {"entity_id": "ſarna", "book_id": "polyanthea_medicinal", "name": "ſarna", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["ſarna"], "contexts": ["scabies, a skin condition", "condition treated by unguent"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Itch", "target_book": "polyanthea_medicinal", "target_name": "Itch", "similarity": 0.935}, {"source_book": "english_physician_1652", "source_name": "itching", "target_book": "polyanthea_medicinal", "target_name": "Itch", "similarity": 0.881}, {"source_book": "english_physician_1652", "source_name": "itching", "target_book": "first_principles_spencer_1862", "target_name": "itching", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "Itch", "target_book": "first_principles_spencer_1862", "target_name": "itching", "similarity": 0.881}], "id": 610, "stable_key": "clu_db2f6d794e1c6447", "ground_truth": {"modern_name": "Scabies", "confidence": "high", "type": "disease", "modern_term": "Scabies", "wikidata_id": "Q167178", "wikidata_description": "human disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Scabies", "note": "The early modern term 'itch' encompassed both the symptom of itching and specific conditions like scabies. Given the context of skin conditions and affections, scabies is the most likely specific disease referent.", "wikipedia_extract": "Scabies (, SKAY-beez; also sometimes known as the seven-year itch) is a contagious human skin infestation by the tiny (0.2–0.45 mm) mite Sarcoptes scabiei, variety hominis. The word is from Latin: scabere, lit. 'to scratch'. It is a particular public health problem in crowded settings such as care homes, schools, refugee camps, prisons, and hospitals. The most common symptoms are severe itchiness and a pimple-like rash. Occasionally, tiny burrows may appear on the skin from eggs that are about to hatch."}, "member_count": 9, "cross_references": [{"found_name": "Scab", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2954, "target_cluster_name": "Scab", "source_book": "llm_generated", "evidence_snippet": "The provided description explicitly states that 'Itch' is a historical name for Scabies, and 'Scab' is listed as an alias for Scabies in the candidate list.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "The provided description explicitly states that 'Itch' is a historical name for Scabies, and 'Scab' is listed as an alias for Scabies in the candidate list."}, {"found_name": "lepra", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 579, "target_cluster_name": "lepra", "source_book": "historia_medicinal_monardes_1574", "evidence_snippet": "las coſas que del reſultan, Arm grandeobra,que ſea vniuerſal,o que ſea particu delcuera lar:enlacabeca,olo que llaman Mirarchia:y aſsi po. enlosquetienz Lepra,delos Arabes, o Elepan cialis de los Grie", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "reverse: synonym for itching/infection of the skin, related to Lepra", "is_reverse": true}, {"found_name": "coſtras", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2226, "target_cluster_name": "coſtras", "source_book": "llm_generated", "evidence_snippet": "Scabs are a common symptom or manifestation of scabies, a skin infestation.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Scabs are a common symptom or manifestation of scabies, a skin infestation.", "