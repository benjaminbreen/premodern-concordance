PLACE", "count": 2, "variants": ["fuentes"], "contexts": ["fountains created with artifice", "springs, sources of water"]}, {"entity_id": "fonti", "book_id": "ricettario_fiorentino_1597", "name": "fonti", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["fonti"], "contexts": ["water from springs", "source of water"]}, {"entity_id": "fonte", "book_id": "polyanthea_medicinal", "name": "fonte", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 7, "variants": ["fonte", "da fonte"], "contexts": ["opening a vein for evacuation", "medical procedure"]}, {"entity_id": "sources", "book_id": "connexion_physical_sciences_somerville_1858", "name": "sources", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["sources"], "contexts": ["origin points of rivers"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "fuentes", "target_book": "ricettario_fiorentino_1597", "target_name": "fonti", "similarity": 0.962}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "fuentes", "target_book": "polyanthea_medicinal", "target_name": "fonte", "similarity": 0.93}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "fuentes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sources", "similarity": 0.979}, {"source_book": "ricettario_fiorentino_1597", "source_name": "fonti", "target_book": "polyanthea_medicinal", "target_name": "fonte", "similarity": 0.934}, {"source_book": "ricettario_fiorentino_1597", "source_name": "fonti", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sources", "similarity": 0.932}, {"source_book": "polyanthea_medicinal", "source_name": "fonte", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sources", "similarity": 0.923}], "id": 394, "stable_key": "clu_ded853f50da531aa", "ground_truth": {"modern_name": "Spring", "confidence": "high", "type": "place", "description": "A source of water, often from underground.", "note": "Encompasses natural water sources and the concept of a source.", "wikipedia_extract": "Geography (from Ancient Greek γεωγραφία geōgraphía; combining gê 'Earth' and gráphō 'write', literally 'Earth writing') is the study of the lands, features, inhabitants, and phenomena of Earth. Geography is an all-encompassing discipline that seeks an understanding of Earth and its human and natural complexities—not merely where objects are, but also how they have changed and come to be. While geography is specific to Earth, many concepts can be applied more broadly to other celestial bodies in the field of planetary science. Geography has been called \"a bridge between natural science and social science disciplines.\" The history of geography as a discipline spans cultures and millennia, being independently developed by multiple groups, and cross-pollinated by trade between these groups. Geography as a discipline dates back to the earliest attempts to understand the world spatially, with the earliest example of an attempted world map dating to the 9th century BC in ancient Babylon. Origins of many of the concepts in geography can be traced to Greek Eratosthenes of Cyrene, who may have coined the term \"geographia\" (c. 276 BC – c. 195/194 BC)."}, "cross_references": [{"found_name": "Chaudes-Aigues", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3653, "target_cluster_name": "Chaudes Aigues", "source_book": "llm_generated", "evidence_snippet": "Chaudes-Aigues is a commune in the Cantal department in south-central France, known for its hot springs. The entity 'Spring' (fonte) can refer to a natural source of water, often associated with geological features like those found in Chaudes-Aigues.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Chaudes-Aigues is a commune in the Cantal department in south-central France, known for its hot springs. The entity 'Spring' (fonte) can refer to a natural source of water, often associated with geological features like those found in Chaudes-Aigues."}]}, {"canonical_name": "Hawks", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 4, "total_mentions": 11, "members": [{"entity_id": "hawks", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Hawks", "category": "ANIMAL", "subcategory": "BIRD", "count": 4, "variants": ["Hawks"], "contexts": ["animal whose talons were tested for electricity", "have peculiar vermine"]}, {"entity_id": "hawk", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Hawk", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["Hawk"], "contexts": ["predator causing birds to be silent"]}, {"entity_id": "hawks", "book_id": "origin_of_species_darwin_1859", "name": "hawks", "category": "ANIMAL", "subcategory": "BIRD", "count": 3, "variants": ["hawks"], "contexts": ["predatory birds that hunt by sight", "birds of prey that hunt other birds"]}, {"entity_id": "hawks", "book_id": "principles_of_psychology_james_1890", "name": "hawks", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["hawks"], "contexts": ["raptorial birds"]}, {"entity_id": "hawk", "book_id": "first_principles_spencer_1862", "name": "hawk", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["hawk"], "contexts": ["bird of prey", "bird of prey whose appearance causes destruction"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hawks", "target_book": "origin_of_species_darwin_1859", "target_name": "hawks", "similarity": 0.948}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hawks", "target_book": "principles_of_psychology_james_1890", "target_name": "hawks", "similarity": 0.948}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hawk", "target_book": "first_principles_spencer_1862", "target_name": "hawk", "similarity": 0.951}, {"source_book": "origin_of_species_darwin_1859", "source_name": "hawks", "target_book": "principles_of_psychology_james_1890", "target_name": "hawks", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "hawks", "target_book": "first_principles_spencer_1862", "target_name": "hawk", "similarity": 0.93}, {"source_book": "principles_of_psychology_james_1890", "source_name": "hawks", "target_book": "first_principles_spencer_1862", "target_name": "hawk", "similarity": 0.93}], "id": 395, "stable_key": "clu_faba8ad364c6cdd2", "ground_truth": {"wikipedia_extract": "Hawks are birds of prey of the family Accipitridae. They are very widely distributed and are found on all continents, except Antarctica. The subfamily Accipitrinae includes goshawks, sparrowhawks, sharp-shinned hawks, and others. This subfamily are mainly woodland birds with short broad wings, long tails, and high visual acuity. They hunt by dashing suddenly from a concealed perch. In the United States, members of the Buteo group are also called hawks, though birds of this group are called buzzards in other parts of the world."}, "cross_references": [{"found_name": "aves", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2148, "target_cluster_name": "aves", "source_book": "llm_generated", "evidence_snippet": "Hawks are a type of bird.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Hawks are a type of bird.", "is_reverse": true}, {"found_name": "Vulture", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1443, "target_cluster_name": "Vulture", "source_book": "llm_generated", "evidence_snippet": "Vultures belong to the same family (Accipitridae) as hawks.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Vultures belong to the same family (Accipitridae) as hawks.", "is_reverse": true}]}, {"canonical_name": "paraíso terreal", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 11, "members": [{"entity_id": "paradise", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Paradise", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Paradise"], "contexts": ["biblical garden of Eden", "ideal place of knowledge"]}, {"entity_id": "paradise", "book_id": "kosmos_humboldt_1845", "name": "Paradise", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Paradise"], "contexts": ["biblical garden"]}, {"entity_id": "paraíso_terreal", "book_id": "coloquios_da_orta_1563", "name": "paraíso terreal", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["paraíso terreal", "Parayzo terreal", "Paraíso terrestre", "paraizo terreal"], "contexts": ["place from which a substance is said to come", "mythical location"]}, {"entity_id": "paraiſo_terreal", "book_id": "polyanthea_medicinal", "name": "Paraiſo terreal", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Paraiſo terreal"], "contexts": ["earthly paradise", "Earthly Paradise, location of the Tree of Life"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Paradise", "target_book": "kosmos_humboldt_1845", "target_name": "Paradise", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Paradise", "target_book": "coloquios_da_orta_1563", "target_name": "paraíso terreal", "similarity": 0.925}, {"source_book": "kosmos_humboldt_1845", "source_name": "Paradise", "target_book": "coloquios_da_orta_1563", "target_name": "paraíso terreal", "similarity": 0.925}, {"source_book": "coloquios_da_orta_1563", "source_name": "paraíso terreal", "target_book": "polyanthea_medicinal", "target_name": "Paraiſo terreal", "similarity": 0.911}], "id": 396, "stable_key": "clu_a470ce0f759c4d99", "ground_truth": {"modern_name": "Earthly Paradise", "confidence": "high", "type": "place", "description": "A mythical location, often associated with the Garden of Eden.", "wikipedia_extract": "In Abrahamic mythology, the Garden of Eden (Biblical Hebrew: גַּן־עֵדֶן‎, romanized: gan-ʿĒḏen; Greek: Εδέμ; Latin: Paradisus) or Garden of God (גַּן־יְהֹוֶה‎, gan-YHWH and גַן־אֱלֹהִים‎, gan-Elohim), also called the Terrestrial Paradise, is the biblical paradise described in Genesis 2–3 and Ezekiel 28 and 31. The location of Eden is described in the Book of Genesis as the source of four tributaries. Various suggestions have been made for its location: at the head of the Persian Gulf, in southern Mesopotamia where the Tigris and Euphrates rivers run into the sea; and in Armenia. Others theorize that Eden was the entire Fertile Crescent or a region substantial in size in Mesopotamia, where its native inhabitants still exist in cities such as Telassar. Like the Genesis flood narrative, the Genesis creation narrative and the account of the Tower of Babel, the story of Eden echoes the Mesopotamian myth of a king, as a primordial man, who is placed in a divine garden to guard the tree of life. Scholars note that the Eden narrative shows parallels with aspects of Solomon's Temple and Jerusalem, attesting to its nature as a sacred place."}, "cross_references": [{"found_name": "Earth", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 533, "target_cluster_name": "earth", "source_book": "llm_generated", "evidence_snippet": "The Earthly Paradise is a conceptual location within the broader context of the Earth.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Earthly Paradise is a conceptual location within the broader context of the Earth."}, {"found_name": "terra", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 709, "target_cluster_name": "terra", "source_book": "llm_generated", "evidence_snippet": "Earthly Paradise is a conceptual location on Earth.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Earthly Paradise is a conceptual location on Earth.", "is_reverse": true}, {"found_name": "Pomum Paradisi", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "as ha, chamão por outro nome Pomum Para- disi . . . Dizem e affirmão os orientaes e palestinos ser aquella a arvore da qual comeo o nosso Padre Adão no Parayzo terreal, sendo-lhe ve- dada pelo Senhor ", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "alternative name for"}]}, {"canonical_name": "Garcias", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 4, "total_mentions": 11, "members": [{"entity_id": "garcias_ab_horto", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Garcias ab horto", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Garcias ab Horto", "Garcias ab horto"], "contexts": ["physician to the Spanish Viceroy", "author on elephant experience and Malavar"]}, {"entity_id": "garcias", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Garcias", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Garcias"], "contexts": ["described ginger and nutmeg trees"]}, {"entity_id": "garcia", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Garcia", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Garcia"], "contexts": ["author of 'Orig. de los Ind.'", "cited source"]}, {"entity_id": "garcias", "book_id": "coloquios_da_orta_1563", "name": "Garcias", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Garcias", "Garciam"], "contexts": ["mentioned by Sprengel", "mentioned in relation to costus"]}, {"entity_id": "garcia", "book_id": "ricettario_fiorentino_1597", "name": "Garcia", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Garcia"], "contexts": ["scholar who described Indian trees"]}], "edges": [{"source_book": "pseudodoxia_epidemica_brow