nt": 1, "variants": ["books"], "contexts": ["written works for reading"]}, {"entity_id": "livro", "book_id": "coloquios_da_orta_1563", "name": "Livro", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 17, "variants": ["Livro", "livras", "livro", "livros", "livros antigos", "livros impressos", "livros impressos xylographicas", "livros modernos"], "contexts": ["reference to a book", "cited work by Duarte Barbosa"]}, {"entity_id": "livro", "book_id": "polyanthea_medicinal", "name": "Livro", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 5, "variants": ["Livro", "livro", "livros"], "contexts": ["A book, referring to Polyanthea", "written work"]}, {"entity_id": "lib__lo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "lib. lo", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["lib. lo"], "contexts": ["book reference"]}, {"entity_id": "lib_", "book_id": "polyanthea_medicinal", "name": "lib.", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 9, "variants": ["lib.", "LIBERI", "LIBRI", "lib.de Peſte", "libr."], "contexts": ["book", "book chapter or section indicator"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Book", "target_book": "principles_of_psychology_james_1890", "target_name": "book", "similarity": 0.997}, {"source_book": "english_physician_1652", "source_name": "Book", "target_book": "principles_of_psychology_james_1890", "target_name": "books", "similarity": 0.918}, {"source_book": "english_physician_1652", "source_name": "Book", "target_book": "coloquios_da_orta_1563", "target_name": "Livro", "similarity": 0.99}, {"source_book": "english_physician_1652", "source_name": "Book", "target_book": "polyanthea_medicinal", "target_name": "Livro", "similarity": 0.99}, {"source_book": "principles_of_psychology_james_1890", "source_name": "book", "target_book": "coloquios_da_orta_1563", "target_name": "Livro", "similarity": 0.99}, {"source_book": "principles_of_psychology_james_1890", "source_name": "book", "target_book": "polyanthea_medicinal", "target_name": "Livro", "similarity": 0.99}, {"source_book": "principles_of_psychology_james_1890", "source_name": "books", "target_book": "coloquios_da_orta_1563", "target_name": "Livro", "similarity": 0.92}, {"source_book": "principles_of_psychology_james_1890", "source_name": "books", "target_book": "polyanthea_medicinal", "target_name": "Livro", "similarity": 0.92}, {"source_book": "coloquios_da_orta_1563", "source_name": "Livro", "target_book": "polyanthea_medicinal", "target_name": "Livro", "similarity": 1.0}], "id": 283, "stable_key": "clu_9826cc6dcd4d4ba2", "ground_truth": {"modern_name": "Book", "confidence": "high", "type": "object", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Book", "note": "'lib.' is a common abbreviation for 'liber', the Latin word for book. 'lib. lo' likely refers to a specific book or section.", "wikipedia_extract": "A book is a written work of substantial length created by one or more authors. They can be distributed in various forms such as printed books, audiobooks, and electronic books (ebooks). Books are broadly classified into fiction, containing invented narrative or other imaginary content; and non-fiction, containing content intended as factual truth. The term may also refer to the physical or electronic object containing such a work. Modern books are typically printed in a codex format, composed of many pages bound together and protected by a cover. Before the wide adoption of the modern printing press, codices were used to create handwritten manuscripts."}, "member_count": 7, "cross_references": [{"found_name": "Chapter", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 594, "target_cluster_name": "cap.", "source_book": "llm_generated", "evidence_snippet": "A chapter is a distinct section of a book.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "A chapter is a distinct section of a book."}, {"found_name": "Glossary", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1732, "target_cluster_name": "Glossary", "source_book": "llm_generated", "evidence_snippet": "A glossary is a list of terms with definitions, often found at the end of a book.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "A glossary is a list of terms with definitions, often found at the end of a book."}, {"found_name": "Commentary", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 4480, "target_cluster_name": "Commentary", "source_book": "llm_generated", "evidence_snippet": "A commentary is a series of notes or explanations on a text, often presented in book form.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "A commentary is a series of notes or explanations on a text, often presented in book form."}, {"found_name": "Tom. III", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 661, "target_cluster_name": "Tom. III", "source_book": "llm_generated", "evidence_snippet": "A volume is a specific type of book, often part of a larger set. 'Book' is a direct synonym in this context.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: A volume is a specific type of book, often part of a larger set. 'Book' is a direct synonym in this context.", "is_reverse": true}, {"found_name": "Paper", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2517, "target_cluster_name": "paper", "source_book": "llm_generated", "evidence_snippet": "Paper is the primary material used for printing books.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Paper is the primary material used for printing books."}, {"found_name": "Almanack", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1413, "target_cluster_name": "Almanack", "source_book": "llm_generated", "evidence_snippet": "An almanac is a type of book containing calendars and other information.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: An almanac is a type of book containing calendars and other information.", "is_reverse": true}, {"found_name": "scholastic books", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "principles_of_psychology_james_1890", "evidence_snippet": "MENTAL STATES EXIST? it will be best to give the list of so-called proofs as briefly as possible, and to follow each by its objection, as in scholastic books.[177] _First Proof_. The _minimum visibile", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of books"}]}, {"canonical_name": "entranhas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 31, "members": [{"entity_id": "entrails", "book_id": "english_physician_1652", "name": "Entrails", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["Entrails", "Intrails"], "contexts": ["internal organs of digestion"]}, {"entity_id": "entrails", "book_id": "principles_of_psychology_james_1890", "name": "entrails", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["entrails"], "contexts": ["internal organs providing sensation"]}, {"entity_id": "entrías", "book_id": "historia_medicinal_monardes_1574", "name": "entrías", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["entrías", "entrañas"], "contexts": ["misspelling of entrails", "body part, intestines"]}, {"entity_id": "entranhas", "book_id": "polyanthea_medicinal", "name": "entranhas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 26, "variants": ["entranhas", "entrails", "entranhas damáy", "entranhas naturaes"], "contexts": ["entrails", "internal organs"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Entrails", "target_book": "principles_of_psychology_james_1890", "target_name": "entrails", "similarity": 0.981}, {"source_book": "english_physician_1652", "source_name": "Entrails", "target_book": "polyanthea_medicinal", "target_name": "entranhas", "similarity": 0.919}, {"source_book": "principles_of_psychology_james_1890", "source_name": "entrails", "target_book": "polyanthea_medicinal", "target_name": "entranhas", "similarity": 0.936}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "entrías", "target_book": "polyanthea_medicinal", "target_name": "entranhas", "similarity": 0.901}], "id": 284, "stable_key": "clu_87dbf005603f2b82", "ground_truth": {"modern_name": "entrails", "confidence": "high", "type": "substance", "description": "The internal organs, especially of digestion.", "wikipedia_extract": "The gastrointestinal tract (also called the GI tract, digestive tract, and the alimentary canal) is the tract or passageway of the digestive system that leads from the mouth to the anus. The tract is one of the largest of the body's systems. The GI tract contains all the major organs of the digestive system, in humans and other animals, including the esophagus, stomach, and intestines. Food taken in through the mouth is digested to extract nutrients and absorb energy, and the waste expelled at the anus as feces. Gastrointestinal is an adjective meaning of or pertaining to the stomach and intestines. Most animals have a \"through-gut\" or complete digestive tract."}, "cross_references": [{"found_name": "Intestine", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2647, "target_cluster_name": "intestine", "source_book": "llm_generated", "evidence_snippet": "The entrails are primarily composed of the intestines.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The entrails are primarily composed of the intestines."}, {"found_name": "Intestines", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 903, "target_cluster_name": "Tripas", "source_book": "llm_generated", "evidence_snippet": "The entrails are primarily composed of the intestines.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The entrails are primarily composed of the intestines."}, {"found_name": "Blood vessels", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1267, "target_cluster_name": "blood-vessels", "source_book": "llm_generated", "evidence_snippet": "Entrails are supplied with blood vessels.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Entrails are supplied with blood vessels."}]}, {"canonical_name": "Alpes", "category": "PLACE", "subcategory": "REGION", "book_count": 4, "total_mentions": 31, "members": [{"entity_id": "alps", "book_id": "origin_of_species_darwin_1859", "name": "Alps", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Alps"], "contexts": ["mountain range in Europe", "southern limit of arctic fauna and flora"]}, {"entity_id": "alpes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Alpes", "category": "PLACE", "subcategory": "REGION", "count": 25, "variants": ["Alpes", "Alpes Scandinaves", "Alpes d'Europe", "Alpes de la Suisse", "Alpes du Tyrol"], "contexts": ["mountain range", "mountain range in Switzerland"]}, {"entity_id": "alpes", "book_id": "polyanthea_medicinal", "name": "Alpes", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Alpes"], "contexts": ["mountain range", "mountains mentioned with hernias"]}, {"entity_id": "alps", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Alps", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Alps"], "contexts": ["mountain range with frozen declivities", "mountain range where bearded vulture is found"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Alps", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Alpes", "similarity": 0.897}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Alps", "target_book": "polyanthea_medicinal", "target_name": "Alpes", "similarity": 0.897}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Alps", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Alps", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Alpes", "target_book": "polyanthea_medicinal", "target_name": "Alpes", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Alpes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Alps", "similarity": 0.897}, {"source_book": "polyanthea_medicinal", "source_name": "Alpes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Alps", "similarity": 0.897}], "id": 285, "stable_key": "clu_5189105edc204b81", "ground_truth": {"modern_name": "Alps", "confidence": "high", "type": "place", "description": "Major European mountain range, notable for its arctic fauna and flora.", "wikipedia_extract": "The Alps () are some of the highest and most extensive mountain ranges in Europe, stretching approximately 1,200 km (750 mi) across eight Alpine countries (from west to east): Monaco, France, Switzerland, Italy, Liechtenstein, Germany, Austria, Slovenia, and Hungary. The Alpine arch extends from Nice on the western Mediterranean to Trieste on the Adriatic and Vienna at the beginning of the Pannonian Basin. The mountains were formed over tens of millions of years as the African and Eurasian tectonic plates collided. Extreme shortening  caused by the event resulted in marine sedimentary rocks rising by thrusting and folding into high mountain peaks such as Mont Blanc and the Matterhorn. Mont Blanc spans the French-Italian border, and at 4,809 m (15,778 ft) is the highest mountain in the Alps. The Alpine region area contains 82 peaks higher than 4,000 m (13,000 ft)."}, "cross_references": [{"found_name": "Himalaya", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 18, "target_cluster_name": "Himalaya", "source_book": "llm_generated", "evidence_snippet": "Both are major mountain ranges in Asia and Europe, respectively, and are often discussed in geographical contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both are major mountain ranges in Asia and Europe, respectively, and are often discussed in geographical contexts.", "is_reverse": true}, {"found_name": "Itália", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 88, "target_cluster_name": "Itália", "source_book": "llm_generated", "evidence_snippet": "The Alps form the northern land border of Italy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Alps form the northern land border of Italy.", "is_reverse": true}, {"found_name": "Germany", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 99, "target_cluster_name": "Germany", "source_book": "llm_generated", "evidence_snippet": "The Alps mountain range forms a southern border for Germany.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Alps mountain range forms a southern border for Germany.", "is_reverse": true}]}, {"canonical_name": "planet", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 31, "members": [{"entity_id": "planet", "book_id": "origin_of_species_darwin_1859", "name": "planet", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["planet"], "contexts": ["Earth as a celestial body"]}, {"entity_id": "planète", "book_id": "relation_historique_humboldt_vol3_1825", "name": "planète", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["planète"], "contexts": ["Earth", "Earth's crust"]}, {"entity_id": "planet", "book_id": "kosmos_humboldt_1845", "name": "planet", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 19, "variants": ["planet"], "contexts": ["celestial body orbiting a star", "our world"]}, {"entity_id": "planet", "book_id": "first_principles_spencer_1862", "name": "planet", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 6, "variants": ["planet"], "contexts": ["celestial body orbiting a star", "celestial body observed in motion"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "planet", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "planète", "similarity": 0.981}, {"source_book": "origin_of_species_darwin_1859", "source_name": "planet", "target_book": "kosmos_humboldt_1845", "target_name": "planet", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "planet", "target_book": "first_principles_spencer_1862", "target_name": "planet", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "planète", "target_book": "kosmos_humboldt_1845", "target_name": "planet", "similarity": 0.981}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "planète", "target_book": "first_principles_spencer_1862", "target_name": "planet", "similarity": 0.981}, {"source_book": "kosmos_humboldt_1845", "source_name": "planet", "target_book": "first_principles_spencer_1862", "target_name": "planet", "similarity": 1.0}], "id": 286, "stable_key": "clu_39e8d10aeba6c9c5", "ground_truth": {"modern_name": "Planet", "confidence": "high", "type": "place", "wikidata_id": "Q634", "wikidata_description": "celestial body directly orbiting a star or stellar remnant", "wikipedia_url": "https://en.wikipedia.org/wiki/Planet", "wikipedia_extract": "A planet is a large, rounded astronomical body that is generally required to be in orbit around a star, stellar remnant, or brown dwarf, and is not one itself. The Solar System has eight planets by the most restrictive definition of the term: the terrestrial planets Mercury, Venus, Earth, and Mars, and the giant planets Jupiter, Saturn, Uranus, and Neptune. The best available theory of planet formation is the nebular hypothesis, which posits that an interstellar cloud collapses out of a nebula to create a young protostar orbited by a protoplanetary disk. Planets grow in this disk by the gradual accumulation of material driven by gravity, a process called accretion. The word planet comes from the Greek πλανήται (planḗtai) 'wanderers'. In antiquity, this word referred to the Sun, Moon, and five points of light visible to the naked eye that moved across the background of the stars—namely, Mercury, Venus, Mars, Jupiter, and Saturn."}, "cross_references": []}, {"canonical_name": "Farelos", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 4, "total_mentions": 31, "members": [{"entity_id": "céréales", "book_id": "relation_historique_humboldt_vol3_1825", "name": "céréales", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["céréales", "céréale", "céréales d'Europe"], "contexts": ["grains cultivated in Europe", "grain crops"]}, {"entity_id": "cereals", "book_id": "kosmos_humboldt_1845", "name": "cereals", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["cereals"], "contexts": ["grains that grow at high altitudes"]}, {"entity_id": "farelos", "book_id": "polyanthea_medicinal", "name": "Farelos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 23, "variants": ["Farelos", "farellos", "farelos", "faretos"], "contexts": ["ingredient in a wash", "bran for facilitating digestion"]}, {"entity_id": "cereals", "book_id": "first_principles_spencer_1862", "name": "cereals", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["cereals"], "contexts": ["conventional divisions established by agriculture"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "céréales", "target_book": "kosmos_humboldt_1845", "target_name": "cereals", "similarity": 0.948}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "céréales", "target_book": "polyanthea_medicinal", "target_name": "Farelos", "similarity": 0.903}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "céréales", "target_book": "first_principles_spencer_1862", "target_name": "cereals", "similarity": 0.948}, {"source_book": "kosmos_humboldt_1845", "source_name": "cereals", "target_book": "polyanthea_medicinal", "target_name": "Farelos", "similarity": 0.904}, {"source_book": "kosmos_humboldt_1845", "source_name": "cereals", "target_book": "first_principles_spencer_1862", "target_name": "cereals", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "Farelos", "target_book": "first_principles_spencer_1862", "target_name": "cereals", "similarity": 0.904}], "id": 287, "stable_key": "clu_6a86d13426c3298f", "ground_truth": {"modern_name": "bran", "confidence": "high", "type": "substance", "description": "Outer coating of cereal grains, used as food or in preparations.", "wikipedia_extract": "Bran, also known as miller's bran, is the component of a cereal grain consisting of the hard layers – the combined aleurone and pericarp – surrounding the endosperm. Corn (maize) bran also includes the pedicel (tip cap). Along with the germ, it is an integral part of whole grains, and is often produced as a byproduct of milling in the production of refined grains. Bran is highly nutritious, but is difficult to digest due to its high fiber content; its high fat content also reduces its shelf life as the oils/fats are prone to becoming rancid. As such, it is typically removed from whole grain during the refining process – e.g. in processing wheat grain into white flour, or refining brown rice into white rice. Bran is present in cereal grain, including rice, corn (maize), wheat, oats, barley, rye, and millet."}, "cross_references": [{"found_name": "Grains", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2320, "target_cluster_name": "grãos", "source_book": "llm_generated", "evidence_snippet": "Bran is a component of cereal grains.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Bran is a component of cereal grains."}, {"found_name": "Corn", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 426, "target_cluster_name": "Corn", "source_book": "llm_generated", "evidence_snippet": "Bran is a component of cereal grains, including corn (maize).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Bran is a component of cereal grains, including corn (maize)."}, {"found_name": "Barley", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1570, "target_cluster_name": "Cevada", "source_book": "llm_generated", "evidence_snippet": "Bran is a component of cereal grains, including barley.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Bran is a component of cereal grains, including barley."}, {"found_name": "Oats", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1223, "target_cluster_name": "Oats", "source_book": "llm_generated", "evidence_snippet": "Bran is a component of cereal grains, including oats.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Bran is a component of cereal grains, including oats."}, {"found_name": "Wheat", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 102, "target_cluster_name": "Wheat", "source_book": "llm_generated", "evidence_snippet": "Bran is a component of cereal grains, including wheat.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Bran is a component of cereal grains, including wheat."}, {"found_name": "Rye", "link_type": "conceptual_overlap", "lin