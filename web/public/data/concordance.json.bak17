"lobster", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Lobster", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Lobster"], "contexts": ["crustacean with a large claw"]}, {"entity_id": "lobster", "book_id": "first_principles_spencer_1862", "name": "lobster", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["lobster"], "contexts": ["example of longitudinal union in Vertebrata"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Lobster", "target_book": "first_principles_spencer_1862", "target_name": "lobster", "similarity": 0.994}], "id": 3887, "stable_key": "clu_fd4cc8f24766f74b", "ground_truth": {"modern_name": "lobster", "confidence": "high", "type": "animal", "wikipedia_extract": "The American lobster (Homarus americanus) is a species of lobster found on the Atlantic coast of North America, chiefly from Labrador to New Jersey. It is also known as Atlantic lobster, Canadian lobster, true lobster, northern lobster, Canadian Reds, or Maine lobster. It can reach a body length of 64 cm (25 in), and a mass of over 20 kilograms (44 lb), making it not only the heaviest crustacean in the world, but also the heaviest of all living arthropod species. Its closest relative is the European lobster Homarus gammarus, which can be distinguished by its coloration and the lack of spines on the underside of the rostrum. American lobsters are usually bluish green to brown with red spines, but several color variations have been observed. Homarus americanus is distributed along the Atlantic coast of North America, from Labrador in the north to Cape Hatteras, North Carolina, in the south.", "wikipedia_url": "https://en.wikipedia.org/wiki/American_lobster"}, "cross_references": [{"found_name": "shell-fish", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1016, "target_cluster_name": "shell-fish", "source_book": "llm_generated", "evidence_snippet": "Lobsters are a type of shellfish.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Lobsters are a type of shellfish.", "is_reverse": true}]}, {"canonical_name": "Trent", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "trent", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Trent", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Trent"], "contexts": ["city near Anania valley"]}, {"entity_id": "trent", "book_id": "english_physician_1652", "name": "Trent", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Trent"], "contexts": ["seat of Cardinal Prince"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Trent", "target_book": "english_physician_1652", "target_name": "Trent", "similarity": 1.0}], "id": 3888, "stable_key": "clu_52eea54176346c84", "ground_truth": {"modern_name": "Trent", "confidence": "high", "type": "place", "country": "Italy"}, "cross_references": []}, {"canonical_name": "Julius Scaliger", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "julius_scaliger", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Julius Scaliger", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Julius Scaliger"], "contexts": ["scholar writing on bear reproduction"]}, {"entity_id": "joseph_scaliger", "book_id": "principles_of_psychology_james_1890", "name": "Joseph Scaliger", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Joseph Scaliger"], "contexts": ["learned scholar engrossed in Homer"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Julius Scaliger", "target_book": "principles_of_psychology_james_1890", "target_name": "Joseph Scaliger", "similarity": 0.954}], "id": 3889, "stable_key": "clu_c16e2a247aab2ee6", "ground_truth": {"modern_name": "Julius Caesa