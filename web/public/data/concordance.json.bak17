book": "first_principles_spencer_1862", "target_name": "curvature", "similarity": 0.88}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "curvature", "target_book": "first_principles_spencer_1862", "target_name": "curvature", "similarity": 1.0}], "id": 1394, "stable_key": "clu_981d3480ce115e5a", "ground_truth": {"modern_name": "Curvature", "confidence": "high", "type": "concept", "wikidata_id": "Q214881", "wikidata_description": "inverse of the radius of curvature", "wikipedia_url": "https://en.wikipedia.org/wiki/Curvature", "wikipedia_extract": "In mathematics, curvature is any of several strongly related concepts in geometry that intuitively measure the amount by which a curve deviates from being a straight line or by which a surface deviates from being a plane. If a curve or surface is contained in a larger space, curvature can be defined extrinsically relative to the ambient space. Curvature of Riemannian manifolds of dimension at least two can be defined intrinsically without reference to a larger space. For curves, curvature describes how sharply the curve bends. The canonical examples are circles: smaller circles bend more sharply and hence have higher curvature. For a point on a general curve, the direction of the curve is described by its  tangent line."}, "cross_references": [{"found_name": "mathematics", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 161, "target_cluster_name": "mathematics", "source_book": "llm_generated", "evidence_snippet": "Curvature is a geometric property studied extensively in mathematics, particularly in differential geometry and its applications to understanding shapes and spaces.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Curvature is a geometric property studied extensively in mathematics, particularly in differential geometry and its applications to understanding shapes and spaces.", "is_reverse": true}, {"found_name": "Centrifugal force", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 315, "target_cluster_name": "Centrifugal force", "source_book": "llm_generated", "evidence_snippet": "Circular motion, where centrifugal force is relevant, involves curvature of the path.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Circular motion, where centrifugal force is relevant, involves curvature of the path.", "is_reverse": true}, {"found_name": "Waves", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 763, "target_cluster_name": "Waves", "source_book": "llm_generated", "evidence_snippet": "Wave fronts can exhibit curvature, and the study of wave propagation in curved spaces or media is a significant area of physics. The geometry of the wave is often related to curvature.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Wave fronts can exhibit curvature, and the study of wave propagation in curved spaces or media is a significant area of physics. The geometry of the wave is often related to curvature.", "is_reverse": true}, {"found_name": "round", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1421, "target_cluster_name": "round", "source_book": "llm_generated", "evidence_snippet": "Roundness is a specific type of curvature, implying a smooth, unbroken, and generally convex shape.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Roundness is a specific type of curvature, implying a smooth, unbroken, and generally convex shape.", "is_reverse": true}, {"found_name": "Time and Space", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2573, "target_cluster_name": "Time and Space", "source_book": "llm_generated", "evidence_snippet": "Curvature describes the deviation of space from flatness, a key concept in understanding the geometry of space.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Curvature describes the deviation of space from flatness, a key concept in understanding the geometry of space.", "is_reverse": true}, {"found_name": "straight line", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2654, "target_cluster_name": "straight line", "source_book": "llm_generated", "evidence_snippet": "Curvature is the degree to which a line or surface deviates from being flat or straight. A straight line has zero curvature.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Curvature is the degree to which a line or surface deviates from being flat or straight. A straight line has zero curvature.", "is_reverse": true}, {"found_name": "Geometry", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2912, "target_cluster_name": "Geometry", "source_book": "llm_generated", "evidence_snippet": "A key property studied and quantified in geometry.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: A key property studied and quantified in geometry.", "is_reverse": true}]}, {"canonical_name": "Andreas", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "andreas", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Andreas", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Andreas"], "contexts": ["ancient author of a piece"]}, {"entity_id": "andreas", "book_id": "coloquios_da_orta_1563", "name": "Andreas", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Andreas"], "contexts": ["translator"]}, {"entity_id": "andreas", "book_id": "polyanthea_medicinal", "name": "Andreas", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Andreas"], "contexts": ["name of an author"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Andreas",