AL", "subcategory": "BIRD", "count": 1, "variants": ["kingfisher"], "contexts": ["bird that catches fish"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "King-fisher", "target_book": "origin_of_species_darwin_1859", "target_name": "kingfisher", "similarity": 0.973}], "id": 2910, "stable_key": "clu_ced964147cf16c6c", "ground_truth": {"modern_name": "Kingfisher", "confidence": "high", "type": "animal", "wikidata_id": "Q1013136", "wikidata_description": "city in and the county seat of Kingfisher County, Oklahoma, United States", "wikipedia_url": "https://en.wikipedia.org/wiki/Kingfisher", "wikipedia_extract": "Kingfishers are a family, the Alcedinidae, of small to medium-sized, brightly coloured birds in the order Coraciiformes. They have a cosmopolitan distribution: most species live in the tropical regions of Africa, Asia, and Oceania, but they can also be found in Europe and the Americas. They can be found in deep forests near calm ponds and small rivers. The family contains 118 species and is divided into three subfamilies and 19 genera. All kingfishers have large heads, long, sharp, pointed bills, short legs, and stubby tails. Most species have bright plumage with only small differences between the sexes."}, "cross_references": [{"found_name": "Birds", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 5, "target_cluster_name": "birds", "source_book": "llm_generated", "evidence_snippet": "Kingfishers are a type of bird.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Kingfishers are a type of bird."}]}, {"canonical_name": "Barbara", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "barbara", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Barbara", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Barbara"], "contexts": ["specific type of syllogism", "saint associated with 