vidence_snippet": "This is a shortened form of the entity's name.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "This is a shortened form of the entity's name."}]}, {"canonical_name": "Bodies", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 11, "members": [{"entity_id": "bodies", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "bodies", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["bodies"], "contexts": ["general term for physical entities"]}, {"entity_id": "bodies", "book_id": "english_physician_1652", "name": "Bodies", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["Bodies", "Bodie"], "contexts": ["human beings", "human physical form"]}, {"entity_id": "corpos", "book_id": "polyanthea_medicinal", "name": "corpos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["corpos"], "contexts": ["human bodies", "human bodies susceptible to contagion"]}, {"entity_id": "corpora", "book_id": "polyanthea_medicinal", "name": "corpora", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["corpora"], "contexts": ["bodies"]}, {"entity_id": "bodies", "book_id": "first_principles_spencer_1862", "name": "bodies", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["bodies"], "contexts": ["physical entities", "physical form of organisms"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "bodies", "target_book": "english_physician_1652", "target_name": "Bodies", "similarity": 0.991}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "bodies", "target_book": "polyanthea_medicinal", "target_name": "corpos", "similarity": 0.988}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "bodies", "target_book": "polyanthea_medicinal", "target_name": "corpora", "similarity": 0.98}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "bodies", "target_book": "first_principles_spencer_1862", "target_name": "bodies", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Bodies", "target_book": "polyanthea_medicinal", "target_name": "corpos", "similarity": 0.977}, {"source_book": "english_physician_1652", "source_name": "Bodies", "target_book": "polyanthea_medicinal", "target_name": "corpora", "similarity": 0.978}, {"source_book": "english_physician_1652", "source_name": "Bodies", "target_book": "first_principles_spencer_1862", "target_name": "bodies", "similarity": 0.991}, {"source_book": "polyanthea_medicinal", "source_name": "corpos", "target_book": "first_principles_spencer_1862", "target_name": "bodies", "similarity": 0.988}, {"source_book": "polyanthea_medicinal", "source_name": "corpora", "target_book": "first_principles_spencer_1862", "target_name": "bodies", "similarity": 0.98}], "id": 398, "stable_key": "clu_668d5ad2db7d7e4a", "ground_truth": {"modern_name": "Body", "confidence": "high", "type": "concept", "note": "The term 'Bodies' is used broadly in early modern texts to refer to physical entities, particularly human and animal bodies, in both scientific and philosophical contexts.", "wikidata_id": "Q5", "wikidata_description": "any single member of Homo sapiens, unique extant species of the genus Homo", "wikipedia_url": "https://en.wikipedia.org/wiki/Human", "wikipedia_extract": "Humans (Homo sapiens, meaning \"thinking man\" or \"wise man\") are the most common and widespread species of primate, and the only extant species of the genus Homo. They are great apes characterized by hairlessness, obligate bipedality, manual dexterity with opposable thumbs, precision grip, and high intelligence. Humans have large brains compared to body size (a high encephalization quotient), enabling more advanced cognitive skills that facilitate successful adaptation to varied environments, development of sophisticated tools, and formation of complex social structures and civilizations. Humans possess a disproportionately larger volume of both cerebral white matter and gray matter present in the prefrontal cortex (PFC) than any other primate species, which facilitated the expansion of higher-order executive functions. Humans are highly social, with individual humans tending to belong to a multi-layered network of distinct social groups – from families and peer groups to corporations and political states. As such, social interactions between humans have established a wide variety of values, social norms, languages, and traditions (collectively termed institutions), each of which bolsters human society."}, "cross_references": []}, {"canonical_name": "Butter", "category": "SUBSTANCE", "subcategory": "OTHER_ANIMAL", "book_count": 4, "total_mentions": 11, "members": [{"entity_id": "butter", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "butter", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 1, "variants": ["butter"], "contexts": ["animal product used in gunpowder"]}, {"entity_id": "butter", "book_id": "english_physician_1652", "name": "Butter", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 5, "variants": ["Butter"], "contexts": ["fried with herb for swellings", "fried in Butter"]}, {"entity_id": "beurre", "book_id": "relation_historique_humboldt_vol3_1825", "name": "beurre", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 4, "variants": ["Beurre", "beurre"], "contexts": ["foodstuff in Havana", "butter"]}, {"entity_id": "butter", "book_id": "principles_of_psychology_james_1890", "name": "butter", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 1, "variants": ["butter"], "contexts": ["dairy product"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "butter", "target_book": "english_physician_1652", "target_name": "Butter", "similarity": 0.839}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "butter", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "beurre", "similarity": 0.912}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "butter", "target_book": "principles_of_psychology_james_1890", "target_name": "butter", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Butter", "target_book": "principles_of_psychology_james_1890", "target_name": "butter", "similarity": 0.839}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "beurre", "target_book": "principles_of_psychology_james_1890", "target_name": "butter", "similarity": 0.912}], "id": 399, "stable_key": "clu_0ef2532eb50dd363", "ground_truth": {"modern_name": "Butter", "confidence": "high", "type": "ANIMAL", "description": "A dairy product made from churning milk or cream.", "wikipedia_extract": "Butter is a dairy product made from the fat and protein components of churned cream. It is a semi-solid emulsion at room temperature, consisting of approximately 81% butterfat. It is used at room temperature as a spread, melted as a condiment, and used as a fat in baking, sauce-making, pan frying, and other cooking procedures. Most frequently made from cow's milk, butter can also be manufactured from the milk of other mammals, including sheep, goats, buffalo, and yaks. It is made by churning milk or cream to separate the fat globules from the buttermilk. Salt has been added to butter since antiquity to help preserve it, particularly when being transported; salt may still play a preservation role but is less important today as the entire supply chain is usually refrigerated."}, "cross_references": [{"found_name": "Curdled Milk", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3956, "target_cluster_name": "Curdled Milk", "source_book": "llm_generated", "evidence_snippet": "Butter is a dairy product derived from churned cream, which is itself a product of milk. Curdled milk is a related dairy product.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Butter is a dairy product derived from churned cream, which is itself a product of milk. Curdled milk is a related dairy product."}, {"found_name": "Milk", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 637, "target_cluster_name": "Milk", "source_book": "llm_generated", "evidence_snippet": "Butter is a dairy product made from the fat and protein components of churned cream, which is derived from milk. Milk is the fundamental source material.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Butter is a dairy product made from the fat and protein components of churned cream, which is derived from milk. Milk is the fundamental source material."}, {"found_name": "Oils", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 203, "target_cluster_name": "olio", "source_book": "llm_generated", "evidence_snippet": "Butter is primarily composed of butterfat, which is a type of oil. It is a fat-based substance.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Butter is primarily composed of butterfat, which is a type of oil. It is a fat-based substance."}]}, {"canonical_name": "Germans", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 4, "total_mentions": 11, "members": [{"entity_id": "germanicus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Germanicus", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Germanicus"], "contexts": ["Roman general and statesman"]}, {"entity_id": "germans", "book_id": "english_physician_1652", "name": "Germans", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 7, "variants": ["Germans"], "contexts": ["people who use Winter-Green salve", "people who prize wound herbs"]}, {"entity_id": "germans", "book_id": "principles_of_psychology_james_1890", "name": "Germans", "category": "PERSON", "subcategory": "OTHER_PERSON", "cou