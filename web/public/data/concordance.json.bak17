uster_name": null, "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "s'intendono tré piante j cioè la maggiore , la minore, e la rotonda . per TEfula maggiore s'inrcdt la Py* thy ufa di Diofcoride^e la Scebram maggiore di Mefue ; per TEfula minore i 1 tithymalo cypanfs", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for lesser euphorbia"}, {"found_name": "Pepio", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "s'intendono tré piante j cioè la maggiore , la minore, e la rotonda . per TEfula maggiore s'inrcdt la Py* thy ufa di Diofcoride^e la Scebram maggiore di Mefue ; per TEfula minore i 1 tithymalo cypanfs", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for round euphorbia"}]}, {"canonical_name": "panaricio", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "panarizos", "book_id": "historia_medicinal_monardes_1574", "name": "panarizos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["panarizos"], "contexts": ["ailment treated with iron powder"]}, {"entity_id": "panaricio", "book_id": "polyanthea_medicinal", "name": "panaricio", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 12, "variants": ["panaricio", "Panaricio", "Panaricios", "panarici", "panariciopor", "panaricios"], "contexts": ["infection treated with cat's ear", "whitlow"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "panarizos", "target_book": "polyanthea_medicinal", "target_name": "panaricio", "similarity": 0.883}], "id": 1958, "stable_key": "clu_bed4c7c2359ce0de", "ground_truth": {"modern_name": "whitlow", "confidence": "high", "type": "disease", "description": "A painful inflammation or infection of a finger or toe.", "wikipedia_extract": "A whitlow or felon is an infection of the tip of the finger. Herpetic whitlow and melanotic whitlow (subungual melanoma) are subtypes that are not synonymous with the term felon. A felon is an \"extremely painful abscess on the palmar aspect of the fingertip\". Whitlow usually refers to herpetic whitlow, though it can also refer to melanotic whitlow (subungual melanoma), which somewhat resembles acral lentiginous melanoma. The terms whitlow and felon are also sometimes misapplied to paronychia, which is an infection of the tissue at the side or base of the nail. Felon presents clinically with a throbbing pain."}, "cross_references": []}, {"canonical_name": "Sepúlveda", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "sepúlveda", "book_id": "coloquios_da_orta_1563", "name": "Sepúlveda", "category": "PERSON", "subcategory": "SCHOLAR", "count": 12, "variants": ["Sepúlveda"], "contexts": ["mentioned scholar", "author of 'Mandamus medicamentorum'"]}, {"entity_id": "sepulveda", "book_id": "polyanthea_medicinal", "name": "Sepulveda", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["Sepulveda"], "contexts": ["Physician of the Chamber of Philip III"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Sepúlveda", "target_book": "polyanthea_medicinal", "target_name": "Sepulveda", "similarity": 0.396}], "id": 1959, "stable_key": "clu_9ef98bf4b8e4e09f", "ground_truth": {"modern_name": "Juan Ginés de Sepúlveda", "confidence": "high", "type": "person", "birth_year": 1490, "death_year": 1573, "description": "Spanish philosopher and theologian, debated indigenous rights", "note": "The text mentions him as a scholar and physician to Philip III, which is incorrect. Juan Ginés de Sepúlveda was primarily a philosopher and theologian, and though he lived in the 16th century, he was not known as a physician nor associated with Philip III."}, "cross_references": [{"found_name": "Aristotle", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 62, "target_cluster_name": "Aristotle", "source_book": "llm_generated", "evidence_snippet": "Sepúlveda was a prominent Aristotelian philosopher and theologian, deeply engaged with and often defending Aristotelian thought against critics.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Sepúlveda was a prominent Aristotelian philosopher and theologian, deeply engaged with and often defending Aristotelian thought against critics."}, {"found_name": "Averroes", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 952, "target_cluster_name": "Averroes", "source_book": "llm_generated", "evidence_snippet": "Sepúlveda engaged in significant debate with Averroist interpretations of Aristotle, particularly concerning the immortality of the soul.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Sepúlveda engaged in significant debate with Averroist interpretations of Aristotle, particularly concerning the immortality of the soul."}, {"found_name": "Avicenna", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1492, "target_cluster_name": "Avicena", "source_book": "llm_generated", "evidence_snippet": "Sepúlveda, like many Renaissance thinkers, was aware of and sometimes contrasted with Avicenna's philosophical positions, especially in relation to Aristotelianism.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Sepúlveda, like many Renaissance thinkers, was aware of and sometimes contrasted with Avicenna's philosophical positions, especially in relation to Aristotelianism."}, {"found_name": "Galen", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 29, "target_cluster_name": "Galen", "source_book": "llm_generated", "evidence_snippet": "Sepúlveda, as a humanist scholar, would have been familiar with Galen's medical and philosophical works, which were foundational in the period.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Sepúlveda, as a humanist scholar, would have been familiar with Galen's medical and philosophical works, which were foundational in the period."}, {"found_name": "Hippocrates", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 31, "target_cluster_name": "Hippocrates", "source_book": "llm_generated", "evidence_snippet": "Sepúlveda, as a humanist scholar, would have been familiar with Hippocrates' medical works, which were foundational in the period.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Sepúlveda, as a humanist scholar, would have been familiar with Hippocrates' medical works, which were foundational in the period."}, {"found_name": "Charles V, Holy Roman Emperor", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 771, "target_cluster_name": "Carlos V.", "source_book": "llm_generated", "evidence_snippet": "Sepúlveda served as a chaplain and historian to Emperor Charles V, and his intellectual work was often situated within the political and religious context of Charles's reign.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Sepúlveda served as a chaplain and historian to Emperor Charles V, and his intellectual work was often situated within the political and religious context of Charles's reign."}, {"found_name": "Pope", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2862, "target_cluster_name": "papa", "source_book": "llm_generated", "evidence_snippet": "Sepúlveda's theological writings and his involvement in debates concerning the Spanish conquest of the Americas had significant implications for papal authority and policy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Sepúlveda's theological writings and his involvement in debates concerning the Spanish conquest of the Americas had significant implications for papal authority and policy."}]}, {"canonical_name": "Espodio", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 25, "members": [{"entity_id": "espodio", "book_id": "coloquios_da_orta_1563", "name": "Espodio", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 11, "variants": ["Espodio", "espodio", "espodio metallico"], "contexts": ["preparation from burnt elephant bones", "substance discussed"]}, {"entity_id": "espodio", "book_id": "polyanthea_medicinal", "name": "espodio", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["espodio"], "contexts": ["ingredient in a remedy for diabetes", "used in trociscos"]}, {"entity_id": "spodio", "book_id": "coloquios_da_orta_1563", "name": "spodio", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["spodio", "spodo"], "contexts": ["ancient substance", "burnt ivory, also called spodium Arabum"]}, {"entity_id": "spodio", "book_id": "ricettario_fiorentino_1597", "name": "Spodio", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 9, "variants": ["Spodio"], "contexts": ["substance found in furnaces", "a substance from the East"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Espodio", "target_book": "polyanthea_medicinal", "target_name": "espodio", "similarity": 0.672}], "id": 1960, "stable_key": "clu_6dbc80d5fa096efa", "ground_truth": {"modern_name": "Spodium", "confidence": "high", "type": "substance", "description": "A residue from furnaces or a substance derived from the East.", "note": "Likely a reference to a charcoal-like substance or mineral residue.", "wikipedia_extract": "Spodium, (Latin for ashes or soot) refers to burned bone (usually used for medical purposes), or the act of divination with ash. Spodium may also refer to other types of ash, such as the scrapings from the inside of a furnace. Spodium has a long history of medical usage, mentioned by Hippocrates and, for example, in the Medical Poem of Salerno \"...Who knows the cause why Spodium stancheth bleeding?...\" (in this case spodium referring to oxen bone Ashes)."}, "member_count": 4, "cross_references": [{"found_name": "Carbon", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 11, "target_cluster_name": "carbon", "source_book": "llm_generated", "evidence_snippet": "Ashes are primarily composed of carbon and mineral compounds resulting from combustion. Carbon is a fundamental component of spodium.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Ashes are primarily composed of carbon and mineral compounds resulting from combustion. Carbon is a fundamental component of spodium."}, {"found_name": "Earths", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1183, "target_cluster_name": "earths", "source_book": "llm_generated", "evidence_snippet": "Spodium, particularly when referring to furnace scrapings or mineral ashes, can be considered a type of earth or mineral substance.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Spodium, particularly when referring to furnace scrapings or mineral ashes, can be considered a type of earth or mineral substance."}, {"found_name": "pompholige", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "medicine, che fi danno dentro al corpo; come quello che fi fa di cime di mortella, ò di vliuaftri abbruciate,comefi dirà j & in quelle di fuori, ó il vero Spodio, ò la pompholige o vero la tuzia de gl", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym"}, {"found_name": "tuzia de gli Speziali", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "medicine, che fi danno dentro al corpo; come quello che fi fa di cime di mortella, ò di vliuaftri abbruciate,comefi dirà j & in quelle di fuori, ó il vero Spodio, ò la pompholige o vero la tuzia de gl", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym"}, {"found_name": "Tabaxir", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "medicine, che fi danno dentro al corpo; come quello che fi fa di cime di mortella, ò di vliuaftri abbruciate,comefi dirà j & in quelle di fuori, ó il vero Spodio, ò la pompholige o vero la tuzia de gl", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym"}]}, {"canonical_name": "triaga", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "triaga", "book_id": "coloquios_da_orta_1563", "name": "triaga", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 11, "variants": ["triaga", "triacal", "triaga bebida", "triagua"], "contexts": ["theriac, compound medicine", "universal antidote"]}, {"entity_id": "triaca", "book_id": "ricettario_fiorentino_1597", "name": "Triaca", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["Triaca", "tria- ca"], "contexts": ["theriac (antidote)", "theriac, a complex antidote"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "triaga", "target_book": "ricettario_fiorentino_1597", "target_name": "Triaca", "similarity": 0.906}], "id": 1961, "stable_key": "clu_4e2b3940447005ed", "ground_truth": {"modern_name": "Theriac", "confidence": "high", "type": "substance", "description": "A complex compound medicine or antidote, historically used as a panacea.", "wikipedia_extract": "Theriac or theriaca is a medical concoction originally labelled by the Greeks in the 1st century AD and widely adopted in the ancient world as far away as Persia, China and India via the trading links of the Silk Route. It was an alexipharmic, or antidote for a variety of poisons and diseases. It was also considered a panacea, a term for which it could be used interchangeably: in the 16th century Adam Lonicer wrote that garlic was the rustic's theriac or Heal-All. The word theriac comes from the Greek term θηριακή (thēriakē), a feminine adjective signifying \"pertaining to animals\", from θηρίον (thērion), \"wild animal, beast\". The ancient bestiaries included information—often fanciful—about dangerous beasts and their bites. When cane sugar was an exotic Eastern commodity, the English recommended the sugar-based treacle as an antidote against poison, originally applied as a salve."}, "cross_references": [{"found_name": "Theriaca", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 309, "target_cluster_name": "Theriaca", "source_book": "llm_generated", "evidence_snippet": "Directly provided as an alternative name for Theriac.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "Directly provided as an alternative name for Theriac."}, {"found_name": "pa:(am", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 880, "target_cluster_name": "antidotos", "source_book": "coloquios_da_orta_1563", "evidence_snippet": "esta pedra pa^ar, do pa^am (bode así chamado), e asi quando ▼os cá pedem alguma mezinha contra a peçonha, lhe cha- mam pa:(am^ e asi chamam o locomio* e a triaga alguns. Este nome de pa:{ar lhe chamam", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "alternative name for triaga"}, {"found_name": "locomio", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "esta pedra pa^ar, do pa^am (bode así chamado), e asi quando ▼os cá pedem alguma mezinha contra a peçonha, lhe cha- mam pa:(am^ e asi chamam o locomio* e a triaga alguns. Este nome de pa:{ar lhe chamam", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for triaga"}]}, {"canonical_name": "Chingualas", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "chingualas", "book_id": "coloquios_da_orta_1563", "name": "Chingualas", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 8, "variants": ["Chingualas", "Chin", "Chinas", "Chingalas", "Chingallas", "Chtngalas", "chin"], "contexts": ["people of Ceylon", "language"]}, {"entity_id": "chenticos", "book_id": "polyanthea_medicinal", "name": "Chenticos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 5, "variants": ["Chenticos"], "contexts": ["a group referred to by authors", "physicians or learned men"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Chingualas", "target_book": "polyanthea_medicinal", "target_name": "Chenticos", "similarity": 0.859}], "id": 1962, "stable_key": "clu_18ebbe59d59e279c", "ground_truth": {"modern_name": "Sinhalese people", "confidence": "high", "type": "person", "description": "The majority ethnic group of Sri Lanka (formerly Ceylon)", "note": "The OCR likely mistranscribed 'Sinhalese' as 'Chingualas' and 'Chenticos'.", "wikidata_id": "Q932244", "wikidata_description": "ethnic group of Sri Lanka"}, "cross_references": []}, {"canonical_name": "melancia", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "melancia", "book_id": "coloquios_da_orta_1563", "name": "melancia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["melancia", "melancias"], "contexts": ["one of the four great cold seeds", "Portuguese name for water melon"]}, {"entity_id": "melancia", "book_id": "polyanthea_medicinal", "name": "melancia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 9, "variants": ["melancia", "Melancia", "melancias"], "contexts": ["seeds used for refreshing and cleansing kidneys", "watermelon used in remedy"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "melancia", "target_book": "polyanthea_medicinal", "target_name": "melancia", "similarity": 1.0}], "id": 1963, "stable_key": "clu_c6d5e75ec4049478", "ground_truth": {"modern_name": "watermelon", "confidence": "high", "type": "plant", "linnaean": "Citrullus lanatus", "family": "Cucurbitaceae", "description": "A large, sweet fruit with a hard rind, often used for its cooling properties.", "wikipedia_extract": "The watermelon (Citrullus lanatus) is a species of flowering plant in the family Cucurbitaceae, that has a large, edible fruit. It is a scrambling and trailing vine-like plant, and is widely cultivated worldwide, with more than 1,000 varieties. Watermelons are grown in favorable climates from tropical to temperate regions worldwide for its large edible fruit, which is a berry with a hard rind and no internal divisions, and is botanically called a pepo. The sweet, juicy flesh is usually deep red to pink, with many seeds that are black when mature, white when immature. Seedless varieties also exist. The fruit can be eaten raw or pickled, and the rind is edible after cooking."}, "cross_references": [{"found_name": "Colocynthis", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3818, "target_cluster_name": "Colocynthis", "source_book": "llm_generated", "evidence_snippet": "Colocynth (Citrullus colocynthis) is closely related botanically to the watermelon (Citrullus lanatus), both belonging to the same genus.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Colocynth (Citrullus colocynthis) is closely related botanically to the watermelon (Citrullus lanatus), both belonging to the same genus.", "is_reverse": true}, {"found_name": "Melon", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2227, "target_cluster_name": "melões", "source_book": "llm_generated", "evidence_snippet": "Watermelon and melon are both cucurbit fruits, often cultivated and discussed together in historical texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Watermelon and melon are both cucurbit fruits, often cultivated and discussed together in historical texts."}, {"found_name": "Melao", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2637, "target_cluster_name": "Melao", "source_book": "llm_generated", "evidence_snippet": "Watermelon and melao are both cucurbit fruits, often cultivated and discussed together in historical texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Watermelon and melao are both cucurbit fruits, often cultivated and discussed together in historical texts."}, {"found_name": "melões", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2227, "target_cluster_name": "melões", "source_book": "llm_generated", "evidence_snippet": "Watermelon and melões are both cucurbit fruits, often cultivated and discussed together in historical texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Watermelon and melões are both cucurbit fruits, often cultivated and discussed together in historical texts."}, {"found_name": "Melons", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4041, "target_cluster_name": "melons", "source_book": "llm_generated", "evidence_snippet": "Watermelon and Melons are both cucurbit fruits, often cultivated and discussed together in historical texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Watermelon and Melons are both cucurbit fruits, often cultivated and discussed together in historical texts."}]}, {"canonical_name": "Coimbra", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "coimbra", "book_id": "coloquios_da_orta_1563", "name": "Coimbra", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Coimbra"], "contexts": ["university where Dimas Bosque completed studies"]}, {"entity_id": "coimbra", "book_id": "polyanthea_medicinal", "name": "Coimbra", "category": "PLACE", "subcategory": "CITY", "count": 12, "variants": ["Coimbra"], "contexts": ["location of university", "University city in Portugal"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Coimbra", "target_book": "polyanthea_medicinal", "target_name": "Coimbra", "similarity": 1.0}], "id": 1964, "stable_key": "clu_12a8bcf99d4991c4", "ground_truth": {"modern_name": "Coimbra", "confidence": "high", "type": "place", "description": "A historic university city in Portugal.", "note": "NuevaCoimbra is likely a reference to Coimbra or a settlement named after it.", "wikipedia_extract": "Coimbra, officially the City of Coimbra, is a city and a municipality in Portugal. The population of the municipality at the 2021 census was 140,796, in an area of 319.40 square kilometres (123.3 sq mi). It is the fourth-largest agglomerated urban area in Portugal after Lisbon, Porto, and Braga, and is the largest city of the district of Coimbra and the Central Region. About 460,000 people live in its intermunicipal community. Among the many archaeological structures dating back to the Roman era, when Coimbra was the settlement of Aeminium, are its well-preserved aqueduct and cryptoporticus. Similarly, buildings from the period when Coimbra was the capital of Portugal (from 1131 to 1255) still remain."}, "cross_references": [{"found_name": "Portugal", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 37, "target_cluster_name": "Portugal", "source_book": "llm_generated", "evidence_snippet": "Coimbra is a city in Portugal, historically significant as the seat of its first university.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Coimbra is a city in Portugal, historically significant as the seat of its first university.", "is_reverse": true}, {"found_name": "Universidade de Coimbra", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3211, "target_cluster_name": "Universidade de Coimbra", "source_book": "llm_generated", "evidence_snippet": "The University of Coimbra is a major institution located in the city of Coimbra, indicating a strong geographical and institutional connection.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The University of Coimbra is a major institution located in the city of Coimbra, indicating a strong geographical and institutional connection."}]}, {"canonical_name": "red rays", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "red_rays", "book_id": "connexion_physical_sciences_somerville_1858", "name": "red rays", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 12, "variants": ["red rays"], "contexts": ["part of the solar spectrum", "part of the spectrum with least dispersion"]}, {"entity_id": "red_rays", "book_id": "first_principles_spencer_1862", "name": "red rays", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["red rays"], "contexts": ["light with longest undulations"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "red rays", "target_book": "first_principles_spencer_1862", "target_name": "red rays", "similarity": 1.0}], "id": 1965, "stable_key": "clu_02f31b1795b600b2", "ground_truth": {"modern_name": "Red light", "confidence": "high", "type": "concept"}, "cross_references": [{"found_name": "red", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1713, "target_cluster_name": "red", "source_book": "llm_generated", "evidence_snippet": "Red Light is a specific manifestation or aspect of the color Red.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Red Light is a specific manifestation or aspect of the color Red.", "is_reverse": true}]}, {"canonical_name": "spheroid", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "spheroid", "book_id": "connexion_physical_sciences_somerville_1858", "name": "spheroid", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 10, "variants": ["Spheroid", "spheroid"], "contexts": ["nearly spherical shape", "shape resembling a sphere"]}, {"entity_id": "spheroid", "book_id": "first_principles_spencer_1862", "name": "spheroid", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["spheroid"], "contexts": ["imperfectly specific geometric figure", "celestial body shape"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "spheroid", "target_book": "first_principles_spencer_1862", "target_name": "spheroid", "similarity": 1.0}], "id": 1966, "stable_key": "clu_3bf50a66c94877de", "ground_truth": {"modern_name": "Spheroid", "confidence": "high", "type": "concept"}, "cross_references": [{"found_name": "sphere", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 783, "target_cluster_name": "sphere", "source_book": "llm_generated", "evidence_snippet": "A spheroid is a shape that is almost a sphere, often an oblate or prolate spheroid, differing slightly from a perfect sphere.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: A spheroid is a shape that is almost a sphere, often an oblate or prolate spheroid, differing slightly from a perfect sphere.", "is_reverse": true}]}, {"canonical_name": "Austin", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "austin", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Austin", "category": "PERSON", "subcategory": "AUTHORITY", "count": 10, "variants": ["Austin"], "contexts": ["referring to Augustine of Hippo", "ancient source cited for heresies"]}, {"entity_id": "st_austin", "book_id": "first_principles_spencer_1862", "name": "St Austin", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["St Austin"], "contexts": ["language for recognizing existence beyond reach", "ancient authority on knowledge and ignorance"]}, {"entity_id": "st__augustine", "book_id": "kosmos_humboldt_1845", "name": "St. Augustine", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["St. Augustine"], "contexts": ["city in Florida, United States", "early Church father discussing creation after the flood"]}, {"entity_id": "st__augustin", "book_id": "first_principles_spencer_1862", "name": "St. Augustin", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["St. Augustin"], "contexts": ["early Christian theologian and philosopher"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Austin", "target_book": "first_principles_spencer_1862", "target_name": "St Austin", "similarity": 0.87}], "id": 1967, "stable_key": "clu_2441e42901920a42", "ground_truth": {"modern_name": "Augustine of Hippo", "confidence": "high", "type": "person", "birth_year": 354, "death_year": 430, "description": "Early Christian theologian and philosopher, bishop of Hippo Regius.", "wikidata_id": "Q8018", "wikidata_description": "Christian theologian, philosopher, and saint (354–430)", "wikipedia_url": "https://en.wikipedia.org/wiki/Augustine%20of%20Hippo", "wikipedia_extract": "Augustine of Hippo ( aw-GUST-in, US also  AW-gə-steen; Latin: Aurelius Augustinus Hipponensis; 13 November 354 – 28 August 430) was a Christian theologian and philosopher from Roman Africa. He was the bishop of Hippo Regius from Thagaste in Numidia Cirtensis, (present-day Souk Ahras, Algeria). His writings deeply influenced the development of Western philosophy and Western Christianity, and he is viewed as one of the most important Church Fathers of the Latin Church in the Patristic Period. His many important works include The City of God, On Christian Doctrine, and Confessions. According to his contemporary, Jerome of Stridon, Augustine \"established anew the ancient Faith\". In his youth he was drawn to the Manichaean faith, and later to the Hellenistic philosophy of Neoplatonism."}, "member_count": 4, "cross_references": [{"found_name": "philosopher", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 431, "target_cluster_name": "philosopher", "source_book": "llm_generated", "evidence_snippet": "Augustine of Hippo was a philosopher and theologian whose writings influenced the development of Western philosophy and Western Christianity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Augustine of Hippo was a philosopher and theologian whose writings influenced the development of Western philosophy and Western Christianity.", "is_reverse": true}, {"found_name": "Isidore", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 938, "target_cluster_name": "Isidore", "source_book": "llm_generated", "evidence_snippet": "Isidore of Seville was a major figure in the transmission and synthesis of classical and Christian knowledge, heavily influenced by Augustine of Hippo's theological and philosophical works. Isidore's own encyclopedic works, like the Etymologiae, drew extensively from Augustine.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Isidore of Seville was a major figure in the transmission and synthesis of classical and Christian knowledge, heavily influenced by Augustine of Hippo's theological and philosophical works. Isidore's own encyclopedic works, like the Etymologiae, drew extensively from Augustine.", "is_reverse": true}, {"found_name": "Augustus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2668, "target_cluster_name": "Augustus", "source_book": "llm_generated", "evidence_snippet": "Augustine of Hippo was a prominent figure in the early Christian church, and Augustus was the first Roman Emperor. Both are foundational figures in Western history and religion, with Augustine's theological work often engaging with the legacy of the Roman Empire established by Augustus.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Augustine of Hippo was a prominent figure in the early Christian church, and Augustus was the first Roman Emperor. Both are foundational figures in Western history and religion, with Augustine's theological work often engaging with the legacy of the Roman Empire established by Augustus."}, {"found_name": "Thomas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2931, "target_cluster_name": "Thomas", "source_book": "llm_generated", "evidence_snippet": "Augustine of Hippo was a highly influential Church Father whose theological writings were a primary source and inspiration for Thomas Aquinas's own theological work.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Augustine of Hippo was a highly influential Church Father whose theological writings were a primary source and inspiration for Thomas Aquinas's own theological work.", "is_reverse": true}]}, {"canonical_name": "ass", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "asses", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Asses", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["Asses"], "contexts": ["donkey animals", "animal discussed for gall presence"]}, {"entity_id": "ass", "book_id": "origin_of_species_darwin_1859", "name": "ass", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 9, "variants": ["ass"], "contexts": ["domesticated equid species", "animal with transverse bars on legs"]}, {"entity_id": "asses", "book_id": "origin_of_species_darwin_1859", "name": "Asses", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Asses"], "contexts": ["striped"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Asses", "target_book": "origin_of_species_darwin_1859", "target_name": "ass", "similarity": 0.897}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Asses", "target_book": "origin_of_species_darwin_1859", "target_name": "Asses", "similarity": 1.0}], "id": 1968, "stable_key": "clu_2a6e3ddff74221e1", "ground_truth": {"modern_name": "Donkey", "confidence": "high", "type": "animal", "wikidata_id": "Q19707", "wikidata_description": "subspecies of mammal (donkey as a domesticated subspecies); beast of burden, similar to a horse, but smaller", "wikipedia_url": "https://en.wikipedia.org/wiki/Donkey", "wikipedia_extract": "The donkey or ass is a domesticated equine. It derives from the African wild ass, Equus africanus, and may be classified either as a subspecies thereof, Equus africanus asinus, or as a separate species, Equus asinus. It was domesticated in Africa some 5000–7000 years ago, and has been used mainly as a working animal since that time. There are more than 40 million donkeys in the world, mostly in underdeveloped countries, where they are used principally as draught or pack animals. While working donkeys are often associated with those living at or below subsistence, small numbers of donkeys or asses are kept for breeding, as pets, and for livestock protection in developed countries. An adult male donkey is a jack or jackass, an adult female is a jenny or jennet, and an immature donkey of either sex is a foal."}, "cross_references": [{"found_name": "Horse", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 115, "target_cluster_name": "horse", "source_book": "llm_generated", "evidence_snippet": "Donkeys and horses are both domesticated equines and are often discussed together in historical texts concerning animal husbandry and transportation.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Donkeys and horses are both domesticated equines and are often discussed together in historical texts concerning animal husbandry and transportation."}, {"found_name": "Mule", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2676, "target_cluster_name": "mule", "source_book": "llm_generated", "evidence_snippet": "Mules are the offspring of a male donkey and a female horse, making them a direct product of donkey reproduction and a closely related entity in historical contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Mules are the offspring of a male donkey and a female horse, making them a direct product of donkey reproduction and a closely related entity in historical contexts."}]}, {"canonical_name": "Wolf", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "wolves", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Wolves", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Wolves"], "contexts": ["animal causing fear and silence", "animals that attacked people"]}, {"entity_id": "wolf", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Wolf", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Wolf"], "contexts": ["animal associated with vision myths"]}, {"entity_id": "wolf", "book_id": "origin_of_species_darwin_1859", "name": "Wolf", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 6, "variants": ["wolf", "Wolf"], "contexts": ["predatory mammal", "predatory canine species"]}, {"entity_id": "wolves", "book_id": "origin_of_species_darwin_1859", "name": "Wolves", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 3, "variants": ["Wolves", "wolves"], "contexts": ["wi