}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "froid", "target_book": "polyanthea_medicinal", "target_name": "frio", "similarity": 0.981}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "frio", "target_book": "coloquios_da_orta_1563", "target_name": "frio", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "frio", "target_book": "polyanthea_medicinal", "target_name": "frio", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "frio", "target_book": "polyanthea_medicinal", "target_name": "frio", "similarity": 1.0}], "id": 201, "stable_key": "clu_a203d1c75aecf137", "ground_truth": {"modern_name": "cold", "confidence": "high", "type": "concept", "wikidata_id": "Q199804", "wikidata_description": "lung disease involving long-term poor airflow", "wikipedia_url": "https://en.wikipedia.org/wiki/Chronic%20obstructive%20pulmonary%20disease", "note": "Refers to the physical sensation and thermodynamic state of low temperature, as well as its perceived qualities in historical medical contexts.", "wikipedia_extract": "Chronic obstructive pulmonary disease (COPD) is a type of progressive lung disease characterized by chronic respiratory symptoms and airflow limitation. GOLD defines COPD as a heterogeneous lung condition characterized by chronic respiratory symptoms (shortness of breath, cough, sputum production or exacerbations) due to abnormalities of the airways (bronchitis, bronchiolitis) or alveoli (emphysema) that cause persistent, often progressive, airflow obstruction. The main symptoms of COPD include shortness of breath and a cough, which may or may not produce mucus. COPD progressively worsens, with everyday activities such as walking or dressing becoming difficult. While COPD is incurable, it is preventable and treatable. The two most common types of COPD are emphysema and chronic bronchitis, and have been the two classic COPD phenotypes."}, "member_count": 14, "cross_references": [{"found_name": "causa fria", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 4473, "target_cluster_name": "causa fria", "source_book": "llm_generated", "evidence_snippet": "This is a direct translation of the adjective form of the concept.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: This is a direct translation of the adjective form of the concept.", "is_reverse": true}, {"found_name": "Flower-de-luce", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "english_physician_1652", "evidence_snippet": "and is also very effectual for all disea∣ses of the Lungs, as shortness of breath, wheesings, hoarsness of the Throat, and the Cough, and to expectorate cold Flegm, or a∣ny other parts thereabouts. It", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym"}, {"found_name": "fric", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "relation_historique_humboldt_vol3_1825", "evidence_snippet": "M. Benito Sanchez Dorta ; celles de Macao , de 1 200 observations que M. l'abbé Richenet a bien voulu me communiquer ■^. ' Ce froid accidentel avoit déjà frappé les premiers voyageurs. « En Cuba, dit ", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym"}]}, {"canonical_name": "Plinio", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 9, "total_mentions": 226, "members": [{"entity_id": "plinio", "book_id": "historia_medicinal_monardes_1574", "name": "Plinio", "category": "PERSON", "subcategory": "AUTHORITY", "count": 9, "variants": ["Plinio"], "contexts": ["ancient author on natural history", "ancient authority on natural history"]}, {"entity_id": "plinio", "book_id": "coloquios_da_orta_1563", "name": "Plinio", "category": "PERSON", "subcategory": "AUTHORITY", "count": 112, "varia