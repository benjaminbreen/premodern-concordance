.85, "auto_label": "llm_related", "found_relationship": "Sweets are a component of dietary regimens."}]}, {"canonical_name": "papoulas", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 23, "members": [{"entity_id": "papoula", "book_id": "coloquios_da_orta_1563", "name": "papoula", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["papoula"], "contexts": ["plant cultivated for opium"]}, {"entity_id": "papoulas", "book_id": "polyanthea_medicinal", "name": "papoulas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 20, "variants": ["papoulas", "Papoulas", "papoulis"], "contexts": ["remedy for thin humor", "ingredient in a syrup"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "papoula", "target_book": "polyanthea_medicinal", "target_name": "papoulas", "similarity": 0.918}], "id": 1723, "stable_key": "clu_f7b7ffa9d510bc19", "ground_truth": {"modern_name": "Poppy", "confidence": "high", "type": "plant", "linnaean": "Papaver", "family": "Papaveraceae", "description": "A flowering plant, source of opium and other medicinal compounds.", "wikipedia_extract": "Papaver  is a genus of 70–100 species of frost-tolerant annuals, biennials, and perennials native to temperate and cold regions of Eurasia, Africa and North America. It is the type genus of the poppy family, Papaveraceae. The flowers have two sepals that fall off as the bud opens, and four (or up to six) petals in red, pink, orange, yellow, or lilac. There are many stamens in several whorls around a compound pistil, which results from the fusion of carpels. The stigmas are visible on top of the capsule, and the number of stigmas corresponds to the number of fused carpels. The ovary later develops into a dehiscing capsule, capped by the dried stigmas."}, "cross_references": [{"found_name": "khaschkhasch", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "derivaram afiam, e depois por uma alteração phonetica natural amfiam. Para terminarmos desde já com a nomenclatura, diremos que árabes e deckanis chamam á papoula do ópio i^JLsr\\Là^, khaschkhasch, o «", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "Arabic/Deccani name for poppy"}]}, {"canonical_name": "Halley’s comet", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 23, "members": [{"entity_id": "halley's_great_comet", "book_id": "kosmos_humboldt_1845", "name": "Halley's great comet", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Halley's great comet"], "contexts": ["specific comet with long orbit"]}, {"entity_id": "comete_de_halley", "book_id": "kosmos_humboldt_1845", "name": "Comete de Halley", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Comete de Halley"], "contexts": ["subject of physical changes"]}, {"entity_id": "halley’s_comet", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Halley’s comet", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 12, "variants": ["Halley’s comet"], "contexts": ["comet whose motion is studied", "comet whose periodicity was established"]}, {"entity_id": "halley's_comet", "book_id": "kosmos_humboldt_1845", "name": "Halley's comet", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 8, "variants": ["Halley's comet"], "contexts": ["comet known from 1456 observation", "comet observed in 1835"]}, {"entity_id": "faye’s_comet", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Faye’s Comet", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Faye’s Comet"], "contexts": ["a specific comet"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Halley's great comet", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Halley’s comet", "similarity": 0.942}, {"source_book": "kosmos_humboldt_1845", "source_name": "Comete de Halley", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Halley’s comet", "similarity": 0.949}, {"source_book": "kosmos_humboldt_1845", "source_name": "Halley's comet", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Faye’s Comet", "similarity": 0.891}], "id": 1724, "stable_key": "clu_fcdde409c9383bca", "ground_truth": {"modern_name": "Halley's Comet", "confidence": "high", "type": "object", "note": "Faye's Comet is a different comet, but mentioned in the same text as Halley's comet, likely for comparison or contextualization.", "wikidata_id": "Q23054", "wikidata_description": "short-period comet visible from Earth every 75–76 years", "wikipedia_url": "https://en.wikipedia.org/wiki/Halley%27s%20Comet", "wikipedia_extract": "Halley's Comet is the only known short-period comet that is consistently visible to the naked eye from Earth, appearing every 72–80 years, though with the majority of recorded apparitions (25 of 30) occurring after 75–77 years. It last appeared in the inner parts of the Solar System in 1986 and will next appear in mid-2061. Officially designated 1P/Halley, it is also commonly called Comet Halley, or sometimes simply Halley. Halley's periodic returns to the inner Solar System have been observed and recorded by astronomers around the world since at least 240 BC, but it was not until 1705 that the English astronomer Edmond Halley understood that these appearances were re-appearances of the same comet. As a result of this discovery, the comet is named after Halley. In March 1986, during its latest visit to the inner Solar System, Halley's Comet became the first comet to be observed in detail by a spacecraft, ESA's Giotto mission, providing the first observational data on the structure of a comet nucleus and the mechanism of coma and tail formation."}, "member_count": 5, "cross_references": [{"found_name": "comet", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 291, "target_cluster_name": "comet", "source_book": "llm_generated", "evidence_snippet": "Halley's Comet is a specific instance of a comet.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Halley's Comet is a specific instance of a comet.", "is_reverse": true}, {"found_name": "Encke’s comet", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 899, "target_cluster_name": "Encke’s comet", "source_book": "llm_generated", "evidence_snippet": "Halley's Comet is another famous comet whose orbital period and behavior were studied extensively in the same historical period.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Halley's Comet is another famous comet whose orbital period and behavior were studied extensively in the same historical period.", "is_reverse": true}, {"found_name": "Encke's Comet", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 899, "target_cluster_name": "Encke’s comet", "source_book": "llm_generated", "evidence_snippet": "Another named comet, indicating a shared category and potential for comparative study in astronomical texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Another named comet, indicating a shared category and potential for comparative study in astronomical texts."}, {"found_name": "Comet of 1770", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2842, "target_cluster_name": "comet of 1770", "source_book": "llm_generated", "evidence_snippet": "Another named comet, indicating a shared category and potential for comparative study in astronomical texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Another named comet, indicating a shared category and potential for comparative study in astronomical texts."}, {"found_name": "Comet of 181