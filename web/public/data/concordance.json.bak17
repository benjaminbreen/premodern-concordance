cholera", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["cholera"], "contexts": ["infectious disease causing severe diarrhea"]}, {"entity_id": "cholera", "book_id": "coloquios_da_orta_1563", "name": "cholera", "category": "DISEASE", "subcategory": "ACUTE", "count": 11, "variants": ["cholera"], "contexts": ["disease described by Garcia da Orta", "suspected illness"]}, {"entity_id": "cholera_aduſta", "book_id": "polyanthea_medicinal", "name": "cholera aduſta", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["cholera aduſta"], "contexts": ["burnt cholera"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "cholera", "target_book": "coloquios_da_orta_1563", "target_name": "cholera", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "cholera", "target_book": "polyanthea_medicinal", "target_name": "cholera aduſta", "similarity": 0.888}, {"source_book": "coloquios_da_orta_1563", "source_name": "cholera", "target_book": "polyanthea_medicinal", "target_name": "cholera aduſta", "similarity": 0.888}], "id": 835, "stable_key": "clu_1bdcd42900462c78", "ground_truth": {"modern_name": "Cholera", "confidence": "high", "type": "disease", "description": "Severe infectious disease causing diarrhea and dehydration.", "wikipedia_extract": "Cholera () is an infection of the small intestine by some strains of the bacterium Vibrio cholerae. Symptoms may range from none, to mild, to severe. The classic symptom is large amounts of watery diarrhea lasting a few days. Vomiting and muscle cramps may also occur. Diarrhea can be so severe that it leads within hours to severe dehydration and electrolyte imbalance. This can in turn result in sunken eyes, cold or cyanotic skin, decreased skin elasticity, wrinkling of the hands and feet, and, in severe cases, death."}, "cross_references": [{"found_name": "camaras", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 1495, "target_cluster_name": "camaras", "source_book": "llm_generated", "evidence_snippet": "The entity 'Cholericas' is a historical name for a disease, and 'Cholera' is a direct modern medical term for a specific disease that shares a similar etymological root and historical understanding of symptoms, often involving severe gastrointestinal distress and dehydration, which could be broadly categorized under 'cholericas' in older medical contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The entity 'Cholericas' is a historical name for a disease, and 'Cholera' is a direct modern medical term for a specific disease that shares a similar etymological root and historical understanding of symptoms, often involving severe gastrointestinal distress and dehydration, which could be broadly categorized under 'cholericas' in older medical contexts.", "is_reverse": true}, {"found_name": "Dyarrhea", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1313, "target_cluster_name": "Dyarrhea", "source_book": "llm_generated", "evidence_snippet": "Cholera is a severe diarrheal disease characterized by extreme fluid loss and dehydration, often presenting with watery stools. It is a distinct but related condition due to its prominent diarrheal symptoms.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Cholera is a severe diarrheal disease characterized by extreme fluid loss and dehydration, often presenting with watery stools. It is a distinct but related condition due to its prominent diarrheal symptoms.", "is_reverse": true}]}, {"canonical_name": "coco", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 4, "total_mentions": 17, "members": [{"entity_id": "cocoa-nut", "book_id": "kosmos_humboldt_1845", "name": "cocoa-nut", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["cocoa-nut"], "contexts": ["plant requiring hot climate"]}, {"entity_id": "coco", "book_id": "coloquios_da_orta_1563", "name": "coco", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 11, "variants": ["coco", "Coco", "Coco de mer", "Cocos", "coco do mar"], "contexts": ["fruit of the coconut tree", "fruit of the palm tree"]}, {"entity_id": "cocomé", "book_id": "ricettario_fiorentino_1597", "name": "cocomé", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["cocomé"], "contexts": ["ingredient in decoction"]}, {"entity_id": "coco_das_maldivas", "book_id": "coloquios_da_orta_1563", "name": "coco das Maldivas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["coco das Maldivas", "Coquo das Maldivas"], "contexts": ["marine production with antidotal properties", "topic of colloquy"]}, {"entity_id": "cocos_demaldiva", "book_id": "polyanthea_medicinal", "name": "Cocos deMaldiva", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Cocos deMaldiva", "cocos de Maldiva"], "contexts": ["fruit from Maldives", "coconuts of Maldives"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "cocoa-nut", "target_book": "coloquios_da_orta_1563", "target_name": "coco", "similarity": 0.902}, {"source_book": "coloquios_da_orta_1563", "source_name": "coco", "target_book": "ricettario_fiorentino_1597", "target_name": "cocomé", "similarity": 0.919}], "id": 836, "stable_key": "clu_99fe77aa65c1c53c", "ground_truth": {"modern_name": "Coconut", "confidence": "high", "type": "plant", "family": "Arecaceae", "wikidata_id": "Q13187", "wikidata_description": "species of plant", "wikipedia_extract": "The coconut (Cocos nucifera) is a member of the palm family (Arecaceae) and the only living species of the genus Cocos. The term \"coconut\" (or the archaic \"cocoanut\") can denote the whole coconut palm tree or the large hard fruit. Originally native to Central Indo-Pacific, they are ubiquitous in coastal tropical regions. The coconut tree provides food, fuel, cosmetics, folk medicine and building materials. The inner flesh of the mature fruit forms a regular part of the diets of many people in the tropics and subtropics. Coconut endosperm contains a large quantity of a liquid, \"coconut water\".", "wikipedia_url": "https://en.wikipedia.org/wiki/Coconut", "linnaean": "Cocos nucifera Linnaeus"}, "member_count": 5, "cross_references": [{"found_name": "Tree", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 24, "target_cluster_name": "Tree", "source_book": "coloquios_da_orta_1563", "evidence_snippet": "chama jcai\\ialindi, que quer dizer no^ da índia; e Serapio* e Rasis chamam ao arvore j ar alnare, que quer àizcr ^arvore que dá coquos; e os Malabares chamam ao arvore tengamaram, e o firuito, quando ", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "reverse: Portuguese name for the fruit of the tree", "is_reverse": true}, {"found_name": "palmeta", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3040, "target_cluster_name": "palmeta", "source_book": "llm_generated", "evidence_snippet": "Coconut is the fruit of the coconut palm, a specific type of palm tree.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Coconut is the fruit of the coconut palm, a specific type of palm tree.", "is_reverse": true}]}, {"canonical_name": "Papauero", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "papaver", "book_id": "coloquios_da_orta_1563", "name": "Papaver", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Papaver"], "contexts": ["genus of opium poppy", "plant cultivated for opium"]}, {"entity_id": "papauero", "book_id": "ricettario_fiorentino_1597", "name": "Papauero", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 9, "variants": ["Papauero", "Papaueri", "Papaueri fieri", "papauero", "papautri", "paueri"], "contexts": ["flower head similar to poppy", "poppy plant"]}, {"entity_id": "papavera", "book_id": "polyanthea_medicinal", "name": "papavera", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["papavera", "Papaveris"], "contexts": ["sleep-inducing plant, poppy", "succus for urine without offense"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Papaver", "target_book": "ricettario_fiorentino_1597", "target_name": "Papauero", "similarity": 0.9}, {"source_book": "coloquios_da_orta_1563", "source_name": "Papaver", "target_book": "polyanthea_medicinal", "target_name": "papavera", "similarity": 0.947}], "id": 837, "stable_key": "clu_ac61437be1bdaf18", "ground_truth": {"modern_name": "Poppy", "confidence": "high", "type": "plant", "linnaean": "Papaver somniferum Linnaeus", "family": "Papaveraceae", "wikidata_id": "Q967457", "wikidata_description": "common name for various plant species of the family Papaveraceae", "wikipedia_url": "https://en.wikipedia.org/wiki/Poppy", "wikipedia_extract": "A poppy is a flowering plant in the subfamily Papaveroideae of the family Papaveraceae. Poppies are herbaceous plants, often grown for their colourful flowers. One species of poppy, Papaver somniferum, is the source of the narcotic drug mixture opium, which contains powerful medicinal alkaloids such as morphine and has been used since ancient times as an analgesic and narcotic medicinal and recreational drug. It also produces edible seeds. Following the trench warfare in the poppy fields of Flanders, Belgium, during World War I, poppies, specifically the red poppy, have become a symbol of remembrance of soldiers who have died during wartime, especially in the UK, Canada, Australia, Africa and other Commonwealth realms. Poppies are herbaceous annual, biennial or short-lived perennial plants."}, "cross_references": [{"found_name": "Poppy Seed", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2957, "target_cluster_name": "Poppy Seed", "source_book": "llm_generated", "evidence_snippet": "Poppy Seed is a direct product of the Poppy plant.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Poppy Seed is a direct product of the Poppy plant."}]}, {"canonical_name": "telescope", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 3, "total_mentions": 20, "members": [{"entity_id": "magnetic_telescope", "book_id": "kosmos_humboldt_1845", "name": "magnetic telescope", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["magnetic telescope"], "contexts": ["instrument for magnetic measurements"]}, {"entity_id": "telescope", "book_id": "connexion_physical_sciences_somerville_1858", "name": "telescope", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 10, "variants": ["telescope"], "contexts": ["instrument for astronomical observation", "instrument for viewing distant objects"]}, {"entity_id": "telescope", "book_id": "origin_of_species_darwin_1859", "name": "telescope", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["telescope"], "contexts": ["optical instrument for viewing distant objects"]}, {"entity_id": "telescope", "book_id": "kosmos_humboldt_1845", "name": "telescope", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["telescope"], "contexts": ["instrument for viewing distant objects"]}, {"entity_id": "telescopes", "book_id": "kosmos_humboldt_1845", "name": "telescopes", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 4, "variants": ["telescopes"], "contexts": ["instruments for astronomical observation", "instruments for viewing distant objects"]}, {"entity_id": "telescopes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "telescopes", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 3, "variants": ["telescopes"], "contexts": ["instruments for observing distant objects", "instruments for viewing distant objects"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "magnetic telescope", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "telescope", "similarity": 0.907}, {"source_book": "origin_of_species_darwin_1859", "source_name": "telescope", "target_book": "kosmos_humboldt_1845", "target_name": "telescope", "similarity": 1.0}], "id": 838, "stable_key": "clu_d4351f70f3f48980", "ground_truth": {"modern_name": "Telescope", "confidence": "high", "type": "object", "wikidata_id": "Q4213", "wikidata_description": "instrument that aids in the observation of remote objects", "wikipedia_url": "https://en.wikipedia.org/wiki/Telescope", "wikipedia_extract": "A telescope is a device used to observe distant objects by their emission, absorption, or reflection of electromagnetic radiation. Originally, it was an optical instrument using lenses, curved mirrors, or a combination of both to observe distant objects – an optical telescope. Nowadays, the word \"telescope\" is defined as a wide range of instruments capable of detecting different regions of the electromagnetic spectrum, and in some cases other types of detectors. The first known practical telescopes were refracting telescopes with glass lenses and were invented in the Netherlands at the beginning of the 17th century. They were used for both terrestrial applications and astronomy. The reflecting telescope, which uses mirrors to collect and focus light, was invented within a few decades of the first refracting telescope."}, "member_count": 6, "cross_references": [{"found_name": "lens", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2485, "target_cluster_name": "lens", "source_book": "llm_generated", "evidence_snippet": "Lenses are a fundamental component of many optical telescopes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Lenses are a fundamental component of many optical telescopes."}, {"found_name": "mirror", "link_type": "conceptua