, "book_id": "coloquios_da_orta_1563", "name": "açucar", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["açucar"], "contexts": ["sugar added to rose decoction"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Sugar", "target_book": "english_physician_1652", "target_name": "Sugar", "similarity": 1.0}, {"source_book": "ricettario_fiorentino_1597", "source_name": "sugar", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sugar", "similarity": 1.0}], "id": 254, "stable_key": "clu_cabc34d122a61150", "ground_truth": {"modern_name": "Sugar", "confidence": "high", "type": "substance", "description": "Sweet crystalline substance derived from plants, used as a sweetener.", "note": "Refers to the substance itself, distinct from the plant.", "wikipedia_extract": "Sugar () is a class of sweet-tasting, soluble carbohydrates, many of which are used in food. Simple sugars, also called monosaccharides, include glucose, fructose, and galactose. Compound sugars, also called disaccharides or double sugars, are molecules made of two bonded monosaccharides; common examples are sucrose (glucose + fructose), lactose (glucose + galactose), and maltose (two molecules of glucose). White sugar is almost pure sucrose. During digestion, compound sugars are hydrolysed into simple sugars. Longer chains of saccharides are not regarded as sugars, and are called oligosaccharides or polysaccharides."}, "member_count": 10, "cross_references": [{"found_name": "Agarico", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 567, "target_cluster_name": "Agarico", "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "fine aggi ugni te , facci la decozzi one di liero I cpithymo , che habbi vn boi- di capra* lore, éc leua da fuoco ^ & ag- giugni Heìl boro nero Agarico Saie indo cioè zucchero . 31.^. Lafcia freddare,", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship":