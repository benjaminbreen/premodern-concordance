most of this is limestone."}, "member_count": 11, "cross_references": [{"found_name": "stone", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 132, "target_cluster_name": "stone", "source_book": "llm_generated", "evidence_snippet": "Limestone is a sedimentary rock composed mainly of calcium carbonate, a common type of stone.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Limestone is a sedimentary rock composed mainly of calcium carbonate, a common type of stone.", "is_reverse": true}, {"found_name": "Chalk", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 829, "target_cluster_name": "chalk", "source_book": "llm_generated", "evidence_snippet": "Chalk is a soft, white, porous sedimentary rock, a form of limestone composed of the mineral calcite.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Chalk is a soft, white, porous sedimentary rock, a form of limestone composed of the mineral calcite."}, {"found_name": "Jura limestone", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1987, "target_cluster_name": "Jura limestone", "source_book": "llm_generated", "evidence_snippet": "Jura limestone is a specific geological formation of limestone.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Jura limestone is a specific geological formation of limestone."}, {"found_name": "rock", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 383, "target_cluster_name": "rock", "source_book": "llm_generated", "evidence_snippet": "Limestone is a sedimentary rock composed mainly of calcium carbonate.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Limestone is a sedimentary rock composed mainly of calcium carbonate.", "is_reverse": true}, {"found_name": "Lime", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 862, "target_clus