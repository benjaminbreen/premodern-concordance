, "similarity": 0.989}], "id": 1001, "stable_key": "clu_149bf5e9ccb48d31", "ground_truth": {"modern_name": "Damascus", "confidence": "high", "type": "place", "description": "Ancient city in Syria, significant as a trade route and political center.", "note": "Also referred to as Damasco.", "wikipedia_extract": "Damascus is the capital and largest city of Syria. It is the oldest capital city in the world. Known colloquially in Syria as aš-Šām and dubbed, poetically, the \"City of Jasmine\" (مَدِيْنَةُ الْيَاسْمِينِ Madīnat al-Yāsmīn), Damascus is a major cultural center of the Levant and the Arab world. Situated in southwestern Syria, Damascus is the center of a large metropolitan area. Nestled among the eastern foothills of the Anti-Lebanon mountain range 80 kilometres (50 mi) inland from the eastern shore of the Mediterranean on a plateau 680 metres (2,230 ft) above sea level, Damascus experiences an arid climate because of the rain shadow effect. The Barada River flows through Damascus."}, "cross_references": [{"found_name": "Syria", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1702, "target_cluster_name": "Syria", "source_book": "llm_generated", "evidence_snippet": "Damascus is the capital city of Syria.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Damascus is the capital city of Syria."}, {"found_name": "Jerusalem", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 954, "target_cluster_name": "Jerusalém", "source_book": "llm_generated", "evidence_snippet": "Jerusalem and Damascus are both ancient and historically significant cities in the Levant, often appearing in similar historical contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Jerusalem and Damascus are both ancient and historically significant cities in the Levant, often appearing in similar historical contexts."}, {"found_name": "Arabia", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 169, "target_cluster_name": "Arabia", "source_book": "llm_generated", "evidence_snippet": "Damascus is a major cultural center of the Arab world.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Damascus is a major cultural center of the Arab world."}]}, {"canonical_name": "Hail", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "hail", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Hail", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Hail"], "contexts": ["frozen precipitation"]}, {"entity_id": "hail", "book_id": "kosmos_humboldt_1845", "name": "hail", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["hail"], "contexts": ["frozen precipitation", "ice precipitation"]}, {"entity_id": "hail", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Hail", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["Hail", "hail"], "contexts": ["frozen precipitation", "approach makes atmosphere intensely electric"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hail", "target_book": "kosmos_humboldt_1845", "target_name": "hail", "similarity": 0.941}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hail", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Hail", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "hail", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Hail", "similarity": 0.941}], "id": 1002, "stable_key": "clu_ebf77973c4b59653", "ground_truth": {"modern_name": "Hail", "confidence": "high", "type": "concept", "wikidata_id": "Q1569280", "wikidata_description": "municipality in the region of Northern Ostrobothnia in Finland", "wikipedia_url": "https://en.wikipedia.org/wiki/Hailuoto", "wikipedia_extract": "Hail is a form of solid precipitation. It is distinct from ice pellets (American English \"sleet\"), though the two are often confused. It consists of balls or irregular lumps of ice, each of which is called a hailstone. Ice pellets generally fall in cold weather, while hail growth is greatly inhibited during low surface temperatures. Unlike other forms of water ice precipitation, such as graupel (which is made of rime ice), ice pellets (which are smaller and translucent), and snow (which consists of tiny, delicately crystalline flakes or needles), hailstones usually measure between 5 mm (0.2 in) and 15 cm (6 in) in diameter. The METAR reporting code for hail 5 mm (0.20 in) or greater is GR, while smaller hailstones and graupel are coded GS."}, "cross_references": [{"found_name": "ice", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 275, "target_cluster_name": "ice", "source_book": "llm_generated", "evidence_snippet": "Hail is a form of solid precipitation, similar to ice, that falls from thunderstorms.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Hail is a form of solid precipitation, similar to ice, that falls from thunderstorms.", "is_reverse": true}, {"found_name": "rain", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 693, "target_cluster_name": "rain", "source_book": "llm_generated", "evidence_snippet": "Hail is a form of precipitation consisting of solid ice pellets, often associated with thunderstorms that also produce rain.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Hail is a form of precipitation consisting of solid ice pellets, often associated with thunderstorms that also produce rain.", "is_reverse": true}]}, {"canonical_name": "cavallo marinho", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "sea-horse", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Sea-horse", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Sea-horse"], "contexts": ["animal whose body was tested for electricity"]}, {"entity_id": "cavallo_marinho", "book_id": "coloquios_da_orta_1563", "name": "cavallo marinho", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["cavallo marinho"], "contexts": ["sea horse, mentioned for comparison", "animal Orta said hippopotamus was not"]}, {"entity_id": "cavallo_marinho", "book_id": "polyanthea_medicinal", "name": "cavallo marinho", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 4, "variants": ["cavallo marinho", "CavalloMarinho", "cavallo Marinho"], "contexts": ["animal product used in medicine", "marine horse, worn around waist during pregnancy"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Sea-horse", "target_book": "coloquios_da_orta_1563", "target_name": "cavallo marinho", "similarity": 0.898}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Sea-horse", "target_book": "polyanthea_medicinal", "target_name": "cavallo marinho", "similarity": 0.898}, {"source_book": "coloquios_da_orta_1563", "source_name": "cavallo marinho", "target_book": "polyanthea_medicinal", "target_name": "cavallo marinho", "similarity": 1.0}], "id": 1003, "stable_key": "clu_37b52b1057ed5c51", "ground_truth": {"modern_name": "Seahorse", "confidence": "high", "type": "ANIMAL", "linnaean": "Hippocampus spp.", "family": "Syngnathidae", "description": "Marine fish used in medicine and for comparison.", "wikipedia_extract": "A seahorse (also written sea-horse and sea horse) is any of 46 species of small marine bony fish in the genus Hippocampus. The genus name comes from the Ancient Greek hippókampos (ἱππόκαμπος), itself from híppos (ἵππος) meaning \"horse\" and kámpos (κάμπος) meaning \"sea monster\" or \"sea animal\". Having a head and neck suggestive of a horse, seahorses also feature segmented bony armour, an upright posture and a curled prehensile tail. Along with the pipefishes and seadragons (Phycodurus and Phyllopteryx) they form the family Syngnathidae. Anatomical evidence, supported by molecular, physical, and genetic evidence, demonstrates that seahorses are highly modified pipefish. The fossil record of seahorses, however, is very sparse."}, "cross_references": [{"found_name": "Fish", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 94, "target_cluster_name": "Fish", "source_book": "llm_generated", "evidence_snippet": "Seahorses are a type of fish.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Seahorses are a type of fish."}, {"found_name": "Horse", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 115, "target_cluster_name": "horse", "source_book": "llm_generated", "evidence_snippet": "The name 'seahorse' and its genus name 'Hippocampus' are derived from the Greek word for 'horse', reflecting its equine-like head and neck.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The name 'seahorse' and its genus name 'Hippocampus' are derived from the Greek word for 'horse', reflecting its equine-like head and neck."}]}, {"canonical_name": "Mummia", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "mummia", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Mummia", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Mummia"], "contexts": ["substance tested for electrical properties"]}, {"entity_id": "mummia", "book_id": "english_physician_1652", "name": "Mummia", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Mummia"], "contexts": ["taken with Rubarb powder"]}, {"entity_id": "mummia", "book_id": "ricettario_fiorentino_1597", "name": "Mummia", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 6, "variants": ["Mummia", "Mumia"], "contexts": ["mummy substance", "substance used in preparation"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mummia", "target_book": "english_physician_1652", "target_name": "Mummia", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mummia", "target_book": "ricettario_fiorentino_1597", "target_name": "Mummia", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Mummia", "target_book": "ricettario_fiorentino_1597", "target_name": "Mummia", "similarity": 1.0}], "id": 1004, "stable_key": "clu_b0d516b5162b01a9", "ground_truth": {"modern_name": "Mummy", "confidence": "high", "type": "substance", "description": "Preserved human or animal remains, historically used in medicine.", "wikipedia_extract": "A mummy is a dead human or an animal whose soft tissues and organs have been preserved by either intentional or accidental exposure to chemicals, extreme cold, very low humidity, or lack of air, so that the recovered body does not decay further if kept in cool and dry conditions. Some authorities restrict the use of the term to bodies deliberately embalmed with chemicals, but the use of the word to cover accidentally desiccated bodies goes back to at least the early 17th century. Mummies of humans and animals have been found on every continent, both as a result of natural preservation through unusual conditions, and as cultural artifacts. Over one million animal mummies have been found in Egypt, many of which are cats. Many of the Egyptian animal mummies are sacred ibis, and radiocarbon dating suggests the Egyptian ibis mummies that have been analyzed were from a time frame that falls between approximately 450 and 250 BC. The earliest discovered evidence of deliberate mummification in human cultures now extends to approximately 10,000 B.C. and is documented to have existed across Southeast Asia, China, New Guinea, and Australia in burials discovered there, and is prompting research to cultures documented to 20,000 years ago for evidence of use of the same mummification methods."}, "cross_references": [{"found_name": "Gums", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1838, "target_cluster_name": "Gums", "source_book": "llm_generated", "evidence_snippet": "Mummy, in the context of historical materia medica, refers to a substance derived from mummified bodies, which could include resins and gums used as preservatives or medicines.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Mummy, in the context of historical materia medica, refers to a substance derived from mummified bodies, which could include resins and gums used as preservatives or medicines.", "is_reverse": true}, {"found_name": "piùsphalto", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "che Diolconde d^ccdel piflàsphalto, cioè che ella ha la medefima virtù , che ha il bitume,c la pece mefcolaca* Se cosi é,non ha • uendo noi la vera Mumia , ne il piflàsphalto di Diofcoride, fi può tar", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym"}]}, {"canonical_name": "Mice", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "mice", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Mice", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Mice"], "contexts": ["vermin killed by powdered glass"]}, {"entity_id": "mice", "book_id": "english_physician_1652", "name": "Mice", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Mice"], "contexts": ["vermin repelled by Wormwood ink", "small rodent"]}, {"entity_id": "mice", "book_id": "origin_of_species_darwin_1859", "name": "Mice", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 5, "variants": ["Mice", "mice"], "contexts": ["number dependent on cats", "prey for felines"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mice", "target_book": "english_physician_1652", "target_name": "Mice", "similarity": 0.822}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mice", "target_book": "origin_of_species_darwin_1859", "target_name": "Mice", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Mice", "target_book": "origin_of_species_darwin_1859", "target_name": "Mice", "similarity": 0.822}], "id": 1005, "stable_key": "clu_5d678eb9af9c7580", "ground_truth": {"modern_name": "Mouse", "confidence": "high", "type": "animal", "note": "The term 'Mice' is consistently used to refer to the common rodent.", "wikidata_id": "Q83310", "wikidata_description": "species of mammal", "wikipedia_url": "https://en.wikipedia.org/wiki/House%20mouse", "wikipedia_extract": "The house mouse (Mus musculus) is a small mammal of the rodent family Muridae, characteristically having a pointed snout, large rounded ears, and a long and almost hairless tail. It is one of the most abundant species of the genus Mus. Although a wild animal, the house mouse has benefited significantly from associating with human habitation to the point that truly wild populations are significantly less common than the synanthropic populations near human activity. The house mouse has been domesticated as the pet or fancy mouse, and as the laboratory mouse, which is one of the most important model organisms in biology and medicine. The complete mouse reference genome was sequenced in 2002. House mice have an adult body length (nose to base of tail) of 7.5–10 centimetres (3–4 in) and a tail length of 5–10 cm (2–4 in)."}, "cross_references": [{"found_name": "mouse", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2717, "target_cluster_name": "mouse", "source_book": "llm_generated", "evidence_snippet": "Plural form of the same animal.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: Plural form of the same animal.", "is_reverse": true}, {"found_name": "Rodents", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2366, "target_cluster_name": "Rodents", "source_book": "llm_generated", "evidence_snippet": "Mice are a common and well-known type of rodent.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Mice are a common and well-known type of rodent.", "is_reverse": true}]}, {"canonical_name": "Loeb", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 1, "total_mentions": 4, "members": [{"entity_id": "loeb", "book_id": "principles_of_psychology_james_1890", "name": "Loeb", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Loeb"], "contexts": ["researcher studying motor disturbances", "researcher on animal behavior and brain"]}], "edges": [], "id": 1006, "stable_key": "clu_65679151bb3806e0", "ground_truth": {"modern_name": "Matthias Jakob Schleiden", "confidence": "low", "type": "person", "birth_year": 1804, "death_year": 1881, "description": "German botanist, co-founder of cell theory.", "note": "The names 'Lobelius', 'Lobel', and 'Loeb' appear to be a conflation of different historical figures. Lobelius and Lobel refer to Matthias de l'Obel, a Flemish botanist. 'Loeb' could refer to Jacques Loeb, a physiologist, or potentially a phonetic misspelling of another scientist. Given the context of botany (Lobelius/Lobel) and then a shift to physiology ('researcher studying motor disturbances' associated with Loeb), and the broad range of dates and specializations, a definitive single identification is not possible without more specific textual evidence. However, if the 'Loeb' refers to the physiology context, Jacques Loeb is a possibility. If the primary focus is early botany, Matthias de l'Obel is the more likely candidate for the first two mentions, but 'Loeb' is then a significant outlier.", "wikidata_id": "Q76747", "wikidata_description": "German botanist and philosopher (1804-1881)", "wikipedia_url": "https://en.wikipedia.org/wiki/Matthias%20Jakob%20Schleiden", "wikipedia_extract": "Matthias Jakob Schleiden (German: [maˈtiːas ˈjaːkɔp ˈʃlaɪdn̩]; 5 April 1804 – 23 June 1881) was a German botanist and co-founder of cell theory, along with Theodor Schwann and Rudolf Virchow. He published some poems and non-scientific work under the pseudonym Ernst. Matthias Jakob Schleiden was born in Hamburg. on 5 April 1804. His father was the municipal physician of Hamburg. Schleiden pursued legal studies graduating in 1827."}, "cross_references": [{"found_name": "poet", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 509, "target_cluster_name": "poets", "source_book": "llm_generated", "evidence_snippet": "Matthias Jakob Schleiden published poems.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Matthias Jakob Schleiden published poems."}, {"found_name": "botanist", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2986, "target_cluster_name": "botanists", "source_book": "llm_generated", "evidence_snippet": "Matthias Jakob Schleiden was a botanist.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Matthias Jakob Schleiden was a botanist."}]}, {"canonical_name": "Nero", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "nero", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Nero", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Nero"], "contexts": ["Roman Emperor"]}, {"entity_id": "nero", "book_id": "kosmos_humboldt_1845", "name": "Nero", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 5, "variants": ["Nero"], "contexts": ["historical figure", "Roman emperor mentioned for observations"]}, {"entity_id": "neros", "book_id": "polyanthea_medicinal", "name": "Neros", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Neros"], "contexts": ["Roman emperor, associated with cruelty"]}, {"entity_id": "negrinho", "book_id": "polyanthea_medicinal", "name": "negrinho", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["negrinho"], "contexts": ["young negro boy from Brazil"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Nero", "target_book": "kosmos_humboldt_1845", "target_name": "Nero", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Nero", "target_book": "polyanthea_medicinal", "target_name": "Neros", "similarity": 0.964}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Nero", "target_book": "polyanthea_medicinal", "target_name": "negrinho", "similarity": 0.894}, {"source_book": "kosmos_humboldt_1845", "source_name": "Nero", "target_book": "polyanthea_medicinal", "target_name": "Neros", "similarity": 0.964}, {"source_book": "kosmos_humboldt_1845", "source_name": "Nero", "target_book": "polyanthea_medicinal", "target_name": "negrinho", "similarity": 0.894}], "id": 1007, "stable_key": "clu_9e39bfa6cf2bcac2", "ground_truth": {"modern_name": "Nero", "confidence": "high", "type": "person", "birth_year": 37, "death_year": 68, "description": "Roman Emperor, known for cruelty and artistic pursuits.", "wikidata_id": "Q1413", "wikidata_description": "fifth and last Roman Emperor of Julio-Claudian dynasty (54–68)", "wikipedia_url": "https://en.wikipedia.org/wiki/Nero", "wikipedia_extract": "Nero Claudius Caesar Augustus Germanicus ( NEER-oh; born Lucius Domitius Ahenobarbus; 15 December AD 37 – 9 June AD 68) was a Roman emperor and the final emperor of the Julio-Claudian dynasty, reigning from AD 54 until his suicide in AD 68. Nero was born at Antium in AD 37, the son of Gnaeus Domitius Ahenobarbus and Agrippina the Younger (great-granddaughter of the emperor Augustus). Nero was three when his father died. By the time Nero turned eleven, his mother married Emperor Claudius, who then adopted Nero as his heir. Upon Claudius' death in AD 54, Nero ascended to the throne with the backing of the Praetorian Guard and the Senate. In the early years of his reign, Nero was advised and guided by his mother Agrippina, his tutor Seneca the Younger, and his praetorian prefect Sextus Afranius Burrus, but sought to rule independently and rid himself of restraining influences."}, "cross_references": [{"found_name": "Agrippa", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3330, "target_cluster_name": "Agrippa", "source_book": "llm_generated", "evidence_snippet": "Agrippa was Nero's father-in-law and a prominent figure during his reign.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Agrippa was Nero's father-in-law and a prominent figure during his reign."}, {"found_name": "Augustus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2668, "target_cluster_name": "Augustus", "source_book": "llm_generated", "evidence_snippet": "Augustus was the first Roman Emperor and the founder of the Julio-Claudian dynasty, to which Nero belonged.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Augustus was the first Roman Emperor and the founder of the Julio-Claudian dynasty, to which Nero belonged."}, {"found_name": "Galba", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3872, "target_cluster_name": "Galba", "source_book": "llm_generated", "evidence_snippet": "Galba succeeded Nero as Roman Emperor, marking the end of the Julio-Claudian dynasty.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Galba succeeded Nero as Roman Emperor, marking the end of the Julio-Claudian dynasty."}, {"found_name": "Germanicus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 400, "target_cluster_name": "Germans", "source_book": "llm_generated", "evidence_snippet": "Germanicus was Nero's paternal grandfather and a celebrated general.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Germanicus was Nero's paternal grandfather and a celebrated general."}]}, {"canonical_name": "Euphrates", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "ephraim", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Ephraim", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Ephraim"], "contexts": ["biblical region or tribe"]}, {"entity_id": "euphrates", "book_id": "kosmos_humboldt_1845", "name": "euphrates", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["euphrates"], "contexts": ["river in ancient regions"]}, {"entity_id": "euphrates", "book_id": "coloquios_da_orta_1563", "name": "Euphrates", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 6, "variants": ["Euphrates"], "contexts": ["river in the Middle East", "river mouth"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ephraim", "target_book": "coloquios_da_orta_1563", "target_name": "Euphrates", "similarity": 0.88}, {"source_book": "kosmos_humboldt_1845", "source_name": "euphrates", "target_book": "coloquios_da_orta_1563", "target_name": "Euphrates", "similarity": 0.978}], "id": 1008, "stable_key": "clu_c830f1b635d3991a", "ground_truth": {"modern_name": "Euphrates River", "confidence": "high", "type": "place", "country": "Iraq, Syria, Turkey", "note": "The context of 'river in the Middle East' and its spelling variations, alongside the clear mention of 'Euphrates' in historical texts, points to the Euphrates River. 'Ephraim' appears to be a variant or a related biblical term but the primary referent is the river.", "wikidata_id": "Q34589", "wikidata_description": "river in Asia", "wikipedia_url": "https://en.wikipedia.org/wiki/Euphrates", "wikipedia_extract": "The Euphrates (  yoo-FRAY-teez; see below) is the longest and one of the most historically important rivers of West Asia. Together with the Tigris, it is one of the two defining rivers of Mesopotamia (lit. 'the land between the rivers'). Originating in Turkey, the Euphrates flows through Syria and Iraq to join the Tigris in the Shatt al-Arab in Iraq, which empties into the Persian Gulf. The Euphrates is the fifteenth-longest river in Asia and the longest in West Asia, at about 2,780 km (1,730 mi), with a drainage area of 440,000 km2 (170,000 mi2) that covers six countries. The term Euphrates derives from the Greek Euphrátēs (Εὐφρᾱ́της), adapted from Old Persian: 𐎢𐎳𐎼𐎠𐎬𐎢, romanized: hUfrātuš, itself from Elamite: 𒌑𒅁𒊏𒌅𒅖, romanized: Úipratuiš. The Elamite name is ultimately derived from cuneiform 𒌓𒄒𒉣; read as Buranun in Sumerian and Purattu in Akkadian; many cuneiform signs have a Sumerian pronunciation and an Akkadian pronunciation, taken from a Sumerian word and an Akkadian word that mean the same."}, "cross_references": [{"found_name": "Babylonia", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2628, "target_cluster_name": "Babylonia", "source_book": "llm_generated", "evidence_snippet": "The Euphrates River flowed through the historical region of Babylonia.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Euphrates River flowed through the historical region of Babylonia."}]}, {"canonical_name": "hares", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "hares", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Hares", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Hares"], "contexts": ["mammal used for comparison of lifespan"]}, {"entity_id": "hares", "book_id": "origin_of_species_darwin_1859", "name": "hares", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 3, "variants": ["hares"], "contexts": ["long-eared rabbits", "lagomorph prey"]}, {"entity_id": "hare", "book_id": "origin_of_species_darwin_1859", "name": "hare", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["hare"], "contexts": ["fast-running long-eared mammal"]}, {"entity_id": "hare", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Hare", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["Hare"], "contexts": ["constellation tail extended towards", "comet observed near"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hares", "target_book": "origin_of_species_darwin_1859", "target_name": "hares", "similarity": 0.979}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hares", "target_book": "origin_of_species_darwin_1859", "target_name": "hare", "similarity": 0.91}, {"source_book": "origin_of_species_darwin_1859", "source_name": "hare", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Hare", "similarity": 0.613}], "id": 1009, "stable_key": "clu_7c75c9950040d9e9", "ground_truth": {"modern_name": "Hare", "confidence": "high", "type": "animal", "wikidata_id": "Q46076", "wikidata_description": "genus of mammals in the family Leporidae", "wikipedia_url": "https://en.wikipedia.org/wiki/Hare", "wikipedia_extract": "Hares and jackrabbits are mammals belonging to the genus Lepus. They are herbivores and live solitarily or in pairs. They nest in depressions in the ground called forms, and their young are able to fend for themselves shortly after birth. The genus includes the largest lagomorphs. Most are fast runners with long, powerful hind legs, and large ears that dissipate body heat. Hare species are native to Africa, Eurasia and  North America."}, "cross_references": [{"found_name": "Rabbit", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2036, "target_cluster_name": "Rabbit", "source_book": "llm_generated", "evidence_snippet": "Hares and rabbits are closely related lagomorphs, often confused or discussed together in historical texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Hares and rabbits are closely related lagomorphs, often confused or discussed together in historical texts."}, {"found_name": "Rodents", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2366, "target_cluster_name": "Rodents", "source_book": "llm_generated", "evidence_snippet": "Hares are often grouped with rodents due to superficial similarities, though they belong to a different order (Lagomorpha).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Hares are often grouped with rodents due to superficial similarities, though they belong to a different order (Lagomorpha).", "is_reverse": true}]}, {"canonical_name": "cold Diseases", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 4, "total_mentions": 12, "members": [{"entity_id": "cold_diseases", "book_id": "english_physician_1652", "name": "cold Diseases", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["cold Diseases", "cold diseases", "cold griefs"], "contexts": ["illnesses attributed to coldness", "ailments associated with cold quality"]}, {"entity_id": "enfermedades_frías", "book_id": "historia_medicinal_monardes_1574", "name": "enfermedades frías", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["enfermedades frías", "enfermedades frigs"], "contexts": ["cold diseases treated by a substance", "cold diseases"]}, {"entity_id": "doenças_frias", "book_id": "polyanthea_medicinal", "name": "doenças frias", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["doenças frias"], "contexts": ["illnesses characterized by coldness"]}, {"entity_id": "enfermidades_frias", "book_id": "polyanthea_medicinal", "name": "enfermidades frias", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["enfermidades frias"], "contexts": ["cold illnesses"]}, {"entity_id": "colds", "book_id": "english_physician_1652", "name": "Colds", "category": "DISEASE", "subcategory": "ACUTE", "count": 3, "variants": ["Colds"], "contexts": ["respiratory infection", "common respiratory illness"]}, {"entity_id": "colds", "book_id": "first_principles_spencer_1862", "name": "colds", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["colds"], "contexts": ["common respiratory illness"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "cold Diseases", "target_book": "historia_medicinal_monardes_1574", "target_name": "enfermedades frías", "similarity": 0.942}, {"source_book": "english_physician_1652", "source_name": "cold Diseases", "target_book": "polyanthea_medicinal", "target_name": "doenças frias", "similarity": 0.935}, {"source_book": "english_physician_1652", "source_name": "cold Diseases", "target_book": "polyanthea_medicinal", "target_name": "enfermidades frias", "similarity": 0.935}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "enfermedades frías", "target_book": "polyanthea_medicinal", "target_name": "doenças frias", "similarity": 0.993}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "enfermedades frías", "target_book": "polyanthea_medicinal", "target_name": "enfermidades frias", "similarity": 0.992}], "id": 1010, "stable_key": "clu_0089b4b0abd244d5", "ground_truth": {"modern_name": "Cold", "confidence": "high", "type": "disease", "modern_term": "Common cold", "note": "Early modern texts often grouped various ailments associated with 'coldness' under a broad category. While 'common cold' is a plausible modern referent, the historical usage could encompass a wider range of conditions than the modern specific viral infection.", "wikidata_id": "Q5153310", "wikidata_description": "former unit of the British Medical Research Council", "wikipedia_url": "https://en.wikipedia.org/wiki/Common%20Cold%20Unit", "wikipedia_extract": "The Common Cold Unit (CCU) or Common Cold Research Unit (CCRU) was a unit of the British Medical Research Council which undertook laboratory and epidemiological research on the common cold between 1946 and 1989 and produced 1,006 papers. The unit studied etiology, epidemiology, prevention, and treatment of common colds. It utilised Harvard Hospital, near Salisbury, a redundant Second World War-duration emergency infectious diseases field-hospital at Harnham Down. Common colds account for a majority of all acute respiratory infections, and the economic costs are substantial in terms of sick leave. The public-facing side of the CCU involved continually recruiting human volunteers, by advertising. Volunteers were housed at the hospital, for typically ten-days while participating in common cold trials."}, "member_count": 6, "cross_references": []}, {"canonical_name": "New Holland", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "holland", "book_id": "english_physician_1652", "name": "Holland", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Holland"], "contexts": ["country of Leyden university", "region in Lincolnshire"]}, {"entity_id": "new_holland", "book_id": "kosmos_humboldt_1845", "name": "New Holland", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["New Holland"], "contexts": ["location of comet observation", "location for hemisphere comparison"]}, {"entity_id": "new_holland", "book_id": "connexion_physical_sciences_somerville_1858", "name": "New Holland", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["New Holland"], "contexts": ["shores with distinct species"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Holland", "target_book": "kosmos_humboldt_1845", "target_name": "New Holland", "similarity": 0.892}, {"source_book": "english_physician_1652", "source_name": "Holland", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "New Holland", "similarity": 0.892}, {"source_book": "kosmos_humboldt_1845", "source_name": "New Holland", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "New Holland", "similarity": 1.0}], "id": 1011, "stable_key": "clu_66cfefd5b5702c9b", "ground_truth": {"modern_name": "Australia", "confidence": "high", "type": "place", "country": "Australia", "note": " 'New Holland' was the historical name given to the western part of Australia. The context of distinct species and shores confirms this identification.", "wikidata_id": "Q408", "wikidata_description": "country in Oceania", "wikipedia_url": "https://en.wikipedia.org/wiki/Australia", "wikipedia_extract": "Australia, officially the Commonwealth of Australia, is a country comprising the mainland of the Australian continent, the island of Tasmania and numerous smaller islands. It has a total area of 7,688,287 km2 (2,968,464 sq mi), making it the sixth-largest country in the world and the largest in Oceania. Australia is the world's flattest and driest inhabited continent. It is a megadiverse country, and its size gives it a wide variety of landscapes and climates including deserts in the interior and tropical rainforests along the coast. The ancestors of Aboriginal Australians began arriving from Southeast Asia 50,000 to 65,000 years ago, during the Last Glacial Period. By the time of British settlement, Aboriginal Australians spoke more than 250 distinct languages and had one of the oldest living cultures in the world."}, "cross_references": [{"found_name": "Commonwealths", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 3798, "target_cluster_name": "Commonwealths", "source_book": "llm_generated", "evidence_snippet": "New Holland is an historical name for Australia.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: New Holland is an historical name for Australia.", "is_reverse": true}, {"found_name": "Dutch Scurvy-Grass", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "english_physician_1652", "evidence_snippet": "round about the Sea Coasts to Dover, Portsmouth, and even to Bristol, where it is had in plenty: The other with round Leavs groweth in the Marshes in Holland in Lin∣colnshire, and other places of Linc", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym"}]}, {"canonical_name": "rivers", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 8, "total_mentions": 16, "members": [{"entity_id": "rivers", "book_id": "english_physician_1652", "name": "Rivers", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Rivers"], "contexts": ["habitat of the plant"]}, {"entity_id": "rivers", "book_id": "principles_of_psychology_james_1890", "name": "rivers", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["rivers"], "contexts": ["natural flowing watercourses"]}, {"entity_id": "rivers", "book_id": "first_principles_spencer_1862", "name": "rivers", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 6, "variants": ["rivers"], "contexts": ["natural flowing watercourses", "waterways carrying sediment to the sea"]}, {"entity_id": "rivière", "book_id": "relation_historique_humboldt_vol3_1825", "name": "rivière", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["rivière"], "contexts": ["river"]}, {"entity_id": "river", "book_id": "kosmos_humboldt_1845", "name": "river", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["river"], "contexts": ["waterway with mud-banks"]}, {"entity_id": "river", "book_id": "connexion_p