LACE", "count": 1, "variants": ["îles Kuriles"], "contexts": ["island chain"]}, {"entity_id": "kurile_islands", "book_id": "kosmos_humboldt_1845", "name": "Kurile Islands", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Kurile Islands"], "contexts": ["islands with volcanic eruptions"]}, {"entity_id": "kurile_islands", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Kurile Islands", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Kurile Islands"], "contexts": ["islands between Japan and Russia"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "îles Kuriles", "target_book": "kosmos_humboldt_1845", "target_name": "Kurile Islands", "similarity": 0.953}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "îles Kuriles", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Kurile Islands", "similarity": 0.953}, {"source_book": "kosmos_humboldt_1845", "source_name": "Kurile Islands", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Kurile Islands", "similarity": 1.0}], "id": 1447, "stable_key": "clu_e157321386eb9d53", "ground_truth": {"modern_name": "Kurile Islands", "confidence": "high", "type": "place", "country": "Russia", "wikidata_id": "Q80389", "wikidata_description": "island chain located in Northeast Asia administered by Russia", "wikipedia_url": "https://en.wikipedia.org/wiki/Kuril_Islands", "wikipedia_extract": "The Kuril Islands or Kurile Islands are a volcanic archipelago administered as part of Sakhalin Oblast in the Russian Far East. The islands stretch approximately 1,300 km (810 mi) northeast from Hokkaido in Japan to Kamchatka Peninsula in Russia, separating the Sea of Okhotsk from the north Pacific Ocean. There are 56 islands and many minor islets. The Kuril Islands consist of the Greater Kuril Chain and, at the southwest end, the parallel Lesser Kuril Chain. The group termed the 'South Kurils' consists of those of the Lesser Kuril Chain together with Kunashir and Iturup in the Greater Kuril Chain. The Vries Strait between Iturup and Urup forms the Miyabe Line dividing the North and South Kurils."}, "cross_references": []}, {"canonical_name": "Berne", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "berne", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Berne", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Berne"], "contexts": ["city in Switzerland"]}, {"entity_id": "berne", "book_id": "kosmos_humboldt_1845", "name": "Berne", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Berne"], "contexts": ["city in Switzerland"]}, {"entity_id": "berne", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Berne", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Berne"], "contexts": ["city with increasing mine temperature"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Berne", "target_book": "kosmos_humboldt_1845", "target_name": "Berne", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Berne", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Berne", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Berne", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Berne", "similarity": 1.0}], "id": 1448, "stable_key": "clu_526615ec897540ee", "ground_truth": {"modern_name": "Bern", "confidence": "high", "type": "place", "country": "Switzerland", "wikidata_id": "Q935784", "wikidata_description": "city and urban gmina of Poland", "wikipedia_extract": "Bern (Swiss Standard German: [bɛrn] ), or Berne (French: [bɛʁn] ), is the de facto capital of Switzerland, referred to as the \"federal city\". With a population of about 146,000 (as of 2024), Bern is the fifth-most populous city in Switzerland, behind Zürich, Geneva, Basel and Lausanne. The Bern agglomeration, which includes 36 municipalities, had a population of 406,900 in 2014. The metropolitan area had a population of 660,000 in 2000. Bern is also the capital of the canton of Bern, the second-most populous of Switzerland's cantons. The city's official language is German.", "wikipedia_url": "https://en.wikipedia.org/wiki/Bern"}, "cross_references": []}, {"canonical_name": "Colima", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "colima", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Colima", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Colima"], "contexts": ["volcanoes of Colima"]}, {"entity_id": "colima", "book_id": "kosmos_humboldt_1845", "name": "Colima", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Colima"], "contexts": ["volcanic mountain in Mexico"]}, {"entity_id": "colima", "book_id": "historia_medicinal_monardes_1574", "name": "Colima", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Colima"], "contexts": ["land near Mechoacan"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Colima", "target_book": "kosmos_humboldt_1845", "target_name": "Colima", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Colima", "target_book": "historia_medicinal_monardes_1574", "target_name": "Colima", "similarity": 0.813}, {"source_book": "kosmos_humboldt_1845", "source_name": "Colima", "target_book": "historia_medicinal_monardes_1574", "target_name": "Colima", "similarity": 0.813}], "id": 1449, "stable_key": "clu_32340f536691d2d3", "ground_truth": {"modern_name": "Colima", "confidence": "high", "type": "place", "country": "Mexico", "wikidata_id": "Q825347", "wikidata_description": "mountain", "wikipedia_url": "https://en.wikipedia.org/wiki/Volc%C3%A1n%20de%20Colima", "wikipedia_extract": "The Volcán de Colima, 3,820 m (12,530 ft), also known as Volcán de Fuego, is part of the Colima Volcanic Complex (CVC) consisting of Volcán de Colima, Nevado de Colima (Spanish pronunciation: [neˈβaðo ðe koˈlima] ) and the eroded El Cántaro (listed as extinct). It is the youngest of the three and as of 2015 is one of the most active volcanoes in Mexico and in North America. Having been active for nearly 5 million years, and with frequent eruptions, the Volcán de Colima is considered a stratovolcano. \"Volcán de Fuego is an active stratovolcano, the most explosive and dangerous of all of Mexico\" (Colima). It has erupted more than 40 times since 1576. One of the largest eruptions was on January 20–24, 1913."}, "cross_references": [{"found_name": "Jorullo", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2120, "target_cluster_name": "Jorullo", "source_book": "llm_generated", "evidence_snippet": "Colima is a volcano in Mexico, and Jorullo is a volcano in Mexico. Both are notable volcanoes in the same region that experienced significant eruptions.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Colima is a volcano in Mexico, and Jorullo is a volcano in Mexico. Both are notable volcanoes in the same region that experienced significant eruptions.", "is_reverse": true}]}, {"canonical_name": "régularité", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "régularité", "book_id": "relation_historique_humboldt_vol3_1825", "name": "régularité", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["régularité"], "contexts": ["characteristic of observed phenomena"]}, {"entity_id": "regularity", "book_id": "kosmos_humboldt_1845", "name": "regularity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["regularity"], "contexts": ["implied by 'mundus'"]}, {"entity_id": "regularity", "book_id": "connexion_physical_sciences_somerville_1858", "name": "regularity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["regularity"], "contexts": ["state of being orderly"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "régularité", "target_book": "kosmos_humboldt_1845", "target_name": "regularity", "similarity": 0.957}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "régularité", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "regularity", "similarity": 0.957}, {"source_book": "kosmos_humboldt_1845", "source_name": "regularity", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "regularity", "similarity": 1.0}], "id": 1450, "stable_key": "clu_9a9bb68780fc4d29", "ground_truth": {"modern_name": "regularity", "confidence": "high", "type": "concept", "wikidata_id": "Q117467430", "wikidata_description": "concept in mathematics", "wikipedia_url": "https://en.wikipedia.org/wiki/Regularity%20theory", "wikipedia_extract": "Regularity is a topic of the mathematical study of partial differential equations (PDE) such as Laplace's equation, about the integrability and differentiability of weak solutions. Hilbert's nineteenth problem was concerned with this concept. The motivation for this study is as follows. It is often difficult to construct a classical solution satisfying the PDE in regular sense, so we search for a weak solution at first, and then find out whether the weak solution is smooth enough to be qualified as a classical solution. Several theorems have been proposed for different types of PDEs. ."}, "cross_references": []}, {"canonical_name": "Saba", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "saba", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Saba", "