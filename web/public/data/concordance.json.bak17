": {"modern_name": "path", "confidence": "high", "type": "place"}, "cross_references": []}, {"canonical_name": "woody", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "woody", "book_id": "english_physician_1652", "name": "woody", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["woody"], "contexts": ["quality of root"]}, {"entity_id": "woody", "book_id": "origin_of_species_darwin_1859", "name": "woody", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["woody"], "contexts": ["having characteristics of wood"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "woody", "target_book": "origin_of_species_darwin_1859", "target_name": "woody", "similarity": 1.0}], "id": 3916, "stable_key": "clu_b9a0c006ed6bbabc", "ground_truth": {"modern_name": "Lignified", "confidence": "high", "type": "concept", "note": "Refers to the characteristic of having wood-like tissue.", "wikidata_id": "Q87156246", "wikidata_description": "scientific article published on 01 December 1974"}, "cross_references": []}, {"canonical_name": "Vessels of Urin", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "vessels_of_urin", "book_id": "english_physician_1652", "name": "Vessels of Urin", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Vessels of Urin"], "contexts": ["body parts Cantharides can harm"]}, {"entity_id": "via_urinaria", "book_id": "polyanthea_medicinal", "name": "via urinaria", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["via urinaria"], "contexts": ["pathway for urine expulsion"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Vessels of Urin", "target_book": "polyanthea_medicinal", "target_name": "via urinaria", "similarity": 0.908}], "id": 3917, "stable_key": "clu_d8d462bf78a1e486", "ground_truth": {"modern_name": "Urinary tract", "confidence": "high", "type": "concept", "wikidata_id": "Q1585769", "wikidata_description": "kidney stone disease"}, "cross_references": [{"found_name": "Bladder", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 608, "target_cluster_name": "Bladder", "source_book": "llm_generated", "evidence_snippet": "The bladder is a key component of the urinary tract.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The bladder is a key component of the urinary tract.", "is_reverse": true}]}, {"canonical_name": "Hypochon∣dria", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "hypochon∣dria", "book_id": "english_physician_1652", "name": "Hypochon∣dria", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Hypochon∣dria"], "contexts": ["region associated with windiness"]}, {"entity_id": "hypogaſtrio", "book_id": "polyanthea_medicinal", "name": "Hypogaſtrio", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Hypogaſtrio"], "contexts": ["body region"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Hypochon∣dria", "target_book": "polyanthea_medicinal", "target_name": "Hypogaſtrio", "similarity": 0.882}], "id": 3918, "stable_key": "clu_e68c4b49b409a92c", "ground_truth": {"modern_name": "hypochondria", "confidence": "high", "type": "anatomy", "description": "The upper region of the abdomen, below the ribs.", "wikipedia_extract": "Hypochondriasis or hypochondria is a condition in which a person is excessively and unduly worried about having a serious illness. Hypochondria is an old concept whose meaning has repeatedly changed over its lifespan. It has been claimed that this debilitating condition results from an inaccurate perception of the condition of body or mind despite the absence of an actual medical diagnosis. An individual with hypochondriasis is known as a hypochondriac. Hypochondriacs become unduly alarmed about any physical or psychological symptoms they detect, no matter how minor the symptom may be, and are convinced that they have, or are about to be diagnosed with, a serious illness. Often, hypochondria persists even after a physician has evaluated a person and reassured them that their concerns about symptoms do not have an underlying medical basis or, if there is a medical illness, their concerns are far in excess of what is appropriate for the level of disease."}, "cross_references": []}, {"canonical_name": "tents", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "tents", "book_id": "english_physician_1652", "name": "tents", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["tents"], "contexts": ["used with balm for wounds"]}, {"entity_id": "felt_tents", "book_id": "kosmos_humboldt_1845", "name": "felt tents", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["felt tents"], "contexts": ["nomadic dwelling made of felt"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "tents", "target_book": "kosmos_humboldt_1845", "target_name": "felt tents", "similarity": 0.921}], "id": 3919, "stable_key": "clu_a5d2a7d4a3d48c0e", "ground_truth": {"modern_name": "Tents", "confidence": "high", "type": "object", "wikidata_id": "Q7700902", "wikidata_description": "genus of insects", "wikipedia_url": "https://en.wikipedia.org/wiki/Tenthredo", "wikipedia_extract": "Tenthredo (from the Greek τενθρηδών tenthrēdōn \"earth nesting wasp\")  is a genus of sawflies with more than 700 species of the family Tenthredinidae, subfamily Tenthredininae. It is of Holarctic distribution. Species of this genus are easily recognisable by their wasplike appearance although lacking the thin 'waist' of a true wasp. They have long antennæ. The fore wings of these sawflies have a lance-shaped cell with a straight cross-nervure. Larvae feed on a very wide variety of plants, each species is often restricted to one host; adults prey on flies and other insects in flowers."}, "cross_references": []}, {"canonical_name": "putrid", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "putrid", "book_id": "english_physician_1652", "name": "putrid", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["putrid"], "contexts": ["quality of venom and sores"]}, {"entity_id": "putridis", "book_id": "polyanthea_medicinal", "name": "putridis", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["putridis"], "contexts": ["quality of fevers"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "putrid", "target_book": "polyanthea_medicinal", "target_name": "putridis", "similarity": 0.958}], "id": 3920, "stable_key": "clu_ce2f509c2226e03c", "ground_truth": {"modern_name": "Putrid", "confidence": "high", "type": "concept", "wikidata_id": "Q671701", "wikidata_description": "breaking down of a body of a human or animal post-mortem"}, "cross_references": []}, {"canonical_name": "Saturnine Diseas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "saturnine_diseas", "book_id": "english_physician_1652", "name": "Saturnine Diseas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Saturnine Diseas"], "contexts": ["illness attributed to Saturn"]}, {"entity_id": "saturnino", "book_id": "polyanthea_medicinal", "name": "Saturnino", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Saturnino"], "contexts": ["a condition related to lead poisoning"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Saturnine Diseas", "target_book": "polyanthea_medicinal", "target_name": "Saturnino", "similarity": 0.907}], "id": 3921, "stable_key": "clu_75a02ecf6bb67725", "ground_truth": {"modern_name": "Saturnine poisoning", "confidence": "high", "type": "disease", "modern_term": "Plumbism", "note": "Saturnine diseases refer to ailments attributed to the influence of the planet Saturn, which in early modern medicine was associated with lead and its toxic effects.", "wikipedia_extract": "Lead poisoning, also known as plumbism and saturnism, is a type of metal poisoning caused by the presence of lead in the human body. Symptoms of lead poisoning may include abdominal pain, constipation, headaches, irritability, memory problems, infertility, numbness and tingling in the hands and feet. Lead poisoning causes almost 10% of intellectual disability of otherwise unknown cause and can result in behavioral problems. Some of the effects are permanent. In severe cases, anemia, seizures, coma, or death may occur. Exposure to lead can occur through contaminated air, water, dust, food, or consumer products.", "wikipedia_url": "https://en.wikipedia.org/wiki/Lead_poisoning"}, "cross_references": [{"found_name": "veneno", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 584, "target_cluster_name": "veneno", "source_book": "llm_generated", "evidence_snippet": "Saturnine poisoning is a specific type of poisoning caused by lead.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Saturnine poisoning is a specific type of poisoning caused by lead.", "is_reverse": true}]}, {"canonical_name": "property", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "property", "book_id": "english_physician_1652", "name": "property", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["property"], "contexts": ["drying and binding property"]}, {"entity_id": "propriété", "book_id": "relation_historique_humboldt_vol3_1825", "name": "propriété", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["propriété"], "contexts": ["ownership"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "property", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "propriété", "similarity": 0.889}], "id": 3922, "stable_key": "clu_a01d4aca5c83f45e", "ground_truth": {"modern_name": "Property", "confidence": "high", "type": "concept"}, "cross_references": []}, {"canonical_name": "Hawthorn", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "hawthorn", "book_id": "english_physician_1652", "name": "Hawthorn", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Hawthorn"], "contexts": ["common hedgerow tree"]}, {"entity_id": "hawthorn", "book_id": "first_principles_spencer_1862", "name": "hawthorn", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["hawthorn"], "contexts": ["flower with dome-shaped petals"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Hawthorn", "target_book": "first_principles_spencer_1862", "target_name": "hawthorn", "similarity": 0.832}], "id": 3923, "stable_key": "clu_9a397348e08d6446", "ground_truth": {"modern_name": "Hawthorn", "confidence": "high", "type": "plant", "linnaean": "Crataegus Linnaeus", "family": "Rosaceae", "wikidata_id": "Q132557", "wikidata_description": "genus of flowering plants in the rose family Rosaceae", "wikipedia_extract": "Crataegus (), commonly called hawthorn, quickthorn, thornapple, May-tree, whitethorn, Mayflower or hawberry, is a genus of several hundred species of shrubs and trees in the family Rosaceae, native to temperate regions of the Northern Hemisphere in Europe, Asia, North Africa and North America. The name \"hawthorn\" was originally applied to the species native to northern Europe, especially the common hawthorn C. monogyna, and the unmodified name is often so used in Britain and Ireland. The name is now also applied to the entire genus and to the related Asian genus Rhaphiolepis. Crataegus species are shrubs or small trees, mostly growing to 5–15 m (15–50 ft) tall, with small fruit and (usually) thorny branches. The most common type of bark is smooth grey in young individuals, developing shallow longitudinal fissures with narrow ridges in older trees.", "wikipedia_url": "https://en.wikipedia.org/wiki/Crataegus"}, "cross_references": []}, {"canonical_name": "old Folks", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "old_folks", "book_id": "english_physician_1652", "name": "old Folks", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["old Folks"], "contexts": ["elderly people"]}, {"entity_id": "old_man", "book_id": "first_principles_spencer_1862", "name": "old man", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["old man"], "contexts": ["least structural modifiability"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "old Folks", "target_book": "first_principles_spencer_1862", "target_name": "old man", "similarity": 0.892}], "id": 3924, "stable_key": "clu_ec598a52db7d20f4", "ground_truth": {"modern_name": "Elderly people", "confidence": "high", "type": "concept", "note": "This cluster refers to a general demographic rather than specific individuals."}, "cross_references": [{"found_name": "homens", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 904, "target_cluster_name": "homens", "source_book": "llm_generated", "evidence_snippet": "The term 'elderly people' refers to individuals in a specific life stage, a subset of 'individuals' (homens).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The term 'elderly people' refers to individuals in a specific life stage, a subset of 'individuals' (homens).", "is_reverse": true}]}, {"canonical_name": "humers", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "humers", "book_id": "english_physician_1652", "name": "humers", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["humers"], "contexts": ["bodily fluids, often imbalanced"]}, {"entity_id": "hum", "book_id": "coloquios_da_orta_1563", "name": "hum", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["hum"], "contexts": ["humor"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "humers", "target_book": "coloquios_da_orta_1563", "target_name": "hum", "similarity": 0.888}], "id": 3925, "stable_key": "clu_b43e42b88da137de-2", "ground_truth": {"modern_name": "Humors", "confidence": "high", "type": "concept", "description": "Bodily fluids central to humoral theory, believed to influence health and temperament.", "note": "Includes specific types like 'humor adusto' and 'humor phleugmatico'.", "wikipedia_extract": "Humorism, the humoral theory, or humoralism, was a system of medicine detailing a supposed makeup and workings of the human body, adopted by Ancient Greek and Roman physicians and philosophers. Humorism began to fall out of favor in the 17th century and it was definitively disproved with the discovery of microbes. The concept of \"humors\" may have origins in Ancient Egyptian medicine, or Mesopotamia, though it was not systemized until ancient Greek thinkers. The word humor is a translation of Greek χυμός, chymos (literally 'juice' or 'sap', metaphorically 'flavor'). Early texts on Indian Ayurveda medicine presented a theory of three or four humors (doṣas), which they sometimes linked with the five elements (pañca-bhūta): earth, water, fire, air, and space. The concept of \"humors\" (chemical systems regulating human behaviour) became more prominent from the writing of medical theorist Alcmaeon of Croton (c. 540–500 BC)."}, "cross_references": [{"found_name": "humores frios", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1773, "target_cluster_name": "humores frios", "source_book": "llm_generated", "evidence_snippet": "This is a direct translation and specific type of humor ('cold humors') within the humoral theory.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "This is a direct translation and specific type of humor ('cold humors') within the humoral theory."}, {"found_name": "humores melancolicos", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1814, "target_cluster_name": "humores melancolicos", "source_book": "llm_generated", "evidence_snippet": "This is a direct translation and specific type of humor ('melancholic humors') within the humoral theory.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "This is a direct translation and specific type of humor ('melancholic humors') within the humoral theory."}, {"found_name": "Gall", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 650, "target_cluster_name": "Gall", "source_book": "llm_generated", "evidence_snippet": "This is the English term for 'bile', one of the four humors in humoral theory.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "This is the English term for 'bile', one of the four humors in humoral theory."}, {"found_name": "bilis", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 454, "target_cluster_name": "bilis", "source_book": "llm_generated", "evidence_snippet": "This is the Latin term for 'bile', one of the four humors in humoral theory.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "This is the Latin term for 'bile', one of the four humors in humoral theory."}, {"found_name": "fel", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 1921, "target_cluster_name": "fel", "source_book": "llm_generated", "evidence_snippet": "This is the Latin term for 'bile', one of the four humors in humoral theory.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "This is the Latin term for 'bile', one of the four humors in humoral theory."}, {"found_name": "Phlegm", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2513, "target_cluster_name": "phlegm", "source_book": "llm_generated", "evidence_snippet": "Phlegm is one of the four cardinal humors in the humoral theory, alongside blood, yellow bile, and black bile.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Phlegm is one of the four cardinal humors in the humoral theory, alongside blood, yellow bile, and black bile."}, {"found_name": "Bile", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 454, "target_cluster_name": "bilis", "source_book": "llm_generated", "evidence_snippet": "Bile (yellow bile) is one of the four cardinal humors in the humoral theory.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Bile (yellow bile) is one of the four cardinal humors in the humoral theory."}, {"found_name": "suco-cetrmo", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "melhor, porque ^^--AJ^uns cscriptores o chamão suco-cetrmo? 26 Colóquio segundo OETA Não faz o nome ao caso. RUANO CcHno sabeis que sabem descernír hum do outro os Pér- sios, Arábios e Turcos em Ormuz", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for humores"}, {"found_name": "saibo", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "nem outros acostumam fazer justiça ; e mais me dizey por que em Espanha lhe chamão o Sabayo? ORTA Alguns me dezião que se chamava assi, porque tinha hum capitam chamado per este nome; mas depois soube", "confidence": 0.8, "auto_label": "cross_linguistic", "found_relationship": "means 'lord' in Arabic and Persian"}, {"found_name": "apas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "sua, não comprão a outra que se gasta em gente mesquinha, em comeres e mezinhas ; alguns a comem com o. pão, a que chamão apas. RUANO o cheiro he todo hum? ORTA O da que aprovão qua por milhor, que he", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "called a type of food/consumption"}, {"found_name": "tangue", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "BANGUE INTERLOCUTORES RUANO, ORTA, ANTO^aA RUANO Nam sei a diferença que ha entre o que chamão tangue, e o que se diz amfiarn; porque pode ser que tudo seja hum, pois que vos vejo, quando vituperais a", "confidence": 0.65, "auto_label": "contested_identity", "found_relationship": "referred to as a term of abuse, possibly related to humors"}, {"found_name": "amfiarn", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "BANGUE INTERLOCUTORES RUANO, ORTA, ANTO^aA RUANO Nam sei a diferença que ha entre o que chamão tangue, e o que se diz amfiarn; porque pode ser que tudo seja hum, pois que vos vejo, quando vituperais a", "confidence": 0.65, "auto_label": "contested_identity", "found_relationship": "referred to as a term of abuse, possibly related to humors"}, {"found_name": "maju", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "acima ditas, a que chamão maju (3). RUANO Faz esses effeitos de prazer em todos? ORTA Pôde ser que nos acustumados a elle, que os fará assi; mas eu vi hum portuguez choquareiro, que comigo foy ao Bala", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "called a type of electuary"}, {"found_name": "chamderros", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "mesturada com algumas lascas de pedra muito delgadas, ou com huma goma (a que chamão chamderros) que parece alambres crus, ou he mesturada com farinha de hum páo; mas todas estas cousas bem se vê, a q", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "called a type of gum"}]}, {"canonical_name": "Orange", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "orange", "book_id": "english_physician_1652", "name": "Orange", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Orange"], "contexts": ["seed to balance coldness"]}, {"entity_id": "orange", "book_id": "principles_of_psychology_james_1890", "name": "orange", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["orange"], "contexts": ["citrus fruit"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Orange", "target_book": "principles_of_psychology_james_1890", "target_name": "orange", "similarity": 0.945}], "id": 3926, "stable_key": "clu_c713d012732b639b", "ground_truth": {"modern_name": "Orange tree", "confidence": "high", "type": "plant", "linnaean": "Citrus × sinensis", "family": "Rutaceae", "description": "Tree bearing citrus fruits, valued for fruit, wood, and medicinal properties.", "note": "Refers to the orange tree, not the planet or musician.", "wikipedia_extract": "Citrus × sinensis (sometimes written Citrus sinensis), is a broadleaf evergreen hybrid between pomelo (Citrus maxima) and mandarin (Citrus reticulata). Hybrid sweet oranges are commonly cultivated fruits that include Valencia oranges, blood oranges and navel oranges. The orange fruit is an important agricultural product, used for both the juicy fruit pulp and the aromatic peel (rind). Orange blossoms (the flowers) are used in several different ways, as are the leaves and wood of the tree. The orange blossom, which is the state flower of Florida, is highly fragrant and traditionally associated with good fortune. It has long been popular in bridal bouquets and head wreaths."}, "cross_references": [{"found_name": "limoens", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1051, "target_cluster_name": "limoens", "source_book": "llm_generated", "evidence_snippet": "The lemon is a hybrid of the citron and the bitter orange, making the orange tree a close relative.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The lemon is a hybrid of the citron and the bitter orange, making the orange tree a close relative.", "is_reverse": true}]}, {"canonical_name": "Springs", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "springs", "book_id": "english_physician_1652", "name": "Springs", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Springs"], "contexts": ["location where Maidenhair grows"]}, {"entity_id": "springs", "book_id": "kosmos_humboldt_1845", "name": "springs", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["springs"], "contexts": ["water sources from ground"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Springs", "target_book": "kosmos_humboldt_1845", "target_name": "springs", "similarity": 0.959}], "id": 3927, "stable_key": "clu_fcd4096fd9b4de9f", "ground_truth": {"modern_name": "Springs", "confidence": "high", "type": "place", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Borrego_Springs,_California", "wikipedia_extract": "Borrego Springs is a census-designated place (CDP) in northeastern San Diego County, California. It is located within the Low Desert area of Southern California. The population was 3,073 at the 2020 census. Borrego Springs is surrounded by Anza-Borrego Desert State Park. Anza-Borrego State Park's name is derived from Juan Bautista de Anza, who notably camped there, and \"borrego\", which is Spanish for \"lamb\", in honor of the local herds of bighorn sheep. The area east of town was the site of a vast World War II US Navy training center, the Borrego Valley Maneuver Area, with supporting camps and airstrips."}, "cross_references": [{"found_name": "Meadows", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1861, "target_cluster_name": "Meadows", "source_book": "llm_generated", "evidence_snippet": "Springs are often found within or are the source of water for meadows, creating a close geographical and ecological relationship.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Springs are often found within or are the source of water for meadows, creating a close geographical and ecological relationship.", "is_reverse": true}]}, {"canonical_name": "Cloves", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "cloves", "book_id": "english_physician_1652", "name": "Cloves", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Cloves"], "contexts": ["added to poultice"]}, {"entity_id": "clovers", "book_id": "origin_of_species_darwin_1859", "name": "clovers", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["clovers"], "contexts": ["plants fertilized by bees"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Cloves", "target_book": "origin_of_species_darwin_1859", "target_name": "clovers", "similarity": 0.904}], "id": 3928, "stable_key": "clu_c74da96c570d0387", "ground_truth": {"modern_name": "Clove", "confidence": "high", "type": "plant", "linnaean": "Syzygium aromaticum", "family": "Myrtaceae", "note": "The text mentions 'clovers' in the context of bees, which is a different plant (Trifolium). However, 'cloves' in the context of poultices strongly refers to Syzygium aromaticum."}, "cross_references": []}, {"canonical_name": "viscuous", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "viscuous", "book_id": "english_physician_1652", "name": "viscuous", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["viscuous"], "contexts": ["thick and sticky quality"]}, {"entity_id": "viscoso", "book_id": "polyanthea_medicinal", "name": "viscoso", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["viscoso"], "contexts": ["viscous quality"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "viscuous", "target_book": "polyanthea_medicinal", "target_name": "viscoso", "similarity": 0.889}], "id": 3929, "stable_key": "clu_a48684a871eac2f0", "ground_truth": {"modern_name": "Viscosity", "confidence": "high", "type": "concept"}, "cross_references": []}, {"canonical_name": "Timber Trees", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "timber_trees", "book_id": "english_physician_1652", "name": "Timber Trees", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Timber Trees"], "contexts": ["trees where Misselto grows"]}, {"entity_id": "alberi", "book_id": "ricettario_fiorentino_1597", "name": "alberi", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["alberi"], "contexts": ["trees commonly called"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Timber Trees", "target_book": "ricettario_fiorentino_1597", "target_name": "alberi", "similarity": 0.902}], "id": 3930, "stable_key": "clu_86917ea4afd9169a", "ground_truth": {"modern_name": "Timber trees", "confidence": "medium", "type": "plant", "note": "While 'alberi' in Italian means trees, 'timber trees' is a functional classification rather than a specific botanical one, making a precise Linnaean identification difficult.", "wikidata_id": "Q18394421", "wikidata_description": "alphabetical list of useful timber trees growing in the Gauteng area of South Africa"}, "cross_references": [{"found_name": "Poplar", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1215, "target_cluster_name": "Poplar", "source_book": "llm_generated", "evidence_snippet": "Populus nigra is a medium- to large-sized tree, often used for timber.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Populus nigra is a medium- to large-sized tree, often used for timber.", "is_reverse": true}, {"found_name": "Alder-Tree", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2349, "target_cluster_name": "Alder-Tree", "source_book": "llm_generated", "evidence_snippet": "Alder is a type of tree that can be used for timber.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Alder is a type of tree that can be used for timber.", "is_reverse": true}, {"found_name": "Pino", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2460, "target_cluster_name": "Pino", "source_book": "llm_generated", "evidence_snippet": "Pine is a significant timber tree.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Pine is a significant timber tree.", "is_reverse": true}, {"found_name": "Ash-tree", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2502, "target_cluster_name": "Ash-tree", "source_book": "llm_generated", "evidence_snippet": "Ash is a type of timber tree.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Ash is a type of timber tree.", "is_reverse": true}, {"found_name": "cedro", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2508, "target_cluster_name": "cedro", "source_book": "llm_generated", "evidence_snippet": "Cedar is a type of timber tree, valued for its wood.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Cedar is a type of timber tree, valued for its wood.", "is_reverse": true}, {"found_name": "rama", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2629, "target_cluster_name": "rama", "source_book": "llm_generated", "evidence_snippet": "A branch is a part of a timber tree.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: A branch is a part of a timber tree.", "is_reverse": true}]}, {"canonical_name": "Viscuous Humors", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "viscuous_humors", "book_id": "english_physician_1652", "name": "Viscuous Humors", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Viscuous Humors"], "contexts": ["thick bodily fluids"]}, {"entity_id": "viscous_humors", "book_id": "polyanthea_medicinal", "name": "viscous humors", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["viscous humors"], "contexts": ["thick bodily fluids"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Viscuous Humors", "target_book": "polyanthea_medicinal", "target_name": "viscous humors", "similarity": 0.893}], "id": 3931, "stable_key": "clu_d4318174b58cfb9e", "ground_truth": {"modern_name": "Viscous humors", "confidence": "medium", "type": "concept", "note": "Refers to the humoral theory of medicine, specifically thick bodily fluids.", "wikidata_id": "Q5782572", "wikidata_description": "ancient Greek and Roman system of medicine involving four fluid types", "wikipedia_url": "https://en.wikipedia.org/wiki/Rheology", "wikipedia_extract": "Rheology (; from Ancient Greek  ῥέω (rhéō) 'flow' and  -λoγία (-logía) 'study of') is the study of the flow of matter, primarily in a fluid (liquid or gas) state, as well as \"soft solids\", which experience conditions under which they respond with plastic flow rather than elastic deformation to forces applied to them. Rheology is the branch of physics that deals with the deformation and flow of materials, both solids and liquids. The term rheology was coined by Eugene C. Bingham, a professor at Lafayette College, in 1920 from a suggestion by a colleague, Markus Reiner. The term was inspired by the aphorism of  Heraclitus (often mistakenly attributed to Simplicius), panta rhei (πάντα ῥεῖ, 'everything flows') and was first used to describe the flow of liquids and the deformation of solids. It applies to substances that have a complex microstructure, such as muds, sludges, suspensions, and polymers and other glass formers (e.g., silicates), as well as many foods and additives, bodily fluids (e.g., blood) and other biological materials, and other materials that belong to the class of soft matter such as food."}, "cross_references": [{"found_name": "Humors", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 28, "target_cluster_name": "humores", "source_book": "llm_generated", "evidence_snippet": "Viscous humors are a specific type of humor within the broader category of humors in historical medical theory.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Viscous humors are a specific type of humor within the broader category of humors in historical medical theory."}]}, {"canonical_name": "Dogs-turd", "category": "SUBSTANCE", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "dogs-turd", "book_id": "english_physician_1652", "name": "Dogs-turd", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Dogs-turd"], "contexts": ["vulgar cure for Quinsie"]}, {"entity_id": "dog", "book_id": "polyanthea_medicinal", "name": "dog", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["dog"], "contexts": ["animal"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Dogs-turd", "target_book": "polyanthea_medicinal", "target_name": "dog", "similarity": 0.903}], "id": 3932, "stable_key": "clu_34b53aa72fd31c43", "ground_truth": {"modern_name": "Dog feces", "confidence": "high", "type": "animal", "note": "The term 'Dogs-turd' is a direct and somewhat vulgar reference to dog feces, which was historically used in some folk remedies. The mention of 'dog' in a medical context likely refers to the animal from which the feces are derived.", "wikidata_id": "Q336441", "wikidata_description": "excrement of domestic dogs"}, "cross_references": [{"found_name": "excremento", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1857, "target_cluster_name": "excremento", "source_book": "llm_generated", "evidence_snippet": "Dog feces is a specific type of excrement.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Dog feces is a specific type of excrement.", "is_reverse": true}, {"found_name": "venenos", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2363, "target_cluster_name": "venenos", "source_book": "llm_generated", "evidence_snippet": "Animal excrement, including dog feces, was sometimes considered a poison or used in folk remedies with potential toxic effects.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Animal excrement, including dog feces, was sometimes considered a poison or used in folk remedies with potential toxic effects.", "is_reverse": true}]}, {"canonical_name": "Tendon", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "tendon", "book_id": "english_physician_1652", "name": "Tendon", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Tendon"], "contexts": ["connective tissue"]}, {"entity_id": "tendon", "book_id": "principles_of_psychology_james_1890", "name": "tendon", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["tendon"], "contexts": ["connective tissue attaching muscle to bone"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Tendon", "target_book": "principles_of_psychology_james_1890", "target_name": "tendon", "similarity": 0.562}], "id": 3933, "stable_key": "clu_0c5697b8a822e6ba", "ground_truth": {"wikipedia_extract": "A tendon or sinew is a tough band of dense fibrous connective tissue that connects muscle to bone. It sends the mechanical forces of muscle contraction to the skeletal system, while withstanding tension. Tendons, like ligaments, are made of collagen. The difference is that ligaments connect bone to bone, while tendons connect muscle to bone. There are about 4,000 tendons in the adult human body. A tendon is made of dense regular connective tissue, whose main cellular components are special fibroblasts called tendon cells (tenocytes)."}, "cross_references": []}, {"canonical_name": "Lunatick", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "lunatick", "book_id": "english_physician_1652", "name": "Lunatick", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Lunatick"], "contexts": ["mentally ill person"]}, {"entity_id": "lunacy", "book_id": "principles_of_psychology_james_1890", "name": "lunacy", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["lunacy"], "contexts": ["state of mental derangement"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Lunatick", "target_book": "principles_of_psychology_james_1890", "target_name": "lunacy", "similarity": 0.937}], "id": 3934, "stable_key": "clu_bc6547c754e6006c", "ground_truth": {"modern_name": "Lunacy", "confidence": "high", "type": "disease", "modern_term": "Lunacy", "wikidata_id": "Q14639933", "wikidata_description": "episode of Law & Order: Special Victims Unit"}, "cross_references": [{"found_name": "Doudos", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2820, "target_cluster_name": "Doudos", "source_book": "llm_generated", "evidence_snippet": "'Madness' (Doudos) is historically linked to 'Lunacy', which specifically referred to mental disorders believed to be influenced by the moon, but often used more broadly for mental derangement.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: 'Madness' (Doudos) is historically linked to 'Lunacy', which specifically referred to mental disorders believed to be influenced by the moon, but often used more broadly for mental derangement.", "is_reverse": true}]}, {"canonical_name": "dried Fruit", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "dried_fruit", "book_id": "english_physician_1652", "name": "dried Fruit", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["dried Fruit"], "contexts": ["processed plums"]}, {"entity_id": "fruits_secs", "book_id": "relation_historique_humboldt_vol3_1825", "name": "fruits secs", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["fruits secs"], "contexts": ["dried fruits"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "dried Fruit", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "fruits secs", "similarity": 0.919}], "id": 3935, "stable_key": "clu_52e0aea088bc793b", "ground_truth": {"modern_name": "Dried fruits", "confidence": "high", "type": "plant", "not