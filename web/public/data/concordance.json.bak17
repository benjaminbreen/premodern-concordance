ence": 0.65, "auto_label": "true_synonym", "found_relationship": "a plant commonly known as"}]}, {"canonical_name": "goma", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "goma_arábica", "book_id": "coloquios_da_orta_1563", "name": "goma arábica", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["goma arábica"], "contexts": ["substance sometimes used to falsify aloés", "gum arabic"]}, {"entity_id": "goma", "book_id": "polyanthea_medicinal", "name": "goma", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["goma", "goma arabica", "goma elemi", "gomo", "gumo"], "contexts": ["ingredient in an emplaster", "gum used in a broth"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "goma arábica", "target_book": "polyanthea_medicinal", "target_name": "goma", "similarity": 0.893}], "id": 2239, "stable_key": "clu_bc76289031ff821c", "ground_truth": {"modern_name": "Gum arabic", "confidence": "high", "type": "plant", "linnaean": "Senegalia senegal", "family": "Fabaceae", "note": "While 'goma' can refer to any gum, 'goma arábica' specifically points to Gum arabic. The context of it being an ingredient in an emplaster and sometimes used to falsify aloes strongly suggests this."}, "cross_references": [{"found_name": "Acacia", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 153, "target_cluster_name": "Acacia", "source_book": "llm_generated", "evidence_snippet": "Gum arabic is the hardened sap of Acacia trees, specifically species like Acacia senegal.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Gum arabic is the hardened sap of Acacia trees, specifically species like Acacia senegal."}]}, {"canonical_name": "mitridato", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "mitridato", "book_id": "coloquios_da_orta_1563", 