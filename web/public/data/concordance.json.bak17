references": [{"found_name": "Curve", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3645, "target_cluster_name": "curve", "source_book": "llm_generated", "evidence_snippet": "The abbreviation 't.' for tangent is a mathematical notation used to denote a specific type of curve or line segment in geometry and trigonometry.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The abbreviation 't.' for tangent is a mathematical notation used to denote a specific type of curve or line segment in geometry and trigonometry."}]}, {"canonical_name": "Turin", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "turin", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Turin", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Turin"], "contexts": ["location of observation", "city in Italy"]}, {"entity_id": "turin", "book_id": "kosmos_humboldt_1845", "name": "Turin", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Turin"], "contexts": ["city in Italy"]}, {"entity_id": "turin", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Turin", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Turin"], "contexts": ["location of M. Botto's experiments"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Turin", "target_book": "kosmos_humboldt_1845", "target_name": "Turin", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Turin", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Turin", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Turin", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Turin", "similarity": 1.0}], "id": 1349, "stable_key": "clu_fd497e8a05e4538a", "ground_truth": {"modern_name": "Turin", "confidence": "high", "type": "place", "country": "Italy", "wikidata_id": "Q495", "wikidata_description": "city and commune in Italy", "wikipedia_url": "https://en.wikipedia.org/wiki/Turin", "wikipedia_extract": "Turin is a city and an important business and cultural centre in northern Italy. It is the capital city of the Piedmont region and of the Metropolitan City of Turin. From 1861 to 1865, it was the first capital of the Kingdom of Italy. The city is mainly on the western bank of the River Po, below its Susa Valley, and is surrounded by the western Alpine arch and Superga hill. The population of the city proper is 853,196 as of 2025, while the population of the urban area is estimated by Eurostat to be 1.7 million inhabitants. The Turin metropolitan area is estimated by the OECD to have a population of 2.2 million."}, "cross_references": []}, {"canonical_name": "lakes", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "grands_lacs", "book_id": "relation_historique_humboldt_vol3_1825", "name": "grands lacs", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["grands lacs"], "contexts": ["large lakes in North America"]}, {"entity_id": "lakes", "book_id": "kosmos_humboldt_1845", "name": "lakes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["lakes"], "contexts": ["bodies of water"]}, {"entity_id": "lakes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "lakes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["lakes"], "contexts": ["large bodies of water", "bodies of water"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "grands lacs", "target_book": "kosmos_humboldt_1845", "target_name": "lakes", "similarity": 0.881}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "grands lacs", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "lakes", "similarity": 0.881}, {"source_book": "kosmos_humboldt_1845", "source_name": "lakes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "lakes", "similarity": 1.0}], "id": 1350, "stable_key": "clu_4e8430f4af178a5e", "ground_truth": {"modern_name": "Great Lakes", "confidence": "high", "type": "place", "country": "Canada, United States", "note": "The context of 'large lakes in North America' strongly suggests the Great Lakes region.", "wikidata_id": "Q1166", "wikidata_description": "state of the United States of America", "wikipedia_url": "https://en.wikipedia.org/wiki/Michigan", "wikipedia_extract": "Michigan (  MISH-ig-ən) is a peninsular state in the Great Lakes region of the Upper Midwestern United States. It shares water and land boundaries with Minnesota to the northwest, Wisconsin to the west, Indiana and Illinois to the southwest, Ohio to the southeast, and the Canadian province of Ontario to the east, northeast and north. With a population of 10.14 million and an area of 96,716 sq mi (250,490 km2), Michigan is the tenth-largest state by population, the 11th-largest by area, and the largest by total area east of the Mississippi River. The state capital is Lansing, while its most populous city is Detroit. The Metro Detroit region in Southeast Michigan is among the nation's most populous and largest metropolitan economies. Other important metropolitan areas include Grand Rapids, Flint, Ann Arbor, Kalamazoo, the Tri-Cities, and Muskegon."}, "cross_references": [{"found_name": "Kasan", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1038, "target_cluster_name": "Kasan", "source_book": "llm_generated", "evidence_snippet": "Kazan is situated at the confluence of major rivers, similar to how the Great Lakes are a significant hydrological feature. This relates to geographical descriptions of large water bodies and their importance.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Kazan is situated at the confluence of major rivers, similar to how the Great Lakes are a significant hydrological feature. This relates to geographical descriptions of large water bodies and their importance.", "is_reverse": true}, {"found_name": "North America", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 606, "target_cluster_name": "North America", "source_book": "llm_generated", "evidence_snippet": "The Great Lakes are a defining geographical feature of North America.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Great Lakes are a defining geographical feature of North America."}, {"found_name": "St. Lawrence", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2597, "target_cluster_name": "St. Lawrence", "source_book": "llm_generated", "evidence_snippet": "The St. Lawrence River connects the Great Lakes to the Atlantic Ocean.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The St. Lawrence River connects the Great Lakes to the Atlantic Ocean.", "is_reverse": true}]}, {"canonical_name": "luxuria", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "luxe", "book_id": "relation_historique_humboldt_vol3_1825", "name": "luxe", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["luxe"], "contexts": ["non-essential item"]}, {"entity_id": "luxus", "book_id": "principles_of_psychology_james_1890", "name": "Luxus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Luxus"], "contexts": ["term for something superfluous or excessive"]}, {"entity_id": "luxuria", "book_id": "polyanthea_medicinal", "name": "luxuria", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["luxuria"], "contexts": ["excessive sexual indulgence"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "luxe", "target_book": "principles_of_psychology_james_1890", "target_name": "Luxus", "similarity": 0.96}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "luxe", "target_book": "polyanthea_medicinal", "target_name": "luxuria", "similarity": 0.912}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Luxus", "target_book": "polyanthea_medicinal", "target_name": "luxuria", "similarity": 0.92}], "id": 1351, "stable_key": "clu_8b8f07611c666a4c", "ground_truth": {"modern_name": "Luxury", "confidence": "high", "type": "concept", "note": "The Latin 'luxuria' can also mean 'excess' or 'licentiousness', but in the context of non-essential items and superfluity, 'luxury' is the most fitting modern equivalent.", "wikipedia_extract": "The Cadillac Urban Luxury Concept (ULC) is a gasoline-electric hybrid, 4-seater, city concept car manufactured by Cadillac and unveiled at the 2010 Los Angeles Auto Show. The ULC was designed by Niki Smart and features a signature wedge shaped styling cues from most of the Cadillac models of the 2000s. The ULC features touchpad screens and projected displays that take the place of traditional gauges. The ULC seats four adults, with access through a pair of scissor doors that extend outward and rotate forward when opened allowing easy access to all four seats. The ULC was powered by a 1.0L turbocharged 3-cylinder with 350kw electric power engine with a dual-clutch transmission and a hybrid propulsion system that employs electric assist technology, engine start-stop function, and brake energy regeneration. According to Cadillac, the ULC could potentially achieve 156 miles per US gallon (1.51 L/100 km; 187 mpg‑imp) in the city and 165 miles per US gallon (1.43 L/100 km; 198 mpg‑imp) on the highway.", "wikipedia_url": "https://en.wikipedia.org/wiki/Cadillac_Urban_Luxury_Concept"}, "cross_references": [{"found_name": "Ambition", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4281, "target_cluster_name": "Ambition", "source_book": "llm_generated", "evidence_snippet": "Luxury is often associated with the pursuit of wealth and status, which can be driven by ambition.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Luxury is often associated with the pursuit of wealth and status, which can be driven by ambition."}, {"found_name": "Desire", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 925, "target_cluster_name": "desire", "source_book": "llm_generated", "evidence_snippet": "Luxury is often the object of desire, representing things that are wanted but not essential.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Luxury is often the object of desire, representing things that are wanted but not essential."}, {"found_name": "Appetite", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2030, "target_cluster_name": "Appetite", "source_book": "llm_generated", "evidence_snippet": "Similar to desire, luxury can be seen as catering to or stimulating appetites beyond basic needs.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Similar to desire, luxury can be seen as catering to or stimulating appetites beyond basic needs."}, {"found_name": "Lust", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2699, "target_cluster_name": "Lust", "source_book": "llm_generated", "evidence_snippet": "In some historical contexts, 'luxury' (luxuria) was used to encompass excessive or uncontrolled desires, including lust.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: In some historical contexts, 'luxury' (luxuria) was used to encompass excessive or uncontrolled desires, including lust.", "is_reverse": true}]}, {"canonical_name": "Moorcroft", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "mo