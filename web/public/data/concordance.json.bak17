, "edges": [{"source_book": "english_physician_1652", "source_name": "Beets", "target_book": "origin_of_species_darwin_1859", "target_name": "beet", "similarity": 0.919}], "id": 2962, "stable_key": "clu_75229e484d3dc603", "ground_truth": {"modern_name": "Beet", "confidence": "high", "type": "plant", "linnaean": "Beta vulgaris Linnaeus", "family": "Amaranthaceae", "wikidata_id": "Q165437", "wikidata_description": "cultivar group of the beet plant (no colour indication)"}, "cross_references": []}, {"canonical_name": "Sea Coasts", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 6, "total_mentions": 11, "members": [{"entity_id": "sea_coasts", "book_id": "english_physician_1652", "name": "Sea Coasts", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Sea Coasts"], "contexts": ["geographic location", "location where the plant is found"]}, {"entity_id": "côtes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "côtes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["côtes"], "contexts": ["land bordering the sea"]}, {"entity_id": "sea-coasts", "book_id": "origin_of_species_darwin_1859", "name": "sea-coasts", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["sea-coasts"], "contexts": ["habitats for brassy or lurid insects"]}, {"entity_id": "sea-coast", "book_id": "kosmos_humboldt_1845", "name": "sea-coast", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["sea-coast"], "contexts": ["boundary between land and sea", "edge of the land bordering the sea"]}, {"entity_id": "ocean_shore", "book_id": "kosmos_humboldt_1845", "name": "ocean shore", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["ocean shore"], "contexts": ["location with waves and sea weeds"]}, {"entity_id": "sea-shore", "book_id": "first_principles_spencer_1862", "name": "sea-shore", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "varia