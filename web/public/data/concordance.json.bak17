ship": "reverse: An 'infant' can be a 'virgin'.", "is_reverse": true}]}, {"canonical_name": "laboratory", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "laboratory", "book_id": "principles_of_psychology_james_1890", "name": "laboratory", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["laboratory"], "contexts": ["place for scientific experiments"]}, {"entity_id": "laboratories", "book_id": "principles_of_psychology_james_1890", "name": "laboratories", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["laboratories"], "contexts": ["places for scientific experimentation"]}, {"entity_id": "laboratories", "book_id": "kosmos_humboldt_1845", "name": "laboratories", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["laboratories"], "contexts": ["places for scientific experiments"]}, {"entity_id": "laboratory", "book_id": "first_principles_spencer_1862", "name": "laboratory", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["laboratory"], "contexts": ["place for scientific experiments", "place for artificial production of phenomena"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "laboratory", "target_book": "kosmos_humboldt_1845", "target_name": "laboratories", "similarity": 0.941}, {"source_book": "principles_of_psychology_james_1890", "source_name": "laboratory", "target_book": "first_principles_spencer_1862", "target_name": "laboratory", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "laboratories", "target_book": "kosmos_humboldt_1845", "target_name": "laboratories", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "laboratories", "target_book": "first_principles_spencer_1862", "target_name": "laboratory", "similarity": 0.941}, {"source_book": "kosmos_humboldt_1845", "source_name": "laboratories", "target_book": "first_principles_spencer_1862", "target_name": "laboratory", "similarity": 0.941}], "id": 1106, "stable_key": "clu_db3a8ec8c7bb7828", "ground_truth": {"modern_name": "laboratory", "confidence": "high", "type": "concept", "wikidata_id": "Q483242", "wikidata_description": "facility that provides controlled conditions in which scientific or technological research, experiments, and measurement may be performed", "wikipedia_url": "https://en.wikipedia.org/wiki/Laboratory", "wikipedia_extract": "A laboratory (UK: ; US: ; colloquially lab) is a facility that provides controlled conditions in which scientific or technological research, experiments, and measurement may be performed. Laboratories are found in a variety of settings such as schools, universities, privately owned research institutions, corporate research and testing facilities, government regulatory and forensic investigation centers,  physicians' offices, clinics, hospitals, regional and national referral centers, and even occasionally personal residences. The organisation and contents of laboratories are determined by the differing requirements of the specialists working within. A physics laboratory might contain a particle accelerator or vacuum chamber, while a metallurgy laboratory could have apparatus for casting or refining metals or for testing their strength. A chemist or biologist might use a wet laboratory, while a psychologist's laboratory might be a room with one-way mirrors and hidden cameras in which to observe behavior. In some laboratories, such as those commonly used by computer scientists, computers (sometimes supercomputers) are used for either simulations or the analysis of data."}, "cross_references": [{"found_name": "Cambridge Observatory", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4359, "target_cluster_name": "Cambridge Observatory", "source_book": "llm_generated", "evidence_snippet": "Cambridge Observatory is a specific type of institution that would house and utilize a laboratory for astronomical research.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Cambridge Observatory is a specific type of institution that would house and utilize a laboratory for astronomical research."}]}, {"canonical_name": "bell-stroke", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "bell-stroke", "book_id": "principles_of_psychology_james_1890", "name": "bell-stroke", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["bell-stroke"], "contexts": ["auditory stimulus in experiment", "auditory stimulus for experiment"]}, {"entity_id": "bell", "book_id": "principles_of_psychology_james_1890", "name": "bell", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["bell"], "contexts": ["auditory signaling device"]}, {"entity_id": "bells", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Bells", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Bells"], "contexts": ["hollow objects that ring", "hollow objects that produce sound when struck"]}, {"entity_id": "bell", "book_id": "connexion_physical_sciences_somerville_1858", "name": "bell", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["bell"], "contexts": ["object producing sound when struck"]}, {"entity_id": "bells", "book_id": "first_principles_spencer_1862", "name": "bells", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["bells"], "contexts": ["objects producing sound when struck"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "bell-stroke", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "bell", "similarity": 0.934}, {"source_book": "principles_of_psychology_james_1890", "source_name": "bell-stroke", "target_book": "first_principles_spencer_1862", "target_name": "bells", "similarity": 0.884}, {"source_book": "principles_of_psychology_james_1890", "source_name": "bell", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bells", "similarity": 0.883}, {"source_book": "principles_of_psychology_james_1890", "source_name": "bell", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "bell", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "bell", "target_book": "first_principles_spencer_1862", "target_name": "bells", "similarity": 0.933}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Bells", "target_book": "first_principles_spencer_1862", "target_name": "bells", "similarity": 0.949}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "bell", "target_book": "first_principles_spencer_1862", "target_name": "bells", "similarity": 0.933}], "id": 1107, "stable_key": "clu_94fdb0a3128aae8b", "ground_truth": {"modern_name": "bell", "confidence": "high", "type": "object", "note": "The term 'bell-stroke' refers to the sound produced by a bell or the act of ringing it, but the core object is the bell itself.", "wikidata_id": "Q26158", "wikidata_description": "Flowering plant in the daisy family Asteraceae", "wikipedia_url": "https://en.wikipedia.org/wiki/Bellis%20perennis", "wikipedia_extract": "Bellis perennis ( BEL-iss pə-REN-iss), the daisy, is a European species of the family Asteraceae, often considered the archetypal species of the name daisy. To distinguish this species from other plants known as daisies, it is sometimes qualified or known as common daisy, lawn daisy or English daisy. Bellis perennis is a perennial herbaceous plant growing to 20 centimetres (8 inches) in height. It has short creeping rhizomes and rosettes of small rounded or spoon-shaped leaves that are from 2 to 5 cm (3⁄4–2 in) long and grow flat to the ground. The species habitually colonises lawns and is difficult to eradicate by mowing, hence the term 'lawn daisy'. The plant blooms from March to September and exhibits the phenomenon of heliotropism, in which the flowers follow the position of the sun in the sky."}, "cross_references": []}, {"canonical_name": "tuning-fork", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "tuning-fork", "book_id": "principles_of_psychology_james_1890", "name": "tuning-fork", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["tuning-fork"], "contexts": ["component of reaction timer"]}, {"entity_id": "tuning-forks", "book_id": "principles_of_psychology_james_1890", "name": "tuning-forks", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["tuning-forks"], "contexts": ["instrument for producing simple tones"]}, {"entity_id": "tuning-fork", "book_id": "connexion_physical_sciences_somerville_1858", "name": "tuning-fork", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 4, "variants": ["tuning-fork"], "contexts": ["instrument for producing musical notes", "instrument producing specific musical notes"]}, {"entity_id": "tuning-fork", "book_id": "first_principles_spencer_1862", "name": "tuning-fork", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["tuning-fork"], "contexts": ["instrument producing musical tones"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "tuning-fork", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "tuning-fork", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "tuning-fork", "target_book": "first_principles_spencer_1862", "target_name": "tuning-fork", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "tuning-forks", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "tuning-fork", "similarity": 0.975}, {"source_book": "principles_of_psychology_james_1890", "source_name": "tuning-forks", "target_book": "first_principles_spencer_1862", "target_name": "tuning-fork", "similarity": 0.975}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "tuning-fork", "target_book": "first_principles_spencer_1862", "target_name": "tuning-fork", "similarity": 1.0}], "id": 1108, "stable_key": "clu_c9992595923a609e", "ground_truth": {"modern_name": "tuning fork", "confidence": "high", "type": "object", "wikidata_id": "Q201898", "wikidata_description": "device used to produce a fixed tone", "wikipedia_url": "https://en.wikipedia.org/wiki/Tuning%20fork", "wikipedia_extract": "A tuning fork is an acoustic resonator in the form of a two-pronged fork with the prongs (tines) formed from a U-shaped bar of elastic metal (usually steel). It resonates at a specific constant pitch when set vibrating by striking it against a surface or with an object, and emits a pure musical tone once the high overtones fade out. A tuning fork's pitch depends on the length and mass of the two prongs. They are traditional sources of standard pitch for tuning musical instruments. The tuning fork was invented in 1711 by British musician John Shore, sergeant trumpeter and lutenist to the royal court. A tuning fork is a fork-shaped acoustic resonator used in many applications to produce a fixed tone."}, "cross_references": [{"found_name": "Musical instruments", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2894, "target_cluster_name": "musical instruments", "source_book": "llm_generated", "evidence_snippet": "A tuning fork is a type of musical instrument.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "A tuning fork is a type of musical instrument."}, {"found_name": "Vibrating string", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1465, "target_cluster_name": "vibrating string", "source_book": "llm_generated", "evidence_snippet": "Both tuning forks and vibrating strings produce sound through vibration, forming the basis of musical tones.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both tuning forks and vibrating strings produce sound through vibration, forming the basis of musical tones."}, {"found_name": "pendulum-strokes", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4241, "target_cluster_name": "pendulum-strokes", "source_book": "llm_generated", "evidence_snippet": "Both pendulums and tuning forks are devices that produce oscillations at a specific frequency, relevant to the study of vibrations and resonance.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both pendulums and tuning forks are devices that produce oscillations at a specific frequency, relevant to the study of vibrations and resonance.", "is_reverse": true}]}, {"canonical_name": "ar ambiente", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "environment", "book_id": "principles_of_psychology_james_1890", "name": "environment", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["environment"], "contexts": ["surroundings of the organism"]}, {"entity_id": "ar_ambiente", "book_id": "polyanthea_medicinal", "name": "ar ambiente", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["ar ambiente"], "contexts": ["ambient air", "ambient air as a cause"]}, {"entity_id": "environment", "book_id": "first_principles_spencer_1862", "name": "environment", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["environment"], "contexts": ["surroundings influencing organism"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "environment", "target_book": "polyanthea_medicinal", "target_name": "ar ambiente", "sim