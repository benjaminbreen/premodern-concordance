 "connexion_physical_sciences_somerville_1858", "target_name": "Bologna", "similarity": 0.903}, {"source_book": "kosmos_humboldt_1845", "source_name": "Bologna", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bologna", "similarity": 1.0}], "id": 1456, "stable_key": "clu_f0e3fd005dd9b7d9-2", "ground_truth": {"modern_name": "Poland", "confidence": "high", "type": "place", "description": "European country, historical kingdom and later part of Russian Empire.", "wikipedia_extract": "Poland, officially the Republic of Poland, is a country in Central Europe. It extends from the Baltic Sea in the north to the Sudetes and Carpathian Mountains in the south. Poland borders Kaliningrad Oblast and Lithuania to the north; Belarus and Ukraine to the east; Slovakia and the Czech Republic to the south; and Germany to the west. The territory has a varied landscape, diverse ecosystems, and a temperate climate. Poland is composed of sixteen voivodeships and is the fifth most populous member state of the European Union (EU), with over 38 million people, and the fifth largest EU country by land area, covering 312,696 km2 (120,733 sq mi). The capital and largest city is Warsaw; other major cities include Kraków, Wrocław, Łódź, Poznań, and Gdańsk."}, "cross_references": [{"found_name": "Central Europe", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2214, "target_cluster_name": "Central Europe", "source_book": "llm_generated", "evidence_snippet": "Poland is a country located in Central Europe.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Poland is a country located in Central Europe."}]}, {"canonical_name": "opposite", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "opposite", "book_id": "principles_of_psychology_james_1890", "name": "opposite", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["opposite"], "contexts": ["contrasting or contrary"]}, {"entity_id": "contrario", "book_id": "historia_medicinal_monardes_1574", "name": "contrario", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["contrario"], "contexts": ["opposite to counteract poison"]}, {"entity_id": "opposite", "book_id": "connexion_physical_sciences_somerville_1858", "name": "opposite", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["opposite"], "contexts": ["facing the other way"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "opposite", "target_book": "historia_medicinal_monardes_1574", "target_name": "contrario", "similarity": 0.951}, {"source_book": "principles_of_psychology_james_1890", "source_name": "opposite", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "opposite", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "contrario", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "opposite", "similarity": 0.951}], "id": 1457, "stable_key": "clu_bea7bbe61a78dd90", "ground_truth": {"modern_name": "Opposite", "confidence": "high", "type": "concept", "note": "This refers to the philosophical or physical concept of being contrary or opposed, not a specific scientific term.", "wikidata_id": "Q2602337", "wikidata_description": "written prose piece in a publication expressing the opinion of an author or entity"}, "cross_references": [{"found_name": "Action and reaction", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 961, "target_cluster_name": "Action and reaction", "source_book": "llm_generated", "evidence_snippet": "The concept of 'opposite' is fundamental to understanding 'action and reaction' as forces acting in opposing directions.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The concept of 'opposite' is fundamental to understanding 'action and reaction' as forces acting in opposing directions."}, {"found_name": "Difference", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 698, "target_cluster_name": "difference", "source_book": "llm_generated", "evidence_snippet": "The concept of 'opposite' implies a fundamental difference between two entities or states.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The concept of 'opposite' implies a fundamental difference between two entities or states."}, {"found_name": "Discord", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1209, "target_cluster_name": "discord", "source_book": "llm_generated", "evidence_snippet": "Discord is a state of disagreement or lack of harmony, often arising from opposing viewpoints or forces.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Discord is a state of disagreement or lack of harmony, often arising from opposing viewpoints or forces."}, {"found_name": "Divergence", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3977, "target_cluster_name": "divergence", "source_book": "llm_generated", "evidence_snippet": "Divergence implies moving apart or becoming different, which relates to the idea of opposition or contrast.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Divergence implies moving apart or becoming different, which relates to the idea of opposition or contrast."}, {"found_name": "Equality", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4249, "target_cluster_name": "equality", "source_book": "llm_generated", "evidence_snippet": "Equality is the state of being equal, which is the direct antithesis or opposite of inequality or difference.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Equality is the state of being equal, which is the direct antithesis or opposite of inequality or difference."}, {"found_name": "Forces of attraction", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4344, "target_cluster_name": "forces of attraction", "source_book": "llm_generated", "evidence_snippet": "While attraction itself isn't opposite, it is often contrasted with repulsion, making 'opposite' a relevant contextual concept.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "While attraction itself isn't opposite, it is often contrasted with repulsion, making 'opposite' a relevant contextual concept."}]}, {"canonical_name": "organic growth", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "organic_growth", "book_id": "principles_of_psychology_james_1890", "name": "organic growth", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["organic growth"], "contexts": ["development through biological processes"]}, {"entity_id": "organic_development", "book_id": "kosmos_humboldt_1845", "name": "organic development", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["organic development"], "contexts": ["process of growth and change"]}, {"entity_id": "organic_growth", "book_id": "first_principles_spencer_1862", "name": "organic growth", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["organic growth"], "contexts": ["biological development process"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "organic growth", "target_book": "kosmos_humboldt_1845", "target_name": "organic development", "similarity": 0.915}, {"source_book": "principles_of_psychology_james_1890", "source_name": "organic growth", "target_book": "first_principles_spencer_1862", "target_name": "organic growth", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "organic development", "target_book": "first_principles_spencer_1862", "target_name": "organic growth", "similarity": 0.915}], "id": 1458, "stable_key": "clu_716da89b103c2d9a", "ground_truth": {"modern_name": "Organic growth", "confidence": "high", "type": "concept", "note": "Refers to development through biological processes, a key concept in early evolutionary and developmental biology.", "wikidata_id": "Q445127", "wikidata_description": "business expansion through increasing output and sales as opposed to mergers, acquisitions and takeovers"}, "cross_references": [{"found_name": "Development", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 960, "target_cluster_name": "development", "source_book": "llm_generated", "evidence_snippet": "Development is a broader term that often encompasses organic growth, especially in biological and economic contexts. Organic growth refers to the internal development and expansion of a system or entity, which is a key aspect of 'development'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Development is a broader term that often encompasses organic growth, especially in biological and economic contexts. Organic growth refers to the internal development and expansion of a system or entity, which is a key aspect of 'development'."}, {"found_name": "Evolution", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 540, "target_cluster_name": "Evolution", "source_book": "llm_generated", "evidence_snippet": "Evolution, particularly in a biological context, describes the process of change and development in living organisms over generations, which is a form of organic growth. In broader philosophical or economic contexts, 'evolution' can also refer to gradual, organic development.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Evolution, particularly in a biological context, describes the process of change and development in living organisms over generations, which is a form of organic growth. In broader philosophical or economic contexts, 'evolution' can also refer to gradual, organic development."}, {"found_name": "Spring", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1680, "target_cluster_name": "Spring", "source_book": "llm_generated", "evidence_snippet": "Spring is a season of significant organic growth in nature.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Spring is a season of significant organic growth in nature.", "is_reverse": true}]}, {"canonical_name": "instability", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "instability", "book_id": "principles_of_psychology_james_1890", "name": "instability", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["instability"], "contexts": ["lack of fixed or predictable state"]}, {"entity_id": "instability", "book_id": "connexion_physical_sciences_somerville_1858", "name": "instability", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["instability"], "contexts": ["state of being unstable"]}, {"entity_id": "instability", "book_id": "first_principles_spencer_1862", "name": "instability", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["instability"], "contexts": ["tendency to change"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "instability", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "instability", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "instability", "target_book": "first_principles_spencer_1862", "target_name": "instability", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "instability", "target_book": "first_principles_spencer_1862", "target_name": "instability", "similarity": 1.0}], "id": 1459, "stable_key": "clu_6557326207b00c88", "ground_truth": {"modern_name": "Instability", "confidence": "high", "type": "concept", "wikidata_id": "Q405372", "wikidata_description": "characterized by some of the outputs or internal states growing without bounds", "wikipedia_url": "https://en.wikipedia.org/wiki/Instability", "wikipedia_extract": "In dynamical systems instability means that some of the outputs or internal states increase with time, without bounds. Not all systems that are not stable are unstable; systems can also be marginally stable or exhibit limit cycle behavior. In structural engineering, a structural beam or column can become unstable when excessive compressive load is applied. Beyond a certain threshold, structural deflections magnify stresses, which in turn increases deflections. This can take the form of buckling or crippling. The general field of study is called structural stability."}, "cross_references": [{"found_name": "Acceleration", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2252, "target_cluster_name": "acceleration", "source_book": "llm_generated", "evidence_snippet": "In dynamical systems, instability is characterized by outputs or internal states increasing without bounds over time, which is directly related to acceleration as a measure of the rate of change of velocity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "In dynamical systems, instability is characterized by outputs or internal states increasing without bounds over time, which is directly related to acceleration as a measure of the rate of change of velocity."}, {"found_name": "Centrifugal force", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 315, "target_cluster_name": "Centrifugal force", "source_book": "llm_generated", "evidence_snippet": "Centrifugal force is a concept often discussed in relation to circular motion and stability, where an outward-directed force can lead to instability if not balanced.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Centrifugal force is a concept often discussed in relation to circular motion and stability, where an outward-directed force can lead to instability if not balanced."}, {"found_name": "Equilibrium", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 247, "target_cluster_name": "equilibrium", "source_book": "llm_generated", "evidence_snippet": "Instability is the opposite of equilibrium. A system is unstable if it deviates from an equilibrium state and its deviations grow over time.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Instability is the opposite of equilibrium. A system is unstable if it deviates from an equilibrium state and its deviations grow over time."}, {"found_name": "Force", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 59, "target_cluster_name": "Force", "source_book": "llm_generated", "evidence_snippet": "Instability in physical systems often arises from the interplay of forces, where unbalanced forces can lead to unbounded growth of motion or deformation.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Instability in physical systems often arises from the interplay of forces, where unbalanced forces can lead to unbounded growth of motion or deformation."}, {"found_name": "Expansion", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 933, "target_cluster_name": "Expansion", "source_book": "llm_generated", "evidence_snippet": "Instability is often described as a process where certain quantities expand or grow without bound over time.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Instability is often described as a process where certain quantities expand or grow without bound over time."}]}, {"canonical_name": "corpuscular philosophy", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "corpuscular_philosophy", "book_id": "principles_of_psychology_james_1890", "name": "corpuscular philosophy", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["corpuscular philosophy"], "contexts": ["philosophy of tiny particles"]}, {"entity_id": "corpuscular_philosophy", "book_id": "polyanthea_medicinal", "name": "corpuscular philosophy", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["corpuscular philosophy"], "contexts": ["theory of corpuscles"]}, {"entity_id": "corpuscular_philosophers", "book_id": "connexion_physical_sciences_somerville_1858", "name": "corpuscular philosophers", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["corpuscular philosophers"], "contexts": ["philosophers with corpuscular theory of light"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "corpuscular philosophy", "target_book": "polyanthea_medicinal", "target_name": "corpuscular philosophy", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "corpuscular philosophy", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "corpuscular philosophers", "similarity": 0.89}, {"source_book": "polyanthea_medicinal", "source_name": "corpuscular philosophy", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "corpuscular philosophers", "similarity": 0.89}], "id": 1460, "stable_key": "clu_9f9c8aa189d97bea", "ground_truth": {"modern_name": "Corpuscular theory", "confidence": "high", "type": "concept", "wikidata_id": "Q456954", "wikidata_description": "theory", "wikipedia_url": "https://en.wikipedia.org/wiki/Corpuscular%20theory%20of%20light", "wikipedia_extract": "In optics, the corpuscular theory of light states that light is made up of small discrete particles called \"corpuscles\" (little particles) which travel in a straight line with a finite velocity and possess impetus. This notion was based on an alternate description of atomism of the time period. Isaac Newton laid the foundations for this theory through his work in optics. This early conception of the particle theory of light was an early forerunner to the modern understanding of the photon. This theory came to dominate the conceptions of light in the eighteenth century, displacing the previously prominent vibration theories, where light was viewed as \"pressure\" of the medium between the source and the receiver, first championed by René Descartes, and later in a more refined form by Christiaan Huygens. In part correct, being able to successfully explain refraction, reflection, rectilinear propagation and to a lesser extent diffraction, the theory would fall out of favor in the early nineteenth century, as the wave theory of light amassed new experimental evidence."}, "cross_references": [{"found_name": "Chymica", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 1531, "target_cluster_name": "Chymica", "source_book": "llm_generated", "evidence_snippet": "Some alchemical theories, particularly later ones, engaged with corpuscular ideas about matter.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Some alchemical theories, particularly later ones, engaged with corpuscular ideas about matter.", "is_reverse": true}, {"found_name": "physics", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 110, "target_cluster_name": "physics", "source_book": "llm_generated", "evidence_snippet": "Corpuscular theories, particularly regarding light, were early models in physics that preceded wave and quantum theories.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Corpuscular theories, particularly regarding light, were early models in physics that preceded wave and quantum theories.", "is_reverse": true}, {"found_name": "Force", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 59, "target_cluster_name": "Force", "source_book": "llm_generated", "evidence_snippet": "The corpuscular theory of light describes light particles (corpuscles) as possessing impetus and traveling in straight lines, implying concepts of motion and force that govern their behavior.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The corpuscular theory of light describes light particles (corpuscles) as possessing impetus and traveling in straight lines, implying concepts of motion and force that govern their behavior."}]}, {"canonical_name": "spinning top", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "spinning_top", "book_id": "principles_of_psychology_james_1890", "name": "spinning top", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["spinning top"], "contexts": ["toy that spins on its axis"]}, {"entity_id": "top_spinning", "book_id": "connexion_physical_sciences_somerville_1858", "name": "top spinning", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["top spinning"], "contexts": ["toy that spins"]}, {"entity_id": "spinning_top", "book_id": "first_principles_spencer_1862", "name": "spinning top", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["spinning top"], "contexts": ["example of successive equilibration of combined movements"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "spinning top", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "top spinning", "similarity": 0.926}, {"source_book": "principles_of_psychology_james_1890", "source_name": "spinning top", "target_book": "first_principles_spencer_1862", "target_name": "spinning top", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "top spinning", "target_book": "first_principles_spencer_1862", "target_name": "spinning top", "similarity": 0.926}], "id": 1461, "stable_key": "clu_ce788392d94a0724", "ground_truth": {"modern_name": "spinning top", "confidence": "high", "type": "object", "wikidata_id": "Q15583916", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Leucadendron%20rubrum", "wikipedia_extract": "Leucadendron rubrum, the spinning top, is a flower-bearing shrub belonging to the genus Leucadendron and forms part of the fynbos. The plant is native to the Western Cape, South Africa. The shrub grows 2.5 m (8.2 ft) tall and flowers from August to September. Fire destroys the plant but the seeds survive. The seeds are stored in a toll on the female plant and are released where they are spread by the wind. The seed has a parachute mechanism that allows it to float and rotate through the air."}, "cross_references": []}, {"canonical_name": "tendency", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "tendency", "book_id": "principles_of_psychology_james_1890", "name": "tendency", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["tendency"], "contexts": ["internal inclination or disposition"]}, {"entity_id": "tendency", "book_id": "connexion_physical_sciences_somerville_1858", "name": "tendency", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["tendency"], "contexts": ["inclination to move"]}, {"entity_id": "tendencies", "book_id": "first_principles_spencer_1862", "name": "tendencies", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["tendencies"], "contexts": ["inclinations or predispositions"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "tendency", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "tendency", "similarity": 1.0}, {"source_book": "principles_of_