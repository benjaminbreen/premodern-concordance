, "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["conceit"], "contexts": ["idea or notion"]}, {"entity_id": "conceit", "book_id": "principles_of_psychology_james_1890", "name": "conceit", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["conceit"], "contexts": ["excessive pride in oneself", "excessive pride"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "conceit", "target_book": "principles_of_psychology_james_1890", "target_name": "conceit", "similarity": 1.0}], "id": 2946, "stable_key": "clu_2eae3988dd7b0bad", "ground_truth": {"modern_name": "Conceit", "confidence": "high", "type": "concept"}, "cross_references": [{"found_name": "Pride", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2709, "target_cluster_name": "Pride", "source_book": "llm_generated", "evidence_snippet": "Conceit is a form of excessive pride, often involving an inflated sense of one's own worth or abilities.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: Conceit is a form of excessive pride, often involving an inflated sense of one's own worth or abilities.", "is_reverse": true}, {"found_name": "opinions", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2924, "target_cluster_name": "opinions", "source_book": "llm_generated", "evidence_snippet": "Conceit can be seen as a specific, often negative, type of opinion or judgment about oneself or others.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Conceit can be seen as a specific, often negative, type of opinion or judgment about oneself or others.", "is_reverse": true}, {"found_name": "Jupiter", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 553, "target_cluster_name": "Jupiter", "source_book": "pseudodoxia_epidemica_browne_1646", "evidence_snippet": "_Epithets_. Had _Orestes_ been Judge, he would not have acquitted that _Lys