]}, {"canonical_name": "Socrates", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 4, "total_mentions": 7, "members": [{"entity_id": "socrates", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Socrates", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Socrates"], "contexts": ["suffered for his beliefs about gods", "ancient Greek philosopher"]}, {"entity_id": "socrates", "book_id": "english_physician_1652", "name": "Socrates", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Socrates"], "contexts": ["ancient Greek philosopher"]}, {"entity_id": "socrates", "book_id": "kosmos_humboldt_1845", "name": "Socrates", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Socrates"], "contexts": ["ancient Greek philosopher", "ancient philosopher quoted"]}, {"entity_id": "socrates", "book_id": "historia_medicinal_monardes_1574", "name": "Socrates", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Socrates"], "contexts": ["ancient philosopher quoted on wealth"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Socrates", "target_book": "english_physician_1652", "target_name": "Socrates", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Socrates", "target_book": "kosmos_humboldt_1845", "target_name": "Socrates", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Socrates", "target_book": "historia_medicinal_monardes_1574", "target_name": "Socrates", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Socrates", "target_book": "kosmos_humboldt_1845", "target_name": "Socrates", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Socrates", "target_book": "historia_medicinal_monardes_1574", "target_name": "Socrates", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Socrates", "target_book": "historia_medicinal_monardes_1574", "target_name": "Socrates", "similarity": 1.0}], "id": 460, "stable_key": "clu_274b048f59923684", "ground_truth": {"modern_name": "Socrates", "confidence": "high", "type": "person", "birth_year": -470, "death_year": -399, "description": "Ancient Greek philosopher, known for his Socratic method.", "wikidata_id": "Q913", "wikidata_description": "5th-century BCE Greek philosopher", "wikipedia_url": "https://en.wikipedia.org/wiki/Socrates", "wikipedia_extract": "Socrates (; Ancient Greek: Σωκράτης, romanized: Sōkrátēs; c. 470 – 399 BC) was an ancient Greek philosopher from Classical Athens, perhaps the first Western moral philosopher, and a major inspiration on his student Plato, who largely founded the tradition of Western philosophy. An enigmatic figure, Socrates authored no texts and is known mainly through the posthumous accounts of classical writers, particularly his students Plato and Xenophon. These accounts are written as dialogues, in which Socrates and his interlocutors examine a subject in the style of question and answer; they gave rise to the Socratic dialogue literary genre. Contradictory accounts of Socrates make a reconstruction of his philosophy nearly impossible, a situation known as the Socratic problem. Socrates was a polarizing figure in Athenian society."}, "cross_references": [{"found_name": "Plato", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 113, "target_cluster_name": "Plato", "source_book": "llm_generated", "evidence_snippet": "Plato was Socrates' student and wrote dialogues featuring him.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Plato was Socrates' student and wrote dialogues featuring him.", "is_reverse": true}, {"found_name": "Aristotle", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 62, "target_cluster_name": "Aristotle", "source_book": "llm_generated", "evidence_snippet": "Aris