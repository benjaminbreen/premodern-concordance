ry": "SCHOLAR", "count": 1, "variants": ["Professor Huxley"], "contexts": ["friend who suggested 'persistence'"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Professor Huxley", "target_book": "first_principles_spencer_1862", "target_name": "Professor Huxley", "similarity": 1.0}], "id": 4024, "stable_key": "clu_5620db35d65402ba", "ground_truth": {"modern_name": "Thomas Henry Huxley", "confidence": "high", "type": "person", "birth_year": 1825, "death_year": 1895, "description": "Prominent biologist and advocate for Darwin's theory"}, "cross_references": [{"found_name": "Huxley", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 871, "target_cluster_name": "Huxley", "source_book": "llm_generated", "evidence_snippet": "This is a direct alternative appellation for Thomas Henry Huxley, indicating his academic position.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: This is a direct alternative appellation for Thomas Henry Huxley, indicating his academic position.", "is_reverse": true}]}, {"canonical_name": "imago", "category": "ANIMAL", "subcategory": "INSECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "imago", "book_id": "origin_of_species_darwin_1859", "name": "imago", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["imago"], "contexts": ["adult stage of insect"]}, {"entity_id": "imago", "book_id": "first_principles_spencer_1862", "name": "imago", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["imago"], "contexts": ["stage evolved from pupa"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "imago", "target_book": "first_principles_spencer_1862", "target_name": "imago", "similarity": 1.0}], "id": 4025, "stable_key": "clu_c19a8196b7824754", "ground_truth": {"modern_name": "Imago", "confidence": "high", "type": "animal", "wikipedia_extract": "Terrestrial animals are animals that live predominantly or entirely on land (e.g., cats, chickens, ants, most spiders), as compared with aquatic animals (e.g., fish, whales, octopuses, lobsters, etc.), who live predominantly or entirely in bodies of water; and semiaquatic animals (e.g., crocodilians, seals, platypus and most amphibians), who inhabit coastal, riparian or wetland areas and rely on both aquatic and terrestrial habitats. While most insects (who constitute over half of all known species in the animal kingdom) are terrestrial, some groups, such as mosquitoes and dragonflies, spend their egg and larval stages in water but emerge as fully terrestrial adults (imagos) after completing metamorphosis. Terrestrial animals conduct respiratory gas exchange directly with the atmosphere, typically via specialized respiratory organs known as lungs, or via cutaneous respiration across the skin. They have also evolved homeostatic features such as impermeable cuticles that can restrict fluid loss, temperature fluctuations and infection, and an excretory system that can filter out nitrogenous waste in the form of urea or uric acid, in contrast to the ammonia-based excretion of aquatic animals. Without the buoyancy of an aqueous environment to support their weight, they have evolved robust skeletons that can hold up their body shape, as well as powerful appendages known as legs or limbs to facilitate terrestrial locomotion, although some perform limbless locomotion using body surface projections such as scales and setae. Some terrestrial animals even have wings or membranes that act as airfoils to generate lift, allowing them to fly and/or glide as airborne animals.", "wikipedia_url": "https://en.wikipedia.org/wiki/Terrestrial_animal"}, "cross_references": [{"found_name": "caterpillar", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 908, "target_cluster_name": "caterpillar", "source_book": "llm_generated", "evidence_snippet": "The imago is the final, adult stage of an insect, which develops from the larval stage (caterpillar).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The imago is the final, adult stage of an insect, which develops from the larval stage (caterpillar).", "is_reverse": true}, {"found_name": "flies", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2679, "target_cluster_name": "flies", "source_book": "llm_generated", "evidence_snippet": "Imago refers to the adult, sexually mature stage of an insect, which in the case of flies is the winged form.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Imago refers to the adult, sexually mature stage of an insect, which in the case of flies is the winged form.", "is_reverse": true}, {"found_name": "Gnats", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2694, "target_cluster_name": "Gnats", "source_book": "llm_generated", "evidence_snippet": "Imago refers to the adult, sexually mature stage of an insect, which is the 'gnat' form described.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Imago refers to the adult, sexually mature stage of an insect, which is the 'gnat' form described.", "is_reverse": true}, {"found_name": "larvæ", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2720, "target_cluster_name": "larvæ", "source_book": "llm_generated", "evidence_snippet": "The imago is the final, adult stage of an insect, which develops from the larva. Historical texts often discuss the transformation from larva to imago.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The imago is the final, adult stage of an insect, which develops from the larva. Historical texts often discuss the transformation from larva to imago.", "is_reverse": true}]}, {"canonical_name": "phosphate of lime", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions":