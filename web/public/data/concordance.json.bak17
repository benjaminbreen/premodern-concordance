ubcategory": "OTHER_CONCEPT", "count": 1, "variants": ["consideration"], "contexts": ["thoughtful attention to a subject"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "considerations", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "consideration", "similarity": 0.909}, {"source_book": "principles_of_psychology_james_1890", "source_name": "consideration", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "consideration", "similarity": 1.0}], "id": 3086, "stable_key": "clu_05024d9211750887", "ground_truth": {"modern_name": "consideration", "confidence": "high", "type": "concept"}, "cross_references": []}, {"canonical_name": "hope", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "hope", "book_id": "principles_of_psychology_james_1890", "name": "hope", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["hope"], "contexts": ["a phrenological faculty", "cardinal passion of life"]}, {"entity_id": "hopes", "book_id": "principles_of_psychology_james_1890", "name": "hopes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["hopes"], "contexts": ["desires for future outcomes"]}, {"entity_id": "hope", "book_id": "kosmos_humboldt_1845", "name": "hope", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["hope"], "contexts": ["feeling of expectation and desire"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "hope", "target_book": "kosmos_humboldt_1845", "target_name": "hope", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "hopes", "target_book": "kosmos_humboldt_1845", "target_name": "hope", "similarity": 0.946}], "id": 3087, "stable_key": "clu_7227af037fddd056", "ground_truth": {"modern_name": "Hope", "confidence": "high", "type": "concept", "note": "The context 'phrenological faculty' strongly suggests the psychological concept of hope, also explicitly mentioned as 'feeling of expectation and desire'.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/J-Hope", "wikipedia_extract": "Jung Ho-seok (Korean: 정호석; born February 18, 1994), known professionally as J-Hope (제이홉; stylized in lower case), is a South Korean rapper, singer, songwriter, dancer, and record producer. He made his debut as a member of South Korean boy band BTS in 2013, under Big Hit Entertainment. J-Hope released his first solo mixtape, Hope World, in 2018. It was received positively by critics and peaked at number 38 on the US Billboard 200, the highest-charting album by a Korean solo artist at the time. He became the first member of BTS to enter the Billboard Hot 100 as a soloist in 2019, when his single \"Chicken Noodle Soup\", featuring singer Becky G, debuted at number 81. In 2022, J-Hope released his debut studio album Jack in the Box."}, "cross_references": [{"found_name": "Prayer", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1226, "target_cluster_name": "Prayer", "source_book": "llm_generated", "evidence_snippet": "Prayer is often an expression of hope and a means to seek desired outcomes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Prayer is often an expression of hope and a means to seek desired outcomes.", "is_reverse": true}, {"found_name": "grief", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2305, "target_cluster_name": "grief", "source_book": "llm_generated", "evidence_snippet": "The loss of hope or the absence of hope can be a significant aspect of grief.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The loss of hope or the absence of hope can be a significant aspect of grief.", "is_reverse": true}]}, {"canonical_name": "Fig. 17", "