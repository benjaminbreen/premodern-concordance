ansition from solid to liquid state"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "fusion", "target_book": "kosmos_humboldt_1845", "target_name": "fusion", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fusion", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "fusion", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fusion", "target_book": "first_principles_spencer_1862", "target_name": "fusion", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "fusion", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "fusion", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "fusion", "target_book": "first_principles_spencer_1862", "target_name": "fusion", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "fusion", "target_book": "first_principles_spencer_1862", "target_name": "fusion", "similarity": 1.0}], "id": 433, "stable_key": "clu_20248b48f32abb97", "ground_truth": {"modern_name": "Melting point", "confidence": "high", "type": "concept", "note": "The contexts 'fusion point' and 'process of melting' clearly point to the physical phenomenon of phase transition.", "wikidata_id": "Q465149", "wikidata_description": "process in which adding a solute to a solvent decreases the freezing point of the solvent", "wikipedia_url": "https://en.wikipedia.org/wiki/Freezing-point%20depression", "wikipedia_extract": "The melting point (or, rarely, liquefaction point) of a substance is the temperature at which it changes state from solid to liquid. At the melting point the solid and liquid phase exist in equilibrium. The melting point of a substance depends on pressure and is usually specified at a standard pressure such as 1 atmosphere or 100 kPa. When considered as the temperature of the reverse change from liquid to solid, it is referred to as the freezing point or crystallization point. Because of the ability of substances to supercool, the freezing point can easily appear to be below its actual value. When the \"characteristic freezing point\" of a substance is determined, in fact, the actual methodology is almost always \"the principle of observing the disappearance rather than the formation of ice, that is, the melting point.\" For most substances, melting and freezing points are approximately equal."}, "cross_references": [{"found_name": "Freezing", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1407, "target_cluster_name": "congelation", "source_book": "llm_generated", "evidence_snippet": "Freezing is the inverse process of melting, occurring at the same temperature for a given substance under constant pressure.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Freezing is the inverse process of melting, occurring at the same temperature for a given substance under constant pressure."}]}, {"canonical_name": "South", "category": "PLACE", "subcategory": "REGION", "book_count": 4, "total_mentions": 9, "members": [{"entity_id": "south", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "South", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["South"], "contexts": ["cardinal direction", "opposite direction to the North"]}, {"entity_id": "sud", "book_id": "relation_historique_humboldt_vol3_1825", "name": "sud", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["sud"], "contexts": ["direction, south", "southern direction"]}, {"entity_id": "southern_regions", "book_id": "connexion_physical_sciences_somerville_1858", "name": "southern regions", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["southern regions"], "contexts": ["regions with distinguishable marine animals"]}, {"entity_id": "south", "book_id": "origin_of_species_darwin_1859", "name": "sou