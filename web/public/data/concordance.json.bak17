", "similarity": 0.966}, {"source_book": "english_physician_1652", "source_name": "bloodletting", "target_book": "polyanthea_medicinal", "target_name": "bloodletting", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "bloodletting", "target_book": "coloquios_da_orta_1563", "target_name": "bloodletting", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "bloodletting", "target_book": "ricettario_fiorentino_1597", "target_name": "Bloodletting", "similarity": 0.966}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "bloodletting", "target_book": "polyanthea_medicinal", "target_name": "bloodletting", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "bloodletting", "target_book": "ricettario_fiorentino_1597", "target_name": "Bloodletting", "similarity": 0.966}, {"source_book": "coloquios_da_orta_1563", "source_name": "bloodletting", "target_book": "polyanthea_medicinal", "target_name": "bloodletting", "similarity": 1.0}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Bloodletting", "target_book": "polyanthea_medicinal", "target_name": "bloodletting", "similarity": 0.966}], "id": 43, "stable_key": "clu_f0eb9af6f7438534", "ground_truth": {"modern_name": "Bloodletting", "confidence": "high", "type": "concept", "wikidata_id": "Q356405", "wikidata_description": "therapy, now rarely used in medicine", "wikipedia_url": "https://en.wikipedia.org/wiki/Bloodletting", "wikipedia_extract": "Bloodletting (or blood-letting) is the deliberate withdrawal of blood from a patient to prevent or cure illness and disease. Bloodletting, whether by a physician or by leeches, was based on an ancient system of medicine in which blood and other bodily fluids were regarded as \"humors\" that had to remain in proper balance to maintain health. It was the most common medical practice performed by surgeons from antiquity until the late 19th century, a span of over 2,000 years. In Europe, the practice continued to be relatively common until the end of the 19th century. The practice has been abandoned by modern-style medicine for all except a few very specific medical conditions. In the beginning of the 19th century, studies had begun to show the harmful effects of bloodletting."}, "cross_references": [{"found_name": "sangrias", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 523, "target_cluster_name": "sangrias", "source_book": "llm_generated", "evidence_snippet": "This is a direct Spanish synonym for bloodletting, commonly used in historical medical texts.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "This is a direct Spanish synonym for bloodletting, commonly used in historical medical texts."}, {"found_name": "Astrological medicine", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 569, "target_cluster_name": "astrological medicine", "source_book": "llm_generated", "evidence_snippet": "Bloodletting was often prescribed based on astrological considerations, linking the timing and method of the procedure to celestial influences.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Bloodletting was often prescribed based on astrological considerations, linking the timing and method of the procedure to celestial influences."}, {"found_name": "Humors", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 562, "target_cluster_name": "Humors", "source_book": "llm_generated", "evidence_snippet": "Bloodletting was a common medical practice derived from humoral theory, intended to rebalance the body's humors.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Bloodletting was a common medical practice derived from humoral theory, intended to rebalance the body's humors.", "is_reverse": true}, {"found_name": "evacuação", "link_type": "conceptual_overlap", "link_strength": 0.5, 