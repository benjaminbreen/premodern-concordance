sciences_somerville_1858", "target_name": "globe", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "globe", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Terrestrial globe", "similarity": 0.916}], "id": 1825, "stable_key": "clu_c58931db554edb82", "ground_truth": {"modern_name": "Globe", "confidence": "high", "type": "object"}, "cross_references": [{"found_name": "sphere", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 783, "target_cluster_name": "sphere", "source_book": "llm_generated", "evidence_snippet": "A globe is a spherical model of the Earth or other celestial body, directly representing a sphere in a physical form.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: A globe is a spherical model of the Earth or other celestial body, directly representing a sphere in a physical form.", "is_reverse": true}, {"found_name": "Variables of seamen", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "connexion_physical_sciences_somerville_1858", "evidence_snippet": "contrary directions cross at the equator, balance each other through about 6 degrees of latitude, and produce a belt of calms of that breadth encircling the globe, known as the calms of the equator, o", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for calms of the equator"}]}, {"canonical_name": "Melancolicos", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "melantholicos", "book_id": "historia_medicinal_monardes_1574", "name": "melantholicos", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["melantholicos", "melancholicó"], "contexts": ["bad sustenance quality", "humor related to melancholy"]}, {"entity_id": "melancolicos", "book_id": "polyanthea_medicinal", "name": "Melancolicos", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 15, "variants": ["Melancolicos", "melancolicos"], "contexts": ["melancholic humors", "disease of melancholy"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "melantholicos", "target_book": "polyanthea_medicinal", "target_name": "Melancolicos", "similarity": 0.886}], "id": 1826, "stable_key": "clu_937b6b7595d18aa4-2", "ground_truth": {"modern_name": "melancholic", "confidence": "high", "type": "concept", "description": "Relating to or characterized by melancholy; a humoral imbalance.", "note": "Refers to both a temperament and a humoral state.", "wikipedia_extract": "Melancholia or melancholy (Ancient Greek: μελαγχολία, romanized: melancholía; from μέλαινα χολή, mélaina cholḗ, 'black bile') is a concept found throughout ancient, medieval, and premodern medicine in Europe that describes a condition characterized by markedly depressed mood, bodily complaints, and sometimes hallucinations and delusions. Besides a pathological condition, melancholy could also refer to a mood or temperament and at times it was even used as a description of the human condition in general. Melancholy (or more precisely the 'black bile', from which melancholy derives its name) was regarded as one of the four temperaments matching the four humours. Until the 18th century, doctors and other scholars classified melancholic conditions as such by their perceived common cause – an excess of a notional fluid known as \"black bile\", which was commonly linked to the spleen. Hippocrates and other ancient physicians described melancholia as a distinct disease with mental and physical symptoms, including persistent fears and despondencies, poor appetite, abulia, sleeplessness, irritability, and agitation. Later, fixed delusions were added by Galen and other physicians to the list of symptoms."}, "cross_references": [{"found_name": "humoral theory", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 64, "target_cluster_name": "humoral theory", "source_book": "llm_generated", "evidence_snippet": "Melancholy is a concept deeply embedded within the framework of humoral theory, which posited that bodily and mental states were determined by the balance of four humors, including black bile.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Melancholy is a concept deeply embedded within the framework of humoral theory, which posited that bodily and mental states were determined by the balance of four humors, including black bile."}, {"found_name": "cold humors", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 785, "target_cluster_name": "humores frios", "source_book": "llm_generated", "evidence_snippet": "Melancholy was often associated with cold and dry humors, particularly black bile, and its symptoms were understood through this lens.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Melancholy was often associated with cold and dry humors, particularly black bile, and its symptoms were understood through this lens."}, {"found_name": "coldness", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 664, "target_cluster_name": "friealdade", "source_book": "llm_generated", "evidence_snippet": "The symptoms of melancholy were often described in terms of coldness, both physically and emotionally, aligning with the humoral understanding of the condition.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The symptoms of melancholy were often described in terms of coldness, both physically and emotionally, aligning with the humoral understanding of the condition."}, {"found_name": "choleric", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2858, "target_cluster_name": "cholericas", "source_book": "llm_generated", "evidence_snippet": "While distinct, choleric and melancholic temperaments were both part of the humoral system and represented different imbalances of humors (yellow bile vs. black bile).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "While distinct, choleric and melancholic temperaments were both part of the humoral system and represented different imbalances of humors (yellow bile vs. black bile)."}, {"found_name": "Astrological Influence", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3953, "target_cluster_name": "Infortune", "source_book": "llm_generated", "evidence_snippet": "In premodern thought, astrological influences were often considered significant factors in the causation of diseases and temperaments, including melancholy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "In premodern thought, astrological influences were often considered significant factors in the causation of diseases and temperaments, including melancholy."}]}, {"canonical_name": "Trincavelus", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "trimegisto", "book_id": "historia_medicinal_monardes_1574", "name": "Trimegisto", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Trimegisto", "Trimegis"], "contexts": ["attributed earth as mother of metals", "figure associated with principles and origin"]}, {"entity_id": "trincavelus", "book_id": "polyanthea_medicinal", "name": "Trincavelus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 15, "variants": ["Trincavelus", "Trincav", "Trincav.", "Trincavel.", "Trincavello", "Trincavelo"], "contexts": ["author of Consilia Medica", "cited in lib. 25"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Trimegisto", "target_book": "polyanthea_medicinal", "target_name": "Trincavelus", "similarity": 0.851}], "id": 1827, "stable_key": "clu_cf195465ce8e838a", "ground_truth": {"modern_name": "Trismegistus", "confidence": "high", "type": "person", "description": "Mythical alchemist and philosopher, attributed with Hermetic texts.", "note": "The name 'Trincavelus' appears to be a corruption or variation of 'Trismegistus'.", "wikidata_id": "Q192358", "wikidata_description": "purported author of the Hermetic Corpus"}, "cross_references": []}, {"canonical_name": "trigo", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "trigo", "book_id": "coloquios_da_orta_1563", "name": "trigo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["trigo"], "contexts": ["commodity transported", "cultivated crop"]}, {"entity_id": "pâo_de_trigo", "book_id": "coloquios_da_orta_1563", "name": "pâo de trigo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["pâo de trigo"], "contexts": ["bread not given to the sick"]}, {"entity_id": "trigo", "book_id": "polyanthea_medicinal", "name": "trigo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 11, "variants": ["trigo"], "contexts": ["ingredient in a preparation", "ingredient in a remedy"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "trigo", "target_book": "polyanthea_medicinal", "target_name": "trigo", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "pâo de trigo", "target_book": "polyanthea_medicinal", "target_name": "trigo", "similarity": 0.899}], "id": 1828, "stable_key": "clu_5d5c097138ead7ef", "ground_truth": {"modern_name": "Wheat", "confidence": "high", "type": "plant", "linnaean": "Triticum aestivum", "family": "Poaceae", "description": "Grain used in preparations, remedies, and for weight comparisons.", "note": "Includes 'triguo' and 'Tritico'.", "wikipedia_extract": "Common wheat (Triticum aestivum), also known as bread wheat, is a cultivated wheat species. About 95% of wheat produced worldwide is this species; it is the most widely planted of all crops by area (as of 2009) and the cereal with the highest monetary yield. Numerous forms of wheat have evolved under human selection. This diversity has led to confusion in the naming of wheats, with names based on both genetic and morphological characteristics. Bread wheat is an allohexaploid – a combination of six sets of chromosomes from different species. Of the six sets of chromosomes, four come from emmer (Triticum turgidum, itself a tetraploid) and two from Aegilops tauschii (a wild diploid goatgrass)."}, "cross_references": [{"found_name": "Barley", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1570, "target_cluster_name": "Cevada", "source_book": "llm_generated", "evidence_snippet": "Wheat and Barley are both major cereal grains, often cultivated and used for similar purposes (e.g., bread, flour).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Wheat and Barley are both major cereal grains, often cultivated and used for similar purposes (e.g., bread, flour)."}, {"found_name": "Barley flour", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 614, "target_cluster_name": "farinha de cevada", "source_book": "llm_generated", "evidence_snippet": "Barley flour is a direct derivative of Barley, a closely related cereal grain to Wheat. Historical texts often discuss these grains and their flours in conjunction.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Barley flour is a direct derivative of Barley, a closely related cereal grain to Wheat. Historical texts often discuss these grains and their flours in conjunction."}, {"found_name": "Grains", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2320, "target_cluster_name": "grãos", "source_book": "llm_generated", "evidence_snippet": "Wheat is a type of grain, making 'Grains' a direct supercategory that is relevant in historical contexts discussing agricultural products.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Wheat is a type of grain, making 'Grains' a direct supercategory that is relevant in historical contexts discussing agricultural products."}, {"found_name": "Flax", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 358, "target_cluster_name": "Folio", "source_book": "llm_generated", "evidence_snippet": "Flax is another important agricultural crop often discussed alongside cereal grains like wheat in historical texts concerning agriculture and food production.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Flax is another important agricultural crop often discussed alongside cereal grains like wheat in historical texts concerning agriculture and food production."}, {"found_name": "Rice", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1695, "target_cluster_name": "Arroz", "source_book": "llm_generated", "evidence_snippet": "Rice is a major cereal grain, and like wheat, it has been a staple food for large populations throughout history, leading to its frequent mention in similar contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Rice is a major cereal grain, and like wheat, it has been a staple food for large populations throughout history, leading to its frequent mention in similar contexts."}]}, {"canonical_name": "linho", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "linho", "book_id": "coloquios_da_orta_1563", "name": "linho", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["linho", "linho commum"], "contexts": ["commodity mentioned in relation to weights", "plant material found on the island"]}, {"entity_id": "linho", "book_id": "polyanthea_medicinal", "name": "linho", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 14, "variants": ["linho", "linho canhamo", "linhonovo"], "contexts": ["material for a linen cloth", "linen cloths used to absorb blood"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "linho", "target_book": "polyanthea_medicinal", "target_name": "linho", "similarity": 1.0}], "id": 1829, "stable_key": "clu_52f1f770f8fbcd3d", "ground_truth": {"modern_name": "Flax", "confidence": "high", "type": "plant", "linnaean": "Linum usitatissimum", "family": "Linaceae", "description": "A plant cultivated for its fiber (linen) and seeds (linseed).", "wikipedia_extract": "Flax, also known as common flax or linseed, is a flowering plant, Linum usitatissimum, in the family Linaceae. It is cultivated as a food and fiber crop in regions of the world with temperate climates. In 2022, France produced 75% of the world's supply of flax. Textiles made from flax are known in English as linen and are traditionally used for bed sheets, underclothes, and table linen. Its oil is known as linseed oil. In addition to referring to the plant, the word \"flax\" may refer to the unspun fibers of the flax plant."}, "cross_references": [{"found_name": "lino", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 3688, "target_cluster_name": "lino", "source_book": "llm_generated", "evidence_snippet": "Historical Portuguese name for Flax.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "reverse: Historical Portuguese name for Flax.", "is_reverse": true}, {"found_name": "linho do nosso", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "de linho alça- neve, que ha lá muito, e no Decam e em Bengala; e mais eu vi lá linho do nosso, de que fazemos as nossas camizas, e todo este linho e o linho alcanave he mercadoria que vem a nós das te", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for common flax, distinct from linho alcanave"}, {"found_name": "linho alça- neve", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "huma arvore muito grande ; e pêra falar comvosco a verdade também as fazem de linho alça- neve, que ha lá muito, e no Decam e em Bengala; e mais eu vi lá linho do nosso, de que fazemos as nossas camiz", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for linho alcanave"}, {"found_name": "alei", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "de linho alça- neve, que ha lá muito, e no Decam e em Bengala; e mais eu vi lá linho do nosso, de que fazemos as nossas camizas, e todo este linho e o linho alcanave he mercadoria que vem a nós das te", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "vernacular name for linho alcanave"}, {"found_name": "camizas", "link_type": "derivation", "link_strength": 0.4, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "de linho alça- neve, que ha lá muito, e no Decam e em Bengala; e mais eu vi lá linho do nosso, de que fazemos as nossas camizas, e todo este linho e o linho alcanave he mercadoria que vem a nós das te", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "made from linho do nosso"}, {"found_name": "bangue", "link_type": "derivation", "link_strength": 0.4, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "que fazemos as nossas camizas, e todo este linho e o linho alcanave he mercadoria que vem a nós das terras sobreditas (ao qual chamão alei): e porém o linho alcanave ha nesta terra firme e he pouco; e", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "related to linho alcanave (likely derived from it)"}]}, {"canonical_name": "Cidade", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "cidade", "book_id": "coloquios_da_orta_1563", "name": "cidade", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["cidade"], "contexts": ["location of the epidemic", "city"]}, {"entity_id": "cidade", "book_id": "polyanthea_medicinal", "name": "Cidade", "category": "PLACE", "subcategory": "CITY", "count": 15, "variants": ["Cidade", "Cidades"], "contexts": ["city where remedies are falsified", "city"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "cidade", "target_book": "polyanthea_medicinal", "target_name": "Cidade", "similarity": 0.945}], "id": 1830, "stable_key": "clu_ae939e21c0189a89", "ground_truth": {"modern_name": "city", "confidence": "high", "type": "place", "note": "This is a generic term. The specific city would depend on the context of the text.", "wikidata_id": "", "wikidata_description": "capital and most populous city in France"}, "cross_references": []}, {"canonical_name": "Coloquintida", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "coloquintida", "book_id": "ricettario_fiorentino_1597", "name": "Coloquintida", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["Coloquintida", "Colocynth'M", "Colocynthida", "Colocyntida", "Cploquintida", "Golocynthida"], "contexts": ["colocynth", "bitter gourd used in preparations"]}, {"entity_id": "coloquintidas", "book_id": "polyanthea_medicinal", "name": "coloquintidas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["coloquintidas", "Colocynthide", "Coloquintida", "Coloquintidas", "colocynthide", "coloquinti"], "contexts": ["ingredient in plaster", "plant used in remedies"]}, {"entity_id": "polpade_coloquintidas", "book_id": "polyanthea_medicinal", "name": "polpade coloquintidas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["polpade coloquintidas"], "contexts": ["colocynth pulp used in preparations"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Coloquintida", "target_book": "polyanthea_medicinal", "target_name": "coloquintidas", "similarity": 0.95}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Coloquintida", "target_book": "polyanthea_medicinal", "target_name": "polpade coloquintidas", "similarity": 0.89}], "id": 1831, "stable_key": "clu_e152a87d07fe476c", "ground_truth": {"modern_name": "Colocynth", "confidence": "high", "type": "plant", "linnaean": "Citrullus colocynthis", "family": "Cucurbitaceae", "description": "A bitter gourd plant used as an ingredient in medicinal preparations.", "note": "Includes singular and plural forms in Italian and English.", "wikipedia_extract": "Citrullus colocynthis, with many common names including colocynth, bitter apple, bitter cucumber, vine of Sodom, or wild gourd, is a poisonous desert viny plant native to the Mediterranean Basin and West Asia, especially the Levant, Turkey (especially in regions such as İzmir), and Nubia. It resembles a common watermelon vine but bears small, hard fruits with a bitter pulp. The plant contains cytotoxic cucurbitacins and is thus unsafe to use as an herbal medicine. It originally bore the scientific name Colocynthis citrullus. The vine ranges from 2.4–3 metres (8–10 feet) in length. The roots are large, fleshy, and perennial, leading to a high survival rate due to the long tap root."}, "cross_references": [{"found_name": "Colocynthis", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 3818, "target_cluster_name": "Colocynthis", "source_book": "llm_generated", "evidence_snippet": "Coloquintida is listed as a historical name for Colocynth.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: Coloquintida is listed as a historical name for Colocynth.", "is_reverse": true}, {"found_name": "frutas", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 72, "target_cluster_name": "frutas", "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "qualità csida óc fecca in terzo grado attribuitali dagl'Arabi . Però fi vii iUuo luccidanco. DELL'ELATERIO. L*E L A T E R I o é il fugo canato del frutto del cocomero faluatico detto afinino piata not", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "reverse: synonym for cocomero faluatico", "is_reverse": true}]}, {"canonical_name": "glandulas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 25, "members": [{"entity_id": "glandulas", "book_id": "polyanthea_medicinal", "name": "glandulas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 16, "variants": ["glandulas"], "contexts": ["glands in the intestines", "glands"]}, {"entity_id": "glandular_organs", "book_id": "first_principles_spencer_1862", "name": "glandular organs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["glandular organs"], "contexts": ["organs producing secretions"]}, {"entity_id": "glands", "book_id": "principles_of_psychology_james_1890", "name": "glands", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["glands"], "contexts": ["organs producing secretions", "body parts producing feelings"]}, {"entity_id": "mammary_glands", "book_id": "first_principles_spencer_1862", "name": "mammary glands", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["mammary glands"], "contexts": ["glands producing milk in mammals"]}, {"entity_id": "glands", "book_id": "origin_of_species_darwin_1859", "name": "glands", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["glands"], "contexts": ["structures that excrete nectar"]}, {"entity_id": "gland", "book_id": "principles_of_psychology_james_1890", "name": "gland", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["gland"], "contexts": ["organ secreting substances"]}, {"entity_id": "glanduloſas", "book_id": "polyanthea_medicinal", "name": "glanduloſas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["glanduloſas"], "contexts": ["glandular body parts"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "glandulas", "target_book": "first_principles_spencer_1862", "target_name": "glandular organs", "similarity": 0.925}], "id": 1832, "stable_key": "clu_4e46e298577bb44d", "ground_truth": {"modern_name": "glands", "confidence": "high", "type": "concept", "wikidata_id": "Q9647", "wikidata_description": "type of animal organ", "wikipedia_url": "https://en.wikipedia.org/wiki/Gland", "wikipedia_extract": "A gland is a cell or an organ in an animal's body that produces and secretes different substances that the organism needs, either into the bloodstream or into a body cavity or outer surface. A gland may also function to remove unwanted substances such as urine from the body. There are two types of gland, each with a different method of secretion. Endocrine glands are ductless and secrete their products, hormones,  directly into interstitial spaces to be taken up into the bloodstream. Exocrine glands secrete their products through a duct into a body cavity or outer surface. Glands are mostly composed of epithelial tissue, and typically have a supporting framework of connective tissue, and a capsule."}, "member_count": 7, "cross_references": [{"found_name": "Liver", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 51, "target_cluster_name": "Liver", "source_book": "llm_generated", "evidence_snippet": "The liver is a gland.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The liver is a gland."}]}, {"canonical_name": "nutation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "nutation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "nutation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 15, "variants": ["nutation", "Nutation"], "contexts": ["wobble in orbital axis", "slight irregularity in Earth's precession"]}, {"entity_id": "nutation", "book_id": "first_principles_spencer_1862", "name": "nutation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["nutation"], "contexts": ["wobble in Earth's axial tilt", "wobbling motion of Earth's axis"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "nutation", "target_book": "first_principles_spencer_1862", "target_name": "nutation", "similarity": 1.0}], "id": 1833, "stable_key": "clu_1ffde4b8d93348d4", "ground_truth": {"modern_name": "Nutation", "confidence": "high", "type": "concept", "note": "The 'wobble in Earth's axial tilt' is a specific astronomical phenomenon.", "wikidata_id": "Q190009", "wikidata_description": "type of motion in astronomy. A component of the rotating motion of a planet under the influence of gravitational pull by moons, other planets or the central star", "wikipedia_url": "https://en.wikipedia.org/wiki/Astronomical_nutation", "wikipedia_extract": "Honda has produced the following cars, SUVs, and light trucks. During the late 1980s and early 1990s, Honda collaborated with Rover in the development and marketing of the Honda Concerto, Rover 200, 400, 600 and 800. The 800 was called the Sterling in the US. Honda partnered with Isuzu in the 1990s to produce the Passport and the Acura SLX."}, "cross_references": [{"found_name": "Aphelion", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 864, "target_cluster_name": "Aphelion", "source_book": "llm_generated", "evidence_snippet": "Nutation is a slow, conical movement of the Earth's axis, which is related to the Earth's orbital motion around the Sun, and thus to its aphelion (the point in its orbit farthest from the Sun).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Nutation is a slow, conical movement of the Earth's axis, which is related to the Earth's orbital motion around the Sun, and thus to its aphelion (the point in its orbit farthest from the Sun)."}, {"found_name": "Ecliptic", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1541, "target_cluster_name": "ecliptic", "source_book": "llm_generated", "evidence_snippet": "Nutation is a perturbation of the Earth's axis that causes it to wobble around the pole of the ecliptic, the plane of Earth's orbit.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Nutation is a perturbation of the Earth's axis that causes it to wobble around the pole of the ecliptic, the plane of Earth's orbit."}, {"found_name": "Elliptical orbit", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2341, "target_cluster_name": "elliptical orbit", "source_book": "llm_generated", "evidence_snippet": "Nutation is a phenomenon related to the Earth's orbital motion, which is an elliptical orbit around the Sun.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Nutation is a phenomenon related to the Earth's orbital motion, which is an elliptical orbit around the Sun."}, {"found_name": "Oscillations", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 372, "target_cluster_name": "Oscillations", "source_book": "first_principles_spencer_1862", "evidence_snippet": "velocity. Then, too, there is the revolution of the line of apsides, which in course of time moves round the heavens—not regularly, but through complex oscillations. And further we have variations in ", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "reverse: type of variation in planetary axes", "is_reverse": true}]}, {"canonical_name": "Undulations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "undulations", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Undulations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 12, "variants": ["undulations", "Undulations"], "contexts": ["interference of waves", "wave-like movements"]}, {"entity_id": "undulation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "undulation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["undulation"], "contexts": ["wave-like motion", "wave-like motion of light"]}, {"entity_id": "undulations", "book_id": "first_principles_spencer_1862", "name": "undulations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["undulations"], "contexts": ["wave-like movements of particles", "caused by rising fish, die away on water surface"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Undulations", "target_book": "first_principles_spencer_1862", "target_name": "undulations", "similarity": 0.955}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "undulation", "target_book": "first_principles_spencer_1862", "target_name": "undulations", "similarity": 0.916}], "id": 1834, "stable_key": "clu_d1cb2af2279ee9cf", "ground_truth": {"modern_name": "wave motion", "confidence": "high", "type": "concept", "wikidata_id": "Q26008", "wikidata_description": "peer-reviewed scientific journal"}, "cross_references": []}, {"canonical_name": "Feavers", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 4, "total_mentions": 28, "members": [{"entity_id": "feavers", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Feavers", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["Feavers"], "contexts": ["medical condition"]}, {"entity_id": "feavers", "book_id": "english_physician_1652", "name": "Feavers", "category": "DISEASE", "subcategory": "ACUTE", "count": 15, "variants": ["Feavers", "Feaver", "Fever", "feavers"], "contexts": ["condition treated with barley preparations", "hot distempers of the body"]}, {"entity_id": "calentura", "book_id": "historia_medicinal_monardes_1574", "name": "calentura", "category": "DISEASE", "subcategory": "ACUTE", "count": 9, "variants": ["calentura", "Calentura", "calenturas cotidianas", "calenturas lentas", "calenturilla"], "contexts": ["fever that afflicted the lady", "fever that stones are used to alleviate"]}, {"entity_id": "calore_febrili", "book_id": "polyanthea_medicinal", "name": "calore febrili", "category": "DISEASE", "subcategory": "ACUTE", "count": 3, "variants": ["calore febrili", "calorem febritem", "flammam febrilem"], "contexts": ["feverish heat", "fever heat"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Feavers", "target_book": "english_physician_1652", "target_name": "Feavers", "similarity": 1.0}], "id": 1835, "stable_key": "clu_3c8f0a63aec96103", "ground_truth": {"modern_name": "Fever", "confidence": "high", "type": "disease", "modern_term": "Fever", "wikidata_id": "Q38933", "wikidata_description": "common medical sign characterized by elevated body temperature", "wikipedia_url": "https://en.wikipedia.org/wiki/Fever", "wikipedia_extract": "Fever or pyrexia in humans is a symptom of an anti-infection defense mechanism that appears with body temperature exceeding the normal range caused by an increase in the body's temperature set point in the hypothalamus. There is no single agreed-upon upper limit for normal temperature: sources use values ranging between 37.2 and 38.3 °C (99.0 and 100.9 °F) in humans. The increase in set point triggers increased muscle contractions and causes a feeling of cold or chills. This results in greater heat production and efforts to conserve heat. When the set point temperature returns to normal, a person feels hot, becomes flushed, and may begin to sweat. Rarely a fever may trigger a febrile seizure, with this being more common in young children."}, "member_count": 4, "cross_references": []}, {"canonical_name": "Bark", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "bark", "book_id": "english_physician_1652", "name": "Bark", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 15, "variants": ["Bark", "Barke", "Barks"], "contexts": ["part of the plant used medicinally", "part of the Alder-Tree used medicinally"]}, {"entity_id": "bark", "book_id": "kosmos_humboldt_1845", "name": "bark", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["bark"], "contexts": ["outer layer of a tree trunk"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Bark", "target_book": "kosmos_humboldt_1845", "target_name": "bark", "similarity": 0.993}], "id": 1836, "stable_key": "clu_afdfaa85f58d4c0c", "ground_truth": {"modern_name": "Bark", "confidence": "high", "type": "plant", "note": "Refers to the outer layer of a tree, often used medicinally.", "wikidata_id": "Q184453", "wikidata_description": "plant tissue outside the vascular cambium or the xylem; in older trees may be divided into dead outer bark and living inner bark, which consists of secondary phloem. external parenchymal tissue, located just below the epidermis of the stem"}, "cross_references": [{"found_name": "Tree", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 24, "target_cluster_name": "Tree", "source_book": "llm_generated", "evidence_snippet": "Bark is a component of a tree.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Bark is a component of a tree.", "is_reverse": true}, {"found_name": "Folio", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 358, "target_cluster_name": "Folio", "source_book": "llm_generated", "evidence_snippet": "Bark is 