tronomy"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "mathematical and physical sciences", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "mathematical and mechanical science", "similarity": 0.94}], "id": 3593, "stable_key": "clu_a20377f43a08b399", "ground_truth": {"modern_name": "Mathematical and physical sciences", "confidence": "high", "type": "concept", "wikidata_id": "Q17549772", "wikidata_description": "architectural structure in Brighton and Hove, East Sussex, England, UK"}, "cross_references": []}, {"canonical_name": "M. Bouvard", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "m__bouvard", "book_id": "kosmos_humboldt_1845", "name": "M. Bouvard", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["M. Bouvard"], "contexts": ["paved way for Neptune's discovery", "corrected astronomical calculations"]}, {"entity_id": "m__bouvard", "book_id": "connexion_physical_sciences_somerville_1858", "name": "M. Bouvard", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["M. Bouvard"], "contexts": ["scientist who studied atmospheric oscillations"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "M. Bouvard", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "M. Bouvard", "similarity": 1.0}], "id": 3594, "stable_key": "clu_1cbe44f9e7f2fab8", "ground_truth": {"modern_name": "Alexis Bouvard", "confidence": "high", "type": "person", "birth_year": 1767, "death_year": 1843, "description": "French astronomer, calculated planetary tables, aided Neptune discovery.", "wikidata_id": "Q318601", "wikidata_description": "French astronomer (1767-1843)", "wikipedia_url": "https://en.wikipedia.org/wiki/Alexis%20Bouvard", "wikipedia_extract": "Alexis Bouvard (French pronunciation: [alɛksi buvaʁ], 27 June 1767 – 7 June 1843) was a French astronomer. He is particularly noted for his careful observations of the irregularities in the motion of Uranus and his hypothesis of the existence of an eighth planet in the Solar System. Born in Contamines, Duchy of Savoy, Bouvard's achievements included the discovery of eight comets and the compilation of astronomical tables of Jupiter, Saturn and Uranus. While the former two tables were eminently successful, the latter showed substantial discrepancies with subsequent observations. This led Bouvard to hypothesise the existence of an eighth planet responsible for the irregularities in Uranus' orbit. The position of Neptune was subsequently calculated from Bouvard's observations by Urbain Le Verrier after his death."}, "cross_references": [{"found_name": "Encke", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 659, "target_cluster_name": "Encke", "source_book": "llm_generated", "evidence_snippet": "Alexis Bouvard was a French astronomer who worked on calculating planetary tables, a field related to Encke's work on comets and asteroids and measuring the Earth-Sun distance.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Alexis Bouvard was a French astronomer who worked on calculating planetary tables, a field related to Encke's work on comets and asteroids and measuring the Earth-Sun distance.", "is_reverse": true}, {"found_name": "Cassini", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1081, "target_cluster_name": "Cassini", "source_book": "llm_generated", "evidence_snippet": "Both were astronomers working in France during the same period, and Cassini was director of the Paris Observatory where Bouvard also worked.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were astronomers working in France during the same period, and Cassini was director of the Paris Observatory where Bouvard also worked.", "is_reverse": true}, {"found_name": "Mayer", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1156, "target_cluster_name": "Mayer", "source_book": "llm_generated", "evidence_snippet": "Both were astronomers who studied the Moon.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were astronomers who studied the Moon.", "is_reverse": true}, {"found_name": "Messier", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2002, "target_cluster_name": "Messier", "source_book": "llm_generated", "evidence_snippet": "Alexis Bouvard was a French astronomer who worked with Charles Messier and was involved in astronomical calculations and observations.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Alexis Bouvard was a French astronomer who worked with Charles Messier and was involved in astronomical calculations and observations.", "is_reverse": true}, {"found_name": "Godin", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2290, "target_cluster_name": "Godin", "source_book": "llm_generated", "evidence_snippet": "Both were French astronomers who worked at the Paris Observatory and were members of the French Academy of Sciences.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were French astronomers who worked at the Paris Observatory and were members of the French Academy of Sciences.", "is_reverse": true}]}, {"canonical_name": "Vico", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "vico", "book_id": "kosmos_humboldt_1845", "name": "Vico", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Vico"], "contexts": ["saw satellites at Rome", "author on satellites of Saturn"]}, {"entity_id": "vico", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Vico", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Vico"], "contexts": ["astronomer who discovered a comet"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Vico", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Vico", "similarity": 1.0}], "id": 3595, "stable_key": "clu_caa7269703152654", "ground_truth": {"modern_name": "Angelo Secchi", "confidence": "medium", "type": "person", "birth_year": 1818, "death_year": 1878, "description": "Italian Jesuit astronomer, director of Vatican Observatory, studied solar and stellar spectra.", "note": "The context 'saw satellites at Rome' and 'astronomer who discovered a comet' strongly points to Secchi, especially given the 'Vico' in the original text might be a misreading or alternative name associated with his observations or publications. However, 'Vico' itself is an unrelated philosopher. The texts mention 'Vico' twice, which could indicate a misprint of a different astronomer or a reference to a publication by Vico discussing astronomical observations, though unlikely. Angelo Secchi is a much stronger candidate for astronomical observations and discoveries in Rome during the period. Without further context to definitively link 'Vico' to a comet discovery, Secchi is the best fit for the astronomical activity described.", "wikidata_id": "Q312416", "wikidata_description": "Italian astronomer", "wikipedia_url": "https://en.wikipedia.org/wiki/Angelo%20Secchi", "wikipedia_extract": "Angelo Secchi  (Italian pronunciation: [ˈandʒelo ˈsekki]; 28 June 1818 – 26 February 1878) was an Italian Catholic priest and astronomer from the Italian region of Emilia. He was director of the observatory at the Pontifical Gregorian University (then called the Roman College) for 28 years. He was a pioneer in astronomical spectroscopy, and was one of the first scientists to state authoritatively that the Sun is a star. Secchi was born in Reggio Emilia, where he studied at the Jesuit gymnasium. At the age of 16, he entered the Jesuit Order in Rome. He continued his studies at the Roman College, and demonstrated great scientific ability."}, "cross_references": []}, {"canonical_name": "Valz", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "valz", "book_id": "kosmos_humboldt_1845", "name": "Valz", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Valz"], "contexts": ["astronomer who noticed comet changes", "author on the comet of 1618"]}, {"entity_id": "valz", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Valz", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Valz"], "contexts": ["astronomer who observed comet light"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Valz", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Valz", "similarity": 1.0}], "id": 3596, "stable_key": "clu_ed0afce53f1f2c10", "ground_truth": {"modern_name": "Camille Flammarion", "confidence": "medium", "type": "person", "birth_year": 1842, "death_year": 1925, "description": "French astronomer and author, known for popularizing astronomy and comet studies.", "note": "The name 'Valz' (likely Giovanni Battista Valz) is a known astronomer, but the descriptions 'astronomer who noticed comet changes' and 'astronomer who observed comet light' align better with the popularizing astronomical work of Camille Flammarion, who was active in the later part of the 19th century and extensively wrote about comets. Giovanni Battista Valz was active earlier and his primary contributions were orbital calculations. Given the context of Humboldt's 'Kosmos' and Somerville's works which were published or widely read in the mid-to-late 19th century, Flammarion is a more likely referent for a person discussed in such a context for popularizing comet observations.", "wikidata_id": "Q295524", "wikidata_description": "French astronomer and author (1842–1925)"}, "cross_references": [{"found_name": "Messier", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2002, "target_cluster_name": "Messier", "source_book": "llm_generated", "evidence_snippet": "Camille Flammarion was a prominent French astronomer and popularizer of astronomy, a field in which Messier was a key figure.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Camille Flammarion was a prominent French astronomer and popularizer of astronomy, a field in which Messier was a key figure.", "is_reverse": true}]}, {"canonical_name": "Euripides", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "euripides", "book_id": "kosmos_humboldt_1845", "name": "Euripides", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Euripides"], "contexts": ["ancient Greek playwright"]}, {"entity_id": "euripedes", "book_id": "polyanthea_medicinal", "name": "Euripedes", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Euripedes"], "contexts": ["ancient Greek physician"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Euripides", "target_book": "polyanthea_medicinal", "target_name": "Euripedes", "similarity": 0.878}], "id": 3597, "stable_key": "clu_b89d3ae19214f95e", "ground_truth": {"modern_name": "Euripides", "confidence": "high", "type": "person", "birth_year": -480, "death_year": -406, "description": "Ancient Greek tragedian, sometimes misattributed as a physician.", "note": "While primarily known as a playwright, the context 'ancient Greek physician' suggests a potential conflation or erroneous reference in some texts.", "wikidata_id": "Q48305", "wikidata_description": "Classical Athenian playwright", "wikipedia_url": "https://en.wikipedia.org/wiki/Euripides", "wikipedia_extract": "Euripides (; Ancient Greek: Eὐριπίδης, romanized: Eurīpídēs, pronounced [eu̯.riː.pí.dɛːs]; c. 480 – c. 406 BC) was a Greek tragedian of classical Athens. Along with Aeschylus and Sophocles, he is one of the three authors of Greek tragedy for whom any plays have survived in full. Some ancient scholars attributed ninety-five plays to him, but the Suda says it was ninety-two at most. Nineteen plays attributed to Euripides have survived more or less complete, although one of these (Rhesus) is often considered not to be genuinely his work."}, "cross_references": []}, {"canonical_name": "Palmer", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "palmer", "book_id": "kosmos_humboldt_1845", "name": "Palmer", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Palmer"], "contexts": ["observed shooting stars in North America", "reported on shooting stars in New Haven"]}, {"entity_id": "palmario", "book_id": "polyanthea_medicinal", "name": "Palmario", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Palmario"], "contexts": ["referenced for his arguments"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Palmer", "target_book": "polyanthea_medicinal", "target_name": "Palmario", "similarity": 0.88}], "id": 3598, "stable_key": "clu_4b22dc81f9c15fad", "ground_truth": {"modern_name": "John Palmer", "confidence": "medium", "type": "person", "description": "Observer of shooting stars in North America", "note": "Multiple individuals named John Palmer existed. The context suggests a natural philosopher or astronomer.", "wikidata_id": "Q102361828", "wikidata_description": "English priest, chaplain to Elizabeth I, and archdeacon of Ely (died 1614)"}, "cross_references": []}, {"canonical_name": "Cygni", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "cygni", "book_id": "kosmos_humboldt_1845", "name": "Cygni", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Cygni"], "contexts": ["star", "constellation Cygnus"]}, {"entity_id": "α_cygni", "book_id": "connexion_physical_sciences_somerville_1858", "name": "α Cygni", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["α Cygni"], "contexts": ["second magnitude star"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Cygni", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "α Cygni", "similarity": 0.865}], "id": 3599, "stable_key": "clu_2e5b5e3ef3ff6723", "ground_truth": {"modern_name": "Deneb", "confidence": "high", "type": "place", "country": "Unknown", "wikidata_id": "Q3022426", "wikidata_description": "genus of mammals (fossil)", "wikipedia_url": "https://en.wikipedia.org/wiki/Denebola%20%28mammal%29"}, "cross_references": []}, {"canonical_name": "Dunkirk", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "dunkirk", "book_id": "kosmos_humboldt_1845", "name": "Dunkirk", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Dunkirk"], "contexts": ["location of pendulum observations", "location for hemisphere comparison"]}, {"entity_id": "dunkirk", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Dunkirk", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Dunkirk"], "contexts": ["northern French city"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Dunkirk", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Dunkirk", "similarity": 1.0}], "id": 3600, "stable_key": "clu_9cbafe6044cef123", "ground_truth": {"modern_name": "Dunkirk", "confidence": "high", "type": "place", "country": "France", "wikipedia_extract": "Dunkirk (UK:  dun-KURK; US:  DUN-kurk; French: Dunkerque [dœ̃kɛʁk] ; Picard: Dunkèke; West Flemish: Duunkerke; Dutch: Duinkerke or Duinkerken) is a major port city in the department of Nord in northern France. It lies on the North Sea, 10 kilometres (6.2 mi) from the Belgian border. It has the third-largest French harbour. The population of the commune in 2019 was 86,279. The name of Dunkirk derives from West Flemish dun(e) 'dune' or 'dun' and kerke 'church', thus 'church in the dunes'. A smaller town 25 km (15 miles) farther up the Flemish coast originally shared the same name, but it was later renamed Oostduinkerke ('East Dunkirk') in order to avoid confusion.", "wikipedia_url": "https://en.wikipedia.org/wiki/Dunkirk"}, "cross_references": [{"found_name": "Dieppe", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2559, "target_cluster_name": "Dieppe", "source_book": "llm_generated", "evidence_snippet": "Dieppe and Dunkirk are both significant port cities in northern France, historically important for maritime trade and naval activities.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Dieppe and Dunkirk are both significant port cities in northern France, historically important for maritime trade and naval activities.", "is_reverse": true}]}, {"canonical_name": "New Guinea", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "new_guinea", "book_id": "kosmos_humboldt_1845", "name": "New Guinea", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["New Guinea"], "contexts": ["highland near Rawak", "island near Rawak"]}, {"entity_id": "new_guinea", "book_id": "first_principles_spencer_1862", "name": "New Guinea", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["New Guinea"], "contexts": ["island in Oceania"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "New Guinea", "target_book": "first_principles_spencer_1862", "target_name": "New Guinea", "similarity": 0.873}], "id": 3601, "stable_key": "clu_e9f1de9488400d85", "ground_truth": {"modern_name": "New Guinea", "confidence": "high", "type": "place", "country": "Indonesia, Papua New Guinea", "wikidata_id": "Q504839", "wikidata_description": "species of reptile"}, "cross_references": []}, {"canonical_name": "molten masses", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "molten_masses", "book_id": "kosmos_humboldt_1845", "name": "molten masses", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["molten masses"], "contexts": ["liquefied rock from Earth's interior", "liquefied rock"]}, {"entity_id": "molten_matter", "book_id": "first_principles_spencer_1862", "name": "molten matter", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["molten matter"], "contexts": ["matter in a liquid state due to heat"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "molten masses", "target_book": "first_principles_spencer_1862", "target_name": "molten matter", "similarity": 0.937}], "id": 3602, "stable_key": "clu_92eb7d38531337ca", "ground_truth": {"modern_name": "Molten rock", "confidence": "high", "type": "mineral", "wikidata_id": "Q59092322", "wikidata_description": "scientific article published in Nature"}, "cross_references": []}, {"canonical_name": "Magnet. der Erde", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "magnet__der_erde", "book_id": "kosmos_humboldt_1845", "name": "Magnet. der Erde", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Magnet. der Erde"], "contexts": ["book on Earth's magnetism", "publication on Earth's magnetism"]}, {"entity_id": "earth’s_magnetism", "book_id": "connexion_physical_sciences_somerville_1858", "name": "earth’s magnetism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["earth’s magnetism"], "contexts": ["magnetic field of the Earth"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Magnet. der Erde", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "earth’s magnetism", "similarity": 0.899}], "id": 3603, "stable_key": "clu_295175b775424351", "ground_truth": {"modern_name": "Earth's magnetic field", "confidence": "high", "type": "concept", "wikidata_id": "Q60703027", "wikidata_description": ""}, "cross_references": [{"found_name": "magnetism", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 241, "target_cluster_name": "magnetism", "source_book": "llm_generated", "evidence_snippet": "The Earth's magnetic field is a prominent manifestation of magnetism, and its study is intrinsically linked to the concept of magnetism itself.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Earth's magnetic field is a prominent manifestation of magnetism, and its study is intrinsically linked to the concept of magnetism itself.", "is_reverse": true}]}, {"canonical_name": "terrestrial phenomena", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "terrestrial_phenomena", "book_id": "kosmos_humboldt_1845", "name": "terrestrial phenomena", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["terrestrial phenomena"], "contexts": ["phenomena related to Earth", "phenomena occurring on Earth"]}, {"entity_id": "terrestrial_phenomena", "book_id": "connexion_physical_sciences_somerville_1858", "name": "terrestrial phenomena", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["terrestrial phenomena"], "contexts": ["phenomena occurring on Earth"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "terrestrial phenomena", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "terrestrial phenomena", "similarity": 1.0}], "id": 3604, "stable_key": "clu_fa49f3bda28df868", "ground_truth": {"modern_name": "terrestrial phenomena", "confidence": "high", "type": "concept"}, "cross_references": []}, {"canonical_name": "cirrous clouds", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "cirrous_clouds", "book_id": "kosmos_humboldt_1845", "name": "cirrous clouds", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["cirrous clouds"], "contexts": ["delicate clouds associated with aurora", "type of cloud"]}, {"entity_id": "luminous_clouds", "book_id": "connexion_physical_sciences_somerville_1858", "name": "luminous clouds", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["luminous clouds"], "contexts": ["constitute photosphere"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "cirrous clouds", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "luminous clouds", "similarity": 0.888}], "id": 3605, "stable_key": "clu_0f2d4b5af98277d7", "ground_truth": {"modern_name": "cirrus clouds", "confidence": "medium", "type": "concept", "note": "The term 'luminous clouds' is less specific than 'cirrous clouds' and could refer to various atmospheric phenomena. However, in the context of aurora and photosphere, cirrus clouds are a plausible, though not definitive, interpretation of both."}, "cross_references": []}, {"canonical_name": "Pausanias", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "pausanias", "book_id": "kosmos_humboldt_1845", "name": "Pausanias", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Pausanias"], "contexts": ["ancient Greek writer", "ancient writer who described elevation"]}, {"entity_id": "pau(ania", "book_id": "ricettario_fiorentino_1597", "name": "Pau(ania", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Pau(ania"], "contexts": ["authority describing the Grana plant"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Pausanias", "target_book": "ricettario_fiorentino_1597", "target_name": "Pau(ania", "similarity": 0.86}], "id": 3606, "stable_key": "clu_ce3376554d93aa80", "ground_truth": {"modern_name": "Pausanias", "confidence": "high", "type": "person", "description": "Ancient Greek traveler and geographer, author of Description of Greece.", "wikidata_id": "Q433408", "wikidata_description": "5th century BC Agiad King of Sparta", "wikipedia_url": "https://en.wikipedia.org/wiki/Pausanias%20%28king%20of%20Sparta%29", "wikipedia_extract": "Pausanias (Ancient Greek: Παυσανίας) was the Agiad King of Sparta; the son of Pleistoanax. He ruled Sparta from 445 BC to 427 BC and again from 409 BC to 395 BC. He was the leader of the faction in Sparta that opposed the imperialist policy conducted by Lysander. Pausanias became king in 445 BC, when his father Pleistoanax was forced into exile because he made a peace settlement with Athens, which was deemed dishonourable in Sparta. Too young to reign, his uncle Cleomenes acted as regent. Pleistoanax then returned in 427 BC and resumed his reign."}, "cross_references": []}, {"canonical_name": "Kordofan", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "kordofan", "book_id": "kosmos_humboldt_1845", "name": "Kordofan", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Kordofan"], "contexts": ["region with volcanoes", "region where volcanoes are discussed"]}, {"entity_id": "kordofan", "book_id": "coloquios_da_orta_1563", "name": "Kordofan", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Kordofan"], "contexts": ["geographic location"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Kordofan", "target_book": "coloquios_da_orta_1563", "target_name": "Kordofan", "similarity": 1.0}], "id": 3607, "stable_key": "clu_ccac792ce4237a29", "ground_truth": {"modern_name": "Kordofan", "confidence": "high", "type": "place", "country": "Sudan", "wikidata_id": "Q2044659", "wikidata_description": "subspecies of mammal", "wikipedia_url": "https://en.wikipedia.org/wiki/Kordofan%20giraffe", "wikipedia_extract": "Kordofan (Arabic: كردفان Kurdufān) is a former province of central Sudan. In 1994 it was divided into three new federal states: North Kordofan, South Kordofan and West Kordofan. In August 2005, West Kordofan State was abolished and its territory divided between North and South Kordofan States, as part of the implementation of the Comprehensive Peace Agreement between the Government of Sudan and the Sudan People's Liberation Movement. West Kordofan was reestablished in July 2013. Kordofan covers an area of some 376,145 km2 (146,932 miles²), with an estimated population in 2000 of 3.6 million (3 million in 1983). It is largely an undulating plain, with the Nuba Mountains in the southeast quarter."}, "cross_references": []}, {"canonical_name": "Medina", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "medina", "book_id": "kosmos_humboldt_1845", "name": "Medina", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Medina"], "contexts": ["location of a volcano"]}, {"entity_id": "medina", "book_id": "coloquios_da_orta_1563", "name": "Medina", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Medina"], "contexts": ["city in Castella"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Medina", "target_book": "coloquios_da_orta_1563", "target_name": "Medina", "similarity": 0.891}], "id": 3608, "stable_key": "clu_0565d0538ed400c8", "ground_truth": {"wikipedia_extract": "Medina del Campo is a town and municipality of Spain located in the autonomous community of Castile and León. Part of the Province of Valladolid, it is the centre of a farming area. It lies on the banks of the Zapardiel river, in the central part of the Douro basin. Initially a Berber settlement, it was repopulated after 1085. By the 12th century the walled town had become a major population centre of the Kingdom of Castile, drawing large-scale trading operations. It was later granted right to hold its well-known free fairs, which attracted a notable presence of international dealers."}, "cross_references": []}, {"canonical_name": "detritus", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "detritus", "book_id": "kosmos_humboldt_1845", "name": "detritus", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["detritus"], "contexts": ["waste or debris from erosion", "exogenous mechanical deposit"]}, {"entity_id": "detritus", "book_id": "first_principles_spencer_1862", "name": "detritus", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["detritus"], "contexts": ["waste or debris from erosion"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "detritus", "target_book": "first_principles_spencer_1862", "target_name": "detritus", "similarity": 0.823}], "id": 3609, "stable_key": "clu_dd7098588875acf9", "ground_truth": {"modern_name": "Detritus", "confidence": "high", "type": "concept", "wikidata_id": "Q2750657", "wikidata_description": "animal that feeds on decomposing plant and animal parts as well as faeces", "wikipedia_url": "https://en.wikipedia.org/wiki/Detritivore", "wikipedia_extract": "Detritivores (also known as detrivores, detritophages, detritus feeders or detritus eaters) are heterotrophs that obtain nutrients by consuming detritus (decomposing plant and animal parts as well as feces). There are many kinds of invertebrates, vertebrates, and plants that eat detritus or carry out coprophagy. By doing so, all these detritivores contribute to decomposition and the nutrient cycles. Detritivores should be distinguished from other decomposers, such as many species of bacteria, fungi and protists, which are unable to ingest discrete lumps of matter. Instead, these other decomposers live by absorbing and metabolizing on a molecular scale (saprotrophic nutrition). The terms detritivore and decomposer are often used interchangeably, but they describe different organisms."}, "cross_references": [{"found_name": "squelettes", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1444, "target_cluster_name": "squelettes", "source_book": "llm_generated", "evidence_snippet": "Skeletal remains can be considered a form of detritus.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Skeletal remains can be considered a form of detritus.", "is_reverse": true}, {"found_name": "sediment", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2732, "target_cluster_name": "sediment", "source_book": "llm_generated", "evidence_snippet": "Detritus is composed of fragmented material, often forming sediment.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Detritus is composed of fragmented material, often forming sediment.", "is_reverse": true}]}, {"canonical_name": "Frederic Hoffman", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "frederic_hoffman", "book_id": "kosmos_humboldt_1845", "name": "Frederic Hoffman", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Frederic Hoffman"], "contexts": ["geologist, observed rock formation", "cited for rock formation"]}, {"entity_id": "fredericus_hoffmanus", "book_id": "polyanthea_medicinal", "name": "Fredericus Hoffmanus", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Fredericus Hoffmanus"], "contexts": ["author of Methodi medendi"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Frederic Hoffman", "target_book": "polyanthea_medicinal", "target_name": "Fredericus Hoffmanus", "similarity": 0.918}], "id": 3610, "stable_key": "clu_303f84036cbdbd12", "ground_truth": {"modern_name": "Friedrich Hoffmann", "confidence": "high", "type": "person", "birth_year": 1660, "death_year": 1742, "description": "German physician and chemist, influential medical theorist and practitioner.", "wikidata_id": "Q76607", "wikidata_description": "German physician and chemist (1660–1742)", "wikipedia_url": "https://en.wikipedia.org/wiki/Friedrich%20Hoffmann", "wikipedia_extract": "Friedrich Hoffmann or Hofmann (19 February 1660 – 12 November 1742) was a German physician and chemist. He is also sometimes known in English as Frederick Hoffmann. His family had been connected with medicine for 200 years before him. Born in Halle, he attended the local gymnasium where he acquired that taste for and skill in mathematics to which he attributed much of his later success. Beginning at age 18, he studied medicine at the University of Jena. From there, in 1680, he went to Erfurt, to attend Kasper Cramer's lectures on chemistry."}, "cross_references": [{"found_name": "Hartmanus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1581, "target_cluster_name": "Hartmanus", "source_book": "llm_generated", "evidence_snippet": "Friedrich Hoffmann was a contemporary physician and chemist who, like Stahl, was a prominent figure in German medical and scientific circles during the late 17th and early 18th centuries. Hoffmann's work on the 'animal spirit' and his development of 'Hoffmann's drops' are significant in the history of medicine and chemistry, areas where Stahl also made substantial contributions.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Friedrich Hoffmann was a contemporary physician and chemist who, like Stahl, was a prominent figure in German medical and scientific circles during the late 17th and early 18th centuries. Hoffmann's work on the 'animal spirit' and his development of 'Hoffmann's drops' are significant in the history of medicine and chemistry, areas where Stahl also made substantial contributions.", "is_reverse": true}, {"found_name": "Hoffmann", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2416, "target_cluster_name": "Hoffmann", "source_book": "llm_generated", "evidence_snippet": "Friedrich Hoffmann was the father of August Wilhelm Hoffmann and a prominent physician and encyclopedist. August Wilhelm Hoffmann followed in his father's footsteps, becoming a renowned chemist and pharmacologist, and his work often built upon or referenced his father's legacy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Friedrich Hoffmann was the father of August Wilhelm Hoffmann and a prominent physician and encyclopedist. August Wilhelm Hoffmann followed in his father's footsteps, becoming a renowned chemist and pharmacologist, and his work often built upon or referenced his father's legacy.", "is_reverse": true}]}, {"canonical_name": "Roman", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "roman", "book_id": "kosmos_humboldt_1845", "name": "Roman", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Roman"], "contexts": ["referring to ancient adage", "writers who used the word 'cosmos'"]}, {"entity_id": "romans", "book_id": "first_principles_spencer_1862", "name": "Romans", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Romans"], "contexts": ["people with sacred dances"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Roman", "target_book": "first_principles_spencer_1862", "target_name": "Romans", "similarity": 0.978}], "id": 3611, "stable_key": "clu_3f91b6c0a2714fdc", "ground_truth": {"modern_name": "Roman", "confidence": "high", "type": "concept", "note": "The context 'referring to ancient adage' strongly suggests a reference to ancient Roman culture or history.", "wikidata_id": "Q1747689", "wikidata_description": "country that began growing on the Italian Peninsula from the 8th century BC"}, "cross_references": []}, {"canonical_name": "strata of air", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "strata_of_air", "book_id": "kosmos_humboldt_1845", "name": "strata of air", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["strata of air"], "contexts": ["layers of the atmosphere"]}, {"entity_id": "stratum_of_air", "book_id": "connexion_physical_sciences_somerville_1858", "name": "stratum of air", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["stratum of air"], "contexts": ["layers of air affected by storms"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "strata of air", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "stratum of air", "similarity": 0.982}], "id": 3612, "stable_key": "clu_fdc03e3adccca72e", "ground_truth": {"modern_name": "Atmospheric layers", "confidence": "high", "type": "concept"}, "cross_references": [{"found_name": "atmospheric", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4409, "target_cluster_name": "atmospheric", "source_book": "llm_generated", "evidence_snippet": "Atmospheric layers are structural components of the atmosphere, representing a more detailed breakdown of the entity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Atmospheric layers are structural components of the atmosphere, representing a more detailed breakdown of the entity.", "is_reverse": true}]}, {"canonical_name": "fogs", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "fogs", "book_id": "kosmos_humboldt_1845", "name": "fogs", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["fogs"], "contexts": ["visible atmospheric moisture", "weather phenomenon"]}, {"entity_id": "fogs", "book_id": "connexion_physical_sciences_somerville_1858", "name": "fogs", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["fogs"], "contexts": ["cloud at ground level"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "fogs", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "fogs", "similarity": 1.0}], "id": 3613, "stable_key": "clu_0b9775ae4a20aa21", "ground_truth": {"modern_name": "Fog", "confidence": "high", "type": "concept", "note": "The entry lists 'fogs' as a disease. This is likely a metaphorical or erroneous categorization, with 'fog' itself being the referent.", "wikidata_id": "Q1431308", "wikidata_description": "airport serving Foggia, Italy", "wikipedia_extract": "Fog is a visible aerosol consisting of tiny water droplets or ice crystals held in the air  near the Earth's surface. Fog can be considered a type of low-lying cloud usually resembling stratus and is heavily influenced by nearby bodies of water, topography, and wind conditions. In turn, fog affects many human activities, such as shipping, travel, and warfare. Fog appears when water vapor (water in its gaseous form) condenses. During condensation, molecules of water vapor combine to make tiny water droplets that hang in the air. Sea fog, which shows up near bodies of saline water, is formed as water vapor condenses on bits of salt.", "wikipedia_url": "https://en.wikipedia.org/wiki/Fog"}, "cross_references": []}, {"canonical_name": "Colladon", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "colladon", "book_id": "kosmos_humboldt_1845", "name": "Colladon", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Colladon"], "contexts": ["proposed electro-magnetic apparatus", "developed electro-magnetic apparatus"]}, {"entity_id": "colladon", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Colladon", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Colladon"], "contexts": ["experimenter on sound transmission in water"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Colladon", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Colladon", "similarity": 1.0}], "id": 3614, "stable_key": "clu_a37b94c6714fd2a1", "ground_truth": {"modern_name": "Daniel Colladon", "confidence": "high", "type": "person", "birth_year": 1802, "death_year": 1893, "description": "Swiss physicist who measured the speed of sound in water.", "wikidata_id": "Q108840410", "wikidata_description": ""}, "cross_references": []}, {"canonical_name": "Clark", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 1, "total_mentions": 2, "members": [{"entity_id": "clark", "book_id": "kosmos_humboldt_1845", "name": "Clark", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Clark"], "contexts": ["performed experiments at Dublin", "experiments on atmospheric electricity"]}], "edges": [], "id": 3615, "stable_key": "clu_8952d86b669c750b", "ground_truth": {"modern_name": "John Clarke", "confidence": "medium", "type": "person", "birth_year": 1700, "death_year": 1771, "description": "Irish physician and chemist, known for his work on gout.", "note": "There are multiple notable individuals named 'Clark' or 'Clarke' in the early modern period. The context of performing experiments in Dublin and identifying plants suggests a natural philosopher or physician. John Clarke (1700-1771) fits this profile and is a plausible candidate. Further textual evidence would be needed for definitive identification."}, "cross_references": []}, {"canonical_name": "glacial sea", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "glacial_sea", "book_id": "kosmos_humboldt_1845", "name": "glacial sea", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["glacial sea"], "contexts": ["vast area swept by ice during an epoch", "sea during the glacial epoch"]}, {"entity_id": "glacial_sea", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Glacial Sea", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Glacial Sea"], "contexts": ["northern boundary of Russian arc"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "glacial sea", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Glacial Sea", "similarity": 0.931}], "id": 3616, "stable_key": "clu_9700c3183278ecea", "ground_truth": {"modern_name": "Glacial Sea", "confidence": "high", "type": "place", "country": "Global", "wikidata_id": "Q788", "wikidata_description": "smallest, shallowest, coldest, and northernmost of the world's major oceans", "wikipedia_url": "https://en.wikipedia.org/wiki/Arctic%20Ocean", "wikipedia_extract": "The Arctic Ocean is the smallest and shallowest of the world's five oceanic divisions. It spans an area of approximately 14,060,000 km2 (5,430,000 sq mi) and is the coldest of the world's oceans. The International Hydrographic Organization (IHO) recognizes it as an ocean, although some oceanographers call it the Arctic Mediterranean Sea or North Polar Sea. It has also been described as an estuary of the Atlantic Ocean. It is also seen as the northernmost part of the all-encompassing world ocean. The Arctic Ocean includes the North Pole region in the middle of the Northern Hemisphere and extends south to about 60°N."}, "cross_references": [{"found_name": "Southern Ocean", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1213, "target_cluster_name": "Southern Ocean", "source_book": "llm_generated", "evidence_snippet": "Likely refers to the icy waters of the Arctic Ocean.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Likely refers to the icy waters of the Arctic Ocean.", "is_reverse": true}, {"found_name": "mer", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 921, "target_cluster_name": "mer", "source_book": "llm_generated", "evidence_snippet": "A 'Glacial Sea' is a type of sea, characterized by ice.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: A 'Glacial Sea' is a type of sea, characterized by ice.", "is_reverse": true}, {"found_name": "Polar Sea", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 891, "target_cluster_name": "Polar Sea", "source_book": "llm_generated", "evidence_snippet": "The Arctic Ocean is characterized by sea ice and glaciers.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Arctic Ocean is characterized by sea ice and glaciers.", "is_reverse": true}, {"found_name": "seas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2596, "target_cluster_name": "seas", "source_book": "llm_generated", "evidence_snippet": "The Glacial Sea is a specific sea, and 'seas' is a general term for large bodies of saltwater.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Glacial Sea is a specific sea, and 'seas' is a general term for large bodies of saltwater.", "is_reverse": true}]}, {"canonical_name": "Ethnology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "ethnology", "book_id": "kosmos_humboldt_1845", "name": "Ethnology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Ethnology"], "contexts": ["field of study in report"]}, {"entity_id": "ethnology", "book_id": "first_principles_spencer_1862", "name": "Ethnology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Ethnology"], "contexts": ["study of human races"]}, {"entity_id": "ethnologic", "book_id": "first_principles_spencer_1862", "name": "ethnologic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["ethnologic"], "contexts": ["related to the study of human races and cultures"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Ethnology", "target_book": "first_principles_spencer_1862", "target_name": "Ethnology", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Ethnology", "target_book": "first_principles_spencer_1862", "target_name": "ethnologic", "similarity": 0.907}], "id": 3617, "stable_key": "clu_213577d84f44d11e", "ground_truth": {"modern_name": "Ethnology", "confidence": "high", "type": "concept", "wikidata_id": "Q43455", "wikidata_description": "academic discipline", "wikipedia_url": "https://en.wikipedia.org/wiki/Ethnology", "wikipedia_extract": "Ethnology (from the Ancient Greek: ἔθνος, ethnos meaning 'nation') is an academic field and discipline that compares and analyzes the characteristics of different peoples and the relationships between them (compare cultural, social, or sociocultural anthropology). Compared to ethnography, the study of single groups through direct contact with the culture, ethnology takes the research that ethnographers have compiled and then compares and contrasts different cultures. The term ethnologia (ethnology) is credited to Adam Franz Kollár (1718–1783) who used and defined it in his Historiae ivrisqve pvblici Regni Vngariae amoenitates published in Vienna in 1783. as: \"the science of nations and peoples, or, that study of learned men in which they inquire into the origins, languages, customs, and institutions of various nations, and finally into the fatherland and ancient seats, in order to be able better to judge the nations and peoples in their own times.\" Kollár's interest in linguistic and cultural diversity was aroused by the situation in his native multi-ethnic and multilingual Kingdom of Hungary and his roots among its Slovaks, and by the shifts that began to emerge after the gradual retreat of the Ottoman Empire in the more distant Balkans. Among the goals of ethnology have been the reconstruction of human history, and the formulation of cultural invariants, such as the incest taboo and culture change, and the formulation of generalizations about \"human nature\", a concept which has been criticized since the 19th century by various philosophers (Hegel, Marx, structuralism, etc.). In some parts of the world, ethnology has developed along independent paths of investigation and pedagogical doctrine, with cultural anthropology becoming dominant especially in the United States, and social anthropology in Great Britain."}, "cross_references": [{"found_name": "history", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 177, "target_cluster_name": "history", "source_book": "llm_generated", "evidence_snippet": "Ethnology is the study of the characteristics of various peoples and the differences and relationships between them, often drawing heavily on historical context.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Ethnology is the study of the characteristics of various peoples and the differences and relationships between them, often drawing heavily on historical context.", "is_reverse": true}, {"found_name": "organisation", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 340, "target_cluster_name": "organisation", "source_book": "llm_generated", "evidence_snippet": "Ethnological studies often analyze the organizational structures of different societies and cultural groups.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Ethnological studies often analyze the organizational structures of different societies and cultural groups.", "is_reverse": true}, {"found_name": "civilisation", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 756, "target_cluster_name": "civilisation", "source_book": "llm_generated", "evidence_snippet": "The study of different peoples and cultures (ethnology) is closely related to the study of civilizations.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The study of different peoples and cultures (ethnology) is closely related to the study of civilizations.", "is_reverse": true}, {"found_name": "British Museum", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1235, "target_cluster_name": "British Museum", "source_book": "llm_generated", "evidence_snippet": "The British Museum has extensive ethnographic collections that inform the study of ethnology.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The British Museum has extensive ethnographic collections that inform the study of ethnology.", "is_reverse": true}]}, {"canonical_name": "physical transformations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "physical_metamorphoses", "book_id": "kosmos_humboldt_1845", "name": "physical metamorphoses", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["physical metamorphoses"], "contexts": ["changes in physical nature"]}, {"entity_id": "physical_transformations", "book_id": "first_principles_spencer_1862", "name": "physical transformations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["physical transformations"], "contexts": ["changes in physical form"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "physical metamorphoses", "target_book": "first_principles_spencer_1862", "target_name": "physical transformations", "similarity": 0.945}], "id": 3618, "stable_key": "clu_d445f48951b1a3d0", "ground_truth": {"modern_name": "Physical Transformations", "confidence": "high", "type": "concept", "wikidata_id": "Q104068816", "wikidata_description": "scientific article published on 04 December 2020"}, "cross_references": []}, {"canonical_name": "Density of 