ue}]}, {"canonical_name": "spirit", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "spirit", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "spirit", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["spirit"], "contexts": ["principle contained in crystal"]}, {"entity_id": "spirit", "book_id": "english_physician_1652", "name": "Spirit", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Spirit"], "contexts": ["chemically drawn from herb, more powerful"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "spirit", "target_book": "english_physician_1652", "target_name": "Spirit", "similarity": 0.646}], "id": 3822, "stable_key": "clu_2b0fc88aa74fe922", "ground_truth": {"modern_name": "spirit", "confidence": "high", "type": "concept", "note": "Refers to the vitalistic or essential principle, often a distilled essence, in early modern philosophy and medicine."}, "cross_references": []}, {"canonical_name": "Agaths", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "agaths", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Agaths", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Agaths"], "contexts": ["hard bodies that do not readily strike fire"]}, {"entity_id": "agatas", "book_id": "historia_medicinal_monardes_1574", "name": "Agatas", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Agatas"], "contexts": ["precious stones from mines"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Agaths", "target_book": "historia_medicinal_monardes_1574", "target_name": "Agatas", "similarity": 0.912}], "id": 3823, "stable_key": "clu_1113ac159f733ba5", "ground_truth": {"modern_name": "agate", "confidence": "high", "type": "mineral"}, "cross_references": []}, {"canonical_name": "Caramania", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "caramania", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Caramania", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Caramania"], "contexts": ["historical region in Asia Minor"]}, {"entity_id": "caramanian", "book_id": "kosmos_humboldt_1845", "name": "Caramanian", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Caramanian"], "contexts": ["coast region"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Caramania", "target_book": "kosmos_humboldt_1845", "target_name": "Caramanian", "similarity": 0.915}], "id": 3824, "stable_key": "clu_ccd97557a814380b", "ground_truth": {"modern_name": "Karaman", "confidence": "medium", "type": "place", "country": "Turkey", "note": "The primary referent is likely 'Caramania', a historical region in Asia Minor (modern Turkey). 'Carabaya' is a region in Peru, and 'Caramanian' refers to the region. The cluster is titled 'Caramania', making it the most probable focus. 'Caramania' is an older spelling for the region of Karaman.", "wikidata_id": "Q262579", "wikidata_description": "central district and city in Karaman Province, Turkey", "wikipedia_url": "https://en.wikipedia.org/wiki/Karaman", "wikipedia_extract": "Karaman is a city in south central Turkey, located in Central Anatolia, north of the Taurus Mountains, about 100 km (62 mi) south of Konya. It is the seat of Karaman Province and Karaman District. Its population is 175,390 (2022). The town lies at an average elevation of 1,039 m (3,409 ft). The Karaman Museum is one of the major sights. The town owes its name to Karaman Bey, who was one of the rulers of the Karamanid dynasty."}, "cross_references": []}, {"canonical_name": "Parma", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "parma", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Parma", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Parma"], "contexts": ["city in Italy"]}, {"entity_id": "parma", "book_id": "kosmos_humboldt_1845", "name": "Parma", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Parma"], "contexts": ["city in Italy"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Parma", "target_book": "kosmos_humboldt_1845", "target_name": "Parma", "similarity": 1.0}], "id": 3825, "stable_key": "clu_735fa01071e54693", "ground_truth": {"modern_name": "Parma", "confidence": "high", "type": "place", "country": "Italy", "wikidata_id": "Q2683", "wikidata_description": "city in the northern Italian region of Emilia-Romagna", "wikipedia_url": "https://en.wikipedia.org/wiki/Parma", "wikipedia_extract": "Parma (Italian: [ˈparma] ; Parmigiano: Pärma [ˈpɛːʁmɐ]) is a city in the region of Emilia-Romagna in Northern Italy, known for its architecture, music, art, prosciutto (ham), cheese and surrounding countryside. With a population of 202,111 inhabitants as of 2025, Parma is the second most populous city in Emilia-Romagna after Bologna, the region's capital. The city is home to the University of Parma, one of the oldest universities in the world. Parma is divided into two parts by the stream of the same name. The district on the west side of the river is Oltretorrente, meaning The other side of the stream. Parma's Etruscan name was adapted by Romans to describe the round shield called Parma."}, "cross_references": []}, {"canonical_name": "Northern Seas", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "northern_seas", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Northern Seas", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Northern Seas"], "contexts": ["mountains of ice about the Northern Seas"]}, {"entity_id": "northern_seas", "book_id": "connexion_physical_sciences_somerville_1858", "name": "northern seas", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["northern seas"], "contexts": ["seas with analogous species"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Northern Seas", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "northern seas", "similarity": 0.95}], "id": 3826, "stable_key": "clu_c7fa85ff20958d81", "ground_truth": {"modern_name": "Arctic Ocean", "confidence": "high", "type": "place", "country": "International"}, "cross_references": []}, {"canonical_name": "diaphanity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "diaphanity", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "diaphanity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["diaphanity"], "contexts": ["quality of being transparent"]}, {"entity_id": "diaphaneity", "book_id": "connexion_physical_sciences_somerville_1858", "name": "diaphaneity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["diaphaneity"], "contexts": ["transparency of a substance"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "diaphanity", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "diaphaneity", "similarity": 0.951}], "id": 3827, "stable_key": "clu_98b2a7a95b5112f4", "ground_truth": {"modern_name": "Transparency", "confidence": "high", "type": "concept"}, "cross_references": []}, {"canonical_name": "oyl of Vitriol", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "oyl_of_vitriol", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "oyl of Vitriol", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["oyl of Vitriol"], "contexts": ["acid used for cooling wire"]}, {"entity_id": "oyl_of_vitriol", "book_id": "english_physician_1652", "name": "Oyl of Vitriol", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["Oyl of Vitriol"], "contexts": ["added for tartness to juleps"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "oyl of Vitriol", "target_book": "english_physician_1652", "target_name": "Oyl of Vitriol", "similarity": 0.868}], "id": 3828, "stable_key": "clu_6942bf630c977a71", "ground_truth": {"modern_name": "Oil of Vitriol", "confidence": "high", "type": "chemical", "description": "Strong acidic liquid, sulfuric acid, used in alchemy and medicine.", "wikipedia_extract": "Sulfuric acid (American spelling and the preferred IUPAC name) or sulphuric acid (Commonwealth spelling), known in antiquity as oil of vitriol, is a mineral acid composed of the elements sulfur, oxygen, and hydrogen, with the molecular formula H2SO4. It is a colorless, odorless, and viscous liquid that is miscible with water. Pure sulfuric acid does not occur naturally due to its strong affinity to water vapor; it is hygroscopic and readily absorbs water vapor from the air. Concentrated sulfuric acid is a strong oxidant with powerful dehydrating properties, making it highly corrosive towards other materials, from rocks to metals. Phosphorus pentoxide is a notable exception in that it is not dehydrated by sulfuric acid but, to the contrary, dehydrates sulfuric acid to sulfur trioxide. Upon addition of sulfuric acid to water, a considerable amount of heat is released; thus, the reverse procedure of adding water to the acid is generally avoided since the heat released may boil the solution, spraying droplets of hot acid during the process."}, "cross_references": [{"found_name": "Vitriolo", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 564, "target_cluster_name": "Vitriolo", "source_book": "llm_generated", "evidence_snippet": "The description explicitly states that Vitriol was known in antiquity as 'oil of vitriol'.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: The description explicitly states that Vitriol was known in antiquity as 'oil of vitriol'.", "is_reverse": true}]}, {"canonical_name": "Poles of the World", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "poles_of_the_world", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Poles of the World", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Poles of the World"], "contexts": ["geographic poles of Earth"]}, {"entity_id": "poles", "book_id": "principles_of_psychology_james_1890", "name": "poles", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["poles"], "contexts": ["extremities of a magnet"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Poles of the World", "target_book": "principles_of_psychology_james_1890", "target_name": "poles", "similarity": 0.884}], "id": 3829, "stable_key": "clu_04f9ff1a17140483", "ground_truth": {"modern_name": "Earth's Poles", "confidence": "high", "type": "concept", "note": "Refers to both geographic poles of Earth and the poles of a magnet, depending on context.", "wikidata_id": "Q3907660", "wikidata_description": ""}, "cross_references": [{"found_name": "pole", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 2352, "target_cluster_name": "pole", "source_book": "llm_generated", "evidence_snippet": "The entity 'Pole' is a historical name for the geographical poles of the Earth, which are also referred to as 'Earth's Poles'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The entity 'Pole' is a historical name for the geographical poles of the Earth, which are also referred to as 'Earth's Poles'.", "is_reverse": true}]}, {"canonical_name": "Saint Michael", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "saint_michael", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Saint Michael", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Saint Michael"], "contexts": ["island with middle situation"]}, {"entity_id": "st__michael", "book_id": "kosmos_humboldt_1845", "name": "St. Michael", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["St. Michael"], "contexts": ["island in the Azores"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Saint Michael", "target_book": "kosmos_humboldt_1845", "target_name": "St. Michael", "similarity": 0.973}], "id": 3830, "stable_key": "clu_1605e4d52f50b6a9", "ground_truth": {"modern_name": "San Miguel", "confidence": "high", "type": "place", "description": "Gulf and church name, likely referring to a specific geographical location.", "wikipedia_extract": "Saint Junípero Serra Ferrer  (; Spanish: [xuˈnipeɾo ˈsera]; November 24, 1713 – August 28, 1784), popularly known simply as Junipero Serra, was a Spanish Catholic priest and missionary of the Franciscan Order. He is credited with establishing the Franciscan Missions in the Sierra Gorda, a UNESCO World Heritage Site. He founded a mission in Baja California and established eight of the 21 Spanish missions in California from San Diego to San Francisco, in what was then Spanish-occupied Alta California in the Province of Las Californias of New Spain. Serra was beatified by Pope John Paul II on 25 September 1988 in Vatican City. Amid denunciations from Native American tribes who accused Serra of presiding over a brutal colonial subjugation, Pope Francis canonized Serra on 23 September 2015 at the Basilica of the National Shrine of the Immaculate Conception in Washington, D.C., during his visit to the United States. Serra's missionary efforts earned him the title of \"Apostle of California\"."}, "cross_references": []}, {"canonical_name": "Phoenicean", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "phoenicean", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Phoenicean", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Phoenicean"], "contexts": ["navigators who might have used stars"]}, {"entity_id": "phoenicians", "book_id": "kosmos_humboldt_1845", "name": "Phoenicians", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Phoenicians"], "contexts": ["ancient seafaring civilization"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Phoenicean", "target_book": "kosmos_humboldt_1845", "target_name": "Phoenicians", "similarity": 0.928}], "id": 3831, "stable_key": "clu_e8ccfda8fbc827fa", "ground_truth": {"modern_name": "Phoenicians", "confidence": "high", "type": "person", "description": "Ancient seafaring civilization known for navigation and trade.", "wikidata_id": "Q129630055", "wikidata_description": "scholarly article published on 24 June 2018"}, "cross_references": []}, {"canonical_name": "magnetical parts", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "magnetical_parts", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "magnetical parts", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["magnetical parts"], "contexts": ["parts of earth affecting variation"]}, {"entity_id": "magnetic_nucleus", "book_id": "kosmos_humboldt_1845", "name": "magnetic nucleus", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["magnetic nucleus"], "contexts": ["hypothesized core of Earth's magnetism"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "magnetical parts", "target_book": "kosmos_humboldt_1845", "target_name": "magnetic nucleus", "similarity": 0.884}], "id": 3832, "stable_key": "clu_580a9d062f110ee1", "ground_truth": {"modern_name": "Earth's magnetic field", "confidence": "high", "type": "concept", "note": "Refers to the hypothesized internal structure or source of Earth's magnetism.", "wikidata_id": "Q6500960", "wikidata_description": "magnetic field that extends from the Earth's inner core to where it meets the solar wind"}, "cross_references": [{"found_name": "Loadstone", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 593, "target_cluster_name": "Loadstone", "source_book": "llm_generated", "evidence_snippet": "Lodestones are the natural source of magnetism, which is the basis of the Earth's magnetic field.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Lodestones are the natural source of magnetism, which is the basis of the Earth's magnetic field.", "is_reverse": true}, {"found_name": "magnets", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 822, "target_cluster_name": "magnets", "source_book": "llm_generated", "evidence_snippet": "Magnets are the fundamental components that create and interact with magnetic fields.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Magnets are the fundamental components that create and interact with magnetic fields.", "is_reverse": true}]}, {"canonical_name": "Faces", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "faces", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Faces", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Faces"], "contexts": ["sides of a magnet"]}, {"entity_id": "facies", "book_id": "polyanthea_medicinal", "name": "facies", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["facies"], "contexts": ["face that can swell in dropsy"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Faces", "target_book": "polyanthea_medicinal", "target_name": "facies", "similarity": 0.961}], "id": 3833, "stable_key": "clu_fb8dddd55d15df42-2", "ground_truth": {"modern_name": "Face", "confidence": "high", "type": "substance", "description": "The front part of a person's head, from the forehead to the chin.", "wikipedia_extract": "The face is the front of the head in humans and many other animals that features most of the sense organs including the eyes, nose and mouth. Many animals may express emotions through their face. Sense organs in the faces of different animals are varied such as the snout, and the proboscis. Many animals are flat-faced (brachycephalic) such as the pug dog. The human face is crucial for identity, and damage such as scarring or developmental deformities may adversely affect the psyche. The front of the human head is called the face."}, "cross_references": [{"found_name": "Head", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1508, "target_cluster_name": "cabeça", "source_book": "llm_generated", "evidence_snippet": "The face is a part of the head.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The face is a part of the head."}, {"found_name": "Eye", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 81, "target_cluster_name": "eye", "source_book": "llm_generated", "evidence_snippet": "The eye is a sense organ located in the face.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The eye is a sense organ located in the face."}, {"found_name": "Lips", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2707, "target_cluster_name": "Lips", "source_book": "llm_generated", "evidence_snippet": "Lips are anatomical features of the face.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Lips are anatomical features of the face."}]}, {"canonical_name": "