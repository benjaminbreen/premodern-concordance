to_label": "llm_related", "found_relationship": "Both rice and sugarcane are important staple crops cultivated in similar climates and often discussed together in agricultural and economic contexts."}, {"found_name": "Barley flour", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 614, "target_cluster_name": "farinha de cevada", "source_book": "llm_generated", "evidence_snippet": "Both rice and barley are grains, and their flours are used as food staples, often appearing in discussions of food preparation and nutrition.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both rice and barley are grains, and their flours are used as food staples, often appearing in discussions of food preparation and nutrition."}, {"found_name": "Wheat", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 102, "target_cluster_name": "Wheat", "source_book": "llm_generated", "evidence_snippet": "Rice, wheat, and barley are primary cereal grains that form the basis of many diets worldwide and are frequently compared or discussed in relation to each other.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Rice, wheat, and barley are primary cereal grains that form the basis of many diets worldwide and are frequently compared or discussed in relation to each other."}]}, {"canonical_name": "Micuipampa", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "micuipampa", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Micuipampa", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 8, "variants": ["Micuipampa", "Micaipampa", "Micuiparapa"], "contexts": ["Andes passage name", "location in the Andes"]}, {"entity_id": "micuipampa", "book_id": "kosmos_humboldt_1845", "name": "Micuipampa", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Micuipampa"], "contexts": ["location in Peruvian Andes"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Micuipampa", "target_book": "kosmos_humboldt_1845", "target_name": "Micuipampa", "similarity": 1.0}], "id": 2192, "stable_key": "clu_3f4227ea64664bfd", "ground_truth": {"modern_name": "Micuipampa", "confidence": "high", "type": "place", "country": "Peru"}, "cross_references": []}, {"canonical_name": "madrépores", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "madrépores", "book_id": "relation_historique_humboldt_vol3_1825", "name": "madrépores", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 8, "variants": ["madrépores"], "contexts": ["marine invertebrates forming reefs", "fossil organism, first traces of organization"]}, {"entity_id": "madrepores", "book_id": "connexion_physical_sciences_somerville_1858", "name": "madrepores", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["madrepores"], "contexts": ["marine invertebrates forming reefs"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "madrépores", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "madrepores", "similarity": 0.62}], "id": 2193, "stable_key": "clu_89127756043f1c90", "ground_truth": {"modern_name": "Madreporaria", "confidence": "high", "type": "animal", "note": "Refers to stony corals, a subclass of Anthozoa.", "wikidata_id": "Q137922301", "wikidata_description": "scholarly article published on 28 October 1939", "wikipedia_extract": "Scleractinia, also called stony corals or hard corals, are marine animals in the phylum Cnidaria that build themselves a hard skeleton. The individual animals are known as polyps and have a cylindrical body crowned by an oral disc in which a mouth is fringed with tentacles. Although some species are solitary, most are colonial. The founding polyp settles and starts to secrete calcium carbonate to protect its soft body. Solitary corals can be as much as 25 cm (10 in) across but in colonial species the polyps are usually only a few millimetres in diameter. These polyps reproduce asexually by budding, but remain attached to each other, forming a multi-polyp colony of clones with a common skeleton, which may be up to several metres in diameter or height according to species."}, "cross_references": []}, {"canonical_name": "Sibérie", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "sibérie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Sibérie", "category": "PLACE", "subcategory": "REGION", "count": 8, "variants": ["Sibérie"], "contexts": ["region in Russian Empire", "region with sugar consumption"]}, {"entity_id": "siberia,_eastern", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Siberia, Eastern", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Siberia, Eastern"], "contexts": ["depression of barometer observed in"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Sibérie", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Siberia, Eastern", "similarity": 0.911}], "id": 2194, "stable_key": "clu_6c43ab07c899f7ff", "ground_truth": {"modern_name": "Siberia", "confidence": "high", "type": "place", "description": "A vast geographical region within the Russian Empire.", "wikipedia_extract": "Siberia ( sy-BEER-ee-ə; Russian: Сибирь, romanized: Sibir', IPA: [sʲɪˈbʲirʲ] ), also known as Asian Russia, is an extensive geographical region comprising all of North Asia, from the Ural Mountains in the west (with the Ural River usually forming the southernmost portion of its western boundary) to the Pacific Ocean in the east. It has formed a part of the sovereign territory of Russia and its predecessor states since the lengthy conquest of Siberia, which began with the fall of the Khanate of Sibir in 1582 and concluded with the annexation of Chukotka in 1778. Siberia is vast and sparsely populated, covering an area of over 13.1 million square kilometres (5,100,000 mi2) – about three-quarters of Russia's total area, but home to roughly a quarter of Russia's population. Novosibirsk, Krasnoyarsk, and Omsk are the largest cities in the area. Because Siberia is a geographic and historic concept and not a political entity, there is no single precise definition of its territorial borders. It is further defined as stretching from the territories within the Arctic Circle in the north to the northern borders of Kazakhstan, Mongolia, and China in the south, although the hills of north-central Kazakhstan are also commonly included."}, "cross_references": []}, {"canonical_name": "Anghiera", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "anghiera", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Anghiera", "category": "PERSON", "subcategory": "SCHOLAR", "count": 7, "variants": ["Anghiera"], "contexts": ["author of 'Océaniques'", "cited author"]}, {"entity_id": "anghiera", "book_id": "kosmos_humboldt_1845", "name": "Anghiera", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Anghiera"], "contexts": ["secretary to Ferdinand the Catholic", "known to the Gulf Stream"]}, {"entity_id": "pierre_martyr_d'anghiera", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Pierre Martyr d'Anghiera", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Pierre Martyr d'Anghiera"], "contexts": ["recognized existence of chain", "early modern scholar, 16th century"]}, {"entity_id": "peter_martyr_de_aughiera", "book_id": "kosmos_humboldt_1845", "name": "Peter Martyr de Aughiera", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Peter Martyr de Aughiera"], "contexts": ["observer of snow limit and friend of Columbus"]}, {"entity_id":