85, "auto_label": "llm_related", "found_relationship": "A hygrometer is a type of scientific instrument."}, {"found_name": "instrument", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 456, "target_cluster_name": "Instruments", "source_book": "llm_generated", "evidence_snippet": "A hygrometer is a type of instrument.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "A hygrometer is a type of instrument."}]}, {"canonical_name": "effort", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 15, "members": [{"entity_id": "effort", "book_id": "principles_of_psychology_james_1890", "name": "effort", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["effort"], "contexts": ["exertion of mental or physical energy", "exertion of physical or mental energy"]}, {"entity_id": "esforço", "book_id": "polyanthea_medicinal", "name": "esforço", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["esforço"], "contexts": ["effort"]}, {"entity_id": "effort", "book_id": "first_principles_spencer_1862", "name": "effort", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["effort"], "contexts": ["physical or mental exertion", "exertion of mental energy"]}, {"entity_id": "travail", "book_id": "relation_historique_humboldt_vol3_1825", "name": "travail", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["travail"], "contexts": ["effort exerted for a purpose"]}, {"entity_id": "labour", "book_id": "connexion_physical_sciences_somerville_1858", "name": "labour", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["labour"], "contexts": ["effort expended to perform work"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "effort", "target_book": "polyanthea_medicinal", "target_name": "esforço", "similarity": 0.959}, {"source_book": "principles_of_psychology_james_1890", "source_name": "effort", "target_book": "first_principles_spencer_1862", "target_name": "effort", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "esforço", "target_book": "first_principles_spencer_1862", "target_name": "effort", "similarity": 0.959}], "id": 831, "stable_key": "clu_53ffea6788a915fa", "ground_truth": {"modern_name": "effort", "confidence": "high", "type": "concept", "wikidata_id": "Q510236", "wikidata_description": "psychopathological term to denote a condition with symptoms of fatigue, anxiety, headache, heart palpitations, high blood pressure, neuralgia, and depressed mood", "wikipedia_url": "https://en.wikipedia.org/wiki/Neurasthenia", "wikipedia_extract": "Neurasthenia (from Ancient Greek  νεῦρον (neuron) 'nerve' and ἀσθενής (asthenés) 'weak') is a term that was first used as early as 1829 for a mechanical weakness of the nerves. It became a major diagnosis in North America during the late nineteenth and early twentieth centuries after neurologist George Miller Beard reintroduced the concept in 1869. As a psychopathological term, the first to publish on neurasthenia was Michigan alienist E. H. Van Deusen of the Kalamazoo asylum in 1869. Also in 1868, New York neurologist George Beard used the term in an article published in the Boston Medical and Surgical Journal to denote a condition with symptoms of fatigue, anxiety, headache, heart palpitations, high blood pressure, neuralgia, and depressed mood."}, "member_count": 5, "cross_references": []}, {"canonical_name": "Reality", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "reality", "book_id": "principles_of_psychology_james_1890", "name": "Reality", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["reality", "Reality"], "contexts": ["philosophical concept of existence", "the state of being real"]}, {"entity_id": "reality", "book_id": "kosmos_humboldt_1845", "name": "reality", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["reality"], "contexts": ["the state of things as they actually exist"]}, {"entity_id": "reality", "book_id": "first_principles_spencer_1862", "name": "reality", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["reality", "Reality"], "contexts": ["the state of things as they actually exist", "the true nature of existence"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Reality", "target_book": "kosmos_humboldt_1845", "target_name": "reality", "similarity": 0.98}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Reality", "target_book": "first_principles_spencer_1862", "target_name": "reality", "similarity": 0.98}, {"source_book": "kosmos_humboldt_1845", "source_name": "reality", "target_book": "first_principles_spencer_1862", "target_name": "reality", "similarity": 1.0}], "id": 832, "stable_key": "clu_b0569ee7f305ce84", "ground_truth": {"modern_name": "reality", "confidence": "high", "type": "concept", "wikidata_id": "Q667661", "wikidata_description": "literary movement", "wikipedia_url": "https://en.wikipedia.org/wiki/Literary%20realism", "wikipedia_extract": "Literary realism is a movement and genre of literature that attempts to represent mundane and ordinary subject-matter in a faithful and straightforward way, avoiding grandiose or exotic subject-matter, exaggerated portrayals, and speculative elements such as supernatural events and alternative worlds. It encompasses both fiction (realistic fiction) and nonfiction writing. Literary realism is a subset of the broader realist art movement that began with mid-nineteenth-century French literature (Stendhal) and Russian literature (Alexander Pushkin). It  attempts to represent familiar things, including everyday activities and experiences, as they truly are. Broadly defined as \"the representation of reality\", realism in the arts is the attempt to represent subject matter truthfully, without artificiality and avoiding artistic conventions, as well as implausible, exotic and supernatural elements. Realism has been prevalent in the arts at many periods, and is in large part a matter of technique and training, and the avoidance of stylization."}, "cross_references": [{"found_name": "Noumenon", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 4233, "target_cluster_name": "Noumenon", "source_book": "principles_of_psychology_james_1890", "evidence_snippet": "still stands inside the mind. In the function of knowing there is a multiplicity to be connected, and Kant brings this multiplicity inside the mind. The Reality becomes a mere empty _locus_, or unknow", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for Reality"}, {"found_name": "External world", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 978, "target_cluster_name": "external world", "source_book": "llm_generated", "evidence_snippet": "Literary realism aims to represent the external world faithfully and straightforwardly.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Literary realism aims to represent the external world faithfully and straightforwardly."}]}, {"canonical_name": "intensity", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "intensity", "book_id": "principles_of_psychology_james_1890", "name": "intensity", "category": "CONCEPT", "subcategory": "QUALITY", "count": 6, "variants": ["intensity"], "contexts": ["strength of a sensation", "formal element of experience"]}, {"entity_id": "intensity", "book_id": "kosmos_humboldt_1845", "name": "intensity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["intensity"], "contexts": ["strength of magnetic force", "magnetic field property"]}, {"entity