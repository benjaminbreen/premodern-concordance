ity": 1.0}], "id": 2170, "stable_key": "clu_82c48720adfbce57", "ground_truth": {"modern_name": "Lancashire", "confidence": "high", "type": "place", "country": "United Kingdom", "wikipedia_extract": "Preston ( ) is a city on the north bank of the River Ribble in Lancashire, in North West England. The city is the administrative centre of the county of Lancashire and the wider City of Preston local government district. Preston and its surrounding district obtained city status in 2002, becoming England's 50th city in the 50th year of Queen Elizabeth II's reign. Preston had a population of 147,835 at the 2021 census, the City of Preston district 156,411 in 2023 and the Preston Built-up Area 313,322. The Preston Travel To Work Area, in 2011, had a population of 420,661, compared with 354,000 at the previous census. The south bank of the Ribble is part of the Preston urban area, although it forms the South Ribble borough that is administratively separate.", "wikipedia_url": "https://en.wikipedia.org/wiki/Preston,_Lancashire"}, "cross_references": [{"found_name": "Yorkshire", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 951, "target_cluster_name": "Yorkshire", "source_book": "llm_generated", "evidence_snippet": "Lancashire is a neighboring historic county to Yorkshire, often contrasted in historical and cultural contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Lancashire is a neighboring historic county to Yorkshire, often contrasted in historical and cultural contexts.", "is_reverse": true}, {"found_name": "England", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 65, "target_cluster_name": "England", "source_book": "llm_generated", "evidence_snippet": "Lancashire is a county within England.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Lancashire is a county within England."}, {"found_name": "Liverpool", "link_type": "conceptual_overlap", 