nce": 0.85, "auto_label": "llm_related", "found_relationship": "The term 'ground' in historical texts often refers to the solid surface of the Earth, especially in contrast to air or water."}]}, {"canonical_name": "confusion", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "confusion", "book_id": "principles_of_psychology_james_1890", "name": "confusion", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["confusion"], "contexts": ["state of being bewildered or unclear", "uncertainty about object identity"]}, {"entity_id": "confusion_of_perception", "book_id": "principles_of_psychology_james_1890", "name": "confusion of perception", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["confusion of perception"], "contexts": ["difficulty in distinguishing sensory input"]}, {"entity_id": "confusion", "book_id": "first_principles_spencer_1862", "name": "confusion", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["confusion"], "contexts": ["unorganized mental state of an infant"]}, {"entity_id": "confusion_of_thought", "book_id": "first_principles_spencer_1862", "name": "confusion of thought", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["confusion of thought"], "contexts": ["result from pre-established associations"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "confusion", "target_book": "first_principles_spencer_1862", "target_name": "confusion", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "confusion", "target_book": "first_principles_spencer_1862", "target_name": "confusion of thought", "similarity": 0.948}, {"source_book": "principles_of_psychology_james_1890", "source_name": "confusion of perception", "target_book": "first_principles_spencer_1862", "target_name": "confusion", "similarity": 0.895}, {"source_book": "principles_of_psychology_james_1890", "source_name": "confusion of perception", "target_book": "first_principles_spencer_1862", "target_name": "confusion of thought", "similarity": 0.927}], "id": 2814, "stable_key": "clu_59acb49fed2370bf", "ground_truth": {"modern_name": "confusion", "confidence": "high", "type": "disease", "modern_term": "confusion", "wikidata_id": "Q111529541", "wikidata_description": "2021 Eastercon", "wikipedia_extract": "Sundowning, or sundown syndrome, prevalent among people with some form of dementia, is characterized by increased confusion and restlessness beginning in the late afternoon and early evening. The term sundowning was coined by nurse Lois K. Evans in 1987 due to the association between the person's increased confusion and the setting of the sun. For people with sundown syndrome, a multitude of behavioral problems begin to occur and are associated with long-term adverse outcomes. Sundowning seems to occur more frequently during the middle stages of Alzheimer's disease and mixed dementia and seems to subside with the progression of the person's dementia. People are generally able to understand that this behavioral pattern is abnormal.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sundowning"}, "cross_references": [{"found_name": "delirios", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 235, "target_cluster_name": "delirios", "source_book": "llm_generated", "evidence_snippet": "The provided description of Delirium explicitly states it is a 'specific state of acute confusion'.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: The provided description of Delirium explicitly states it is a 'specific state of acute confusion'.", "is_reverse": true}, {"found_name": "amentia", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1824, "target_cluster_name": "amentia", "source_book": "llm_generated", "evidence_snippet": "Confusion 