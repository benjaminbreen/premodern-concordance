ul. \"Search results Family: Geometridae\". Butterflies and Moths of the World. Natural History Museum, London."}, "cross_references": []}, {"canonical_name": "Torricelli", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "torricelli", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Torricelli", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Torricelli"], "contexts": ["associated with the Torricellian vacuum"]}, {"entity_id": "torricelli", "book_id": "first_principles_spencer_1862", "name": "Torricelli", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Torricelli"], "contexts": ["Italian physicist and mathematician"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Torricelli", "target_book": "first_principles_spencer_1862", "target_name": "Torricelli", "similarity": 1.0}], "id": 4091, "stable_key": "clu_b492e0cb224a8212", "ground_truth": {"modern_name": "Evangelista Torricelli", "confidence": "high", "type": "person", "birth_year": 1608, "death_year": 1647, "description": "Italian physicist and mathematician, inventor of the barometer", "wikidata_id": "Q102490", "wikidata_description": "Italian physicist and mathematician (1608-1647)"}, "cross_references": []}, {"canonical_name": "dilatation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "dilatation", "book_id": "relation_historique_humboldt_vol3_1825", "name": "dilatation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["dilatation"], "contexts": ["process of expanding"]}, {"entity_id": "dilatations", "book_id": "connexion_physical_sciences_somerville_1858", "name": "dilatations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["dilatations"], "contexts": ["regions of decreased pressure in a fluid"]}], "edges": [{