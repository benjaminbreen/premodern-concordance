ource_name": "Mont-Rose", "target_book": "kosmos_humboldt_1845", "target_name": "Mount Rosa", "similarity": 0.897}], "id": 2779, "stable_key": "clu_f8eaea63cb184e52", "ground_truth": {"modern_name": "Monte Rosa", "confidence": "high", "type": "place", "country": "Switzerland, Italy", "wikidata_id": "Q14668", "wikidata_description": "massif in Switzerland and Italy"}, "cross_references": [{"found_name": "Protococcus", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "kosmos_humboldt_1845", "evidence_snippet": "delicate web of an Usnea, in caves where meteoric water could alone penetrate through fissures. Podurellae penetrate into the icy crevices of the glaciers on Mount Rosa, the Grindelwald, and the Upper", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "formerly known as"}]}, {"canonical_name": "Popocatepetl", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "popocatepetl", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Popocatepetl", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Popocatepetl"], "contexts": ["volcanoes of Popocatepetl", "volcano in Anahuac group"]}, {"entity_id": "popocatepetl", "book_id": "kosmos_humboldt_1845", "name": "Popocatepetl", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Popocatepetl"], "contexts": ["volcano near Tlascala", "volcano in the New World"]}, {"entity_id": "popocatepel", "book_id": "kosmos_humboldt_1845", "name": "Popocatepel", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Popocatepel"], "contexts": ["volcanic mountain in Mexico"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Popocatepetl", "target_book": "kosmos_humboldt_1845", "target_name": "Popocatepetl", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Popocatepetl", "target_book": "kosmos_humboldt_1845", "target_name": "Popocatepel", "similarity": 0.953}], "id": 2780, "stable_key": "clu_f3291fd3fd782e20", "ground_truth": {"modern_name": "Popocatépetl", "confidence": "high", "type": "place", "country": "Mexico", "wikidata_id": "Q181157", "wikidata_description": "North America volcano", "wikipedia_url": "https://en.wikipedia.org/wiki/Popocat%C3%A9petl", "wikipedia_extract": "Popocatépetl (UK:  POP-ə-KAT-ə-pet-əl, -⁠kat-ə-PET-əl, US:  POHP-, Spanish: [popokaˈtepetl] ; Nahuatl languages: Popōcatepētl [popoːkaˈtepeːt͡ɬ] ) is an active stratovolcano located in the states of Puebla, Morelos, and Mexico in central Mexico. It lies in the eastern half of the Trans-Mexican Volcanic Belt. At 5,393 m (17,694 ft) it is the second highest peak in Mexico, after Citlaltépetl (Pico de Orizaba) at 5,636 m (18,491 ft). Popocatépetl is ranked 89th by prominence. It is linked to the twin volcano of Iztaccihuatl to the north by the high saddle known as the \"Paso de Cortés\". Izta-Popo Zoquiapan National Park, wherein the two volcanoes are located, is named after them."}, "cross_references": [{"found_name": "Chimborazo", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 708, "target_cluster_name": "Chimborazo", "source_book": "llm_generated", "evidence_snippet": "Chimborazo is a volcano in Ecuador, and Popocatépetl is a volcano in Mexico. Both are prominent stratovolcanoes in the Americas, often discussed in contexts of geology and exploration.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Chimborazo is a volcano in Ecuador, and Popocatépetl is a volcano in Mexico. Both are prominent stratovolcanoes in the Americas, often discussed in contexts of geology and exploration."}, {"found_name": "Cotopaxi", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1777, "target_cluster_name": "Cotopaxi", "source_book": "llm_generated