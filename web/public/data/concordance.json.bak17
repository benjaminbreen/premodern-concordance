m_generated", "evidence_snippet": "Absolute power is a characteristic or form of state.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Absolute power is a characteristic or form of state.", "is_reverse": true}]}, {"canonical_name": "palm of the hand", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "palm_of_the_hand", "book_id": "principles_of_psychology_james_1890", "name": "palm of the hand", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["palm of the hand"], "contexts": ["part of the hand used for tactile sensation"]}, {"entity_id": "palm_of_the_hand", "book_id": "first_principles_spencer_1862", "name": "palm of the hand", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["palm of the hand"], "contexts": ["inner surface of the hand"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "palm of the hand", "target_book": "first_principles_spencer_1862", "target_name": "palm of the hand", "similarity": 1.0}], "id": 4264, "stable_key": "clu_2652d9251fd2db94", "ground_truth": {"modern_name": "Palm of the hand", "confidence": "high", "type": "concept", "wikidata_id": "Q2001588", "wikidata_description": "central region of the front (ventral side) of the human hand or other primate hand"}, "cross_references": []}, {"canonical_name": "granules", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "granules", "book_id": "principles_of_psychology_james_1890", "name": "granules", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["granules"], "contexts": ["small particles in the eye"]}, {"entity_id": "granules", "book_id": "kosmos_humboldt_1845", "name": "granules", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["granules"], "contexts": ["small particles or grains"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "granules", "target_book": "kosmos_humboldt_1845", "target_name": "granules", "similarity": 0.735}], "id": 4265, "stable_key": "clu_fb2f53c862d99344", "ground_truth": {"modern_name": "granules", "confidence": "high", "type": "concept", "note": "The term 'granules' in early modern medical texts can refer to small, grain-like particles in the body, or more generally to any small particulate matter. In the context of anatomy, it most likely refers to histological structures or small particles observed under magnification, but without more specific context, it's best classified as a concept of particulate matter.", "wikidata_id": "Q18581596", "wikidata_description": "genus of insects"}, "cross_references": [{"found_name": "muscæ volitantes", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "principles_of_psychology_james_1890", "evidence_snippet": "give a few well-known cases, taken from physiological optics, as examples. Every eye probably contains _muscæ volitantes_, so called; these are fibres, granules, etc., floating in the vitreous humor, ", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "a type of floating object in the eye"}]}, {"canonical_name": "daylight", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "daylight", "book_id": "principles_of_psychology_james_1890", "name": "daylight", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["daylight"], "contexts": ["light from the sun during the day"]}, {"entity_id": "common_daylight", "book_id": "connexion_physical_sciences_somerville_1858", "name": "common daylight", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["common daylight"], "contexts": ["ordinary light from the sun"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "daylight", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "common daylight", "similarity": 0.951}], "id": 4266, "stable_key": "clu_4901eabace40360b", "ground_truth": {"modern_name": "daylight", "confidence": "high", "type": "concept", "wikidata_id": "Q36669", "wikidata_description": "seasonal adjustment of clocks"}, "cross_references": []}, {"canonical_name": "pound", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "pound", "book_id": "principles_of_psychology_james_1890", "name": "pound", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["pound"], "contexts": ["unit of weight"]}, {"entity_id": "pound", "book_id": "first_principles_spencer_1862", "name": "pound", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["pound"], "contexts": ["unit of weight"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "pound", "target_book": "first_principles_spencer_1862", "target_name": "pound", "similarity": 1.0}], "id": 4267, "stable_key": "clu_d0a4a9db1531a48d", "ground_truth": {"modern_name": "pound", "confidence": "high", "type": "concept", "note": "In this context, 'pound' refers to a unit of weight, a common concept in both scientific and everyday discourse."}, "cross_references": []}, {"canonical_name": "feelings of heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "feelings_of_heat", "book_id": "principles_of_psychology_james_1890", "name": "feelings of heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["feelings of heat"], "contexts": ["sensory modality"]}, {"entity_id": "sensation_of_heat", "book_id": "first_principles_spencer_1862", "name": "sensation of heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sensation of heat"], "contexts": ["subjective experience of heat"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "feelings of heat", "target_book": "first_principles_spencer_1862", "target_name": "sensation of heat", "similarity": 0.971}], "id": 4268, "stable_key": "clu_4cb2a3da86ebb95c", "ground_truth": {"modern_name": "sensation of heat", "confidence": "high", "type": "concept", "note": "This refers to the subjective experience of temperature, a fundamental sensory input."}, "cross_references": []}, {"canonical_name": "ratio", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "ratio", "book_id": "principles_of_psychology_james_1890", "name": "ratio", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["ratio"], "contexts": ["proportion between quantities"]}, {"entity_id": "ratio", "book_id": "polyanthea_medicinal", "name": "ratio", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["ratio"], "contexts": ["reason or logic in medicine"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "ratio", "target_book": "polyanthea_medicinal", "target_name": "ratio", "similarity": 1.0}], "id": 4269, "stable_key": "clu_862ea9a8c437c024", "ground_truth": {"modern_name": "ratio", "confidence": "high", "type": "concept", "note": "A fundamental mathematical and philosophical concept, applicable in both abstract reasoning and proportional relationships."}, "cross_references": []}, {"canonical_name": "perceptibility", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "perceptibility", "book_id": "principles_of_psychology_james_1890", "name": "perceptibility", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["perceptibility"], "contexts": ["ability to notice a difference"]}, {"entity_id": "sensibility", "book_id": "first_principles_spencer_1862", "name": "sensibility", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sensibility"], "contexts": ["capacity to receive impressions"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "perceptibility", "target_book": "first_principles_spencer_1862", "target_name": "sensibility", "similarity": 0.955}], "id": 4270, "stable_key": "clu_97cf455fec4e6ae9", "ground_truth": {"modern_name": "perceptibility", "confidence": "high", "type": "concept", "note": "This refers to the capacity to be perceived or sensed, a concept related to sensory input and awareness."}, "cross_references": []}, {"canonical_name": "Dobrowolsky", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "dobrowolsky", "book_id": "principles_of_psychology_james_1890", "name": "Dobrowolsky", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Dobrowolsky"], "contexts": ["observer of color differences"]}, {"entity_id": "dobrowsky", "book_id": "kosmos_humboldt_1845", "name": "Dobrowsky", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Dobrowsky"], "contexts": ["editor of Bohemian historical texts"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Dobrowolsky", "target_book": "kosmos_humboldt_1845", "target_name": "Dobrowsky", "similarity": 0.946}], "id": 4271, "stable_key": "clu_d2ff2c9c006019f6", "ground_truth": {"modern_name": "Dobrowolsky", "confidence": "low", "type": "person", "description": "Observer of color differences and editor of historical texts.", "note": "The identity of 'Dobrowolsky'/'Dobrowsky' is not clearly identifiable without further context from the specific texts.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_extract": "An induction motor or asynchronous motor is an AC electric motor in which the electric current in the rotor that produces torque is obtained by electromagnetic induction from the magnetic field of the stator winding. An induction motor therefore needs no electrical connections to the rotor. An induction motor's rotor can be either wound type or squirrel-cage type. Three-phase squirrel-cage induction motors are widely used as industrial drives because they are self-starting, reliable, and economical. Single-phase induction motors are used extensively for smaller loads, such as garbage disposals and stationary power tools. Although traditionally used for constant-speed service, single- and three-phase induction motors are increasingly being installed in variable-speed applications using variable-frequency drives (VFD).", "wikipedia_url": "https://en.wikipedia.org/wiki/Induction_motor"}, "cross_references": []}, {"canonical_name": "transitions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "transitions", "book_id": "principles_of_psychology_james_1890", "name": "transitions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["transitions"], "contexts": ["movement from one state to another"]}, {"entity_id": "transitions", "book_id": "kosmos_humboldt_1845", "name": "transitions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["transitions"], "contexts": ["changes from one state to another"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "transitions", "target_book": "kosmos_humboldt_1845", "target_name": "transitions", "similarity": 1.0}], "id": 4272, "stable_key": "clu_310cdc5eef41adcd", "ground_truth": {"modern_name": "transition", "confidence": "high", "type": "concept"}, "cross_references": [{"found_name": "transitions of reason", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "principles_of_psychology_james_1890", "evidence_snippet": "or things, and to telling him that his thinking follows them. But as a matter of fact, his thinking only sometimes follows them, and these so-called 'transitions of reason' are far from being all alik", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "a type of thinking process"}]}, {"canonical_name": "room", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "room", "book_id": "principles_of_psychology_james_1890", "name": "room", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["room"], "contexts": ["enclosed space within a building"]}, {"entity_id": "room", "book_id": "coloquios_da_orta_1563", "name": "Room", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Room"], "contexts": ["Word discussed in the glossary"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "room", "target_book": "coloquios_da_orta_1563", "target_name": "Room", "similarity": 0.996}], "id": 4273, "stable_key": "clu_cb2f31eee58f7cbe", "ground_truth": {"modern_name": "room", "confidence": "high", "type": "place", "wikidata_id": "Q220", "wikidata_description": "capital and largest city of Italy"}, "cross_references": []}, {"canonical_name": "morning", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "morning", "book_id": "principles_of_psychology_james_1890", "name": "morning", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["morning"], "contexts": ["part of the day"]}, {"entity_id": "manhã", "book_id": "polyanthea_medicinal", "name": "manhã", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["manhã"], "contexts": ["morning"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "morning", "target_book": "polyanthea_medicinal", "target_name": "manhã", "similarity": 0.938}], "id": 4274, "stable_key": "clu_cbf3c54ef726504d", "ground_truth": {"modern_name": "Morning", "confidence": "high", "type": "concept", "note": "The terms 'matin' (French), 'morning' (English), 'mañana' (Spanish), and 'manhã' (Portuguese) all refer to the early part of the day.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_extract": "Morning is either the period from sunrise to noon, or the period from midnight to noon. In the first definition it is preceded by the twilight period of dawn, and there are no exact times for when morning begins (also true of evening and night) because it can vary according to one's latitude, and the hours of daylight at each time of year. However, morning strictly ends at noon, when afternoon starts. Morning precedes afternoon, evening, and night in the sequence of a day. Originally, the term referred to sunrise. The Modern English words \"morning\" and \"tomorrow\" began in Middle English as morwening, developing into morwen, then morwe, and eventually morrow."}, "cross_references": []}, {"canonical_name": "Fig. 41", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "fig__41", "book_id": "principles_of_psychology_james_1890", "name": "Fig. 41", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Fig. 41"], "contexts": ["diagram of impartial redintegration"]}, {"entity_id": "fig__54", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Fig. 54", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Fig. 54"], "contexts": ["illustration reference"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Fig. 41", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Fig. 54", "similarity": 0.914}], "id": 4275, "stable_key": "clu_45cb8a27b1908f3e", "ground_truth": {"modern_name": "figure", "confidence": "high", "type": "object", "note": "Refers to a numbered illustration or diagram within a text.", "wikidata_id": "", "wikidata_description": "form of an object or its external boundary"}, "cross_references": []}, {"canonical_name": "Fig. 42", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "fig__42", "book_id": "principles_of_psychology_james_1890", "name": "Fig. 42", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Fig. 42"], "contexts": ["diagram of mixed association"]}, {"entity_id": "fig__52", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Fig. 52", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Fig. 52"], "contexts": ["illustration reference"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Fig. 42", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Fig. 52", "similarity": 0.933}], "id": 4276, "stable_key": "clu_6082906f54165840", "ground_truth": {"modern_name": "figure", "confidence": "high", "type": "object", "note": "Refers to a numbered illustration or diagram within a text.", "wikidata_id": "", "wikidata_description": "form of an object or its external boundary"}, "cross_references": []}, {"canonical_name": "uniformity of nature", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "uniformity_of_nature", "book_id": "principles_of_psychology_james_1890", "name": "uniformity of nature", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["uniformity of nature"], "contexts": ["belief that nature follows consistent laws"]}, {"entity_id": "natural_uniformity", "book_id": "first_principles_spencer_1862", "name": "natural uniformity", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["natural uniformity"], "contexts": ["consistent natural laws"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "uniformity of nature", "target_book": "first_principles_spencer_1862", "target_name": "natural uniformity", "similarity": 0.932}], "id": 4277, "stable_key": "clu_fda12c1ddaa8855a", "ground_truth": {"modern_name": "Uniformity of nature", "confidence": "high", "type": "concept", "wikidata_id": "Q208650", "wikidata_description": "assumption that the same natural laws and processes that operate in the universe here and now have operated always and everywhere", "wikipedia_url": "https://en.wikipedia.org/wiki/Uniformitarianism", "wikipedia_extract": "Uniformitarianism, also known as the Doctrine of Uniformity or the Uniformitarian Principle, is the assumption that the same natural laws and processes that operate in our present-day scientific observations have always operated in the universe in the past and apply everywhere in the universe. It refers to invariance in the metaphysical principles underpinning science, such as the constancy of cause and effect throughout space-time, but has also been used to describe spatiotemporal invariance of physical laws. Though an unprovable postulate that cannot be verified using the scientific method, some consider that uniformitarianism should be a required first principle in scientific research. In geology, uniformitarianism has included the gradualistic concept that \"the present is the key to the past\" and that geological events occur at the same rate now as they have always done, though many modern geologists no longer hold to a strict gradualism. Coined by William Whewell, uniformitarianism was originally proposed in contrast to catastrophism by British naturalists in the late 18th century, starting with the work of the geologist James Hutton in his many books including Theory of the Earth. Hutton's work was later refined by scientist John Playfair and popularised by geologist Charles Lyell's Principles of Geology in 1830."}, "cross_references": []}, {"canonical_name": "crescendo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "crescendo", "book_id": "principles_of_psychology_james_1890", "name": "crescendo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["crescendo"], "contexts": ["a gradual increase in loudness or intensity"]}, {"entity_id": "crescer", "book_id": "polyanthea_medicinal", "name": "crescer", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["crescer"], "contexts": ["to grow"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "crescendo", "target_book": "polyanthea_medicinal", "target_name": "crescer", "similarity": 0.9}], "id": 4278, "stable_key": "clu_3965dd3edba9e0d8", "ground_truth": {"modern_name": "Crescendo", "confidence": "high", "type": "concept", "note": "The early modern usage is consistent with the modern musical and general sense of gradual increase.", "wikidata_id": "Q2347888", "wikidata_description": "musical term indicating a gradual increase in dynamic strength"}, "cross_references": [{"found_name": "rhythm", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 779, "target_cluster_name": "rhythm", "source_book": "llm_generated", "evidence_snippet": "Both 'Rhythm' and 'Crescendo' refer to patterns of change over time, with 'Crescendo' specifically denoting a gradual increase in intensity, often in music or sound, which can be seen as a type of rhythmic progression.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both 'Rhythm' and 'Crescendo' refer to patterns of change over time, with 'Crescendo' specifically denoting a gradual increase in intensity, often in music or sound, which can be seen as a type of rhythmic progression.", "is_reverse": true}, {"found_name": "pitch", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 975, "target_cluster_name": "pitch", "source_book": "llm_generated", "evidence_snippet": "Crescendo is a gradual increase in loudness, which is a related auditory property to pitch. Both are fundamental elements of musical sound.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Crescendo is a gradual increase in loudness, which is a related auditory property to pitch. Both are fundamental elements of musical sound.", "is_reverse": true}, {"found_name": "music", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1052, "target_cluster_name": "music", "source_book": "llm_generated", "evidence_snippet": "Crescendo is a musical term indicating a gradual increase in loudness, directly related to the practice and theory of music.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Crescendo is a musical term indicating a gradual increase in loudness, directly related to the practice and theory of music.", "is_reverse": true}, {"found_name": "intensités", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1346, "target_cluster_name": "intensités", "source_book": "llm_generated", "evidence_snippet": "Both 'Intensity' and 'Crescendo' refer to a measure of magnitude or force, with 'Crescendo' specifically relating to an increase in intensity, particularly in music or sound.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both 'Intensity' and 'Crescendo' refer to a measure of magnitude or force, with 'Crescendo' specifically relating to an increase in intensity, particularly in music or sound.", "is_reverse": true}, {"found_name": "reverberation", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1409, "target_cluster_name": "reverberation", "source_book": "llm_generated", "evidence_snippet": "Crescendo describes a gradual increase in loudness, which is a dynamic aspect of sound that interacts with reverberation.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Crescendo describes a gradual increase in loudness, which is a dynamic aspect of sound that interacts with reverberation.", "is_reverse": true}, {"found_name": "musical notes", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2587, "target_cluster_name": "musical notes", "source_book": "llm_generated", "evidence_snippet": "A crescendo is a gradual increase in loudness in a piece of music, directly related to the dynamics of musical notes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: A crescendo is a gradual increase in loudness in a piece of music, directly related to the dynamics of musical notes.", "is_reverse": true}]}, {"canonical_name": "scientific research", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "scientific_research", "book_id": "principles_of_psychology_james_1890", "name": "scientific research", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["scientific research"], "contexts": ["systematic investigation for knowledge"]}, {"entity_id": "scientific_researches", "book_id": "kosmos_humboldt_1845", "name": "Scientific researches", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Scientific researches"], "contexts": ["frequent result, knowledge requirement"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "scientific research", "target_book": "kosmos_humboldt_1845", "target_name": "Scientific researches", "similarity": 0.935}], "id": 4279, "stable_key": "clu_fe89fd9cd26992a6", "ground_truth": {"modern_name": "Scientific Research", "confidence": "high", "type": "concept", "note": "The term has been in continuous use with a consistent meaning."}, "cross_references": []}, {"canonical_name": "psychologic acts", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "psychologic_acts", "book_id": "principles_of_psychology_james_1890", "name": "psychologic acts", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["psychologic acts"], "contexts": ["mental actions and processes"]}, {"entity_id": "mental_acts", "book_id": "first_principles_spencer_1862", "name": "mental acts", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mental acts"], "contexts": ["cognitive processes involved in actions"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "psychologic acts", "target_book": "first_principles_spencer_1862", "target_name": "mental acts", "similarity": 0.941}], "id": 4280, "stable_key": "clu_827ab566d78df271", "ground_truth": {"modern_name": "Mental Acts", "confidence": "high", "type": "concept", "note": "Refers to the processes and actions of the mind."}, "cross_references": []}, {"canonical_name": "Ambition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "ambition", "book_id": "principles_of_psychology_james_1890", "name": "Ambition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Ambition"], "contexts": ["social affection arising from transferred pleasure"]}, {"entity_id": "ambição", "book_id": "polyanthea_medicinal", "name": "ambição", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["ambição"], "contexts": ["desire for power or success"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Ambition", "target_book": "polyanthea_medicinal", "target_name": "ambição", "similarity": 0.979}], "id": 4281, "stable_key": "clu_011cfb1cc7ea0e97", "ground_truth": {"modern_name": "Ambition", "confidence": "high", "type": "concept", "wikidata_id": "Q3006977", "wikidata_description": "cruise ship built in 1999 with a capacity of 1727 passengers", "wikipedia_url": "https://en.wikipedia.org/wiki/MS_Ambition", "wikipedia_extract": "MS Ambition is a cruise ship operated by Ambassador Cruise Line. Completed in France as Mistral for Festival Cruises in 1999, she sailed between 2005 and 2019 as Grand Mistral with Ibero Cruises and Costa neoRiviera with Costa Cruises. The ship was in service as AIDAmira with AIDA Cruises, a subsidiary of Carnival Corporation & plc, until her sale in 2022 to Ambassador Cruise Line, who renamed her Ambition, commencing sailing in May 2023. It and its sister ship \"Ambience\" featured as the location of the third series of the television show \"The Cruise: Fun-Loving Brits at Sea\" The ship was originally ordered by Renaissance Cruises in mid 1996, but the order was later withdrawn. The yard and bankers together held ownership of the ship through a company called Auxiliaire Maritime. During construction at Chantiers de l'Atlantique, the order was taken over by Festival Cruises, which would receive its first new-build vessel."}, "cross_references": [{"found_name": "volition", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 250, "target_cluster_name": "volition", "source_book": "llm_generated", "evidence_snippet": "Ambition is a strong desire and determination to achieve success, which is closely related to volition as a driving force behind committed action.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Ambition is a strong desire and determination to achieve success, which is closely related to volition as a driving force behind committed action.", "is_reverse": true}, {"found_name": "pleasure", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 384, "target_cluster_name": "pleasure", "source_book": "llm_generated", "evidence_snippet": "Ambition is a strong desire for achievement, power, or success, which is often pursued for the pleasure it is expected to bring.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Ambition is a strong desire for achievement, power, or success, which is often pursued for the pleasure it is expected to bring.", "is_reverse": true}, {"found_name": "Human Nature", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 513, "target_cluster_name": "Human Nature", "source_book": "llm_generated", "evidence_snippet": "Ambition is a specific disposition and drive that is often discussed as a key aspect of human nature.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Ambition is a specific disposition and drive that is often discussed as a key aspect of human nature.", "is_reverse": true}, {"found_name": "feelings", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 618, "target_cluster_name": "feelings", "source_book": "llm_generated", "evidence_snippet": "Ambition is a complex emotional drive related to the desire for achievement and power, thus it is a specific related concept to emotions.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Ambition is a complex emotional drive related to the desire for achievement and power, thus it is a specific related concept to emotions.", "is_reverse": true}, {"found_name": "desires", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4149, "target_cluster_name": "desires", "source_book": "llm_generated", "evidence_snippet": "Ambition is a strong desire for achievement, success, power, or wealth. It is a specific, often powerful, manifestation of desire.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Ambition is a strong desire for achievement, success, power, or wealth. It is a specific, often powerful, manifestation of desire.", "is_reverse": true}, {"found_name": "passion", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1042, "target_cluster_name": "passion", "source_book": "llm_generated", "evidence_snippet": "'Passion' can be a driving force behind 'ambition', representing an intense desire or enthusiasm for achieving goals.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: 'Passion' can be a driving force behind 'ambition', representing an intense desire or enthusiasm for achieving goals.", "is_reverse": true}, {"found_name": "luxuria", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1351, "target_cluster_name": "luxuria", "source_book": "llm_generated", "evidence_snippet": "Luxury is often associated with the pursuit of wealth and status, which can be driven by ambition.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Luxury is often associated with the pursuit of wealth and status, which can be driven by ambition.", "is_reverse": true}, {"found_name": "fortune", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1404, "target_cluster_name": "fortune", "source_book": "llm_generated", "evidence_snippet": "Ambition is often portrayed as a force that either seeks to control or is subject to fortune. The pursuit of ambition is frequently discussed in relation to the whims of fortune, either as a means to achieve it or as a potential downfall.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Ambition is often portrayed as a force that either seeks to control or is subject to fortune. The pursuit of ambition is frequently discussed in relation to the whims of fortune, either as a means to achieve it or as a potential downfall.", "is_reverse": true}, {"found_name": "mental life", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1904, "target_cluster_name": "mental life", "source_book": "llm_ge