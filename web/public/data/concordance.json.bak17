variants": ["Dalton"], "contexts": ["observer of southern lights in England", "views on atmospheric moisture measurement"]}, {"entity_id": "dalton", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Dalton", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Dalton"], "contexts": ["established law of definite proportion", "proposed atomic theory based on weight"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Dalton", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Dalton", "similarity": 1.0}], "id": 2442, "stable_key": "clu_e39ef57b840ca7b3", "ground_truth": {"modern_name": "John Dalton", "confidence": "high", "type": "person", "birth_year": 1766, "death_year": 1844, "description": "Chemist and physicist, father of atomic theory.", "wikidata_id": "Q41284", "wikidata_description": "British chemist and physicist (1766–1844)"}, "cross_references": [{"found_name": "Joule", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2155, "target_cluster_name": "Joule", "source_book": "llm_generated", "evidence_snippet": "Both were significant figures in 19th-century British science. Dalton is known for his atomic theory, and Joule for his work on energy and heat, both contributing to the understanding of matter and energy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were significant figures in 19th-century British science. Dalton is known for his atomic theory, and Joule for his work on energy and heat, both contributing to the understanding of matter and energy.", "is_reverse": true}, {"found_name": "John Frederic Daniell", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1165, "target_cluster_name": "Daniell", "source_book": "llm_generated", "evidence_snippet": "John Frederic Daniell was a chemist and physicist who worked on electricity and meteorology, fields that John Dalton also contributed to significantly, particularly with his work on atmospheric electricity and the development of meteorological instruments.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "John Frederic Daniell was a chemist and physicist who worked on electricity and meteorology, fields that John Dalton also contributed to significantly, particularly with his work on atmospheric electricity and the development of meteorological instruments."}, {"found_name": "John Herschel", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 554, "target_cluster_name": "Sir John Herschel", "source_book": "llm_generated", "evidence_snippet": "John Herschel was a prominent astronomer and physicist who also made contributions to mathematics and optics. His work, like Dalton's, was foundational in several scientific disciplines and he was a respected figure in the scientific community of the 19th century.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "John Herschel was a prominent astronomer and physicist who also made contributions to mathematics and optics. His work, like Dalton's, was foundational in several scientific disciplines and he was a respected figure in the scientific community of the 19th century."}, {"found_name": "James Prescott Joule", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1276, "target_cluster_name": "Mr. Joule", "source_book": "llm_generated", "evidence_snippet": "James Prescott Joule was a physicist known for his work on the nature of heat and its relation to mechanical work, leading to the development of the first law of thermodynamics. John Dalton's earlier work on the atomic theory and the properties of gases laid some of the groundwork for later developments in thermodynamics and statistical mechanics.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "James Prescott Joule was a physicist known for his work on the nature of heat and its relation to mechanical work, leading to the development of the first law of thermodynamics. John Dalton's earlier work on the atomic theory and the properties of gases laid some of the groundwork for later developments in thermodynamics and statistical mechanics."}]}, {"canonical_name": "volcanic", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 10, "members": [{"entity_id": "volcanic", "book_id": "kosmos_humboldt_1845", "name": "volcanic", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["volcanic"], "contexts": ["action by planet's interior on external crust", "classification of rocks based on origin"]}, {"entity_id": "volcanoes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "volcanoes", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["volcanoes"], "contexts": ["vents from which lava erupts", "natural phenomena involving fire and eruption"]}, {"entity_id": "volcanic_eruption", "book_id": "connexion_physical_sciences_somerville_1858", "name": "volcanic eruption", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["volcanic eruption"], "contexts": ["sudden release of lava and ash"]}, {"entity_id": "éruptions", "book_id": "relation_historique_humboldt_vol3_1825", "name": "éruptions", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["éruptions"], "contexts": ["volcanic activity"]}, {"entity_id": "eruptions", "book_id": "kosmos_humboldt_1845", "name": "Eruptions", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Eruptions"], "contexts": ["volcanic phenomena"]}, {"entity_id": "eruptions,_volcanic", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Eruptions, volcanic", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Eruptions, volcanic"], "contexts": ["recorded geological events"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "volcanic", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "volcanoes", "similarity": 0.965}, {"source_book": "kosmos_humboldt_1845", "source_name": "volcanic", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "volcanic eruption", "similarity": 0.947}], "id": 2443, "stable_key": "clu_6f4ffa23d82476d8", "ground_truth": {"modern_name": "Volcanic eruption", "confidence": "high", "type": "concept", "note": "The term 'volcanic' in early modern texts, especially when referring to physical phenomena like eruptions and vents, aligns with the modern concept of volcanic activity. While not a disease, it was often discussed in natural philosophy alongside geological processes that could have perceived impacts on the 'health' of the planet.", "wikidata_id": "Q7692360", "wikidata_description": "natural phenomenon where lava, hot gases or other substances are emitted suddenly from a geological feature", "wikipedia_url": "https://en.wikipedia.org/wiki/Volcanic%20eruption", "modern_term": "Volcanic eruptions", "wikipedia_extract": "A volcanic eruption occurs when material is expelled from a volcanic vent or fissure. Several types of volcanic eruptions have been distinguished by volcanologists. These are often named after famous volcanoes where that type of behavior has been observed. Some volcanoes may exhibit only one characteristic type of eruption during a period of activity, while others may display an entire sequence of types all in one eruptive series. There are three main types of volcanic eruptions. Magmatic eruptions involve the decompression of gas within magma that propels it forward."}, "member_count": 6, "cross_references": [{"found_name": "magnetic storms", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2003, "target_cluster_name": "magnetic storms", "source_book": "llm_generated", "evidence_snippet": "Both 'magnetic storms' and 'volc