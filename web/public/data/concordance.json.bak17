et_cluster_id": 42, "target_cluster_name": "Humboldt", "source_book": "llm_generated", "evidence_snippet": "Both were prominent scientists of the 19th century, known for their contributions to physics and physiology, and likely interacted within the scientific community.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were prominent scientists of the 19th century, known for their contributions to physics and physiology, and likely interacted within the scientific community."}, {"found_name": "Carl Friedrich Gauss", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1176, "target_cluster_name": "Gauss", "source_book": "llm_generated", "evidence_snippet": "Both were leading mathematicians and physicists of the 19th century, and it is highly probable they were aware of each other's work and may have corresponded or met.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were leading mathematicians and physicists of the 19th century, and it is highly probable they were aware of each other's work and may have corresponded or met."}, {"found_name": "Michael Faraday", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 248, "target_cluster_name": "Faraday", "source_book": "llm_generated", "evidence_snippet": "Both were highly influential scientists in the 19th century, with Helmholtz making significant contributions to electromagnetism, a field Faraday pioneered. They would have been contemporaries and aware of each other's work.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were highly influential scientists in the 19th century, with Helmholtz making significant contributions to electromagnetism, a field Faraday pioneered. They would have been contemporaries and aware of each other's work."}, {"found_name": "Isaac Newton", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 71, "target_cluster_name": "Newton", "source_book": "llm_generated", "evidence_snippet": "Helmholtz's work in physics, particularly on the conservation of energy, built upon the foundations laid by Newton's laws of motion and universal gravitation. Newton represents a foundational figure in the scientific tradition that Helmholtz belonged to.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Helmholtz's work in physics, particularly on the conservation of energy, built upon the foundations laid by Newton's laws of motion and universal gravitation. Newton represents a foundational figure in the scientific tradition that Helmholtz belonged to."}]}, {"canonical_name": "Sol", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 37, "members": [{"entity_id": "sol", "book_id": "historia_medicinal_monardes_1574", "name": "Sol", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 5, "variants": ["Sol"], "contexts": ["celestial body the flower turns towards", "sun, used for drying"]}, {"entity_id": "sol", "book_id": "coloquios_da_orta_1563", "name": "sol", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 4, "variants": ["sol", "Sol"], "contexts": ["element that cures amber", "celestial body, object of affection"]}, {"entity_id": "sol", "book_id": "polyanthea_medicinal", "name": "Sol", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 28, "variants": ["Sol"], "contexts": ["the Sun", "Source of lights"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Sol", "target_book": "coloquios_da_orta_1563", "target_name": "sol", "similarity": 0.894}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Sol", "target_book": "polyanthea_medicinal", "target_name": "Sol", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "sol", "target_book": "polyanthea_medicinal", "target_name": "Sol", "similarity": 0.894}], "id": 625, "stable_key": "clu_6406cd173a4216a6-2", "ground_truth": {"modern_name": "Sun", "confidence": "high", "type": "object", "description": "The star at the center of our solar system; source of light and heat.", "note": "Refers to the celestial body, not the Roman deity unless context implies it.", "wikipedia_extract": "The Sun is the star at the centre of the Solar System. It is a massive, nearly perfect sphere of hot plasma, heated to incandescence by nuclear fusion reactions in its core, radiating the energy from its surface mainly as visible light and infrared radiation with 10% at ultraviolet energies. It is the main source of energy for life on Earth. The Sun has been an object of veneration in many cultures and a central subject for astronomical research since antiquity. The Sun orbits the Galactic Center at a distance of 24,000 to 28,000 light-years. Its mean distance from Earth is about 1.496×108 kilometres or about 8 light-minutes."}, "cross_references": [{"found_name": "Nebulous stars", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 3144, "target_cluster_name": "nebulous stars", "source_book": "llm_generated", "evidence_snippet": "Nebulous stars are a type of star, distinct from the Sun but within the same astronomical context.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Nebulous stars are a type of star, distinct from the Sun but within the same astronomical context."}, {"found_name": "Planet", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2065, "target_cluster_name": "planets", "source_book": "llm_generated", "evidence_snippet": "The Sun is the central body around which planets orbit.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Sun is the central body around which planets orbit."}, {"found_name": "Sphere", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 783, "target_cluster_name": "sphere", "source_book": "llm_generated", "evidence_snippet": "The Sun is described as a sphere.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Sun is described as a sphere."}, {"found_name": "Star", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3914, "target_cluster_name": "Star", "source_book": "llm_generated", "evidence_snippet": "The Sun is a star.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Sun is a star."}, {"found_name": "guandis", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "preto min e o branco bom, que he huma das condições da sua bondade? ORTA He costume dos boticairos da índia (a quem chamam os índios guandis) secálo ao sol, dizem que secálo á sombra o faz preto. E da", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for boticairos da índia"}]}, {"canonical_name": "Gay-Lussac", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 37, "members": [{"entity_id": "gay-lussac", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Gay-Lussac", "category": "PERSON", "subcategory": "SCHOLAR", "count": 20, "variants": ["Gay-Lussac", "J. L. Gay-Lussac", "M. Gay-Lussac", "MM. Gay-Lussac"], "contexts": ["cited author in chemistry", "author on volcano action"]}, {"entity_id": "gay-lussac", "book_id": "kosmos_humboldt_1845", "name": "Gay-Lussac", "category": "PERSON", "subcategory": "SCHOLAR", "count": 14, "variants": ["Gay-Lussac"], "contexts": ["with Gay-Lussac and Von Buch", "scientist, published in Annales"]}, {"entity_id": "gay-lussac", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Gay-Lussac", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Gay-Lussac"], "contexts": ["ascended in a balloon"]}, {"entity_id": "gay_lussac", "book_id": "kosmos_humboldt_1845", "name": "Gay Lussac", "category": "PERSON",