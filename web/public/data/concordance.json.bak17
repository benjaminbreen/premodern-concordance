: "llm_related", "found_relationship": "Hunting is often contrasted with or seen as a precursor to the domestication of animals."}]}, {"canonical_name": "leg", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "leg", "book_id": "origin_of_species_darwin_1859", "name": "leg", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["leg"], "contexts": ["limb for locomotion", "lower limb"]}, {"entity_id": "leg", "book_id": "principles_of_psychology_james_1890", "name": "leg", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["leg"], "contexts": ["lower limb of a vertebrate"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "leg", "target_book": "principles_of_psychology_james_1890", "target_name": "leg", "similarity": 1.0}], "id": 2719, "stable_key": "clu_d1ac657d198b440e", "ground_truth": {"modern_name": "Leg", "confidence": "high", "type": "concept"}, "cross_references": [{"found_name": "Feet", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 134, "target_cluster_name": "Feet", "source_book": "llm_generated", "evidence_snippet": "The leg is a limb of the body, and the foot is the terminal part of the leg.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The leg is a limb of the body, and the foot is the terminal part of the leg.", "is_reverse": true}, {"found_name": "ligamentos", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3334, "target_cluster_name": "ligamentos", "source_book": "llm_generated", "evidence_snippet": "The 'Leg' is a body part that contains ligaments.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The 'Leg' is a body part that contains ligaments.", "is_reverse": true}, {"found_name": "trunk", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1218, "target_cl