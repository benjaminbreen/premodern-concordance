, "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Salt-water", "target_book": "kosmos_humboldt_1845", "target_name": "salt water", "similarity": 0.957}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Salt-water", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "salt water", "similarity": 0.957}, {"source_book": "kosmos_humboldt_1845", "source_name": "salt water", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "salt water", "similarity": 1.0}], "id": 1231, "stable_key": "clu_6ce91532ead772a6", "ground_truth": {"modern_name": "Saltwater", "confidence": "high", "type": "concept", "wikidata_id": "Q182599", "wikidata_description": "species of reptile"}, "cross_references": [{"found_name": "Rivers", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2611, "target_cluster_name": "Rivers", "source_book": "llm_generated", "evidence_snippet": "Rivers can flow into and mix with saltwater bodies.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Rivers can flow into and mix with saltwater bodies.", "is_reverse": true}, {"found_name": "agua caliente", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1484, "target_cluster_name": "agua caliente", "source_book": "llm_generated", "evidence_snippet": "Hot water is a state of saltwater.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Hot water is a state of saltwater.", "is_reverse": true}]}, {"canonical_name": "numbers", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "numbers", "book_id": "origin_of_species_darwin_1859", "name": "numbers", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["numbers"], "contexts": ["quantity of individuals"]}, {"entity_id": "numerals", "book_id": "principles_of_psychology_james_1890", "name": "numerals", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["numerals"], "contexts": ["words representing numbers"]}, {"entity_id": "number", "book_id": "principles_of_psychology_james_1890", "name": "number", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["number"], "contexts": ["mathematical quantity"]}, {"entity_id": "numbers", "book_id": "principles_of_psychology_james_1890", "name": "numbers", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["numbers"], "contexts": ["mathematical symbols for quantity"]}, {"entity_id": "number", "book_id": "first_principles_spencer_1862", "name": "number", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["number"], "contexts": ["grammatical distinction of singular/plural"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "numbers", "target_book": "principles_of_psychology_james_1890", "target_name": "numerals", "similarity": 0.951}, {"source_book": "origin_of_species_darwin_1859", "source_name": "numbers", "target_book": "principles_of_psychology_james_1890", "target_name": "number", "similarity": 0.855}, {"source_book": "origin_of_species_darwin_1859", "source_name": "numbers", "target_book": "principles_of_psychology_james_1890", "target_name": "numbers", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "numbers", "target_book": "first_principles_spencer_1862", "target_name": "number", "similarity": 0.855}, {"source_book": "principles_of_psychology_james_1890", "source_name": "number", "target_book": "first_principles_spencer_1862", "target_name": "number", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "numbers", "target_book": "first_principles_spencer_1862", "target_name": "number", "similarity": 0.855}], "id": 1232, "stable_key": "clu_da340677956c2a49", "ground_truth": {"modern_name": "Number", "confidence": "high", "type": "concept", "wikidata_id": "Q11563", "wikidata_description": "mathematical object used to count, label, and measure", "wikipedia_url": "https://en.wikipedia.org/wiki/Number", "wikipedia_extract": "A number is a mathematical object used to count, measure, and label. The most basic examples are the natural numbers: 1, 2, 3, 4, 5, and so forth. Individual numbers can be represented in language with number words or by dedicated symbols called numerals; for example, \"five\" is a number word and \"5\" is the corresponding numeral. As only a limited list of symbols can be memorized, a numeral system is used to represent any number in an organized way. The most common representation is the Hindu–Arabic numeral system, which can display any non-negative integer using a combination of ten symbols, called numerical digits. Numerals can be used for counting (as with cardinal number of a collection or set), labels (as with telephone numbers), for ordering (as with serial numbers), and for codes (as with ISBNs)."}, "cross_references": [{"found_name": "Arithmetica", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1207, "target_cluster_name": "Arithmetica", "source_book": "llm_generated", "evidence_snippet": "Arithmetic is the study of numbers and their properties.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Arithmetic is the study of numbers and their properties.", "is_reverse": true}, {"found_name": "Calculation", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1380, "target_cluster_name": "calculation", "source_book": "llm_generated", "evidence_snippet": "Calculation is the process of computing or determining a numerical result, which is fundamentally based on the manipulation of numbers.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Calculation is the process of computing or determining a numerical result, which is fundamentally based on the manipulation of numbers."}, {"found_name": "Geometry", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2912, "target_cluster_name": "Geometry", "source_book": "llm_generated", "evidence_snippet": "Geometry, while dealing with shapes and space, relies heavily on numerical measurements, ratios, and quantities. Early geometry was deeply intertwined with number theory and measurement.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Geometry, while dealing with shapes and space, relies heavily on numerical measurements, ratios, and quantities. Early geometry was deeply intertwined with number theory and measurement."}]}, {"canonical_name": "innate", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "hereditary", "book_id": "origin_of_species_darwin_1859", "name": "hereditary", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["hereditary"], "contexts": ["passed down through inheritance"]}, {"entity_id": "inherited", "book_id": "origin_of_species_darwin_1859", "name": "inherited", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["inherited"], "contexts": ["passed down genetically"]}, {"entity_id": "innate", "book_id": "principles_of_psychology_james_1890", "name": "innate", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["innate"], "contexts": ["inborn, natural", "inherent quality of movement"]}, {"entity_id": "hereditary", "book_id": "first_principles_spencer_1862", "name": "hereditary", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["hereditary"], "contexts": ["passed down through generations"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "hereditary", "target_book": "first_principles_spencer_1862", "target_name": "hereditary", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "inherited", "target_book": "principles_of_psychology_james_1890", "target_name": "innate", "similarity": 0.892}, {"source_book": "origin_of_species_darwin_1859", "source_name": "inherited", "target_book": "first_principles_spencer_1862", "target_name": "hereditary", "similarity": 0.93}], "id": 1233, "stable_key": "clu_4310a3e28994b064", "ground_truth": {"modern_name": "Heredity", "confidence": "high", "type": "concept", "wikidata_id": "Q2261546", "wikidata_description": "scientific journal", "wikipedia_url": "https://en.wikipedia.org/wiki/Heredity", "wikipedia_extract": "Heredity, also called inheritance or biological inheritance, is the passing on of traits from parents to their offspring; either through asexual reproduction or sexual reproduction, the offspring cells or organisms acquire the genetic information of their parents. Through heredity, variations between individuals can accumulate and cause species to evolve by natural selection. The study of heredity in biology is genetics. In humans, eye color is an example of an inherited characteristic: an individual might inherit the \"brown-eye trait\" from one of the parents. Inherited traits are controlled by genes and the complete set of genes within an organism's genome is called its genotype. The complete set of observable traits of the structure and behavior of an organism is called its phenotype."}, "cross_references": [{"found_name": "Descent", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1973, "target_cluster_name": "descent", "source_book": "llm_generated", "evidence_snippet": "Historical texts often discussed heredity in the context of 'descent' or lineage, tracing traits and characteristics from ancestors to descendants.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Historical texts often discussed heredity in the context of 'descent' or lineage, tracing traits and characteristics from ancestors to descendants."}, {"found_name": "Breed", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2181, "target_cluster_name": "breed", "source_book": "llm_generated", "evidence_snippet": "The concept of 'breed' in animals and plants is directly tied to the principles of heredity, as selective breeding relies on passing specific traits through generations.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The concept of 'breed' in animals and plants is directly tied to the principles of heredity, as selective breeding relies on passing specific traits through generations."}, {"found_name": "Development", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 960, "target_cluster_name": "development", "source_book": "llm_generated", "evidence_snippet": "Heredity provides the foundational blueprint for an organism's development, influencing its growth and maturation processes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Heredity provides the foundational blueprint for an organism's development, influencing its growth and maturation processes."}, {"found_name": "Evolution", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 540, "target_cluster_name": "Evolution", "source_book": "llm_generated", "evidence_snippet": "Heredity is a fundamental mechanism of evolution, as the inheritance of variations allows for natural selection to act upon populations over time.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Heredity is a fundamental mechanism of evolution, as the inheritance of variations allows for natural selection to act upon populations over time."}, {"found_name": "Generation", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 166, "target_cluster_name": "generation", "source_book": "llm_generated", "evidence_snippet": "Heredity is the process by which traits are passed from one generation to the next.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Heredity is the process by which traits are passed from one generation to the next."}, {"found_name": "hybrids", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1669, "target_cluster_name": "hybrids", "source_book": "llm_generated", "evidence_snippet": "Hybridization is a direct consequence of the principles of heredity, as it involves the transmission of genetic material from two different parents to their offspring.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Hybridization is a direct consequence of the principles of heredity, as it involves the transmission of genetic material from two different parents to their offspring.", "is_reverse": true}, {"found_name": "sexual selection", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1841, "target_cluster_name": "sexual selection", "source_book": "llm_generated", "evidence_snippet": "Sexual selection acts on heritable traits, influencing their frequency in subsequent generations.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Sexual selection acts on heritable traits, influencing their frequency in subsequent generations.", "is_reverse": true}, {"found_name": "parent-species", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2723, "target_cluster_name": "parent-species", "source_book": "llm_generated", "evidence_snippet": "The traits of an ancestor species are passed down through heredity to its descendants.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The traits of an ancestor species are passed down through heredity to its descendants.", "is_reverse": true}]}, {"canonical_name": "Glasgow", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "glasgow", "book_id": "orig