rget_cluster_name": "Iceland", "source_book": "llm_generated", "evidence_snippet": "An island nation located in the North Atlantic Ocean, bordering the Arctic Ocean.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "An island nation located in the North Atlantic Ocean, bordering the Arctic Ocean."}, {"found_name": "North Pole", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 804, "target_cluster_name": "South pole", "source_book": "llm_generated", "evidence_snippet": "The northernmost point on Earth, located within the Arctic Ocean.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The northernmost point on Earth, located within the Arctic Ocean."}]}, {"canonical_name": "Afphalto", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "asphaltus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Asphaltus", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Asphaltus"], "contexts": ["bitumen from Judea, tested for electricity"]}, {"entity_id": "afphalto", "book_id": "ricettario_fiorentino_1597", "name": "Afphalto", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Afphalto"], "contexts": ["substance used in preparations", "bitumen, asphalt"]}, {"entity_id": "asphalt", "book_id": "connexion_physical_sciences_somerville_1858", "name": "asphalt", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["asphalt"], "contexts": ["film dissolved in oil of lavender", "dissolved in oil for photographic plate"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Asphaltus", "target_book": "ricettario_fiorentino_1597", "target_name": "Afphalto", "similarity": 0.981}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Asphaltus", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "asphalt", "similarity": 0.99}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Afphalto", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "asphalt", "similarity": 0.976}], "id": 1214, "stable_key": "clu_25eb484c5396d93c", "ground_truth": {"modern_name": "Asphalt", "confidence": "high", "type": "chemical", "note": "Includes references to asphalt and bitumen, used in preparations and tested for electrical properties.", "wikidata_id": "Q202251", "wikidata_description": "petroleum product", "wikipedia_extract": "Sealcoating, or pavement sealing, is the process of applying a protective coating to asphalt-based pavements to provide a layer of protection from the elements: water, oils, and U.V. damage. The effects of asphalt sealers have been debated. Asphalt sealing is marketed as increasing the life of the asphalt, but there is no independent research that proves these claims. Asphalt sealing can also make the asphalt more slippery and impact the environment. There are concerns about pavement sealer polluting the environment after it is abraded from the surface of the pavement.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sealcoat"}, "cross_references": [{"found_name": "bitume", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 160, "target_cluster_name": "bitume", "source_book": "llm_generated", "evidence_snippet": "Bitumen and asphalt are often used interchangeably in historical texts to refer to similar viscous, black, tar-like substances derived from petroleum or coal. While subtle distinctions might exist in modern chemistry, historical usage frequently conflates them.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Bitumen and asphalt are often used interchangeably in historical texts to refer to similar viscous, black, tar-like substances derived from petroleum or coal. While subtle distinctions might exist in modern chemistry, historical usage frequently conflates them.", "is_reverse": true}, {"found_name": "wax", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 716, "target_cluster_name": "wax", "source_book": "llm_generated", "evidence_snippet": "Asphalt is a sticky, black, highly viscous liquid or semi-solid form of petroleum or natural, sharing hydrocarbon-based properties with waxes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Asphalt is a sticky, black, highly viscous liquid or semi-solid form of petroleum or natural, sharing hydrocarbon-based properties with waxes.", "is_reverse": true}, {"found_name": "Charcoal", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 857, "target_cluster_name": "Charcoal", "source_book": "llm_generated", "evidence_snippet": "Asphalt is a related fossil fuel, similar in composition to bitumen and coal.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Asphalt is a related fossil fuel, similar in composition to bitumen and coal.", "is_reverse": true}]}, {"canonical_name": "Poplar", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "poplar", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Poplar", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Poplar"], "contexts": ["tree whose gums form concretion"]}, {"entity_id": "poplar", "book_id": "english_physician_1652", "name": "Poplar", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Poplar", "Poplar-Tree"], "contexts": ["tree dedicated to Hercules", "tree with two common sorts"]}, {"entity_id": "poplars", "book_id": "kosmos_humboldt_1845", "name": "poplars", "category": "PLANT", "subcategory": "TREE", "count": 2, "variants": ["poplars"], "contexts": ["abundant in middle tertiary period", "tree species in ancient forests"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Poplar", "target_book": "english_physician_1652", "target_name": "Poplar", "similarity": 0.878}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Poplar", "target_book": "kosmos_humboldt_1845", "target_name": "poplars", "similarity": 0.919}], "id": 1215, "stable_key": "clu_c137951004a0b5e9", "ground_truth": {"modern_name": "Poplar", "confidence": "high", "type": "plant", "linnaean": "Populus spp.", "family": "Salicaceae", "wikipedia_extract": "Populus nigra, the black poplar, is a species of cottonwood poplar, the type species of section Aigeiros of the genus Populus, native to Europe, southwest and central Asia, and northwest Africa. Black poplars are medium- to large-sized deciduous trees, reaching 20–30 m, and rarely 40 m tall. Their leaves are diamond-shaped to triangular, 5–8 cm long and 6–8 cm broad, and green on both surfaces. Normally, their trunks achieve up to 1.5 m in diameter, but some unusual individual trees in France have grown old enough to have much larger trunks – more than 3 metres DBH (Diameter at Breast Height). The species is dioecious (male and female flowers are on different plants), with flowers in catkins and pollination achieved by the wind. The black poplar grows in low-lying areas of moist ground.", "wikipedia_url": "https://en.wikipedia.org/wiki/Populus_nigra"}, "cross_references": [{"found_name": "cozimento", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1654, "target_cluster_name": "cozimento", "source_book": "polyanthea_medicinal", "evidence_snippet": "nafcem as moſcas ;& tem differentes nomes , porque huns the chamão Ulmeiro , outros Choupo , outros Salgueiro. A entrecaſca do pao do Ulmeiro cura o feu cozimento todas aschagas interiores,& exteriore", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "reverse: synonym for", "is_reverse": true}, {"found_name": "arvore", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1632, "target_cluster_name": "arvore", "source_book": "polyanthea_medicinal", "evidence_snippet": "uſou de chapejaras tacs chagas com a aguada infuſaódo ,,entrecaſco do Ulmeiro,ou Choupo,& foycomomilagrofaa brevidadecom ,, quefarou. Advirto que eſta arvore he aquela , que gera humas bolſas , em que", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "reverse: alternative name for the tree", "is_reverse": true}, {"found_name": "cura", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1748, "target_cluster_name": "cura", "source_book": "polyanthea_medicinal", "evidence_snippet": "em que nafcem as moſcas ;& tem differentes nomes , porque huns the chamão Ulmeiro , outros Choupo , outros Salgueiro. A entrecaſca do pao do Ulmeiro cura o feu cozimento todas aschagas interiores,& ex", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "reverse: synonym for the tree with medicinal bark", "is_reverse": true}, {"found_name": "Willow", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1059, "target_cluster_name": "Willow", "source_book": "llm_generated", "evidence_snippet": "Poplars (genus Populus) are closely related to Willows (genus Salix), both belonging to the family Salicaceae. They share similar habitats and growth forms.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Poplars (genus Populus) are closely related to Willows (genus Salix), both belonging to the family Salicaceae. They share similar habitats and growth forms.", "is_reverse": true}, {"found_name": "Tree", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 24, "target_cluster_name": "Tree", "source_book": "llm_generated", "evidence_snippet": "Populus nigra is a species of tree.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Populus nigra is a species of tree."}, {"found_name": "Timber trees", "link_type": "conceptual_ov