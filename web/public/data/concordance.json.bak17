, "variants": ["Menardo"], "contexts": ["authority on water and summer heat"]}, {"entity_id": "menardo", "book_id": "coloquios_da_orta_1563", "name": "Menardo", "category": "PERSON", "subcategory": "SCHOLAR", "count": 19, "variants": ["Menardo"], "contexts": ["modern author criticizing Mesue", "modern scholar cited"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Mendel", "target_book": "coloquios_da_orta_1563", "target_name": "Menardo", "similarity": 0.85}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Menardo", "target_book": "coloquios_da_orta_1563", "target_name": "Menardo", "similarity": 0.669}], "id": 712, "stable_key": "clu_a8234cbad416a48a", "ground_truth": {"modern_name": "Charles-Émile de Menard", "confidence": "medium", "type": "person", "description": "Author of medical and botanical works, cited in psychiatric archives.", "note": "The combination of 'Menardo' and the context 'modern author criticizing Mesue' alongside psychiatric archives points to Charles-Émile de Menard, though 'Mendel' appears as a possible OCR error."}, "cross_references": []}, {"canonical_name": "Aurora", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 21, "members": [{"entity_id": "aurora", "book_id": "kosmos_humboldt_1845", "name": "Aurora", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 14, "variants": ["Aurora"], "contexts": ["natural light phenomenon", "celestial phenomenon"]}, {"entity_id": "aurora", "book_id": "coloquios_da_orta_1563", "name": "Aurora", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Aurora"], "contexts": ["dawn, used for pearl color comparison"]}, {"entity_id": "aurora", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Aurora", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["aurora", "Aurora"], "contexts": ["natural light display", "light resembling phenomenon"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Aurora", "target_book": "coloquios_da_orta_1563", "target_name": "Aurora", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Aurora", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Aurora", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Aurora", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Aurora", "similarity": 1.0}], "id": 713, "stable_key": "clu_86147a708f8c6110", "ground_truth": {"modern_name": "Aurora", "confidence": "high", "type": "concept", "note": "The contexts 'natural light phenomenon', 'dawn', and 'natural light display' all refer to the phenomenon of aurora, likely celestial, or the time of dawn.", "wikidata_id": "Q132015", "wikidata_description": "municipality of the Philippines in the province of Zamboanga del Sur", "wikipedia_url": "https://en.wikipedia.org/wiki/Aurora%2C%20Zamboanga%20del%20Sur", "wikipedia_extract": "Aurora, officially the Municipality of Aurora (Cebuano: Lungsod sa Aurora; Subanen: Benwa Aurora; Maguindanaon: Inged nu Awrura, Jawi: ايڠد نو اورور; Chavacano: Municipalidad de Aurora; Tagalog: Bayan ng Aurora), is a municipality in the province of Zamboanga del Sur, Philippines. According to the 2024 census, it has a population of 52,746 people. The town was named after President Manuel L. Quezon's wife, Aurora Quezon. On July 1, 1941, the barrios of Cebuano Barracks, Parasan, and Tambulig were excised from Pagadian to form the new municipality of Aurora, then part of the undivided province Zamboanga, by virtue of Executive Order No. 353, signed by President Manuel L."}, "cross_references": [{"found_name": "Magnetic storms", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2435, "target_cluster_name": "Magnetic storms", "source_book": "llm_generated", "evidence_snippet": "Auroras are a direct visual manifestation of geomagnetic storms, caused by the interaction of charged particles from the storm with the Earth's atmosphere.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Auroras are a direct visual manifestation of geomagnetic storms, caused by the interaction of charged particles from the storm with the Earth's atmosphere.", "is_reverse": true}]}, {"canonical_name": "dormideyras", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 21, "members": [{"entity_id": "dormideras", "book_id": "historia_medicinal_monardes_1574", "name": "Dormideras", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Dormideras"], "contexts": ["plant whose dried flowers resemble black seeds"]}, {"entity_id": "durmideiras", "book_id": "coloquios_da_orta_1563", "name": "durmideiras", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["durmideiras", "dormideiras", "dormideiras brancas", "dormydeyras", "durmideiras pretas"], "contexts": ["poppy plants", "white poppy plants"]}, {"entity_id": "dormideyras", "book_id": "polyanthea_medicinal", "name": "dormideyras", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 15, "variants": ["dormideyras", "Dormideiras", "dormideiras", "dormideyras brancas"], "contexts": ["ingredient in poultice for headaches", "sleep-inducing herbs"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Dormideras", "target_book": "coloquios_da_orta_1563", "target_name": "durmideiras", "similarity": 0.977}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Dormideras", "target_book": "polyanthea_medicinal", "target_name": "dormideyras", "similarity": 0.938}, {"source_book": "coloquios_da_orta_1563", "source_name": "durmideiras", "target_book": "polyanthea_medicinal", "target_name": "dormideyras", "similarity": 0.93}], "id": 714, "stable_key": "clu_91b6bd8dd611dd5d", "ground_truth": {"modern_name": "Poppy", "confidence": "high", "type": "plant", "description": "Flowering plant known for its seeds and sleep-inducing properties.", "note": "Likely refers to species of Papaver, particularly Papaver somniferum.", "wikipedia_extract": "A poppy is a flowering plant in the subfamily Papaveroideae of the family Papaveraceae. Poppies are herbaceous plants, often grown for their colourful flowers. One species of poppy, Papaver somniferum, is the source of the narcotic drug mixture opium, which contains powerful medicinal alkaloids such as morphine and has been used since ancient times as an analgesic and narcotic medicinal and recreational drug. It also produces edible seeds. Following the trench warfare in the poppy fields of Flanders, Belgium, during World War I, poppies, specifically the red poppy, have become a symbol of remembrance of soldiers who have died during wartime, especially in the UK, Canada, Australia, Africa and other Commonwealth realms. Poppies are herbaceous annual, biennial or short-lived perennial plants."}, "cross_references": []}, {"canonical_name": "oleo violado", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 3, "total_mentions": 21, "members": [{"entity_id": "olio_violado", "book_id": "coloquios_da_orta_1563", "name": "olio violado", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["olio violado"], "contexts": ["violet-infused oil"]}, {"entity_id": "olio_violato", "book_id": "ricettario_fiorentino_1597", "name": "olio violato", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["olio violato"], "contexts": ["violet oil used in preparation", "preparation made from violets"]}, {"entity_id": "oleo_violado", "book_id": "polyanthea_medicinal", "name": "oleo violado", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 18, "variants": ["oleo violado", "oleo viola do"], "contexts": ["a medicinal preparation", "preparation used as medicine"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "olio violado", "target_book": "ricettario_fiorentino_1597", "target_name": "olio violato", "similarity": 0.996}, {"source_book": "coloquios_da_orta_1563", "source_name": "olio violado", "target_book": "polyanthea_medicinal", "target_name": "oleo violado", "similarity": 0.987}, {"source_book": "ricettario_fiorentino_1597", "source_name": "olio violato", "target_book": "polyanthea_medicinal", "target_name": "oleo violado", "similarity": 0.984}], "id": 715, "stable_key": "clu_bed70f6326c13d27", "ground_truth": {"modern_name": "Violet Oil", "confidence": "high", "type": "substance", "description": "Medicinal oil infused with violets.", "note": "A pharmaceutical preparation derived from violets.", "wikipedia_extract": "Essential oils are compodes of hydrophobic volatile organic compounds, usually in liquid form, obtained from plant material. Essential oils are also known as volatile oils, ethereal oils, aetheroleum, or simply as the oil of the plant from which they were extracted, such as oil of clove. An essential oil is essential in the sense that the oil contains the fragrance or essence of the plant. The term \"essential\" used here does not indicate that it is nutritionally required in the diet, as with essential amino acid or essential fatty acid. Essential oils, according to ISO, are produced either by steam distillation, by mechanical manipulation of the rind of the fruits of the genus Citrus (also called cold pressing), or by dry distillation. Other methods, such as solvent extraction, are not accepted and, in fact, result in different perfumed products (pommades, concretes, and absolutes)."}, "cross_references": [{"found_name": "Oils", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 203, "target_cluster_name": "olio", "source_book": "llm_generated", "evidence_snippet": "Violet oil is a specific type of oil, and 'Oils' is a broader category that encompasses it.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Violet oil is a specific type of oil, and 'Oils' is a broader category that encompasses it."}, {"found_name": "Rose oil", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 987, "target_cluster_name": "olio rosato", "source_book": "llm_generated", "evidence_snippet": "Both are essential oils derived from flowers, suggesting a shared method of extraction and similar properties.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are essential oils derived from flowers, suggesting a shared method of extraction and similar properties."}, {"found_name": "Mint Water", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4477, "target_cluster_name": "agua de ortelãa", "source_book": "llm_generated", "evidence_snippet": "Both are plant-derived liquids used in historical medicine and perfumery, often prepared through similar processes like distillation.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are plant-derived liquids used in historical medicine and perfumery, often prepared through similar processes like distillation."}]}, {"canonical_name": "wax", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 20, "members": [{"entity_id": "wax", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Wax", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 8, "variants": ["wax", "Wax"], "contexts": ["waxy material", "soft, pliable substance"]}, {"entity_id": "wax", "book_id": "origin_of_species_darwin_1859", "name": "wax", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 11, "variants": ["wax"], "contexts": ["material used by bees for comb construction", "material used for making cells"]}, {"entity_id": "wax", "book_id": "principles_of_psychology_james_1890", "name": "wax", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["wax"], "contexts": ["material easily impressed"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Wax", "target_book": "origin_of_species_darwin_1859", "target_name": "wax", "similarity": 0.936}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Wax", "target_book": "principles_of_psychology_james_1890", "target_name": "wax", "similarity": 0.936}, {"source_book": "origin_of_species_darwin_1859", "source_name": "wax", "target_book": "principles_of_psychology_james_1890", "target_name": "wax", "similarity": 1.0}], "id": 716, "stable_key": "clu_8fa98b5e9b9adc5e", "ground_truth": {"modern_name": "wax", "confidence": "high", "type": "substance", "description": "A malleable, sticky substance secreted by bees to build their honeycomb.", "wikipedia_extract": "Waxes are a diverse class of organic compounds that are lipophilic solids that are  malleable near ambient temperatures. They include higher alkanes and lipids, typically with melting points above about 40 °C (104 °F), melting to give low viscosity liquids. Waxes are insoluble in water but soluble in nonpolar organic solvents such as hexane, benzene and chloroform. Natural waxes of various types are produced by plants and animals and occur in petroleum. Waxes are organic compounds that characteristically consist of long aliphatic alkyl chains, although aromatic compounds may also be present. Natural waxes may contain unsaturated bonds and include various functional groups such as fatty acids, primary and secondary alcohols, ketones, aldehydes and fatty acid esters."}, "cross_references": [{"found_name": "Amber", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 820, "target_cluster_name": "amber", "source_book": "llm_generated", "evidence_snippet": "Amber is a fossilized tree resin, which shares properties with natural waxes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Amber is a fossilized tree resin, which shares properties with natural waxes."}, {"found_name": "Birdlime", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3843, "target_cluster_name": "Birdlime", "source_book": "llm_generated", "evidence_snippet": "Birdlime is a sticky substance, often derived from plant materials, used to trap birds, and shares adhesive properties with some waxes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Birdlime is a sticky substance, often derived from plant materials, used to trap birds, and shares adhesive properties with some waxes."}, {"found_name": "Bitumen", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 160, "target_cluster_name": "bitume", "source_book": "llm_generated", "evidence_snippet": "Bitumen is a sticky, black, highly viscous liquid or semi-solid form of petroleum or natural asphalt, sharing hydrocarbon-based properties with waxes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Bitumen is a sticky, black, highly viscous liquid or semi-solid form of petroleum or natural asphalt, sharing hydrocarbon-based properties with waxes."}, {"found_name": "Honey", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 227, "target_cluster_name": "Honey", "source_book": "llm_generated", "evidence_snippet": "Honey is a viscous, sweet substance produced by bees, and shares a viscous, semi-solid consistency with some waxes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Honey is a viscous, sweet substance produced by bees, and shares a viscous, semi-solid consistency with some waxes."}, {"found_name": "Oils", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 203, "target_cluster_name": "olio", "source_book": "llm_generated", "evidence_snippet": "Oils are a diverse group of lipids, and share lipophilic properties with waxes, often being related in terms of their organic chemistry.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Oils are a diverse group of lipids, and share lipophilic properties with waxes, often being related in terms of their organic chemistry."}, {"found_name": "Pitch", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2141, "target_cluster_name": "pez", "source_book": "llm_generated", "evidence_snippet": "Pitch is a viscous, black, sticky substance derived from organic materials, sharing adhesive and viscous properties with waxes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Pitch is a viscous, black, sticky substance derived from organic materials, sharing adhesive and viscous properties with waxes."}, {"found_name": "Asphalt", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1214, "target_cluster_name": "Afphalto", "source_book": "llm_generated", "evidence_snippet": "Asphalt is a sticky, black, highly viscous liquid or semi-solid form of petroleum or natural, sharing hydrocarbon-based properties with waxes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Asphalt is a sticky, black, highly viscous liquid or semi-solid form of petroleum or natural, sharing hydrocarbon-based properties with waxes."}]}, {"canonical_name": "sheep", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 3, "total_mentions": 20, "members": [{"entity_id": "sheep", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Sheep", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 4, "variants": ["Sheep"], "contexts": ["have peculiar vermine", "animals that get the Rot"]}, {"entity_id": "sheep", "book_id": "origin_of_species_darwin_1859", "name": "sheep", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 13, "variants": ["Sheep", "sheep"], "contexts": ["domesticated animal", "domesticated mammals with many breeds"]}, {"entity_id": "sheep", "book_id": "first_principles_spencer_1862", "name": "sheep", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 3, "variants": ["sheep"], "contexts": ["rural inhabitants producing sheep", "domesticated ovine species"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Sheep", "target_book": "origin_of_species_darwin_1859", "target_name": "sheep", "similarity": 0.991}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Sheep", "target_book": "first_principles_spencer_1862", "target_name": "sheep", "similarity": 0.991}, {"source_book": "origin_of_species_darwin_1859", "source_name": "sheep", "target_book": "first_principles_spencer_1862", "target_name": "sheep", "similarity": 1.0}], "id": 717, "stable_key": "clu_7c54247a7b6fd99e", "ground_truth": {"modern_name": "sheep", "confidence": "high", "type": "animal", "wikidata_id": "Q4628", "wikidata_description": "North Atlantic archipelago organized as an autonomous constituent country of the Kingdom of Denmark", "wikipedia_url": "https://en.wikipedia.org/wiki/Faroe%20Islands", "wikipedia_extract": "The Faroe Islands ( FAIR-oh), also known as the Faroes, are an archipelago in the North Atlantic Ocean and a rigsdel ('autonomous territory') of the Kingdom of Denmark. Located between Iceland, Norway, and the Hebrides and Shetland isles of Scotland, the islands have a population of 54,870 as of November 2025 and a land area of 1,393 km2 (538 sq mi). The official language is Faroese, which is partially mutually intelligible with Icelandic. The terrain is rugged, dominated by fjords and cliffs with sparse vegetation and few trees. As a result of their proximity to the Arctic Circle, the islands experience perpetual civil twilight during summer nights and very short winter days; nevertheless, they experience a subpolar oceanic climate and mild temperatures year-round due to the Gulf Stream. The capital, Tórshavn, receives the fewest recorded hours of sunshine of any city in the world at only 840 per year."}, "cross_references": [{"found_name": "Goat", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2022, "target_cluster_name": "Goat", "source_book": "llm_generated", "evidence_snippet": "Goats and sheep are commonly grouped together as livestock, often sharing similar husbandry practices and appearing in similar contexts in premodern texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Goats and sheep are commonly grouped together as livestock, often sharing similar husbandry practices and appearing in similar contexts in premodern texts.", "is_reverse": true}, {"found_name": "Bode", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2474, "target_cluster_name": "Bode", "source_book": "llm_generated", "evidence_snippet": "Goats and sheep are both members of the family Bovidae and are often discussed together as closely related livestock.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Goats and sheep are both members of the family Bovidae and are often discussed together as closely related livestock.", "is_reverse": true}]}, {"canonical_name": "Berries", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 20, "members": [{"entity_id": "berries", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Berries", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Berries"], "contexts": ["fleshy fruit of plants"]}, {"entity_id": "berries", "book_id": "english_physician_1652", "name": "Berries", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 18, "variants": ["Berries"], "contexts": ["part of the Bay-Tree", "fruit of the Black Bilberry plant"]}, {"entity_id": "berries", "book_id": "origin_of_species_darwin_1859", "name": "berries", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["berries"], "contexts": ["fleshy fruits of plants"]}], "edges": [{"source_book": "pseudodoxia_ep