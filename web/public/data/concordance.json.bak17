pe": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 24, "target_cluster_name": "Tree", "source_book": "llm_generated", "evidence_snippet": "Alder is a specific type of tree.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Alder is a specific type of tree."}, {"found_name": "Timber trees", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3930, "target_cluster_name": "Timber Trees", "source_book": "llm_generated", "evidence_snippet": "Alder is a type of tree that can be used for timber.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Alder is a type of tree that can be used for timber."}]}, {"canonical_name": "Camerarius", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "camerarius", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Camerarius", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Camerarius"], "contexts": ["scholar who defended Herodotus"]}, {"entity_id": "camerarius", "book_id": "english_physician_1652", "name": "Camerarius", "category": "PERSON", "subcategory": "SCHOLAR", "count": 6, "variants": ["Camerarius", "Cameravius"], "contexts": ["cited for remedy", "scholar who noted use of Meadow Rue for Jaundice"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Camerarius", "target_book": "english_physician_1652", "target_name": "Camerarius", "similarity": 1.0}], "id": 2350, "stable_key": "clu_98ba6c71c3ae3857", "ground_truth": {"modern_name": "Joachim Camerarius", "confidence": "high", "type": "person", "birth_year": 1500, "death_year": 1574, "description": "German humanist scholar, physician, and botanist.", "note": "There were multiple scholars named Camerarius. Joachim Camerarius the Younger (1534-1598) was also a physician and botanist. The citations suggest a historical figure associated with botanical knowledge and remedies.", "wikidata_id": "Q71261", "wikidata_description": "German scientist (1534-1598)", "wikipedia_url": "https://en.wikipedia.org/wiki/Joachim%20Camerarius%20the%20Younger", "wikipedia_extract": "Joachim Camerarius (12 April 1500 – 17 April 1574), the Elder, was a German classical scholar. His critical abilities, his deep understanding of Greek and Latin, and his wide-ranging knowledge of the ancient world made him one of the foremost German scholars of his time. Camerarius was born in Bamberg, in the Prince-Bishopric of Bamberg. His family name was Liebhard, but he was generally called Kammermeister, previous members of his family having held the office of chamberlain (camerarius) to the bishops of Bamberg. He studied at Leipzig, Erfurt and Wittenberg, where he became a student and friend of Philipp Melanchthon. For some years he was teacher of history and Greek at the gymnasium in Nuremberg (Ägidiengymnasium)."}, "cross_references": [{"found_name": "Scholars", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3236, "target_cluster_name": "Scholars", "source_book": "llm_generated", "evidence_snippet": "Joachim Camerarius was a prominent classical scholar.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Joachim Camerarius was a prominent classical scholar."}]}, {"canonical_name": "diameters", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "diameter", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Diameter", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Diameter"], "contexts": ["straight line passing through circle's center"]}, {"entity_id": "circumference", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "circumference", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["circumference"], "contexts": ["boundary of a circle"]}, {"entity_id": "diameters", "book_id": "connexion_physical_sciences_somerville_1858", "name": "diameters", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["Diameters", "diameters"], "contexts": ["straight line passing through the center", "lines through the center of a shape"]}, {"entity_id": "circumference", "book_id": "connexion_physical_sciences_somerville_1858", "name": "circumference", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["circumference"], "contexts": ["outer boundary of a circle or sphere", "distance around a circular object"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Diameter", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "diameters", "similarity": 0.939}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Diameter", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "circumference", "similarity": 0.903}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "circumference", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "diameters", "similarity": 0.884}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "circumference", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "circumference", "similarity": 1.0}], "id": 2351, "stable_key": "clu_b20770b75698451a", "ground_truth": {"modern_name": "Diameter", "confidence": "high", "type": "concept", "note": "This cluster refers to geometrical concepts rather than a specific substance or anatomical part. The context of 'boundary of a circle' and 'straight line passing through the center' points to the geometric definition of a diameter and circumference."}, "cross_references": []}, {"canonical_name": "pole", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "poles", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "poles", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["poles"], "contexts": ["Earth's magnetic poles"]}, {"entity_id": "pole", "book_id": "connexion_physical_sciences_somerville_1858", "name": "pole", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 6, "variants": ["pole"], "contexts": ["geographic extremity of the earth", "northernmost point of Earth's axis"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "poles", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "pole", "similarity": 0.938}], "id": 2352, "stable_key": "clu_f51de4c710633306", "ground_truth": {"modern_name": "Pole", "confidence": "high", "type": "concept", "note": "The contexts 'Earth's magnetic poles' and 'geographic extremity of the earth' refer to the concept of poles, both geographic and magnetic, rather than a physical object or substance."}, "cross_references": [{"found_name": "Earth's Poles", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 3829, "target_cluster_name": "Poles of the World", "source_book": "llm_generated", "evidence_snippet": "The entity 'Pole' is a historical name for the geographical poles of the Earth, which are also referred to as 'Earth's Poles'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The entity 'Pole' is a historical name for the geographical poles of the Earth, which are also referred to as 'Earth's Poles'."}, {"found_name": "Earth's magnetic poles", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 3768, "target_cluster_name": "pole of the earth", "source_book": "llm_generated", "evidence_snippet": "The entity 'Pole' can refer to the magnetic poles of the Earth, which are also referred to as 'Earth's magnetic poles'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The entity 'Pole' can refer to the magnetic poles of the Earth, which are also referred to as 'Earth's magnetic poles'."}, {"found_name": "north pole", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2136, "target_cluster_name": "north pole", "source_book": "llm_generated", "evidence_snippet": "The North Pole is a specific type of pole, referring to the northernmost point on the Earth's axis of rotation. 'Pole' is a more general term that encompasses the North Pole.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The North Pole is a specific type of pole, referring to the northernmost point on the Earth's axis of rotation. 'Pole' is a more general term that encompasses the North Pole.", "is_reverse": true}]}, {"canonical_name": "silk", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "silk", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Silk", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Silk"], "contexts": ["natural fiber"]}, {"entity_id": "silk", "book_id": "connexion_physical_sciences_somerville_1858", "name": "silk", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 6, "variants": ["silk"], "contexts": ["fabric with light reflecting properties", "material used for rubbing glass"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Silk", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "silk", "similarity": 0.949}], "id": 2353, "stable_key": "clu_e13dada9bf0e03f9", "ground_truth": {"modern_name": "silk", "confidence": "medium", "type": "substance", "note": "The Portuguese 'sedas' directly means 'silks'. The Spanish 'sedago' is less clear but could be a corruption or a related textile term. Given the context of trade at Ormuz, silk is a highly probable commodity.", "wikidata_id": "Q134747", "wikidata_description": "insect from the moth family", "wikipedia_extract": "Bombyx mori, commonly known as the domestic silk moth, is a domesticated moth species belonging to the family Bombycidae. It is the closest relative of Bombyx mandarina, the wild silk moth. Silkworms are the larvae of silk moths. The silkworm is of particular economic value, being a primary producer of silk. The silkworm's preferred food are the leaves of white mulberry, though they may eat other species of mulberry, and even leaves of other plants. Domestic silk moths are entirely dependent on humans for reproduction, as a result of millennia of selective breeding.", "wikipedia_url": "https://en.wikipedia.org/wiki/Bombyx_mori"}, "cross_references": [{"found_name": "seda", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 2232, "target_cluster_name": "seda", "source_book": "llm_generated", "evidence_snippet": "This is the Portuguese word for silk, appearing in the entity description.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "This is the Portuguese word for silk, appearing in the entity description."}]}, {"canonical_name": "hernias", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "hernias", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Hernias", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Hernias"], "contexts": ["a medical condition"]}, {"entity_id": "herniam", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Herniam", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Herniam"], "contexts": ["plaster for hernia with attractive power"]}, {"entity_id": "hernias", "book_id": "polyanthea_medicinal", "name": "hernias", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 5, "variants": ["hernias", "Hernias", "Hernias inteſtinaes", "hernias carnofas"], "contexts": ["condition affecting the throat", "hernias"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Hernias", "target_book": "polyanthea_medicinal", "target_name": "hernias", "similarity": 0.991}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Herniam", "target_book": "polyanthea_medicinal", "target_name": "hernias", "similarity": 0.903}], "id": 2354, "stable_key": "clu_eba611654f5f3107", "ground_truth": {"modern_name": "hernias", "confidence": "high", "type": "disease", "description": "Protrusion of an organ or tissue through an abnormal opening.", "note": "Includes specific types of ruptures and general hernias.", "wikipedia_extract": "A hernia (pl.: hernias or herniae, from Latin, meaning 'rupture') is the abnormal exit of tissue or an organ, such as the bowel, through the wall of the cavity in which it normally resides. The term is also used for the normal development of the intestinal tract, referring to the retraction of the intestine from the extra-embryonal navel coelom into the abdomen in the healthy embryo at about 71⁄2 weeks. Various types of hernias can occur, most commonly involving the abdomen, and specifically the groin. Groin hernias are most commonly inguinal hernias but may also be femoral hernias. Other types of hernias include hiatus, incisional, and umbilical hernias. Symptoms are present in about 66% of people with groin hernias."}, "cross_references": [{"found_name": "Ruptures", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 277, "target_cluster_name": "Ruptures", "source_book": "llm_generated", "evidence_snippet": "The entity description explicitly states that 'hernia' is from Latin meaning 'rupture', and 'Ruptures' is listed as an alias.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The entity description explicitly states that 'hernia' is from Latin meaning 'rupture', and 'Ruptures' is listed as an alias."}, {"found_name": "malde Loanda", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "polyanthea_medicinal", "evidence_snippet": "chamado vulgarmente malde Loanda ; osde Lingadoc acar-,, alid translate canunt. Idem etiam affirmat Frater Frei bunculos, osdosAlpes,&Allobrogos abocios ,ou hernias da garganta , os ,, Pedro de Poyare", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for hernias"}, {"found_name": "osde Lingadoc", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "polyanthea_medicinal", "evidence_snippet": "chamado vulgarmente malde Loanda ; osde Lingadoc acar-,, alid translate canunt. Idem etiam affirmat Frater Frei bunculos, osdosAlpes,&Allobrogos abocios ,ou hernias da garganta , os ,, Pedro de Poyare", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for hernias"}, {"found_name": "Allobrogos", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "polyanthea_medicinal", "evidence_snippet": "chamado vulgarmente malde Loanda ; osde Lingadoc acar-,, alid translate canunt. Idem etiam affirmat Frater Frei bunculos, osdosAlpes,&Allobrogos abocios ,ou hernias da garganta , os ,, Pedro de Poyare", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for hernias"}, {"found_name": "the Fleshy Rupture", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "english_physician_1652", "evidence_snippet": "drive forth the Stone, which the Pouder of the Bark of the Root taken in Wine performeth effectually. Mathiolus saith, the same helpeth the Diseas called Hiernia Carnosa, the Fleshy Rupture* 8.510 by ", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for Hiernia Carnosa"}]}, {"canonical_name": "Gomma", "category": "PLANT", "subcategory": "RESIN", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "gum", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Gum", "category": "PLANT", "subcategory": "RESIN", "count": 1, "variants": ["Gum"], "contexts": ["viscous plant substance"]}, {"entity_id": "gomma", "book_id": "ricettario_fiorentino_1597", "name": "Gomma", "category": "PLANT", "subcategory": "RESIN", "count": 6, "variants": ["gomma", "Gomma"], "contexts": ["substance used to falsify opium", "resin used in preparations"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Gum", "target_book": "ricettario_fiorentino_1597", "target_name": "Gomma", "similarity": 0.887}], "id": 2355, "stable_key": "clu_cc42c90aa5bef23b", "ground_truth": {"modern_name": "Plant gums", "confidence": "high", "type": "plant", "note": "Refers to exudates from plants, often sticky and viscous, used in medicine and industry.", "wikidata_id": "Q424275", "wikidata_description": "viscous substance produced by nearly all plants and some microorganisms; in terms of science, a polar glycoprotein and exopolysaccharide", "wikipedia_url": "https://en.wikipedia.org/wiki/Resin", "wikipedia_extract": "A resin is a solid or highly viscous liquid that can be converted into a polymer. Resins may be biological or synthetic in origin, but are typically harvested from plants. Resins are mixtures of organic compounds insoluble in water, predominantly terpenes. Technically, resins should not be confused with gums, which consist predominantly of water-soluble polysaccharides, although these two terms are often interchangeable in the less formal context. Common resins include pine oleoresins, amber, hashish, frankincense, myrrh and the animal-derived resin, shellac. Resins are used in varnishes, adhesives, food additives, incenses and perfumes."}, "cross_references": [{"found_name": "Sangue di drago", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1168, "target_cluster_name": "Sangue di drago", "source_book": "llm_generated", "evidence_snippet": "Dragon's blood is a resin, which is a type of plant exudate often grouped with gums in historical contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Dragon's blood is a resin, which is a type of plant exudate often grouped with gums in historical contexts.", "is_reverse": true}, {"found_name": "Resin", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1481, "target_cluster_name": "resin", "source_book": "llm_generated", "evidence_snippet": "The description of 'Plant gums (historical name: Gomma)' aligns directly with the definition of 'Resin' as a substance harvested from plants, often a solid or viscous liquid composed of organic compounds.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "The description of 'Plant gums (historical name: Gomma)' aligns directly with the definition of 'Resin' as a substance harvested from plants, often a solid or viscous liquid composed of organic compounds."}, {"found_name": "Turpentine", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1737, "target_cluster_name": "Trementina", "source_book": "llm_generated", "evidence_snippet": "Turpentine is a resin obtained from pine trees, and thus is a specific type of plant gum/resin.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Turpentine is a resin obtained from pine trees, and thus is a specific type of plant gum/resin."}, {"found_name": "Frankincense", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 653, "target_cluster_name": "incenso", "source_book": "llm_generated", "evidence_snippet": "Frankincense is a resin obtained from trees of the genus Boswellia, making it a specific type of plant gum/resin.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Frankincense is a resin obtained from trees of the genus Boswellia, making it a specific type of plant gum/resin."}, {"found_name": "Myrrh", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 583, "target_cluster_name": "Myrrha", "source_book": "llm_generated", "evidence_snippet": "Myrrh is a resinous substance obtained from trees of the genus Commiphora, making it a specific type of plant gum/resin.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Myrrh is a resinous substance obtained from trees of the genus Commiphora, making it a specific type of plant gum/resin."}, {"found_name": "Storax", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2505, "target_cluster_name": "Storace", "source_book": "llm_generated", "evidence_snippet": "Storax is a balsamic resin obtained from trees of the genus Styrax, making it a specific type of plant gum/resin.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Storax is a balsamic resin obtained from trees of the genus Styrax, making it a specific type of plant gum/resin."}, {"found_name": "Dragon's blood", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1168, "target_cluster_name": "Sangue di drago", "source_book": "llm_generated", "evidence_snippet": "Dragon's blood is a red resin obtained from several different species of plants, notably Dracaena cinnabari, making it a specific type of plant gum/resin.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Dragon's blood is a red resin obtained from several different species of plants, notably Dracaena cinnabari, making it a specific type of plant gum/resin."}, {"found_name": "Bdellium", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 947, "target_cluster_name": "Bdellio", "source_book": "llm_generated", "evidence_snippet": "Bdellium is a type of resin obtained from various plants, often associated with Commiphora species, making it a specific type of plant gum/resin.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Bdellium is a type of resin obtained from various plants, often associated with Commiphora species, making it a specific type of plant gum/resin."}]}, {"canonical_name": "Parsnip", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "parsnips", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Parsnips", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Parsnips"], "contexts": ["vegetable plant"]}, {"entity_id": "parsnip", "book_id": "english_physician_1652", "name": "Parsnip", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["Parsnip", "Parsnep", "Parsnips"], "contexts": ["root mistaken for Hemlock root", "root vegetable for comparison"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Parsnips", "target_book": "english_physician_1652", "target_name": "Parsnip", "similarity": 0.962}], "id": 2356, "stable_key": "clu_8bf7f40a7dc5ac42", "ground_truth": {"modern_name": "Parsnip", "confidence": "high", "type": "plant", "linnaean": "Pastinaca sativa Linnaeus", "family": "Apiaceae", "note": "The text mentions mistaking its root for Hemlock, a known confusion between similar-looking plants.", "wikidata_id": "Q1479657", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Heracleum_maximum", "wikipedia_extract": "Heracleum maximum, commonly known as cow parsnip, is the only member of the genus Heracleum native to North America. It is also known as American cow-parsnip, Satan celery, Indian celery, Indian rhubarb, poison turnip or pushki. Cow parsnip is a tall herbaceous perennial plant, reaching heights of 3 metres (10 feet). The stems are hollow and densely hairy. The leaves are very large, up to 40 centimetres (16 inches) across and divided into three lobes. Cow parsnip has the characteristic flower umbels of the carrot family (Apiaceae), blooming from February to September."}, "cross_references": [{"found_name": "Angelica", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 385, "target_cluster_name": "Angelica", "source_book": "llm_generated", "evidence_snippet": "Both are tall herbaceous plants in the Apiaceae family, often found in similar habitats and sometimes confused due to their appearance.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are tall herbaceous plants in the Apiaceae family, often found in similar habitats and sometimes confused due to their appearance."}, {"found_name": "Carrot", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2940, "target_cluster_name": "Carrots", "source_book": "llm_generated", "evidence_snippet": "Both are root vegetables belonging to the Apiaceae family, sharing some morphological similarities and culinary uses.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are root vegetables belonging to the Apiaceae family, sharing some morphological similarities and culinary uses."}, {"found_name": "Parsley", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2339, "target_cluster_name": "Petrofellino", "source_book": "llm_generated", "evidence_snippet": "Both are herbaceous plants in the Apiaceae family, with similar leaf structures and culinary applications, though Parsnip is typically larger and has a different root.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are herbaceous plants in the Apiaceae family, with similar leaf structures and culinary applications, though Parsnip is typically larger and has a different root."}, {"found_name": "herbaceous plant", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1217, "target_cluster_name": "herbaceous Plant", "source_book": "llm_generated", "evidence_snippet": "Cow parsnip is explicitly described as a herbaceous perennial plant.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Cow parsnip is explicitly described as a herbaceous perennial plant."}, {"found_name": "Radish", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2519, "target_cluster_name": "Radish", "source_book": "llm_generated", "evidence_snippet": "Both are root vegetables commonly cultivated and consumed.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both are root vegetables commonly cultivated and consumed.", "is_reverse": true}, {"found_name": "Carrots", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2940, "target_cluster_name": "Carrots", "source_book": "llm_generated", "evidence_snippet": "Parsnips are similar root vegetables to carrots and often discussed in similar contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Parsnips are similar root vegetables to carrots and often discussed in similar contexts.", "is_reverse": true}]}, {"canonical_name": "Beetles", "category": "ANIMAL", "subcategory": "INSECT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "moths", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Moths", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["Moths"], "contexts": ["prevented by keeping birds in chests"]}, {"entity_id": "beetles", "book_id": "origin_of_species_darwin_1859", "name": "Beetles", "category": "ANIMAL", "subcategory": "INSECT", "count": 5, "variants": ["Beetles", "beetles"], "contexts": ["insular insects with soldered elytra", "insects with hardened forewings"]}, {"entity_id": "moths", "book_id": "origin_of_species_darwin_1859", "name": "moths", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["moths"], "contexts": ["pollinate orchidaceous plants"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Moths", "target_book": "origin_of_species_darwin_1859", "target_name": "Beetles", "similarity": 0.909}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Moths", "target_book": "origin_of_species_darwin_1859", "target_name": "moths", "similarity": 0.959}], "id": 2357, "stable_key": "clu_3f8ffcdad96208c7", "ground_truth": {"modern_name": "Beetles", "confidence": "high", "type": "animal", "note": "The cluster includes 'moths' but the primary term and most references point to 'beetles'. Beetles are insects with elytra. Moths are also insects but are typically winged and lack hardened forewings (elytra). The contexts also align more with beetles (e.g., 'soldered elytra').", "wikidata_id": "Q22671", "wikidata_description": "order of insects whose wings serve as a protective shell"}, "cross_references": [{"found_name": "Insects", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4, "target_cluster_name": "insects", "source_book": "llm_generated", "evidence_snippet": "Beetles are a type of insect.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Beetles are a type of insect."}]}, {"canonical_name": "Docks", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "docks", "book_id": "english_physician_1652", "name": "Docks", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["Docks", "Dock"], "contexts": ["herbs that make meat boil sooner", "herb"]}, {"entity_id": "dock-plant", "book_id": "origin_of_species_darwin_1859", "name": "dock-plant", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["dock-plant"], "contexts": ["plant where aphides are found"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Docks", "target_book": "origin_of_species_darwin_1859", "target_name": "dock-plant", "similarity": 0.892}], "id": 2358, "stable_key": "clu_7ba29931c2fa57ca", "ground_truth": {"modern_name": "Dock", "confidence": "high", "type": "plant", "linnaean": "Rumex L.", "family": "Polygonaceae", "note": "The term 'dock' refers to plants of the genus Rumex. The contexts ('herbs that make meat boil sooner', 'plant where aphides are found') are consistent with common uses and observations of dock plants.", "wikidata_id": "Q157643", "wikidata_description": "species of perennial flowering plant in the family Polygonaceae"}, "cross_references": [{"found_name": "Rush", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2937, "target_cluster_name": "Rush", "source_book": "llm_generated", "evidence_snippet": "Dock and Rush are both common wetland plants, often found in similar habitats and sometimes confused or grouped together in historical texts discussing marsh or waterside vegetation.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Dock and Rush are both common wetland plants, often found in similar habitats and sometimes confused or grouped together in historical texts discussing marsh or waterside vegetation."}]}, {"canonical_name": "palsy", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "palsie", "book_id": "english_physician_1652", "name": "Palsie", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["Palsie"], "contexts": ["paralysis", "loss of sensation or muscle control"]}, {"entity_id": "palsy", "book_id": "principles_of_psychology_james_1890", "name": "palsy", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 4, "variants": ["palsy"], "contexts": ["loss of muscle function", "paralysis or weakness"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Palsie", "target_book": "principles_of_psychology_james_1890", "target_name": "palsy", "similarity": 0.927}], "id": 2359, "stable_key": "clu_accbae30a8a8b71f", "ground_truth": {"modern_name": "Paralysis", "confidence": "high", "type": "disease", "modern_term": "Paralysis", "note": "The terms 'palsy' and 'palsie' are historical terms for paralysis, referring to a loss of muscle function or movement. The contexts directly support this interpretation.", "wikidata_id": "Q1788314", "wikidata_description": "human disease"}, "cross_references": [{"found_name": "Convulsions", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 652, "target_cluster_name": "Convulsions", "source_book": "llm_generated", "evidence_snippet": "Convulsions can be a symptom or a related neurological event that may co-occur with or be caused by conditions leading to paralysis.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Convulsions can be a symptom or a related neurological event that may co-occur with or be caused by conditions leading to paralysis."}]}, {"canonical_name": "Saxony", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "saxony", "book_id": "english_physician_1652", "name": "Saxony", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Saxony"], "contexts": ["neighbor to Brandenburg in place", "region where Garden Rue is used against Jaundice"]}, {"entity_id": "saxony", "book_id": "kosmos_humboldt_1845", "name": "Saxony", "category": "PLACE", "subcategory": "REGION", "count": 5, "variants": ["Saxony"], "contexts": ["mining districts with temperature data", "mining district in Germany"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Saxony", "target_book": "kosmos_humboldt_1845", "target_name": "Saxony", "similarity": 1.0}], "id": 2360, "stable_key": "clu_ab8bf0b6eda0d12a", "ground_truth": {"modern_name": "Saxony", "confidence": "high", "type": "place", "description": "A historical region in Germany, known for its geography and flora.", "note": "Refers to the geographical region, not a person.", "wikipedia_extract": "Saxony, officially the Free State of Saxony, is a landlocked state of Germany, bordering the states of Brandenburg, Saxony-Anhalt, Thuringia, and Bavaria, as well as the countries of Poland and the Czech Republic. Its capital is Dresden, and its largest city is Leipzig. Saxony is the tenth largest of Germany's sixteen states, with an area of 18,413 square kilometres (7,109 sq mi), and the seventh most populous, with more than 4 million inhabitants. The term Saxony has been in use for more than a millennium. It was used for the medieval Duchy of Saxony, the Electorate of Saxony of the Holy Roman Empire, the Kingdom of Saxony, and twice for a republic. The first Free State of Saxony was established in 1918 as a constituent state of the Weimar Republic."}, "cross_references": [{"found_name": "Bavaria", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2961, "target_cluster_name": "Bavaria", "source_book": "llm_generated", "evidence_snippet": "Bavaria is listed as a bordering state to Saxony in the description.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Bavaria is listed as a bordering state to Saxony in the description."}, {"found_name": "Leipzig", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2417, "target_cluster_name": "Leipzig", "source_book": "llm_generated", "evidence_snippet": "Leipzig is listed as the largest city in Saxony in the description.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Leipzig is listed as the largest city in Saxony in the description."}]}, {"canonical_name": "cowslip", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "cowslips", "book_id": "english_physician_1652", "name": "Cowslips", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Cowslips"], "contexts": ["flowering plant", "plant for conserves"]}, {"entity_id": "cowslip", "book_id": "origin_of_species_darwin_1859", "name": "cowslip", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["cowslip"], "contexts": ["plant differing from primrose", "plant used in cross-fertilization experiments"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Cowslips", "target_book": "origin_of_species_darwin_1859", "target_name": "cowslip", "similarity": 0.882}], "id": 2361, "stable_key": "clu_ebe4af27be82e95f", "ground_truth": {"modern_name": "Cowslip", "confidence": "high", "type": "plant", "linnaean": "Primula veris", "family": "Primulaceae", "description": "A common yellow-flowered woodland plant, often used medicinally.", "wikipedia_extract": "Primula veris, the cowslip, common cowslip, or cowslip primrose (syn. Primula officinalis Hill), is a herbaceous perennial  flowering plant in the primrose family Primulaceae. The species is native throughout most of temperate Europe and western Asia, and although absent from more northerly areas including much of northwest Scotland, it reappears in northernmost Sutherland and Orkney and in Scandinavia. This species frequently hybridizes with other Primulas such as the common primrose Primula vulgaris to form false oxlip (Primula × polyantha) which is often confused with true oxlip (Primula elatior), a much rarer plant. The common name cowslip may derive from the old English for cow dung, probably because the plant was often found growing amongst the manure in cow pastures. An alternative derivation simply refers to slippery or boggy ground; again, a typical habitat for this plant."}, "cross_references": [{"found_name": "Primrose", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1013, "target_cluster_name": "Primrose", "source_book": "llm_generated", "evidence_snippet": "Cowslip (Primula veris) is a closely related species within the same genus (Primula) and often discussed alongside the common primrose.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Cowslip (Primula veris) is a closely related species within the same genus (Primula) and often discussed alongside the common primrose.", "is_reverse": true}, {"found_name": "Primula", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4034, "target_cluster_name": "Primula", "source_book": "llm_generated", "evidence_snippet": "Cowslip is a species within the genus Primula.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Cowslip is a species within the genus Primula."}, {"found_name": "Primula elatior", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3970, "target_cluster_name": "elatior", "source_book": "llm_generated", "evidence_snippet": "Primula elatior is a closely related species within the same genus, often confused or grouped with cowslip.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Primula elatior is a closely related species within the same genus, often confused or grouped with cowslip."}, {"found_name": "herbaceous plant", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1217, "target_cluster_name": "herbaceous Plant", "source_book": "llm_generated", "evidence_snippet": "Cowslip is described as a herbaceous perennial flowering plant.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Cowslip is described as a herbaceous perennial flowering plant."}]}, {"canonical_name": "Sapa", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 6, "total_mentions": 13, "members": [{"entity_id": "sapa", "book_id": "english_physician_1652", "name": "Sapa", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["Sapa"], "contexts": ["boiled fruit juice for mouth diseases", "preparation for mouth diseases"]}, {"entity_id": "sapa", "book_id": "ricettario_fiorentino_1597", "name": "Sapa", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["Sapa", "sapa"], "contexts": ["reduced grape must, a sweetener", "syrup of grape must, used in preparation"]}, {"entity_id": "sabão", "book_id": "coloquios_da_orta_1563", "name": "sabão", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["sabão"], "contexts": ["substance sold with opium and bangue"]}, {"entity_id": "sabao", "book_id": "polyanthea_medicinal", "name": "Sabao", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 3, "variants": ["Sabao", "sabao", "sabaõ"], "contexts": ["ingredient in caustic", "soap"]}, {"entity_id": "sap", "book_id": "origin_of_species_darwin_1859", "name": "sap", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["sap"], "contexts": ["fluid circulating in plants"]}, {"entity_id": "sap", "book_id": "connexion_physical_sciences_somerville_1858", "name": "sap", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["sap"], "contexts": ["fluid in plants"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Sapa", "target_book": "ricettario_fiorentino_1597", "target_name": "Sapa", "similarity": 0.796}], "id": 2362, "stable_key": "clu_e66c98af2c2c2999", "ground_truth": {"modern_name": "Grape must reduction", "confidence": "high", "type": "concept", "description": "Concentrated and reduced grape juice, used as a sweetener and in preparations.", "note": "The term 'sap' in Darwin refers to plant fluid, distinct from the grape must reduction. 'Sapos' in Monardes refers to toads, a different category. 'Sabão' (soap) and 'saponis' (of soap) are related to saponification but contextually distinct.", "wikipedia_extract": "Balsamic vinegar (Italian: aceto balsamico) is a dark, concentrated, pungent, intensely flavoured vinegar made wholly or partially from grape must, which is freshly crushed grape juice with all the skins, seeds, and stems. The Italian word balsamico (from Latin balsamum, from Greek βάλσαμον, bálsamon) means 'balsam-like' in the sense of \"restorative\" or \"curative\"; cf. English 'balm'. Ultimately from Ancient Hebrew-Phoenician בשׂם (bāśām or besem, IPA [baːˈɬaːm]), the name means 'perfume or spice', with the consonant sequence of the letter 'λ' and 'σ' deriving from Ancient Greek to pronounce the שׂ (ś) sound, sounding back then as [ɬ]. The term balsamico in \"balsamic vinegar\" originates from the Latin word balsamum and the Greek word βάλσαμον, both conveying the idea of something \"restorative\" or \"curative\". The practice of cooking grapes can be traced back to ancient Roman times, where it was valued both as a medicinal remedy and a sweetener or condiment in cooking."}, "member_count": 6, "cross_references": [{"found_name": "vino", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1554, "target_cluster_name": "vino", "source_book": "llm_generated", "evidence_snippet": "Grape must reduction (Sapa) is a concentrated form of grape juice, the primary ingredient in wine.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Grape must reduction (Sapa) is a concentrated form of grape juice, the primary ingredient in wine.", "is_reverse": true}, {"found_name": "Balsam", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2139, "target_cluster_name": "Balſamo", "source_book": "llm_generated", "evidence_snippet": "Grape must reduction, known historically as Sapa, is a concentrated syrup derived from grape must. Balsam, in its various forms (e.g., Balsamis, Balſamo), refers to aromatic resins or oils, often with medicinal or perfumed properties. While distinct, both terms in historical texts can refer to viscous, concentrated, and often aromatic substances, sometimes with overlapping uses or descriptions in medicinal and culinary contexts. The term 'balsamic' in 'balsamic vinegar' itself suggests a connection to balsamic properties, implying a shared characteristic of concentrated, aromatic, and potentially medicinal qualities.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Grape must reduction, known historically as Sapa, is a concentrated syrup derived from grape must. Balsam, in its various forms (e.g., Balsamis, Balſamo), refers to aromatic resins or oils, often with medicinal or perfumed properties. While distinct, both terms in historical texts can refer to viscous, concentrated, and often aromatic substances, sometimes with overlapping uses or descriptions in medicinal and culinary contexts. The term 'balsamic' in 'balsamic vinegar' itself suggests a connection to balsamic properties, implying a shared characteristic of concentrated, aromatic, and potentially medicinal qualities."}]}, {"canonical_name": "venenos", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 5, "total_mentions": 11, "members": [{"entity_id": "venemous", "book_id": "english_physician_1652", "name": "Venemous", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Venemous"], "contexts": ["poisonous substances"]}, {"entity_id": "venenos", "book_id": "historia_medicinal_monardes_1574", "name": "venenos", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 6, "variants": ["venenos", "Venenos", "venenum"], "contexts": ["poisons that harm the body", "plural of poisonous substance"]}, {"entity_id": "poisons", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "poisons", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["poisons"], "contexts": ["deleterious substances"]}, {"entity_id": "poison", "book_id": "origin_of_species_darwin_1859", "name": "Poison", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["poison", "Poison"], "contexts": ["toxic substance", "substance with discussed effects"]}, {"entity_id": "poison", "book_id": "principles_of_psychology_james_1890", "name": "poison", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["poison"], "contexts": ["toxic substance"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Venemous", "target_book": "historia_medicinal_monardes_1574", "target_name": "venenos", "similarity": 0.908}], "id": 2363, "stable_key": "clu_60772dc6a772cf28", "ground_truth": {"modern_name": "Poisons", "confidence": "high", "type": "chemical", "wikidata_id": "Q114953", "wikidata_description": "toxic effect of a biological or chemical agent"}, "member_count": 5, "cross_references": [{"found_name": "Antidote", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 880, "target_cluster_name": "antidotos", "source_book": "llm_generated", "evidence_snippet": "Antidotes are specifically designed to counteract the effects of poisons.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Antidotes are specifically designed to counteract the effects of poisons."}, {"found_name": "Alexipharmic", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2089, "target_cluster_name": "Alexipharmacum", "source_book": "llm_generated", "evidence_snippet": "Alexipharmics are substances believed to counteract poisons or disease, closely related to the concept of antidotes and poisons.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Alexipharmics are substances believed to counteract poisons or disease, closely related to the concept of antidotes and poisons."}, {"found_name": "Alkaline substances", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4109, "target_cluster_name": "substances alcalines", "source_book": "llm_generated", "evidence_snippet": "Certain alkaline substances were historically investigated or used in relation to poisons, either as poisons themselves or in attempts to neutralize them.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Certain alkaline substances were historically investigated or used in relation to poisons, either as poisons themselves or in attempts to neutralize them."}, {"found_name": "Alcohol", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 131, "target_cluster_name": "alcohol", "source_book": "llm_generated", "evidence_snippet": "Alcohol, in concentrated forms or large quantities, can act as a poison and was a subject of study in relation to its toxic effects.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Alcohol, in concentrated forms or large quantities, can act as a poison and was a subject of study in relation to its toxic effects."}, {"found_name": "Antimony", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 40, "target_cluster_name": "Antimonio", "source_book": "llm_generated", "evidence_snippet": "Antimony compounds were known and used historically, some with toxic properties, placing them within the sphere of poisons.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Antimony compounds were known and used historically, some with toxic properties, placing them within the sphere of poisons."}, {"found_name": "Dog feces", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3932, "target_cluster_name": "Dogs-turd", "source_book": "llm_generated", "evidence_snippet": "Animal excrement, including dog feces, was sometimes considered a poison or used in folk remedies with potential toxic effects.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Animal excrement, including dog feces, was sometimes considered a poison or used in folk remedies with potential toxic effects."}, {"found_name": "Horse dung", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3279, "target_cluster_name": "Horse dung", "source_book": "llm_generated", "evidence_snippet": "Similar to dog feces, horse dung was sometimes associated with medicinal or toxic properties in historic