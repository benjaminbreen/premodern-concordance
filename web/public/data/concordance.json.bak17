ntity_id": "red_sea", "book_id": "kosmos_humboldt_1845", "name": "Red Sea", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Red Sea"], "contexts": ["sea", "geographic body of water"]}, {"entity_id": "red_seas", "book_id": "kosmos_humboldt_1845", "name": "Red Seas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Red Seas"], "contexts": ["sea with fissures"]}, {"entity_id": "red_sea", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Red Sea", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Red Sea"], "contexts": ["sea where tides are perceptible", "sea with different marine plants"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Red sea", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Mer Rouge", "similarity": 0.892}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Red sea", "target_book": "kosmos_humboldt_1845", "target_name": "Red Sea", "similarity": 0.982}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Red sea", "target_book": "kosmos_humboldt_1845", "target_name": "Red Seas", "similarity": 0.973}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Red sea", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Red Sea", "similarity": 0.982}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Mer Rouge", "target_book": "kosmos_humboldt_1845", "target_name": "Red Seas", "similarity": 0.883}, {"source_book": "kosmos_humboldt_1845", "source_name": "Red Sea", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Red Sea", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Red Seas", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Red Sea", "similarity": 0.969}], "id": 370, "stable_key": "clu_697eb0305b19cb47", "ground_truth": {"modern_name": "Red Sea", "confidence": "high", "type": "place", "description": "A sea route connecting East and West.", "wikipedia_extract": "The Red Sea is a sea inlet of the Indian Ocean, lying between Africa and Asia. Its connection to the ocean is in the south, through the Bab-el-Mandeb Strait and the Gulf of Aden. To the north of the Red Sea lies the Sinai Peninsula, the Gulf of Aqaba, and the Gulf of Suez, which leads to the Suez Canal. It is underlain by the Red Sea Rift, which is part of the Great Rift Valley. The Red Sea has a surface area of roughly 438,000 km2 (169,000 sq mi), is about 2,250 km (1,400 mi) long, and 355 km (221 mi) across at its widest point. It has an average depth of 490 m (1,610 ft), and in the central Suakin Trough, it reaches its maximum depth of 2,730 m (8,960 ft)."}, "cross_references": [{"found_name": "Indian Ocean", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 362, "target_cluster_name": "Indian Ocean", "source_book": "llm_generated", "evidence_snippet": "The description states the Indo-Pacific bottlenose dolphin lives in the waters around the Red Sea.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The description states the Indo-Pacific bottlenose dolphin lives in the waters around the Red Sea.", "is_reverse": true}, {"found_name": "Aden", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1954, "target_cluster_name": "Aden", "source_book": "llm_generated", "evidence_snippet": "Aden is a port city located at the entrance of the Red Sea, making it geographically significant to the Red Sea's maritime traffic and historical context.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Aden is a port city located at the entrance of the Red Sea, making it geographically significant to the Red Sea's maritime traffic and historical context."}, {"found_name": "Africa", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3, "target_cluster_name": "Africa", "source_book": "llm_generated", "evidence_snippet": "The Red Sea forms a significant part of the eastern coastline of Africa.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Red Sea forms a significant part of the eastern coastline of Africa."}, {"found_name": "Asia", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 231, "target_cluster_name": "Asie", "source_book": "llm_generated", "evidence_snippet": "The Red Sea forms a significant part of the western coastline of Asia.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Red Sea forms a significant part of the western coastline of Asia."}, {"found_name": "Arabia", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 169, "target_cluster_name": "Arabia", "source_book": "llm_generated", "evidence_snippet": "The Red Sea lies to the west of the Arabian Peninsula.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Red Sea lies to the west of the Arabian Peninsula."}]}, {"canonical_name": "jaws", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 15, "members": [{"entity_id": "jaws", "book_id": "english_physician_1652", "name": "Jaws", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["Jaws"], "contexts": ["part of the mouth with inflammation", "body part affected by ailments"]}, {"entity_id": "jaws", "book_id": "origin_of_species_darwin_1859", "name": "jaws", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 8, "variants": ["jaws"], "contexts": ["part homologous with limbs", "mouthparts for biting"]}, {"entity_id": "jaw", "book_id": "origin_of_species_darwin_1859", "name": "jaw", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["jaw"], "contexts": ["part of the mouth"]}, {"entity_id": "jaw", "book_id": "principles_of_psychology_james_1890", "name": "jaw", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["jaw"], "contexts": ["organ of reaction"]}, {"entity_id": "jaws", "book_id": "first_principles_spencer_1862", "name": "jaws", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["jaws"], "contexts": ["bones of the mouth"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Jaws", "target_book": "origin_of_species_darwin_1859", "target_name": "jaws", "similarity": 0.979}, {"source_book": "english_physician_1652", "source_name": "Jaws", "target_book": "first_principles_spencer_1862", "target_name": "jaws", "similarity": 0.979}, {"source_book": "origin_of_species_darwin_1859", "source_name": "jaws", "target_book": "principles_of_psychology_james_1890", "target_name": "jaw", "similarity": 0.911}, {"source_book": "origin_of_species_darwin_1859", "source_name": "jaws", "target_book": "first_principles_spencer_1862", "target_name": "jaws", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "jaw", "target_book": "principles_of_psychology_james_1890", "target_name": "jaw", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "jaw", "target_book": "first_principles_spencer_1862", "target_name": "jaws", "similarity": 0.911}, {"source_book": "principles_of_psychology_james_1890", "source_name": "jaw", "target_book": "first_principles_spencer_1862", "target_name": "jaws", "similarity": 0.911}], "id": 371, "stable_key": "clu_047510438f6d02de", "ground_truth": {"modern_name": "Jaw", "confidence": "high", "type": "animal", "note": "Refers to the anatomical structure of the jaw, relevant in both medical and evolutionary contexts.", "wikidata_id": "Q3586", "wikidata_description": "province of Indonesia, on island of Java", "wikipedia_url": "https://en.wikipedia.org/wiki/East%20Java", "wikipedia_extract": "East Java (Indonesian: Jawa Timur, Javanese: ꦙꦮꦶꦮꦺꦠꦤ꧀, romanized: Jawi Wétan, Madurese: Jhâbâ Tèmor) is a province of Indonesia located in the easternmost third of Java island. It has a land border only with the province of Central Java to the west; the Java Sea and the Indian Ocean border its northern and southern coasts, respectively, while the narrow Bali Strait to the east separates Java from Bali by around 2.29 kilometres (1.42 mi). Located in eastern Java, the province also includes the island of Madura (which is connected to Java by the longest bridge in Indonesia, the Suramadu Bridge), as well as the Kangean islands and other smaller island groups located further east (in the northern Bali Sea) and the Masalembu archipelago to the north. Its capital is Surabaya, the second largest city in Indonesia, a major industrial center and also a major business center. Banyuwangi is the largest regency in East Java and the largest on the island of Java. The province covers a land area of 48,036.84 square kilometres (18,547.13 sq mi), and according to the 2010 Census, there were 37,476,757 people residing there, making it Indonesia's second-most-populous province; the 2020 Census showed an increase to 40,665,696 people, while the official estimate for mid 2024 was 41,914,499 (comprising 20,848,660 males and 20,965,880 females)."}, "cross_references": [{"found_name": "Tooth", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2705, "target_cluster_name": "Tooth", "source_book": "llm_generated", "evidence_snippet": "The jawbone houses and supports the teeth.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The jawbone houses and supports the teeth.", "is_reverse": true}]}, {"canonical_name": "Oscillations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 15, "members": [{"entity_id": "oscillations", "book_id": "relation_historique_humboldt_vol3_1825", "name": "oscillations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["oscillations", "oscillation", "oscillations diurnes"], "contexts": ["measurement of magnetic forces", "measure of magnetic force"]}, {"entity_id": "oscillations", "book_id": "principles_of_psychology_james_1890", "name": "oscillations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["oscillations"], "contexts": ["back-and-forth movements", "fluctuations in accuracy and error"]}, {"entity_id": "oscillations", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Oscillations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["Oscillations", "oscillations"], "contexts": ["three kinds in the ocean", "wave-like movements in fluid"]}, {"entity_id": "oscillations", "book_id": "first_principles_spencer_1862", "name": "oscillations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["oscillations"], "contexts": ["regular fluctuations", "vertical and lateral, caused by ocean-swell"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "oscillations", "target_book": "principles_of_psychology_james_1890", "target_name": "oscillations", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "oscillations", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Oscillations", "similarity": 0.991}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "oscillations", "target_book": "first_principles_spencer_1862", "target_name": "oscillations", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "oscillations", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Oscillations", "similarity": 0.991}, {"source_book": "principles_of_psychology_james_1890", "source_name": "oscillations", "target_book": "first_principles_spencer_1862", "target_name": "oscillations", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Oscillations", "target_book": "first_principles_spencer_1862", "target_name": "oscillations", "similarity": 0.991}], "id": 372, "stable_key": "clu_a7bd35781961ad09", "ground_truth": {"modern_name": "Oscillation", "confidence": "high", "type": "concept", "wikidata_id": "Q170475", "wikidata_description": "repetitive variation of some measure about a central value", "wikipedia_url": "https://en.wikipedia.org/wiki/Oscillation", "wikipedia_extract": "Oscillation is the repetitive or periodic variation, typically in time, of some measure about a central value (often a point of equilibrium) or between two or more different states. Familiar examples of oscillation include a swinging pendulum and alternating current. Oscillations can be used in physics to approximate complex interactions, such as those between atoms. Oscillations occur not only in mechanical systems but also in dynamic systems in virtually every area of science: for example the beating of the human heart (for circulation),  business cycles in economics, predator–prey population cycles in ecology, geothermal geysers in geology, vibration of strings in guitar and other string instruments, periodic firing of nerve cells in the brain, and the periodic swelling of Cepheid variable stars in astronomy. The term vibration is precisely used to describe a mechanical oscillation. Oscillation, especially rapid oscillation, may be an undesirable phenomenon in process control and control theory (e.g."}, "cross_references": [{"found_name": "Centrifugal force", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 315, "target_cluster_name": "Centrifugal force", "source_book": "llm_generated", "evidence_snippet": "Centrifugal force is a key concept in understanding circular motion, a specific type of oscillation.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Centrifugal force is a key concept in understanding circular motion, a specific type of oscillation."}, {"found_name": "Circular polarization", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1952, "target_cluster_name": "Circular polarization", "source_book": "llm_generated", "evidence_snippet": "Circular polarization describes a type of wave oscillation.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Circular polarization describes a type of wave oscillation."}, {"found_name": "Equilibrium", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 247, "target_cluster_name": "equilibrium", "source_book": "llm_generated", "evidence_snippet": "Oscillation is defined as variation about a central value or point of equilibrium.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Oscillation is defined as variation about a central value or point of equilibrium."}, {"found_name": "Galvanism", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3585, "target_cluster_name": "galvanism", "source_book": "llm_generated", "evidence_snippet": "Galvanism, the study of electricity produced by chemical reactions, is closely related to the study of electric currents and their oscillatory behavior.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Galvanism, the study of electricity produced by chemical reactions, is closely related to the study of electric currents and their oscillatory behavior."}, {"found_name": "nutation", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1833, "target_cluster_name": "nutation", "source_book": "first_principles_spencer_1862", "evidence_snippet": "velocity. Then, too, there is the revolution of the line of apsides, which in course of time moves round the heavens—not regularly, but through complex oscillations. And further we have variations in ", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of variation in planetary axes"}]}, {"canonical_name": "Scotland", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 4, "total_mentions": 14, "members": [{"entity_id": "scotland", "book_id": "english_physician_1652", "name": "Scotland", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Scotland"], "contexts": ["location where the plant grows", "country where Winter-Green grows"]}, {"entity_id": "scotland", "book_id": "origin_of_species_darwin_1859", "name": "Scotland", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Scotland"], "contexts": ["country with scored mountains from ice", "mountains with scored flanks and polished surfaces"]}, {"entity_id": "scotland", "book_id": "kosmos_humboldt_1845", "name": "Scotland", "category": "PLACE", "subcategory": "COUNTRY", "count": 4, "variants": ["Scotland"], "contexts": ["country with coal beds", "Northern hemisphere location"]}, {"entity_id": "scotland", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Scotland", "category": "PLACE", "subcategory": "COUNTRY", "count": 6, "variants": ["Scotland"], "contexts": ["location of trigonometrical survey", "country around which wave goes"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Scotland", "target_book": "origin_of_species_darwin_1859", "target_name": "Scotland", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Scotland", "target_book": "kosmos_humboldt_1845", "target_name": "Scotland", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Scotland", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Scotland", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Scotland", "target_book": "kosmos_humboldt_1845", "target_name": "Scotland", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Scotland", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Scotland", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Scotland", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Scotland", "similarity": 1.0}], "id": 373, "stable_key": "clu_3a6b1c1fdf6bb9b1", "ground_truth": {"wikipedia_extract": "Scotland is a country that is part of the United Kingdom. It contains nearly one-third of the United Kingdom's land area, consisting of the northern part of the island of Great Britain and more than 790 adjacent islands, principally in the archipelagos of the Hebrides and the Northern Isles. In 2022, the country's population was about 5.4 million. Its capital city is Edinburgh, whilst Glasgow is the largest city and the most populous of the cities of Scotland. To the south-east, Scotland has its only land border with England; otherwise it is surrounded by the Atlantic Ocean to the north and west, the North Sea to the north-east and east, and the Irish Sea to the south. The legislature, the Scottish Parliament, elects 129 members to represent 73 constituencies."}, "cross_references": [{"found_name": "Great Britain", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 776, "target_cluster_name": "Great Britain", "source_book": "llm_generated", "evidence_snippet": "Scotland is a constituent country of Great Britain.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Scotland is a constituent country of Great Britain.", "is_reverse": true}, {"found_name": "Yorkshire", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 951, "target_cluster_name": "Yorkshire", "source_book": "llm_generated", "evidence_snippet": "Scotland is a country within Great Britain, often discussed in relation to English regions like Yorkshire.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Scotland is a country within Great Britain, often discussed in relation to English regions like Yorkshire.", "is_reverse": true}]}, {"canonical_name": "montagnes", "category": "PLACE", "subcategory": "REGION", "book_count": 4, "total_mentions": 14, "members": [{"entity_id": "mountain", "book_id": "origin_of_species_darwin_1859", "name": "mountain", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["mountain"], "contexts": ["large natural elevation of the earth's surface", "high-altitude terrain"]}, {"entity_id": "montagnes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "montagnes", "category": "PLACE", "subcategory": "REGION", "count": 10, "variants": ["montagnes"], "contexts": ["elevated landforms", "natural elevations of land"]}, {"entity_id": "montagna", "book_id": "ricettario_fiorentino_1597", "name": "Montagna", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Montagna"], "contexts": ["Mountainous region"]}, {"entity_id": "mountain_peaks", "book_id": "first_principles_spencer_1862", "name": "mountain peaks", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["mountain peaks"], "contexts": ["highest points of mountains"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "mountain", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "montagnes", "similarity": 0.911}, {"source_book": "origin_of_species_darwin_1859", "source_name": "mountain", "target_book": "ricettario_fiorentino_1597", "target_name": "Montagna", "similarity": 0.894}, {"source_book": "origin_of_species_darwin_1859", "source_name": "mountain", "target_book": "first_principles_spencer_1862", "target_name": "mountain peaks", "similarity": 0.903}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "montagnes", "target_book": "ricettario_fiorentino_1597", "target_name": "Montagna", "similarity": 0.928}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "montagnes", "target_book": "first_principles_spencer_1862", "target_name": "mountain peaks", "similarity": 0.893}], "id": 374, "stable_key": "clu_08c6e71274484b0e", "ground_truth": {"modern_name": null, "confidence": "high", "type": "place", "note": "The cluster includes 'montagnes' (French for mountains), 'mountain', 'Montagna' (likely related to mountain), and 'mountain peaks'. The general concept of a mountain or mountainous region is clear.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Mountain", "wikipedia_extract": "A mountain is an elevated portion of the surface of a planet, generally with steep sides that show significant exposed bedrock. Although definitions vary, a mountain may differ from a plateau in having a limited summit area, and is usually higher than a hill, typically rising at least several hundred metres (a few thousand feet) above the surrounding land. A few mountains are isolated summits, but most occur in mountain ranges. Mountains are formed through tectonic forces, erosion, or volcanism, which act on time scales of up to tens of millions of years. Once mountain building ceases, mountains are slowly leveled through the action of weathering, through slumping and other forms of mass wasting, as well as through erosion by rivers and glaciers. High elevations on mountains produce colder climates than at sea level at similar latitude."}, "cross_references": []}, {"canonical_name": "commerce", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 14, "members": [{"entity_id": "commerce", "book_id": "relation_historique_humboldt_vol3_1825", "name": "commerce", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 8, "variants": ["commerce", "Commercf", "commerce de la France avec les colonies de l'Amérique", "commerce françois", "commerce intérieur", "commerce libre"], "contexts": ["economic activity", "trade"]}, {"entity_id": "commerce", "book_id": "kosmos_humboldt_1845", "name": "commerce", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["commerce"], "contexts": ["exchange of goods and services"]}, {"entity_id": "commercio", "book_id": "coloquios_da_orta_1563", "name": "commercio", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["commercio", "commercio oriental"], "contexts": ["trade", "trade and commerce"]}, {"entity_id": "commerce", "book_id": "first_principles_spencer_1862", "name": "commerce", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["commerce", "Commerce"], "contexts": ["development from simple to complex", "activity of buying and selling"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "commerce", "target_book": "kosmos_humboldt_1845", "target_name": "commerce", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "commerce", "target_book": "coloquios_da_orta_1563", "target_name": "commercio", "similarity": 0.953}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "commerce", "target_book": "first_principles_spencer_1862", "target_name": "commerce", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "commerce", "target_book": "coloquios_da_orta_1563", "target_name": "commercio", "similarity": 0.953}, {"source_book": "kosmos_humboldt_1845", "source_name": "commerce", "target_book": "first_principles_spencer_1862", "target_name": "commerce", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "commercio", "target_book": "first_principles_spencer_1862", "target_name": "commerce", "similarity": 0.953}], "id": 375, "stable_key": "clu_02d4f27d8e73b02d", "ground_truth": {"modern_name": "Commerce", "confidence": "high", "type": "concept", "wikidata_id": "Q26643", "wikidata_description": "large-scale organized system related to the exchange of goods and services"}, "cross_re