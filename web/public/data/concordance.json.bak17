inciples_of_psychology_james_1890", "source_name": "fidelity", "target_book": "first_principles_spencer_1862", "target_name": "loyalty", "similarity": 0.951}], "id": 4237, "stable_key": "clu_83376ae26965d050", "ground_truth": {"modern_name": "Loyalty", "confidence": "high", "type": "concept", "wikidata_id": "Q1132131", "wikidata_description": "faithfulness or devotion to a person, country, group, or cause"}, "cross_references": []}, {"canonical_name": "mental derangement", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "mental_derangement", "book_id": "principles_of_psychology_james_1890", "name": "mental derangement", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["mental derangement"], "contexts": ["disorder of the mind"]}, {"entity_id": "deranged", "book_id": "connexion_physical_sciences_somerville_1858", "name": "deranged", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["deranged"], "contexts": ["disrupted or disturbed"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "mental derangement", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "deranged", "similarity": 0.902}], "id": 4238, "stable_key": "clu_148cccf0bedfaa11", "ground_truth": {"modern_name": "Mental disorder", "confidence": "high", "type": "disease", "modern_term": "Mental disorder", "wikidata_id": "Q18966384", "wikidata_description": "Human disease"}, "cross_references": [{"found_name": "Mania", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1612, "target_cluster_name": "Mania", "source_book": "llm_generated", "evidence_snippet": "Mania is a specific type of mental disorder.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Mania is a specific type of mental disorder.", "is_reverse": true}, {"found_name": "confusion", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2814, "target_cluster_name": "confusion", "source_book": "llm_generated", "evidence_snippet": "Confusion is a symptom of various mental disorders, including dementia.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Confusion is a symptom of various mental disorders, including dementia.", "is_reverse": true}]}, {"canonical_name": "Julius Cæsar", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "julius_cæsar", "book_id": "principles_of_psychology_james_1890", "name": "Julius Cæsar", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Julius Cæsar"], "contexts": ["historical figure dictating letters"]}, {"entity_id": "julius_cæsar", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Julius Cæsar", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Julius Cæsar"], "contexts": ["initiated the Julian Calendar"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Julius Cæsar", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Julius Cæsar", "similarity": 0.795}], "id": 4239, "stable_key": "clu_5a5c25a0b69bedcc", "ground_truth": {"modern_name": "Julius Caesar", "confidence": "high", "type": "person", "birth_year": -100, "death_year": -44, "description": "Roman general and dictator, initiated the Julian Calendar.", "wikidata_id": "Q1048", "wikidata_description": "Roman general and dictator"}, "cross_references": []}, {"canonical_name": "negative", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "negative", "book_id": "principles_of_psychology_james_1890", "name": "negative", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["negative"], "contexts": ["type of error in time estimation"]}, {"entity_id": "negative", "book_id": "connexion_physical_sciences_somerville_1858", "name": "negative", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["negative"], "contexts": ["other electric state"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "negative", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "negative", "similarity": 1.0}], "id": 4240, "stable_key": "clu_41ab282f146933d6", "ground_truth": {"modern_name": "Negative", "confidence": "high", "type": "concept", "note": "The term 'negative' has multiple meanings, including errors in judgment and electrical states, and its specific historical application requires further contextual information.", "wikidata_id": "Q1478451", "wikidata_description": "grammatical form that encodes negative polarity or falsity"}, "cross_references": []}, {"canonical_name": "pendulum-strokes", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "pendulum-strokes", "book_id": "principles_of_psychology_james_1890", "name": "pendulum-strokes", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["pendulum-strokes"], "contexts": ["sounds from pendulum movement"]}, {"entity_id": "pendulum", "book_id": "first_principles_spencer_1862", "name": "pendulum", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["pendulum"], "contexts": ["alters its rate of oscillation when taken to equator"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "pendulum-strokes", "target_book": "first_principles_spencer_1862", "target_name": "pendulum", "similarity": 0.884}], "id": 4241, "stable_key": "clu_247630a81123a1c0", "ground_truth": {"modern_name": "pendulum", "confidence": "high", "type": "object", "note": "The term 'pendulum-strokes' likely refers to the oscillations or beats of a pendulum, particularly in the context of me