_count": 3, "total_mentions": 9, "members": [{"entity_id": "oxus", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Oxus", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Oxus"], "contexts": ["ancient name for Amou/Djihoun river", "ancient name for Amou river"]}, {"entity_id": "oxus", "book_id": "kosmos_humboldt_1845", "name": "Oxus", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Oxus"], "contexts": ["river in Central Asia", "river"]}, {"entity_id": "oxus", "book_id": "coloquios_da_orta_1563", "name": "Oxus", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Oxus"], "contexts": ["river, also known as Amu-darya", "river east of which Uzbeks took lands"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Oxus", "target_book": "kosmos_humboldt_1845", "target_name": "Oxus", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Oxus", "target_book": "coloquios_da_orta_1563", "target_name": "Oxus", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Oxus", "target_book": "coloquios_da_orta_1563", "target_name": "Oxus", "similarity": 1.0}], "id": 970, "stable_key": "clu_e34b19c6d33f6306", "ground_truth": {"modern_name": "Amu Darya", "confidence": "high", "type": "place", "description": "A major river in Central Asia, historically known as the Oxus.", "note": "Also referred to as Djihoun in historical texts.", "wikipedia_extract": "The Amu Darya, historically known as the Oxus, is a major river in Central Asia which flows through Afghanistan, Tajikistan, Turkmenistan, and Uzbekistan. Rising in the Pamir Mountains, north of the Hindu Kush, the Amu Darya is formed by the confluence of the Vakhsh and Panj rivers, in the Tigrovaya Balka Nature Reserve on the border between Afghanistan and Tajikistan, and flows from there north-westwards into the southern remnants of the Aral Sea. However, today the Amu Darya does not reach the Aral Sea, and its mouth is in a dried-up area, of what was once the Aral Sea. In its upper course, the river forms part of Afghanistan's northern border with Tajikistan, Uzbekistan, and Turkmenistan. In ancient history, the river was regarded as the boundary of Greater Iran with Turan, which roughly corresponded to present-day Central Asia. The Amu Darya has a flow of about 70 cubic kilometres per year on average."}, "cross_references": [{"found_name": "Balassia", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "podia conhecer a geographia do interior tio bem como a do littoral; e a sua Balassia, isto é o Badakhshan, ficava muito longe d'ali, para os lados do alto Oxus e do Pamir. Ibn Batuta explica muito bem", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym"}]}, {"canonical_name": "Niebuhr", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "niebuhr", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Niebuhr", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Niebuhr"], "contexts": ["observer of continental atmosphere temperatures"]}, {"entity_id": "niebuhr", "book_id": "kosmos_humboldt_1845", "name": "Niebuhr", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Niebuhr"], "contexts": ["hypothesized Scythians were Mongolians"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Niebuhr", "target_book": "kosmos_humboldt_1845", "target_name": "Niebuhr", "similarity": 1.0}], "id": 971, "stable_key": "clu_561980b0d945e981", "ground_truth": {"modern_name": "Carsten Niebuhr", "confidence": "high", "type": "person", "birth_year": 1733, "death_year": 1815, "description": "Danish geographer and explorer of Arabia", "note": "The context of visiting Djidda and observations aligns with Carsten Niebuhr's travels in Arabia.", "wikidata_id": "Q57420", "wikidata_description": "German mathematician, botanist, cartographer and explorer in Danish service (1733–1815)", "wikipedia_url": "https://en.wikipedia.org/wiki/Carsten%20Niebuhr", "wikipedia_extract": "Carsten Niebuhr, or Karsten Niebuhr (17 March 1733 Lüdingworth – 26 April 1815 Meldorf, Dithmarschen), was a German mathematician, cartographer, and explorer in the service of Denmark-Norway. He is renowned for his participation in the Danish Arabia expedition (1761-1767). He was the father of the Danish-German statesman and historian Barthold Georg Niebuhr, who published an account of his father's life in 1817. Niebuhr was born in Lüdingworth (now a part of Cuxhaven, Lower Saxony) in what was then Bremen-Verden. His father Barthold Niebuhr (1704-1749) was a successful farmer and owned his own property. Carsten and his sister were educated at home by a local school teacher, then he attended the Latin School in Otterndorf, near Cuxhaven."}, "cross_references": [{"found_name": "Alexander von Humboldt", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 42, "target_cluster_name": "Humboldt", "source_book": "llm_generated", "evidence_snippet": "Both were prominent explorers and naturalists who undertook significant expeditions, with Humboldt's work in South America and Niebuhr's in Arabia being foundational for their respective fields.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were prominent explorers and naturalists who undertook significant expeditions, with Humboldt's work in South America and Niebuhr's in Arabia being foundational for their respective fields."}, {"found_name": "James Rennell", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2392, "target_cluster_name": "Rennell", "source_book": "llm_generated", "evidence_snippet": "Both were influential geographers and cartographers who made significant contributions to the mapping and understanding of previously less-explored regions (Rennell in Africa and India, Niebuhr in Arabia).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were influential geographers and cartographers who made significant contributions to the mapping and understanding of previously less-explored regions (Rennell in Africa and India, Niebuhr in Arabia)."}, {"found_name": "Christopher Columbus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 327, "target_cluster_name": "Columbus", "source_book": "llm_generated", "evidence_snippet": "Both were European explorers who undertook voyages to distant lands, significantly expanding European knowledge of geography and cultures.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were European explorers who undertook voyages to distant lands, significantly expanding European knowledge of geography and cultures."}]}, {"canonical_name": "Reich", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "mm__reich", "book_id": "relation_historique_humboldt_vol3_1825", "name": "MM. Reich", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["MM. Reich"], "contexts": ["scholar who collaborated on a mine observation"]}, {"entity_id": "reich", "book_id": "kosmos_humboldt_1845", "name": "Reich", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["Reich"], "contexts": ["made observations on elevation", "performed torsion balance experiments"]}, {"entity_id": "reich", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Reich", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Reich"], "contexts": ["observed mine temperatures", "Professor who found mean temperature increase"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "MM. Reich", "target_book": "kosmos_humboldt_1845", "target_name": "Reich", "similarity": 0.875}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "MM. Reich", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Reich", "similarity": 0.875}, {"source_book": "kosmos_humboldt_1845", "source_name": "Reich", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Reich", "similarity": 1.0}], "id": 972, "stable_key": "clu_d014d04207a6ee87", "ground_truth": {"modern_name": "Johann Christian Reich", "confidence": "high", "type": "person", "birth_year": 1741, "death_year": 1810, "description": "German metallurgist and mine inspector", "note": "The collaboration on mine observations and mine temperatures points to J.C. Reich, a notable figure in mining and metallurgy.", "wikidata_id": "Q21294804", "wikidata_description": "German medalist (1740–1814)"}, "cross_references": []}, {"canonical_name": "meaning", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "meaning", "book_id": "principles_of_psychology_james_1890", "name": "meaning", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["meaning"], "contexts": ["significance or interpretation", "significance or import of a thought"]}, {"entity_id": "meanings", "book_id": "principles_of_psychology_james_1890", "name": "meanings", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["meanings"], "contexts": ["significance or import of words and thoughts"]}, {"entity_id": "meaning", "book_id": "kosmos_humboldt_1845", "name": "meaning", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["meaning"], "contexts": ["significance of a word"]}, {"entity_id": "meaning", "book_id": "first_principles_spencer_1862", "name": "meaning", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["meaning"], "contexts": ["fixed by processes"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "meaning", "target_book": "kosmos_humboldt_1845", "target_name": "meaning", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "meaning", "target_book": "first_principles_spencer_1862", "target_name": "meaning", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "meanings", "target_book": "kosmos_humboldt_1845", "target_name": "meaning", "similarity": 0.922}, {"source_book": "principles_of_psychology_james_1890", "source_name": "meanings", "target_book": "first_principles_spencer_1862", "target_name": "meaning", "similarity": 0.922}, {"source_book": "kosmos_humboldt_1845", "source_name": "meaning", "target_book": "first_principles_spencer_1862", "target_name": "meaning", "similarity": 1.0}], "id": 973, "stable_key": "clu_e3a53e6a2d627225", "ground_truth": {"modern_name": "Meaning", "confidence": "high", "type": "concept", "note": "This refers to the general philosophical and linguistic concept of meaning, as discussed in works on psychology and general principles.", "wikidata_id": "Q16877783", "wikidata_description": "nebulously defined concept used in psychology as well as in other fields such as philosophy, linguistics, semiotics and sociology, in which an item, entity, or action represents, signals, or conveys", "wikipedia_url": "https://en.wikipedia.org/wiki/Meaning%20%28psychology%29", "wikipedia_extract": "Meaning is an epistemological concept used in multiple disciplines, such as psychology, philosophy, linguistics, semiotics, and sociology, with its definition depending upon the field of study by which it is being used. These multidisciplinary uses of the term are not independent and can more or less overlap; each construction of the term meaning can correspond with related constructions in other fields. The logical positivists, for example, associated meaning with scientific verification. n of idea. Like an idea, a meaning is said to be expressed or communicated by an utterance. A meaning explains the occurrence of a particular word in the sense that if there had been a different meaning to be expressed, a different word would probably have appeared."}, "cross_references": [{"found_name": "purpose", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2740, "target_cluster_name": "purpose", "source_book": "llm_generated", "evidence_snippet": "The search for 'purpose' is often intertwined with the search for 'meaning' in life or events.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The search for 'purpose' is often intertwined with the search for 'meaning' in life or events.", "is_reverse": true}, {"found_name": "pure nothing", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "principles_of_psychology_james_1890", "evidence_snippet": "meaning, when the word is concrete, as 'table,' 'Boston,' consists of sensory images awakened; when it is abstract, as 'criminal legislation,' 'fallacy,' the meaning consists of other words aroused, f", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "identical to pure being"}]}, {"canonical_name": "Bradley", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "bradley", "book_id": "principles_of_psychology_james_1890", "name": "Bradley", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Bradley"], "contexts": ["philosopher quoted on attention", "calls abstract quality a 'floating adjective'"]}, {"entity_id": "bradley", "book_id": "kosmos_humboldt_1845", "name": "Bradley", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Bradley"], "contexts": ["astronomer whose observations are mentioned"]}, {"entity_id": "bradley", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Bradley", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Bradley"], "contexts": ["astronomer who observed stars", "discovered nutation"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Bradley", "target_book": "kosmos_humboldt_1845", "target_name": "Bradley", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Bradley", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bradley", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Bradley", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bradley", "similarity": 1.0}], "id": 974, "stable_key": "clu_51122a60a2984f04", "ground_truth": {"modern_name": "James Bradley", "confidence": "high", "type": "person", "birth_year": 1693, "death_year": 1762, "description": "English astronomer, discoverer of aberration of starlight", "note": "The mention of astronomical observations and stars strongly suggests James Bradley, a highly influential astronomer.", "wikidata_id": "Q111177518", "wikidata_description": "American politician"}, "cross_references": [{"found_name": "Halley", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1784, "target_cluster_name": "Halley", "source_book": "llm_generated", "evidence_snippet": "James Bradley was Astronomer Royal after Halley and continued much of the observational work Halley had initiated.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: James Bradley was Astronomer Royal after Halley and continued much of the observational work Halley had initiated.", "is_reverse": true}]}, {"canonical_name": "pitch", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "pitch", "book_id": "principles_of_psychology_james_1890", "name": "pitch", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["pitch"], "contexts": ["quality of tone that rises with rapidity", "highness or lowness of a tone"]}, {"entity_id": "pitch", "book_id": "connexion_physical_sciences_somerville_1858", "name": "pitch", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["pitch"], "contexts": ["perceived highness or lowness of a sound", "frequency of sound vibration"]}, {"entity_id": "pitch", "book_id": "first_principles_spencer_1862", "name": "pitch", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["pitch"], "contexts": ["highness or lowness of a sound"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "pitch", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "pitch", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "pitch", "target_book": "first_principles_spencer_1862", "target_name": "pitch", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "pitch", "target_book": "first_principles_spencer_1862", "target_name": "pitch", "similarity": 1.0}], "id": 975, "stable_key": "clu_e92c3002daa07943", "ground_truth": {"modern_name": "pitch (sound)", "confidence": "high", "type": "concept", "note": "The descriptions 'perceived highness or lowness of a sound' and 'quality of tone that rises with rapidity' unequivocally refer to the concept of pitch in acoustics and psychoacoustics.", "wikipedia_extract": "Pitch is the quality that makes it possible to judge sounds as \"higher\" and \"lower\" in the sense associated with musical melodies. Pitch is a perceptual property that allows sounds to be ordered on a frequency-related scale. Pitch is a major auditory attribute of musical tones, along with duration, loudness, and timbre. Pitch may be quantified as a frequency, but pitch is not a purely objective physical property; it is a subjective psychoacoustical attribute of sound. Historically, the study of pitch and pitch perception has been a central problem in psychoacoustics, and has been instrumental in forming and testing theories of sound representation, processing, and perception in the auditory system. Pitch is an auditory sensation in which a listener assigns musical tones to relative positions on a musical scale based primarily on their perception of the frequency of vibration (audio frequency)."}, "cross_references": [{"found_name": "Crescendo", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4278, "target_cluster_name": "crescendo", "source_book": "llm_generated", "evidence_snippet": "Crescendo is a gradual increase in loudness, which is a related auditory property to pitch. Both are fundamental elements of musical sound.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Crescendo is a gradual increase in loudness, which is a related auditory property to pitch. Both are fundamental elements of musical sound."}, {"found_name": "Discord", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1209, "target_cluster_name": "discord", "source_book": "llm_generated", "evidence_snippet": "Discord is a combination of sounds that is considered unpleasant or dissonant, often in contrast to harmonious intervals which are defined by specific pitch relationships.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Discord is a combination of sounds that is considered unpleasant or dissonant, often in contrast to harmonious intervals which are defined by specific pitch relationships."}]}, {"canonical_name": "Tyndall", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "tyndall", "book_id": "principles_of_psychology_james_1890", "name": "Tyndall", "category": "PERSON", "subcategory": "SCHOLAR", "co