nce": "medium", "type": "concept", "note": "Refers to natural underground hollow spaces, not specifically a disease or anatomical part.", "wikidata_id": "Q2660276", "wikidata_description": "genus of plants"}, "cross_references": []}, {"canonical_name": "Thomas Young", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "thomas_young", "book_id": "kosmos_humboldt_1845", "name": "Thomas Young", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Thomas Young"], "contexts": ["made early observations on pendulum vibration"]}, {"entity_id": "thomas_young", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Thomas Young", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Thomas Young"], "contexts": ["polymath, deciphered hieroglyphs"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Thomas Young", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Thomas Young", "similarity": 1.0}], "id": 4349, "stable_key": "clu_255d4ead803bc14f", "ground_truth": {"modern_name": "Thomas Young", "confidence": "high", "type": "person", "birth_year": 1773, "death_year": 1829, "description": "British polymath, physician, physicist, and decipherer of hieroglyphs.", "wikidata_id": "Q25820", "wikidata_description": "English polymath (1773-1829)"}, "cross_references": []}, {"canonical_name": "errors of observation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "errors_of_observation", "book_id": "kosmos_humboldt_1845", "name": "errors of observation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["errors of observation"], "contexts": ["limitations in experimental measurements"]}, {"entity_id": "errors_of_observation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "errors of observation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["errors of observation"], "contexts": ["inaccuracies in measurement"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "errors of observation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "errors of observation", "similarity": 1.0}], "id": 4350, "stable_key": "clu_be4760bab4ab1a29", "ground_truth": {"modern_name": "Observational errors", "confidence": "high", "type": "concept", "wikidata_id": "Q196372", "wikidata_description": "difference between a measured quantity value and a reference quantity value"}, "cross_references": []}, {"canonical_name": "Lipsiae", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "lipsiae", "book_id": "kosmos_humboldt_1845", "name": "Lipsiae", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Lipsiae"], "contexts": ["location of publication"]}, {"entity_id": "lipsiae", "book_id": "coloquios_da_orta_1563", "name": "Lipsiae", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Lipsiae"], "contexts": ["location of publication"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Lipsiae", "target_book": "coloquios_da_orta_1563", "target_name": "Lipsiae", "similarity": 1.0}], "id": 4351, "stable_key": "clu_c271a23979de27f1-2", "ground_truth": {"modern_name": "Leipzig", "confidence": "high", "type": "place", "description": "City in Germany, significant for publication.", "note": "Refers to the city of Leipzig, Germany, a known center for printing and academic work.", "wikipedia_extract": "Leipzig is the most populous city in the German state of Saxony. The city has a population of 628,718 inhabitants as of 2023. It is the eighth-largest city in Germany and is part of the Central German Metropolitan Region. Leipzig is located about 150 km (90 mi) southwest of Berlin, in the southernmost part of the North German Plain (the Leipzig Bay), at the confluence of the White Elster and its tributaries Pleiße and Parthe. Leipzig has been a trade city since at least the time of the Holy Roman Empire. Via Regia and the Via Imperii, two important medieval trade routes, intersected here, marking the city's economic importance."}, "cross_references": [{"found_name": "Germany", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 99, "target_cluster_name": "Germany", "source_book": "llm_generated", "evidence_snippet": "Leipzig is a major city within Germany.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Leipzig is a major city within Germany."}, {"found_name": "Berlin", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 267, "target_cluster_name": "Berlin", "source_book": "llm_generated", "evidence_snippet": "Leipzig is located near Berlin.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Leipzig is located near Berlin."}]}, {"canonical_name": "secular motion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "secular_motion", "book_id": "kosmos_humboldt_1845", "name": "secular motion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["secular motion"], "contexts": ["long-term change in magnetic declination"]}, {"entity_id": "secular_motion", "book_id": "connexion_physical_sciences_somerville_1858", "name": "secular motion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["secular motion"], "contexts": ["periodic variations of equinoxes"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "secular motion", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "secular motion", "similarity": 1.0}], "id": 4352, "stable_key": "clu_12b8e09fcd27e5af", "ground_truth": {"modern_name": "Secular variation", "confidence": "high", "type": "concept", "note": "Refers to long-term changes, particularly in scientific contexts like astronomy or geomagnetism.", "wikidata_id": "Q1763933", "wikidata_description": "long-term non-periodic variation", "wikipedia_url": "https://en.wikipedia.org/wiki/Secular%20variation", "wikipedia_extract": "The secular variation of a time series is its long-term, non-periodic variation (see Decomposition of time series). Whether a variation is perceived as secular or not depends on the available timescale: a variation that is secular over a timescale of centuries may be a segment of what is, over a timescale of millions of years, a periodic variation. Natural quantities often have both periodic and secular variations. Secular variation is sometimes called secular trend or secular drift when the emphasis is on a linear long-term trend. The term is used wherever time series are applicable in history, economics, operations research, biological anthropology, and astronomy (particularly celestial mechanics) such as VSOP (planets). The word secular, from the Latin root saecularis (\"of an age, occurring once in an age\"), has two basic meanings: I."}, "cross_references": []}, {"canonical_name": "Socotora", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "socotora", "book_id": "kosmos_humboldt_1845", "name": "Socotora", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Socotora"], "contexts": ["island west of where equator enters Africa"]}, {"entity_id": "socotora", "book_id": "ricettario_fiorentino_1597", "name": "Socotora", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Socotora"], "contexts": ["island producing excellent aloe"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Socotora", "target_book": "ricettario_fiorentino_1597", "target_name": "Socotora", "similarity": 1.0}], "id": 4353, "stable_key": "clu_8ae2698f2221e430", "ground_truth": {"modern_name": "Socotra", "confidence": "high", "type": "place", "description": "Yemeni island in the Arabian Sea, known for its unique flora and medicinal aloes.", "wikipedia_extract": "Socotra, locally known as Saqatri, is a Yemeni island in the Indian Ocean. It is situated between the Gulf of Aden, the Guardafui Channel and the Arabian Sea, and lies near major shipping routes. The largest of the six islands in the Socotra archipelago, it comprises around 95% of the landmass of the archipelago. It lies 380 kilometres (205 nautical miles) south of the Arabian Peninsula and 232 km (125 nmi) east of the Horn of Africa. The inhabitants of the island are called Socotrans, and they speak Arabic and Soqotri. Socotra is home to a high number of unique species that are endemic."}, "cross_references": []}, {"canonical_name": "thermo-magnetic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "thermo-magnetic", "book_id": "kosmos_humboldt_1845", "name": "thermo-magnetic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["thermo-magnetic"], "contexts": ["related to heat and magnetism"]}, {"entity_id": "thermo-electric", "book_id": "connexion_physical_sciences_somerville_1858", "name": "thermo-electric", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["thermo-electric"], "contexts": ["relating heat and electricity"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "thermo-magnetic", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "thermo-electric", "similarity": 0.881}], "id": 4354, "stable_key": "clu_02482f178f5e0a66", "ground_truth": {"modern_name": "Thermo-magnetic and thermo-electric effects", "confidence": "medium", "type": "concept", "note": "The terms 'thermo-magnetic' and 'thermo-electric' are closely related but distinct phenomena. The cluster appears to encompass both or a concept bridging them.", "wikidata_id": "Q129988337", "wikidata_description": "scholarly article published on 12 April 2018"}, "cross_references": []}, {"canonical_name": "dark red heat", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "dark_red_heat", "book_id": "kosmos_humboldt_1845", "name": "dark red heat", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["dark red heat"], "contexts": ["temperature at which iron manifests magnetism"]}, {"entity_id": "red_heat", "book_id": "connexion_physical_sciences_somerville_1858", "name": "red heat", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["red heat"], "contexts": ["temperature at which iron loses magnetism"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "dark red heat", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "red heat", "similarity": 0.918}], "id": 4355, "stable_key": "clu_01f6a7a4ce796aa8", "ground_truth": {"modern_name": "Red heat", "confidence": "high", "type": "concept", "note": "Describes a temperature range at which materials, particularly metals, glow visibly red. 'Dark red heat' specifies a lower end of this range.", "wikidata_id": "Q5387937", "wikidata_description": "species of plant"}, "cross_references": []}, {"canonical_name": "terrestrial stratum", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "terrestrial_stratum", "book_id": "kosmos_humboldt_1845", "name": "terrestrial stratum", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["terrestrial stratum"], "contexts": ["layer of the Earth"]}, {"entity_id": "strata_of_the_earth", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Strata of the earth", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Strata of the earth"], "contexts": ["layers of the earth's crust"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "terrestrial stratum", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Strata of the earth", "similarity": 0.931}], "id": 4356, "stable_key": "clu_c7c29056d48e10e8", "ground_truth": {"modern_name": "Earth's crust strata", "confidence": "high", "type": "concept", "note": "While 'terrestrial stratum' could refer to a single layer, the context of 'strata of the earth' and 'layers of the earth's crust' points to the geological concept of stratification."}, "cross_references": [{"found_name": "external crust", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1282, "target_cluster_name": "external crust", "source_book": "llm_generated", "evidence_snippet": "The entity 'Crust (geology)' with the historical name 'external crust' is a fundamental component of the Earth's structure, and 'Earth's crust strata' refers to the layers within this crust.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The entity 'Crust (geology)' with the historical name 'external crust' is a fundamental component of the Earth's structure, and 'Earth's crust strata' refers to the layers within this crust.", "is_reverse": true}]}, {"canonical_name": "magnetism terrestre", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "magnetism_terrestre", "book_id": "kosmos_humboldt_1845", "name": "magnetism terrestre", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["magnetism terrestre"], "contexts": ["terrestrial magnetism in French"]}, {"entity_id": "planetary_magnetism", "book_id": "connexion_physical_sciences_somerville_1858", "name": "planetary magnetism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["planetary magnetism"], "contexts": ["magnetic fields of planets"]}], "edges": [{"source_book": "kosmos_humboldt_1