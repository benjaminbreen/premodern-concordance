l": "llm_related", "found_relationship": "reverse: Pallas was a student and follower of Linnaeus's taxonomic system, applying it to his extensive collections and descriptions of flora and fauna, particularly from Siberia.", "is_reverse": true}, {"found_name": "De Candolle", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 721, "target_cluster_name": "De Candolle", "source_book": "llm_generated", "evidence_snippet": "Linnaeus was a foundational figure in botany, and de Candolle built upon his work.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Linnaeus was a foundational figure in botany, and de Candolle built upon his work.", "is_reverse": true}, {"found_name": "A.", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 856, "target_cluster_name": "A.", "source_book": "llm_generated", "evidence_snippet": "Adanson's 'natural system' of taxonomy was proposed as an alternative to the binomial system developed by Linnaeus, creating a direct intellectual contrast and relationship.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Adanson's 'natural system' of taxonomy was proposed as an alternative to the binomial system developed by Linnaeus, creating a direct intellectual contrast and relationship.", "is_reverse": true}, {"found_name": "Müller", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1328, "target_cluster_name": "Müller", "source_book": "llm_generated", "evidence_snippet": "Müller's work in physiology and anatomy built upon the systematic classification of organisms, a field heavily influenced by Linnaeus's foundational work in taxonomy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Müller's work in physiology and anatomy built upon the systematic classification of organisms, a field heavily influenced by Linnaeus's foundational work in taxonomy.", "is_reverse": true}, {"found_name": "Carl Ludwig Blume", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3162, "target_cluster_name": "Blume", "source_book": "llm_generated", "evidence_snippet": "Both were prominent botanists of the 18th and 19th centuries, with Blume being a student of Linnaeus's system.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were prominent botanists of the 18th and 19th centuries, with Blume being a student of Linnaeus's system."}, {"found_name": "Georges-Louis Leclerc, Comte de Buffon", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 473, "target_cluster_name": "Buffon", "source_book": "llm_generated", "evidence_snippet": "Buffon was a contemporary naturalist whose work on natural history and classification, while differing in approach, engaged with the broader scientific context in which Linnaeus operated.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Buffon was a contemporary naturalist whose work on natural history and classification, while differing in approach, engaged with the broader scientific context in which Linnaeus operated."}, {"found_name": "Antoine Laurent de Jussieu", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3366, "target_cluster_name": "Jussieu", "source_book": "llm_generated", "evidence_snippet": "Jussieu developed a natural system of plant classification that was influential and, in some ways, a development or alternative to Linnaeus's artificial system.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Jussieu developed a natural system of plant classification that was influential and, in some ways, a development or alternative to Linnaeus's artificial system."}, {"found_name": "Charles Darwin", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 118, "target_cluster_name": "Darwin", "source_book": "llm_generated", "evidence_snippet": "Darwin's theory of evolution fundamentally changed biological classification and understanding, building upon and eventually challenging the Linnaean system.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Darwin's theory of evolution fundamentally changed biological classification and understanding, building upon and eventually challenging the Linnaean system."}, {"found_name": "Augustin Pyramus de Candolle", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 721, "target_cluster_name": "De Candolle", "source_book": "llm_generated", "evidence_snippet": "De Candolle was a major figure in botany after Linnaeus, working to refine and expand plant classification systems, often referencing and building upon Linnaean principles.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "De Candolle was a major figure in botany after Linnaeus, working to refine and expand plant classification systems, often referencing and building upon Linnaean principles."}]}, {"canonical_name": "Lepidosiren", "category": "ANIMAL", "subcategory": "FISH", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "lepidosiren", "book_id": "origin_of_species_darwin_1859", "name": "Lepidosiren", "category": "ANIMAL", "subcategory": "FISH", "count": 4, "variants": ["Lepidosiren"], "contexts": ["anomalous form connecting separated orders", "lungfish, transitional animal"]}, {"entity_id": "lepidosiren", "book_id": "first_principles_spencer_1862", "name": "Lepidosiren", "category": "ANIMAL", "subcategory": "FISH", "count": 1, "variants": ["Lepidosiren"], "contexts": ["African animal torpid in dried mud"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Lepidosiren", "target_book": "first_principles_spencer_1862", "target_name": "Lepidosiren", "similarity": 1.0}], "id": 2722, "stable_key": "clu_880623261b2d6bab", "ground_truth": {"modern_name": "Lepidosiren", "confidence": "high", "type": "animal", "note": "Lepidosiren is a genus of lungfish. Lepidosteus refers to the genus Lepisosteus (gars).", "wikidata_id": "Q1410142", "wikidata_description": "species of chordates", "wikipedia_url": "https://en.wikipedia.org/wiki/South%20American%20lungfish", "wikipedia_extract": "The South American lungfish (Lepidosiren paradoxa), also known as the American mud-fish and scaly salamanderfish, is the single species of lungfish found in swamps and slow-moving waters of the Amazon, Paraguay, and lower Paraná River basins in South America. Notable as an obligate air-breather, it is the sole member of its family Lepidosirenidae, although some authors also place Protopterus in the family. In Brazil, it is known by the indigenous language Tupi name piramboia, which means \"snake-fish\" (Portuguese pronunciation: [piɾɐ̃ˈbɔjjɐ]), and synonyms pirarucu-bóia ([piɾɐɾuˈku ˈbɔjjɐ]), traíra-bóia ([tɾɐˈiɾɐ ˈbɔjjɐ]), and caramuru ([kɐɾɐmuˈɾu]). The South American lungfish is most closely related to the African lungfishes (family Protopteridae), and both families are thought to have diverged during the Early Cretaceous. Some papers suggest classifying both Lepidosiren and Protopterus within Lepidosirenidae, though authorities continue to classify both as distinct families. The immature lungfish is spotted with gold on a black background; in the adult, this fades to a brown or gray color."}, "cross_references": [{"found_name": "Fish", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 94, "target_cluster_name": "Fish", "source_book": "llm_generated", "evidence_snippet": "Lepidosiren is a genus of lungfish, which are a type of fish.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Lepidosiren is a genus of lungfish, which are a type of fish.", "is_reverse": true}]}, {"canonical_name": "parent-species", "category": "CONCEPT", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "parent-species", "book_id": "origin_of_species_darwin_1859", "name": "parent-species", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 4, "variants": ["parent-species"], "contexts": ["original species before hybridization", "original species from which new forms arise"]}, {"entity_id": "parent_organism", "book_id": "first_principles_spencer_1862", "name": "parent organism", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["parent organism"], "contexts": ["organism containing a germ"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "parent-species", "target_book": "first_principles_spencer_1862", "target_name": "parent organism", "similarity": 0.906}], "id": 2723, "stable_key": "clu_e88458ab5e7810a7", "ground_truth": {"modern_name": "ancestor species", "confidence": "high", "type": "concept", "note": "The terms 'parent-species' and 'parent organism' in the context of evolutionary theory and reproduction refer to the original or ancestral forms from which descendant species or individuals arise."}, "cross_references": [{"found_name": "Evolution", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 540, "target_cluster_name": "Evolution", "source_book": "llm_generated", "evidence_snippet": "Ancestor species is a concept central to evolutionary theory, representing the species from which other species have descended.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Ancestor species is a concept central to evolutionary theory, representing the species from which other species have descended."}, {"found_name": "Descent", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1973, "target_cluster_name": "descent", "source_book": "llm_generated", "evidence_snippet": "Ancestor species directly relates to the concept of descent, as it is the progenitor from which descendants arise.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Ancestor species directly relates to the concept of descent, as it is the progenitor from which descendants arise."}, {"found_name": "Extinct species", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3360, "target_cluster_name": "extinct species", "source_book": "llm_generated", "evidence_snippet": "Ancestor species are often extinct, having given rise to descendant species.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Ancestor species are often extinct, having given rise to descendant species."}, {"found_name": "Genus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 263, "target_cluster_name": "genus", "source_book": "llm_generated", "evidence_snippet": "Ancestor species can be considered within the context of genus, as a genus may contain multiple descendant species originating from a common ancestor.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Ancestor species can be considered within the context of genus, as a genus may contain multiple descendant species originating from a common ancestor."}, {"found_name": "Heredity", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1233, "target_cluster_name": "innate", "source_book": "llm_generated", "evidence_snippet": "The traits of an ancestor species are passed down through heredity to its descendants.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The traits of an ancestor species are passed down through heredity to its descendants."}]}, {"canonical_name": "pachyderms", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "pachyderms", "book_id": "origin_of_species_darwin_1859", "name": "pachyderms", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 4, "variants": ["pachyderms", "Pachyderms"], "contexts": ["order of mammals", "thick-skinned mammals like elephants"]}, {"entity_id": "pachydermata", "book_id": "kosmos_humboldt_1845", "name": "Pachydermata", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Pachydermata"], "contexts": ["thick-skinned mammals"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "pachyderms", "target_book": "kosmos_humboldt_1845", "target_name": "Pachydermata", "similarity": 0.926}], "id": 2724, "stable_key": "clu_239745a91235046b", "ground_truth": {"modern_name": "Pachyderm", "confidence": "high", "type": "animal", "wikidata_id": "Q2735907", "wikidata_description": "skin disease characterized by skin that is loose, hanging, wrinkled and lacking in elasticity; it can also affect connective tissue in other parts of the body, including the heart, blood vessels, joints, intestines and lungs", "wikipedia_url": "https://en.wikipedia.org/wiki/Cutis%20laxa", "wikipedia_extract": "Pachydermata (meaning 'thick skin', from the Greek παχύς, pachys, 'thick', and δέρμα, derma, 'skin') is an obsolete order of mammals described by Gottlieb Storr, Georges Cuvier, and others, at one time recognized by many systematists. The term pachyderm is commonly used to describe elephants, rhinoceroses, hippopotamuses and tapirs. The grouping was determined to be artificial as a biological classification due to genetic studies. Pachydermata is an obsolete order of mammals described by Gottlieb Storr, Georges Cuvier, and others, at one time recognized by many systematists. The grouping is polyphyletic, so the order is no longer in use as a biological classification. Outside strict biological classification, the related term pachyderm is commonly used to describe elephants, rhinoceroses, hippopotamuses and tapirs."}, "cross_references": [{"found_name": "mammals", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 266, "target_cluster_name": "mammals", "source_book": "llm_generated", "evidence_snippet": "Pachyderm was a historical classification often applied to large, thick-skinned mammals like elephants and rhinoceroses, which are indeed mammals.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Pachyderm was a historical classification often applied to large, thick-skinned mammals like elephants and rhinoceroses, which are indeed mammals.", "is_reverse": true}, {"found_name": "Elephant", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 839, "target_cluster_name": "Elephants", "source_book": "llm_generated", "evidence_snippet": "The historical classification 'pachyderm' was commonly used to describe elephants, among other thick-skinned mammals.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The historical classification 'pachyderm' was commonly used to describe elephants, among other thick-skinned mammals."}, {"found_name": "Rhinoceros", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1066, "target_cluster_name": "rhinoceros", "source_book": "llm_generated", "evidence_snippet": "The historical classification 'pachyderm' was commonly used to describe rhinoceroses, among other thick-skinned mammals.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The historical classification 'pachyderm' was commonly used to describe rhinoceroses, among other thick-skinned mammals."}]}, {"canonical_name": "dugong", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "dugong", "book_id": "origin_of_species_darwin_1859", "name": "dugong", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 4, "variants": ["Dugong", "dugong"], "contexts": ["marine mammal", "pachydermatous animal with whale resemblance"]}, {"entity_id": "dugong", "book_id": "coloquios_da_orta_1563", "name": "dugong", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["dugong"], "contexts": ["species of marine mammal"]}], "edges": [{"source_book": "