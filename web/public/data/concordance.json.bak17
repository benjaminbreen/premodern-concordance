"source_name": "Italia", "target_book": "coloquios_da_orta_1563", "target_name": "Itália", "similarity": 0.983}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Italia", "target_book": "ricettario_fiorentino_1597", "target_name": "Italia", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Italia", "target_book": "polyanthea_medicinal", "target_name": "Italia", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Italia", "target_book": "coloquios_da_orta_1563", "target_name": "Itália", "similarity": 0.983}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Italia", "target_book": "ricettario_fiorentino_1597", "target_name": "Italia", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Italia", "target_book": "polyanthea_medicinal", "target_name": "Italia", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Itália", "target_book": "ricettario_fiorentino_1597", "target_name": "Italia", "similarity": 0.983}, {"source_book": "coloquios_da_orta_1563", "source_name": "Itália", "target_book": "polyanthea_medicinal", "target_name": "Italia", "similarity": 0.983}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Italia", "target_book": "polyanthea_medicinal", "target_name": "Italia", "similarity": 1.0}], "id": 88, "stable_key": "clu_a1ac889aa4c54856", "ground_truth": {"modern_name": "Italy", "confidence": "high", "type": "place", "description": "European country associated with specific plants and historical references.", "wikipedia_extract": "Italy, officially the Italian Republic, is a country in Southern and Western Europe. It consists of a peninsula that extends into the Mediterranean Sea, with the Alps on its northern land border, as well as nearly 800 islands, notably Sicily and Sardinia. Italy shares land borders with France to the west; Switzerland and Austria to the north; Slovenia to the east; and the two enclaves of Vatican City and San Marino. It is the tenth-largest country in Europe by area, covering 301,340 km2 (116,350 sq mi), and the third-most populous member state of the European Union, with nearly 59 million inhabitants. Italy's capital and largest city is Rome; other major cities include Milan, Naples, Turin, Palermo, Bologna, Florence, Genoa, and Venice. The history of Italy goes back to numerous Italic peoples, notably including the ancient Romans, who conquered the Mediterranean world during the Roman Republic and ruled it for centuries during the Roman Empire."}, "member_count": 14, "cross_references": [{"found_name": "Alps", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 285, "target_cluster_name": "Alpes", "source_book": "llm_generated", "evidence_snippet": "The Alps form the northern land border of Italy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Alps form the northern land border of Italy."}, {"found_name": "Europe", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 30, "target_cluster_name": "Europe", "source_book": "llm_generated", "evidence_snippet": "Italy is a country located in Europe.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Italy is a country located in Europe."}, {"found_name": "Mediterranean Sea", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 256, "target_cluster_name": "Méditerranée", "source_book": "llm_generated", "evidence_snippet": "Italy is a peninsula that extends into the Mediterranean Sea.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Italy is a peninsula that extends into the Mediterranean Sea."}, {"found_name": "Veneza", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1662, "target_cluster_name": "Veneza", "source_book": "llm_generated", "evidence_snippet": "Venice is a city in northeast