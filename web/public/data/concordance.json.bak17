umboldt_1845", "source_name": "hydrogen gas", "target_book": "first_principles_spencer_1862", "target_name": "hydrogen", "similarity": 0.926}], "id": 731, "stable_key": "clu_3b569751cb7e591c", "ground_truth": {"modern_name": "Hydrogen", "confidence": "high", "type": "chemical", "wikidata_id": "Q556", "wikidata_description": "chemical element with symbol H and atomic number 1", "wikipedia_url": "https://en.wikipedia.org/wiki/Hydrogen", "wikipedia_extract": "Hydrogen is a chemical element; it has the symbol H and atomic number 1. It is the lightest and most abundant chemical element in the universe, constituting about 75% of all normal matter. Under standard conditions, hydrogen is a gas of diatomic molecules with the formula H2, called dihydrogen, or sometimes hydrogen gas, molecular hydrogen, or simply hydrogen. Dihydrogen is colorless, odorless, non-toxic, and highly combustible. Stars, including the Sun, mainly consist of hydrogen in a plasma state, while on Earth, hydrogen is found as the gas H2 (dihydrogen) and in molecules, such as in water and organic compounds. The most common isotope of hydrogen, 1H, consists of one proton, one electron, and no neutrons."}, "cross_references": [{"found_name": "phosphorus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 173, "target_cluster_name": "phosphorus", "source_book": "llm_generated", "evidence_snippet": "Phosphorus is a chemical element, and Hydrogen is another chemical element. They are often discussed together in early chemistry as fundamental substances.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Phosphorus is a chemical element, and Hydrogen is another chemical element. They are often discussed together in early chemistry as fundamental substances.", "is_reverse": true}, {"found_name": "Sulphur", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 313, "target_cluster_name": "Sulphur", "source_book": "llm_generated", 