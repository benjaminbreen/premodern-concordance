luster_id": 535, "target_cluster_name": "Vomitorios", "source_book": "llm_generated", "evidence_snippet": "Emetics are sometimes used as a form of treatment or antidote in cases of poisoning.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Emetics are sometimes used as a form of treatment or antidote in cases of poisoning.", "is_reverse": true}]}, {"canonical_name": "murtinhos", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "murtinhos", "book_id": "coloquios_da_orta_1563", "name": "murtinhos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["murtinhos", "murtinho"], "contexts": ["small myrtle plants", "plants not similar to turbit"]}, {"entity_id": "murtinhos", "book_id": "polyanthea_medicinal", "name": "murtinhos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 10, "variants": ["murtinhos"], "contexts": ["myrtle, used in syrup", "kernels used in ointment"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "murtinhos", "target_book": "polyanthea_medicinal", "target_name": "murtinhos", "similarity": 1.0}], "id": 1917, "stable_key": "clu_9b87245903c0fc30", "ground_truth": {"modern_name": "Myrtle", "confidence": "high", "type": "plant", "linnaean": "Myrtus communis Linnaeus", "family": "Myrtaceae", "wikidata_id": "Q165152", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Myrtus", "wikipedia_extract": "Myrtus (commonly called   myrtle) is a genus of flowering plants in the family Myrtaceae. It was first described by Swedish botanist Linnaeus in 1753. Over 600 names have been proposed in the genus, but nearly all have either been moved to other genera or been regarded as synonyms. Two species are currently accepted: Myrtus communis L. – Common myrtle; native to the Mediterranean region in southern Europe Myrtus nivellei Batt. & Trab."}, "cross_references": [{"found_name": "Juniperus communis", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4462, "target_cluster_name": "azimbro", "source_book": "llm_generated", "evidence_snippet": "Juniperus communis is the scientific name for the common juniper, which is closely related to the common myrtle (Myrtus communis) and often found in similar Mediterranean habitats. Historical texts might conflate or associate them due to shared geographical distribution and similar uses.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Juniperus communis is the scientific name for the common juniper, which is closely related to the common myrtle (Myrtus communis) and often found in similar Mediterranean habitats. Historical texts might conflate or associate them due to shared geographical distribution and similar uses."}, {"found_name": "Strawberry Tree", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3721, "target_cluster_name": "sorveira", "source_book": "llm_generated", "evidence_snippet": "The Strawberry Tree (Arbutus unedo) is another common evergreen shrub native to the Mediterranean region, often found alongside or in similar ecological niches as the common myrtle. They share a similar botanical family (Ericaceae vs. Myrtaceae) and are frequently mentioned together in descriptions of Mediterranean flora.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Strawberry Tree (Arbutus unedo) is another common evergreen shrub native to the Mediterranean region, often found alongside or in similar ecological niches as the common myrtle. They share a similar botanical family (Ericaceae vs. Myrtaceae) and are frequently mentioned together in descriptions of Mediterranean flora."}]}, {"canonical_name": "carbunculos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "carbúnculos", "book_id": "coloquios_da_orta_1563", "name": "carbúnculos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["carbúnculos"], "contexts": ["gemstones, mentioned by Pliny", "red or purple stones"]}, {"entity_id": "carbunculos", "book_id": "polyanthea_medicinal", "name": "carbunculos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 11, "variants": ["carbunculos", "Carbunculos", "carbunculos peftilenciaes", "carbunculus"], "contexts": ["carbuncles", "skin eruptions associated with malignant fevers"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "carbúnculos", "target_book": "polyanthea_medicinal", "target_name": "carbunculos", "similarity": 0.978}], "id": 1918, "stable_key": "clu_f3db1a6324d58945", "ground_truth": {"modern_name": "Lumps", "confidence": "high", "type": "disease", "description": "Abnormal swellings or growths on or under the skin.", "note": "While 'carbúnculos' can refer to gemstones, in a medicinal context, it refers to lumps or boils.", "wikipedia_extract": "Lyme disease, also known as Lyme borreliosis, is a tick-borne disease caused by species of Borrelia bacteria, transmitted by blood-feeding ticks in the genus Ixodes. It is the most common disease spread by ticks in the Northern Hemisphere. Infections are most common in the spring and early summer. Infection is treatable with antibiotics. Most treated patients experience a full recovery. For some patients recovery may not be immediate or complete, resulting in long-term effects."}, "cross_references": [{"found_name": "Buboes", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1751, "target_cluster_name": "Bubões", "source_book": "llm_generated", "evidence_snippet": "Buboes are swollen lymph nodes, a characteristic symptom of several infectious diseases, including plague and sometimes Lyme disease in its early stages.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Buboes are swollen lymph nodes, a characteristic symptom of several infectious diseases, including plague and sometimes Lyme disease in its early stages."}, {"found_name": "Swelling", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 55, "target_cluster_name": "Swellings", "source_book": "llm_generated", "evidence_snippet": "Lumps (carbunculos) are a form of swelling, and 'swelling' is a general term that could encompass them.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Lumps (carbunculos) are a form of swelling, and 'swelling' is a general term that could encompass them."}, {"found_name": "Ulcers", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3702, "target_cluster_name": "ulceras", "source_book": "llm_generated", "evidence_snippet": "While Lyme disease is not primarily characterized by ulcers, skin manifestations can sometimes lead to ulceration, and 'ulcers' are a related pathological skin condition.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "While Lyme disease is not primarily characterized by ulcers, skin manifestations can sometimes lead to ulceration, and 'ulcers' are a related pathological skin condition."}]}, {"canonical_name": "pombos", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "pombas", "book_id": "coloquios_da_orta_1563", "name": "Pombas", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Pombas", "pombas"], "contexts": ["birds found in abundance", "many kinds of doves found"]}, {"entity_id": "pombos", "book_id": "polyanthea_medicinal", "name": "pombos", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 12, "variants": ["pombos", "Pombos", "pomba", "pombo"], "contexts": ["blood used in a remedy", "animal used as a remedy"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Pombas", "target_book": "polyanthea_medicinal", "target_name": "pombos", "similarity": 0.929}], "id": 1919, "stable_key": "clu_4546e28d891a079c", "ground_truth": {"modern_name": "Doves", "confidence": "high", "type": "animal", "linnaean": "Columba livia", "family": "Columbidae", "description": "Birds, often kept or used for medicinal purposes.", "note": "The Portuguese 'pombos' and 'pombas' both translate to doves or pigeons.", "wikipedia_extract": "The rock dove (Columba livia), also known as the common pigeon or \"rock pigeon\", is a member of the bird family Columbidae (doves and pigeons). In common usage, it is often simply referred to as the \"pigeon\", although the rock dove is the wild form of the bird; the pigeons familiar to most people are the domesticated forms of the wild rock dove. Wild rock doves are uniformly pale grey with two black bars on each wing, with few differences being seen between males and females; i.e. they are not strongly sexually dimorphic. The domestic pigeon, often, but invalidly, called \"Columba livia domestica\", which includes about 1,000 different breeds, is descended from this species. Escaped domestic pigeons are the origin of feral pigeons around the world. Both forms can vary widely in the colour and pattern of their plumage unlike their wild ancestor, being red, brown, checkered, uniformly coloured, or pied."}, "cross_references": [{"found_name": "Pigeon", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 704, "target_cluster_name": "pigeons", "source_book": "llm_generated", "evidence_snippet": "The term 'pigeon' is often used interchangeably with 'dove' in common usage, and the entity description explicitly states that the rock dove is the wild form of the bird that is commonly referred to as a 'pigeon'.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "The term 'pigeon' is often used interchangeably with 'dove' in common usage, and the entity description explicitly states that the rock dove is the wild form of the bird that is commonly referred to as a 'pigeon'."}, {"found_name": "Rock pigeon", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 4007, "target_cluster_name": "carrier-pigeons", "source_book": "llm_generated", "evidence_snippet": "The entity description explicitly identifies 'rock pigeon' as a common name for the rock dove (Columba livia).", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "The entity description explicitly identifies 'rock pigeon' as a common name for the rock dove (Columba livia)."}, {"found_name": "insects", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 4, "target_cluster_name": "insects", "source_book": "llm_generated", "evidence_snippet": "Portuguese for 'doves', birds, not insects. This is an error in the candidate list.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "reverse: Portuguese for 'doves', birds, not insects. This is an error in the candidate list.", "is_reverse": true}, {"found_name": "Columba livia", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1331, "target_cluster_name": "domestic pigeon", "source_book": "llm_generated", "evidence_snippet": "Columba livia is the scientific name for the rock dove, which is the specific species described by the entity 'Doves (historical name: pombos)'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Columba livia is the scientific name for the rock dove, which is the specific species described by the entity 'Doves (historical name: pombos)'."}, {"found_name": "Birds", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 5, "target_cluster_name": "birds", "source_book": "llm_generated", "evidence_snippet": "Doves are a type of bird.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Doves are a type of bird."}]}, {"canonical_name": "sandalos citrinos", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "sandali_citrini", "book_id": "ricettario_fiorentino_1597", "name": "Sandali citrini", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["Sandali citrini", "Sandali bianchO", "Sandati Citrini"], "contexts": ["yellow sandalwood used in preparation", "ingredient in a preparation"]}, {"entity_id": "sandalos_citrinos", "book_id": "polyanthea_medicinal", "name": "sandalos citrinos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["sandalos citrinos", "Sandalos brancos", "Sandalos vermelhos", "sandalos", "sandalos vermelhos"], "contexts": ["ingredient in a decoction for fever", "citron sandalwood"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Sandali citrini", "target_book": "polyanthea_medicinal", "target_name": "sandalos citrinos", "similarity": 0.925}], "id": 1920, "stable_key": "clu_e088062cdbd42ece", "ground_truth": {"modern_name": "yellow sandalwood", "confidence": "high", "type": "plant", "description": "A fragrant wood, likely a type of sandalwood, used medicinally.", "wikipedia_extract": "Sandalwood is a class of woods from trees in the genus Santalum. The woods are heavy, yellow, and fine-grained, and, unlike many other aromatic woods, they retain their fragrance for decades. Sandalwood oil is extracted from the woods. Sandalwood is often cited as one of the most expensive woods in the world. Both the wood and the oil produce a distinctive fragrance that has been highly valued for centuries. Consequently, some species of these slow-growing trees have suffered over-harvesting in the past."}, "cross_references": [{"found_name": "citrinos", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2465, "target_cluster_name": "citrinos", "source_book": "llm_generated", "evidence_snippet": "The name 'yellow sandalwood' (sandalos citrinos) suggests a connection to the color 'citrine' or citrus, implying a potential historical association or similarity in appearance or use.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The name 'yellow sandalwood' (sandalos citrinos) suggests a connection to the color 'citrine' or citrus, implying a potential historical association or similarity in appearance or use.", "is_reverse": true}]}, {"canonical_name": "fel", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "felle", "book_id": "ricettario_fiorentino_1597", "name": "felle", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["felle"], "contexts": ["bile"]}, {"entity_id": "fel", "book_id": "polyanthea_medicinal", "name": "fel", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 13, "variants": ["fel", "Fel"], "contexts": ["bile, a bodily fluid", "organ related to bile duct obstruction"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "felle", "target_book": "polyanthea_medicinal", "target_name": "fel", "similarity": 0.906}], "id": 1921, "stable_key": "clu_f2f3b3333487b702", "ground_truth": {"modern_name": "Bile", "confidence": "high", "type": "chemical"}, "cross_references": [{"found_name": "humers", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 3925, "target_cluster_name": "humers", "source_book": "llm_generated", "evidence_snippet": "This is the Latin term for 'bile', one of the four humors in humoral theory.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "reverse: This is the Latin term for 'bile', one of the four humors in humoral theory.", "is_reverse": true}, {"found_name": "baço", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1527, "target_cluster_name": "baço", "source_book": "llm_generated", "evidence_snippet": "The spleen is closely associated with the production and circulation of bile in humoral theory.", "confidence": 0.85, "a