 "organs_of_motion", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "organs of motion", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["organs of motion"], "contexts": ["body parts for movement", "body parts responsible for movement"]}, {"entity_id": "organs_of_locomotion", "book_id": "origin_of_species_darwin_1859", "name": "organs of locomotion", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["organs of locomotion"], "contexts": ["body parts for movement"]}, {"entity_id": "bodily_motions", "book_id": "principles_of_psychology_james_1890", "name": "bodily motions", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["bodily motions"], "contexts": ["movements of the physical body"]}, {"entity_id": "body_moving", "book_id": "principles_of_psychology_james_1890", "name": "body moving", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["body moving"], "contexts": ["object in motion"]}, {"entity_id": "bodily_movements", "book_id": "principles_of_psychology_james_1890", "name": "bodily movements", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["bodily movements"], "contexts": ["physical actions of the body"]}, {"entity_id": "muscular_movements", "book_id": "first_principles_spencer_1862", "name": "muscular movements", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["muscular movements"], "contexts": ["actions of muscles", "actions performed by muscles"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "organs of motion", "target_book": "origin_of_species_darwin_1859", "target_name": "organs of locomotion", "similarity": 0.959}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "organs of motion", "target_book": "principles_of_psychology_james_1890", "target_name": "bodily motions", "similarity": 0.91}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "organs of motion", "target_book": "principles_of_psychology_james_1890", "target_name": "body moving", "similarity": 0.927}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "organs of motion", "target_book": "principles_of_psychology_james_1890", "target_name": "bodily movements", "similarity": 0.91}, {"source_book": "principles_of_psychology_james_1890", "source_name": "bodily motions", "target_book": "first_principles_spencer_1862", "target_name": "muscular movements", "similarity": 0.952}, {"source_book": "principles_of_psychology_james_1890", "source_name": "body moving", "target_book": "first_principles_spencer_1862", "target_name": "muscular movements", "similarity": 0.925}, {"source_book": "principles_of_psychology_james_1890", "source_name": "bodily movements", "target_book": "first_principles_spencer_1862", "target_name": "muscular movements", "similarity": 0.952}], "id": 429, "stable_key": "clu_fa75a8068e7c9a41", "ground_truth": {"modern_name": "Musculoskeletal System", "confidence": "medium", "type": "concept", "note": "The term 'organs of motion' is archaic and refers broadly to the structures enabling movement, best captured by the musculoskeletal system.", "wikidata_id": "Q4116663", "wikidata_description": "medical condition", "wikipedia_url": "https://en.wikipedia.org/wiki/Musculoskeletal%20disorder", "wikipedia_extract": "Musculoskeletal disorders (MSDs) are injuries or pain in the human musculoskeletal system, including the joints, ligaments, muscles, nerves, tendons, and structures that support limbs, neck and back. MSDs can arise from a sudden exertion (e.g., lifting a heavy object), or they can arise from making the same motions repeatedly (repetitive strain), or from repeated exposure to force, vibration, or awkward posture. Injuries and pain in the musculoskeletal system caused by acute traumatic events like a car accident or fall are not considered musculoskeletal disorders. MSDs can affect many different parts of the body including upper and lower back, neck, shoulders and extremities (arms, legs, feet, and hands). Examples of MSDs include carpal tunnel syndrome, epicondylitis, tendinitis, back pain, tension neck syndrome, and hand-arm vibration syndrome. MSDs can arise from the interaction of physical factors with ergonomic, psychological, social, and occupational factors."}, "cross_references": [{"found_name": "Arm", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 140, "target_cluster_name": "arm", "source_book": "llm_generated", "evidence_snippet": "The arm is a component of the musculoskeletal system.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The arm is a component of the musculoskeletal system."}, {"found_name": "Back", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 825, "target_cluster_name": "Back", "source_book": "llm_generated", "evidence_snippet": "The back is a component of the musculoskeletal system.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The back is a component of the musculoskeletal system."}, {"found_name": "Bone", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4023, "target_cluster_name": "bone", "source_book": "llm_generated", "evidence_snippet": "Bones are a fundamental component of the musculoskeletal system.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Bones are a fundamental component of the musculoskeletal system."}, {"found_name": "Bones", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 347, "target_cluster_name": "Bones", "source_book": "llm_generated", "evidence_snippet": "Bones are a fundamental component of the musculoskeletal system.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Bones are a fundamental component of the musculoskeletal system."}, {"found_name": "Joints", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1290, "target_cluster_name": "juncturas", "source_book": "llm_generated", "evidence_snippet": "Joints are a key component of the musculoskeletal system.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Joints are a key component of the musculoskeletal system."}]}, {"canonical_name": "Love", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 9, "members": [{"entity_id": "love", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "love", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["love"], "contexts": ["positive quality, from good principle"]}, {"entity_id": "love", "book_id": "english_physician_1652", "name": "Love", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Love"], "contexts": ["beyond gifts"]}, {"entity_id": "love", "book_id": "principles_of_psychology_james_1890", "name": "Love", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["Love", "love"], "contexts": ["strong affection or desire", "cardinal passion of life"]}, {"entity_id": "loves", "book_id": "principles_of_psychology_james_1890", "name": "loves", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["loves"], "contexts": ["feelings of affection"]}, {"entity_id": "amor", "book_id": "polyanthea_medicinal", "name": "amor", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["amor"], "contexts": ["emotion that can leave lasting impressions"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "love", "target_book": "english_physician_1652", "target_name": "Love", "similarity": 0.978}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "love", "target_book": "principles_of_psychology_james_1890", "target_name": "Love", "similarity": 0.978}, {"source_book": "pseudodoxia_epidemica_browne_1646", "so