contexts": ["cause of transparency in things", "ability to let light pass through"]}, {"entity_id": "transparent", "book_id": "principles_of_psychology_james_1890", "name": "transparent", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["transparent"], "contexts": ["visual quality"]}, {"entity_id": "transparency", "book_id": "principles_of_psychology_james_1890", "name": "transparency", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["transparency"], "contexts": ["state of being transparent"]}, {"entity_id": "transparency", "book_id": "kosmos_humboldt_1845", "name": "transparency", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["transparency"], "contexts": ["property of the atmosphere"]}, {"entity_id": "transparency", "book_id": "connexion_physical_sciences_somerville_1858", "name": "transparency", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["transparency"], "contexts": ["ability to allow light to pass through"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "transparency", "target_book": "principles_of_psychology_james_1890", "target_name": "transparent", "similarity": 0.901}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "transparency", "target_book": "principles_of_psychology_james_1890", "target_name": "transparency", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "transparency", "target_book": "kosmos_humboldt_1845", "target_name": "transparency", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "transparency", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "transparency", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "transparent", "target_book": "kosmos_humboldt_1845", "target_name": "transparency", "similarity": 0.901}, {"source_book": "principles_of_psychology_james_1890", "source_name": "transparent", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "transparency", "similarity": 0.901}, {"source_book": "principles_of_psychology_james_1890", "source_name": "transparency", "target_book": "kosmos_humboldt_1845", "target_name": "transparency", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "transparency", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "transparency", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "transparency", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "transparency", "similarity": 1.0}], "id": 481, "stable_key": "clu_6a5d2c800b84dc15", "ground_truth": {"modern_name": "transparent", "confidence": "high", "type": "concept", "wikidata_id": "Q568753", "wikidata_description": "economic concept", "wikipedia_url": "https://en.wikipedia.org/wiki/Transparency%20%28market%29", "wikipedia_extract": "In economics, a market is transparent if much is known by many about what products and services or capital assets are available, market depth (quantity available), what price, and where. Transparency is important since it is one of the theoretical conditions required for a free market to be efficient. Price transparency can, however, lead to higher prices. For example, if it makes sellers reluctant to give steep discounts to certain buyers (e.g. disrupting price dispersion among buyers), or if it facilitates collusion, and price volatility is another concern. A high degree of market transparency can result in disintermediation due to the buyer's increased knowledge of supply pricing."}, "cross_references": [{"found_name": "Depth", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3639, "target_cluster_name": "depth", "source_book": "llm_generated", "evidence_snippet": "The definition of 'transparent' in economics explicitly mentions 'market depth' as a component of transparency.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The definition of 'transparent' in economics explicitly mentions 'market depth' as a component of transparency."}]}, {"canonical_name": "Terra Lemnia", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 4, "total_mentions": 6, "members": [{"entity_id": "terra_lemnia", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Terra Lemnia", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Terra Lemnia"], "contexts": ["medicinal earth from Lemnos", "stone mentioned with Ætites"]}, {"entity_id": "terra_lemnia", "book_id": "historia_medicinal_monardes_1574", "name": "Terra lemnia", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Terra lemnia", "Terra lemnía"], "contexts": ["medicinal earth from Lemnos", "earth substance, Bolarmeníco"]}, {"entity_id": "terra_de_lemnos", "book_id": "coloquios_da_orta_1563", "name": "terra de Lemnos", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["terra de Lemnos"], "contexts": ["earth used in medicine"]}, {"entity_id": "terra_lemnia", "book_id": "polyanthea_medicinal", "name": "terra Lemnia", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["terra Lemnia"], "contexts": ["type of medicinal earth"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Terra Lemnia", "target_book": "historia_medicinal_monardes_1574", "target_name": "Terra lemnia", "similarity": 0.764}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Terra Lemnia", "target_book": "coloquios_da_orta_1563", "target_name": "terra de Lemnos", "similarity": 0.893}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Terra Lemnia", "target_book": "polyanthea_medicinal", "target_name": "terra Lemnia", "similarity": 0.979}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Terra lemnia", "target_book": "polyanthea_medicinal", "target_name": "terra Lemnia", "similarity": 0.765}, {"source_book": "coloquios_da_orta_1563", "source_name": "terra de Lemnos", "target_book": "polyanthea_medicinal", "target_name": "terra Lemnia", "similarity": 0.915}], "id": 482, "stable_key": "clu_1a2500e504267e16", "ground_truth": {"modern_name": "Lemnian earth", "confidence": "high", "type": "mineral", "note": "A medicinal earth historically sourced from the island of Lemnos.", "wikidata_id": "Q135185467", "wikidata_description": "historic medicinal clay", "wikipedia_url": "https://en.wikipedia.org/wiki/Lemnian%20Earth", "wikipedia_extract": "Lemnian Earth was a medicinal clay sourced from the Greek island of Lemnos in the Aegean Sea. It was used from antiquity on until the post-medieval period for the treatment of poisonings, open wounds and other illnesses. Lemnian clay was shaped into tablets with distinctive seals stamped into them, from which it got its name terra sigillata - Latin for 'sealed earth'. Lemnian Earth was first documented in the 3rd century BCE for its use as a pigment. The earliest mention of its application as a medicine appears in Dioscorides' De Materia Medica, dated to ca. 50–70."}, "cross_references": [{"found_name": "Armenian bole", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 335, "target_cluster_name": "bolo armenio", "source_book": "llm_generated", "evidence_snippet": "Both are medicinal clays historically used for similar purposes, often mentioned together in pharmacopoeias and medical texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are medicinal clays historically used for similar purposes, often mentioned together in pharmacopoeias and medical texts."}, {"found_name": "Clay", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 344, "target_cluster_name": "Barro", "source_book": "llm_generated", "evidence_snippet": "Lemnian Earth is a specific type of clay, and 'Clay' is a broader category that encompasses it.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Lemnian Earth is a specific type of clay, and 'Clay' is a broader category that encompasses it."}, {"found_name": "Earth", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 21, "target_cluster_name": "terra", "source_book": "llm_generated", "evidence_snippet": "Lemnian Earth is a specific type of earth, and 'Earth' is a broader category that encompasses it.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Lemnian Earth is a specific type of earth, and 'Earth' is a broader category that encompasses it."}, {"found_name": "earths", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1183, "target_cluster_name": "earths", "source_book": "llm_generated", "evidence_snippet": "Lemnian earth is a specific type of 'earth' used historically for medicinal purposes, indicating a direct subtype relationship.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Lemnian earth is a specific type of 'earth' used historically for medicinal purposes, indicating a direct subtype relationship.", "is_reverse": true}, {"found_name": "substancia terrea", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1485, "target_cluster_name": "substancia terrea", "source_book": "llm_generated", "evidence_snippet": "Lemnian earth is a specific historical substance often described as an earthy matter.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Lemnian earth is a specific historical substance often described as an earthy matter.", "is_reverse": true}, {"found_name": "Terra santa", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2176, "target_cluster_name": "Terra santa", "source_book": "llm_generated", "evidence_snippet": "Both are earth-like substances historically used in medicine, often associated with specific geographical origins and believed to have medicinal properties.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both are earth-like substances historically used in medicine, often associated with specific geographical origins and believed to have medicinal properties.", "is_reverse": true}, {"found_name": "terra figillada", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2625, "target_cluster_name": "terra figillada", "source_book": "llm_generated", "evidence_snippet": "Both are specific types of earth/clay used medicinally, with 'Lemnian earth' being a well-known variety of medicinal earth, similar to how 'terra sigillata' was a specific medicinal earth.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both are specific types of earth/clay used medicinally, with 'Lemnian earth' being a well-known variety of medicinal earth, similar to how 'terra sigillata' was a specific medicinal earth.", "is_reverse": true}]}, {"canonical_name": "guerras", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 6, "members": [{"entity_id": "war", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "War", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["War"], "contexts": ["conflict signified by flies"]}, {"entity_id": "guerres", "book_id": "relation_historique_humboldt_vol3_1825", "name": "guerres", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["guerres"], "contexts": ["armed conflicts"]}, {"entity_id": "war", "book_id": "relation_historique_humboldt_vol3_1825", "name": "war", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["war"], "contexts": ["cause of population decline"]}, {"entity_id": "guerra", "book_id": "coloquios_da_orta_1563", "name": 