texts": ["religious order"]}, {"entity_id": "companhia_de_jesus", "book_id": "coloquios_da_orta_1563", "name": "Companhia de Jesus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["Companhia de Jesus", "companhia de Jesus"], "contexts": ["religious order", "religious order involved in pearl fishery"]}, {"entity_id": "companhia_de_jesus", "book_id": "polyanthea_medicinal", "name": "Companhia de JESUS", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["Companhia de JESUS", "Companhiade JESU"], "contexts": ["religious order"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Compania de Jésus", "target_book": "coloquios_da_orta_1563", "target_name": "Companhia de Jesus", "similarity": 0.962}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Compania de Jésus", "target_book": "polyanthea_medicinal", "target_name": "Companhia de JESUS", "similarity": 0.941}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Compailia de Jésus", "target_book": "polyanthea_medicinal", "target_name": "Companhia de JESUS", "similarity": 0.884}, {"source_book": "coloquios_da_orta_1563", "source_name": "Companhia de Jesus", "target_book": "polyanthea_medicinal", "target_name": "Companhia de JESUS", "similarity": 0.961}], "id": 813, "stable_key": "clu_52e9d2809824ed61", "ground_truth": {"modern_name": "Society of Jesus", "confidence": "high", "type": "concept", "description": "A Catholic religious order of pontifical right.", "note": "Also known as the Jesuits.", "wikipedia_extract": "The Society of Jesus (Latin: Societas Iesu; abbreviation: S.J. or SJ), also known as the Jesuit Order or the Jesuits ( JEZH-oo-its, JEZ-ew-; Latin: Iesuitae), is a religious order of clerics regular of pontifical right for men in the Catholic Church. Headquartered in Rome, it was founded in 1540 by Ignatius of Loyola and six companions, with the approval of Pope Paul III. The Society of Jesus is the largest Catholic religious order and has played a significant role in education, charity, humanitarian acts and global policies. Jesuits are engaged in evangelization and apostolic ministry in 112 countries, including education, research, and cultural pursuits. They also conduct retreats, minister in hospitals and parishes, sponsor direct social and humanitarian works, and promote ecumenical dialogue. The Society of Jesus is consecrated under the patronage of Madonna della Strada, a title of the Blessed Virgin Mary, and it is led by a superior general."}, "cross_references": []}, {"canonical_name": "anacardo", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 14, "members": [{"entity_id": "anacardo", "book_id": "coloquios_da_orta_1563", "name": "anacardo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 11, "variants": ["anacardo", "ANACARDO", "Anacardiace", "Anacardo", "anacardus"], "contexts": ["subject of discussion, Greek name for heart", "fruit used for various medicinal purposes"]}, {"entity_id": "anacardi", "book_id": "ricettario_fiorentino_1597", "name": "anacardi", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["anacardi"], "contexts": ["nuts used to extract mucilage"]}, {"entity_id": "anacardo", "book_id": "polyanthea_medicinal", "name": "Anacardo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Anacardo", "Anacardos"], "contexts": ["ingredient in compound remedy", "cashews prepared for confection"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "anacardo", "target_book": "ricettario_fiorentino_1597", "target_name": "anacardi", "similarity": 0.915}, {"source_book": "coloquios_da_orta_1563", "source_name": "anacardo", "target_book": "polyanthea_medicinal", "target_name": "Anacardo", "similarity": 0.975}, {"source_book": "ricettario_fiorentino_1597", "source_name": "anacardi", "target_book": "polyanthea_medicinal", "target_name": "Anacardo", "similarity": 0.912}], "id": 814, "stable_key": "clu_c0a406c1a8f78e38", "ground_truth": {"modern_name": "cashew", "confidence": "high", "type": "plant", "linnaean": "Anacardium occidentale", "family": "Anacardiaceae", "description": "A tropical tree and its kidney-shaped nut, used medicinally.", "note": "The Greek name for heart (anacardion) is also referenced, linking to the shape of the nut.", "wikipedia_extract": "Cashew is the common name of a tropical evergreen tree Anacardium occidentale, in the family Anacardiaceae. It is the source of the cashew nut (often simply called a 'cashew') and the cashew apple. The tree can grow as tall as 14 meters (46 feet). The species is native to South America. The dwarf cultivars, growing up to 6 m (20 ft), are the most profitable, maturing sooner and producing greater yields. In 2023, 3.9 million tons of cashew nuts were harvested globally, led by the Ivory Coast and India."}, "cross_references": []}, {"canonical_name": "words", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 14, "members": [{"entity_id": "words", "book_id": "principles_of_psychology_james_1890", "name": "words", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["words"], "contexts": ["units of language", "symbols for things, contract relation by vicinity"]}, {"entity_id": "word", "book_id": "principles_of_psychology_james_1890", "name": "word", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["word"], "contexts": ["unit of language", "linguistic unit of expression"]}, {"entity_id": "words", "book_id": "connexion_physical_sciences_somerville_1858", "name": "words", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["words"], "contexts": ["units of language"]}, {"entity_id": "words", "book_id": "first_principles_spencer_1862", "name": "words", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["words"], "contexts": ["conveying ideas"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "words", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "words", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "words", "target_book": "first_principles_spencer_1862", "target_name": "words", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "word", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "words", "similarity": 0.848}, {"source_book": "principles_of_psychology_james_1890", "source_name": "word", "target_book": "first_principles_spencer_1862", "target_name": "words", "similarity": 0.848}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "words", "target_book": "first_principles_spencer_1862", "target_name": "words", "similarity": 1.0}], "id": 815, "stable_key": "clu_f2123da602d35eb8", "ground_truth": {"modern_name": "Word", "confidence": "high", "type": "concept", "note": "This refers to the linguistic unit, not the concept of 'speaking' or 'utterance'.", "wikidata_id": "Q8171", "wikidata_description": "smallest linguistic element that will be said in isolation with semantic or pragmatic content", "wikipedia_url": "https://en.wikipedia.org/wiki/Word", "wikipedia_extract": "A word is a basic element of language that carries meaning, can be used on its own, and is uninterruptible. Despite the fact that language speakers often have an intuitive grasp of what a word is, there is no consensus among linguists on its definition and numerous attempts to find specific criteria of the concept remain controversial. Different standards have been proposed, depending on the theoretical background and descriptive context; these do not converge on a single definition. Some specific definitions of the term \"word\" are employed to convey its different meanings at different levels of description, for example based on phonological, grammatical or orthographic basis. Others suggest that the concept is simply a convention used in everyday situations. The concept of \"word\" is distinguished from that of a morpheme, which is the smallest unit of language that has a meaning, even if it cannot stand on its own."}, "cross_references": [{"found_name": "Alphabet", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3074, "target_cluster_name": "alphabet", "source_book": "llm_generated", "evidence_snippet": "The alphabet is a system of symbols used to represent words, making it a fundamental component in the construction and representation of words.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The alphabet is a system of symbols used to represent words, making it a fundamental component in the construction and representation of words."}, {"found_name": "Communication", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3561, "target_cluster_name": "communicação", "source_book": "llm_generated", "evidence_snippet": "Words are the primary medium for communication, enabling the transmission of ideas and information.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Words are the primary medium for communication, enabling the transmission of ideas and information."}, {"found_name": "Cognition", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 656, "target_cluster_name": "cognition", "source_book": "llm_generated", "evidence_snippet": "Words are essential tools for thought and cognition, shaping how we understand and process information.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Words are essential tools for thought and cognition, shaping how we understand and process information."}, {"found_name": "Conjunction", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 701, "target_cluster_name": "conjunção", "source_book": "llm_generated", "evidence_snippet": "Conjunctions are a type of word that connects other words, phrases, or clauses, playing a grammatical role in sentence structure.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Conjunctions are a type of word that connects other words, phrases, or clauses, playing a grammatical role in sentence structure."}, {"found_name": "Adjective", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3570, "target_cluster_name": "adjectives", "source_book": "llm_generated", "evidence_snippet": "Adjectives are a class of words that modify nouns, providing descriptive information and enriching the meaning of words.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Adjectives are a class of words that modify nouns, providing descriptive information and enriching the meaning of words."}]}, {"canonical_name": "Solids", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 14, "members": [{"entity_id": "solids", "book_id": "kosmos_humboldt_1845", "name": "solids", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["solids"], "contexts": ["earth's crust components", "state of matter"]}, {"entity_id": "solids", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Solids", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 6, "variants": ["solids", "Solids"], "contexts": ["state of matter with definite shape", "material medium for sound"]}, {"entity_id": "solid", "book_id": "first_principles_spencer_1862", "name": "solid", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["solid"], "contexts": ["state of matter"]}, {"entity_id": "solid_matters", "book_id": "first_principles_spencer_1862", "name": "solid matters", "category": "SUBSTANCE", "subcategory": "O