ory": "OTHER_CONCEPT", "count": 2, "variants": ["meteoric showers"], "contexts": ["celestial events exhibiting phenomena", "celestial phenomenon of falling meteors"]}, {"entity_id": "showers_of_meteors", "book_id": "kosmos_humboldt_1845", "name": "showers of meteors", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["showers of meteors"], "contexts": ["meteorological events"]}, {"entity_id": "meteoros", "book_id": "polyanthea_medicinal", "name": "meteoros", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["meteoros"], "contexts": ["meteors"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "meteoric streams", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "meteoric showers", "similarity": 0.891}, {"source_book": "kosmos_humboldt_1845", "source_name": "meteoric shower", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "meteoric showers", "similarity": 0.968}], "id": 3154, "stable_key": "clu_f007a983b12b01f7", "ground_truth": {"modern_name": "Meteor shower", "confidence": "high", "type": "concept", "wikidata_id": "Q105000", "wikidata_description": "celestial event caused by streams of meteoroids entering Earth's atmosphere", "note": "The term 'meteoros' in 'polyanthea_medicinal' likely refers to atmospheric phenomena or meteors, aligning with 'showers of meteors'."}, "member_count": 5, "cross_references": []}, {"canonical_name": "Schiraz", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "schiraz", "book_id": "kosmos_humboldt_1845", "name": "Schiraz", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Schiraz"], "contexts": ["location of observations"]}, {"entity_id": "schiraz", "book_id": "coloquios_da_orta_1563", "name": "Schiraz", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Schiraz"], "contexts": ["city where Miguel Ferreira was received", "origin of weight unit"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Schiraz", "target_book": "coloquios_da_orta_1563", "target_name": "Schiraz", "similarity": 1.0}], "id": 3155, "stable_key": "clu_2182de894491f4ae", "ground_truth": {"modern_name": "Shiraz", "confidence": "high", "type": "place", "country": "Iran", "wikipedia_extract": "Shiraz is the fifth-most-populous city of Iran and the capital of Fars province, which is historically known by the exonym Persia proper. As of the 2016 national census, the population of the city was 1,565,572 people, and its built-up area with Sadra was home to almost 1,800,000 inhabitants. A census in 2021 showed an increase in the city's population to 1,995,500 people. Shiraz is located in southwestern Iran on the rudkhaneye khoshk (lit. 'dry river') seasonal river. The city has a moderate climate and has been a regional trade center for over a thousand years. The earliest reference to the city, as Tiraziš, is on Elamite clay tablets dated to 2000 BCE."}, "cross_references": []}, {"canonical_name": "Vulpecula", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "vulpis", "book_id": "kosmos_humboldt_1845", "name": "Vulpis", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Vulpis"], "contexts": ["constellation with similar phenomenon"]}, {"entity_id": "vulpecula", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Vulpecula", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Vulpecula"], "contexts": ["constellation containing a nebula", "nebula in"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Vulpis", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Vulpecula", "similarity": 0.889}], "id": 3156, "stable_key": "clu_14e252196578f616", "ground_truth": {"modern_name": "Vulpecula", "confidence": "high", "type": "place", "country": "Unknown", "note": "Vulpis is the Latin word for fox, and Vulpecula is a constellation named after a small fox. The context 'constellation containing dumb-bell nebula' confirms this.", "wikidata_id": "Q10519", "wikidata_description": "constellation in the northern celestial hemisphere", "wikipedia_extract": "Vulpecula () is a faint constellation in the Northern Sky. Its name is Latin for \"little fox\", although it is commonly called simply the Fox. It was identified in the 17th century, and is located in the middle of the Summer Triangle (an asterism consisting of the bright stars Deneb, Vega, and Altair). There are no stars brighter than 4th magnitude in this constellation. The brightest star in Vulpecula is Alpha Vulpeculae, a magnitude 4.44m red giant at an approximate distance of 291 light-years. The star is an optical binary (separation of 413.7\") that can be split using binoculars."}, "cross_references": []}, {"canonical_name": "Mariner’s compass", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "mariner's_compass", "book_id": "kosmos_humboldt_1845", "name": "mariner's compass", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["mariner's compass"], "contexts": ["navigational instrument"]}, {"entity_id": "mariner’s_compass", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Mariner’s compass", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["Mariner’s compass", "mariner’s compass"], "contexts": ["navigational instrument using a magnetic needle", "navigational instrument"]}, {"entity_id": "mariner's_compass", "book_id": "connexion_physical_sciences_somerville_1858", "name": "mariner's compass", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["mariner's compass"], "contexts": ["magnetic needle for navigation"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "mariner's compass", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mariner’s compass", "similarity": 0.988}, {"source_book": "kosmos_humboldt_1845", "source_name": "mariner's compass", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "mariner's compass", "similarity": 1.0}], "id": 3157, "stable_key": "clu_32be2baa382d877a", "ground_truth": {"modern_name": "Mariner's compass", "confidence": "high", "type": "object", "wikidata_id": "Q7908138", "wikidata_description": "1989 Malayalam black comedy film directed by Sreenivasan", "wikipedia_url": "https://en.wikipedia.org/wiki/Vadakkunokkiyantram", "wikipedia_extract": "A compass is a device that shows the cardinal directions used for navigation and geographic orientation. It typically consists of a magnetized needle or another element, such as a compass card or compass rose, that pivots to align itself with magnetic north. Other methods may be used, including gyroscopes, magnetometers, and GPS receivers. Compasses often show angles in degrees: north corresponds to 0°, and the angles increase clockwise, so east is 90°, south is 180°, and west is 270°. These numbers allow the compass to show azimuths or bearings which are commonly stated in degrees. If local variation between magnetic north and true north is known, then direction of magnetic north also gives direction of true north."}, "cross_references": [{"found_name": "compass", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 428, "target_cluster_name": "compass", "source_book": "llm_generated", "evidence_snippet": "A specific type of compass used by mariners, but fundamentally the same object.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: A specific type of compass used by mariners, but fundamentally the same object.", "is_reverse": true}, {"found_name": "magnetic needle", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 740, "target_cluster_name": "magnetic needle", "source_book": "llm_generated", "evidence_snippet": "A mariner's compass uses a magnetic needle to indicate direction.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: A mariner's compass uses a magnetic needle to indicate direction.", "is_reverse": true}, {"found_name": "chronomètres", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 853, "target_cluster_name": "chronomètres", "source_book": "llm_generated", "evidence_snippet": "Both chronometers and mariner's compasses were crucial navigational instruments, often used together at sea.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both chronometers and mariner's compasses were crucial navigational instruments, often used together at sea.", "is_reverse": true}]}, {"canonical_name": "Isogeothermal lines", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "isogeothermal_lines", "book_id": "kosmos_humboldt_1845", "name": "isogeothermal lines", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["isogeothermal lines"], "contexts": ["lines of equal internal terrestrial temperature"]}, {"entity_id": "isogeothermal_lines", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Isogeothermal lines", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Isogeothermal lines", "Isogeothermal Lines", "isogeothermal lines"], "contexts": ["lines of equal geothermal temperature", "lines of equal mean ground temperature"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "isogeothermal lines", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Isogeothermal lines", "similarity": 0.976}], "id": 3158, "stable_key": "clu_c9da50464a02c146", "ground_truth": {"modern_name": "Isotherm", "confidence": "high", "type": "concept", "note": "Isogeothermal lines refer to lines connecting points of equal geothermal temperature, which are a specific type of isotherm.", "wikidata_id": "Q486921", "wikidata_description": "thermodynamic process in which the temperature remains constant"}, "cross_references": [{"found_name": "isothermal lines", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2324, "target_cluster_name": "isothermal lines", "source_book": "llm_generated", "evidence_snippet": "Isogeothermal lines are a direct synonym for Isotherms in the context of historical scientific terminology, referring to lines connecting points of equal temperature.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Isogeothermal lines are a direct synonym for Isotherms in the context of historical scientific terminology, referring to lines connecting points of equal temperature.", "is_reverse": true}, {"found_name": "Climatologie", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2199, "target_cluster_name": "Climatologie", "source_book": "llm_generated", "evidence_snippet": "Isotherms (lines of equal temperature) are fundamental graphical representations used in climatology to depict temperature distributions.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Isotherms (lines of equal temperature) are fundamental graphical representations used in climatology to depict temperature distributions.", "is_reverse": true}]}, {"canonical_name": "interference of light", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "interference_of_light", "book_id": "kosmos_humboldt_1845", "name": "interference of light", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["interference of light"], "contexts": ["optical phenomenon explained by wave interaction"]}, {"entity_id": "interference_of_light", "book_id": "connexion_physical_sciences_somerville_1858", "name": "interference of light", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Interference of Light", "interference of light"], "contexts": ["wave interaction of light", "wave phenomenon causing coloured fringes"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "interference of light", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "interference of light", "similarity": 1.0}], "id": 3159, "stable_key": "clu_7cd2d200f5004d6c", "ground_truth": {"modern_name": "Interference of light", "confidence": "high", "type": "concept", "wikidata_id": "Q71862002", "wikidata_description": "scientific article published on 01 October 1967"}, "cross_references": [{"found_name": "Refraction", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1747, "target_cluster_name": "Refraction", "source_book": "llm_generated", "evidence_snippet": "Both phenomena describe the behavior of light waves.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both phenomena describe the behavior of light waves.", "is_reverse": true}, {"found_name": "Circular polarization", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1952, "target_cluster_name": "Circular polarization", "source_book": "llm_generated", "evidence_snippet": "Interference of light is a phenomenon that, along with diffraction and polarization, is a key characteristic behavior of light waves, and understanding these phenomena often involves related concepts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Interference of light is a phenomenon that, along with diffraction and polarization, is a key characteristic behavior of light waves, and understanding these phenomena often involves related concepts.", "is_reverse": true}, {"found_name": "dispersion of light", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2222, "target_cluster_name": "dispersion of light", "source_book": "llm_generated", "evidence_snippet": "Interference is a phenomenon that occurs when light waves interact, often following or preceding discussions of dispersion.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Interference is a phenomenon that occurs when light waves interact, often following or preceding discussions of dispersion.", "is_reverse": true}]}, {"canonical_name": "Tolosa", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "tolosa", "book_id": "kosmos_humboldt_1845", "name": "Tolosa", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Tolosa"], "contexts": ["location between cities"]}, {"entity_id": "tolosa", "book_id": "coloquios_da_orta_1563", "name": "Tolosa", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Tolosa"], "contexts": ["city of printing", "publication location of De proprietatibus rerum"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Tolosa", "target_book": "coloquios_da_orta_1563", "target_name": "Tolosa", "similarity": 1.0}], "id": 3160, "stable_key": "clu_37cc03b2fd258453-2", "ground_truth": {"modern_name": "Toulouse", "confidence": "high", "type": "place", "description": "A city in southern France, historically significant for its printing and scientific observations.", "wikipedia_extract": "Toulouse (, too-LOOZ, French: [tuluz] ; Occitan: Tolosa [tuˈluzɔ] ) is a city in Southern France, the prefecture of the Haute-Garonne department and of the Occitania region. The city is on the banks of the River Garonne, 150 kilometres (93 miles) from the Mediterranean Sea, 230 km (143 mi) from the Atlantic Ocean and 680 km (420 mi) from Paris. It is the fourth-largest city in France after Paris, Marseille, and Lyon, with 511,684 inhabitants within its municipal boundaries (2022); its metropolitan area has a population of 1,513,396 inhabitants (2022). Toulouse is the central city of one of the 22 metropolitan councils of France. Between the 2014 and 2020 censuses, its metropolitan area was the third fastest growing among metropolitan areas larger than 500,000 inhabitants in France. Toulouse is the centre of the European aerospace industry, with the headquarters of Airbus, the SPOT satellite system, ATR and the Aerospace Valley."}, "cross_references": []}, {"canonical_name": "papagayos", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "parrots", "book_id": "kosmos_humboldt_1845", "name": "parrots", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["parrots"], "contexts": ["brightly-colored birds observed"]}, {"entity_id": "papagayos", "book_id": "historia_medicinal_monardes_1574", "name": "papagayos", "category": "ANIMAL", "subcategory": "BIRD", "count": 3, "variants": ["papagayos", "Pagayos"], "contexts": ["parrot meat", "parrot meat eaten"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "parrots", "target_book": "historia_medicinal_monardes_1574", "target_name": "papagayos", "similarity": 0.897}], "id": 3161, "stable_key": "clu_d08aec9fb366e9af", "ground_truth": {"wikipedia_extract": "Papagayos is a village in Chacabuco Department, San Luis Province, Argentina. Among the small towns that are at the feet of the Comechingones Mountains, Papagayos stands out by its particular landscape of caranday palms. It borders Villa Larca to the north, Tilisarao to the west, Villa del Carmen to the south and to the east, Córdoba Province. It has around 750 inhabitants. Its climate is mainly dry with a little summer precipitation. There are two theories about Papagayos' name."}, "cross_references": []}, {"canonical_name": "Blume", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 1, "total_mentions": 1, "members": [{"entity_id": "blom", "book_id": "kosmos_humboldt_1845", "name": "Blom", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Blom"], "contexts": ["author of 'Stat. Beschr. von Norwegen'"]}], "edges": [], "id": 3162, "stable_key": "clu_4e9850b0bbef51ab", "ground_truth": {"modern_name": "Carl Ludwig Blume", "confidence": "high", "type": "person", "birth_year": 1796, "death_year": 1862, "description": "Dutch botanist and physician, known for Indonesian flora", "wikidata_id": "Q76816", "wikidata_description": "German-Dutch botanist (1796-1862)", "wikipedia_url": "https://en.wikipedia.org/wiki/Carl%20Ludwig%20Blume", "wikipedia_extract": "Charles Ludwig de Blume or Karl Ludwig von Blume (9 June 1796 – 3 February 1862) was a German-Dutch botanist and entomologist who spent most of his professional life in the Netherlands and the Dutch East Indies. As deputy director of agriculture at the Bogor Botanical Gardens in Java (1823–1826) and later director of the Rijksherbarium in Leiden, he conducted extensive studies of Southeast Asian flora, publishing numerous influential works including Bijdragen tot de flora van Nederlandsch Indië (1825–1827) and Rumphia (1835–1849). Together with Philipp Franz von Siebold, Blume co-founded the Royal Society for the Encouragement of Horticulture in the Netherlands in 1842, helping to revitalise the country's reputation as a centre for botanical study and exotic plant cultivation. His scientific contributions were recognised with his election as a foreign member of the Royal Swedish Academy of Sciences in 1855, and his legacy is commemorated in the botanical journal Blumea, which bears his name. Blume was born at Braunschweig in Germany, but studied at Leiden University and spent his professional life working in the Dutch East Indies and in the Netherlands, where he was Director of the Rijksherbarium (state herbarium) at Leiden. His name is sometimes given in the Dutch language form Karel Lodewijk Blume, but the original German spelling is the one most widely used in botanical texts: even then there is confusion, as he is sometimes referred to as K.L."}, "cross_references": [{"found_name": "Linnæus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2721, "target_cluster_name": "Linnæus", "source_book": "llm_generated", "evidence_snippet": "Both were prominent botanists of the 18th and 19th centuries, with Blume being a student of Linnaeus's system.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were prominent botanists of the 18th and 19th centuries, with Blume being a student of Linnaeus's system.", "is_reverse": true}]}, {"canonical_name": "oxygen gas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "oxygenous", "book_id": "kosmos_humboldt_1845", "name": "oxygenous", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["oxygenous"], "contexts": ["content of swimming bladders"]}, {"entity_id": "oxygen_gas", "book_id": "connexion_physical_sciences_somerville_1858", "name": "oxygen gas", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["oxygen gas"], "contexts": ["element that combines with hydrogen", "gas studied in spectral analysis"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "oxygenous", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "oxygen gas", "similarity": 0.921}], "id": 3163, "stable_key": "clu_b365fc40f2e8aba7", "ground_truth": {"modern_name": "oxygen", "confidence": "high", "type": "chemical", "wikidata_id": "Q629", "wikidata_description": "chemical element with symbol O and atomic number 8"}, "cross_references": []}, {"canonical_name": "illum", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "luminary", "book_id": "kosmos_humboldt_1845", "name": "luminary", "category": "OBJE