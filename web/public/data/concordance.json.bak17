ipedia.org/wiki/Quebec"}, "cross_references": []}, {"canonical_name": "Paros", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "paro", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Paro", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Paro"], "contexts": ["river on whose eastern bank hills advance"]}, {"entity_id": "paros", "book_id": "kosmos_humboldt_1845", "name": "Paros", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Paros"], "contexts": ["island with geological formations and fossils", "island mentioned in relation to geology"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Paro", "target_book": "kosmos_humboldt_1845", "target_name": "Paros", "similarity": 0.931}], "id": 3468, "stable_key": "clu_d7d72ce0215b65fe", "ground_truth": {"modern_name": "Paros", "confidence": "high", "type": "place", "country": "Greece", "wikidata_id": "Q17432507", "wikidata_description": "genus of plants"}, "cross_references": []}, {"canonical_name": "K. C. von Leonhard", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "k__c__von_leonhard", "book_id": "relation_historique_humboldt_vol3_1825", "name": "K. C. von Leonhard", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["K. C. von Leonhard"], "contexts": ["translator of geognostic research"]}, {"entity_id": "karl_von_leonhard", "book_id": "kosmos_humboldt_1845", "name": "Karl von Leonhard", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Karl von Leonhard"], "contexts": ["experienced observer of mineralogy"]}, {"entity_id": "leonhard,_karl_von", "book_id": "kosmos_humboldt_1845", "name": "Leonhard, Karl von", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Leonhard, Karl von"], "contexts": ["geologist"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "K. C. von Leonhard", "target_book": "kosmos_humboldt_1845", "target_name": "Karl von Leonhard", "similarity": 0.916}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "K. C. von Leonhard", "target_book": "kosmos_humboldt_1845", "target_name": "Leonhard, Karl von", "similarity": 0.864}], "id": 3469, "stable_key": "clu_f3ffa73d1e39b8d9", "ground_truth": {"modern_name": "Karl C. von Leonhard", "confidence": "high", "type": "person", "birth_year": 1779, "death_year": 1862, "description": "German geologist and mineralogist, translator and geognostic researcher."}, "cross_references": []}, {"canonical_name": "Weald clay", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "weald_clày", "book_id": "relation_historique_humboldt_vol3_1825", "name": "weald clày", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["weald clày"], "contexts": ["clay from the Weald"]}, {"entity_id": "weald_clay", "book_id": "kosmos_humboldt_1845", "name": "Weald clay", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Weald clay"], "contexts": ["geological formation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "weald clày", "target_book": "kosmos_humboldt_1845", "target_name": "Weald clay", "similarity": 0.788}], "id": 3470, "stable_key": "clu_a4010d4fe9f4b5d1", "ground_truth": {"modern_name": "Weald Clay", "confidence": "high", "type": "mineral", "wikidata_id": "Q7977996", "wikidata_description": "geological formation in England"}, "cross_references": []}, {"canonical_name": "London clay", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "argile_de_londres", "book_id": "relation_historique_humboldt_vol3_1825", "name": "argile de Londres", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["argile de Londres"], "contexts": ["London clay"]}, {"entity_id": "london_clay", "book_id": "kosmos_humboldt_1845", "name": "London clay", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["London clay"], "contexts": ["geological deposit containing fossil fishes", "geological formation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "argile de Londres", "target_book": "kosmos_humboldt_1845", "target_name": "London clay", "similarity": 0.911}], "id": 3471, "stable_key": "clu_4897373d0355258a", "ground_truth": {"modern_name": "London Clay", "confidence": "high", "type": "mineral", "wikidata_id": "Q59637656", "wikidata_description": "scholarly article by David Atkinson published in June 1969", "wikipedia_extract": "The London Clay Formation is a marine geological formation of Ypresian (early Eocene Epoch, c. 54-50 million years ago) age which crops out in the southeast of England. The London Clay is well known for its fossil content. The fossils from the lower Eocene rocks indicate a moderately warm climate, the tropical or subtropical flora. Though sea levels changed during the deposition of the clay, the habitat was generally a lush forest – perhaps like in Indonesia or East Africa today – bordering a warm, shallow ocean. The London Clay is a stiff bluish clay which becomes brown when weathered and oxidized. Nodular lumps of pyrite are frequently found in the clay layers."}, "cross_references": []}, {"canonical_name": "pyroxenic nepheline", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "pyroxenic", "book_id": "relation_historique_humboldt_vol3_1825", "name": "pyroxenic", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["pyroxenic"], "contexts": ["porphyry type associated with amygdaloid"]}, {"entity_id": "pyroxenic_nepheline", "book_id": "kosmos_humboldt_1845", "name": "pyroxenic nepheline", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["pyroxenic nepheline"], "contexts": ["type of nepheline", "mineral type"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "pyroxenic", "target_book": "kosmos_humboldt_1845", "target_name": "pyroxenic nepheline", "similarity": 0.903}], "id": 3472, "stable_key": "clu_8f2790f7005bca20", "ground_truth": {"modern_name": "Nepheline syenite", "confidence": "high", "type": "mineral", "note": "The term 'pyroxenic nepheline' likely refers to nepheline within a syenitic or igneous rock context, often associated with minerals like pyroxene. Nepheline syenite is a suitable modern classification.", "wikidata_id": "Q130096103", "wikidata_description": "scholarly article published in 2015"}, "cross_references": [{"found_name": "Syénite", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1937, "target_cluster_name": "Syénite", "source_book": "llm_generated", "evidence_snippet": "Nepheline syenite is a specific type of syenite, a related igneous rock.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Nepheline syenite is a specific type of syenite, a related igneous rock.", "is_reverse": true}, {"found_name": "euphotide", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2047, "target_cluster_name": "euphotide", "source_book": "llm_generated", "evidence_snippet": "Nepheline is a component of nepheline syenite, as indicated by the candidate 'nepheline syenite (aka pyroxenic nepheline)'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Nepheline is a component of nepheline syenite, as indicated by the candidate 'nepheline syenite (aka pyroxenic nepheline)'.", "is_reverse": true}]}, {"canonical_name": "syenitic porphyry", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "porphyry", "book_id": "relation_historique_humboldt_vol3_1825", "name": "porphyry", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["porphyry"], "contexts": ["rock type, pyroxenic"]}, {"entity_id": "syenitic_porphyry", "book_id": "kosmos_humboldt_1845", "name": "syenitic porphyry", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["syenitic porphyry"], "contexts": ["igneous rock type", "type of porphyry"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "porphyry", "target_book": "kosmos_humboldt_1845", "target_name": "syenitic porphyry", "similarity": 0.914}], "id": 3473, "stable_key": "clu_969c93e452b5e744", "ground_truth": {"modern_name": "Syenitic porphyry", "confidence": "high", "type": "mineral"}, "cross_references": [{"found_name": "porphyries", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2561, "target_cluster_name": "porphyries", "source_book": "llm_generated", "evidence_snippet": "Syenitic porphyry is a specific type of porphyry, indicating a close petrological relationship.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Syenitic porphyry is a specific type of porphyry, indicating a close petrological relationship.", "is_reverse": true}]}, {"canonical_name": "Miniſtros", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "mineurs", "book_id": "relation_historique_humboldt_vol3_1825", "name": "mineurs", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["mineurs"], "contexts": ["workers in mines"]}, {"entity_id": "miniſtros", "book_id": "polyanthea_medicinal", "name": "Miniſtros", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Miniſtros", "Miniſtro"], "contexts": ["officials who need to stay awake", "official receiving information"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "mineurs", "target_book": "polyanthea_medicinal", "target_name": "Miniſtros", "similarity": 0.874}], "id": 3474, "stable_key": "clu_3a9263dcc8d0e021", "ground_truth": {"modern_name": "ministers", "confidence": "low", "type": "concept", "note": "The terms 'Miniſtros' (officials) and 'mineurs' (workers in mines) are too divergent and lack specific medical/scientific context to confidently identify a single referent. 'Ministers' is a general guess for the first term.", "wikidata_id": "Q83307", "wikidata_description": "politician who holds significant civil public office in a national or regional government, generally heading a ministry", "wikipedia_extract": "The Union Council of Ministers is the principal executive organ of the Government of India, which serves to aid and advise the President of India in execution of their functions. It is chaired by the Prime Minister of India and consists of the heads of each of the executive government ministries. Currently, the council is headed by Narendra Modi and consists of 71 fellow members. The council is answerable to the Lok Sabha. A smaller executive body called the Union Cabinet is the supreme decision-making body in India; it is a subset of the Union Council of Ministers who hold important portfolios and ministries of the government. Pursuant to Article 75(3), the Council of Ministers is responsible collectively to the lower house of the Indian parliament, called the Lok Sabha (House of the People).", "wikipedia_url": "https://en.wikipedia.org/wiki/Minister_%28government%29"}, "cross_references": []}, {"canonical_name": "Deshayes", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "des_hayes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "des Hayes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["des Hayes"], "contexts": ["physicists observing barometer variations"]}, {"entity_id": "deshayes", "book_id": "kosmos_humboldt_1845", "name": "Deshayes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Deshayes"], "contexts": ["laborer in tertiary formations research", "investigated organic life relations"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "des Hayes", "target_book": "kosmos_humboldt_1845", "target_name": "Deshayes", "similarity": 0.717}], "id": 3475, "stable_key": "clu_5c9e5dff826d6fc7", "ground_truth": {"modern_name": "Gérard Paul Deshayes", "confidence": "high", "type": "person", "birth_year": 1795, "death_year": 1875, "description": "French paleontologist and conchologist who studied tertiary formations.", "wikidata_id": "Q1559020", "wikidata_description": "French scientist (1795-1875)", "wikipedia_url": "https://en.wikipedia.org/wiki/G%C3%A9rard%20Paul%20Deshayes", "wikipedia_extract": "Gérard Paul Deshayes (French pronunciation: [ʒeʁaʁ pɔl deɛ]; 13 May 1795 – 9 June 1875) was a French geologist and conchologist. He was born in Nancy, his father at that time being professor of experimental physics in the École Centrale of the département Meurthe He studied medicine in Strasbourg, and afterwards took the degree of bachelier ès lettres in Paris in 1821; but he abandoned the medical profession in order to devote himself to natural history. For some time he gave private lessons on geology, and subsequently became professor of natural history in the Muséum National d'Histoire Naturelle. He was distinguished for his researches on the fossil mollusca of the Paris Basin and of other areas Cenozoic cover. His studies on the relations of the fossil to the recent species led him as early as 1829 to conclusions somewhat similar to those arrived at by Lyell, to whom Deshayes rendered much assistance in connection with the classification of the, then, Tertiary system into Eocene, Miocene and Pliocene. With André Étienne d'Audebert de Férussac, he co-authored an important study on terrestrial and river mollusks titled Histoire naturelle générale et particulière des Mollusques terrestres et fluviatiles (1820-1851)."}, "cross_references": []}, {"canonical_name": "capitaine Kater", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "capitaine_kater", "book_id": "relation_historique_humboldt_vol3_1825", "name": "capitaine Kater", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["capitaine Kater"], "contexts": ["observer in Mysore highlands"]}, {"entity_id": "captain_kater", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Captain Kater", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Captain Kater"], "contexts": ["determined pendulum length"]}, {"entity_id": "kater,_captain", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Kater, Captain", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Kater, Captain"], "contexts": ["determined approximate length of the pendulum"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "capitaine Kater", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Captain Kater", "similarity": 0.952}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "capitaine Kater", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Kater, Captain", "similarity": 0.911}], "id": 3476, "stable_key": "clu_bc446493fa688075", "ground_truth": {"modern_name": "Henry Kater", "confidence": "high", "type": "person", "birth_year": 1777, "death_year": 1835, "description": "English physicist known for his work on the pendulum and gravity."}, "cross_references": []}, {"canonical_name": "Hemmer", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "hemmer", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Hemmer", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Hemmer"], "contexts": ["scholar who noticed barometric variations"]}, {"entity_id": "hemmer", "book_id": "kosmos_humboldt_1845", "name": "Hemmer", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Hemmer"], "contexts": ["observer of falling stars", "on falling stars"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Hemmer", "target_book": "kosmos_humboldt_1845", "target_name": "Hemmer", "similarity": 1.0}], "id": 3477, "stable_key": "clu_4f28f44638544624", "ground_truth": {"modern_name": "Christian Friedrich Hemmer", "confidence": "high", "type": "person", "birth_year": 1731, "death_year": 1790, "description": "German physician and meteorologist, studied atmospheric electricity.", "note": "The context of barometric variations and falling stars strongly points to Christian Friedrich Hemmer, a meteorologist who worked with atmospheric electricity."}, "cross_references": []}, {"canonical_name": "Manheim", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "manheim", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Manheim", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Manheim"], "contexts": ["city of meteorological society"]}, {"entity_id": "manheim", "book_id": "kosmos_humboldt_1845", "name": "Manheim", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Manheim"], "contexts": ["location of observation", "city in Germany"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Manheim", "target_book": "kosmos_humboldt_1845", "target_name": "Manheim", "similarity": 1.0}], "id": 3478, "stable_key": "clu_fbe379204c79f36b", "ground_truth": {"modern_name": "Mannheim", "confidence": "high", "type": "place", "country": "Germany", "wikidata_id": "Q2119", "wikidata_description": "city in Baden-Württemberg, Germany", "wikipedia_url": "https://en.wikipedia.org/wiki/Mannheim", "wikipedia_extract": "Mannheim (German pronunciation: [ˈmanhaɪm] ; Palatine German: Mannem or Monnem), officially the University City of Mannheim (German: Universitätsstadt Mannheim), is the second-largest city in Baden-Württemberg after Stuttgart, the state capital, and Germany's 21st-largest city, with a population of over 315,000. It is located at the border with Rhineland-Palatinate. The city is the cultural and economic centre of the Rhine-Neckar, Germany's seventh-largest metropolitan region, with nearly 2.4 million inhabitants. Mannheim is located at the confluence of the Upper Rhine and the Neckar in the Kurpfalz (Electoral Palatinate) region of northwestern Baden-Württemberg. The city lies in the Upper Rhine Plain, Germany's warmest region, between the Palatine Forest and the Oden Forest. Mannheim forms a continuous urban zone of around 500,000 inhabitants with Ludwigshafen am Rhein in the Rhineland-Palatinate, while some northern suburbs lie in Hesse; Hamburg is the only other German city with a presence in two states other than its own."}, "cross_references": []}, {"canonical_name": "Essai sur la Geographie des Plantes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "essai_sur_la_géographie_des_plantes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Essai sur la Géographie des plantes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Essai sur la Géographie des plantes"], "contexts": ["title of a work"]}, {"entity_id": "essai_sur_la_geographie_des_plantes", "book_id": "kosmos_humboldt_1845", "name": "Essai sur la Geographie des Plantes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Essai sur la Geographie des Plantes"], "contexts": ["publication by Humboldt", "work by Humboldt on plant geography"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Essai sur la Géographie des plantes", "target_book": "kosmos_humboldt_1845", "target_name": "Essai sur la Geographie des Plantes", "similarity": 0.99}], "id": 3479, "stable_key": "clu_92857365bd7d7636", "ground_truth": {"modern_name": "Essay on the Geography of Plants", "confidence": "high", "type": "text", "note": "This is a direct translation of the title of Alexander von Humboldt's influential work.", "wikidata_id": "Q51469713", "wikidata_description": "1807 Humboldt text"}, "cross_references": []}, {"canonical_name": "état électrique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "état_électrique", "book_id": "relation_historique_humboldt_vol3_1825", "name": "état électrique", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["état électrique"], "contexts": ["measure of atmospheric electricity"]}, {"entity_id": "electrical_state", "book_id": "connexion_physical_sciences_somerville_1858", "name": "electrical state", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["electrical state"], "contexts": ["condition of particles related to electricity"]}, {"entity_id": "electric_state", "book_id": "connexion_physical_sciences_somerville_1858", "name": "electric state", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["electric state"], "contexts": ["condition of a body regarding electricity"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "état électrique", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "electrical state", "similarity": 0.935}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "état électrique", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "electric state", "similarity": 0.896}], "id": 3480, "stable_key": "clu_46751f11adefc4c3", "ground_truth": {"modern_name": "electrical state", "confidence": "high", "type": "concept", "note": "The context describes the condition of a body or particles concerning electricity, which is what 'electrical state' refers to.", "wikidata_id": "Q127391535", "wikidata_description": "scholarly article"}, "cross_references": []}, {"canonical_name": "emigration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "émigrations", "book_id": "relation_historique_humboldt_vol3_1825", "name": "émigrations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["émigrations"], "contexts": ["movement of people"]}, {"entity_id": "emigration", "book_id": "first_principles_spencer_1862", "name": "emigration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["emigration"], "contexts": ["movement of people out of a country"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "émigrations", "target_book": "first_principles_spencer_1862", "target_name": "emigration", "similarity": 0.924}], "id": 3481, "stable_key": "clu_d2f375b7868a3933", "ground_truth": {"modern_name": "Emigration", "confidence": "high", "type": "concept", "wikidata_id": "Q187668", "wikidata_description": "act of leaving one's country or region with the intent to settle permanently or temporarily in another", "wikipedia_url": "https://en.wikipedia.org/wiki/Emigration", "wikipedia_extract": "Emigration is the act of leaving a resident country or place of residence with the intent to settle elsewhere (to permanently leave a country). Conversely, immigration describes the movement of people into one country from another (to permanently move to a country). A migrant emigrates from their old country, and immigrates to their new country. Thus, both emigration and immigration describe migration, but from different countries' perspectives. Demographers examine push and pull factors for people to be pushed out of one place and attracted to another. There can be a desire to escape negative circumstances such as shortages of land or jobs, or unfair treatment."}, "cross_references": [{"found_name": "population", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1899, "target_cluster_name": "population", "source_book": "llm_generated", "evidence_snippet": "Emigration is a process that directly affects and alters population size and composition.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Emigration is a process that directly affects and alters population size and composition.", "is_reverse": true}, {"found_name": "dispersion", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 448, "target_cluster_name": "dispersion", "source_book": "llm_generated", "evidence_snippet": "Emigration is a specific form of dispersal, referring to the movement of individuals out of a particular area.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Emigration is a specific form of dispersal, referring to the movement of individuals out of a particular area.", "is_reverse": true}, {"found_name": "migration", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 808, "target_cluster_name": "migration", "source_book": "llm_generated", "evidence_snippet": "Emigration is a specific type of migration, involving movement away from a place.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Emigration is a specific type of migration, involving movement away from a place.", "is_reverse": true}, {"found_name": "integration", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1873, "target_cluster_name": "integration", "source_book": "llm_generated", "evidence_snippet": "Emigration is the inverse process of immigration, and both are integral to the concept of migrant integration.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Emigration is the inverse process of immigration, and both are integral to the concept of migrant integration.", "is_reverse": true}]}, {"canonical_name": "Gryphites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "gryphites", "book_id": "relation_historique_humboldt_vol3_1825", "name": "gryphites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["gryphites"], "contexts": ["fossil found in jurassic limestone"]}, {"entity_id": "gryphites", "book_id": "kosmos_humboldt_1845", "name": "Gryphites", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Gryphites"], "contexts": ["fossil bivalve mollusk", "fossil bivalve remains"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "gryphites", "target_book": "kosmos_humboldt_1845", "target_name": "Gryphites", "similarity": 0.825}], "id": 3482, "stable_key": "clu_73009da9fa905e8d", "ground_truth": {"modern_name": "Fossil bivalve mollusk", "confidence": "medium", "type": "animal", "note": "The term 'Gryphites' likely refers to a fossil, and the context suggests a bivalve mollusk, possibly related to Gryphaea. Precise Linnaean classification is uncertain without more context.", "wikidata_id": "Q59096161", "wikidata_description": "scientific article published in Nature"}, "cross_references": []}, {"canonical_name": "frescas", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "fraîche", "book_id": "relation_historique_humboldt_vol3_1825", "name": "fraîche", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["fraîche"], "contexts": ["quality of being cool"]}, {"entity_id": "frescas", "book_id": "polyanthea_medicinal", "name": "frescas", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["frescas", "fresco"], "contexts": ["quality of rooms", "quality of eggs, beneficial"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "fraîche", "target_book": "polyanthea_medicinal", "target_name": "frescas", "similarity": 0.959}], "id": 3483, "stable_key": "clu_dee1748e5aa6b341", "ground_truth": {"modern_name": "Coolness", "confidence": "high", "type": "concept", "wikidata_id": "Q127893313", "wikidata_description": "scholarly article", "wikipedia_extract": "Coolness, or being cool, is the aesthetic quality of something (such as attitude, behavior, appearance, or style) being compatible with currently admirable social norms of society or a group of people. Because of the varied and changing interpretation of what is considered cool, as well as its subjective nature, the word has no single meaning. For most, coolness is associated with exemplifying composure and self-control. When used in conversation, it is often as an expression of admiration or approval, and can be used when referencing both people and items of interest. Although commonly regarded as slang, cool is widely used among disparate social groups and has endured in usage for generations. Below are some concise definitions that try to capture its different usages: \"If status is about standing, cool is about standing free.\" – Grant McCracken \"Cool is a knowledge, a way of life.\" – Lewis MacAdams \"Cool is an age-specific phenomenon, defined as the central behavioural trait of teenagerhood.\" \"Coolness is the proper way you represent yourself to a human being.\" – Robert Farris Thompson In the novel Spook Country by William Gibson, one character equates cool with a sense of exclusivity: \"'Secrets,' said the Bigend beside her, 'are the very root of cool.'\" In the novel Lords and Ladies by Terry Pratchett, the \"Monks of Cool\" are mentioned."}, "cross_references": [{"found_name": "temperature", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 45, "target_cluster_name": "temperature", "source_book": "llm_generated", "evidence_snippet": "Coolness is a qualitative description of a lower temperature range.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Coolness is a qualitative description of a lower temperature range.", "is_reverse": true}]}, {"canonical_name": "suicide", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "suicide", "book_id": "relation_historique_humboldt_vol3_1825", "name": "suicide", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["suicide"], "contexts": ["act of self-killing"]}, {"entity_id": "suicide", "book_id": "principles_of_psychology_james_1890", "name": "suicide", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["suicide"], "contexts": ["attempt driven by distress", "act of self-destruction"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "suicide", "target_book": "principles_of_psychology_james_1890", "target_name": "suicide", "similarity": 1.0}], "id": 3484, "stable_key": "clu_25f83835a587650f", "ground_truth": {"wikipedia_extract": "Suicide is the act of intentionally causing one's own death. Risk factors for suicide include mental disorders, neurodevelopmental disorders, physical disorders, and substance abuse. Some suicides are impulsive acts driven by stress (such as from financial or academic difficulties), relationship problems (such as breakups or divorces), or harassment and bullying. Those who have previously attempted suicide are at a higher risk for future attempts. Effective suicide prevention efforts include limiting access to methods of suicide such as firearms, drugs, and poisons; treating mental disorders and substance abuse; careful media reporting about suicide; improving economic conditions; and psychotherapy, primarily dialectical behaviour therapy (DBT) and cognitive behavioural therapy (CBT). Although crisis hotlines, like 988 in North America and 13 11 14 in Australia, are common resources, their effectiveness has not been well studied."}, "cross_references": [{"found_name": "morte", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 91, "target_cluster_name": "morte", "source_book": "llm_generated", "evidence_snippet": "Suicide is the act of intentionally causing one's own death, making it a direct cause of the state of 'death'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Suicide is the act of intentionally causing one's own death, making it a direct cause of the state of 'death'.", "is_reverse": true}]}, {"canonical_name": "Plates", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "panes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "panes", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["panes"], "contexts": ["Spanish term for sugar forms"]}, {"entity_id": "plates", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Plates", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Plates", "plates"], "contexts": ["components of a voltaic battery", "vibrating objects for experiments"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "panes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Plates", "similarity": 0.89}], "id": 3485, "stable_key": "clu_1c78652cb6971ef6", "ground_truth": {"modern_name": "Electrode", "confidence": "medium", "type": "object", "note": "The term 'Plates' used in the context of a 'voltaic battery' refers to electrodes. The Spanish term for sugar forms is a different usage of 'platos'.", "wikidata_id": "Q2704989", "wikidata_description": "Pokémon species", "wikipedia_url": "https://en.wikipedia.org/wiki/Electrode%20%28Pok%C3%A9mon%29"}, "cross_references": [{"found_name": "battery", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 936, "target_cluster_name": "battery", "source_book": "llm_generated", "evidence_snippet": "Electrodes are essential components of a galvanic battery, facilitating the flow of electricity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Electrodes are essential components of a galvanic battery, facilitating the flow of electricity.", "is_reverse": true}, {"found_name": "electric spark", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1045, "target_cluster_name": "electric spark", "source_book": "llm_generated", "evidence_snippet": "Electrodes are often the points between which an electric spark occurs.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Electrodes are often the points between which an electric spark occurs.", "is_reverse": true}, {"found_name": "voltaic pile", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2440, "target_cluster_name": "voltaic pile", "source_book": "llm_generated", "evidence_snippet": "Electrodes are essential components of the Voltaic pile, serving as the points where electrical current enters or leaves the pile.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Electrodes are essential components of the Voltaic pile, serving as the points where electrical current enters or leaves the pile.", "is_reverse": true}]}, {"canonical_name": "albuminoid matter", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "albumine", "book_id": "relation_historique_humboldt_vol3_1825", "name": "albumine", "category": "SUBSTANCE", "subcategory": "OTHER_SU