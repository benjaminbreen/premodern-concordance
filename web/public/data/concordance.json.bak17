tegory": "OTHER_DISEASE", "count": 1, "variants": ["Sarampio"], "contexts": ["name for the disease"]}, {"entity_id": "sarampãos", "book_id": "polyanthea_medicinal", "name": "sarampãos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 8, "variants": ["sarampãos", "Sarampaõ", "sarampao", "sarampão"], "contexts": ["measles", "disease treated with Bezoartic cordial"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Sarampio", "target_book": "polyanthea_medicinal", "target_name": "sarampãos", "similarity": 0.891}], "id": 2228, "stable_key": "clu_53c5a49a4251c645", "ground_truth": {"modern_name": "Measles", "confidence": "high", "type": "disease", "description": "A highly contagious infectious disease causing fever and rash.", "note": "Refers to the eruptive fever known as measles.", "wikipedia_extract": "Measles (probably from Middle Dutch or Middle High German masel(e), meaning \"blemish, blood blister\") is a highly contagious, vaccine-preventable infectious disease caused by measles virus. Other names include morbilli, rubeola, 9-day measles, red measles, and English measles. Symptoms usually develop 10–12 days after exposure to an infected person and last 7–10 days. Initial symptoms typically include fever, often greater than 40 °C (104 °F), cough, runny nose, and inflamed eyes. Small white spots known as Koplik spots may form inside the mouth two or three days after the start of symptoms. A red, flat rash which usually starts on the face and then spreads to the rest of the body typically begins three to five days after the start of symptoms."}, "cross_references": [{"found_name": "bexigas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 565, "target_cluster_name": "bexigas", "source_book": "llm_generated", "evidence_snippet": "Measles (sarampãos) is a common childhood infectious disease that shares some epidemiological and symptomatic similarities with smallpox, often being discussed in proximity in historical medical texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Measles (sarampãos) is a common childhood infectious disease that shares some epidemiological and symptomatic similarities with smallpox, often being discussed in proximity in historical medical texts.", "is_reverse": true}]}, {"canonical_name": "viſta", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "viſcoſos", "book_id": "historia_medicinal_monardes_1574", "name": "viſcoſos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["viſcoſos"], "contexts": ["type of humors evacuated by the root"]}, {"entity_id": "viſta", "book_id": "polyanthea_medicinal", "name": "viſta", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["viſta"], "contexts": ["sight affected by sores", "sight, which can be lost or restored"]}, {"entity_id": "viſcoſos", "book_id": "polyanthea_medicinal", "name": "viſcoſos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["viſcoſos"], "contexts": ["describing humors causing paralysis", "viscous quality"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "viſcoſos", "target_book": "polyanthea_medicinal", "target_name": "viſta", "similarity": 0.893}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "viſcoſos", "target_book": "polyanthea_medicinal", "target_name": "viſcoſos", "similarity": 1.0}], "id": 2229, "stable_key": "clu_51451082a749ae87", "ground_truth": {"modern_name": "viscous humors", "confidence": "high", "type": "concept", "note": "The term 'vista' appears to be a transcription error or a variant spelling of 'viscous' or 'viscosos' in the provided contexts, referring to the quality of humors."}, "cross_references": [{"found_name": "fangue", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1566, "target_cluster_name": "fangue", "source_book": "llm_generated", "evidence_snippet": "Blood was considered a viscous humor in humoral theory.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Blood was considered a viscous humor in humoral theory.", "is_reverse": true}]}, {"canonical_name": "quotidianas", "category": "DISEASE", "subcategory": "ACUTE", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "cotidíanas", "book_id": "historia_medicinal_monardes_1574", "name": "Cotidíanas", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["Cotidíanas"], "contexts": ["daily fevers"]}, {"entity_id": "quotidianas", "book_id": "polyanthea_medicinal", "name": "quotidianas", "category": "DISEASE", "subcategory": "ACUTE", "count": 8, "variants": ["quotidianas", "quotidiana", "quotidiana continua", "quotidiane"], "contexts": ["quotidian fevers", "fever type, 'quotidians'"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Cotidíanas", "target_book": "polyanthea_medicinal", "target_name": "quotidianas", "similarity": 0.937}], "id": 2230, "stable_key": "clu_140fbc177967fe05", "ground_truth": {"modern_name": "Quotidian fever", "confidence": "high", "type": "disease", "description": "A type of fever that recurs daily.", "wikipedia_extract": "Fever or pyrexia in humans is a symptom of an anti-infection defense mechanism that appears with body temperature exceeding the normal range caused by an increase in the body's temperature set point in the hypothalamus. There is no single agreed-upon upper limit for normal temperature: sources use values ranging between 37.2 and 38.3 °C (99.0 and 100.9 °F) in humans. The increase in set point triggers increased muscle contractions and causes a feeling of cold or chills. This results in greater heat production and efforts to conserve heat. When the set point temperature returns to normal, a person feels hot, becomes flushed, and may begin to sweat. Rarely a fever may trigger a febrile seizure, with this being more common in young children."}, "cross_references": [{"found_name": "febre latica", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4497, "target_cluster_name": "febre latica", "source_book": "llm_generated", "evidence_snippet": "A type of fever characterized by occurring daily.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: A type of fever characterized by occurring daily.", "is_reverse": true}]}, {"canonical_name": "Palestina", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "palestina", "book_id": "coloquios_da_orta_1563", "name": "Palestina", "category": "PLACE", "subcategory": "REGION", "count": 8, "variants": ["Palestina", "Pales-tina"], "contexts": ["region where benjuy is traded", "place where mungo is found"]}, {"entity_id": "palestina", "book_id": "polyanthea_medicinal", "name": "Palestina", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Palestina"], "contexts": ["place where miracle did not occur"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Palestina", "target_book": "polyanthea_medicinal", "target_name": "Palestina", "similarity": 0.948}], "id": 2231, "stable_key": "clu_e2adec3c9feb0437", "ground_truth": {"modern_name": "Palestine", "confidence": "high", "type": "place", "description": "Geographic region in the Middle East, historically significant for trade and religious importance.", "wikipedia_extract": "Palestine, officially the State of Palestine, is a country in West Asia. It encompasses the Israeli-occupied West Bank, including East Jerusalem, and the Gaza Strip, collectively known as the Palestinian territories. The territories share the vast majority of their borders with Israel, with the West Bank bordering Jordan to the east and the Gaza Strip bordering Egypt to the southwest. It has a total land area of 6,020 square kilometres (2,320 sq mi) while its population exceeds five million. Its proclaimed capital is Jerusalem, while Ramallah serves as its de facto administrative center. Gaza was its largest city prior to evacuations in 2023."}, "cross_references": [{"found_name": "Judea", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1971, "target_cluster_name": "Judéa", "source_book": "llm_generated", "evidence_snippet": "Judea is a historical region that largely overlaps with modern-day Palestine and is often considered a precursor or component of the historical entity referred to as Palestine.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Judea is a historical region that largely overlaps with modern-day Palestine and is often considered a precursor or component of the historical entity referred to as Palestine."}, {"found_name": "Syria", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1702, "target_cluster_name": "Syria", "source_book": "llm_generated", "evidence_snippet": "Syria is a neighboring region that has historically been closely linked to Palestine, with periods where they were administered together or had significant cultural and political overlap.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Syria is a neighboring region that has historically been closely linked to Palestine, with periods where they were administered together or had significant cultural and political overlap."}, {"found_name": "Jerusalem", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 954, "target_cluster_name": "Jerusalém", "source_book": "llm_generated", "evidence_snippet": "Jerusalem is a major city located within the historical and modern territory of Palestine, holding immense religious and historical significance for the region.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Jerusalem is a major city located within the historical and modern territory of Palestine, holding immense religious and historical significance for the region."}, {"found_name": "Judéa", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1971, "target_cluster_name": "Judéa", "source_book": "llm_generated", "evidence_snippet": "Palestine is a historical region that largely overlaps with Judea and is often used interchangeably or in close historical context.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Palestine is a historical region that largely overlaps with Judea and is often used interchangeably or in close historical context.", "is_reverse": true}]}, {"canonical_name": "seda", "category": "SUBSTANCE", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "seda", "book_id": "coloquios_da_orta_1563", "name": "seda", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 8, "variants": ["seda", "seda da china", "seda solta", "seda tecida"], "contexts": ["fibrous material from silkworms", "textile material traded"]}, {"entity_id": "seda", "book_id": "polyanthea_medicinal", "name": "seda", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["seda"], "contexts": ["silk"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "seda", "target_book": "polyanthea_medicinal", "target_name": "seda", "similarity": 1.0}], "id": 2232, "stable_key": "clu_75c5859898e54609", "ground_truth": {"modern_name": "silk", "confidence": "high", "type": "object", "description": "A natural protein fiber produced by certain insect larvae, spun into a soft, lustrous textile.", "note": "Refers to the material produced by silkworms.", "wikipedia_extract": "Silk is a natural protein fiber, some forms of which can be woven into textiles. The protein fiber of silk is composed mainly of fibroin. It is most commonly produced by certain insect larvae to form cocoons. The best-known silk is obtained from the cocoons of the larvae of the mulberry silkworm Bombyx mori, which are reared in captivity (sericulture). The shimmery appearance of silk is due to the triangular prism-like structure of the silk fiber, which causes silk cloth to refract incoming light at different angles, thus producing different colors. Harvested silk is produced by numerous insects; generally, only the silk of various moth caterpillars has been used for textile manufacturing."}, "cross_references": [{"found_name": "silk", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 2353, "target_cluster_name": "silk", "source_book": "llm_generated", "evidence_snippet": "This is the Portuguese word for silk, appearing in the entity description.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "reverse: This is the Portuguese word for silk, appearing in the entity description.", "is_reverse": true}]}, {"canonical_name": "tamalapatra", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "tamalapatra", "book_id": "coloquios_da_orta_1563", "name": "tamalapatra", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["tamalapatra", "Tamalapatra", "tamala pattra", "tamalapatrae", "tamcdapatra"], "contexts": ["Indian name for folio indo", "Indian name for 'folio indo', meaning leaf of tamala"]}, {"entity_id": "tamalàbatro", "book_id": "ricettario_fiorentino_1597", "name": "Tamalàbatro", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Tamalàbatro"], "contexts": ["plant for syrup"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "tamalapatra", "target_book": "ricettario_fiorentino_1597", "target_name": "Tamalàbatro", "similarity": 0.884}], "id": 2233, "stable_key": "clu_f61062d36b13f479", "ground_truth": {"modern_name": "Cinnamomum tamala", "confidence": "high", "type": "plant", "linnaean": "Cinnamomum tamala Nees & Eberm.", "family": "Lauraceae", "note": "Also known as Indian Cassia or Tezpatl in Mesoamerica. The context suggests it's a spice leaf from India.", "wikidata_id": "Q1661611", "wikidata_description": "species of plant"}, "cross_references": [{"found_name": "Cassia", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 317, "target_cluster_name": "cássia", "source_book": "llm_generated", "evidence_snippet": "Cassia is a genus closely related to Cinnamomum, and some species within Cassia are also used as spices and are sometimes confused with true cinnamon. Cinnamomum tamala is sometimes classified under the genus Cassia in older texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Cassia is a genus closely related to Cinnamomum, and some species within Cassia are also used as spices and are sometimes confused with true cinnamon. Cinnamomum tamala is sometimes classified under the genus Cassia in older texts."}, {"found_name": "Amomum", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2029, "target_cluster_name": "Amomum", "source_book": "llm_generated", "evidence_snippet": "Amomum is a genus of plants in the ginger family (Zingiberaceae), which also includes cardamom. While not directly related botanically to Cinnamomum, both genera are important sources of aromatic spices used in historical pharmacopoeias and cuisines.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Amomum is a genus of plants in the ginger family (Zingiberaceae), which also includes cardamom. While not directly related botanically to Cinnamomum, both genera are important sources of aromatic spices used in historical pharmacopoeias and cuisines."}]}, {"canonical_name": "Margarita", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "margarita", "book_id": "coloquios_da_orta_1563", "name": "Margarita", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 8, "variants": ["margarita", "Margarita"], "contexts": ["topic related to aljôfar", "Latin name for small pearl"]}, {"entity_id": "margarita", "book_id": "polyanthea_medicinal", "name": "Margarita", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Margarita"], "contexts": ["pearl, used in medicine"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Margarita", "target_book": "polyanthea_medicinal", "target_name": "Margarita", "similarity": 1.0}], "id": 2234, "stable_key": "clu_8b527c0d02d86d1c", "ground_truth": {"modern_name": "pearl", "confidence": "high", "type": "mineral", "description": "A hard, glistening object produced within the soft tissue of a living shelled mollusk.", "wikipedia_extract": "A pearl is a hard, glistening object produced within the soft tissue (specifically the mantle) of a living shelled mollusk or another animal, such as fossil  conulariids. Just like the shell of a mollusk, a pearl is composed of calcium carbonate (mainly aragonite or a mixture of aragonite and calcite) in minute crystalline form, which has deposited in concentric layers. More commercially valuable pearls are perfectly round and smooth, but many other shapes, known as baroque pearls, can occur. The finest quality of natural pearls have been highly valued as gemstones and objects of beauty for many centuries. Because of this, pearl has become a metaphor for something rare, fine, admirable, and valuable. The most valuable pearls occur spontaneously in the wild but are extremely rare."}, "cross_references": [{"found_name": "Coral", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 630, "target_cluster_name": "Coral", "source_book": "llm_generated", "evidence_snippet": "Both pearls and coral are organic materials prized for their beauty and used in jewelry and ornamentation.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both pearls and coral are organic materials 