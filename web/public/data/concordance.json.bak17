r_name": "pombos", "source_book": "llm_generated", "evidence_snippet": "The entity description explicitly identifies 'rock pigeon' as a common name for the rock dove (Columba livia).", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: The entity description explicitly identifies 'rock pigeon' as a common name for the rock dove (Columba livia).", "is_reverse": true}]}, {"canonical_name": "temperate regions", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "temperate_regions", "book_id": "origin_of_species_darwin_1859", "name": "temperate regions", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["temperate regions"], "contexts": ["regions with moderate climate"]}, {"entity_id": "temperate_regions", "book_id": "first_principles_spencer_1862", "name": "temperate regions", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["temperate regions"], "contexts": ["regions where plant-life diminishes"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "temperate regions", "target_book": "first_principles_spencer_1862", "target_name": "temperate regions", "similarity": 1.0}], "id": 4008, "stable_key": "clu_f68c2e657c006a90", "ground_truth": {"modern_name": "Temperate climate zones", "confidence": "high", "type": "place", "wikidata_id": "Q167466", "wikidata_description": "main climate class"}, "cross_references": [{"found_name": "Latitude", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 551, "target_cluster_name": "latitude", "source_book": "llm_generated", "evidence_snippet": "Temperate zones are defined by their latitudinal position between the tropics and the polar regions.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Temperate zones are defined by their latitudinal position between the tropics and the polar regions."}, {"found_name": "Season", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 401, "target_cluster_name": "Seasons", "source_book": "llm_generated", "evidence_snippet": "Temperate climates are characterized by distinct seasonal changes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Temperate climates are characterized by distinct seasonal changes."}, {"found_name": "Temperature", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 45, "target_cluster_name": "temperature", "source_book": "llm_generated", "evidence_snippet": "Temperate climates are defined by their temperature ranges throughout the year.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Temperate climates are defined by their temperature ranges throughout the year."}, {"found_name": "Zone", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4128, "target_cluster_name": "zone", "source_book": "llm_generated", "evidence_snippet": "Temperate is a type of climate zone.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Temperate is a type of climate zone."}]}, {"canonical_name": "arctic flora", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "arctic_flora", "book_id": "origin_of_species_darwin_1859", "name": "arctic flora", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["arctic flora"], "contexts": ["plants of arctic regions"]}, {"entity_id": "sub-arctic_flora", "book_id": "kosmos_humboldt_1845", "name": "sub-Arctic flora", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["sub-Arctic flora"], "contexts": ["flora adapted to cold climates"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "arctic flora", "target_book": "kosmos_humboldt_1845", "target_name": "sub-Arctic flora", "similarity": 0.952}], "id": 4009, "stable_key": "clu_9254778512b46f4f", "ground_truth": {"modern_name": "Arctic flora", "confidence": "high", "type": "plant", "wikipedia_extract": "Arctic geopolitics is the area study of geopolitics on the Arctic region. The study of geopolitics deals with the \"inalienable relationship between geography and politics\", as it investigates the effects of the Earth's geography on politics and international relations. Arctic geopolitics focuses on the inter-state relations in the Arctic, which is the northernmost polar region. It is composed of the Arctic Ocean and its adjacent seas, and is home to around four million people. The states in or bordering the Arctic are commonly referred to as the Arctic Eight, and are the United States, Canada, Russia, Finland, the Kingdom of Denmark (Greenland), Norway, Iceland and Sweden. The Arctic region is a unique environment.", "wikipedia_url": "https://en.wikipedia.org/wiki/Geopolitics_of_the_Arctic"}, "cross_references": [{"found_name": "Floras", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2595, "target_cluster_name": "Floras", "source_book": "llm_generated", "evidence_snippet": "Arctic flora is a specific type of flora, defined by its geographical location (arctic regions).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Arctic flora is a specific type of flora, defined by its geographical location (arctic regions).", "is_reverse": true}]}, {"canonical_name": "glacial action", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "glacial_action", "book_id": "origin_of_species_darwin_1859", "name": "glacial action", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["glacial action"], "contexts": ["process of ice shaping the land"]}, {"entity_id": "igneous_action", "book_id": "first_principles_spencer_1862", "name": "igneous action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["igneous action"], "contexts": ["process involving molten rock"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "glacial action", "target_book": "first_principles_spencer_1862", "target_name": "igneous action", "similarity": 0.927}], "id": 4010, "stable_key": "clu_11b2a9768e716fe1", "ground_truth": {"modern_name": "Glacial erosion", "confidence": "high", "type": "concept", "note": "The cluster combines 'glacial action' with 'igneous action'. 'Glacial action' clearly refers to the geological processes of glaciers.", "wikidata_id": "Q11549661", "wikidata_description": "geologic process"}, "cross_references": [{"found_name": "Glacial period", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1640, "target_cluster_name": "Glacial period", "source_book": "llm_generated", "evidence_snippet": "The Glacial Period is a geological epoch characterized by extensive glaciation, and glacial erosion is a direct consequence and defining feature of such periods.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Glacial Period is a geological epoch characterized by extensive glaciation, and glacial erosion is a direct consequence and defining feature of such periods.", "is_reverse": true}, {"found_name": "sedimentary rocks", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2128, "target_cluster_name": "sedimentary rocks", "source_book": "llm_generated", "evidence_snippet": "Glacial erosion can significantly shape and deposit sedimentary materials, influencing the formation of sedimentary rocks.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Glacial erosion can significantly shape and deposit sedimentary materials, influencing the formation of sedimentary rocks.", "is_reverse": true}]}, {"canonical_name": "intertropical regions", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "intertropical_regions", "book_id": "origin_of_species_darwin_1859", "name": "intertropical regions", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["intertropical regions"], "contexts": ["regions near the equator"]}, {"entity_id": "america_intertropical", "book_id": "coloquios_da_orta_1563", "name": "America intertropical", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["America intertropical"], "contexts": ["region where pepper is cultivated"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "intertropical regions", "target_book": "coloquios_da_orta_1563", "target_name": "America intertropical", "similarity": 0.886}], "id": 4011, "stable_key": "clu_0ee92cd6c0fd230c", "ground_truth": {"modern_name": "Intertropical regions", "confidence": "high", "type": "place", "country": "Global"}, "cross_references": [{"found_name": "terra", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 709, "target_cluster_name": "terra", "source_book": "llm_generated", "evidence_snippet": "Intertropical regions are geographical areas on Earth.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Intertropical regions are geographical areas on Earth.", "is_reverse": true}, {"found_name": "temperate zone", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2535, "target_cluster_name": "temperate zone", "source_book": "llm_generated", "evidence_snippet": "The temperate zone is geographically and climatically distinct from the intertropical regions, representing a contrasting climate band.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The temperate zone is geographically and climatically distinct from the intertropical regions, representing a contrasting climate band.", "is_reverse": true}]}, {"canonical_name": "whirlwinds", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "whirlwinds", "book_id": "origin_of_species_darwin_1859", "name": "whirlwinds", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["whirlwinds"], "contexts": ["accidental means of fish transport"]}, {"entity_id": "whirlwind", "book_id": "connexion_physical_sciences_somerville_1858", "name": "whirlwind", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["whirlwind"], "contexts": ["storm phenomenon with augmented breadth"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "whirlwinds", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "whirlwind", "similarity": 0.932}], "id": 4012, "stable_key": "clu_7035d4a76a88656c", "ground_truth": {"modern_name": "Whirlwind", "confidence": "high", "type": "concept"}, "cross_references": []}, {"canonical_name": "E. V.", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "e__v_", "book_id": "origin_of_species_darwin_1859", "name": "E. V.", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["E. V."], "contexts": ["informed about birds blown to Madeira"]}, {"entity_id": "j__v_", "book_id": "principles_of_psychology_james_1890", "name": "J. V.", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["J. V."], "contexts": ["person described as amiable and radiant"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "E. V.", "target_book": "principles_of_psychology_james_1890", "target_name": "J. V.", "similarity": 0.892}], "id": 4013, "stable_key": "clu_a0d8c5af9696f261", "ground_truth": {"modern_name": "E. V.", "confidence": "low", "type": "person", "description": "Individual mentioned in scientific correspondence", "note": "Insufficient information to identify specific individual.", "wikidata_id": "Q9299236", "wikidata_description": "registered voluntary association in Germany"}, "cross_references": []}, {"canonical_name": "Celebes", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "celebes", "book_id": "origin_of_species_darwin_1859", "name": "Celebes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Celebes"], "contexts": ["island in Indonesia"]}, {"entity_id": "celebes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Celebes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Celebes"], "contexts": ["island affected by eruption"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Celebes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Celebes", "similarity": 1.0}], "id": 4014, "stable_key": "clu_b4404d7f446a0a92", "ground_truth": {"modern_name": "Celebes", "confidence": "high", "type": "place", "country": "Indonesia", "note": "Modern name is Sulawesi.", "wikidata_id": "Q28831520", "wikidata_description": "species of bird", "wikipedia_url": "https://en.wikipedia.org/wiki/Sulawesi", "wikipedia_extract": "Sulawesi ( SOO-lə-WAY-see, Indonesian: [ˌsulaˈwesi]), also known as Celebes ( SEL-ib-eez, sə-LEE-beez), is an island in Indonesia. One of the four Greater Sunda Islands, and the world's 11th-largest island, it is situated east of Borneo, west of the Maluku Islands, and south of Mindanao and the Sulu Archipelago. Within Indonesia, only Sumatra, Borneo, and Papua are larger in territory, and only Java and Sumatra are more populous. The landmass of Sulawesi includes four peninsulas: the northern Minahasa Peninsula, the East Peninsula, the South Peninsula, and the Southeast Peninsula. Three gulfs separate these peninsulas: the Gulf of Tomini between the northern Minahasa and East peninsulas, the Tolo Gulf between the East and Southeast peninsulas, and the Gulf of Boni between the South and Southeast peninsulas. The Strait of Makassar runs along the western side of the island and separates the island from Borneo."}, "cross_references": [{"found_name": "Great Indian Archipelago", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1471, "target_cluster_name": "Great Indian Archipelago", "source_book": "llm_generated", "evidence_snippet": "Celebes (now Sulawesi) is a major island within the Indonesian Archipelago.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Celebes (now Sulawesi) is a major island within the Indonesian Archipelago.", "is_reverse": true}, {"found_name": "Sumatra", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 330, "target_cluster_name": "Sumatra", "source_book": "llm_generated", "evidence_snippet": "Sumbawa is an island in the Indonesian archipelago, near Celebes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Sumbawa is an island in the Indonesian archipelago, near Celebes.", "is_reverse": true}]}, {"canonical_name": "representative species", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "representative_species", "book_id": "origin_of_species_darwin_1859", "name": "representative species", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["representative species"], "contexts": ["similar species in different locations"]}, {"entity_id": "representative_species", "book_id": "kosmos_humboldt_1845", "name": "representative species", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["representative species"], "contexts": ["species similar to others in different regions"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "representative species", "target_book": "kosmos_humboldt_1845", "target_name": "representative species", "similarity": 1.0}], "id": 4015, "stable_key": "clu_c28d1673a24d3dbe", "ground_truth": {"modern_name": "Representative species", "confidence": "high", "type": "concept", "note": "This refers to a species that is representative of a group or geographical area, particularly in the context of biological classification and biogeography.", "wikidata_id": "Q121914121", "wikidata_description": "scientific article published in 2018"}, "cross_references": []}, {"canonical_name": "generative organs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "generative_organs", "book_id": "origin_of_species_darwin_1859", "name": "generative organs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["generative organs"], "contexts": ["reproductive organs"]}, {"entity_id": "generative_system", "book_id": "first_principles_spencer_1862", "name": "generative system", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["generative system"], "contexts": ["reproductive organs and structures"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "generative organs", "target_book": "first_principles_spencer_1862", "target_name": "generative system", "similarity": 0.935}], "id": 4016, "stable_key": "clu_59c50622bd85dcf6", "ground_truth": {"modern_name": "Reproductive organs", "confidence": "high", "type": "concept", "note": "Early modern texts often used 'generative' to refer to reproduction.", "wikidata_id": "Q44617256", "wikidata_description": "scientific article published on 2 December 2008"}, "cross_references": []}, {"canonical_name": "organs of vegetation", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "organs_of_vegetation", "book_id": "origin_of_species_darwin_1859", "name": "organs of vegetation", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["organs of vegetation"], "contexts": ["parts related to plant growth"]}, {"entity_id": "vegetable_organs", "book_id": "kosmos_humboldt_1845", "name": "vegetable organs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["vegetable organs"], "contexts": ["structures in plants"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "organs of vegetation", "target_book": "kosmos_humboldt_1845", "target_name": "vegetable organs", "similarity": 0.955}], "id": 4017, "stable_key": "clu_81271ce5c9861d76", "ground_truth": {"modern_name": "Plant organs", "confidence": "high", "type": "concept", "note": "This refers to the parts of a plant responsible for its growth and life processes, as opposed to animal anatomy.", "wikidata_id": "Q76149614", "wikidata_description": "scientific article published on 01 January 1951"}, "cross_references": []}, {"canonical_name": "Proteaceæ", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "proteaceæ", "book_id": "origin_of_species_darwin_1859", "name": "Proteaceæ", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Proteaceæ"], "contexts": ["plant family discussed by Robert Brown"]}, {"entity_id": "protéacées", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Protéacées", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Protéacées"], "contexts": ["plant family, not exclusively austral"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Proteaceæ", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Protéacées", "similarity": 0.936}], "id": 4018, "stable_key": "clu_bd357f4a48fa412b", "ground_truth": {"modern_name": "Proteaceae", "confidence": "high", "type": "plant", "family": "Proteaceae", "wikidata_id": "Q157228", "wikidata_description": "family of plants in the Proteales order", "wikipedia_url": "https://en.wikipedia.org/wiki/Grevilleoideae", "wikipedia_extract": "The Grevilleoideae are a subfamily of the plant family Proteaceae. Mainly restricted to the Southern Hemisphere, it contains around 46 genera and about 950 species. Genera include Banksia, Grevillea, and Macadamia. The Grevilleoideae grow as trees, shrubs, or subshrubs. They are highly variable, making a simple, diagnostic identification key for the subfamily essentially impossible to provide. One common and fairly diagnostic characteristic is the occurrence of flowers in pairs that share a common bract."}, "cross_references": []}, {"canonical_name": "adult", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "adult", "book_id": "origin_of_species_darwin_1859", "name": "adult", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["adult"], "contexts": ["fully developed organism"]}, {"entity_id": "adult", "book_id": "first_principles_spencer_1862", "name": "adult", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["adult"], "contexts": ["fully developed organism"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "adult", "target_book": "first_principles_spencer_1862", "target_name": "adult", "similarity": 1.0}], "id": 4019, "stable_key": "clu_fe93b6ac71440270", "ground_truth": {"modern_name": "Adult organism", "confidence": "high", "type": "concept", "note": "Refers to an organism that has reached full maturity and is capable of reproduction.", "wikidata_id": "Q130551624", "wikidata_description": ""}, "cross_references": []}, {"canonical_name": "Catasetum", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "catasetum", "book_id": "origin_of_species_darwin_1859", "name": "Catasetum", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Catasetum"], "contexts": ["genus of orchids"]}, {"entity_id": "catasetum_inaculutiun", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Catasetum inaculutiun", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Catasetum inaculutiun"], "contexts": ["orchid species"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Catasetum", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Catasetum inaculutiun", "similarity": 0.901}], "id": 4020, "stable_key": "clu_4e0c766419b57115", "ground_truth": {"wikipedia_extract": "Catasetum, abbreviated as Ctsm. in horticultural trade, is a genus of showy epiphytic  Orchids, family Orchidaceae, subfamily Epidendroideae, tribe Cymbidieae, subtribe Catasetinae, with currently 200 accepted species, many of which are highly prized in horticulture. Species of the genus Catasetum occur from Mexico to Argentina, including much of Central America, the West Indies, and South America. The largest number of species is in Brazil. They have thick, cigar-shaped pseudobulbs which are clustered. The leaves are pleated in the upper part and deciduous. The pseudobulbs become spiny after the leaves have dropped."}, "cross_references": [{"found_name": "Orchis", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2691, "target_cluster_name": "Orchis", "source_book": "llm_generated", "evidence_snippet": "Catasetum is a genus within the orchid family (Orchidaceae), making it a specific type of orchid.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Catasetum is a genus within the orchid family (Orchidaceae), making it a specific type of orchid.", "is_reverse": true}]}, {"canonical_name": "kangaroo", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "kangaroo", "book_id": "origin_of_species_darwin_1859", "name": "kangaroo", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["kangaroo"], "contexts": ["marsupial mammal"]}, {"entity_id": "kangaroo", "book_id": "kosmos_humboldt_1845", "name": "kangaroo", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["kangaroo"], "contexts": ["animal with fossil remains"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "kangaroo", "target_book": "kosmos_humboldt_1845", "target_name": "kangaroo", "similarity": 1.0}], "id": 4021, "stable_key": "clu_563ee0c7acf10eb0", "ground_truth": {"modern_name": "Kangaroo", "confidence": "high", "type": "animal", "wikidata_id": "Q23193", "wikidata_description": "family of mammals", "wikipedia_extract": "Tree-kangaroos are marsupials of the genus Dendrolagus, adapted for arboreal locomotion. They inhabit the tropical rainforests of New Guinea and far northeastern  Queensland, Australia along with some of the islands in the region. Most species of tree-kangaroo are considered threatened due to hunting and habitat destruction. They are the only true arboreal macropods. The evolutionary history of tree-kangaroos possibly begins with a rainforest floor-dwelling pademelon-like ancestor. This ancestor possibly evolved from an arboreal possum-like ancestor as is suspected of all macropodid marsupials in Australia and New Guinea.", "wikipedia_url": "https://en.wikipedia.org/wiki/Macropodidae"}, "cross_references": []}, {"canonical_name": "bones of the skull", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "bones_of_the_skull", "book_id": "origin_of_species_darwin_1859", "name": "bones of the skull", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["bones of the skull"], "contexts": ["skeletal structure protecting the brain"]}, {"entity_id": "cranial_bones", "book_id": "first_principles_spencer_1862", "name": "cranial bones", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["cranial bones"], "contexts": ["bones of the skull"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "bones of the skull", "target_book": "first_principles_spencer_1862", "target_name": "cranial bones", "similarity": 0.906}], "id": 4022, "stable_key": "clu_6bac0225b4181c72", "ground_truth": {"modern_name": "Cranial bones", "confidence": "high", "type": "concept", "wikidata_id": "Q6581923", "wikidata_description": ""}, "cross_references": []}, {"canonical_name": "bone", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "bone", "book_id": "origin_of_species_darwin_1859", "name": "bone", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["bone"], "contexts": ["hard connective tissue forming the skeleton"]}, {"entity_id": "bone", "book_id": "principles_of_psychology_james_1890", "name": "bone", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["bone"], "contexts": ["material held by dog's paw"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "bone", "target_book": "principles_of_psychology_james_1890", "target_name": "bone", "similarity": 1.0}], "id": 4023, "stable_key": "clu_0d705b78150e0712", "ground_truth": {"modern_name": "Bone", "confidence": "high", "type": "concept"}, "cross_references": [{"found_name": "organs of motion", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 429, "target_cluster_name": "organs of motion", "source_book": "llm_generated", "evidence_snippet": "Bones are a fundamental component of the musculoskeletal system.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Bones are a fundamental component of the musculoskeletal system.", "is_reverse": true}, {"found_name": "spine", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 457, "target_cluster_name": "spine", "source_book": "llm_generated", "evidence_snippet": "The spine is a major component of the skeletal 