rce_name": "Barcelone", "target_book": "kosmos_humboldt_1845", "target_name": "Barcelona", "similarity": 0.953}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Barcelone", "target_book": "coloquios_da_orta_1563", "target_name": "Barcelona", "similarity": 0.953}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Barcelone", "target_book": "polyanthea_medicinal", "target_name": "Barcelona", "similarity": 0.953}, {"source_book": "kosmos_humboldt_1845", "source_name": "Barcelona", "target_book": "coloquios_da_orta_1563", "target_name": "Barcelona", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Barcelona", "target_book": "polyanthea_medicinal", "target_name": "Barcelona", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Barcelona", "target_book": "polyanthea_medicinal", "target_name": "Barcelona", "similarity": 1.0}], "id": 246, "stable_key": "clu_ef17545ed386751c", "ground_truth": {"modern_name": "Barcelona", "confidence": "high", "type": "place", "description": "A major commercial and historical city, sometimes confused with a Venezuelan city.", "note": "Primary reference is the city in Spain, but also a city in Venezuela is mentioned.", "wikipedia_extract": "Barcelona is a city on the northeastern coast of Spain. It is the capital and largest city of the autonomous community of Catalonia, as well as the second-most populous municipality of Spain. With a population of 1.7 million within city limits, its urban area extends to numerous neighbouring municipalities within the province of Barcelona and is home to around 5.7 million people, making it the fifth most populous urban area of the European Union after Paris, the Ruhr area, Madrid and Milan. It is one of the largest metropolises on the Mediterranean Sea, located on the coast between the mouths of the rivers Llobregat and Besòs, bounded to the west by the Serra de Collserola mountain range. According to tradition, Barcelona was founded by either the Phoenicians or the Carthaginians, who had trading posts along the Catalonian coast. In the Middle Ages, Barcelona became the capital of the County of Barcelona."}, "cross_references": []}, {"canonical_name": "equilibrium", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 49, "members": [{"entity_id": "equilibrium", "book_id": "principles_of_psychology_james_1890", "name": "equilibrium", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["equilibrium"], "contexts": ["state of balance", "state of balance or stability"]}, {"entity_id": "equilibrium", "book_id": "kosmos_humboldt_1845", "name": "equilibrium", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["equilibrium"], "contexts": ["state of balance", "state disturbed at poles"]}, {"entity_id": "equilibrium", "book_id": "connexion_physical_sciences_somerville_1858", "name": "equilibrium", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 11, "variants": ["equilibrium"], "contexts": ["state of balance", "state of balance in electrical charge"]}, {"entity_id": "equilibrium", "book_id": "first_principles_spencer_1862", "name": "equilibrium", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 19, "variants": ["equilibrium"], "contexts": ["balance between constitution and conditions", "state of balance in forces"]}, {"entity_id": "equilibration", "book_id": "first_principles_spencer_1862", "name": "equilibration", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 14, "variants": ["equilibration", "Equilibration"], "contexts": ["process of reaching a stable state", "progress toward balance of forces"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "equilibrium", "target_book": "kosmos_humboldt_1845", "target_name": "equilibrium", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "s