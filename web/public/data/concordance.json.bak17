t]) is an Argentine professional sports club based in the Belgrano neighborhood of Buenos Aires. Founded in 1901, the club is named after the English-language name for the city's estuary, Río de la Plata. River's home stadium, the Monumental, is the largest in South America. River had the highest average home attendance of any association football club in the world in 2023 with 84,567. With more than 350,000 members at the end of 2023, River is one of the largest sports clubs by membership. It repeated this achievement in 2024 and 2025."}, "member_count": 9, "cross_references": [{"found_name": "Thames", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2715, "target_cluster_name": "Thames", "source_book": "llm_generated", "evidence_snippet": "The River Thames is a type of river.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The River Thames is a type of river.", "is_reverse": true}]}, {"canonical_name": "Primrose", "category": "PLANT", "subcategory": "HERB", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "primroses", "book_id": "english_physician_1652", "name": "Primroses", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Primroses"], "contexts": ["well known herb"]}, {"entity_id": "primrose", "book_id": "origin_of_species_darwin_1859", "name": "Primrose", "category": "PLANT", "subcategory": "HERB", "count": 6, "variants": ["Primrose", "primrose"], "contexts": ["plant differing from cowslip", "plant used in cross-fertilization experiments"]}, {"entity_id": "primrose", "book_id": "connexion_physical_sciences_somerville_1858", "name": "primrose", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["primrose"], "contexts": ["flower not found in Himalaya"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Primroses", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "primrose", "similarity": 0.908}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Primrose", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "primrose", "similarity": 0.77}], "id": 1013, "stable_key": "clu_66dbbd0c12841b08", "ground_truth": {"modern_name": "Primrose", "confidence": "high", "type": "plant", "linnaean": "Primula vulgaris", "family": "Primulaceae", "description": "A common spring-blooming herbaceous plant with pale yellow flowers.", "wikipedia_extract": "Primula vulgaris is a species of flowering plant in the family Primulaceae, native to Eurasia. The common name of this plant is primrose, or occasionally common primrose or English primrose to distinguish it from other Primula species referred to as primroses. Primula vulgaris is a perennial growing 10–30 centimetres (4–12 inches) tall, with a basal rosette of leaves which are more-or-less evergreen in favoured habitats. The leaves are 5–25 cm (2–10 in) long and 2–6 cm (1–2+1⁄2 in) broad, often heavily wrinkled, with an irregularly crenate to dentate margin. The leaf blade is gradually attenuated towards the base and unevenly toothed. The single stem, extremely short, is hidden in the centre of the leaf rosette."}, "cross_references": [{"found_name": "Primula", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 4034, "target_cluster_name": "Primula", "source_book": "llm_generated", "evidence_snippet": "Primula is the genus name for primroses, and Primula vulgaris is a species within this genus. Texts may use the genus name as a shorthand for the species or related species.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "Primula is the genus name for primroses, and Primula vulgaris is a species within this genus. Texts may use the genus name as a shorthand for the species or related species."}, {"found_name": "Cowslip", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2361, "target_cluster_name": "cowslip", "source_book": "llm_generated", "evidence_snippet": "Cowslip (Primula veris) is a closely related species within the same genus (Primula) and often discussed alongside the common primrose.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Cowslip (Primula veris) is a closely related species within the same genus (Primula) and often discussed alongside the common primrose."}]}, {"canonical_name": "physical conditions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 16, "members": [{"entity_id": "physical_conditions", "book_id": "origin_of_species_darwin_1859", "name": "physical conditions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["physical conditions"], "contexts": ["environmental factors affecting life", "environmental factors"]}, {"entity_id": "physical_conditions", "book_id": "principles_of_psychology_james_1890", "name": "physical conditions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["physical conditions"], "contexts": ["bodily basis of mental states"]}, {"entity_id": "physical_conditions", "book_id": "first_principles_spencer_1862", "name": "physical conditions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["physical conditions"], "contexts": ["state of health and environment", "environmental factors affecting life"]}, {"entity_id": "conditions_of_life", "book_id": "origin_of_species_darwin_1859", "name": "conditions of life", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["conditions of life"], "contexts": ["environmental factors affecting organisms", "environmental factors affecting survival"]}, {"entity_id": "condições_da_vida", "book_id": "coloquios_da_orta_1563", "name": "condições da vida", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["condições da vida"], "contexts": ["factors varying in Eastern lands"]}], "e