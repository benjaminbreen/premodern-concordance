umboldt_1845", "name": "botany", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["botany"], "contexts": ["scientific pursuit", "study of plants"]}, {"entity_id": "botânica", "book_id": "coloquios_da_orta_1563", "name": "botânica", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["botânica", "botânico"], "contexts": ["study of plants", "field of study"]}, {"entity_id": "botany", "book_id": "first_principles_spencer_1862", "name": "Botany", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Botany"], "contexts": ["scientific study of plants"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "botany", "target_book": "coloquios_da_orta_1563", "target_name": "botânica", "similarity": 0.955}, {"source_book": "kosmos_humboldt_1845", "source_name": "botany", "target_book": "first_principles_spencer_1862", "target_name": "Botany", "similarity": 0.967}, {"source_book": "coloquios_da_orta_1563", "source_name": "botânica", "target_book": "first_principles_spencer_1862", "target_name": "Botany", "similarity": 0.943}], "id": 1098, "stable_key": "clu_5f6e6f5d5f00d249", "ground_truth": {"modern_name": "Botany", "confidence": "high", "type": "concept", "wikidata_id": "Q441", "wikidata_description": "science of plant life", "wikipedia_url": "https://en.wikipedia.org/wiki/Botany", "wikipedia_extract": "Botany, also called phytology or plant science, is the branch of natural science and biology that studies plants, especially their anatomy, taxonomy, and ecology. A botanist or plant scientist is a scientist who specialises in this field. \"Plant\" and \"botany\" may be defined more narrowly to include only land plants and their study, which is also known as phytology. Phytologists or botanists (in the strict sense) study approximately 410,000 species of land plants, including some 391,000 species of vascular plants (of which approximately 369,000 are flowering plants) and approximately 20,000 bryophytes. Botany originated as prehistoric herbalism to identify and later cultivate plants that were edible, poisonous, and medicinal, making it one of the first endeavours of human investigation. Medieval physic gardens, often attached to monasteries, contained plants that possibly had medicinal benefits."}, "cross_references": [{"found_name": "Nature", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 20, "target_cluster_name": "Nature", "source_book": "llm_generated", "evidence_snippet": "Botany is the scientific study of plants, a major part of nature.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Botany is the scientific study of plants, a major part of nature.", "is_reverse": true}, {"found_name": "Fossils", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1152, "target_cluster_name": "fossils", "source_book": "llm_generated", "evidence_snippet": "Paleobotany, a branch of botany, studies fossilized plants.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Paleobotany, a branch of botany, studies fossilized plants."}, {"found_name": "Genus", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 263, "target_cluster_name": "genus", "source_book": "llm_generated", "evidence_snippet": "Genus is a fundamental taxonomic rank within the classification system used in botany.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Genus is a fundamental taxonomic rank within the classification system used in botany."}, {"found_name": "Geography", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1068, "target_cluster_name": "Geography", "source_book": "llm_generated", "evidence_snippet": "Botany, particularly plant geography, is a subfield that intersects with geography.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Botany, particularly plant geography, is a subfield that intersects with geography."}, {"found_name": "Geology", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 278, "target_cluster_name": "Geology", "source_book": "llm_generated", "evidence_snippet": "Geology can inform paleobotany through the study of fossil-bearing strata.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Geology can inform paleobotany through the study of fossil-bearing strata."}, {"found_name": "species", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 32, "target_cluster_name": "species", "source_book": "llm_generated", "evidence_snippet": "Botany is the scientific study of plants, and 'species' is the fundamental unit of classification within botany.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Botany is the scientific study of plants, and 'species' is the fundamental unit of classification within botany.", "is_reverse": true}, {"found_name": "empirical", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2995, "target_cluster_name": "empirical", "source_book": "llm_generated", "evidence_snippet": "Botany is a specific branch of science.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Botany is a specific branch of science.", "is_reverse": true}, {"found_name": "organic being", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 807, "target_cluster_name": "organic being", "source_book": "llm_generated", "evidence_snippet": "Botany is the scientific study of plants, which are a type of organism.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Botany is the scientific study of plants, which are a type of organism.", "is_reverse": true}, {"found_name": "agriculture", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 403, "target_cluster_name": "agriculture", "source_book