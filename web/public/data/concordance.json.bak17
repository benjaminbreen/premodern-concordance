, "book_id": "ricettario_fiorentino_1597", "name": "Rementina", "category": "PLANT", "subcategory": "RESIN", "count": 1, "variants": ["Rementina"], "contexts": ["resin used in preparation"]}, {"entity_id": "resins", "book_id": "connexion_physical_sciences_somerville_1858", "name": "resins", "category": "PLANT", "subcategory": "RESIN", "count": 1, "variants": ["resins"], "contexts": ["plant exudates with optical properties"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "resin", "target_book": "ricettario_fiorentino_1597", "target_name": "Rementina", "similarity": 0.882}, {"source_book": "kosmos_humboldt_1845", "source_name": "resin", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "resins", "similarity": 0.944}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Rementina", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "resins", "similarity": 0.889}], "id": 1481, "stable_key": "clu_9fa611b2cc4f513a", "ground_truth": {"modern_name": "Resin", "confidence": "high", "type": "plant", "note": "The term 'Rementina' seems to be a specific historical name for a resinous substance, possibly a particular type of resin used in Florentine pharmacopoeia.", "wikidata_id": "Q145205", "wikidata_description": "solid or highly viscous substance, of plant or synthetic origin, which can be polymerized into a solid", "wikipedia_url": "https://en.wikipedia.org/wiki/Resin", "wikipedia_extract": "A resin is a solid or highly viscous liquid that can be converted into a polymer. Resins may be biological or synthetic in origin, but are typically harvested from plants. Resins are mixtures of organic compounds insoluble in water, predominantly terpenes. Technically, resins should not be confused with gums, which consist predominantly of water-soluble polysaccharides, although these two terms are often interchangeable in the less formal context. Common resins include pine oleoresins, amber, hashish, frankincense, myrrh and the animal-derived resin, shellac. Resins are used in varnishes, adhesives, food additives, incenses and perfumes."}, "cross_references": [{"found_name": "Sangue di drago", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1168, "target_cluster_name": "Sangue di drago", "source_book": "llm_generated", "evidence_snippet": "Dragon's blood is explicitly described as a resin.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Dragon's blood is explicitly described as a resin.", "is_reverse": true}, {"found_name": "Gomma", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2355, "target_cluster_name": "Gomma", "source_book": "llm_generated", "evidence_snippet": "The description of 'Plant gums (historical name: Gomma)' aligns directly with the definition of 'Resin' as a substance harvested from plants, often a solid or viscous liquid composed of organic compounds.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: The description of 'Plant gums (historical name: Gomma)' aligns directly with the definition of 'Resin' as a substance harvested from plants, often a solid or viscous liquid composed of organic compounds.", "is_reverse": true}, {"found_name": "incenso", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 653, "target_cluster_name": "incenso", "source_book": "llm_generated", "evidence_snippet": "'Resin' is the English term for the substance harvested from trees like Boswellia sacra, from which frankincense is derived. The provided entity description also mentions 'resinous dried sap'.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "reverse: 'Resin' is the English term for the substance harvested from trees like Boswellia sacra, from which frankincense is derived. The provided entity description also mentions 'resinous dried sap'.", "is_reverse": true}, {"found_name": "Mirra", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 743, "target_cluster_name": "Mirra", "source_book": "llm_generated", "evidence_snippet": "Myrrh is a specific type of resin, making 'Resin' a broader category that encompasses it.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Myrrh is a specific type of resin, making 'Resin' a broader category that encompasses it.", "is_reverse": true}, {"found_name": "cedro", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2508, "target_cluster_name": "cedro", "source_book": "llm_generated", "evidence_snippet": "Cedar trees produce resin.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Cedar trees produce resin.", "is_reverse": true}]}, {"canonical_name": "inorganic substances", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "inorganic_substances", "book_id": "kosmos_humboldt_1845", "name": "inorganic substances", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["inorganic substances"], "contexts": ["non-living substances"]}, {"entity_id": "amorphous_substances", "book_id": "connexion_physical_sciences_somerville_1858", "name": "amorphous substances", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["amorphous substances"], "contexts": ["substances lacking crystalline structure"]}, {"entity_id": "inorganic_compounds", "book_id": "first_principles_spencer_1862", "name": "inorganic compounds", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["inorganic compounds"], "contexts": ["chemical compounds without carbon-hydrogen bonds"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "inorganic substances", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "amorphous substances", "similarity": 0.937}, {"source_book": "kosmos_humboldt_1845", "source_name": "inorganic substances", "target_book": "first_principles_spencer_1862", "target_name": "inorganic compounds", "similarity": 0.98}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "amorphous substances", "target_book": "first_principles_spencer_1862", "target_name": "inorganic compounds", "similarity": 0.922}], "id": 1482, "stable_key": "clu_26f3f8ac009888b6", "ground_truth": {"modern_name": "Inorganic compounds", "confidence": "high", "type": "chemical", "note": "'Amorphous substances' are a subset of inorganic or organic substances that lack a regular, ordered internal structure. However, in the context of contrasting with living substances or focusing on fundamental chemical constituents, 'inorganic compounds' is a fitting overarching term.", "wikidata_id": "Q190065", "wikidata_description": "compound that is not organic: i.e. does not contain carbon with exceptions e.g. CO, carbon dioxide, disulfide and diselenide, carbides, HCN, carbonic acid, cyanic, isocyanic and fulminic acids and carbonates, hydrogen carbonates, cyanides, cyanates", "wikipedia_url": "https://en.wikipedia.org/wiki/Inorganic%20compound", "wikipedia_extract": "An inorganic compound is typically a chemical compound that lacks carbon–hydrogen bonds⁠‍—‍that is, a compound that is not an organic compound. The study of inorganic compounds is a subfield of chemistry known as inorganic chemistry. Inorganic compounds comprise most of the Earth's crust, although the compositions of the deep mantle remain active areas of investigation. All allotropes of carbon and some simple carbon compounds are often considered inorganic. Examples include the allotropes of carbon (graphite, diamond, buckminsterfullerene, graphene, etc.), carbon monoxide CO, carbon dioxide CO2, carbides, and salts of inorganic anions such as carbonates, cyanides, cyanates, thiocyanates, isothiocyanates, etc. Many of these are normal parts of mostly organic systems, including organisms; describing a chemical as inorganic does not necessarily mean that it cannot occur within living things."}, "cross_references": [{"found_name": "Elements", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 794, "target_cluster_name": "elements", "source_book": "llm_generated", "evidence_snippet": "Many inorganic compounds are formed from chemical elements.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Many inorganic compounds are formed from chemical elements."}, {"found_name": "Minerals", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 138, "target_cluster_name": "minerals", "source_book": "llm_generated", "evidence_snippet": "Inorganic compounds are the fundamental building blocks of minerals.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Inorganic compounds are the fundamental building blocks of minerals."}, {"found_name": "Matter", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 249, "target_cluster_name": "Matter", "source_book": "llm_generated", "evidence_snippet": "Inorganic compounds are a form of matter.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Inorganic compounds are a form of matter."}, {"found_name": "Gases", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 725, "target_cluster_name": "gases", "source_book": "llm_generated", "evidence_snippet": "Many inorganic compounds exist in a gaseous state (e.g., ammonia, carbon dioxide).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Many inorganic compounds exist in a gaseous state (e.g., ammonia, carbon dioxide)."}, {"found_name": "Fluids", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 393, "target_cluster_name": "fluids", "source_book": "llm_generated", "evidence_snippet": "Many inorganic compounds exist in a liquid state (e.g., water, acids).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Many inorganic compounds exist in a liquid state (e.g., water, acids)."}]}, {"canonical_name": "Piloto", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "piloto", "book_id": "historia_medicinal_monardes_1574", "name": "Piloto", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Piloto"], "contexts": ["profession of a sick person"]}, {"entity_id": "pilotos", "book_id": "coloquios_da_orta_1563", "name": "pilotos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["pilotos"], "contexts": ["Pilots appointed by sovereigns"]}, {"entity_id": "piloto", "book_id": "polyanthea_medicinal", "name": "Piloto", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Piloto"], "contexts": ["pilot who uses a helm"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Piloto", "target_book": "coloquios_da_orta_1563", "target_name": "pilotos", "similarity": 0.907}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Piloto", "target_book": "polyanthea_medicinal", "target_name": "Piloto", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "pilotos", "target_book": "polyanthea_medicinal", "target_name": "Piloto", "similarity": 0.907}], "id": 1483, "stable_key": "clu_375c4d6508d27a65", "ground_truth": {"modern_name": "pilot", "confidence": "high", "type": "person", "description": "A person who navigates a ship or aircraft.", "note": "The term 'Piloto' refers to a profession. While some individuals might be named Piloto, the context suggests the occupation.", "wikidata_id": "Q2095549", "wikidata_description": "person controlling an aircraft in flight", "wikipedia_extract": "Jonathan Nolan (born 6 June 1976) is a British and American screenwriter and producer. He is the creator of the CBS science fiction series Person of Interest (2011–2016) and co-creator of the HBO science fiction/Western series Westworld (2016–2022). Nolan has collaborated on several films with his brother, film director Christopher Nolan, who adapted Jonathan's short story \"Memento Mori\" into the neo-noir thriller film Memento (2000). Together, the brothers co-wrote the mystery-thriller film The Prestige (2006), the superhero films The Dark Knight (2008) and The Dark Knight Rises (2012), and the science-fiction film Interstellar (2014). In 2024, he executive produced and directed the first three episodes of the television series adaptation of Fallout. Nolan was nominated for the Academy Award for Best Original Screenplay for Memento, and for the Primetime Emmy Award for Outstanding Writing for a Drama Series and Outstanding Directing for a Drama Series for Westworld.", "wikipedia_url": "https://en.wikipedia.org/wiki/Jonathan_Nolan"}, "cross_references": []}, {"canonical_name": "agua caliente", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "agua_caliente", "book_id": "historia_medicinal_monardes_1574", "name": "agua caliente", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["agua caliente"], "contexts": ["hot water for treatment"]}, {"entity_id": "acqua_calda", "book_id": "ricettario_fiorentino_1597", "name": "acqua calda", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["acqua calda"], "contexts": ["hot water used for washing"]}, {"entity_id": "hot_water", "book_id": "connexion_physical_sciences_somerville_1858", "name": "hot water", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["hot water"], "contexts": ["source of calorific rays"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "agua caliente", "target_book": "ricettario_fiorentino_1597", "t