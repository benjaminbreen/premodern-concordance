 {"canonical_name": "Nueva España", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 4, "total_mentions": 66, "members": [{"entity_id": "nouvelle-espagne", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Nouvelle-Espagne", "category": "PLACE", "subcategory": "REGION", "count": 28, "variants": ["Nouvelle-Espagne", "Nouvelle -Espagne", "Nouvelle-Barcelone", "Nouvelle-Catalogne", "Nouvelle-Espagiie"], "contexts": ["New Spain", "territory of political essay"]}, {"entity_id": "nouvelle_espagne", "book_id": "kosmos_humboldt_1845", "name": "Nouvelle Espagne", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Nouvelle Espagne"], "contexts": ["former name for Mexico", "historical region, modern Mexico"]}, {"entity_id": "nueva_españa", "book_id": "historia_medicinal_monardes_1574", "name": "Nueva España", "category": "PLACE", "subcategory": "COUNTRY", "count": 30, "variants": ["Nueva España", "Nucua Efpaña", "Nucua Eſpaña", "Nuecua España", "Nuena Eſpa", "Nueua Efpaña", "Nueua Elpaña", "Nueua España", "Nueua Eſpaña", "Nueva Efpaña", "Nueva Eſpaña", "nueua Elpaña", "nueua Eſpaña"], "contexts": ["region in the Americas", "New Spain, colonial Mexico"]}, {"entity_id": "nova_espanha", "book_id": "coloquios_da_orta_1563", "name": "Nova Espanha", "category": "PLACE", "subcategory": "COUNTRY", "count": 6, "variants": ["Nova Espanha", "Nova Hespanha"], "contexts": ["place where figs are found", "place where authors wrote"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Nouvelle-Espagne", "target_book": "kosmos_humboldt_1845", "target_name": "Nouvelle Espagne", "similarity": 0.863}, {"source_book": "kosmos_humboldt_1845", "source_name": "Nouvelle Espagne", "target_book": "historia_medicinal_monardes_1574", "target_name": "Nueva España", "similarity": 0.923}, {"source_book": "kosmos_humboldt_1845", "source_name": "Nouvelle Espagne", "target_book": "coloquios_da_orta_1563", "target_name": "Nova Espanha", "similarity": 0.941}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Nueva España", "target_book": "coloquios_da_orta_1563", "target_name": "Nova Espanha", "similarity": 0.963}], "id": 230, "stable_key": "clu_d369ea42424667f8", "ground_truth": {"modern_name": "Mexico", "confidence": "high", "type": "place", "country": "Mexico", "wikidata_id": "Q170603", "wikidata_description": "viceroyalty of the Spanish Empire (1535-1821)", "wikipedia_url": "https://en.wikipedia.org/wiki/New%20Spain", "wikipedia_extract": "New Spain, officially the Viceroyalty of New Spain (Spanish: Virreinato de Nueva España [birejˈnato ðe ˈnweβa esˈpaɲa]; Nahuatl: Yankwik Kaxtillan Birreiyotl), originally the Kingdom of New Spain, was an integral territorial entity of the Spanish Empire, established by Habsburg Spain. It was one of several domains established during the Spanish conquest of the Americas, and had its capital in Mexico City. Its jurisdiction comprised a large area of the southern and western portions of North America, mainly what became Mexico and the Southwestern United States, but also California, Florida and Louisiana; Central America (as part of Mexico); the Caribbean like Hispaniola and Martinique, and northern parts of South America, even Colombia; several Pacific archipelagos, including the Philippines and Guam. Additional Asian colonies included \"Spanish Formosa\", on the island of Taiwan. After the 1521 Spanish conquest of the Aztec Empire, conqueror Hernán Cortés named the territory New Spain, and established the new capital, Mexico City, on the site of Tenochtitlan, the capital of the Aztec Empire. Central Mexico became the base of expeditions of exploration and conquest, expanding the territory claimed by the Spanish Empire."}, "cross_references": [{"found_name": "Americas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1, "target_cluster_name": "America", "source_book": "llm_generated", "evidence_snippet": "Mexico is a part of the Americas.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Mexico is a part of the Americas."}, {"found_name": "Gulf of Mexico", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 577, "target_cluster_name": "Golfe du Mexique", "source_book": "llm_generated", "evidence_snippet": "The Gulf of Mexico borders Mexico and is a significant geographical feature associated with it.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Gulf of Mexico borders Mexico and is a significant geographical feature associated with it."}, {"found_name": "Equatorial America", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1437, "target_cluster_name": "equatorial America", "source_book": "llm_generated", "evidence_snippet": "Mexico is located within the broader region of Equatorial America.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Mexico is located within the broader region of Equatorial America."}]}, {"canonical_name": "Asie", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 6, "total_mentions": 87, "members": [{"entity_id": "asia", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Asia", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Asia"], "contexts": ["continent influencing compass variation", "continent in Eurasia"]}, {"entity_id": "asie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Asie", "category": "PLACE", "subcategory": "COUNTRY", "count": 32, "variants": ["Asie"], "contexts": ["continent mentioned for customs", "region with mountains"]}, {"entity_id": "asia", "book_id": "kosmos_humboldt_1845", "name": "Asia", "category": "PLACE", "subcategory": "COUNTRY", "count": 24, "variants": ["Asia"], "contexts": ["direction of Asia", "western peninsula of Europe"]}, {"entity_id": "asia", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Asia", "categ