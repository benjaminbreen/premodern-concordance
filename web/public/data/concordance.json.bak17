", "target_name": "tongue", "similarity": 0.996}, {"source_book": "english_physician_1652", "source_name": "Tongue", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "tongue", "similarity": 0.996}, {"source_book": "english_physician_1652", "source_name": "Tongue", "target_book": "first_principles_spencer_1862", "target_name": "tongue", "similarity": 0.996}, {"source_book": "origin_of_species_darwin_1859", "source_name": "tongue", "target_book": "principles_of_psychology_james_1890", "target_name": "tongue", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "tongue", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "tongue", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "tongue", "target_book": "first_principles_spencer_1862", "target_name": "tongue", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "tongue", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "tongue", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "tongue", "target_book": "first_principles_spencer_1862", "target_name": "tongue", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "tongue", "target_book": "first_principles_spencer_1862", "target_name": "tongue", "similarity": 1.0}], "id": 135, "stable_key": "clu_f9219f2d1f5d8ff6", "ground_truth": {"modern_name": "Tongue", "confidence": "high", "type": "substance", "description": "An organ of the mouth involved in tasting and speech.", "wikipedia_extract": "The tongue is a muscular organ in the mouth of a typical tetrapod. It manipulates food for chewing and swallowing as part of the digestive process, and is the primary organ of taste. The tongue's upper surface (dorsum) is covered by taste buds housed in numerous lingual papillae. It is sensitive and kept moist by saliva and is richly supplied with nerves and blood vessels. The tongue also serves as a natural means of cleaning the teeth. A major function of the tongue is to enable speech in humans and vocalization in other animals."}, "cross_references": [{"found_name": "Mouth", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 237, "target_cluster_name": "Mouth", "source_book": "llm_generated", "evidence_snippet": "The tongue is located within the mouth and is integral to its function.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The tongue is located within the mouth and is integral to its function."}]}, {"canonical_name": "Ouvidos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 5, "total_mentions": 18, "members": [{"entity_id": "hearing", "book_id": "english_physician_1652", "name": "Hearing", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["Hearing"], "contexts": ["sense of hearing", "sense helped by juice"]}, {"entity_id": "auditory_organs", "book_id": "origin_of_species_darwin_1859", "name": "auditory organs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["auditory organs"], "contexts": ["organs of hearing"]}, {"entity_id": "auditory_apparatus", "book_id": "origin_of_species_darwin_1859", "name": "auditory apparatus", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["auditory apparatus"], "contexts": ["structures involved in hearing"]}, {"entity_id": "auditory", "book_id": "principles_of_psychology_james_1890", "name": "auditory", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["auditory"], "contexts": ["related to hearing", "relating to the sense of hearing"]}, {"entity_id": "ouvidos", "book_id": "polyanthea_medicinal", "name": "Ouvidos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 8, "variants": ["Ouvidos", "ouvidos"], "contexts": ["ears, affected by nerve damage", "ears"]