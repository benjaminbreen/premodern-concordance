 Thames (locally known as the Isis) and Cherwell. It had a population of 166,034 in 2024."}, "cross_references": [{"found_name": "Cambridge", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 352, "target_cluster_name": "Cambridge", "source_book": "llm_generated", "evidence_snippet": "Cambridge is a city in England, like Oxford, and is also home to a major university, historically a rival to Oxford.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Cambridge is a city in England, like Oxford, and is also home to a major university, historically a rival to Oxford."}]}, {"canonical_name": "Knees", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 10, "members": [{"entity_id": "knees", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "knees", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["knees"], "contexts": ["joint in the leg", "joint between thigh and lower leg"]}, {"entity_id": "knee", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Knee", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Knee"], "contexts": ["joint between thigh and lower leg"]}, {"entity_id": "knees", "book_id": "english_physician_1652", "name": "Knees", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["Knees"], "contexts": ["body part affected by gout", "joints affected by gout, treated by bathing"]}, {"entity_id": "knee", "book_id": "principles_of_psychology_james_1890", "name": "knee", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["knee"], "contexts": ["joint between thigh and lower leg"]}, {"entity_id": "joelhos", "book_id": "polyanthea_medicinal", "name": "joelhos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["joelhos"], "contexts": ["knees", "body parts"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "knees", "