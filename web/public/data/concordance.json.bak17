": ["instrument for magnetic measurements"]}, {"entity_id": "magnetic_needle", "book_id": "connexion_physical_sciences_somerville_1858", "name": "magnetic needle", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 3, "variants": ["magnetic needle"], "contexts": ["device indicating magnetic north", "instrument deflected by magnetic force"]}, {"entity_id": "magnetized_needle", "book_id": "connexion_physical_sciences_somerville_1858", "name": "magnetized needle", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["magnetized needle"], "contexts": ["device used to detect magnetic fields", "influenced by voltaic science"]}, {"entity_id": "magnetic_needle", "book_id": "first_principles_spencer_1862", "name": "magnetic needle", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["magnetic needle"], "contexts": ["component of a compass"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "magnetic needle", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic needle", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic needle", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetized needle", "similarity": 0.964}, {"source_book": "kosmos_humboldt_1845", "source_name": "magnetic needle", "target_book": "first_principles_spencer_1862", "target_name": "magnetic needle", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "vertical needle", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic needle", "similarity": 0.886}, {"source_book": "kosmos_humboldt_1845", "source_name": "vertical needle", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetized needle", "similarity": 0.882}, {"source_book": "kosmos_humboldt_1845", "source_name": "vertical needle", "target_book": "first_principles_spencer_1862", "target_name": "magnetic needle", "similarity": 0.886}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "magnetic needle", "target_book": "first_principles_spencer_1862", "target_name": "magnetic needle", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "magnetized needle", "target_book": "first_principles_spencer_1862", "target_name": "magnetic needle", "similarity": 0.964}], "id": 740, "stable_key": "clu_18900157796a06b8", "ground_truth": {"modern_name": "magnetic needle", "confidence": "high", "type": "object", "wikidata_id": "Q129950755", "wikidata_description": "scholarly article published in April 2024", "wikipedia_extract": "Magnetic declination (also called magnetic variation) is the angle between magnetic north and true north at a particular location on the Earth's surface. The angle can change over time due to polar wandering. Magnetic north is the direction that the north end of a magnetized compass needle points, which corresponds to the direction of the Earth's magnetic field lines. True north is the direction along a meridian towards the geographic North Pole. Somewhat more formally, Bowditch defines variation as \"the angle between the magnetic and geographic meridians at any place, expressed in degrees and minutes east or west to indicate the direction of magnetic north from true north. The angle between magnetic and grid meridians is called grid magnetic angle, grid variation, or grivation.\" By convention, declination is positive when magnetic north is east of true north, and negative when it is to the west.", "wikipedia_url": "https://en.wikipedia.org/wiki/Magnetic_declination"}, "cross_references": [{"found_name": "compass", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 428, "target_cluster_name": "compass", "source_book": "llm_generated", "evidence_snippet": "The primary component of a magnetic compass that aligns with the Earth's magnetic field.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The primary component of a magnetic compass that aligns with the Earth's magnetic field.", "is_reverse": true}, {"found_name": "Needle", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 732, "target_cluster_name": "Needle", "source_book": "llm_generated", "evidence_snippet": "A magnetic needle is a type of needle used in compasses to indicate direction.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: A magnetic needle is a type of needle used in compasses to indicate direction.", "is_reverse": true}, {"found_name": "Mariner's compass", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3157, "target_cluster_name": "Mariner’s compass", "source_book": "llm_generated", "evidence_snippet": "A mariner's compass uses a magnetic needle to indicate direction.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "A mariner's compass uses a magnetic needle to indicate direction."}]}, {"canonical_name": "steam", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 7, "total_mentions": 36, "members": [{"entity_id": "steam", "book_id": "kosmos_humboldt_1845", "name": "steam", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["steam"], "contexts": ["ejected from subterranean forces", "water vapor from volcanic activity"]}, {"entity_id": "steam", "book_id": "connexion_physical_sciences_somerville_1858", "name": "steam", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 11, "variants": ["steam", "Steam"], "contexts": ["gaseous state of water", "prevented from expanding by pressure"]}, {"entity_id": "steam", "book_id": "first_principles_spencer_1862", "name": "steam", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["steam"], "contexts": ["gaseous state of water", "gaseous water"]}, {"entity_id": "vapor", "book_id": "principles_of_psychology_james_1890", "name": "vapor", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["vapor"], "contexts": ["gaseous state of matter"]}, {"entity_id": "aqueous_vapor", "book_id": "kosmos_humboldt_1845", "name": "aqueous vapor", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 6, "variants": ["aqueous vapor"], "contexts": ["condensed by terrestrial magnetism", "volcanic emission"]}, {"entity_id": "vapor", "book_id": "kosmos_humboldt_1845", "name": "vapor", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["vapor"], "contexts": ["gaseous water in atmosphere", "gaseous state of matter in space"]}, {"entity_id": "vapor", "book_id": "historia_medicinal_monardes_1574", "name": "vapor", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["vapor", "vapores"], "contexts": ["Aristotle's theory of metal origin", "vapors"]}, {"entity_id": "vaporem", "book_id": "polyanthea_medicinal", "name": "vaporem", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["vaporem"], "contexts": ["vapor"]}, {"entity_id": "aqueous_vapors", "book_id": "kosmos_humboldt_1845", "name": "aqueous vapors", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["aqueous vapors"], "contexts": ["water in gaseous form"]}, {"entity_id": "vapori_dell_acqua", "book_id": "ricettario_fiorentino_1597", "name": "vapori dell acqua", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["vapori dell acqua", "vapo", "vapori"], "contexts": ["used for indirect heating of medicines", "vapors for heating"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "steam", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "steam", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "steam", "target_book": "first_principles_spencer_1862", "target_name": "steam", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "steam", "target_book": "first_principles_spencer_1862", "target_name": "steam", "similarity": 1.0}], "id": 741, "stable_key": "clu_56baf5e1afc55175", "ground_truth": {"modern_name": "Steam", "confidence": "high", "type": "chemical", "wikidata_id": "Q190120", "wikidata_description": "gaseous phase of water; unlike other forms of water, water vapor is invisible", "wikipedia_url": "https://en.wikipedia.org/wiki/Water%20vapor", "wikipedia_extract": "Water vapor, water vapour, or aqueous vapor is the gaseous phase of water. It is one state of water within the hydrosphere. Water vapor can be produced from the evaporation or boiling of liquid water or from the sublimation of ice. Water vapor is transparent, like most constituents of the atmosphere. Under typical atmospheric conditions, water vapor is continuously generated by evaporation and removed by condensation. It is less dense than most of the other constituents of air and triggers convection currents that can lead to clouds and fog."}, "member_count": 10, "cross_references": [{"found_name": "Air", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 109, "target_cluster_name": "air", "source_book": "llm_generated", "evidence_snippet": "Steam is a gaseous form of water, and air is the gaseous mixture that makes up the atmosphere. Both are considered 'elastic fluids' in historical texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Steam is a gaseous form of water, and air is the gaseous mixture that makes up the atmosphere. Both are considered 'elastic fluids' in historical texts."}, {"found_name": "Atmosphere", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 213, "target_cluster_name": "atmosphere", "source_book": "llm_generated", "evidence_snippet": "Steam is a component of the atmosphere, specifically water vapor.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Steam is a component of the atmosphere, specifically water vapor."}, {"found_name": "Gaseous substances", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2321, "target_cluster_name": "gaseous", "source_book": "llm_generated", "evidence_snippet": "Steam is a specific type of gaseous substance (water vapor).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Steam is a specific type of gaseous substance (water vapor)."}, {"found_name": "Fluids", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 393, "target_cluster_name": "fluids", "source_book": "llm_generated", "evidence_snippet": "Steam, as water vapor, is considered a fluid in historical scientific contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Steam, as water vapor, is considered a fluid in historical scientific contexts."}, {"found_name": "Heat", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 530, "target_cluster_name": "heat", "source_book": "llm_generated", "evidence_snippet": "Steam is often produced by the application of heat to water, and its properties are closely linked to heat.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Steam is often produced by the application of heat to water, and its properties are closely linked to heat."}, {"found_name": "planetary nebulous", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "kosmos_humboldt_1845", "evidence_snippet": "when we compare the nebulous stars with unresolvable nebulae, for instance, with the nebula in Andromeda, or even with the so-called planetary nebulous vapor, a fact is made manifest to us by the cons", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of nebula"}]}, {"canonical_name": "boticas", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 19, "members": [{"entity_id": "boticas", "book_id": "historia_medicinal_monardes_1574", "name": "Boticas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Boticas", "botica"], "contexts": ["places where medicines are compounded", "apothecary's shop"]}, {"entity_id": "boticas", "book_id": "coloquios_da_orta_1563", "name": "boticas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["boticas", "botyca"], "contexts": ["apothecaries' shops", "place where turbith is sold"]}, {"entity_id": "boticas", "book_id": "polyanthea_medicinal", "name": "boticas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 13, "variants": ["boticas", "botica"], "contexts": ["Pharmacies where medicines are sold", "pharmacies containing antidotes"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Boticas", "target_book": "coloquios_da_orta_1563", "target_name": "boticas", "similarity": 0.985}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Boticas", "target_book": "polyanthea_medicinal", "target_name": "boticas", "similarity": 0.985}, {"source_book": "coloquios_da_orta_1563", "source_name": "boticas", "target_book": "polyanthea_medicinal", "target_name": "boticas", "similarity": 1.0}], "id": 742, "stable_key": "clu_42e4406e36d16aef", "ground_truth": {"modern_name": "Pharmacy", "confidence": "high", "type": "place", "description": "Establishment where medicines are prepared and sold.", "note": "'boticas' translates to pharmacies or apothecaries' shops.", "wikipedia_extract": "Pharmacy is the science and practice of discovering, producing, preparing, dispensing, reviewing and monitoring medications, aiming to ensure the safe, effective, and affordable use of medicines. It is a miscellaneous science as it links health sciences with pharmaceutical sciences and natural sciences. The professional practice is becoming more clinically oriented as most of the drugs are now manufactured by pharmaceutical industries. Based on the setting, pharmacy practice is either classified as community or institutional pharmacy. Providing direct patient care in the community of institutional pharmacies is considered clinical pharmacy. The scope of pharmacy practice includes more traditional roles such as compounding and dispensing of medications."}, "cross_references": []}, {"canonical_name": "Mirra", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 19, "members": [{"entity_id": "mirra", "book_id": "coloquios_da_orta_1563", "name": "Mirra", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 17, "variants": ["Mirra", "mirra"], "contexts": ["plant product used in medicine", "used in embalming with aloes"]}, {"entity_id": "mirra", "book_id": "ricettario_fiorentino_1597", "name": "Mirra", "category": "PLANT", "subcategory": "RESIN", "count": 1, "variants": ["Mirra"], "contexts": ["myrrh resin used in preparations"]}, {"entity_id": "mirra", "book_id": "polyanthea_medicinal", "name": "mirra", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["mirra"], "contexts": ["ingredient in plaster"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Mirra", "target_book": "ricettario_fiorentino_1597", "target_name": "Mirra", "similarity": 0.653}, {"source_book": "coloquios_da_orta_1563", "source_name": "Mirra", "target_book": "polyanthea_medicinal", "target_name": "mirra", "similarity": 0.939}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Mirra", "target_book": "polyanthea_medicinal", "target_name": "mirra", "similarity": 0.612}], "id": 743, "stable_key": "clu_838c4643d3ebbb61", "ground_truth": {"modern_name": "myrrh", "confidence": "high", "type": "plant", "description": "A fragrant resinous substance from certain trees, used medicinally.", "note": "Refers to the plant product, not the tree itself.", "wikipedia_extract": "Myrrh (; from an unidentified ancient Semitic language, مر; from Arabic, מוֹר /mor/; from Hebrew, see § Etymology) is a gum-resin extracted from a few small, thorny tree species of the Commiphora genus, belonging to the Burseraceae family. Myrrh resin was traded in the ancient world, and has been used throughout history in medicine, in ritual, and to make perfume and incense. Its use is mentioned in the Hebrew Bible, the New Testament and in Islamic texts, as well as by ancient historians. It is still used by certain Christian denominations for ritual purposes. When a cut on a tree penetrates through the bark and into the sapwood, the tree secretes a resin. Myrrh gum, like frankincense, is such a resin."}, "cross_references": [{"found_name": "Resin", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1481, "target_cluster_name": "resin", "source_book": "llm_generated", "evidence_snippet": "Myrrh is a specific type of resin, making 'Resin' a broader category that encompasses it.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Myrrh is a specific type of resin, making 'Resin' a broader category that encompasses it."}]}, {"canonical_name": "Authors", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 18, "members": [{"entity_id": "authors", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Authors", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 4, "variants": ["Authors"], "contexts": ["General term for writers", "ancient and modern sources"]}, {"entity_id": "authors", "book_id": "english_physician_1652", "name": "Authors", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 11, "variants": ["Authors", "Author"], "contexts": ["referred to as source of information", "writers on the subject"]}, {"entity_id": "authors", "book_id": "origin_of_species_darwin_1859", "name": "authors", "ca