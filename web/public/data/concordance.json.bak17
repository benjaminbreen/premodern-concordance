"category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["esparegos"], "contexts": ["herb from terra firme"]}, {"entity_id": "espargos", "book_id": "polyanthea_medicinal", "name": "espargos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["espargos", "esparagos", "esparrago"], "contexts": ["asparagus, root used in preparation", "food with deobstructing properties"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "esparegos", "target_book": "polyanthea_medicinal", "target_name": "espargos", "similarity": 0.893}], "id": 2245, "stable_key": "clu_e95dbad60ce0c8bf", "ground_truth": {"modern_name": "Asparagus", "confidence": "high", "type": "PLANT", "linnaean": "Asparagus officinalis", "family": "Asparagaceae", "description": "A plant whose roots and shoots are used as food and medicine.", "wikipedia_extract": "Asparagus (Asparagus officinalis) or garden asparagus is a perennial flowering plant species in the genus Asparagus native to Eurasia. Widely cultivated as a vegetable crop, its young shoots are used as a spring vegetable. Asparagus is an herbaceous, perennial plant growing typically to 100–150 centimetres (3–5 feet) tall, with stout stems with much-branched, feathery foliage. It has been known to grow as long as 3.5 metres (11 ft). The 'leaves' are needle-like cladodes (modified stems) in the axils of scale leaves; they are 6–32 millimetres (1⁄4–1+1⁄4 inches) long and 1 mm (1⁄32 in) broad, and clustered in fours, up to 15, together, in a rose-like shape. The root system, often referred to as a 'crown', is adventitious; the root type is fasciculated."}, "cross_references": [{"found_name": "prezzemolo di Bryfci", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "co^ SCIROPPO ACETOe fo di cinqutradtpi S^TJ Ad.dMpp.-^ JtV. paluftre oi Iri nocchio di Petrofellino \\ an.^.ii, cioè prezzemolo di Bryfci di Sparagi ^ Acqua di fontt^^^^^^'^ hb vi. ' ICaxTCJ^ canto^ ch", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "an ingredient, likely a synonym or variation of parsley"}, {"found_name": "prezzemolo di Sparagi", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": null, "target_cluster_name": null, "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "Orzo non fcorticatoj Alchechegni Logorizia Capeluenerc Cetracca Adianto nen^ Poht^ice Cufcuta Radici di fuìoc. d'Appio cioè prezzemolo di Sparagi an»mju ^an.oncit. - 1^ Caód DEL RICETTARIO. 'si Cùod i", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "an ingredient, possibly a vernacular name or a specific variety of parsley"}]}, {"canonical_name": "grama", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "grama", "book_id": "coloquios_da_orta_1563", "name": "grama", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["grama"], "contexts": ["plant for comparison of growth habit"]}, {"entity_id": "grama", "book_id": "polyanthea_medicinal", "name": "grama", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["grama"], "contexts": ["herb used in remedy", "couch grass, root used in preparation"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "grama", "target_book": "polyanthea_medicinal", "target_name": "grama", "similarity": 1.0}], "id": 2246, "stable_key": "clu_c7c6d74c1727590d", "ground_truth": {"modern_name": "Couch grass", "confidence": "high", "type": "plant", "linnaean": "Elymus repens", "family": "Poaceae"}, "cross_references": []}, {"canonical_name": "Actuarius", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "actuario", "book_id": "coloquios_da_orta_1563", "name": "Actuario", "category": "PERSON", "subcat