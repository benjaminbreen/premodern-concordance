ior"]}, {"entity_id": "human_habits", "book_id": "principles_of_psychology_james_1890", "name": "human habits", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["human habits"], "contexts": ["learned behavioral patterns"]}, {"entity_id": "habits_of_life", "book_id": "first_principles_spencer_1862", "name": "habits of life", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["habits of life"], "contexts": ["repeated behaviors"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "habits of life", "target_book": "principles_of_psychology_james_1890", "target_name": "human habits", "similarity": 0.892}, {"source_book": "origin_of_species_darwin_1859", "source_name": "habits of life", "target_book": "first_principles_spencer_1862", "target_name": "habits of life", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "human habits", "target_book": "first_principles_spencer_1862", "target_name": "habits of life", "similarity": 0.892}], "id": 1431, "stable_key": "clu_e50b3c8fe3eb41e2", "ground_truth": {"modern_name": "habits", "confidence": "high", "type": "concept"}, "cross_references": [{"found_name": "natural instincts", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2980, "target_cluster_name": "natural instincts", "source_book": "llm_generated", "evidence_snippet": "Habits can be seen as learned behaviors that may originate from or be closely associated with instinctual drives.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Habits can be seen as learned behaviors that may originate from or be closely associated with instinctual drives.", "is_reverse": true}, {"found_name": "practice", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1940, "target_cluster_name": "practice", "source_book": "llm_generated", "evidence_snippet": "Practices can become habits.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Practices can become habits.", "is_reverse": true}, {"found_name": "Personality", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1943, "target_cluster_name": "Personality", "source_book": "llm_generated", "evidence_snippet": "Habits are learned behaviors that contribute significantly to an individual's personality and are often discussed in relation to its development and expression.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Habits are learned behaviors that contribute significantly to an individual's personality and are often discussed in relation to its development and expression.", "is_reverse": true}, {"found_name": "instinctive", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2282, "target_cluster_name": "instinctive", "source_book": "llm_generated", "evidence_snippet": "Instincts can be seen as innate predispositions that may develop into learned habits.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Instincts can be seen as innate predispositions that may develop into learned habits.", "is_reverse": true}]}, {"canonical_name": "experimentalist", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "experimentalist", "book_id": "origin_of_species_darwin_1859", "name": "experimentalist", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["experimentalist"], "contexts": ["one who conducts experiments"]}, {"entity_id": "experimenters", "book_id": "principles_of_psychology_james_1890", "name": "experimenters", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["experimenters"], "contexts": ["individuals conducting experiments"]}, {"entity_id": "rational_experimentalist", "book_id": "kosmos_humboldt_1845", "name": "rational experimentalist", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["rational experimentalist"], "contexts": ["scientist guided by hypotheses"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "experimentalist", "target_book": "principles_of_psychology_james_1890", "target_name": "experimenters", "similarity": 0.901}, {"source_book": "origin_of_species_darwin_1859", "source_name": "experimentalist", "target_book": "kosmos_humboldt_1845", "target_name": "rational experimentalist", "similarity": 0.866}], "id": 1432, "stable_key": "clu_80bdaf1698a6b806", "ground_truth": {"wikipedia_extract": "Experimentalism is the philosophical belief that the way to truth is through experiments and empiricism. It is also associated with instrumentalism, the belief that truth should be evaluated based upon its demonstrated usefulness. Experimentalism is considered a theory of knowledge that emphasizes direct action and scientific control as well as methods and consequences. Experimentalism is referred to as John Dewey's version of pragmatism. The theory, which he also called as practicalism, holds that the pattern for knowledge should be modern science and modern scientific methods. Dewey explained that philosophy involves the critical evaluation of belief and that the concept's function is practical."}, "cross_references": []}, {"canonical_name": "sedimentary formations", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "sedimentary_formations", "book_id": "origin_of_species_darwin_1859", "name": "sedimentary formations", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["sedimentary formations"], "contexts": ["deposits formed from worn material"]}, {"entity_id": "sedimentary_formations", "book_id": "kosmos_humboldt_1845", "name": "sedimentary formations", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "va