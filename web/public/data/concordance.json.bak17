l work"]}, {"entity_id": "history", "book_id": "connexion_physical_sciences_somerville_1858", "name": "History", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["History"], "contexts": ["record of past events"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "History", "target_book": "kosmos_humboldt_1845", "target_name": "history", "similarity": 0.977}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "History", "target_book": "historia_medicinal_monardes_1574", "target_name": "Historia", "similarity": 0.924}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "History", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "History", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "history", "target_book": "historia_medicinal_monardes_1574", "target_name": "Historia", "similarity": 0.928}, {"source_book": "kosmos_humboldt_1845", "source_name": "history", "target_book": "polyanthea_medicinal", "target_name": "historia", "similarity": 0.905}, {"source_book": "kosmos_humboldt_1845", "source_name": "history", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "History", "similarity": 0.977}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Historia", "target_book": "polyanthea_medicinal", "target_name": "historia", "similarity": 0.956}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Historia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "History", "similarity": 0.924}], "id": 177, "stable_key": "clu_016f2c531e2c009a", "ground_truth": {"modern_name": "History", "confidence": "high", "type": "concept", "wikidata_id": "Q309", "wikidata_description": "past events and their tracks or records", "wikipedia_url": "https://en.wikipedia.org/wiki/History", "wikipedia_extract": "History is the systematic study of the past, focusing primarily on the human past. As an academic discipline, it analyses and interprets evidence to construct narratives about what happened and explain why it happened. Some theorists categorize history as a social science, while others see it as part of the humanities or consider it a hybrid discipline. Similar debates surround the purpose of history—for example, whether its main aim is theoretical, to uncover the truth, or practical, to learn lessons from the past. In a more general sense, the term history refers not to an academic field but to the past itself, times in the past, or to individual texts about the past. Historical research relies on primary and secondary sources to reconstruct past events and validate interpretations."}, "cross_references": [{"found_name": "Antiquity", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1054, "target_cluster_name": "Antiquity", "source_book": "llm_generated", "evidence_snippet": "Antiquity refers to a period of history, making it a temporal subset and thus related to the study of history.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Antiquity refers to a period of history, making it a temporal subset and thus related to the study of history."}, {"found_name": "Chronology", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2825, "target_cluster_name": "Chronology", "source_book": "llm_generated", "evidence_snippet": "Chronology is the science of arranging events in the order of their occurrence, a fundamental tool and component of historical study.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Chronology is the science of arranging events in the order of their occurrence, a fundamental tool and component of historical study."}, {"found_name": "Ethnology", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3617, "target_cluster_name": "Ethnology", "source_book": "llm_generated", "evidence_snippet": "Ethnology is the study of the characteristics of various peoples and the differences and relationships between them, often drawing heavily on historical context.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Ethnology is the study of the characteristics of various peoples and the differences and relationships between them, often drawing heavily on historical context."}, {"found_name": "Discoveries", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 505, "target_cluster_name": "discoveries", "source_book": "llm_generated", "evidence_snippet": "Discoveries are significant events that are often the subject of historical inquiry and narrative.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Discoveries are significant events that are often the subject of historical inquiry and narrative."}, {"found_name": "guerras", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 483, "target_cluster_name": "guerras", "source_book": "llm_generated", "evidence_snippet": "War is a significant and recurring subject within the study of history.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: War is a significant and recurring subject within the study of history.", "is_reverse": true}, {"found_name": "Etymologies", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1201, "target_cluster_name": "Etymologies", "source_book": "llm_generated", "evidence_snippet": "Etymology is a historical study of word origins and changes over time, making it intrinsically related to the broader concept of history.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Etymology is a historical study of word origins and changes over time, making it intrinsically related to the broader concept of history.", "is_reverse": true}, {"found_name": "traditions", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1300, "target_cluster_name": "traditions", "source_book": "llm_generated", "evidence_snippet": "Tradition is a fundamental component of historical study, representing the continuity of cultural practices and beliefs across time. Historical accounts often analyze and interpret traditions.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Tradition is a fundamental component of historical study, representing the continuity of cultural practices and beliefs across time. Historical accounts often analyze and interpret traditions.", "is_reverse": true}, {"found_name": "Natural history", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1755, "target_cluster_name": "Natural history", "source_book": "llm_generated", "evidence_snippet": "Natural history is a form of history, specifically the history of the natural world.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Natural history is a form of history, specifically the history of the natural world.", "is_reverse": true}]}, {"canonical_name": "rest", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 8, "members": [{"entity_id": "rest", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "rest", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["rest"], "contexts": ["absence of activity"]}, {"entity_id": "rest", "book_id": "english_physician_1652", "name": "rest", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["rest"], "contexts": ["procured by Vinegar of Roses and Rosewater"]}, {"entity_id": "repose", "book_id": "kosmos_humboldt_1845", "name": "repose", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["repose"], "contexts": ["state of rest"]}, {"entity_id": "descanso", "book_id": "polyanthea_medicinal", "name": "descanso", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["descanso"], "contexts": ["Rest as a remedy"]}, {"entity_id": "rest", "book_id": "first_principles_spencer_1862", "name": "rest", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["rest", "Rest"], "contexts": ["absence of motion", "state contrasted with motion"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "rest", "target_book": "english_physician_1652", "target_name": "rest", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "rest", "target_book": "kosmos_humboldt_1845", "target_name": "repose", "similarity": 0.968}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "rest", "target_book": "polyanthea_medicinal", "target_name": "descanso", "similarity": 0.948}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "rest", "target_book": "first_principles_spencer_1862", "target_name": "rest", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "rest", "target_book": "kosmos_humboldt_1845", "target_name": "repose", "similarity": 0.968}, {"source_book": "english_physician_1652", "source_name": "rest", "target_book": "polyanthea_medicinal", "target_name": "descanso", "similarity": 0.948}, {"source_book": "english_physician_1652", "source_name": "rest", "target_book": "first_principles_spencer_1862", "target_name": "rest", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "repose", "target_book": "polyanthea_medicinal", "target_name": "descanso", "similarity": 0.961}, {"source_book": "kosmos_humboldt_1845", "source_name": "repose", "target_book": "first_principles_spencer_1862", "target_name": "rest", "similarity": 0.968}, {"source_book": "polyanthea_medicinal", "source_name": "descanso", "target_book": "first_principles_spencer_1862", "target_name": "rest", "similarity": 0.948}], "id": 178, "stable_key": "clu_90514970a768c679", "ground_truth": {"modern_name": "Rest", "confidence": "high", "type": "concept", "wikidata_id": "Q35831", "wikidata_description": "naturally recurring resting state of mind and body", "wikipedia_url": "https://en.wikipedia.org/wiki/Sleep", "wikipedia_extract": "Sleep is a state of reduced mental and physical activity in which consciousness is altered and certain sensory activity is inhibited. During sleep, there is a marked decrease in muscle activity and interactions with the surrounding environment. While sleep differs from wakefulness in terms of the ability to react to stimuli, it still involves active brain patterns, making it more reactive than a coma or disorders of consciousness. Sleep occurs in repeating periods, during which the body alternates between two distinct modes: rapid eye movement sleep (REM) and non-REM sleep. Although REM stands for \"rapid eye movement\", this mode of sleep has many other aspects, including virtual paralysis of the body. Dreams are a succession of images, ideas, emotions, and sensations that usually occur involuntarily in the mind during certain stages of sleep."}, "cross_references": [{"found_name": "Somno", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1772, "target_cluster_name": "Somno", "source_book": "llm_generated", "evidence_snippet": "Sleep is a form of rest.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Sleep is a form of rest.", "is_reverse": true}]}, {"canonical_name": "human voice", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 5, "total_mentions": 8, "members": [{"entity_id": "voice", "book_id": "english_physician_1652", "name": "voice", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["voice"], "contexts": ["lost their voice", "faculty of speech"]}, {"entity_id": "human_voice", "book_id": "principles_of_psychology_james_1890", "name": "human voice", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["human voice"], "contexts": ["production of sound for singing"]}, {"entity_id": "voz", "book_id": "polyanthea_medicinal", "name": "voz", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["voz"], "contexts": ["human voice"]}, {"entity_id": "human_voice", "book_id": "connexion_physical_sciences_somerville_1858", "name": "human voice", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["human voice"], "contexts": ["human voice produces sound", "mechanism for producing speech and sound"]}, {"entity_id": "voice-parts", "book_id": "first_principles_spencer_1862", "name": "voice-parts", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["voice-parts"], "contexts": ["musical components"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "voice", "target_book": "principles_of_psychology_james_1890", "target_name": "human voice", "similarity": 0.965}, {"source_book": "english_physician_1652", "source_name": "voice", "target_book": "polyanthea_medicinal", "target_name": "voz", "similarity": 0.973}, {"source_book": "english_physician_1652", "source_name": "voice", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "human voice", "similarity": 0.965}, {"source_book": "english_physician_1652", "source_name": "voice", "target_book": "first_principles_spencer_1862", "target_name": "voice-parts", "similarity": 0.929}, {"source_book": "principles_of_psychology_james_1890", "source_name": "human voice", "target_book": "polyanthea_medicinal", "target_name": "voz", "similarity": 0.937}, {"source_book": "principles_of_psychology_james_1890", "source_name": "human voice", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "human voice", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "human voice", "target_book": "first_principles_spencer_1862", "target_name": "voice-parts", "similarity": 0.926}, {"source_book": "polyanthea_medicinal", "source_name": "voz", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "human voice", "similarity": 0.937}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "human voice", "target_book": "first_principles_spencer_1862", "target_name": "voice-parts", "similarity": 0.926}], "id": 179, "stable_key": "clu_713dfbbc552a59c6", "ground_truth": {"wikipedia_extract": "The human voice consists of sound made by a human being using the vocal tract, including talking, singing, laughing, crying, screaming, shouting, humming or yelling. The human voice  is specifically a part of human sound production in which the vocal folds (vocal cords) are the primary sound source. (Other sound production mechanisms produced from the same general area of the body involve the production of unvoiced consonants, clicks, whistling and whispering.) Generally speaking, the mechanism for generating the human voice can be subdivided into three parts; the lungs, the vocal folds within the larynx (voice box), and the articulators. The lungs, the \"pump\" must produce adequate airflow and air pressure to vibrate vocal folds. The vocal folds (vocal cords) then vibrate to use airflow from the lungs to create audible pulses that form the laryngeal sound source. The muscles of the larynx adjust the length and tension of the vocal folds to 'fine-tune' pitch and tone. The articulators (the parts of the vocal tract above the larynx consisting of tongue, palate, cheek, lips, etc.) articulate and filter the sound emanating from the larynx and to some degree can interact with the laryngeal airflow to strengthen or weaken it as a sound source."}, "cross_references": []}, {"canonical_name": "wood", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 5, "total_mentions": 8, "members": [{"entity_id": "timber", "book_id": "english_physician_1652", "name": "Timber", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Timber"], "contexts": ["wood from trees"]}, {"entity_id": "wood", "book_id": "origin_of_species_darwin_1859", "name": "wood", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["wood"], "contexts": ["hard fibrous material of trees"]}, {"entity_id": "bois_fossile", "book_id": "relation_historique_humboldt_vol3_1825", "name": "bois fossile", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["bois fossile"], "contexts": ["fossilized wood fragments"]}, {"entity_id": "wood", "book_id": "principles_of_psychology_james_1890", "name": "wood", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["wood"], "contexts": ["material of the violin", "material from trees"]}, {"entity_id": "wood", "book_id": "first_principles_spencer_1862", "name": "wood", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["wood"], "contexts": ["material that burns", "material used by an artizan"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Timber", "target_book": "origin_of_species_darwin_1859", "target_name": "wood", "similarity": 0.947}, {"source_book": "english_physician_1652", "source_name": "Timber", "target_book": "principles_of_psychology_james_1890", "target_name": "wood", "similarity": 0.947}, {"source_book": "english_physician_1652", "source_name": "Timber", "target_book": "first_principles_spencer_1862", "target_name": "wood", "similarity": 0.947}, {"source_book": "origin_of_species_darwin_1859", "source_name": "wood", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "bois fossile", "similarity": 0.899}, {"source_book": "origin_of_species_darwin_1859", "source_name": "wood", "target_book": "principles_of_psychology_james_1890", "target_name": "wood", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "wood", "target_book": "first_principles_spencer_1862", "target_name": "wood", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "bois fossile", "target_book": "principles_of_psychology_james_1890", "target_name": "wood", "similarity": 0.899}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "bois fossile", "target_book": "first_principles_spencer_1862", "target_name": "wood", "similarity": 0.899}, {"source_book": "principles_of_psychology_james_1890", "source_name": "wood", "target_book": "first_principles_spencer_1862", "target_name": "wood", "similarity": 1.0}], "id": 180, "stable_key": "clu_4c2c6bdcf73ccd6b", "ground_truth": {"modern_name": "Wood", "confidence": "high", "type": "mineral", "note": "While 'wood' is organic, the early modern texts refer to its material properties and sometimes fossilized forms, aligning with a substance classification. The context of 'bois fossile' further supports this.", "wikidata_id": "Q287", "wikidata_description": "fibrous material from trees or other plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Wood", "wikipedia_extract": "Wood is a structural tissue/material found as xylem in the stems and roots of trees and other woody plants. Being a natural material, it is characterized as an organic material – a natural composite of cellulosic fibers that are strong in tension and embedded in a matrix of lignin and hemicelluloses that resists compression. Wood is sometimes defined as only the secondary xylem in the stems of trees, or more broadly to include the same type of tissue elsewhere, such as in the roots of trees or shrubs. In a living tree, it performs a mechanical-support function, enabling woody plants to grow large or to stand up by themselves. It also conveys water and nutrients among the leaves, other growing tissues, and the roots. Wood may also refer to other plant materials with comparable properties, and to material engineered from wood, woodchips, or fibers."}, "cross_references": []}, {"canonical_name": "microscope", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 6, "total_mentions": 10, "members": [{"entity_id": "microscope", "book_id": "principles_of_psychology_james_1890", "name": "microscope", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["microscope"], "contexts": ["Instrument for viewing small objects"]}, {"entity_id": "microscope", "book_id": "kosmos_humboldt_1845", "name": "microscope", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 3, "variants": ["microscope"], "contexts": ["instrument for viewing small objects", "instrument for observing small life"]}, {"entity_id": "microscopio", "book_id": "polyanthea_medicinal", "name": "microscopio", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["microscopio"], "contexts": ["instrument for viewing small objects"]}, {"entity_id": "microscope", "book_id": "connexion_physical_sciences_somerville_1858", "name": "microscope", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["microscope"], "contexts": ["reveals new beauties in depicted objects"]}, {"entity_id": "microscope", "book_id": "first_principles_spencer_1862", "name": "microscope", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["microscope"], "contexts": ["instrument for viewing small objects", "instrument for viewing minute forms"]}, {"entity_id": "microscopes", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Microscopes", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["Microscopes"], "contexts": ["instruments for viewing microscopic objects"]}, {"entity_id": "microscopes", "book_id": "principles_of_psychology_james_1890", "name": "microscopes", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["microscopes"], "contexts": ["instruments for viewing small objects"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "microscope", "target_book": "kosmos_humboldt_1845", "target_name": "microscope", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "microscope", "target_book": "polyanthea_medicinal", "target_name": "microscopio", "similarity": 0.975}, {"source_book": "principles_of_psychology_james_1890", "source_name": "microscope", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "microscope", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "microscope", "target_book": "first_principles_spencer_1862", "target_name": "microscope", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "microscope", "target_book": "polyanthea_medicinal", "target_name": "microscopio", "similarity": 0.975}, {"source_book": "kosmos_humboldt_1845", "source_name": "microscope", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "microscope", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "microscope", "target_book": "first_principles_spencer_1862", "target_name": "microscope", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "microscopio", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "microscope", "similarity": 0.975}, {"source_book": "polyanthea_medicinal", "source_name": "microscopio", "target_book": "first_principles_spencer_1862", "target_name": "microscope", "similarity": 0.975}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "microscope", "target_book": "first_principles_spencer_1862", "target_name": "microscope", "similarity": 1.0}], "id": 181, "stable_key": "clu_70f953c33303dca1", "ground_truth": {"wikipedia_extract": "A microscope (from Ancient Greek  μικρός (mikrós) 'small' and  σκοπέω (skopéō) 'to look (at); examine, inspect') is a laboratory instrument used to examine objects that are too small to be seen by the naked eye. Microscopy is the science of investigating small objects and structures using a microscope. Microscopic means being invisible to the eye unless aided by a microscope. There are many types of microscopes, and they may be grouped in different ways. One way is to describe the method an instrument uses to interact with a sample and produce images, either by sending a beam of light or electrons through a sample in its optical path, by detecting photon emissions from a sample, or by scanning across and a short distance from the surface of a sample using a probe. The most common microscope (and the first to be invented) is the optical microscope, which uses lenses to refract visible light that passed through a thinly sectioned sample to produce an observable image."}, "member_count": 7, "cross_references": [{"found_name": "lens", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2485, "target_cluster_name": "lens", "source_book": "llm_generated", "evidence_snippet": "Microscopes utilize lenses as fundamental components to magnify small objects.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Microscopes utilize lenses as fundamental components to magnify small objects.", "is_reverse": true}]}, {"canonical_name": "metamorphosis", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 6, "total_mentions": 10, "members": [{"entity_id": "metamorphosis", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Metamorphosis", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Metamorphosis"], "contexts": ["work by Ovid"]}, {"entity_id": "metamorphosis", "book_id": "origin_of_species_darwin_1859", "name": "metamorphosis", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["metamorphosis"], "contexts": ["transformation from larva to adult", "transformation during development"]}, {"entity_id": "metamorphosis", "book_id": "principles_of_psychology_james_1890", "name": "metamorphosis", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["metamorphosis"], "contexts": ["complete change in form or appearance"]}, {"entity_id": "metamorphosis", "book_id": "kosmos_humboldt_1845", "name": "metamorphosis", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["metamorphosis"], "contexts": ["transformation of rock types", "transformation of forms"]}, {"entity_id": "metamorphosis", "book_id": "first_principles_spencer_1862", "name": "metamorphosis", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["metamorphosis"], "contexts": ["transformation of form"]}, {"entity_id": "metamorphose", "book_id": "kosmos_humboldt_1845", "name": "metamorphose", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["metamorphose"], "contexts": ["changing the nature of rocks"]}, {"entity_id": "metamorphoses", "book_id": "kosmos_humboldt_1845", "name": "metamorphoses", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["metamorphoses"], "contexts": ["transformations of matter"]}, {"entity_id": "metamorphoses", "book_id": "coloquios_da_orta_1563", "name": "metamorphoses", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["metamorphoses"], "contexts": ["transformations in mythology"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Metamorphosis", "target_book": "origin_of_species_darwin_1859", "target_name": "metamorphosis", "similarity": 0.986}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Metamorphosis", "target_book": "principles_of_psychology_james_1890", "target_name": "metamorphosis", "similarity": 0.986}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Metamorphosis", "target_book": "kosmos_humboldt_1845", "target_name": "metamorphosis", "similarity": 0.986}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Metamorphosis", "target_book": "first_principles_spencer_1862", "target_name": "metamorphosis", "similarity": 0.986}, {"source_book": "origin_of_species_darwin_1859", "source_name": "metamorphosis", "target_book": "principles_of_psychology_james_1890", "target_name": "metamorphosis", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "metamorphosis", "target_book": "kosmos_humboldt_1845", "target_name": "metamorphosis", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "metamorphosis", "target_book": "first_principles_spencer_1862", "target_name": "metamorphosis", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "metamorphosis", "target_book": "kosmos_humboldt_1845", "target_name": "metamorphosis", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "metamorphosis", "target_book": "first_principles_spencer_1862", "target_name": "metamorphosis", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "metamorphosis", "target_book": "first_principles_spencer_1862", "target_name": "metamorphosis", "similarity": 1.0}], "id": 182, "stable_key": "clu_49f4fd3480e6319f", "ground_truth": {"modern_name": "Metamorphosis", "confidence": "high", "type": "concept", "wikidata_id": "Q33753", "wikidata_description": "profound change in body structure during the postembryonic development of an organism", "wikipedia_url": "https://en.wikipedia.org/wiki/Metamorphosis", "wikipedia_extract": "Metamorphosis is a biological process by which an animal physically develops  including  birth transformation or hatching, involving a conspicuous and relatively abrupt change in the animal's body structure through cell growth and differentiation. Some insects, fish, amphibians, mollusks, crustaceans, cnidarians, echinoderms, and tunicates undergo metamorphosis, which is often accompanied by a change of nutrition source or behavior. Animals can be divided into species that undergo complete metamorphosis (\"holometaboly\"), incomplete metamorphosis (\"hemimetaboly\"), or no metamorphosis (\"ametaboly\"). Generally organisms with a larval stage undergo metamorphosis, and during metamorphosis the organism loses larval characteristics. The word metamorphosis derives from Ancient Greek μεταμόρφωσις, \"transformation, transforming\", from μετα- (meta-), \"after\" and μορφή (morphe), \"form\". In insects, growth and metamorphosis are controlled by hormones synthesized by endocrine glands near the front of the body (anterior)."}, "member_count": 8, "cross_references": [{"found_name": "Development", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 960, "target_cluster_name": "development", "source_book": "llm_generated", "evidence_snippet": "Metamorphosis is a specific type of biological development involving significant physical transformation.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Metamorphosis is a specific type of biological development involving significant physical transformation."}]}, {"canonical_name": "Cartas", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 5, "total_mentions": 7, "members": [{"entity_id": "card", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Card", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Card"], "contexts": ["compass card"]}, {"entity_id": "card", "book_id": "principles_of_psychology_james_1890", "name": "card", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["card"], "contexts": ["flat piece of material"]}, {"entity_id": "cartas", "book_id": "coloquios_da_orta_1563", "name": "Cartas", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Cartas", "cartas"], "contexts": ["maps used for navigation", "cited work by Affonso de Albuquerque"]}, {"entity_id": "carta", "book_id": "ricettario_fiorentino_1597", "name": "carta", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["carta"], "contexts": ["material for covering", "paper for wrapping pills"]}, {"entity_id": "card", "book_id": "connexion_physical_sciences_somerville_1858", "name": "card", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["card"], "contexts": ["material with slits for light experiment"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Card", "target_book": "principles_of_psychology_james_1890", "target_name": "card", "similarity": 0.99}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Card", "target_book": "ricettario_fiorentino_1597", "target_name": "carta", "similarity": 0.907}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Card", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "card", "similarity": 0.99}, {"source_book": "principles_of_psychology_james_1890", "source_name": "card", "target_book": "ricettario_fiorentino_1597", "target_name": "carta", "similarity": 0.893}, {"source_book": "principles_of_psychology_james_1890", "source_name": "card", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "card", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Cartas", "target_book": "ricettario_fiorentino_1597", "target_name": "carta", "similarity": 0.896}, {"source_book": "ricettario_fiorentino_1597", "source_name": "carta", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "card", "similarity": 0.893}], "id": 183, "stable_key": "clu_e575f8a677c086ab", "ground_truth": {"modern_name": "Card", "confidence": "high", "type": "object", "note": "The cluster includes references to 'compass card', 'Cartas' (which could be maps or playing cards, but in the context of scientific/medical texts, likely navigational charts or similar), and 'carta' (in Italian ricettario, possibly referring to a card or recipe sheet). 'Card' is the most encompassing modern term.", "wikidata_id": "Q10690", "wikidata_description": "capital city of Wales, United Kingdom", "wikipedia_url": "https://en.wikipedia.org/wiki/Cardiff", "wikipedia_extract": "Cardiff ( ; Welsh: Caerdydd [kairˈdiːð, kaːɨrˈdɨːð] ) is the capital and largest city of Wales. Cardiff had a population of 383,919 in 2024 and forms a principal area officially known as the City and County of Cardiff (Welsh: Dinas a Sir Caerdydd). The city is the eleventh largest in the United Kingdom. Located in the southeast of Wales and in the Cardiff Capital Region, Cardiff is the county town of the historic county of Glamorgan and in 1974–1996 of South Glamorgan. It belongs to the Eurocities network of the largest European cities. A small town until the early 19th century, its prominence as a port for coal when mining began in the region helped its expansion."}, "cross_references": []}, {"canonical_name": "Borneo", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 5, "total_mentions": 7, "members": [{"entity_id": "borneo", "book_id": "origin_of_species_darwin_1859", "name": "Borneo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Borneo"], "contexts": ["island in Southeast Asia", "location with southern vegetable forms"]}, {"entity_id": "borneo", "book_id": "kosmos_humboldt_1845", "name": "Borneo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Borneo"], "contexts": ["island with a certain areal surface"]}, {"entity_id": "borneo", "book_id": "coloquios_da_orta_1563", "name": "Borneo", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Borneo"], "contexts": ["island where elephants were found in small quantity", "island with fine diamonds"]}, {"entity_id": "borneo", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Borneo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Borneo"], "contexts": ["island affected by eruption"]}, {"entity_id": "borneo", "book_id": "first_principles_spencer_1862", "name": "Borneo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Borneo"], "contexts": ["island in Southeast Asia"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Borneo", "target_book": "kosmos_humboldt_1845", "target_name": "Borneo", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Borneo", "target_book": "coloquios_da_orta_1563", "target_name": "Borneo", "similarity": 0.898}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Borneo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Borneo", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Borneo", "target_book": "first_principles_spencer_1862", "target_name": "Borneo", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Borneo", "target_book": "coloquios_da_orta_1563", "target_name": "Borneo", "similarity": 0.898}, {"source_book": "kosmos_humboldt_1845", "source_name": "Borneo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Borneo", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Borneo", "target_book": "first_principles_spencer_1862", "target_name": "Borneo", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Borneo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Borneo", "similarity": 0.898}, {"source_book": "coloquios_da_orta_1563", "source_name": "Borneo", "target_book": "first_principles_spencer_1862", "target_name": "Borneo", "similarity": 0.898}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Borneo", "target_book": "first_principles_spencer_1862", "target_name": "Borneo", "similarity": 1.0}], "id": 184, "stable_key": "clu_e7a34e1f43180b87", "ground_truth": {"modern_name": "Borneo", "confidence": "high", "type": "place", "description": "Island in Southeast Asia, a source of camphor.", "note": "References to 'Bumeo' and 'Uembo' likely refer to Borneo and its camphor production.", "wikipedia_extract": "Borneo () is the third-largest island in the world, with an area of 748,168 km2 (288,869 sq mi), and population of 23,053,723 (2020 national censuses). Situated at the geographic centre of Maritime Southeast Asia, it is one of the Greater Sunda Islands, located north of Java, west of Sulawesi, and east of Sumatra. The island is crossed by the equator, which divides it roughly in half. In Indonesia, the island is also known as Kalimantan, which is also the name of the Indonesian region located on the island. The geology of Borneo was formed beginning in the Mesozoic. It formed part of Sundaland, a region connected to mainland Asia, until it became isolated by sea level rise at the end of the last ice age."}, "cross_references": [{"found_name": "Great Indian Archipelago", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1471, "target_cluster_name": "Great Indian Archipelago", "source_book": "llm_generated", "evidence_snippet": "Borneo is a major island within the Indonesian Archipelago.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Borneo is a major island within the Indonesian Archipelago.", "is_reverse": true}, {"found_name": "East Indies", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 497, "target_cluster_name": "East Indies", "source_book": "llm_generated", "evidence_snippet": "Borneo is a major island within the East Indies archipelago.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Borneo is a major island within the East Indies archipelago."}, {"found_name": "Sumatra", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 330, "target_cluster_name": "Sumatra", "source_book": "llm_generated", "evidence_snippet": "Sumbawa is an island in the Lesser Sunda Islands, adjacent to Borneo in the Indonesian archipelago.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Sumbawa is an island in the Lesser Sunda Islands, adjacent to Borneo in the Indonesian archipelago.", "is_reverse": true}, {"found_name": "Malay Archipelago", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2275, "target_cluster_name": "Malay Archipelago", "source_book": "llm_generated", "evidence_snippet": "Borneo is a major island within the Malay Archipelago.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Borneo is a major island within the Malay Archipelago.", "is_reverse": true}]}, {"canonical_name": "Bacon", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 6, "total_mentions": 9, "members": [{"entity_id": "bacon", "book_id": "origin_of_species_darwin_1859", "name": "BACON", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["BACON"], "contexts": ["author of Advancement of Learning"]}, {"entity_id": "bacon", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bacon", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Bacon"], "contexts": ["author of political aphorisms", "cited for political aphorisms"]}, {"entity_id": "bacon", "book_id": "polyanthea_medicinal", "name": "Bacon", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Bacon"], "contexts": ["Francis Bacon"]}, {"entity_id": "bacon", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Bacon", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["BACON", "Bacon"], "contexts": ["quote about studying natural phenomena", "philosopher who made conjectures"]}, {"entity_id": "bacon", "book_id": "first_principles_spencer_1862", "name": "Bacon", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Bacon"], "contexts": ["Renaissance philosopher and scientist"]}, {"entity_id": "bacon,_lord", "book_id": "kosmos_humboldt_1845", "name": "Bacon, Lord", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Bacon, Lord"], "contexts": ["philosopher and author of Novum Organon"]}, {"entity_id": "bacon,_francis", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Bacon, Francis", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Bacon, Francis"], "contexts": ["anticipated scientific discovery"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "BACON", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Bacon", "similarity": 0.968}, {"source_book": "origin_of_species_darwin_1859", "source_name": "BACON", "target_book": "polyanthea_medicinal", "target_name": "Bacon", "similarity": 0.968}, {"source_book": "origin_of_species_darwin_1859", "source_name": "BACON", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bacon", "similarity": 0.968}, {"source_book": "origin_of_species_darwin_1859", "source_name": "BACON", "target_book": "first_principles_spencer_1862", "target_name": "Bacon", "similarity": 0.968}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bacon", "target_book": "polyanthea_medicinal", "target_name": "Bacon", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bacon", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bacon", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bacon", "target_book": "first_principles_spencer_1862", "target_name": "Bacon", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "Bacon", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bacon", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "Bacon", "target_book": "first_principles_spencer_1862", "target_name": "Bacon", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Bacon", "target_book": "first_principles_spencer_1862", "target_name": "Bacon", "similarity": 1.0}], "id": 185, "stable_key": "clu_5eea59f66f228dee", "ground_truth": {"modern_name": "Francis Bacon", "confidence": "high", "type": "person", "birth_year": 1561, "death_year": 1626, "description": "Philosopher, statesman, scientist, lawyer, jurist, author and orator", "wikidata_id": "Q37388", "wikidata_description": "English philosopher and statesman (1561–1626)", "wikipedia_url": "https://en.wikipedia.org/wiki/Francis%20Bacon", "wikipedia_extract": "Francis Bacon, 1st Viscount St Alban  (; 22 January 1561 – 9 April 1626) was an English philosopher and statesman who served as Attorney General and Lord Chancellor of England under King James I. Bacon argued for the importance of natural philosophy, guided by the scientific method, and his works remained influential throughout the Scientific Revolution. Bacon has been called the father of empiricism. He argued for the possibility of scientific knowledge based only upon inductive reasoning and careful observation of events in nature. He believed that science could be achieved by the use of a sceptical and methodical approach whereby scientists aim to avoid misleading themselves. Although his most specific proposals about such a method, the Baconian method, did not have long-lasting influence, the general idea of the importance and possibility of a sceptical methodology makes Bacon one of the founders of the scientific method."}, "member_count": 7, "cross_references": [{"found_name": "Newton", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 71, "target_cluster_name": "Newton", "source_book": "llm_generated", "evidence_snippet": "Newton, a key figure in the Scientific Revolution, built upon the methodological foundations laid by Francis Bacon, particularly regarding empirical observation and inductive reasoning.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Newton, a key figure in the Scientific Revolution, built upon the methodological foundations laid by Francis Bacon, particularly regarding empirical observation and inductive reasoning.", "is_reverse": true}, {"found_name": "Aristotle", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 62, "target_cluster_name": "Aristotle", "source_book": "llm_generated", "evidence_snippet": "Francis Bacon is considered a key figure in the development of the scientific method, which was a departure from the Aristotelian approach to natural philosophy. His work is often seen as a reaction against and an advancement upon Aristotelian thought.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Francis Bacon is considered a key figure in the development of the scientific method, which was a departure from the Aristotelian approach to natural philosophy. His work is often seen as a reaction against and an advancement upon Aristotelian thought."}, {"found_name": "Democritus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 156, "target_cluster_name": "Democrito", "source_book": "llm_generated", "evidence_snippet": "Bacon's emphasis on empirical observation and the inductive method aligns with the atomistic philosophy of Democritus, which posited that reality is composed of indivisible particles and void. Bacon's philosophy can be seen as a precursor to later developments in atomic theory.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Bacon's emphasis on empirical observation and the inductive method aligns with the atomistic philosophy of Democritus, which posited that reality is composed of indivisible particles and void. Bacon's philosophy can be seen as a precursor to later developments in atomic theory."}, {"found_name": "Galen", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 29, "target_cluster_name": "Galen", "source_book": "llm_generated", "evidence_snippet": "While Bacon's primary focus was on the scientific method and natural philosophy, his work implicitly challenged the established medical authorities of his time, including Galen, whose doctrines had dominated Western medicine for centuries. Bacon advocated for new methods of inquiry that would eventually lead to a more empirical and experimental approach to medicine.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "While Bacon's primary focus was on the scientific method and natural philosophy, his work implicitly challenged the established medical authorities of his time, including Galen, whose doctrines had dominated Western medicine for centuries. Bacon advocated for new methods of inquiry that would eventually lead to a more empirical and experimental approach to medicine."}, {"found_name": "Locke", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 242, "target_cluster_name": "Locke", "source_book": "llm_generated", "evidence_snippet": "Both were influential English philosophers whose ideas significantly shaped subsequent intellectual and political thought.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were influential English philosophers whose ideas significantly shaped subsequent intellectual and political thought.", "is_reverse": true}, {"found_name": "Drake", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 461, "target_cluster_name": "Drake", "source_book": "llm_generated", "evidence_snippet": "Both were influential figures in English intellectual history, with Drake being a prominent explorer and Bacon a philosopher and scientist who advocated for empirical methods, reflecting the spirit of the age of exploration and scientific inquiry.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were influential figures in English intellectual history, with Drake being a prominent explorer and Bacon a philosopher and scientist who advocated for empirical methods, reflecting the spirit of the age of exploration and scientific inquiry.", "is_reverse": true}, {"found_name": "Bain", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1664, "target_cluster_name": "Bain", "source_book": "llm_generated", "evidence_snippet": "Both were influential figures in the development of empirical methods and scientific thought, though separated by centuries. Bain's work on associationism and scientific psychology can be seen as building on Baconian principles of observation and induction.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were influential figures in the development of empirical methods and scientific thought, though separated by centuries. Bain's work on associationism and scientific psychology can be seen as building on Baconian principles of observation and induction.", "is_reverse": true}, {"found_name": "Comte", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2578, "target_cluster_name": "Comte", "source_book": "llm_generated", "evidence_snippet": "Auguste Comte's emphasis on the scientific method and the organization of knowledge aligns with the foundational principles laid out by Francis Bacon, who is considered a pioneer of the empirical method.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Auguste Comte's emphasis on the scientific method and the organization of knowledge aligns with the foundational principles laid out by Francis Bacon, who is considered a pioneer of the empirical method.", "is_reverse": true}, {"found_name": "Lewis", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2944, "target_cluster_name": "Lewis", "source_book": "llm_generated", "evidence_snippet": "While from different eras, both were influential figures in their respective fields (politics/monarchy for Louis IX, philosophy/science for Bacon) and their works or legacies were discussed in relation to broader historical and intellectual trends.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: While from different eras, both were influential figures in their respective fields (politics/monarchy for Louis IX, philosophy/science for Bacon) and their works or legacies were discussed in relation to broader historical and intellectual trends.", "is_reverse": true}]}, {"canonical_name": "liberté", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 7, "members": [{"entity_id": "liberté", "book_id": "relation_historique_humboldt_vol3_1825", "name": "liberté", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["liberté"], "contexts": ["beneficial state for peoples", "state of being free"]}, {"entity_id": "freedom", "book_id": "principles_of_psychology_james_1890", "name": "freedom", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["freedom"], "contexts": ["state of being unconstrained"]}, {"entity_id": "libertatem", "book_id": "kosmos_humboldt_1845", "name": "libertatem", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["libertatem"], "contexts": ["Latin for liberty"]}, {"entity_id": "liberdade", "book_id": "polyanthea_medicinal", "name": "liberdade", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["liberdade"], "contexts": ["Freedom from constraint"]}, {"entity_id": "liberty", "book_id": "first_principles_spencer_1862", "name": "liberty", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["liberty"], "contexts": ["freedom from oppressive restrictions"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "liberté", "target_book": "principles_of_psychology_james_1890", "target_name": "freedom", "similarity": 0.979}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "liberté", "target_book": "kosmos_humboldt_1845", "target_name": "libertatem", "similarity": 0.952}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "liberté", "target_book": "polyanthea_medicinal", "target_name": "liberdade", "similarity": 0.99}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "liberté", "target_book": "first_principles_spencer_1862", "target_name": "liberty", "similarity": 0.949}, {"source_book": "principles_of_psychology_james_1890", "source_name": "freedom", "target_book": "kosmos_humboldt_1845", "target_name": "libertatem", "similarity": 0.946}, {"source_book": "principles_of_psychology_james_1890", "source_name": "freedom", "target_book": "polyanthea_medicinal", "target_name": "liberdade", "similarity": 0.978}, {"source_book": "principles_of_psychology_james_1890", "source_name": "freedom", "target_book": "first_principles_spencer_1862", "target_name": "liberty", "similarity": 0.945}, {"source_book": "kosmos_humboldt_1845", "source_name": "libertatem", "target_book": "polyanthea_medicinal", "target_name": "liberdade", "similarity": 0.949}, {"source_book": "kosmos_humboldt_1845", "source_name": "libertatem", "target_book": "first_principles_spencer_1862", "target_name": "liberty", "similarity": 0.945}, {"source_book": "polyanthea_medicinal", "source_name": "liberdade", "target_book": "first_principles_spencer_1862", "target_name": "liberty", "similarity": 0.948}], "id": 186, "stable_key": "clu_70603f3f3ea0de39", "ground_truth": {"modern_name": "Liberty", "confidence": "high", "type": "concept", "note": "The cluster includes terms in French, English, Latin, and Portuguese, all referring to the concept of liberty or freedom.", "wikidata_id": "Q981297", "wikidata_description": "city in Texas, United States, part of the Houston metro area", "wikipedia_url": "https://en.wikipedia.org/wiki/Liberty%2C%20Texas", "wikipedia_extract": "Liberty is a city in the U.S. state of Texas, within Liberty County. The population was 8,279 at the 2020 census. It serves as the county seat of Liberty County. Liberty is the third oldest city in the state—established in 1831 on the banks of the Trinity River. The city also has a twin of the Liberty Bell from Philadelphia, Pennsylvania."}, "cross_references": [{"found_name": "Absolute power", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4263, "target_cluster_name": "absolute power", "source_book": "llm_generated", "evidence_snippet": "The concept of 'liberty' is often contrasted with or defined in opposition to 'absolute power'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The concept of 'liberty' is often contrasted with or defined in opposition to 'absolute power'."}, {"found_name": "Authority", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 355, "target_cluster_name": "Authority", "source_book": "llm_generated", "evidence_snippet": "The concept of 'liberty' is often discussed in relation to the limits or nature of 'authority'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The concept of 'liberty' is often discussed in relation to the limits or nature of 'authority'."}, {"found_name": "Civil", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3939, "target_cluster_name": "Civil", "source_book": "llm_generated", "evidence_snippet": "The historical context of 'liberty' often involves discussions of civil rights and governance.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The historical context of 'liberty' often involves