: [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Honda", "target_book": "kosmos_humboldt_1845", "target_name": "Honda", "similarity": 1.0}], "id": 1776, "stable_key": "clu_68c20e1fe2152a74", "ground_truth": {"modern_name": "Honda", "confidence": "high", "type": "place", "country": "Colombia"}, "cross_references": [{"found_name": "Rio Magdalena", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1621, "target_cluster_name": "Rio Magdalena", "source_book": "llm_generated", "evidence_snippet": "Honda is a town in Colombia located on the Magdalena River.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Honda is a town in Colombia located on the Magdalena River.", "is_reverse": true}]}, {"canonical_name": "Cotopaxi", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 19, "members": [{"entity_id": "cotopaxi", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cotopaxi", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 12, "variants": ["Cotopaxi", "Cotocache", "Cotombia"], "contexts": ["volcano in Ecuador", "volcano with similar shape to pic de Tolima"]}, {"entity_id": "cotopaxi", "book_id": "kosmos_humboldt_1845", "name": "Cotopaxi", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 7, "variants": ["Cotopaxi"], "contexts": ["volcano with a great eruption", "active volcano"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cotopaxi", "target_book": "kosmos_humboldt_1845", "target_name": "Cotopaxi", "similarity": 1.0}], "id": 1777, "stable_key": "clu_d8a57b77dff133d3", "ground_truth": {"modern_name": "Cotopaxi", "confidence": "high", "type": "place", "country": "Ecuador", "wikidata_id": "Q5175454", "wikidata_description": "census-designated place in Fremont County, Colorado, United States", "wikipedia_url": "https://en.wikipedia.org/wiki/Cotopaxi%2C%20Colorado", "wikipedia_extract": "Cotopaxi is an unincorporated town, a post office, and a census-designated place (CDP) located in and governed by Fremont County, Colorado, United States. The CDP is a part of the Cañon City, CO Micropolitan Statistical Area. The Cotopaxi post office has the ZIP Code 81223. At the United States Census 2020, the population of the Cotopaxi CDP was 44. The Cotopaxi, Colorado, post office opened on May 25, 1880. The town was named after Cotopaxi Volcano, one of the highest active volcanoes in the world, located in Ecuador."}, "cross_references": [{"found_name": "Andes", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 207, "target_cluster_name": "Andes", "source_book": "llm_generated", "evidence_snippet": "Cotopaxi is a volcano located in the Andes mountain range.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Cotopaxi is a volcano located in the Andes mountain range.", "is_reverse": true}, {"found_name": "Quito", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 210, "target_cluster_name": "Quito", "source_book": "llm_generated", "evidence_snippet": "Cotopaxi is an active volcano in the Andes Mountains of Ecuador, located south of Quito. It is a prominent natural feature in the region and often discussed in conjunction with Quito due to its proximity and volcanic activity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Cotopaxi is an active volcano in the Andes Mountains of Ecuador, located south of Quito. It is a prominent natural feature in the region and often discussed in conjunction with Quito due to its proximity and volcanic activity.", "is_reverse": true}, {"found_name": "volcans", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 602, "target_cluster_name": "volcans", "source_book": "llm_generated", "evidence_snippet": "Cotopaxi is a volcano in Ecuador, and Volcano is a CDP in Hawaii known for its proxim