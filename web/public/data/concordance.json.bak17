AR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "bridges", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bridges", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Bridges"], "contexts": ["author on Negro Slavery"]}, {"entity_id": "brücke", "book_id": "principles_of_psychology_james_1890", "name": "Brücke", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Brücke"], "contexts": ["noted observation about brainless hen"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bridges", "target_book": "principles_of_psychology_james_1890", "target_name": "Brücke", "similarity": 0.914}], "id": 4097, "stable_key": "clu_72c84044622b4fda", "ground_truth": {"modern_name": "Robert Bridges", "confidence": "medium", "type": "person", "description": "English poet and critic, translator of poets.", "note": "The mention of 'Bridges' in the context of 'Negro Slavery' and 'Brücke' (meaning bridge in German, potentially a mistranslation or pun) is ambiguous. Robert Bridges is a prominent figure in English literature. The 'brainless hen' observation might be a different Bridges or a misattribution."}, "cross_references": []}, {"canonical_name": "institutions libres", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "institutions_libres", "book_id": "relation_historique_humboldt_vol3_1825", "name": "institutions libres", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["institutions libres"], "contexts": ["Free institutions"]}, {"entity_id": "free_institutions", "book_id": "first_principles_spencer_1862", "name": "free institutions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["free institutions"], "contexts": ["political systems based on liberty"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "institutions libres", "target_book": "first_principles_spencer_1862", "target_name": "free institutions", "similarity": 0.979}], "id": 4098, "stable_key": "clu_468498702e851b96", "ground_truth": {"modern_name": "free institutions", "confidence": "high", "type": "concept", "note": "This refers to political or social structures that are not subject to arbitrary control and allow for individual liberty."}, "cross_references": []}, {"canonical_name": "M. de Rossel", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "m__de_rossel", "book_id": "relation_historique_humboldt_vol3_1825", "name": "M. de Rossel", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["M. de Rossel"], "contexts": ["had oscillation experiments"]}, {"entity_id": "m__de_rossel", "book_id": "kosmos_humboldt_1845", "name": "M. de Rossel", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["M. de Rossel"], "contexts": ["performed oscillation experiments"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "M. de Rossel", "target_book": "kosmos_humboldt_1845", "target_name": "M. de Rossel", "similarity": 1.0}], "id": 4099, "stable_key": "clu_30722dba8a56da3e", "ground_truth": {"modern_name": "Jean-François de La Rocque de Roqueburne", "confidence": "medium", "type": "person", "description": "French naval officer and administrator", "note": "The name 'M. de Rossel' is ambiguous. While Jean-François de La Rocque de Roqueburne is a possibility given the context of exploration and natural philosophy, the specific individual performing oscillation experiments is not definitively established with this name alone in the provided context. Further research into Humboldt's correspondents or scientific circles of the time might be needed."}, "cross_references": [{"found_name": "Lamanon", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2115, "target_cluster_name": "Lamanon", "source_book": "llm_generated", "evidence_snippet": "Both were naval officers and explorers, with Roqueburne serving as a hydrographer on Lapérouse's expedition.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were naval officers and explorers, with Roqueburne serving as a hydrographer on Lapérouse's expedition.", "is_reverse": true}]}, {"canonical_name": "Basse-Egypte", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "basse-egypte", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Basse-Egypte", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Basse-Egypte"], "contexts": ["region with comparable temperature"]}, {"entity_id": "baixo_egipto", "book_id": "coloquios_da_orta_1563", "name": "baixo Egipto", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["baixo Egipto"], "contexts": ["location of Ichneumon mentions"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Basse-Egypte", "target_book": "coloquios_da_orta_1563", "target_name": "baixo Egipto", "similarity": 0.881}], "id": 4100, "stable_key": "clu_c356deec2d8a9976", "ground_truth": {"modern_name": "Lower Egypt", "confidence": "high", "type": "place", "country": "Egypt", "wikipedia_extract": "In Egyptian history, the Upper and Lower Egypt period (also known as The Two Lands) was the final stage of prehistoric Egypt and directly preceded the unification of the realm. The conception of Egypt as the Two Lands was an example of the dualism in ancient Egyptian culture and frequently appeared in texts and imagery, including in the titles of Egyptian pharaohs. The Egyptian title zmꜣ-tꜣwj (Egyptological pronunciation sema-tawy) is usually translated as \"Uniter of the Two Lands\" and was depicted as a human trachea entwined with the papyrus and lily plant. The trachea stood for unification, while the papyrus and lily plant represent Lower and Upper Egypt. Standard titles of the pharaoh included the prenomen, quite literally \"Of the Sedge and Bee\" (nswt-bjtj, the symbols of Upper and Lower Egypt) and \"lord of the Two Lands\" (written nb-tꜣwj). Queens regnant were addressed as pharaohs and male.", "wikipedia_url": "https://en.wikipedia.org/wiki/Upper_and_Lower_Egypt"}, "cross_references": []}, {"canonical_name": "courans polaires", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "courans_polaires", "book_id": "relation_historique_humboldt_vol3_1825", "name": "courans polaires", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["courans polaires"], "contexts": ["ocean currents from polar regions"]}, {"entity_id": "bandes_polaires", "book_id": "kosmos_humboldt_1845", "name": "bandes polaires", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["bandes polaires"], "contexts": ["French for polar bands"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "courans polaires", "target_book": "kosmos_humboldt_1845", "target_name": "bandes polaires", "similarity": 0.899}], "id": 4101, "stable_key": "clu_678882cc16bef56c", "ground_truth": {"modern_name": "Polar currents", "confidence": "high", "type": "concept"}, "cross_references": []}, {"canonical_name": "Papoux", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "papoux", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Papoux", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Papoux"], "contexts": ["indigenous people of New Guinea"]}, {"entity_id": "papuan", "book_id": "first_principles_spencer_1862", "name": "Papuan", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Papuan"], "contexts": ["indigenous people of New Guinea