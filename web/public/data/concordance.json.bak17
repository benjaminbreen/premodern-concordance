ok": "principles_of_psychology_james_1890", "source_name": "elements", "target_book": "kosmos_humboldt_1845", "target_name": "elements", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "elements", "target_book": "first_principles_spencer_1862", "target_name": "elements", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "elements", "target_book": "first_principles_spencer_1862", "target_name": "elements", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "elements", "target_book": "first_principles_spencer_1862", "target_name": "element", "similarity": 0.913}], "id": 794, "stable_key": "clu_81cb6dc9e94eee41", "ground_truth": {"modern_name": "Elements", "confidence": "high", "type": "concept", "note": "The term 'elements' can refer to fundamental components in various contexts (philosophy, chemistry, psychology). The search term 'chemical element' is chosen to cover the most common scientific interpretation, but the context 'fundamental chemical constituents' strongly supports this. 'Elements of philosophy' could also suggest philosophical elements, but the presence of 'fundamental chemical constituents' leans towards a scientific interpretation.", "wikidata_id": "Q11344", "wikidata_description": "species of atoms having the same number of protons in the atomic nucleus and the same chemical properties, but not necessarily the same mass, or the same stability (or half-lifetime if they are unstable)", "wikipedia_url": "https://en.wikipedia.org/wiki/Chemical%20element", "wikipedia_extract": "A chemical element is a species of atom defined by its number of protons. The number of protons is called the atomic number of that element. For example, oxygen has an atomic number of 8: each oxygen atom has 8 protons in its nucleus. Atoms of the same element can have different numbers of neutrons in their nuclei, known as isotopes of the element. Atoms of one element can be transformed into atoms of a different element in nuclear reactions, which change an atom's atomic number. Almost all baryonic matter in the universe is composed of elements (among rare exceptions are neutron stars)."}, "cross_references": [{"found_name": "chemists", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1124, "target_cluster_name": "chemists", "source_book": "first_principles_spencer_1862", "evidence_snippet": "seems impossible on any other condition than the existence of ultimate atoms; and though the combining weights of the respective elements are termed by chemists their “equivalents,” for the purpose of", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "reverse: possess combining weights termed equivalents by chemists", "is_reverse": true}, {"found_name": "Matter", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 249, "target_cluster_name": "Matter", "source_book": "llm_generated", "evidence_snippet": "Elements are the fundamental constituents of matter.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Elements are the fundamental constituents of matter.", "is_reverse": true}, {"found_name": "hydrogène sulfuré", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 279, "target_cluster_name": "hydrogène sulfuré", "source_book": "llm_generated", "evidence_snippet": "Hydrogen sulfide is a chemical compound composed of hydrogen and sulfur.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Hydrogen sulfide is a chemical compound composed of hydrogen and sulfur.", "is_reverse": true}, {"found_name": "Sulphur", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 313, "target_cluster_name": "Sulphur", "source_book": "llm_generated", "evidence_snippet": "Sulfur is a chemical element, and sulfuric acid is a compound made from elements.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Sulfur is a chemical element, and sulfuric acid is a compound made from elements.", "is_reverse": true}, {"found_name": "Hydrogen", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 731, "target_cluster_name": "Hydrogen", "source_book": "llm_generated", "evidence_snippet": "Hydrogen is a chemical element.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Hydrogen is a chemical element.", "is_reverse": true}, {"found_name": "inorganic substances", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1482, "target_cluster_name": "inorganic substances", "source_book": "llm_generated", "evidence_snippet": "Many inorganic compounds are formed from chemical elements.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Many inorganic compounds are formed from chemical elements.", "is_reverse": true}, {"found_name": "particles", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2253, "target_cluster_name": "particles", "source_book": "llm_generated", "evidence_snippet": "Particles are often associated with the concept of fundamental elements.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Particles are often associated with the concept of fundamental elements.", "is_reverse": true}, {"found_name": "Xɑ", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "principles_of_psychology_james_1890", "evidence_snippet": "equivalent series _Xɑ, Xβ, Xɣ_,... etc. What is gained? The question immediately arises: How is _ɑ β ɣ_ known as a series? According to the theory, these elements must themselves be made up of a part ", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "equivalent series element"}, {"found_name": "Xβ", "link_type": "same_referent", "link_strength": 1.0, "target_c