ution", "book_id": "origin_of_species_darwin_1859", "name": "distribution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["distribution"], "contexts": ["spatial arrangement of organisms", "spread of organisms"]}, {"entity_id": "distribution", "book_id": "kosmos_humboldt_1845", "name": "distribution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["distribution"], "contexts": ["arrangement or spread"]}, {"entity_id": "distribution", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Distribution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Distribution"], "contexts": ["arrangement of electric charge"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "distribution", "target_book": "kosmos_humboldt_1845", "target_name": "distribution", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "distribution", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Distribution", "similarity": 0.931}, {"source_book": "kosmos_humboldt_1845", "source_name": "distribution", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Distribution", "similarity": 0.931}], "id": 1145, "stable_key": "clu_4d0e2178872e381a", "ground_truth": {"modern_name": "Distribution", "confidence": "high", "type": "concept", "wikidata_id": "Q865811", "wikidata_description": "a continuous functional on a space of test functions (Schwartz space), which generalizes the concept of locally integrable functions", "wikipedia_url": "https://en.wikipedia.org/wiki/Distribution%20%28mathematical%20analysis%29", "wikipedia_extract": "Distributions, also known as Schwartz distributions are a kind of generalized function in mathematical analysis. Distributions make it possible to differentiate functions whose derivatives do not exist in the classical sense. In particular, any locally integrable function has a distributional derivative. Distributions are widely used in the theory of partial differential equations, where it may be easier to establish the existence of distributional solutions (weak solutions) than classical solutions, or where appropriate classical solutions may not exist. Distributions are also important in physics and engineering where many problems naturally lead to differential equations whose solutions or initial conditions are singular, such as the Dirac delta function. is normally thought of as acting on the points in the function domain by \"sending\" a point ⁠."}, "cross_references": [{"found_name": "dispersion", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 448, "target_cluster_name": "dispersion", "source_book": "llm_generated", "evidence_snippet": "Distribution, in a biological context, is the result of dispersal and subsequent establishment of organisms in new areas.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Distribution, in a biological context, is the result of dispersal and subsequent establishment of organisms in new areas.", "is_reverse": true}, {"found_name": "economy of nature", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1147, "target_cluster_name": "economy of nature", "source_book": "llm_generated", "evidence_snippet": "The 'economy of nature' involves the spatial distribution of organisms and resources across different environments, and how these distributions are maintained or altered.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The 'economy of nature' involves the spatial distribution of organisms and resources across different environments, and how these distributions are maintained or altered.", "is_reverse": true}, {"found_name": "geography of plants", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2598, "target_cluster_name": "geography of