nce": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for gumme of a tree"}, {"found_name": "blood of a Dragon", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "pseudodoxia_epidemica_browne_1646", "evidence_snippet": "found about the head, to be the spawn of the Whale: Or take _sanguis draconis_ (which is the gumme of a tree,) to be the blood of a Dragon. By the same Logick we may infer, the Crystalline humour of t", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for sanguis draconis"}, {"found_name": "complete thoughts", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "first_principles_spencer_1862", "evidence_snippet": "of the truth: omitting, or rather excluding, as they do, an all-important fact. To speak specifically:—Besides that _definite_ consciousness of which Logic formulates the laws, there is also an _indef", "confidence": 0.65, "auto_label": "contested_identity", "found_relationship": "distinct from indefinite consciousness"}]}, {"canonical_name": "Job", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "job", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Job", "category": "PERSON", "subcategory": "AUTHORITY", "count": 6, "variants": ["Job"], "contexts": ["biblical figure tested by Satan", "biblical figure, known for patience"]}, {"entity_id": "job", "book_id": "principles_of_psychology_james_1890", "name": "Job", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Job"], "contexts": ["biblical figure known for his faith"]}, {"entity_id": "job", "book_id": "polyanthea_medicinal", "name": "Job", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Job"], "contexts": ["Biblical figure, considered a source of wisdom"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Job", "target_book": "principles_of_psychology_james_1890", "target_name": "Job", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Job", "target_book": "polyanthea_medicinal", "target_name": "Job", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Job", "target_book": "polyanthea_medicinal", "target_name": "Job", "similarity": 1.0}], "id": 992, "stable_key": "clu_f8124331a93b6298", "ground_truth": {"wikipedia_extract": "A job, employment, work or occupation, is a person's role in society. More specifically, a job is an activity, often regular and often performed in exchange for payment (\"for a living\"). Many people have multiple jobs (e.g., parent, homemaker, and employee). A person can begin a job by becoming an employee, volunteering, starting a business, or becoming a parent. The duration of a job may range from temporary (e.g., hourly odd jobs) to a lifetime (e.g., judges). An activity that requires a person's mental or physical effort is work (as in \"a day's work\")."}, "cross_references": [{"found_name": "David", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1392, "target_cluster_name": "David", "source_book": "llm_generated", "evidence_snippet": "Biblical figures often appear together in religious texts and theological discussions.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Biblical figures often appear together in religious texts and theological discussions.", "is_reverse": true}, {"found_name": "Ezekiel", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2913, "target_cluster_name": "Ezekiel", "source_book": "llm_generated", "evidence_snippet": "Both are figures in the Old Testament known for their trials and faith.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both are figures in the Old Testament known for their trials and faith.", "is_reverse": true}]}, {"canonical_name": "Atheism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "atheism", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Atheism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Atheism"], "contexts": ["denial of God's existence", "belief in no God"]}, {"entity_id": "atheists", "book_id": "principles_of_psychology_james_1890", "name": "atheists", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["atheists"], "contexts": ["disbelievers in God or gods"]}, {"entity_id": "atheism", "book_id": "principles_of_psychology_james_1890", "name": "Atheism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Atheism"], "contexts": ["belief system"]}, {"entity_id": "pantheism", "book_id": "first_principles_spencer_1862", "name": "Pantheism", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["Pantheism"], "contexts": ["hypothesis of self-creation", "theory of the universe, personality one with phenomena"]}, {"entity_id": "atheism", "book_id": "first_principles_spencer_1862", "name": "Atheism", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["Atheism"], "contexts": ["theory of the universe, negation of religion"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Atheism", "target_book": "principles_of_psychology_james_1890", "target_name": "atheists", "similarity": 0.881}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Atheism", "target_book": "principles_of_psychology_james_1890", "target_name": "Atheism", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Atheism", "target_book": "first_principles_spencer_1862", "target_name": "Pantheism", "similarity": 0.884}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Atheism", "target_book": "first_principles_spencer_1862", "target_name": "Atheism", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "atheists", "target_book": "first_principles_spencer_1862", "target_name": "Atheism", "similarity": 0.881}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Atheism", "target_book": "first_principles_spencer_1862", "target_name": "Pantheism", "similarity": 0.884}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Atheism", "target_book": "first_principles_spencer_1862", "target_name": "Atheism", "similarity": 1.0}], "id": 993, "stable_key": "clu_51097c80aa5fd547", "ground_truth": {"modern_name": "Atheism", "confidence": "high", "type": "concept", "note": "Consistent references to the denial of God's existence and related belief systems or theories.", "wikidata_id": "Q116795590", "wikidata_description": "incorrect assumption that atheism is an organized religion", "wikipedia_extract": "Atheism, in the broadest sense, is an absence of belief in the existence of deities. Less broadly, atheism is a rejection of the belief that any deities exist. In an even narrower sense, atheism is specifically the position that there are no deities. Atheism is contrasted with theism, which is the belief that at least one deity exists. Historically, evidence of atheistic viewpoints can be traced back to classical antiquity and early Indian philosophy. In the Western world, atheism declined after Christianity gained prominence."}, "cross_references": [{"found_name": "spirit", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 476, "target_cluster_name": "spirit", "source_book": "llm_generated", "evidence_snippet": "'Atheism' is the direct negation or absence of belief in 'Spirit' or 'Divinity', making it a conceptually related counterpoint.", "confidence": 0.85, "auto_label": "llm_related", "fo