ory": "OTHER_SUBSTANCE", "count": 5, "variants": ["nectar", "Nectar"], "contexts": ["sweet juice sought by insects", "sugary liquid produced by flowers"]}, {"entity_id": "néctar", "book_id": "coloquios_da_orta_1563", "name": "néctar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["néctar"], "contexts": ["mythical drink of gods", "food of the gods"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Nectar", "target_book": "coloquios_da_orta_1563", "target_name": "néctar", "similarity": 0.817}], "id": 2368, "stable_key": "clu_1ce7864805492927", "ground_truth": {"modern_name": "Nectar", "confidence": "high", "type": "substance", "description": "Sweet liquid produced by flowers, food of the gods in mythology.", "wikipedia_extract": "Nectar is a viscous, sugar-rich liquid produced by plants in glands called nectaries, either within the flowers with which it attracts pollinating animals, or by extrafloral nectaries, which provide a nutrient source to animal mutualists, which in turn provide herbivore protection. Common nectar-consuming pollinators include mosquitoes, hoverflies, wasps, bees, butterflies and moths, hummingbirds, honeyeaters and bats. Nectar is an economically important substance as it is the sugar source for honey. Nectar is also useful in agriculture and horticulture because the adult stages of some predatory insects feed on nectar. For example, a number of predacious or parasitoid wasps (e.g., the social wasp species Apoica flavissima) rely on nectar as a primary food source. In turn, these wasps then hunt agricultural pest insects as food for their young."}, "cross_references": [{"found_name": "manna", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 635, "target_cluster_name": "manna", "source_book": "llm_generated", "evidence_snippet": "Nectar is often described as a divine food or drink, similar to manna, which was a miraculous food provided by God.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Nectar is often described as a divine food or drink, similar to manna, which was a miraculous food provided by God.", "is_reverse": true}, {"found_name": "mel rosado", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1653, "target_cluster_name": "mel rosado", "source_book": "llm_generated", "evidence_snippet": "Nectar is the primary source material from which bees produce honey, including rose honey.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Nectar is the primary source material from which bees produce honey, including rose honey.", "is_reverse": true}, {"found_name": "Sugar", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 254, "target_cluster_name": "Sugar", "source_book": "llm_generated", "evidence_snippet": "Nectar is a sugar-rich liquid.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Nectar is a sugar-rich liquid."}, {"found_name": "Milk", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 637, "target_cluster_name": "Milk", "source_book": "llm_generated", "evidence_snippet": "Both nectar and milk are nutrient-rich liquids produced by organisms, though from different sources and for different purposes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both nectar and milk are nutrient-rich liquids produced by organisms, though from different sources and for different purposes."}]}, {"canonical_name": "Flight", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "flight", "book_id": "origin_of_species_darwin_1859", "name": "Flight", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["Flight", "flight"], "contexts": ["ability to move through air", "movement through the air"]}, {"entity_id": "flight", "book_id": "kosmos_humboldt_1845", "name": "flight", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["flight"], "contexts": ["act of running away"]}, {"entity_id": "flying", "book_id": "kosmos_humboldt_1845", "name": "flying", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["flying"], "contexts": ["ability to move through air"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Flight", "target_book": "kosmos_humboldt_1845", "target_name": "flight", "similarity": 0.978}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Flight", "target_book": "kosmos_humboldt_1845", "target_name": "flying", "similarity": 0.892}], "id": 2369, "stable_key": "clu_8654747e05094694", "ground_truth": {"modern_name": "Flight", "confidence": "high", "type": "concept", "wikipedia_extract": "Falcons Flight is a launched roller coaster located at Six Flags Qiddiya City in Qiddiya City, Riyadh Province, Saudi Arabia. Manufactured by Intamin, the steel coaster opened on December 31, 2025, as the tallest, fastest, and longest roller coaster in the world, surpassing Top Thrill 2, Formula Rossa, and Steel Dragon 2000, respectively. On April 7, 2017, Crown Prince Mohammed bin Salman officially announced the Qiddiya City mega project, an entertainment, sport, and cultural destination designed to diversify Saudi Arabia's economy as part of the Saudi Vision 2030 initiative. Included in the announcement was the involvement of the original Six Flags theme park chain, which at the time was also pursuing the development of international parks in Dubai and China. The Saudi Press Agency reported in October 2018 that the Crown Prince had met with David McKillip – then Six Flags' senior vice president of international park operations –  at the Future Investment Initiative conference in Riyadh. Details for Six Flags Qiddiya were formally revealed on August 26, 2019, with the park slated to open in early 2023.", "wikipedia_url": "https://en.wikipedia.org/wiki/Falcons_Flight"}, "cross_references": [{"found_name": "Fear", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 147, "target_cluster_name": "Fear", "source_book": "llm_generated", "evidence_snippet": "Flight is a common behavioral response to fear.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Flight is a common behavioral response to fear.", "is_reverse": true}, {"found_name": "locomotion", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 463, "target_cluster_name": "locomotion", "source_book": "llm_generated", "evidence_snippet": "Flight is a specific mode of locomotion.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Flight is a specific mode of locomotion.", "is_reverse": true}, {"found_name": "transport", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1438, "target_cluster_name": "transport", "source_book": "llm_generated", "evidence_snippet": "Flight represents a specific and advanced mode of transport, distinct from terrestrial or aquatic movement.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Flight represents a specific and advanced mode of transport, distinct from terrestrial or aquatic movement.", "is_reverse": true}, {"found_name": "movimento", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2004, "target_cluster_name": "movimento", "source_book": "llm_generated", "evidence_snippet": "Flight is a specific mode of movement through the air.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Flight is a specific mode of movement through the air.", "is_reverse": true}]}, {"canonical_name": "reproductive system", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "reproductive_system", "book_id": "origin_of_speci