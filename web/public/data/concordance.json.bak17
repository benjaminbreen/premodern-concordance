ical_name": "slow", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "slow", "book_id": "principles_of_psychology_james_1890", "name": "slow", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["slow"], "contexts": ["speed of motion"]}, {"entity_id": "slow", "book_id": "polyanthea_medicinal", "name": "slow", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["slow"], "contexts": ["rate of blood flow"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "slow", "target_book": "polyanthea_medicinal", "target_name": "slow", "similarity": 1.0}], "id": 4252, "stable_key": "clu_b78053311fccaa39", "ground_truth": {"modern_name": "Slow reproduction rate", "confidence": "medium", "type": "concept", "note": "The term 'slow' in the second context is ambiguous, but in conjunction with 'slow-breeders' and evolutionary texts, it likely refers to the rate of biological reproduction.", "wikipedia_extract": "Sawfish,  also known as carpenter sharks, are a family of very large rays characterized by a long, narrow, flattened rostrum, or nose extension, lined with sharp transverse teeth, arranged in a way that resembles a saw. They are among the largest fish, with some species reaching lengths of about 7–7.6 m (23–25 ft). They are found worldwide in tropical and subtropical regions in coastal marine and brackish estuarine waters, as well as freshwater rivers and lakes. All species are critically endangered. They should not be confused with sawsharks (order Pristiophoriformes) or the extinct sclerorhynchoids (order Rajiformes) which have a similar appearance, or swordfish (family Xiphiidae) which have a similar name but a very different appearance. Sawfishes are relatively slow breeders and the females give birth to live young.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sawfish"}, "cross_references": [{"found_name": "transitions 