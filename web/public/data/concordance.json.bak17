onship": "Arabic name for the known entity"}, {"found_name": "darchini", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "todos os médicos, se ha de dar mais fé que a esses padres da me- decina, que per falsa enformaçam escreverão. De modo que a que chamão os Gregos e Latinos cinamomo, chamam os Arábios quirfé ou quirfd,", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "Persian name for the known entity"}, {"found_name": "canela de Calecut", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "mesturada na canella de Calecut, e que veo ay por acerto. ' ORTA Podia ser que os Mouros de Calecut a levasem pêra o Estreito; e porém pois hia com a canella mesturada, nam era senam de Çeilam; e a de", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of canela"}, {"found_name": "cinamomo musilitico", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "desta cor; e também aquelles baixos que estam entre a costa e a ilha de Ceilam se chamam de Chi- Iam, onde podemos derivar o nome de Zegir. RUANO E cinamomo musilitico, tanto louvado, donde se diz? OR", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of the known entity"}]}, {"canonical_name": "temperature", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 119, "members": [{"entity_id": "température", "book_id": "relation_historique_humboldt_vol3_1825", "name": "température", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 27, "variants": ["température", "Temp. duB.", "tableau de la température", "temperature", "température atmosphérique", "température de l'eau", "température moyenne", "températures", "températures de la surface de l'eau", "températures mensuelles", "températures moyennes", "températures moyennes annuelles"], "contexts": ["temperature", "climatic condition"]}, {"entity_id": "temperature", "book_id": "principles_of_psychology_james_1890", "name": "temperature", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["temperature"], "contexts": ["degree of hotness or coldness", "quality of heat or cold"]}, {"entity_id": "temperature", "book_id": "kosmos_humboldt_1845", "name": "temperature", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 33, "variants": ["temperature"], "contexts": ["measure of heat", "degree of hotness or coldness"]}, {"entity_id": "temperature", "book_id": "connexion_physical_sciences_somerville_1858", "name": "temperature", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 45, "variants": ["Temperature", "temperature"], "contexts": ["degree of heat or cold", "measure of hotness or coldness"]}, {"entity_id": "temperature", "book_id": "first_principles_spencer_1862", "name": "temperature", "category": "CONCEPT", "subcategory": "QUALITY", "count": 10, "variants": ["temperature"], "contexts": ["degree of heat in a substance", "degree of hotness or coldness"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "température", "target_book": "principles_of_psychology_james_1890", "target_name": "temperature", "similarity": 0.986}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "température", "target_book": "kosmos_humboldt_1845", "target_name": "temperature", "similarity": 0.986}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "température", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "temperature", "similarity": 0.986}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "température", "target_book": "first_principles_spencer_1862", "target_name": "temperature", "similarity": 0.986}, {"source_book": "principles_of_psychology_james_1890", "source_name": "temperature", "target_book": "kosmos_humboldt_1845", "target_name": "temperature", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "temperature", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "temperature", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "temperature", "target_book": "first_principles_spencer_1862", "target_name": "temperature", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "temperature", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "temperature", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "temperature", "target_book": "first_principles_spencer_1862", "target_name": "temperature", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "temperature", "target_book": "first_principles_spencer_1862", "target_name": "temperature", "similarity": 1.0}], "id": 45, "stable_key": "clu_607410204c1095cf", "ground_truth": {"modern_name": "Temperature", "confidence": "high", "type": "concept", "wikidata_id": "Q11466", "wikidata_description": "physical property of matter that quantitatively expresses the common notions of hot and cold", "wikipedia_url": "https://en.wikipedia.org/wiki/Temperature", "wikipedia_extract": "Temperature quantitatively expresses the attribute of hotness or coldness. Temperature is measured with a thermometer. It reflects the average kinetic energy of the vibrating and colliding atoms making up a substance. In classical thermodynamics and kinetic theory, temperature reflects the average kinetic energy of the particles in a system, providing a quantitative measure of how energy is distributed among microscopic degrees of freedom. Thermometers are calibrated in various temperature scales that historically have relied on various reference points and thermometric substances for definition. The most common scales are the Celsius scale with the unit symbol °C (formerly called centigrade), the Fahrenheit scale (°F), and the Kelvin scale (K), with the third being used predominantly for scientific purposes."}, "cross_references": [{"found_name": "Animal heat", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3893, "target_cluster_name": "animal heat", "source_book": "llm_generated", "evidence_snippet": "Animal heat is a direct consequence of metabolic processes, which are fundamentally linked to temperature.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Animal heat is a direct consequence of metabolic processes, which are fundamentally linked to temperature."}, {"found_name": "Coldness", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 664, "target_cluster_name": "friealdade", "source_book": "llm_generated", "evidence_snippet": "Coldness is the inverse of hotness, and both are qualitative descriptions of temperature.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Coldness is the inverse of hotness, and both are qualitative descriptions of temperature."}, {"found_name": "Coolness", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3483, "target_cluster_name": "frescas", "source_book": "llm_generated", "evidence_snippet": "Coolness is a qualitative description of a lower temperature range.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Coolness is a qualitative description of a lower temperature range."}, {"found_name": "temperate regions", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4008, "target_cluster_name": "temperate regions", "source_book": "llm_generated", "evidence_snippet": "Temperate climates are defined by their temperature ranges throughout the year.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Temperate climates are defined by their temperature ranges throughout the year.", "is_reverse": true}]}, {"canonical_name": "France", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 9, "total_mentions": 154, "members": [{"entity_id": "france", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "France", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["France"], "contexts": ["shore location for compass variation", "country in Western Europe"]}, {"entity_id": "france", "book_id": "english_physician_1652", "name": "France", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["France"], "contexts": ["country of Mountpilier university", "native land of Turnsole"]}, {"entity_id": "france", "book_id": "origin_of_species_darwin_1859", "name": "France", "category": "PLACE", "subcategory": "COUNTRY", "count": 5, "variants": ["France"], "contexts": ["European country", "flora of France"]}, {"entity_id": "france", "book_id": "relation_historique_humboldt_vol3_1825", "name": "France", "category": "PLACE", "subcategory": "COUNTRY", "count": 103, "variants": ["France", "France continentale", "francoise"], "contexts": ["country where astronomical ephemerides were unavailable", "country with military presence"]}, {"entity_id": "france", "book_id": "principles_of_psychology_james_1890", "name": "France", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["France"], "contexts": ["country whose mothers are addressed", "country in Europe"]}, {"entity_id": "frança", "book_id": "coloquios_da_orta_1563", "name": "França", "category": "PLACE", "subcategory": "COUNTRY", "count": 12, "variants": ["França"], "contexts": ["location where a root grows", "country where a root grows"]}, {"entity_id": "frança", "book_id": "polyanthea_medicin