": "CITY", "count": 1, "variants": ["Dantzick"], "contexts": ["city in Poland"]}, {"entity_id": "danzica", "book_id": "ricettario_fiorentino_1597", "name": "Danzica", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Danzica"], "contexts": ["port where amber is found"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Dantzich", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Dantzick", "similarity": 0.925}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Dantzich", "target_book": "ricettario_fiorentino_1597", "target_name": "Danzica", "similarity": 0.909}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Dantzick", "target_book": "ricettario_fiorentino_1597", "target_name": "Danzica", "similarity": 0.889}], "id": 1414, "stable_key": "clu_41a1ad70599e073d", "ground_truth": {"wikipedia_extract": "Gdańsk (Kashubian: Gduńsk; German: Danzig) is a city on the Baltic coast of northern Poland, and the capital of the Pomeranian Voivodeship. With a population of 486,492, it is Poland's sixth-largest city and its major seaport. Gdańsk lies at the mouth of the Motława River and is situated at the southern edge of Gdańsk Bay, close to the city of Gdynia and the resort town of Sopot; these form a metropolitan area called the Tricity (Trójmiasto), with a population of approximately 1.5 million. Gdańsk was first mentioned in 997 as part of the early Polish state, and thereafter grew into a trading town under the Piast and Samboride dynasties. Shifting between Polish and Teutonic control during the Middle Ages, it subsequently joined the Hanseatic League and, with considerable autonomy, served as the Polish Crown's principal seaport and largest city until the early 18th century. With the Partitions of Poland, the city was annexed by Prussia in 1793, and was integrated into the German Empire in 1871."}, "cross_references": []}, {"canonical_name": "Siler montanum", "category": "PLANT", "subcategory": "HERB", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "siler_montanum", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Siler montanum", "category": "PLANT", "subcategory": "HERB", "count": 1, "variants": ["Siler montanum"], "contexts": ["herb with medicinal properties"]}, {"entity_id": "siler_montanum", "book_id": "coloquios_da_orta_1563", "name": "siler montanum", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["siler montanum"], "contexts": ["mountain celery"]}, {"entity_id": "siler_monta", "book_id": "polyanthea_medicinal", "name": "Siler monta", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Siler monta"], "contexts": ["ingredient in an electuary remedy"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Siler montanum", "target_book": "coloquios_da_orta_1563", "target_name": "siler montanum", "similarity": 0.769}, {"source_book": "coloquios_da_orta_1563", "source_name": "siler montanum", "target_book": "polyanthea_medicinal", "target_name": "Siler monta", "similarity": 0.943}], "id": 1415, "stable_key": "clu_e181b3e6512171fa", "ground_truth": {"wikipedia_extract": "Siler montanum, the laserwort, is a herbaceous perennial plant in the family Apiaceae. It is a robust perennial that can reach a height of about 30–100 centimetres (12–39 in). It has bipinnate, alternate leaves, and produces compound umbels of white five-stellate flowers from June to August. This species can be found in central and southern Europe, in the Alps, the Pyrenees, the Apennine Mountains and the Iberian Mountains. It occurs in gorges and rocky slopes at elevations of 800–2,250 metres (2,620–7,380 ft). The roots and seeds can be used as spices. and have been used in making gruit or beer Siler montanum subsp. apuanum F.Conti & Bartolucci – central Italy (Apuan Alps) Siler montanum subsp. corrasianum Bacch., Congiu, F.Conti & Bartolucci – Sardinia Siler montanum subsp. montanum – Alps, Pyrenees, and Iberian Mountains Siler montanum subsp. ogliastrinum Bacch., F.Conti & Bartolucci – Sardinia Siler montanum subsp. stabianum (Lacaita) F.Conti & Bartolucci – Italy (central and southern Apennines) Siler montanum Crantz."}, "cross_references": []}, {"canonical_name": "Eagle", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "eagle", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Eagle", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["Eagle"], "contexts": ["animal with protective quality"]}, {"entity_id": "eagle", "book_id": "english_physician_1652", "name": "Eagle", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Eagle"], "contexts": ["bird that scorns to meddle with a fly"]}, {"entity_id": "eagle", "book_id": "origin_of_species_darwin_1859", "name": "eagle", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["eagle"], "contexts": ["bird with a perfect eye"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Eagle", "target_book": "english_physician_1652", "target_name": "Eagle", "similarity": 0.897}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Eagle", "target_book": "origin_of_species_darwin_1859", "target_name": "eagle", "similarity": 0.936}], "id": 1416, "stable_key": "clu_2ee43c90cb1eb460", "ground_truth": {"modern_name": "Eagle", "confidence": "high", "type": "animal"}, "cross_references": [{"found_name": "aves", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2148, "target_cluster_name": "aves", "source_book": "llm_generated", "evidence_snippet": "Eagle is a type of bird.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Eagle is a type of bird.", "is_reverse": true}, {"found_name": "Vulture", "link_type": "conceptual_overlap", "link_strength"