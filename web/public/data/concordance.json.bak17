egory": "SCHOLAR", "count": 1, "variants": ["Erman, Adolph"], "contexts": ["researcher on magnetic declination"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Erman", "target_book": "kosmos_humboldt_1845", "target_name": "Erman", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Erman", "target_book": "kosmos_humboldt_1845", "target_name": "Compart Erman", "similarity": 0.862}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Erman", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Erman", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Erman", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Erman", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Compart Erman", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Erman", "similarity": 0.862}], "id": 924, "stable_key": "clu_5652eb77f27e11a6", "ground_truth": {"modern_name": "Adolf Erman", "confidence": "high", "type": "person", "birth_year": 1806, "death_year": 1877, "description": "German geographer and physicist, known for geomagnetic studies.", "note": "The text mentions 'M. Adolphe Erman' and 'Adolph Erman', likely referring to the same person.", "wikidata_id": "Q61421", "wikidata_description": "German Egyptologist and lexicographer (1854-1937)", "wikipedia_url": "https://en.wikipedia.org/wiki/Adolf%20Erman", "wikipedia_extract": "Johann Peter Adolf Erman (German: [ɛɐ̯ˈmãː]; 31 October 1854 – 26 June 1937) was a German Egyptologist and lexicographer. Born in Berlin, he was the son of the physicist Georg Adolf Erman and grandson of the physicist Paul Erman and the astronomer Friedrich Wilhelm Bessel. Educated at Leipzig and Berlin, he became associate professor of Egyptology at the University of Berlin in 1883 and full professor in 1892. In 1885 he was appointed director of the Egyptian department at the royal museum. In 1934 he was excluded from the faculty of the university because he was, according to the Nazi ideology, one quarter Jewish. As his family had converted to Protestantism in 1902, he and his family were not persecuted by the Nazi Party, but they all lost their positions."}, "member_count": 8, "cross_references": [{"found_name": "Friedrich Bessel", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 269, "target_cluster_name": "Bessel", "source_book": "llm_generated", "evidence_snippet": "Friedrich Bessel was Adolf Erman's grandfather.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Friedrich Bessel was Adolf Erman's grandfather."}]}, {"canonical_name": "desire", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 10, "members": [{"entity_id": "desire", "book_id": "principles_of_psychology_james_1890", "name": "desire", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["desire"], "contexts": ["preference for certain sensations", "a wish or longing"]}, {"entity_id": "desejo", "book_id": "polyanthea_medicinal", "name": "desejo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["desejo"], "contexts": ["strong desire"]}, {"entity_id": "desire", "book_id": "first_principles_spencer_1862", "name": "desire", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["desire"], "contexts": ["a strong wish or longing", "a strong feeling of wanting something"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "desire", "target_book": "polyanthea_medicinal", "target_name": "desejo", "similarity": 0.956}, {"source_book": "principles_of_psychology_james_1890", "source_name": "desire", "target_book": "first_principles_spencer_1862", "target_name": "desire", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_nam