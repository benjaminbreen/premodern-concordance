}, {"entity_id": "astronomers", "book_id": "first_principles_spencer_1862", "name": "astronomers", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["astronomers"], "contexts": ["scientists studying celestial bodies"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "astronomers", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Astronomers", "similarity": 0.851}, {"source_book": "kosmos_humboldt_1845", "source_name": "astronomers", "target_book": "first_principles_spencer_1862", "target_name": "astronomers", "similarity": 0.882}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Astronomers", "target_book": "first_principles_spencer_1862", "target_name": "astronomers", "similarity": 0.965}], "id": 901, "stable_key": "clu_7bfbb3b67a9f4503", "ground_truth": {"modern_name": "astronomers", "confidence": "high", "type": "person", "description": "Scientists who study celestial bodies and the universe.", "wikidata_id": "Q11063", "wikidata_description": "scientist who studies celestial bodies", "wikipedia_url": "https://en.wikipedia.org/wiki/Astronomer", "wikipedia_extract": "An astronomer is a scientist in the field of astronomy who focuses on a specific question or field outside the scope of Earth. Astronomers study astronomical objects, such as stars, planets, moons, comets and galaxies, by some combination of observation and the application of astrophysical models. Examples of topics or fields astronomers study include planetary science, solar astronomy, the origin or evolution of stars, or the formation of galaxies. A related but distinct subject is physical cosmology, which studies the universe as a whole. Astronomers cannot typically perform experiments: the objects of interest in the field are far away. Consequently they rely primarily on observations, collecting electromagnetic radiation or particles such as cosmic rays."}, "cross_references": [{"found_name": "Anatomist", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3760, "target_cluster_name": "Anatomicos", "source_book": "llm_generated", "evidence_snippet": "Anatomists are scientists who study the structure of living things, a field that can overlap with the observational and analytical aspects of astronomy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Anatomists are scientists who study the structure of living things, a field that can overlap with the observational and analytical aspects of astronomy."}, {"found_name": "Botanist", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2986, "target_cluster_name": "botanists", "source_book": "llm_generated", "evidence_snippet": "Botanists are scientists who study plants. While distinct, the study of natural phenomena and classification can be a shared characteristic with astronomers.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Botanists are scientists who study plants. While distinct, the study of natural phenomena and classification can be a shared characteristic with astronomers."}, {"found_name": "Chemist", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 609, "target_cluster_name": "Chymicos", "source_book": "llm_generated", "evidence_snippet": "Chemists study the properties and behavior of matter. Historically, the study of celestial bodies sometimes involved chemical considerations, and both fields are branches of natural philosophy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Chemists study the properties and behavior of matter. Historically, the study of celestial bodies sometimes involved chemical considerations, and both fields are branches of natural philosophy."}, {"found_name": "Geographers", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3771, "target_cluster_name": "physical geographers", "source_book": "llm_generated", "evidence_snippet": "Geographers study the Earth's surface, including its physical features and human populations. Early astronomers often had strong ties to geography, particularly in terms of navigation and mapping.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Geographers study the Earth's surface, including its physical features and human populations. Early astronomers often had strong ties to geography, particularly in terms of navigation and mapping."}, {"found_name": "Geologists", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 956, "target_cluster_name": "geologists", "source_book": "llm_generated", "evidence_snippet": "Geologists study the solid Earth, the rocks of which it is composed, and the processes by which they change. While distinct, both fields are part of the broader study of natural sciences and can involve geological observations of celestial bodies.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Geologists study the solid Earth, the rocks of which it is composed, and the processes by which they change. While distinct, both fields are part of the broader study of natural sciences and can involve geological observations of celestial bodies."}, {"found_name": "Arab scholars", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2340, "target_cluster_name": "Arabs", "source_book": "llm_generated", "evidence_snippet": "Arab scholars made significant contributions to astronomy during the Islamic Golden Age, preserving and advancing ancient knowledge and making their own observations.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Arab scholars made significant contributions to astronomy during the Islamic Golden Age, preserving and advancing ancient knowledge and making their own observations."}, {"found_name": "Ancient Egyptians", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_