y": 0.974}, {"source_book": "origin_of_species_darwin_1859", "source_name": "lungs", "target_book": "principles_of_psychology_james_1890", "target_name": "lungs", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "lungs", "target_book": "polyanthea_medicinal", "target_name": "Lungs", "similarity": 0.974}, {"source_book": "origin_of_species_darwin_1859", "source_name": "lungs", "target_book": "first_principles_spencer_1862", "target_name": "lungs", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "lungs", "target_book": "polyanthea_medicinal", "target_name": "Lungs", "similarity": 0.974}, {"source_book": "principles_of_psychology_james_1890", "source_name": "lungs", "target_book": "first_principles_spencer_1862", "target_name": "lungs", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "Lungs", "target_book": "first_principles_spencer_1862", "target_name": "lungs", "similarity": 0.974}], "id": 66, "stable_key": "clu_0cfdd29f14ee494e", "ground_truth": {"modern_name": "Lungs", "confidence": "high", "type": "anatomy", "description": "The primary organs of respiration in humans and other vertebrates.", "wikipedia_extract": "The lungs are the primary organs of the respiratory system in many animals, including humans. In mammals and most other tetrapods, two lungs are located near the backbone on either side of the heart. Their function in the respiratory system is to extract oxygen from the atmosphere and transfer it into the bloodstream, and to release carbon dioxide from the bloodstream into the atmosphere, in a process of gas exchange. Respiration is driven by different muscular systems in different species. Mammals, reptiles and birds use their musculoskeletal systems to support and foster breathing. In early tetrapods, air was driven into the lungs by the pharyngeal muscles via buccal pumping, a mechanism still seen in amphibians."}, "cross_references": [{"found_name": "Air", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 109, "target_cluster_name": "air", "source_book": "llm_generated", "evidence_snippet": "The lungs are the primary organs for respiration, which involves the intake and processing of air.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The lungs are the primary organs for respiration, which involves the intake and processing of air."}, {"found_name": "Atmosphere", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 213, "target_cluster_name": "atmosphere", "source_book": "llm_generated", "evidence_snippet": "The lungs function by exchanging gases with the atmosphere.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The lungs function by exchanging gases with the atmosphere."}, {"found_name": "Earth's atmosphere", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4529, "target_cluster_name": "earth’s atmosphere", "source_book": "llm_generated", "evidence_snippet": "The lungs function by exchanging gases with the atmosphere.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The lungs function by exchanging gases with the atmosphere."}, {"found_name": "Gas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 171, "target_cluster_name": "gas", "source_book": "llm_generated", "evidence_snippet": "The lungs process gases, specifically oxygen and carbon dioxide, during respiration.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The lungs process gases, specifically oxygen and carbon dioxide, during respiration."}, {"found_name": "Gaseous substances", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2321, "target_cluster_name": "gaseous", "source_book": "llm_generated", "evidence_snippet": "The lungs process gases, specifically oxygen and carbon dioxide, during respiration.", "confi