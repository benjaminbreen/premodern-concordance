ook_id": "english_physician_1652", "name": "Asparagus", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Asparagus"], "contexts": ["a plant with edible shoots", "shoots compared to those of Butchers-Broom"]}, {"entity_id": "asparagus_plant", "book_id": "origin_of_species_darwin_1859", "name": "asparagus plant", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["asparagus plant"], "contexts": ["a type of plant"]}, {"entity_id": "asparagorum", "book_id": "relation_historique_humboldt_vol3_1825", "name": "asparagorum", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["asparagorum"], "contexts": ["plant juice used for intoxication"]}, {"entity_id": "garden_asparagus", "book_id": "english_physician_1652", "name": "Garden Asparagus", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Garden Asparagus"], "contexts": ["nourishes more than wild asparagus"]}, {"entity_id": "asparagus", "book_id": "origin_of_species_darwin_1859", "name": "Asparagus", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Asparagus"], "contexts": ["mentioned in text"]}, {"entity_id": "asparagus", "book_id": "coloquios_da_orta_1563", "name": "Asparagus", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Asparagus", "AsparaguSf"], "contexts": ["plant species Orta might have seen", "plant species"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Asparagus", "target_book": "origin_of_species_darwin_1859", "target_name": "asparagus plant", "similarity": 0.975}, {"source_book": "english_physician_1652", "source_name": "Asparagus", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "asparagorum", "similarity": 0.915}, {"source_book": "origin_of_species_darwin_1859", "source_name": "asparagus plant", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "asparagorum", "similarity": 0.924}, {"source_book": "english_physician_1652", "source_name": "Garden Asparagus", "target_book": "origin_of_species_darwin_1859", "target_name": "Asparagus", "similarity": 0.927}, {"source_book": "english_physician_1652", "source_name": "Garden Asparagus", "target_book": "coloquios_da_orta_1563", "target_name": "Asparagus", "similarity": 0.927}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Asparagus", "target_book": "coloquios_da_orta_1563", "target_name": "Asparagus", "similarity": 1.0}], "id": 435, "stable_key": "clu_26a2838513b2904a", "ground_truth": {"modern_name": "Asparagus", "confidence": "high", "type": "plant", "linnaean": "Asparagus officinalis", "family": "Asparagaceae", "description": "Edible shoots of a perennial plant, also known as garden asparagus.", "wikipedia_extract": "Asparagus (Asparagus officinalis) or garden asparagus is a perennial flowering plant species in the genus Asparagus native to Eurasia. Widely cultivated as a vegetable crop, its young shoots are used as a spring vegetable. Asparagus is an herbaceous, perennial plant growing typically to 100–150 centimetres (3–5 feet) tall, with stout stems with much-branched, feathery foliage. It has been known to grow as long as 3.5 metres (11 ft). The 'leaves' are needle-like cladodes (modified stems) in the axils of scale leaves; they are 6–32 millimetres (1⁄4–1+1⁄4 inches) long and 1 mm (1⁄32 in) broad, and clustered in fours, up to 15, together, in a rose-like shape. The root system, often referred to as a 'crown', is adventitious; the root type is fasciculated."}, "cross_references": []}, {"canonical_name": "hot springs", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 15, "members": [{"entity_id": "sources_thermales", "book_id": "relation_historique_humboldt_vol3_1825", "name": "sources thermales", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["sources thermales"], "contexts": ["geological feature"]}, {"entity_id": "hot_springs", "book_id": "kosmos_humboldt_1845", "name": "hot springs", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["hot springs", "Hot Springs"], "contexts": ["springs with naturally heated water", "geothermal water sources"]}, {"entity_id": "thermas", "book_id": "polyanthea_medicinal", "name": "thermas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["thermas", "thermae"], "contexts": ["location for baths"]}, {"entity_id": "aguas_calientes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "aguas calientes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["aguas calientes"], "contexts": ["name for hot springs location"]}, {"entity_id": "hot_springs", "book_id": "connexion_physical_sciences_somerville_1858", "name": "hot springs", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["hot springs"], "contexts": ["geothermal features with high temperature", "geothermal features emitting hot water"]}, {"entity_id": "thermal_springs", "book_id": "kosmos_humboldt_1845", "name": "Thermal springs", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["thermal springs", "Thermal springs"], "contexts": ["hot water springs", "springs with uniform temperature"]}, {"entity_id": "balneis_thermalibus", "book_id": "polyanthea_medicinal", "name": "balneis thermalibus", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["balneis thermalibus"], "contexts": ["thermal baths"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "sources thermales", "target_book": "kosmos_humboldt_1845", "target_name": "hot springs", "similarity": 0.886}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "sources thermales", "target_book": "polyanthea_medicinal", "target_name": "thermas", "similarity": 0.935}, {"source_book": "kosmos_humboldt_1845", "source_name": "hot springs", "target_book": "polyanthea_medicinal", "target_name": "thermas", "similarity": 0.91}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "aguas calientes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "hot springs", "similarity": 0.913}], "id": 436, "stable_key": "clu_34ba0afd5686a786", "ground_truth": {"modern_name": "thermal springs", "confidence": "high", "type": "place", "wikidata_id": "Q97726587", "wikidata_description": "scholarly article", "wikipedia_extract": "A hot spring, thermal spring, hydrothermal spring, or geothermal spring is a spring produced by the emergence of geothermally heated groundwater onto the surface of the Earth. The groundwater is heated either by shallow bodies of magma (molten rock) or by circulation through faults to hot rock deep in the Earth's crust. Hot spring water often contains large amounts of dissolved minerals. The chemistry of hot springs ranges from acid sulfate springs with a pH as low as 0.8, to alkaline chloride springs saturated with silica, to bicarbonate springs saturated with carbon dioxide and carbonate minerals. Some springs also contain abundant dissolved iron. The minerals brought to the surface in hot springs often feed communities of extremophiles, microorganisms adapted to extreme conditions, and it is possible that life on Earth had its origin in hot springs."}, "member_count": 7, "cross_references": [{"found_name": "Chaudes-Aigues", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3653, "target_cluster_name": "Chaudes Aigues", "source_book": "llm_generated", "evidence_snippet": "Chaudes-Aigues is a commune in the Cantal department in south-central France, known for its hot springs.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Chaudes-Aigues is a commune in the Cantal department in south-central France, known for its hot springs."}]}, {"canonical_name": "Mary", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 4, "total_mentions": 8, "members": [{"entity_id": "mary", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Mary", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Mary"], "contexts": ["mother of Jesus", "mother of Jesus, associated with womb mystery"]}, {"entity_id": "mary", "book_id": "principles_of_psychology_james_1890", "name": "Mary", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Mary"], "contexts": ["deceased individual whose spirit allegedly controlled Lurancy", "entity assumed control of Lurancy"]}, {"entity_id": "marie", "book_id": "principles_of_psychology_james_1890", "name": "Marie", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Marie"], "contexts": ["subject of hypnotic trance study"]}, {"entity_id": "mariana", "book_id": "historia_medicinal_monardes_1574", "name": "Mariana", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Mariana"], "contexts": ["wife of Maestro Juan Plutino"]}, {"entity_id": "martha", "book_id": "polyanthea_medicinal", "name": "Martha", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Martha"], "contexts": ["godchild with a dry cough"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mary", "target_book": "principles_of_psychology_james_1890", "target_name": "Mary", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mary", "target_book": "principles_of_psychology_james_1890", "target_name": "Marie", "similarity": 0.931}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mary", "target_book": "historia_medicinal_monardes_1574", "target_name": "Mariana", "similarity": 0.891}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mary", "target_book": "polyanthea_medicinal", "target_name": "Martha", "similarity": 0.863}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Mary", "target_book": "historia_medicinal_monardes_1574", "target_name": "Mariana", "similarity": 0.891}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Mary", "target_book": "polyanthea_medicinal", "target_name": "Martha", "similarity": 0.863}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Marie", "target_book": "historia_medicinal_monardes_1574", "target_name": "Mariana", "similarity": 0.888}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Marie", "target_book": "polyanthea_medicinal", "target_name": "Martha", "similarity": 0.855}], "id": 437, "stable_key": "clu_5d29d7f503261b91", "ground_truth": {"modern_name": "Mary", "confidence": "medium", "type": "person", "description": "Figure of religious significance, subject of psychological study, and historical individual.", "note": "The term 'Mary' appears in multiple contexts, some religious (mother of Jesus), some psychological (subject of study), and potentially historical. Distinguishing a single referent is difficult without more context for each instance.", "wikidata_id": "", "wikidata_description": "female given name", "wikipedia_url": "https://en.wikipedia.org/wiki/Mary%20%28name%29", "wikipedia_extract": "Mary  is a feminine given name, the English form of the name Maria, which was in turn a Latin form of the Greek name Μαρία, María or Μαριάμ, Mariam, found in the Septuagint and New Testament. The latter reflects the original Hebrew pronunciation of the name מרים (Masoretic pronunciation Miryam), as attested by the Septuagint. The vowel \"a\" in a closed unaccented syllable later became \"i\", as seen in other names such as \"Bil'am\" (Balaam) and \"Shimshon\" (Samson). The English name Mary arises by adoption of French Marie into Middle English. Wycliffe's Bible still has Marie, with the modern spelling current from the 16th century, found in the Tyndale Bible (1525), Coverdale Bible (1535) and later translations. The name Mary may have originated from the Egyptian language; it is likely derivative of the root mr, meaning \"love; beloved\" (compare mry.t-ymn, \"Merit-Amun\", i.e."}, "cross_references": [{"found_name": "Eve", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2086, "target_cluster_name": "Eve", "source_book": "llm_generated", "evidence_snippet": "Mary is a central female figure in Christianity, often contrasted with Eve in theological discussions about sin and redemption.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Mary is a central female figure in Christianity, often contrasted with Eve in theological discussions about sin and redemption.", "is_reverse": true}]}, {"canonical_name": "problem", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 8, "members": [{"entity_id": "problems", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Problems", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Problems"], "contexts": ["Aristotle's collection of questions", "Aristotle's work on scientific questions"]}, {"entity_id": "problem", "book_id": "principles_of_psychology_james_1890", "name": "problem", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["problem"], "contexts": ["unresolved question or difficulty", "intellectual challenge to find means"]}, {"entity_id": "problem_", "book_id": "polyanthea_medicinal", "name": "Problem.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Problem."], "contexts": ["section of a text"]}, {"entity_id": "problem", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Problem", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Problem"], "contexts": ["mathematical or scientific challenge"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646"