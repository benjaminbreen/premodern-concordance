arity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "frutas", "target_book": "first_principles_spencer_1862", "target_name": "fruits", "similarity": 0.975}, {"source_book": "polyanthea_medicinal", "source_name": "frutas", "target_book": "first_principles_spencer_1862", "target_name": "fruits", "similarity": 0.975}], "id": 72, "stable_key": "clu_861d10371984881f", "ground_truth": {"modern_name": "fruit", "confidence": "high", "type": "plant", "note": "The term 'frutas'/'fruits' is general and refers to the edible product of plants, not a specific species.", "wikidata_id": "Q3314483", "wikidata_description": "typically sweet and/or sour, edible part/s of a plant that resembles seed-bearing fruit", "wikipedia_url": "https://en.wikipedia.org/wiki/Fruit", "wikipedia_extract": "In botany, a fruit is the seed-bearing structure in flowering plants (angiosperms) that is formed from the ovary after flowering. Fruits are the means by which angiosperms disseminate their seeds. Edible fruits in particular have long propagated using the movements of humans and other animals in a symbiotic relationship that is the means for seed dispersal for the one group and nutrition for the other; humans, and many other animals, have become dependent on fruits as a source of food. Consequently, fruits account for a substantial fraction of the world's agricultural output, and some (such as the apple and the pomegranate) have acquired extensive cultural and symbolic meanings. In common language and culinary usage, fruit normally means the seed-associated fleshy structures (or produce) of plants that typically are sweet (or sour) and edible in the raw state, such as apples, bananas, grapes, lemons, oranges, and strawberries. In botanical usage, the term fruit also includes many structures that are not commonly called as such in everyday language, such as nuts, bean pods, corn kernels, tomatoes, and wheat grains."}, "member_count": 9, "cross_references": [{"found_name": "guoma", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2057, "target_cluster_name": "Gomme", "source_book": "coloquios_da_orta_1563", "evidence_snippet": "dos cardos, sacudindo com pao, e sam mais grandes que coentros secos os grãos; e a cor, como vos dixe, entre roxa e vermelha. O vulgo tem que isto he fruto, mas eu soube que era guoma ou resina: elles", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "alternative name for what the vulgo considers fruit"}, {"found_name": "resina", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2624, "target_cluster_name": "resina", "source_book": "coloquios_da_orta_1563", "evidence_snippet": "dos cardos, sacudindo com pao, e sam mais grandes que coentros secos os grãos; e a cor, como vos dixe, entre roxa e vermelha. O vulgo tem que isto he fruto, mas eu soube que era guoma ou resina: elles", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "alternative name for what the vulgo considers fruit"}, {"found_name": "afinin o", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1831, "target_cluster_name": "Coloquintida", "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "qualità csida óc fecca in terzo grado attribuitali dagl'Arabi . Però fi vii iUuo luccidanco. DELL'ELATERIO. L*E L A T E R I o é il fugo canato del frutto del cocomero faluatico detto afinino piata not", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for cocomero faluatico"}, {"found_name": "Vegetation", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 2157, "target_cluster_name": "Vegetation", "source_book": "llm_generated", "evidence_snippet": "Spanish for 'fruit', a product of plant life.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "reverse: Spanish for 'fruit', a product of plant life.", "is_reverse": true}, {"found_name": "Flowering plants", "