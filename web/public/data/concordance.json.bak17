, {"entity_id": "olhos_mui_sumidos", "book_id": "coloquios_da_orta_1563", "name": "olhos mui sumidos", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["olhos mui sumidos"], "contexts": ["symptom of the illness"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "dim Eyes", "target_book": "coloquios_da_orta_1563", "target_name": "olhos mui sumidos", "similarity": 0.919}], "id": 3940, "stable_key": "clu_2cb02e74d1d141cd", "ground_truth": {"modern_name": "Dimness of vision", "confidence": "high", "type": "disease", "modern_term": "Vision impairment", "note": "Both 'dim Eyes' and 'olhos mui sumidos' refer to a condition characterized by reduced or obscured vision.", "wikidata_id": "Q2138853", "wikidata_description": "medical rehabilitation measures to improve vision"}, "cross_references": []}, {"canonical_name": "Resurrection", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "resurrection", "book_id": "english_physician_1652", "name": "Resurrection", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Resurrection"], "contexts": ["religious concept"]}, {"entity_id": "resurrection", "book_id": "principles_of_psychology_james_1890", "name": "resurrection", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["resurrection"], "contexts": ["revival from death"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Resurrection", "target_book": "principles_of_psychology_james_1890", "target_name": "resurrection", "similarity": 0.977}], "id": 3941, "stable_key": "clu_9d46324f766794bf", "ground_truth": {"modern_name": "Resurrection", "confidence": "high", "type": "concept", "note": "This refers to the religious or metaphorical concept of revival from death, not a medical phenomenon in itself."}, "cross_references": [{"found_name": "dissolve", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1327, "target_cluster_name": "dissolve", "source_book": "llm_generated", "evidence_snippet": "Pralaya, the dissolution of the universe, is often followed by a renewal or recreation, conceptually similar to a resurrection.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Pralaya, the dissolution of the universe, is often followed by a renewal or recreation, conceptually similar to a resurrection.", "is_reverse": true}]}, {"canonical_name": "Salisbury", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "salisbury", "book_id": "english_physician_1652", "name": "Salisbury", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Salisbury"], "contexts": ["city near Alderbury"]}, {"entity_id": "salisbury", "book_id": "principles_of_psychology_james_1890", "name": "Salisbury", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Salisbury"], "contexts": ["location of publication"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Salisbury", "target_book": "principles_of_psychology_james_1890", "target_name": "Salisbury", "similarity": 1.0}], "id": 3942, "stable_key": "clu_20ad3701727f182c", "ground_truth": {"wikipedia_extract": "Salisbury ( SAWLZ-bər-ee, locally  SAWZ-bər-ee) is a cathedral city and civil parish in Wiltshire, England with a population of 41,820, at the confluence of the rivers Avon, Nadder and Bourne. The city is approximately 20 miles (30 kilometres) from Southampton and 30 miles (50 kilometres) from Bath. Salisbury is in the southeast of Wiltshire, near the edge of Salisbury Plain. An ancient cathedral was north of the present city at Old Sarum. A new cathedral was built near the meeting of the rivers and a settlement grew up around it, which received a city charter in 1227 as New Sarum. This continued to be its official name until 2009, when Salisbury City Council was established."}, "cross_references": []}, {"canonical_name": "Salt tast", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "salt_tast", "book_id": "english_physician_1652", "name": "Salt tast", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["Salt tast"], "contexts": ["taste of English Scurvey-grass"]}, {"entity_id": "gosto_de_sal", "book_id": "coloquios_da_orta_1563", "name": "gosto de sal", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["gosto de sal"], "contexts": ["taste of salt"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Salt tast", "target_book": "coloquios_da_orta_1563", "target_name": "gosto de sal", "similarity": 0.95}], "id": 3943, "stable_key": "clu_e636201dc48f1eea", "ground_truth": {"modern_name": "Salty taste", "confidence": "high", "type": "concept", "wikidata_id": "Q22243806", "wikidata_description": "Combining with soluble salty compounds to initiate a change in cell activity. These receptors are responsible for the sense of salty taste.", "wikipedia_extract": "Brigitte Anne-Marie Bardot (French: [bʁiʒit anmaʁi baʁdo]; 28 September 1934 – 28 December 2025), often referred to by her initials B.B., was a French actress, singer, model, and animal rights activist. She became one of the best-known symbols of the sexual revolution and gained international fame for portraying characters associated with hedonistic lifestyles. Although she withdrew from the entertainment industry in 1973, she remained a major pop culture icon. She appeared in 47 films, performed in several musicals, and recorded more than 60 songs. She was awarded the Legion of Honour in 1985. Born and raised in Paris, Bardot was an aspiring ballerina during her childhood.", "wikipedia_url": "https://en.wikipedia.org/wiki/Brigitte_Bardot"}, "cross_references": []}, {"canonical_name": "smooth", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "t