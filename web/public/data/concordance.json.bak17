n", "similarity": 1.0}], "id": 2845, "stable_key": "clu_e0afb82006cd2722", "ground_truth": {"modern_name": "organic vs inorganic matter", "confidence": "high", "type": "concept", "note": "This cluster refers to the distinction between living (organic) and non-living (inorganic) matter, a fundamental concept in early modern science and philosophy."}, "cross_references": [{"found_name": "Evolution", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 540, "target_cluster_name": "Evolution", "source_book": "llm_generated", "evidence_snippet": "The concept of organic matter was intrinsically linked to theories of life and its development, making evolution a closely related concept.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The concept of organic matter was intrinsically linked to theories of life and its development, making evolution a closely related concept."}]}, {"canonical_name": "radius", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "radius", "book_id": "kosmos_humboldt_1845", "name": "radius", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["radius"], "contexts": ["distance from center to edge of a circle"]}, {"entity_id": "radius", "book_id": "connexion_physical_sciences_somerville_1858", "name": "radius", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["radius"], "contexts": ["distance from center to edge", "line from center to circumference of circle"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "radius", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "radius", "similarity": 1.0}], "id": 2846, "stable_key": "clu_f39d594c564bf890", "ground_truth": {"modern_name": "radius", "confidence": "high", "type": "concept", "note": "While 'radius' is a geometric term, its use in relation to 'distance from center to edge' suggests a concept