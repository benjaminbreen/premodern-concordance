bcategory": "OTHER_CONCEPT", "count": 1, "variants": ["health"], "contexts": ["state of being free from illness"]}, {"entity_id": "health", "book_id": "principles_of_psychology_james_1890", "name": "health", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["health"], "contexts": ["state of being free from illness", "state of well-being"]}, {"entity_id": "salud", "book_id": "historia_medicinal_monardes_1574", "name": "salud", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["salud", "salud corporal"], "contexts": ["health desired by the father", "state of being well"]}, {"entity_id": "saúde", "book_id": "coloquios_da_orta_1563", "name": "saúde", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["saúde"], "contexts": ["state of well-being"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "health", "target_book": "origin_of_species_darwin_1859", "target_name": "health", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "health", "target_book": "principles_of_psychology_james_1890", "target_name": "health", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "health", "target_book": "historia_medicinal_monardes_1574", "target_name": "salud", "similarity": 0.968}, {"source_book": "english_physician_1652", "source_name": "health", "target_book": "coloquios_da_orta_1563", "target_name": "saúde", "similarity": 0.972}, {"source_book": "origin_of_species_darwin_1859", "source_name": "health", "target_book": "principles_of_psychology_james_1890", "target_name": "health", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "health", "target_book": "historia_medicinal_monardes_1574", "target_name": "salud", "similarity": 0.968}, {"source_book": "origin_of_species_darwin_1859", "source_name": "health", "target_book": "coloquios_da_orta_1563", "target_name": "saúde", "similarity": 0.972}, {"source_book": "principles_of_psychology_james_1890", "source_name": "health", "target_book": "historia_medicinal_monardes_1574", "target_name": "salud", "similarity": 0.968}, {"source_book": "principles_of_psychology_james_1890", "source_name": "health", "target_book": "coloquios_da_orta_1563", "target_name": "saúde", "similarity": 0.972}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "salud", "target_book": "coloquios_da_orta_1563", "target_name": "saúde", "similarity": 0.993}], "id": 152, "stable_key": "clu_f9be01a7b86dc130", "ground_truth": {"modern_name": "Health", "confidence": "high", "type": "concept", "note": "The terms 'salud', 'saúde', and 'health' in the provided contexts clearly refer to the state of well-being and absence of disease.", "wikidata_id": "Q189603", "wikidata_description": "science and art of preventing disease, prolonging life and promoting health through organized efforts and informed choices of society, organizations, public and private, communities and individuals", "wikipedia_url": "https://en.wikipedia.org/wiki/Public%20health", "wikipedia_extract": "Public health is \"the science and art of preventing disease, prolonging life and promoting health through the organized efforts and informed choices of society, organizations, public and private, communities and individuals\". Analyzing the determinants of health of a population and the threats it faces is the basis for public health. The public can be as small as a handful of people or as large as a village or an entire city; in the case of a pandemic it may encompass several continents. The concept of health takes into account physical, psychological, and social well-being, among other factors. Public health is an interdisciplinary field. For example, epidemiology, biostatistics, social sciences and management of health services are all relevant."}, "cross_references": [{"found_name": "Hygiene", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4293, "target_cluster_name": "hygiene", "source_book": "llm_generated", "evidence_snippet": "Hygiene is the practice or science of maintaining health and preventing disease, directly related to the concept of health itself.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Hygiene is the practice or science of maintaining health and preventing disease, directly related to the concept of health itself."}, {"found_name": "Astrological medicine", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 569, "target_cluster_name": "astrological medicine", "source_book": "llm_generated", "evidence_snippet": "Historical medical practices often linked health and disease to astrological influences, making this a related concept in premodern thought.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Historical medical practices often linked health and disease to astrological influences, making this a related concept in premodern thought."}, {"found_name": "dieta", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1390, "target_cluster_name": "dieta", "source_book": "llm_generated", "evidence_snippet": "Dietary regimen is a key factor in maintaining or improving health.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Dietary regimen is a key factor in maintaining or improving health.", "is_reverse": true}]}, {"canonical_name": "Acacia", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 5, "total_mentions": 15, "members": [{"entity_id": "acacia", "book_id": "english_physician_1652", "name": "Acacia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Acacia"], "contexts": ["used for binding effect"]}, {"entity_id": "acacia_cornigera", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Acacia cornigera", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Acacia cornigera"], "contexts": ["bush with strong thorns"]}, {"entity_id": "acácia", "book_id": "coloquios_da_orta_1563", "name": "acácia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["acácia"], "contexts": ["substance sometimes used to falsify aloés", "used in preparation of Aloes"]}, {"entity_id": "acacia", "book_id": "ricettario_fiorentino_1597", "name": "Acacia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["Acacia", "acacia"], "contexts": ["Acacia, a plant discussed", "a shrub described by Dioscorides"]}, {"entity_id": "acacia", "book_id": "polyanthea_medicinal", "name": "acacia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Acacia", "acacia"], "contexts": ["gum resin", "ingredient in a repercussive plaster"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Acacia", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Acacia cornigera", "similarity": 0.917}, {"source_book": "english_physician_1652", "source_name": "Acacia", "target_book": "coloquios_da_orta_1563", "target_name": "acácia", "similarity": 0.859}, {"source_book": "english_physician_1652", "source_name": "Acacia", "target_book": "ricettario_fiorentino_1597", "target_name": "Acacia", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Acacia", "target_book": "polyanthea_medicinal", "target_name": "acacia", "similarity": 0.935}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Acacia cornigera", "target_book": "ricettario_fiorentino_1597", "target_name": "Acacia", "similarity": 0.917}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Acacia cornigera", "target_book": "polyanthea_medicinal", "target_name": "acacia", "similarity": 0.898}, {"source_book": "coloquios_da_orta_1563", "source_name": "acácia", "target_book": "ricettario_fiorentino_1597", "target_name": "Acacia", "similarity": 0.859}, {"source_book": "coloquios_da_orta_1563", "source_name": "acácia", "target_book": "polyanthea_medicinal", "target_name": "acacia", "similarity": 0.831}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Acacia", "target_book": "polyanthea_medicinal", "target_name": "acacia", "similarity": 0.935}], "id": 153, "stable_key": "clu_bd0b56252ec280b4", "ground_truth": {"modern_name": "Acacia", "confidence": "high", "type": "plant", "linnaean": "Acacia Miller", "family": "Fabaceae", "note": "The mentions of 'Acacia', 'Acacia cornigera', and 'acácia' across different texts strongly indicate the genus Acacia, with specific mentions of a species known for its thorns.", "wikidata_id": "Q81666", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Acacia", "wikipedia_extract": "Acacia, commonly known as wattles or acacias, is a genus of about 1,084 species of shrubs and trees in the subfamily Mimosoideae of the pea family Fabaceae. Initially, it comprised a group of plant species native to Africa, South America, and Australasia, but is now reserved for species mainly from Australia, with others from New Guinea, Southeast Asia, and the Indian Ocean. The genus name is Neo-Latin, borrowed from Koine Greek ἀκακία (akakia), a term used in antiquity to describe a preparation extracted from Vachellia nilotica, the original type species. Several species of Acacia have been introduced to various parts of the world, and two million hectares of commercial plantations have been established. Plants in the genus Acacia are shrubs or trees with bipinnate leaves, the mature leaves sometimes reduced to phyllodes or rarely absent. There are 2 small stipules at the base of the leaf, but sometimes fall off as the leaf matures."}, "cross_references": [{"found_name": "gommai Arabica", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2239, "target_cluster_name": "goma", "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "il quale è inferiore al fopra detto. Da qnefta pianta nafce vna gomma , la quale fi crede per alcuni , che ella fia la gommai Arabica . Ij fugo dell'Acacia infino a hora(che noi lappia- mo ) non e fta", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "believed to be the same as the gum from the plant"}, {"found_name": "Fabaceae", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2184, "target_cluster_name": "Leguminosa", "source_book": "llm_generated", "evidence_snippet": "Acacia is a genus within the pea family, Fabaceae.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Acacia is a genus within the pea family, Fabaceae."}, {"found_name": "goma", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2239, "target_cluster_name": "goma", "source_book": "llm_generated", "evidence_snippet": "Gum arabic is the hardened sap of Acacia trees, specifically species like Acacia senegal.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Gum arabic is the hardened sap of Acacia trees, specifically species like Acacia senegal.", "is_reverse": true}]}, {"canonical_name": "leaves", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 6, "total_mentions": 17, "members": [{"entity_id": "leaves", "book_id": "origin_of_species_darwin_1859", "name": "leaves", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["leaves"], "contexts": ["part of a plant", "plant part subject to variation"]}, {"entity_id": "leaves", "book_id": "principles_of_psychology_james_1890", "name": "leaves", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["leaves"], "contexts": ["feature of a flower"]}, {"entity_id": "leaves", "book_id": "polyanthea_medicinal", "name": "leaves", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["leaves"], "contexts": ["plant part used in remedies"]}, {"entity_id": "leaves_of_plants", "book_id": "connexion_physical_sciences_somerville_1858", "name": "leaves of plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["leaves of plants"], "contexts": ["objects accurately delineated", "objects for photographic impressions"]}, {"entity_id": "leaves", "book_id": "first_principles_spencer_1862", "name": "leaves", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["leaves"], "contexts": ["part of plant structure", "light plant parts affected by air resistance"]}, {"entity_id": "green_leaves", "book_id": "english_physician_1652", "name": "green Leaves", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["green Leaves"], "contexts": ["fresh Thoroughwax leaves"]}, {"entity_id": "green_leaves", "book_id": "principles_of_psychology_james_1890", "name": "green leaves", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["green leaves"], "contexts": ["visual cue for spring"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "leaves", "target_book": "principles_of_psychology_james_1890", "target_name": "leaves", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "leaves", "target_book": "polyanthea_medicinal", "target_name": "leaves", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "leaves", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "leaves of plants", "similarity": 0.956}, {"source_book": "origin_of_species_darwin_1859", "source_name": "leaves", "target_book": "first_principles_spencer_1862", "target_name": "leaves", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "leaves", "target_book": "polyanthea_medicinal", "target_name": "leaves", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "leaves", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "leaves of plants", "similarity": 0.956}, {"source_book": "principles_of_psychology_james_1890", "source_name": "leaves", "target_book": "first_principles_spencer_1862", "target_name": "leaves", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "leaves", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "leaves of plants", "similarity": 0.956}, {"source_book": "polyanthea_medicinal", "source_name": "leaves", "target_book": "first_principles_spencer_1862", "target_name": "leaves", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "leaves of plants", "target_book": "first_principles_spencer_1862", "target_name": "leaves", "similarity": 0.956}], "id": 154, "stable_key": "clu_734c2181177ed93c", "ground_truth": {"modern_name": "Leaves", "confidence": "high", "type": "plant", "note": "General term for a plant organ, not a specific species.", "wikidata_id": "Q33971", "wikidata_description": "main organ of photosynthesis and transpiration in higher plants, usually consisting of a flat green blade attached to the stem directly or by a stalk", "wikipedia_url": "https://en.wikipedia.org/wiki/Leaf", "wikipedia_extract": "A leaf (pl.: leaves) is a principal appendage of the stem of a vascular plant, usually borne laterally above ground and specialized for photosynthesis. Leaves are collectively called foliage, as in \"autumn foliage\", while the leaves, stem, flower, and fruit collectively form the shoot system. In most leaves, the primary photosynthetic tissue is the palisade mesophyll and is located on the upper side of the blade or lamina of the leaf, but in some species, including the mature foliage of Eucalyptus, palisade mesophyll is present on both sides and the leaves are said to be isobilateral. The leaf is an integral part of the stem system, and most leaves are flattened and have distinct upper (adaxial) and lower (abaxial) surfaces that differ in color, hairiness, the number of stomata (pores that intake and output gases), the amount and structure of epicuticular wax, and other features. Leaves are mostly green in color due to the presence of a compound called chlorophyll which is essential for photosynthesis as it absorbs light energy from the Sun. A leaf with lighter-colored or white patches or edges is called a variegated leaf."}, "member_count": 7, "cross_references": [{"found_name": "Root", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 536, "target_cluster_name": "Root", "source_book": "llm_generated", "evidence_snippet": "Leaves are the primary photosynthetic organs of a plant, and are directly connected to the stem, which in turn is connected to the root system.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Leaves are the primary photosynthetic organs of a plant, and are directly connected to the stem, which in turn is connected to the root system.", "is_reverse": true}, {"found_name": "freixo", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2632, "target_cluster_name": "freixo", "source_book": "llm_generated", "evidence_snippet": "Ash trees have leaves.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Ash trees have leaves.", "is_reverse": true}, {"found_name": "vegetable matter", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2832, "target_cluster_name": "vegetable matter", "source_book": "llm_generated", "evidence_snippet": "Leaves are a specific part of plant matter.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Leaves are a specific part of plant matter.", "is_reverse": true}]}, {"canonical_name": "friction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 15, "members": [{"entity_id": "friction", "book_id": "kosmos_humboldt_1845", "name": "friction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["friction"], "contexts": ["resistance to motion between surfaces", "rubbing surfaces together"]}, {"entity_id": "fricção", "book_id": "coloquios_da_orta_1563", "name": "fricção", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["fricção"], "contexts": ["action that electrizes diamonds"]}, {"entity_id": "frictiones", "book_id": "polyanthea_medicinal", "name": "frictiones", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["frictiones"], "contexts": ["treatment for Angina"]}, {"entity_id": "friction", "book_id": "connexion_physical_sciences_somerville_1858", "name": "friction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["friction"], "contexts": ["interaction causing storm axis bend", "resistance to motion between surfaces"]}, {"entity_id": "friction", "book_id": "first_principles_spencer_1862", "name": "friction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["friction"], "contexts": ["resistance to motion between surfaces", "resistance to motion"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "friction", "target_book": "coloquios_da_orta_1563", "target_name": "fricção", "similarity": 0.968}, {"source_book": "kosmos_humboldt_1845", "source_name": "friction", "target_book": "polyanthea_medicinal", "target_name": "frictiones", "similarity": 0.95}, {"source_book": "kosmos_humboldt_1845", "source_name": "friction", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "friction", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "friction", "target_book": "first_principles_spencer_1862", "target_name": "friction", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "fricção", "target_book": "polyanthea_medicinal", "target_name": "frictiones", "similarity": 0.934}, {"source_book": "coloquios_da_orta_1563", "source_name": "fricção", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "friction", "similarity": 0.968}, {"source_book": "coloquios_da_orta_1563", "source_name": "fricção", "target_book": "first_principles_spencer_1862", "target_name": "friction", "similarity": 0.968}, {"source_book": "polyanthea_medicinal", "source_name": "frictiones", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "friction", "similarity": 0.95}, {"source_book": "polyanthea_medicinal", "source_name": "frictiones", "target_book": "first_principles_spencer_1862", "target_name": "friction", "similarity": 0.95}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "friction", "target_book": "first_principles_spencer_1862", "target_name": "friction", "similarity": 1.0}], "id": 155, "stable_key": "clu_1c9d26dc239a22f8", "ground_truth": {"modern_name": "friction", "confidence": "high", "type": "concept", "wikidata_id": "Q82580", "wikidata_description": "force resisting the relative motion of solid surfaces, fluid layers, and material elements sliding against each other", "wikipedia_url": "https://en.wikipedia.org/wiki/Friction", "wikipedia_extract": "Friction is the force resisting the relative motion of solid surfaces, fluid layers, and material elements sliding or grinding against each other. Types of friction include dry, fluid, lubricated, skin, and internal – an incomplete list. The study of the processes involved is called tribology, and has a history of more than 2,000 years. Friction can have dramatic consequences, as illustrated by the use of friction created by rubbing pieces of wood together to start a fire. Another important consequence of many types of friction can be wear, which may lead to performance degradation or damage to components. It is known that frictional energy losses account for about 20% of the total energy expenditure of the world."}, "cross_references": [{"found_name": "Action and reaction", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 961, "target_cluster_name": "Action and reaction", "source_book": "llm_generated", "evidence_snippet": "Friction is a force that directly opposes motion, and Newton's third law of motion (action and reaction) is fundamental to understanding how forces, including friction, interact between surfaces.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Friction is a force that directly opposes motion, and Newton's third law of motion (action and reaction) is fundamental to understanding how forces, including friction, interact between surfaces."}, {"found_name": "Attraction (physics)", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4186, "target_cluster_name": "attractions", "source_book": "llm_generated", "evidence_snippet": "Friction is a type of contact force that arises from the interactions between surfaces, which can be understood in the context of attractive forces at the molecular level.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Friction is a type of contact force that arises from the interactions between surfaces, which can be understood in the context of attractive forces at the molecular level."}, {"found_name": "Centrifugal force", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 315, "target_cluster_name": "Centrifugal force", "source_book": "llm_generated", "evidence_snippet": "Both friction and centrifugal force are concepts related to motion and the forces that resist or are generated by it. Understanding one can inform the understanding of the other in mechanical systems.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both friction and centrifugal force are concepts related to motion and the forces that resist or are generated by it. Understanding one can inform the understanding of the other in mechanical systems."}, {"found_name": "Cohesive force", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2484, "target_cluster_name": "cohesive force", "source_book": "llm_generated", "evidence_snippet": "Friction between surfaces is partly due to the cohesive forces between the molecules of the materials in contact.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Friction between surfaces is partly due to the cohesive forces between the molecules of the materials in contact."}, {"found_name": "Conduction", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2567, "target_cluster_name": "conduction", "source_book": "llm_generated", "evidence_snippet": "Friction generates heat, and heat transfer through conduction is a related physical process that occurs as a result of friction.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Friction generates heat, and heat transfer through conduction is a related physical process that occurs as a result of friction."}, {"found_name": "Cooling", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 720, "target_cluster_name": "cooling", "source_book": "llm_generated", "evidence_snippet": "While friction typically generates heat, the concept of cooling is its inverse and is relevant when considering thermal equilibrium or the absence of frictional heating.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "While friction typically generates heat, the concept of cooling is its inverse and is relevant when considering thermal equilibrium or the absence of frictional heating."}, {"found_name": "Dry", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 38, "target_cluster_name": "dry", "source_book": "llm_generated", "evidence_snippet": "The candidate 'Dry' is listed as a type of friction in the description, indicating a direct relationship.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The candidate 'Dry' is listed as a type of friction in the description, indicating a direct relationship."}, {"found_name": "Elasticity", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 798, "target_cluster_name": "elasticity", "source_book": "llm_generated", "evidence_snippet": "The deformation of surfaces under pressure, which is related to friction, is governed by principles of elasticity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The deformation of surfaces under pressure, which is related to friction, is governed by principles of elasticity."}]}, {"canonical_name": "Democrito", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 5, "total_mentions": 14, "members": [{"entity_id": "democritus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Democritus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 4, "variants": ["Democritus"], "contexts": ["ancient Greek philosopher, known for laughter", "ancient Greek philosopher"]}, {"entity_id": "democritus", "book_id": "kosmos_humboldt_1845", "name": "Democritus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Democritus"], "contexts": ["ancient Greek philosopher"]}, {"entity_id": "democrito", "book_id": "historia_medicinal_monardes_1574", "name": "Democrito", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Democrito"], "contexts": ["ancient philosopher on metal origins"]}, {"entity_id": "democrito", "book_id": "ricettario_fiorentino_1597", "name": "Democrito", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Democrito"], "contexts": ["ancient philosopher"]}, {"entity_id": "democrito", "book_id": "polyanthea_medicinal", "name": "Democrito", "category": "PERSON", "subcategory": "AUTHORITY", "count": 7, "variants": ["Democrito", "Democrit.", "Democrite", "Democritus"], "contexts": ["an