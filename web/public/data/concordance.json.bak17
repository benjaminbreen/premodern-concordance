": "family name"}, "cross_references": []}, {"canonical_name": "Cabrera", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "cabrera", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cabrera", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Cabrera"], "contexts": ["interpreted indigenous words"]}, {"entity_id": "cabreir", "book_id": "polyanthea_medicinal", "name": "Cabreir", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Cabreir"], "contexts": ["author of Compend. var. remed."]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cabrera", "target_book": "polyanthea_medicinal", "target_name": "Cabreir", "similarity": 0.868}], "id": 4112, "stable_key": "clu_2a656180b921ae2c", "ground_truth": {"modern_name": "Cabrera", "confidence": "high", "type": "person", "description": "Author of medical compendium, interpreter of indigenous words.", "note": "Likely refers to a specific scholar, but the exact individual requires further context from the source texts.", "wikidata_id": "Q5914784", "wikidata_description": "Spanish noble family"}, "cross_references": []}, {"canonical_name": "fort", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "fort", "book_id": "relation_historique_humboldt_vol3_1825", "name": "fort", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["fort"], "contexts": ["defensive structure"]}, {"entity_id": "fortaleza", "book_id": "coloquios_da_orta_1563", "name": "fortaleza", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["fortaleza"], "contexts": ["military structure"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "fort", "target_book": "coloquios_da_orta_1563", "target_name": "fortaleza", "similarity": 0.931}], "id": 4113, "stable_key": "clu_aec5106c43dd5375", "ground_truth": {"wikipedia_extract": "A fortification (also called a fort, fortress, fastness, or stronghold) is a military construction designed for the defense of territories in warfare, and is used to establish rule in a region during peacetime. The term is derived from Latin fortis (\"strong\") and facere (\"to make\"). From very early history to modern times, defensive walls have often been necessary for cities to survive in an ever-changing world of invasion and conquest. Some settlements in the Indus Valley Civilization were the first small cities to be fortified. In ancient Greece, large cyclopean stone walls fitted without mortar had been built in Mycenaean Greece, such as the ancient site of Mycenae. A Greek phrourion was a fortified collection of buildings used as a military garrison, and is the equivalent of the Roman castellum or fortress."}, "cross_references": []}, {"canonical_name": "pecado", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "pecado", "book_id": "relation_historique_humboldt_vol3_1825", "name": "pecado", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["pecado"], "contexts": ["religious concept"]}, {"entity_id": "pecado", "book_id": "polyanthea_medicinal", "name": "pecado", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["pecado"], "contexts": ["sin, a moral concept"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "pecado", "target_book": "polyanthea_medicinal", "target_name": "pecado", "similarity": 1.0}], "id": 4114, "stable_key": "clu_2d4e8ff875b9525a", "ground_truth": {"wikipedia_extract": "Pecado is a monotypic genus of dwarf spiders containing the single species, Pecado impudicus. It was first described by G. Hormiga & N. Scharff in 2005, and has only been found in Spain, Morocco, and Algeria."}, "cross_references": []}, {"canonical_name": "peines", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "peines", "book_id": "relation_historique_humboldt_vol3_1825", "name": "peines", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["peines"], "contexts": ["punishments or suffering"]}, {"entity_id": "punishment", "book_id": "first_principles_spencer_1862", "name": "punishment", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["punishment"], "contexts": ["consequence for wrongdoing"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "peines", "target_book": "first_principles_spencer_1862", "target_name": "punishment", "similarity": 0.889}], "id": 4115, "stable_key": "clu_87396b209347d5fd", "ground_truth": {"modern_name": "punishment", "confidence": "high", "type": "concept", "note": "The term 'peines' also has a broader meaning of suffering or hardship, but in the context of 'consequence for wrongdoing', punishment is the most fitting.", "wikidata_id": "Q3544090", "wikidata_description": "facet of operant conditioning; change in a human or animal's surroundings that occurs after a given behavior or response which reduces the likelihood of that behavior occurring again in the future"}, "cross_references": []}, {"canonical_name": "magistrat", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "magistrat", "book_id": "relation_historique_humboldt_vol3_1825", "name": "magistrat", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["magistrat"], "contexts": ["official to whom a slave can appeal"]}, {"entity_id": "magistrate", "book_id": "principles_of_psychology_james_1890", "name": "magistrate", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["magistrate"], "contexts": ["civil authority figure"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "magistrat", "target_book": "principles_of_psychology_james_1890", "target_name": "magistrate", "similarity": 0.99}], "id": 4116, "stable_key": "clu_00db6ea671606faa", "ground_truth": {"modern_name": "magistrate", "confidence": "high", "type": "person", "description": "Civil authority figure, often with judicial or administrative powers.", "wikidata_id": "Q16533", "wikidata_description": "official who presides over court proceedings"}, "cross_references": []}, {"canonical_name": "nations de l'Europe", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "nations_de_l'europe", "book_id": "relation_historique_humboldt_vol3_1825", "name": "nations de l'Europe", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["nations de l'Europe"], "contexts": ["European nations, in the context of civilization"]}, {"entity_id": "european_nations", "book_id": "first_principles_spencer_1862", "name": "European nations", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["European nations"], "contexts": ["countries in Europe"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "nations de l'Europe", "target_book": "first_principles_spencer_1862", "target_name": "European nations", "similarity": 0.966}], "id": 4117, "stable_key": "clu_dadb1f29bc7bab0a", "ground_truth": {"modern_name": "European nations", "confidence": "high", "type": "place", "country": "Europe", "wikidata_id": "Q1467826", "wikidata_description": "rugby union European championship"}, "cross_references": []}, {"canonical_name": "gain", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "gain", "book_id": "relation_historique_humboldt_vol3_1825", "name": "gain", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["gain"], "contexts": ["profit or advantage"]}, {"entity_id": "gain", "book_id": "first_principles_spencer_1862", "name": "gain", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["gain"], "contexts": ["act of acquiring something"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "gain", "target_book": "first_principles_spencer_1862", "target_name": "gain", "similarity": 1.0}], "id": 4118, "stable_key": "clu_ca862793708183b8", "ground_truth": {"modern_name": "gain", "confidence": "high", "type": "concept", "wikidata_id": "Q3403879", "wikidata_description": "increase in a person's total body mass"}, "cross_references": []}, {"canonical_name": "Chio", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "chio", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Chio", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Chio"], "contexts": ["location of massacres"]}, {"entity_id": "chio", "book_id": "historia_medicinal_monardes_1574", "name": "Chio", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Chio"], "contexts": ["island where Almaciga grows"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Chio", "target_book": "historia_medicinal_monardes_1574", "target_name": "Chio", "similarity": 0.711}], "id": 4119, "stable_key": "clu_725f6c7ababa4811", "ground_truth": {"modern_name": "Chios", "confidence": "high", "type": "place", "country": "Greece", "wikidata_id": "Q160483", "wikidata_description": "Greek island situated in the Aegean Sea"}, "cross_references": []}, {"canonical_name": "Mozambique", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "mozambique", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Mozambique", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Mozambique"], "contexts": ["city in Mozambique"]}, {"entity_id": "mozambique", "book_id": "coloquios_da_orta_1563", "name": "Mozambique", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Mozambique"], "contexts": ["port city, geographical reference"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Mozambique", "target_book": "coloquios_da_orta_1563", "target_name": "Mozambique", "similarity": 1.0}], "id": 4120, "stable_key": "clu_4d8b2410793434bf", "ground_truth": {"modern_name": "Mozambique", "confidence": "low", "type": "place", "description": "Port city and coastal location, also a river and islands.", "note": "This cluster appears to conflate several distinct geographical locations including the city/country of Mozambique, the Moluccas islands, and a river named Motagua.", "wikipedia_extract": "Mozambique, officially the Republic of Mozambique, is a country located in Southeast Africa bordered by the Indian Ocean to the east, Tanzania to the north, Malawi and Zambia to the northwest, Zimbabwe to the west, and Eswatini and South Africa to the south and southwest. The sovereign state is separated from the Comoros, Mayotte, and Madagascar through the Mozambique Channel to the east. The capital and largest city is Maputo. Between the 7th and 11th centuries, a series of Swahili port towns developed in the area, which contributed to the development of a distinct Swahili culture and dialect. In the late medieval period, these towns were frequented by traders from Somalia, Ethiopia, Egypt, Arabia, Persia, and India. The voyage of Vasco da Gama in 1498 marked the arrival of the Portuguese, who began a gradual process of colonisation and settlement in 1505."}, "cross_references": []}, {"canonical_name": "Isabelle", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "isabelle", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Isabelle", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Isabelle"], "contexts": ["queen addressed by Columbus"]}, {"entity_id": "queen_isabella", "book_id": "kosmos_humboldt_1845", "name": "Queen Isabella", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Queen Isabella"], "contexts": ["recipient of Columbus's letter"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Isabelle", "target_book": "kosmos_humboldt_1845", "target_name": "Queen Isabella", "similarity": 0.947}], "id": 4121, "stable_key": "clu_2f713c7980a05454", "ground_truth": {"modern_name": "Isabella I of Castile", "confidence": "high", "type": "person", "birth_year": 1451, "death_year": 1504, "description": "Queen of Castile, patron of Columbus's voyages.", "wikidata_id": "Q45859", "wikidata_description": "queen of the Crown of Castile, from 1474 to 1504; first queen of a dynastically-united Spain, from 1479 to 1504 (1451–1504)", "wikipedia_url": "https://en.wikipedia.org/wiki/Isabella_I_of_Castile", "wikipedia_extract": "Isabella I (Spanish: Isabel I; also known as Isabella the Catholic Spanish: Isabel la Católica; 22 April 1451 – 26 November 1504) was Queen of Castile and León from 1474 until her death in 1504. She was also Queen of Aragon from 1479 until her death as the wife of King Ferdinand II. Reigning together over a dynastically unified Spain, Isabella and Ferdinand are known as the Catholic Monarchs. Her reign marked the end of the Reconquista and also the start of the Spanish Empire, allowing Spain to dominate European politics for the next century. Isabella's marriage to Ferdinand of Aragon in 1469 created the basis of the de facto unification of Spain. With Ferdinand's help, she won the War of the Castilian Succession, securing her position as Queen of Castile."}, "cross_references": [{"found_name": "S. M.C.", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2767, "target_cluster_name": "S. M.C.", "source_book": "llm_generated", "evidence_snippet": "Philip II of Spain was the son of Isabella I of Castile and Ferdinand II of Aragon, and she was a significant figure in his early life and reign.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Philip II of Spain was the son of Isabella I of Castile and Ferdinand II of Aragon, and she was a significant figure in his early life and reign.", "is_reverse": true}]}, {"canonical_name": "cétacées herbivores", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "cétacées_herbivores", "book_id": "relation_historique_humboldt_vol3_1825", "name": "cétacées herbivores", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["cétacées herbivores"], "contexts": ["herbivorous marine mammals"]}, {"entity_id": "herbivores", "book_id": "first_principles_spencer_1862", "name": "Herbivores", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Herbivores"], "contexts": ["animals that eat plants"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "cétacées herbivores", "target_book": "first_principles_spencer_1862", "target_name": "Herbivores", "similarity": 0.892}], "id": 4122, "stable_key": "clu_b38d7efd6c9da61a", "ground_truth": {"modern_name": "herbivorous marine mammals", "confidence": "medium", "type": "animal", "note": "The term 'cétacées herbivores' is an oxymoron, as cetaceans are generally carnivorous. The context 'herbivorous marine mammals' suggests a misunderstanding or a specific, potentially erroneous, classification in the source text."}, "cross_references": []}, {"canonical_name": "Apis", "category": "ANIMAL", "subcategory": "INSECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "apis", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Apis", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["Apis"], "contexts": ["genus of bees"]}, {"entity_id": "apis", "book_id": "first_principles_spencer_1862", "name": "Apis", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Apis"], "contexts": ["deity represented by a bull"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Apis", "target_book": "first_principles_spencer_1862", "target_name": "Apis", "similarity": 0.783}], "id": 4123, "stable_key": "clu_cf2a8e2c3a2ac88f", "ground_truth": {"modern_name": "aphids", "confidence": "high", "type": "animal", "description": "Small, soft-bodied insects that feed on plant sap.", "note": "'Apis' refers to bees, while 'Aphides' (plural of Aphid) are a distinct group of insects. The context of 'plant-sucking insects' confirms 'aphids'.", "wikipedia_extract": "Aphids are small sap-sucking insects in the family Aphididae. Common names include greenfly and blackfly, although individuals within a species can vary widely in color. The group includes the fluffy white woolly aphids. A typical life cycle involves flightless females giving live birth to female nymphs—who may also be already pregnant, an adaptation scientists call telescoping generations—without the involvement of males. Maturing rapidly, females breed profusely so that the number of these insects multiplies quickly. Winged females may develop later in the season, allowing the insects to colonize new plants."}, "cross_references": []}, {"canonical_name": "Providence", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "providence", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Providence", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Providence"], "contexts": ["origin of corsairs"]}, {"entity_id": "providence", "book_id": "principles_of_psychology_james_1890", "name": "Providence", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Providence"], "contexts": ["city where money was drawn"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Providence", "target_book": "principles_of_psychology_james_1890", "target_name": "Providence", "similarity": 0.814}], "id": 4124, "stable_key": "clu_f2fe880228b2d138", "ground_truth": {"modern_name": "Providence", "confidence": "high", "type": "place", "country": "United States", "note": "The context 'city where money was drawn' strongly suggests Providence, Rhode Island, a significant port.", "wikidata_id": "Q18383", "wikidata_description": "capital city of Rhode Island, United States", "wikipedia_extract": "Providence ( ) is the capital and most populous city of the U.S. state of Rhode Island. It is the third-most populous city in New England with a population of 190,934 at the 2020 census, while the Providence metropolitan area extending into Massachusetts has approximately 1.7 million residents, the 39th-largest metropolitan area in the U.S. It is the county seat of Providence County. Providence is one of the oldest cities in New England, founded in 1636 by Reformed Baptist theologian Roger Williams, a religious exile from the Massachusetts Bay Colony. He named the area in honor of \"God's merciful Providence\" which he believed was responsible for revealing such a haven for him and his followers.", "wikipedia_url": "https://en.wikipedia.org/wiki/Providence,_Rhode_Island"}, "cross_references": []}, {"canonical_name": "Angle de hauteur", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "angle_de_hauteur", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Angle de hauteur", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Angle de hauteur"], "contexts": ["measurement of elevation"]}, {"entity_id": "horizontal_angle", "book_id": "connexion_physical_sciences_somerville_1858", "name": "horizontal angle", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["horizontal angle"], "contexts": ["angle at earth's center"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Angle de hauteur", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "horizontal angle", "similarity": 0.899}], "id": 4125, "stable_key": "clu_6366ffa78eefaf7b", "ground_truth": {"modern_name": "angle of elevation", "confidence": "high", "type": "concept"}, "cross_references": []}, {"canonical_name": "Piazzi", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "piazzi", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Piazzi", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Piazzi"], "contexts": ["astronomer whose catalogue was used"]}, {"entity_id": "piazzi", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Piazzi", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Piazzi"], "contexts": ["measured heat of the moon"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Piazzi", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Piazzi", "similarity": 0.739}], "id": 4126, "stable_key": "clu_c932ba3928f7c7b3", "ground_truth": {"modern_name": "Giuseppe Piazzi", "confidence": "high", "type": "person", "birth_year": 1746, "death_year": 1826, "description": "Italian astronomer who catalogued stars and studied heat from the moon."}, "cross_references": []}, {"canonical_name": "Maroc", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "maroc", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Maroc", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Maroc"], "contexts": ["country with sugar consumption"]}, {"entity_id": "marraecos", "book_id": "historia_medicinal_monardes_1574", "name": "Marraecos", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Marraecos"], "contexts": ["kings of Morocco"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Maroc", "target_book": "historia_medicinal_monardes_1574", "target_name": "Marraecos", "similarity": 0.887}], "id": 4127, "stable_key": "clu_a42b246752e77e5a", "ground_truth": {"modern_name": "Morocco", "confidence": "high", "type": "place", "country": "Morocco", "wikidata_id": "Q1028", "wikidata_description": "sovereign state in North Africa"}, "cross_references": []}, {"canonical_name": "zone", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "zone", "book_id": "relation_historique_humboldt_vol3_1825", "name": "zone", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["zone"], "contexts": ["latitudinal zone"]}, {"entity_id": "zone", "book_id": "connexion_physical_sciences_somerville_1858", "name": "zone", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["zone"], "contexts": ["stretching from Eta Argûs"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "zone", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "zone", "similarity": 1.0}], "id": 4128, "stable_key": "clu_ad26d79a5641a9fe", "ground_truth": {"modern_name": "Zone", "confidence": "high", "type": "concept", "note": "Refers to geographical or celestial zones, often related to latitude or temperature."}, "cross_references": [{"found_name": "temperate regions", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4008, "target_cluster_name": "temperate regions", "source_book": "llm_generated", "evidence_snippet": "Temperate is a type of climate zone.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Temperate is a type of climate zone.", "is_reverse": true}]}, {"canonical_name": "tiburones", "category": "ANIMAL", "subcategory": "FISH", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "tiburones", "book_id": "relation_historique_humboldt_vol3_1825", "name": "tiburones", "category": "ANIMAL", "subcategory": "FISH", "count": 1, "variants": ["tiburones"], "contexts": ["Spanish word for sharks"]}, {"entity_id": "tiburon", "book_id": "historia_medicinal_monardes_1574", "name": "Tiburon", "category": "ANIMAL", "subcategory": "FISH", "count": 1, "variants": ["Tiburon"], "contexts": ["large, strong, and warlike fish in the Indies"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "tiburones", "target_book": "historia_medicinal_monardes_1574", "target_name": "Tiburon", "similarity": 0.936}], "id": 4129, "stable_key": "clu_b91dbcaddfc56818", "ground_truth": {"wikipedia_extract": "\"Tiburones\" (transl. \"Sharks\") is a song recorded by Puerto Rican singer Ricky Martin for his first extended play, Pausa (2020). The song was written by Oscar Hernandez and Pablo Preciado, while the production was handled by Julio Reyes Copello. The song was released for digital download and streaming by Sony Music Latin on January 23, 2020, as the second single from the extended play. A Spanish language ballad and Latin pop song, it is about the importance of peace, love and unity. It received positive reviews from music critics, who complimented its lyrics. \"Tiburones\" was nominated for Song of the Year at the 21st Annual Latin Grammy Awards. The song was commercially successful in Latin America, reaching number one in Argentina and Puerto Rico, as well as the top 10 in eight other Latin American countries."}, "cross_references": [{"found_name": "Fish", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 94, "target_cluster_name": "Fish", "source_book": "llm_generated", "evidence_snippet": "Tiburones is Spanish for sharks, which are a type of fish.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Tiburones is Spanish for sharks, which are a type of fish.", "is_reverse": true}]}, {"canonical_name": "observations thermo métriques", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "observations_thermo_métriques", "book_id": "relation_historique_humboldt_vol3_1825", "name": "observations thermo métriques", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["observations thermo métriques"], "contexts": ["measurements of temperature"]}, {"entity_id": "thermometrical_measurements", "book_id": "kosmos_humboldt_1845", "name": "thermometrical measurements", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["thermometrical measurements"], "contexts": ["method for measuring temperature"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "observations thermo métriques", "target_book": "kosmos_humboldt_1845", "target_name": "thermometrical measurements", "similarity": 0.887}], "id": 4130, "stable_key": "clu_3f311ec408d994ba", "ground_truth": {"modern_name": "Thermometric measurements", "confidence": "high", "type": "concept"}, "cross_references": []}, {"canonical_name": "Rhizophora Mangle", "category": "PLANT", "subcategory": "TREE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "rhizophora_mangle", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Rhizophora Mangle", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Rhizophora Mangle"], "contexts": ["scientific name for a plant"]}, {"entity_id": "rhizophora_mangle", "book_id": "kosmos_humboldt_1845", "name": "Rhizophora mangle", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Rhizophora mangle"], "contexts": ["low bushes found on coasts"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Rhizophora Mangle", "target_book": "kosmos_humboldt_1845", "target_name": "Rhizophora mangle", "similarity": 0.901}], "id": 4131, "stable_key": "clu_0b6633efbf6fd12c", "ground_truth": {"modern_name": "Red Mangrove", "confidence": "high", "type": "plant", "linnaean": "Rhizophora mangle Linnaeus", "family": "Rhizophoraceae", "wikidata_id": "Q853914", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Rhizophora_mangle", "wikipedia_extract": "Rhizophora mangle, also known as the red mangrove, is a salt-tolerant, small-to-medium sized evergreen tree restricted to coastal, estuarine ecosystems along the southern portions of North America, the Caribbean as well as Central America and tropical West Africa. Its viviparous \"seeds\", in actuality called propagules, become fully mature plants before dropping off the parent tree. These are dispersed by water until eventually embedding in the shallows. Rhizophora mangle grows on aerial prop roots, which arch above the water level, giving stands of this tree the characteristic \"mangrove\" appearance. It is a valuable plant in Florida, Louisiana, and Texas coastal ecosystems. The name refers to the red colour on the inner part of its roots when halved, so it does not display any red colour in its regular appearance."}, "cross_references": []}, {"canonical_name": "Hydrographie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "hydrographie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Hydrographie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Hydrographie"], "contexts": ["field of study for the work"]}, {"entity_id": "hydrography", "book_id": "kosmos_humboldt_1845", "name": "hydrography", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["hydrography"], "contexts": ["study of water bodies"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Hydrographie", "target_book": "kosmos_humboldt_1845", "target_name": "hydrography", "similarity": 0.887}], "id": 4132, "stable_key": "clu_bd44b08cddac8c16", "ground_truth": {"modern_name": "Hydrography", "confidence": "high", "type": "concept"}, "cross_references": [{"found_name": "Gulf-stream", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2539, "target_cluster_name": "Gulf-stream", "source_book": "llm_generated", "evidence_snippet": "The Gulf Stream is a key feature studied within hydrography, the branch of applied science which deals with the measurement and description of the physical features of oceans, seas, coastal areas, rivers and other inland waters, and with the prediction of their associated physical processes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Gulf Stream is a key feature studied within hydrography, the branch of applied science which deals with the measurement and description of the physical features of oceans, seas, coastal areas, rivers and other inland waters, and with the prediction of their associated physical processes.", "is_reverse": true}]}, {"canonical_name": "P. speciosa", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "p__speciosa", "book_id": "relation_historique_humboldt_vol3_1825", "name": "P. speciosa", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["P. speciosa"], "contexts": ["plant species Cluipo"]}, {"entity_id": "s__speciosa", "book_id": "kosmos_humboldt_1845", "name": "S. speciosa", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["S. speciosa"], "contexts": ["flowering plant near snow line"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "P. speciosa", "target_book": "kosmos_humboldt_1845", "target_name": "S. speciosa", "similarity": 0.954}], "id": 4133, "stable_key": "clu_fc6941ace3ffc0e0", "ground_truth": {"modern_name": "Species Plantarum", "confidence": "medium", "type": "text", "note": "The 'P.' and 'S.' likely refer to abbreviations of a genus, and 'speciosa' is an epithet. Without more context or a known work by Humboldt where he uses such abbreviations, identifying a specific plant is difficult. 'Species Plantarum' is a likely candidate for 'P. speciosa' due to its significance in botany and the abbreviation 'P.' sometimes used for binomial nomenclature.", "wikidata_id": "Q21856070", "wikidata_description": "Second edition of Linnaeus' Species Plantarum", "wikipedia_extract": "Parkia speciosa, the bitter bean, twisted cluster bean, sator bean, stink bean, or petai is a plant of the genus Parkia in the family Fabaceae. It bears long, flat edible beans with bright green seeds the size and shape of plump almonds which have a rather peculiar smell, similar to, but stronger than that of the shiitake mushroom, due to sulfur-containing compounds also found in shiitake, truffles and cabbage. The petai tree can grow to about 30 metres. It bears flowers in a light bulb-shaped mass at the end of long stalks. The flowers secrete a nectar that attracts bats and other pollinators. The fruits emerge as long, twisted, translucent pods in a cluster of seven or eight pods.", "wikipedia_url": "https://en.wikipedia.org/wiki/Parkia_speciosa"}, "cross_references": []}, {"canonical_name": "solfatares", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "solfatares", "book_id": "relation_historique_humboldt_vol3_1825", "name": "solfatares", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["solfatares"], "contexts": ["volcanic vents emitting sulfurous gases"]}, {"entity_id": "solfataras", "book_id": "kosmos_humboldt_1845", "name": "solfataras", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["solfataras"], "contexts": ["volcanic vents emitting gases"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "solfatares", "target_book": "kosmos_humboldt_1845", "target_name": "solfataras", "similarity": 0.923}], "id": 4134, "stable_key": "clu_55191d98e16954ce", "ground_truth": {"modern_name": "solfatara", "confidence": "high", "type": "place", "country": "Italy", "note": "Solfataras are specific geological formations, but the term can also refer to the general phenomenon of volcanic vents emitting sulfurous gases.", "wikipedia_extract": "Pozzuoli (Italian: [potˈtswɔːli]; Neapolitan: Pozzule [pətˈtsuːlə]; Latin: Puteoli) is a city and comune (municipality) of the Metropolitan City of Naples, in the Italian region of Campania. It is the main city of the Phlegrean Peninsula. Pozzuoli began as the Greek colony of Dicaearchia (Greek: Δικαιαρχία) founded in about 531 BC in Magna Graecia with the consent of nearby Cumae when refugees from Samos escaped from the tyranny of Polycrates. The Samnites occupied Dicaearchia in 421 BC after conquering Cumae and may have changed its name to Fistelia. It enjoyed considerable political and commercial autonomy favoured by the excellent position of its port with the Campanian hinterland. The Roman occupation of Campania after the end of the 1st Samnite War from 341 BC marked the start of the Romanisation of the Greek-Samnite city.", "wikipedia_url": "https://en.wikipedia.org/wiki/Pozzuoli"}, "cross_references": []}, {"canonical_name": "Gokmali", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "gokmali", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Gokmali", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Gokmali"], "contexts": ["location of an igneous eruption"]}, {"entity_id": "jokmali", "book_id": "kosmos_humboldt_1845", "name": "Jokmali", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Jokmali"], "contexts": ["location of a mud volcano"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Gokmali", "target_book": "kosmos_humboldt_1845", "target_name": "Jokmali", "similarity": 0.88}], "id": 4135, "stable_key": "clu_c173b243adb10b02", "ground_truth": {"modern_name": "Gokmali", "confidence": "low", "type": "place", "country": "Unknown", "note": "The location 'Gokmali' or 'Jokmali' is not readily identifiable in historical or modern geographic records. It may be a transcription error or a very obscure location. Given its association with volcanic activity, it might be a specific volcanic feature."}, "cross_references": []}, {"canonical_name": "Pena", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "pena", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Pena", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Pena"], "contexts": ["cascade near Mariquita"]}, {"entity_id": "pena", "book_id": "polyanthea_medicinal", "name": "Pena", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Pena"], "contexts": ["N. Senhora da Ribeyra de Pena"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pena", "target_book": "polyanthea_medicinal", "target_name": "Pena", "similarity": 1.0}], "id": 4136, "stable_key": "clu_5c930b24b4354894", "ground_truth": {"wikipedia_extract": "Penna (originally known as Penneru, also known as Pinakini, Penneru, Penner, Pennar, Pennai) is a river of southern India. After originating from Nandi hills, it flows as two different streams, one in North and South directions. The Penna rises in the Nandi Hills in Chikkaballapur District of Karnataka state, and runs north and east through the states of Karnataka and Andhra Pradesh to empty into bay of bengal in Andhra Pradesh. It is 597 kilometres (371 mi) long, with a drainage basin covering 55,213 km2: 6,937 km2 in Karnataka and 48,276 km2 in Andhra Pradesh. Along with this main stream is another stream south towards Tamil Nadu with the name Then Pennai or south Pennar which further moves towards the east to empty into the Bay of Bengal. The Penna river basin lies in the rain shadow region of Eastern Ghats and receives 500 mm average rainfall annually."}, "cross_references": []}, {"canonical_name": "administrative", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "administrative", "book_id": "relation_historique_humboldt_vol3_1825", "name": "administrative", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["administrative"], "contexts": ["Relating to governance"]}, {"entity_id": "administrative", "book_id": "first_principles_spencer_1862", "name": "administrative", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["administrative"], "contexts": ["relating to the management of public affairs"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "administrative", "target_book": "first_principles_spencer_1862", "target_name": "administrative", "similarity": 1.0}], "id": 4137, "stable_key": "clu_5ee0a299c6012fc6", "ground_truth": {"modern_name": "Administrative", "confidence": "high", "type": "concept", "wikidata_id": "Q5283295", "wikidata_description": "management of organization"}, "cross_references": [{"found_name": "organisation", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 340, "target_cluster_name": "organisation", "source_book": "llm_generated", "evidence_snippet": "The term 'organization' is often used in administrative contexts to describe the structure and functioning of bodies, institutions, or systems.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The term 'organization' is often used in administrative contexts to describe the structure and functioning of bodies, institutions, or systems.", "is_reverse": true}]}, {"canonical_name": "épicycles", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "épicycles", "book_id": "relation_historique_humboldt_vol3_1825", "name": "épicycles", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["épicycles"], "contexts": ["celestial mechanics concept"]}, {"entity_id": "epicycles", "book_id": "first_principles_spencer_1862", "name": "epicycles", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["epicycles"], "contexts": ["circles used in ancient astronomical models"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "épicycles", "target_book": "first_principles_spencer_1862", "target_name": "epicycles", "similarity": 0.853}], "id": 4138, "stable_key": "clu_663e80ad56c41de7", "ground_truth": {"modern_name": "Epicycles", "confidence": "high", "type": "concept"}, "cross_references": [{"found_name": "orbit", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 644, "target_cluster_name": "orbit", "source_book": "llm_generated", "evidence_snippet": "Epicycles were a historical model used to explain planetary motion within orbits.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Epicycles were a historical model used to explain planetary motion within orbits.", "is_reverse": true}, {"found_name": "orbits", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1379, "target_cluster_name": "orbits", "source_book": "llm_generated", "evidence_snippet": "Epicycles were used in historical models of celestial orbits.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Epicycles were used in historical models of celestial orbits.", "is_reverse": true}, {"found_name": "planetary motions", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2896, "target_cluster_name": "planetary motions", "source_book": "llm_generated", "evidence_snippet": "Epicycles were a key component of the geocentric model used to explain the observed complex motions of planets, including retrograde motion.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Epicycles were a key component of the geocentric model used to explain the observed complex motions of planets, including retrograde motion.", "is_reverse": true}]}, {"canonical_name": "steppe des Kirghises", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "steppe_des_kirghises", "book_id": "relation_historique_humboldt_vol3_1825", "name": "steppe des Kirghises", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["steppe des Kirghises"], "contexts": ["steppe visited for observations"]}, {"entity_id": "kirghis_steppes", "book_id": "kosmos_humboldt_1845", "name": "Kirghis Steppes", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Kirghis Steppes"], "contexts": ["steppe inhabited by Kirghis"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "steppe des Kirghises", "target_book": "kosmos_humboldt_1845", "target_name": "Kirghis Steppes", "similarity": 0.943}], "id": 4139, "stable_key": "clu_a303765edcf7e2a8", "ground_truth": {"modern_name": "Kazakh Steppe", "confidence": "high", "type": "place", "country": "Kazakhstan", "note": "The term 'steppe des Kirghises' directly translates to 'Steppe of the Kirghiz,' which is historically and geographically synonymous with the vast Kazakh Steppe.", "wikidata_id": "Q602925", "wikidata_description": "Ecoregion of grasslands that encompass most of the eastern segment of the Eurasian steppe", "wikipedia_extract": "The Kazakh Steppe (Kazakh: Қазақ даласы, romanized: Qazaq dalasy [qɑˈzɑq dɑɫɑˈsə]), also known as the Great Steppe or Great Dala (Kazakh: Ұлы дала, romanized: Ūly dala [ʊˈɫɤ dɑˈɫɑ]), is a vast region of open grassland in Central Asia, covering areas in northern Kazakhstan and adjacent areas of Russia. It lies east of the Pontic–Caspian steppe and west of the Emin Valley steppe, with which it forms the central and western part of the Eurasian steppe. The Kazakh Steppe is an ecoregion of the temperate grasslands, savannas, and shrublands biome in the Palearctic realm. Before the mid-19th century, it was called the Kirghiz steppe, 'Kirghiz' being an old Russian word for the Kazakhs. The steppe extends more than 2,200 km (1,400 mi) from the east of the Caspian Depression and north of the Aral Sea, all the way to the Altai Mountains. It is the largest dry steppe region on earth, covering approximately 804,450 km2 (310,600 sq mi).", "wikipedia_url": "https://en.wikipedia.org/wiki/Kazakh_Steppe"}, "cross_references": []}, {"canonical_name": "Morlet", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "morlet", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Morlet", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Morlet"], "contexts": ["scholar who fixed magnetic equator position"]}, {"entity_id": "morlet", "book_id": "kosmos_humboldt_1845", "name": "Morlet", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Morlet"], "contexts": ["contributor to Acad. Roy. des Sciences"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Morlet", "target_book": "kosmos_humboldt_1845", "target_name": "Morlet", "similarity": 1.0}], "id": 4140, "stable_key": "clu_3e253ac876a096cc", "ground_truth": {"modern_name": "Morlet", "confidence": "high", "type": "person", "description": "Scholar who fixed magnetic equator position, member of Acad. Roy. des Sciences.", "note": "Assuming the 'Morlet' mentioned is the same individual across texts.", "wikidata_id": "", "wikidata_description": "family name"}, "cross_references": []}, {"canonical_name": "siècle", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "siècle", "book_id": "relation_historique_humboldt_vol3_1825", "name": "siècle", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["siècle"], "contexts": ["period of time"]}, {"entity_id": "century", "book_id": "kosmos_humboldt_1845", "name": "century", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["century"], "contexts": ["period of 100 years"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "siècle", "target_book": "kosmos_humboldt_1845", "target_name": "century", "similarity": 0.946}], "id": 4141, "stable_key": "clu_317dbd8ab9297edf", "ground_truth": {"modern_name": "Century", "confidence": "high", "type": "concept", "wikidata_id": "Q155874", "wikidata_description": "genus of plants"}, "cross_references": []}, {"canonical_name": "Guadaïama", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "guadaïama", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Guadaïama", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Guadaïama"], "contexts": ["location of geological observation"]}, {"entity_id": "guacamayo", "book_id": "kosmos_humboldt_1845", "name": "Guacamayo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Guacamayo"], "contexts": ["volcano in Quixos province"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Guadaïama", "target_book": "kosmos_humboldt_1845", "target_name": "Guacamayo", "similarity": 0.904}], "id": 4142, "stable_key": "clu_05baa05475b9c800", "ground_truth": {"modern_name": "Guayacan", "confidence": "high", "type": "place", "country": "Ecuador", "note": "Humboldt's 'Guadaïama' and 'Guacamayo' likely refer to the Guayacan area, a region known for its geological features and proximity to volcanoes in the Quijos province of Ecuador."}, "cross_references": []}, {"canonical_name": "Porphyre schisteux", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "porphyre_schisteux", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Porphyre schisteux", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Porphyre schisteux"], "contexts": ["type of schistose porphyry rock"]}, {"entity_id": "granitic_porphyry", "book_id": "kosmos_humboldt_1845", "name": "granitic porphyry", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["granitic porphyry"], "contexts": ["porphyry with feldspathic base"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Porphyre schisteux", "target_book": "kosmos_humboldt_1845", "target_name": "granitic porphyry", "similarity": 0.913}], "id": 4143, "stable_key": "clu_283dc8dc4f00c4ab", "ground_truth": {"modern_name": "Schistose porphyry", "confidence": "high", "type": "mineral", "note": "Schistose porphyry is a type of igneous rock with phenocrysts in a fine-grained groundmass, often exhibiting a foliated or schistose texture. 'Granitic porphyry' is a similar classification."}, "cross_references": []}, {"canonical_name": "Zurich", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "zurich", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Zurich", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Zurich"], "contexts": ["location of observation"]}, {"entity_id": "zurich", "book_id": "kosmos_humboldt_1845", "name": "Zurich", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Zurich"], "contexts": ["location for air strata data"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Zurich", "target_book": "kosmos_humboldt_1845", "target_name": "Zurich", "similarity": 1.0}], "id": 4144, "stable_key": "clu_1041e55061e90485", "ground_truth": {"modern_name": "Zurich", "confidence": "high", "type": "place", "country": "Switzerland", "wikidata_id": "Q72", "wikidata_description": "most populous city in Switzerland and capital of the canton of Zurich", "wikipedia_url": "https://en.wikipedia.org/wiki/Zurich", "wikipedia_extract": "Zurich (German: Zürich; Alemannic German: Züri; see below) is the largest city in Switzerland and the capital of the canton of Zurich. It is in north-central Switzerland, at the northwestern tip of Lake Zurich. As of the end of 2024, the municipality had a population of 436,551, while the urban area was home to 1.45 million people (2020), while the Zurich metropolitan area had a total population of 2.1 million (2020). Zurich is a hub for railways, roads, and air traffic. Both Zurich Airport and Zurich's main railway station are the largest and busiest in the country. Evidence of early, sparse settlements in the area dates back more than 6,400 years, indicating human presence prior to the establishment of the town."}, "cross_references": []}, {"canonical_name": "Euler", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "euler", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Euler", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Euler"], "contexts": ["theorist of magnetic inclination"]}, {"entity_id": "euler", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Euler", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Euler"], "contexts": ["proved conditions for solar system stability"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Euler", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Euler", "similarity": 1.0}], "id": 4145, "stable_key": "clu_5aea78bbfc11047e", "ground_truth": {"modern_name": "Leonhard Euler", "confidence": "high", "type": "person", "birth_year": 1707, "death_year": 1783, "description": "Swiss mathematician and physicist, pioneer of calculus.", "wikidata_id": "Q751290", "wikidata_description": "three angles introduced by Leonhard Euler to describe the orientation of a rigid body with respect to a fixed coordinate system", "wikipedia_url": "https://en.wikipedia.org/wiki/Euler_angles", "wikipedia_extract": "The Euler angles are three angles introduced by Leonhard Euler to describe the orientation of a rigid body with respect to a fixed coordinate system. They can also represent the orientation of a mobile frame of reference in physics or the orientation of a general basis in  three dimensional linear algebra. Classic Euler angles usually take the inclination angle in such a way that zero degrees represent the vertical orientation. Alternative forms were later introduced by Peter Guthrie Tait and George H. Bryan intended for use in aeronautics and engineering in which zero degrees represent the horizontal position. Euler angles can be defined by elemental geometry or by composition of rotations (i.e."}, "cross_references": []}, {"canonical_name": "Ust-Kamenogorsk", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "ust-kamenogorsk", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Ust-Kamenogorsk", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Ust-Kamenogorsk"], "contexts": ["city for observation"]}, {"entity_id": "ustkamenogorsk", "book_id": "kosmos_humboldt_1845", "name": "Ustkamenogorsk", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Ustkamenogorsk"], "contexts": ["location on the Irtysch river"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Ust-Kamenogorsk", "target_book": "kosmos_humboldt_1845", "target_name": "Ustkamenogorsk", "similarity": 0.796}], "id": 4146, "stable_key": "clu_9dd8ec76f3c2f18a", "ground_truth": {"modern_name": "Ust-Kamenogorsk", "confidence": "high", "type": "place", "country": "Kazakhstan", "note": "The spellings 'Ust-Kamenogorsk' and 'Ustkamenogorsk' are variations of the same city located on the Irtysh River in Kazakhstan."}, "cross_references": []}, {"canonical_name": "débris organiques", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "débris_organiques", "book_id": "relation_historique_humboldt_vol3_1825", "name": "débris organiques", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["débris organiques"], "contexts": ["remains of living organisms"]}, {"entity_id": "debris", "book_id": "kosmos_humboldt_1845", "name": "debris", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["debris"], "contexts": ["fragmented material"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "débris organiques", "target_book": "kosmos_humboldt_1845", "target_name": "debris", "similarity": 0.923}], "id": 4147, "stable_key": "clu_666f369f7839ef50", "ground_truth": {"modern_name": "Organic debris", "confidence": "high", "type": "concept", "note": "This refers to fragmented material derived from living organisms, commonly encountered in geological and ecological contexts.", "wikidata_id": "Q127370609", "wikidata_description": "scholarly article"}, "cross_references": [{"found_name": "pétrifications", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2932, "target_cluster_name": "pétrifications", "source_book": "llm_generated", "evidence_snippet": "Organic debris is the precurs