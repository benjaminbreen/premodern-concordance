 Baltic states:  Estonia, Latvia, and Lithuania. Estonia, Latvia, Lithuania and Kaliningrad Oblast of Russia, exclaved from the remainder of Russia."}, "cross_references": [{"found_name": "mer", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 921, "target_cluster_name": "mer", "source_book": "llm_generated", "evidence_snippet": "The Baltic Sea is a specific sea, a part of the larger interconnected body of seawaters referred to as 'the sea'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Baltic Sea is a specific sea, a part of the larger interconnected body of seawaters referred to as 'the sea'.", "is_reverse": true}, {"found_name": "Europe", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 30, "target_cluster_name": "Europe", "source_book": "llm_generated", "evidence_snippet": "The Baltic Sea is a significant geographical feature within Europe, and the description of the Baltic region explicitly includes parts of Northern, Central, and Eastern Europe.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Baltic Sea is a significant geographical feature within Europe, and the description of the Baltic region explicitly includes parts of Northern, Central, and Eastern Europe."}, {"found_name": "Eastern Europe", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2797, "target_cluster_name": "Eastern Europe", "source_book": "llm_generated", "evidence_snippet": "The Baltic Sea region is explicitly stated to include parts of Eastern Europe in its description.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Baltic Sea region is explicitly stated to include parts of Eastern Europe in its description."}, {"found_name": "Scandinave", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 810, "target_cluster_name": "Scandinave", "source_book": "llm_generated", "evidence_snippet": "The Baltic Sea borders and is closely associated with Scandinavia.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Baltic Sea borders and is closely associated with Scandinavia.", "is_reverse": true}, {"found_name": "St. Petersburg", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1181, "target_cluster_name": "St. Petersburg", "source_book": "llm_generated", "evidence_snippet": "Saint Petersburg is situated at the head of the Gulf of Finland on the Baltic Sea.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Saint Petersburg is situated at the head of the Gulf of Finland on the Baltic Sea.", "is_reverse": true}, {"found_name": "seas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2596, "target_cluster_name": "seas", "source_book": "llm_generated", "evidence_snippet": "The Baltic Sea is a specific sea, and 'seas' is a general term for large bodies of saltwater.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Baltic Sea is a specific sea, and 'seas' is a general term for large bodies of saltwater.", "is_reverse": true}, {"found_name": "Polythalamia", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "kosmos_humboldt_1845", "evidence_snippet": "beautiful discoveries to consist of microscopic Polythalamia, many of which still exist in our seas, and in the middle latitudes of the North Sea and Baltic. The first group of tertiary formations abo", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of microscopic organism"}]}, {"canonical_name": "Thermometer", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 4, "total_mentions": 21, "members": [{"entity_id": "thermometri", "book_id": "kosmos_humboldt_1845", "name": "thermometri", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["thermometri"], "contexts": ["instrument for measuring temperature"]}, {"entity_id": "thermometer", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Thermometer", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 10, "variants": ["Thermometer", "thermometer"], "contexts": ["measures temperature", "instrument for measuring temperature"]}, {"entity_id": "thermometer", "book_id": "first_principles_spencer_1862", "name": "thermometer", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["thermometer"], "contexts": ["instrument for measuring temperature"]}, {"entity_id": "thermometers", "book_id": "principles_of_psychology_james_1890", "name": "thermometers", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["thermometers"], "contexts": ["devices for measuring temperature"]}, {"entity_id": "thermometer", "book_id": "kosmos_humboldt_1845", "name": "Thermometer", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 6, "variants": ["thermometer", "Thermometer"], "contexts": ["instrument for measuring temperature", "instrument used to measure temperature"]}, {"entity_id": "thermometers", "book_id": "kosmos_humboldt_1845", "name": "thermometers", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["thermometers"], "contexts": ["devices for measuring temperature"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "thermometri", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Thermometer", "similarity": 0.961}, {"source_book": "kosmos_humboldt_1845", "source_name": "thermometri", "target_book": "first_principles_spencer_1862", "target_name": "thermometer", "similarity": 0.964}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Thermometer", "target_book": "first_principles_spencer_1862", "target_name": "thermometer", "similarity": 0.994}, {"source_book": "principles_of_psychology_james_1890", "source_name": "thermometers", "target_book": "kosmos_humboldt_1845", "target_name": "Thermometer", "similarity": 0.956}, {"source_book": "principles_of_psychology_james_1890", "source_name": "thermometers", "target_book": "kosmos_humboldt_1845", "target_name": "thermometers", "similarity": 1.0}], "id": 320, "stable_key": "clu_5140fc3d5217fa19", "ground_truth": {"modern_name": "thermometer", "confidence": "high", "type": "OBJECT", "description": "An instrument used to measure temperature.", "wikipedia_extract": "A thermometer is a device that measures temperature (the hotness or coldness of an object) or temperature gradient (the rates of change of temperature in space). A thermometer has two important elements: (1) a temperature sensor (e.g. the bulb of a mercury-in-glass thermometer or the pyrometric sensor in an infrared thermometer) in which some change occurs with a change in temperature; and (2) some means of converting this change into a numerical value (e.g. the visible scale that is marked on a mercury-in-glass thermometer or the digital readout on an infrared model). Thermometers are widely used in technology and industry to monitor processes, in meteorology, in medicine (medical thermometer), and in scientific research. While an individual thermometer is able to measure degrees of hotness, the readings on two thermometers cannot be compared unless they conform to an agreed scale. Today there is an absolute thermodynamic temperature scale. Internationally agreed temperature scales are designed to approximate this closely, based on fixed points and interpolating thermometers."}, "cross_references": [{"found_name": "Barometer", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 568, "target_cluster_name": "baromètre", "source_book": "llm_generated", "evidence_snippet": "Both are meteorological instruments used to measure atmospheric conditions.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are meteorological instruments used to measure atmospheric conditions."}, {"found_name": "Hygrometer", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 830, "target_cluster_name": "hygromètre à baleine", "source_book": "llm_generated", "evidence_snippet": "Both are meteorological instruments used to measure atmospheric conditions.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are meteorological instruments used to measure atmospheric conditions."}, {"found_name": "Electrometer", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1092, "target_cluster_name": "electrometer", "source_book": "llm_generated", "evidence_snippet": "Both are scientific instruments used for measurement, though of different physical quantities.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are scientific instruments used for measurement, though of different physical quantities."}, {"found_name": "Chronometers", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 853, "target_cluster_name": "chronomètres", "source_book": "llm_generated", "evidence_snippet": "Both are precision instruments, though one measures time and the other temperature.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are precision instruments, though one measures time and the other temperature."}, {"found_name": "Scientific instruments", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 456, "target_cluster_name": "Instruments", "source_book": "llm_generated", "evidence_snippet": "The thermometer is a type of scientific instrument.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The thermometer is a type of scientific instrument."}, {"found_name": "hygromètre à baleine", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 830, "target_cluster_name": "hygr