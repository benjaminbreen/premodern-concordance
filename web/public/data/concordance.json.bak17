": "theory", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "theory", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "theory", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "theory", "target_book": "first_principles_spencer_1862", "target_name": "theory", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "theory", "target_book": "kosmos_humboldt_1845", "target_name": "theory", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "theory", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "theory", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "theory", "target_book": "first_principles_spencer_1862", "target_name": "theory", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "theory", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "theory", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "theory", "target_book": "first_principles_spencer_1862", "target_name": "theory", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "theory", "target_book": "first_principles_spencer_1862", "target_name": "theory", "similarity": 1.0}], "id": 68, "stable_key": "clu_b552c53b7f7e76f3", "ground_truth": {"modern_name": "theory", "confidence": "high", "type": "concept", "description": "An abstract explanation or system of ideas for understanding phenomena.", "note": "'Theoriques' is the French plural of theoretical.", "wikipedia_extract": "A theory is, in general, any hypothesis or set of ideas about something, formed in any number of ways through any sort of reasoning for any sort of reason. When applied to intellectual or academic situations, it is considered a systematic and rational form of abstract thinking about a phenomenon, or the conclusions derived from such thinking. It involves contemplative and logical reasoning, often supported by processes such as observation, experimentation, and research. Theories can be scientific, falling within the realm of empirical and testable knowledge, or they may belong to non-scientific disciplines, such as philosophy, art, or sociology. In some cases, theories may exist independently of any formal discipline. In modern science, the term \"theory\" refers to scientific theories, a well-confirmed type of explanation of nature, made in a way consistent with the scientific method, and fulfilling the criteria required by modern science."}, "member_count": 11, "cross_references": [{"found_name": "Conception", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 282, "target_cluster_name": "conception", "source_book": "llm_generated", "evidence_snippet": "Theories are formed through conception and understanding.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Theories are formed through conception and understanding."}, {"found_name": "Empirical law", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4194, "target_cluster_name": "empirical law", "source_book": "llm_generated", "evidence_snippet": "Empirical laws can be explained by or incorporated into theories.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Empirical laws can be explained by or incorporated into theories."}]}, {"canonical_name": "June", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 50, "members": [{"entity_id": "june", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "June", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["June"], "contexts": ["month when maggots turn into flies"]}, {"entity_id": "june", "book_id": "english_physician_1652", "name": "June", "category": "CONCEPT", "subca