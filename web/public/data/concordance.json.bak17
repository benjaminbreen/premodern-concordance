e": "Lust", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name"}, "cross_references": [{"found_name": "Desire", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 925, "target_cluster_name": "desire", "source_book": "llm_generated", "evidence_snippet": "Lust is a specific form of desire, often with a strong physical or sexual connotation.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Lust is a specific form of desire, often with a strong physical or sexual connotation."}, {"found_name": "Affection", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3559, "target_cluster_name": "affection", "source_book": "llm_generated", "evidence_snippet": "Affection is a broader term for positive feeling, and lust can be seen as a specific, intense, and often physical manifestation of affection or attraction.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Affection is a broader term for positive feeling, and lust can be seen as a specific, intense, and often physical manifestation of affection or attraction."}, {"found_name": "Appetite", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2030, "target_cluster_name": "Appetite", "source_book": "llm_generated", "evidence_snippet": "Lust can be understood as a powerful appetite, particularly a sexual one.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Lust can be understood as a powerful appetite, particularly a sexual one."}, {"found_name": "Luxury", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1351, "target_cluster_name": "luxuria", "source_book": "llm_generated", "evidence_snippet": "In some historical contexts, 'luxury' (luxuria) was used to encompass excessive or uncontrolled desires, including lust.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "In some historical contexts, 'luxury' (luxuria) was used to encompass excessive or uncontrolled desires, including lust."}]}, {"canonical_name": "Plums", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "plums", "book_id": "english_physician_1652", "name": "Plums", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Plums", "Plum"], "contexts": ["well-known fruit", "fruit with diverse operations"]}, {"entity_id": "plums", "book_id": "origin_of_species_darwin_1859", "name": "Plums", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Plums"], "contexts": ["fruit grown in the United States"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Plums", "target_book": "origin_of_species_darwin_1859", "target_name": "Plums", "similarity": 1.0}], "id": 2700, "stable_key": "clu_847618b8adef2c9a", "ground_truth": {"modern_name": "Plum", "confidence": "high", "type": "plant", "linnaean": "Prunus domestica", "family": "Rosaceae", "description": "A common fruit tree bearing sweet, edible drupes.", "note": "The singular 'Plum' is more appropriate for the general fruit type.", "wikipedia_extract": "Prunus domestica is a species of flowering plant in the family Rosaceae. A deciduous tree, it includes many varieties of the fruit trees known as plums in English, though not all plums belong to this species. The greengages and damsons also belong to subspecies of P. domestica. It typically forms a large shrub or a small tree. It may be somewhat thorny, with white blossom, borne in early spring. The oval or spherical fruit varies in size, but can be up to 8 centimetres (3 inches) across."}, "cross_references": [{"found_name": "Fruit trees", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4032, "target_cluster_name": "Fruit-trees", "source_book": "llm_generated", "evidence_snippet": "Plums are a type of fruit tree.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Plums are a type of fruit tree."}, {"found_name": "Tree", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 24, "target_cluster_name": "Tree", "source_book": "llm_generated", "evidence_snippet": "Plums grow on trees.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Plums grow on trees."}, {"found_name": "Fruit", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 72, "target_cluster_name": "frutas", "source_book": "llm_generated", "evidence_snippet": "Plums are a type of fruit.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Plums are a type of fruit."}]}, {"canonical_name": "Oyl of Almonds", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "oyl_of_almonds", "book_id": "english_physician_1652", "name": "Oyl of Almonds", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 4, "variants": ["Oyl of Almonds", "Oyl of Bitter Almonds", "Oyl of sweet and bitter Almonds"], "contexts": ["oil from almonds", "comparison for kernel oil"]}, {"entity_id": "oil_of_almonds", "book_id": "polyanthea_medicinal", "name": "oil of almonds", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["oil of almonds"], "contexts": ["mixed with crystal powder"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Oyl of Almonds", "target_book": "polyanthea_medicinal", "target_name": "oil of almonds", "similarity": 0.88}], "id": 2701, "stable_key": "clu_b07300b7ec98b666", "ground_truth": {"modern_name": "Oil of Almonds", "confidence": "high", "type": "substance", "description": "Oil extracted from almonds, used in remedies.", "note": "Refers to the oil derived from almond kernels.", "wikipedia_extract": "Marzipan is a confection consisting primarily of sugar and almond meal (ground almonds), sometimes augmented with almond oil or extract. It is often made into sweets; common uses are chocolate-covered marzipan and small marzipan imitations of fruits and vegetables. It can also be used in biscuits or rolled into thin sheets and glazed for icing cakes, primarily birthday cakes, wedding cakes and Christmas cakes. Marzipan may also be used as a baking ingredient, as in stollen or banket. In some countries, it is shaped into small figures of animals as a traditional treat for New Year's Day or Christmas. Marzipan is also used in Tortell, and in some versions of king cake eaten during the Carnival season."}, "cross_references": [{"found_name": "oleo de amendoas doces", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 1648, "target_cluster_name": "oleo de amendoas doces", "source_book": "llm_generated", "evidence_snippet": "This is a direct English translation of the historical Portuguese name 'oleo de amendoas doces'.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "reverse: This is a direct English translation of the historical Portuguese name 'oleo de amendoas doces'.", "is_reverse": true}]}, {"canonical_name": "Aromaticum Rosarum", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "aromaticum_rosarum", "book_id": "english_physician_1652", "name": "Aromaticum Rosarum", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 4, "variants": ["Aromaticum Rosarum", "Aromatica Rosarum", "Aromatica Rosa∣rum"], "contexts": ["rose preparation for cordial use", "made with dried Rose leaves"]}, {"entity_id": "aromatico_rosa", "book_id": "ricettario_fiorentino_1597", "name": "AROMATICO ROSA", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["AROMATICO ROSA"], "contexts": ["aromatic preparation with rose"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Aromaticum Rosarum", "target_book": "ricettario_fiorentino_1597", "target_name": "AROMATICO ROSA", "similarity": 0.901}], "id": 2702, "stable_key": "clu_b2ee60d7cec1978e", "ground_truth": {"modern_name": "Aromaticum Rosarum", "confidence": "high", "type": "substance", "description": "Rose preparation used for cordial purposes.", "note": "This is a historical preparation name.", "wikipedia_extract": "In pre-modern medicine, \"diarrhodon\" (Gr διάρροδον, \"compound of roses\", from ῥόδων, \"of roses\") is a name given to diverse compositions, in which red roses are an ingredient. Diarrhodon abbatis is a cordial powder, denominated from the Abbot who invented it. It consists of red roses, red and citron santals, lignum aloes, cinnamon, rhapontic, spikenard, ivory, harts-horn, saffron, mastic, pearls, ambergris, musk, etc. It was used to strengthen the heart, stomach, and liver, and to assist in digestion, and prevent vomiting. Philip Barrough, author of the first textbook on medicine published in English, gives this description and recipe for diarrhodon abbatis: \"Electarium Diarrhodon Abbatis mitigateth the heate of the stomacke and midrife, and yet notwithstanding furthereth their concoction, aswageth paine, and dissipateth wind. \"R. Rosarum rubrarum oz. 1 1/2."}, "cross_references": [{"found_name": "Diarhodon Abhatis", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2950, "target_cluster_name": "Diarhodon Abhatis", "source_book": "llm_generated", "evidence_snippet": "The description explicitly states that 'Diarrhodon abbatis' is a specific composition of roses, and 'Aromaticum Rosarum' is a general term for compositions with roses as an ingredient. Diarrhodon abbatis is a specific example of an Aromaticum Rosarum.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "The description explicitly states that 'Diarrhodon abbatis' is a specific composition of roses, and 'Aromaticum Rosarum' is a general term for compositions with roses as an ingredient. Diarrhodon abbatis is a specific example of an Aromaticum Rosarum."}, {"found_name": "cooling", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 720, "target_cluster_name": "cooling", "source_book": "english_physician_1652", "evidence_snippet": "the Mouth, Throat, or other parts, both to clens and heal them, and to stay the Fluxes of Humors falling upon them; it is also used in Clisters both to cool and clens. The Cordial Pouders called Diarh", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "reverse: synonym", "is_reverse": true}, {"found_name": "olio rosato", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 987, "target_cluster_name": "olio rosato", "source_book": "llm_generated", "evidence_snippet": "This is a Latin name for a rose-based aromatic preparation, closely related to rose oil.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: This is a Latin name for a rose-based aromatic preparation, closely related to rose oil.", "is_reverse": true}, {"found_name": "aromi", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1044, "target_cluster_name": "aromi", "source_book": "llm_generated", "evidence_snippet": "Aromaticum Rosarum is a specific preparation that would contain aromas.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Aromaticum Rosarum is a specific preparation that would contain aromas.", "is_reverse": true}, {"found_name": "Simples", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1065, "target_cluster_name": "Simples", "source_book": "llm_generated", "evidence_snippet": "Aromaticum Rosarum is a specific preparation that would have been composed of various 'simples', particularly aromatic ones.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Aromaticum Rosarum is a specific preparation that would have been composed of various 'simples', particularly aromatic ones.", "is_reverse": true}, {"found_name": "Rosewater", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 292, "target_cluster_name": "Rosewater", "source_book": "llm_generated", "evidence_snippet": "Rosewater is a common ingredient or byproduct of processing roses for medicinal or aromatic purposes, making it directly related to 'Aromaticum Rosarum'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Rosewater is a common ingredient or byproduct of processing roses for medicinal or aromatic purposes, making it directly related to 'Aromaticum Rosarum'."}, {"found_name": "Suɡar of Roses", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "english_physician_1652", "evidence_snippet": "moist and dry, which is more usually called Su∣gar of Roses; Syrup of dryed Roses, and Ho∣ney of Roses; The Cordial Pouder called Diarhodon Abhatis', and Aromatica Rosa∣rum; The Distilled Water of Ros", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for Aromaticum Rosarum"}, {"found_name": "Aromatica Rosaɡum", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "english_physician_1652", "evidence_snippet": "moist and dry, which is more usually called Su∣gar of Roses; Syrup of dryed Roses, and Ho∣ney of Roses; The Cordial Pouder called Diarhodon Abhatis', and Aromatica Rosa∣rum; The Distilled Water of Ros", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for Aromaticum Rosarum"}, {"found_name": "Diarhodon Abbaɡis", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "english_physician_1652", "evidence_snippet": "to stay the Fluxes of Humors falling upon them; it is also used in Clisters both to cool and clens. The Cordial Pouders called Diarhodon Abba