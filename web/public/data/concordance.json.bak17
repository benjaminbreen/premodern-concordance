, "auto_label": "llm_related", "found_relationship": "Palm trees are a type of tree."}, {"found_name": "Tree ferns", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1341, "target_cluster_name": "ferns", "source_book": "llm_generated", "evidence_snippet": "Both are large, tree-like plants, though from different botanical families. They share a similar growth habit and stature.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are large, tree-like plants, though from different botanical families. They share a similar growth habit and stature."}]}, {"canonical_name": "Syrie", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "syrie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Syrie", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Syrie"], "contexts": ["region with deserts", "region with sugar consumption"]}, {"entity_id": "assyrian", "book_id": "first_principles_spencer_1862", "name": "Assyrian", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Assyrian"], "contexts": ["ancient civilization known for architecture", "ancient civilization"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Syrie", "target_book": "first_principles_spencer_1862", "target_name": "Assyrian", "similarity": 0.902}], "id": 3041, "stable_key": "clu_b7c5d834400f7768-2", "ground_truth": {"modern_name": "Syria", "confidence": "high", "type": "place", "description": "A region in the Middle East.", "wikipedia_extract": "Syria, officially the Syrian Arab Republic, is a country in West Asia located in the Eastern Mediterranean and the Levant. It borders the Mediterranean Sea to the west, Turkey to the north and northwest, Iraq to the east and southeast, Jordan to the south, and Israel and Lebanon to the southwest. It is a republic under a provisional government and comprises 14 governorates. Damascus is the capital and largest city. With a population of 26 million across an area of 185,180 square kilometres (71,500 sq mi), it is the 56th-most populous and 87th-largest country. The name \"Syria\" historically referred to a wider region."}, "cross_references": []}, {"canonical_name": "Puerta", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "puerta", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Puerta", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Puerta"], "contexts": ["location near Merida and Truxillo"]}, {"entity_id": "gate", "book_id": "coloquios_da_orta_1563", "name": "Gate", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Gate"], "contexts": ["name of a mountain range", "a type of mountain"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Puerta", "target_book": "coloquios_da_orta_1563", "target_name": "Gate", "similarity": 0.939}], "id": 3042, "stable_key": "clu_692662591e79b53b", "ground_truth": {"wikipedia_extract": "The gates of Intramuros refer to the original eight gates of the Walled City of Intramuros in Manila, built during the Spanish colonial era in the Philippines. The gates are called by the original Spanish word for \"gate\", puerta (plural: puertas). This gate was built in 1662 as the governor-general's gate when the first governor's palace was still located in Fort Santiago. It was destroyed during an earthquake and was never rebuilt. Postigo means \"postern\" or a small gate in Spanish. This gate was named after the nearby Palacio del Gobernador."}, "cross_references": [{"found_name": "maratha ghãt", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "do mar undoso Hum monte alto, que corre longamente, Servindo ao Malabar de forte muro, Com que do Canará vive seguro. Da terra os naturaes lhe chamam Gate,. • • A palavra maratha ghãt significava prop", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for Gate"}]}, {"canonical_name": "Moluques", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "moluques", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Moluques", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Moluques"], "contexts": ["Islands claimed as Castilian domain", "archipelago in Indonesia"]}, {"entity_id": "moluccas", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Moluccas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Moluccas"], "contexts": ["islands in Indonesia", "islands affected by eruption"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Moluques", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Moluccas", "similarity": 0.908}], "id": 3043, "stable_key": "clu_c1c2ff58eddc5d49", "ground_truth": {"modern_name": "Moluccas", "confidence": "high", "type": "place", "country": "Indonesia"}, "cross_references": []}, {"canonical_name": "diable", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "diable", "book_id": "relation_historique_humboldt_vol3_1825", "name": "diable", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Diable", "diable"], "contexts": ["name of a geological formation", "devil, mentioned as a flaw of the women"]}, {"entity_id": "diabo", "book_id": "coloquios_da_orta_1563", "name": "diabo", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["diabo"], "contexts": ["figure associated with devil", "influence on name change"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1