fermidade", "target_book": "first_principles_spencer_1862", "target_name": "illness", "similarity": 0.985}], "id": 694, "stable_key": "clu_ac6f9d2e620c93d4", "ground_truth": {"modern_name": "illness", "confidence": "high", "type": "disease", "modern_term": "illness", "note": "While 'enfermidade' can also mean sickness or infirmity, in the context of early modern medical texts, it broadly refers to a state of ill health or disease. 'Illness' is a suitable modern equivalent covering this range."}, "cross_references": [{"found_name": "males", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 3175, "target_cluster_name": "males", "source_book": "llm_generated", "evidence_snippet": "The entity 'illness' is given the historical name 'enfermidade', which is the Portuguese word for illness or sickness.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "reverse: The entity 'illness' is given the historical name 'enfermidade', which is the Portuguese word for illness or sickness.", "is_reverse": true}]}, {"canonical_name": "Kepler", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 23, "members": [{"entity_id": "kepler", "book_id": "kosmos_humboldt_1845", "name": "Kepler", "category": "PERSON", "subcategory": "SCHOLAR", "count": 12, "variants": ["Kepler"], "contexts": ["author of 'Epitome Astronomiae Copernicanae'", "astronomer on planetary density and volume"]}, {"entity_id": "kepler", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Kepler", "category": "PERSON", "subcategory": "SCHOLAR", "count": 7, "variants": ["Kepler"], "contexts": ["discovered laws of planetary motion", "astronomer known for planetary laws"]}, {"entity_id": "kepler", "book_id": "first_principles_spencer_1862", "name": "Kepler", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Kepler"], "contexts": ["discovered planetary motion laws", "generalizations of Kepler expressing planet motions"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Kepler", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Kepler", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Kepler", "target_book": "first_principles_spencer_1862", "target_name": "Kepler", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Kepler", "target_book": "first_principles_spencer_1862", "target_name": "Kepler", "similarity": 1.0}], "id": 695, "stable_key": "clu_28851b8e21ef4f3f", "ground_truth": {"modern_name": "Johannes Kepler", "confidence": "high", "type": "person", "birth_year": 1571, "death_year": 1630, "description": "Astronomer and mathematician, known for laws of planetary motion.", "wikidata_id": "Q8963", "wikidata_description": "German mathematician and astronomer (1571–1630)", "wikipedia_url": "https://en.wikipedia.org/wiki/Johannes%20Kepler", "wikipedia_extract": "Johannes Kepler (27 December 1571 – 15 November 1630) was a German astronomer, mathematician, astrologer, natural philosopher and music theorist. He is a key figure in the 17th-century Scientific Revolution, best known for his laws of planetary motion, and his books Astronomia nova, Harmonice Mundi, and Epitome Astronomiae Copernicanae. The variety and impact of his work made Kepler one of the founders and fathers of modern astronomy, the scientific method, natural science, and modern science. He has been described as the \"father of science fiction\" for his novel Somnium. Kepler was a mathematics teacher at a seminary school in Graz, where he became an associate of Prince Hans Ulrich von Eggenberg. Later he became an assistant to the astronomer Tycho Brahe in Prague, and eventually the imperial mathematician to Emperor Rudolf II and his two successors Matthias and Ferdinand II."}, "cross_references": [{"found_name": "Galileo Galilei", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 931, "target_cluster_name": "Galileo", "source_book": "llm_generated", "evidence_snippet": "Both were pivotal figures in the Scientific Revolution, with Kepler building upon and refining the work of Galileo, particularly in astronomy and physics.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were pivotal figures in the Scientific Revolution, with Kepler building upon and refining the work of Galileo, particularly in astronomy and physics."}, {"found_name": "Isaac Newton", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 71, "target_cluster_name": "Newton", "source_book": "llm_generated", "evidence_snippet": "Kepler's laws of planetary motion were a fundamental precursor to Newton's law of universal gravitation, forming a crucial link in the development of classical mechanics.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Kepler's laws of planetary motion were a fundamental precursor to Newton's law of universal gravitation, forming a crucial link in the development of classical mechanics."}, {"found_name": "mathematicians", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1337, "target_cluster_name": "mathematicians", "source_book": "llm_generated", "evidence_snippet": "Kepler was a mathematician and astronomer known for his laws of planetary motion, which involved significant mathematical calculations.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Kepler was a mathematician and astronomer known for his laws of planetary motion, which involved significant mathematical calculations.", "is_reverse": true}, {"found_name": "Messier", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2002, "target_cluster_name": "Messier", "source_book": "llm_generated", "evidence_snippet": "Johannes Kepler was a German astronomer and mathematician whose laws of planetary motion and