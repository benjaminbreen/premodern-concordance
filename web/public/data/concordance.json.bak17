s": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Seneca", "target_book": "kosmos_humboldt_1845", "target_name": "Seneca", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Seneca", "target_book": "coloquios_da_orta_1563", "target_name": "Séneca", "similarity": 0.688}, {"source_book": "kosmos_humboldt_1845", "source_name": "Seneca", "target_book": "coloquios_da_orta_1563", "target_name": "Séneca", "similarity": 0.688}], "id": 746, "stable_key": "clu_03ad3af5e4336b2c", "ground_truth": {"modern_name": "Seneca", "confidence": "high", "type": "person", "birth_year": -4, "death_year": 65, "description": "Roman Stoic philosopher, statesman, and playwright.", "wikidata_id": "Q2054", "wikidata_description": "Roman Stoic philosopher, statesman and dramatist (c. 4 BCE–65 CE)", "wikipedia_url": "https://en.wikipedia.org/wiki/Seneca%20the%20Younger", "wikipedia_extract": "Lucius Annaeus Seneca the Younger ( SEN-ik-ə; c. 4 BC – AD 65), usually known mononymously as Seneca, was a Stoic philosopher of Ancient Rome, a statesman, a dramatist, and in one work, a satirist, from the post-Augustan age of Latin literature. Seneca was born in Colonia Patricia Corduba in Hispania, and was trained in rhetoric and philosophy in Rome. His father was Seneca the Elder, his elder brother was Lucius Junius Gallio Annaeanus, and his nephew was the poet Lucan. In AD 41, Seneca was exiled to the island of Corsica under emperor Claudius, but was allowed to return in 49 to become a tutor to Nero. When Nero became emperor in 54, Seneca became his advisor and, together with the praetorian prefect Sextus Afranius Burrus, provided competent government for the first five years of Nero's reign."}, "cross_references": [{"found_name": "Galen", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 29, "target_cluster_name": "Galen", "source_book": "llm_generated", "evidence_snippet": "Both were highly influential physicians and medical writers in antiquity, forming the bedrock of medical knowledge for centuries.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were highly influential physicians and medical writers in antiquity, forming the bedrock of medical knowledge for centuries."}, {"found_name": "Dioscorides", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 33, "target_cluster_name": "Dioscorides", "source_book": "llm_generated", "evidence_snippet": "Both were significant figures in ancient pharmacology and botany, with Dioscorides focusing on materia medica and Seneca on broader philosophical and ethical topics, but their works were foundational for later scientific inquiry.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were significant figures in ancient pharmacology and botany, with Dioscorides focusing on materia medica and Seneca on broader philosophical and ethical topics, but their works were foundational for later scientific inquiry."}, {"found_name": "Aristotle", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 62, "target_cluster_name": "Aristotle", "source_book": "llm_generated", "evidence_snippet": "Both were towering figures in ancient philosophy, with Aristotle's influence spanning logic, metaphysics, ethics, and natural sciences, while Seneca was a prominent Stoic philosopher and statesman.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were towering figures in ancient philosophy, with Aristotle's influence spanning logic, metaphysics, ethics, and natural sciences, while Seneca was a prominent Stoic philosopher and statesman."}]}, {"canonical_name": "scale", "category": "OBJECT", "subcategory": "TOOL", "book_count": 3, "total_mentions": 18, "members": [{"entity_id": "scale", "book_id": "english_physician_1652", "name": "Scale", "category": "OBJECT", "subcategory": "TOOL", "count": 1, "variants": ["Scale"], "contexts": ["measuring instrument"]}, {"entity_id": "scale", "book_id": "ricettario_fiorentino_1597", "name": "Scale", "category": "OBJECT", "subcategory": "TOOL", "count": 1, "variants": ["Scale"], "contexts": ["measuring instrument"]}, {"entity_id": "scale", "book_id": "polyanthea_medicinal", "name": "scale", "category": "OBJECT", "subcategory": "TOOL", "count": 16, "variants": ["scale", "Scale", "scales"], "contexts": ["an instrument for weighing", "instrument for weighing"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Scale", "target_book": "ricettario_fiorentino_1597", "target_name": "Scale", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Scale", "target_book": "polyanthea_medicinal", "target_name": "scale", "similarity": 0.974}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Scale", "target_book": "polyanthea_medicinal", "target_name": "scale", "similarity": 0.974}], "id": 747, "stable_key": "clu_a21f70e026048f79", "ground_truth": {"modern_name": "Scale (weighing)", "confidence": "high", "type": "object", "description": "Instrument used for measuring weight.", "note": "Refers to a weighing instrument, not a biological scale.", "wikipedia_extract": "A scale or balance is a device used to measure weight or mass. These are also known as mass scales, weight scales, mass balances, massometers, and weight balances. The traditional scale consists of two plates or bowls suspended at equal distances from a fulcrum. One plate holds an object of unknown mass (or weight), while objects of known mass or weight, called weights, are added to the other plate until mechanical equilibrium is achieved and the plates level off, which happens when the masses on the two plates are equal. The perfect scale rests at neutral. A spring scale will make use of a spring of known stiffness to determine mass (or weight)."}, "cross_references": [{"found_name": "Libra", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 3210, "target_cluster_name": "Libra", "source_book": "llm_generated", "evidence_snippet": "Libra is a Latin word for 'balance' or 'scale', and was historically used to refer to weighing instruments.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "Libra is a Latin word for 'balance' or 'scale', and was historically used to refer to weighing instruments."}, {"found_name": "Ounce (unit of weight)", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2237, "target_cluster_name": "onças", "source_book": "llm_generated", "evidence_snippet": "An ounce is a unit of weight often measured using scales. While not a scale itself, it is intrinsically linked to the function of a scale.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "An ounce is a unit of weight often measured using scales. While not a scale itself, it is intrinsically linked to the function of a scale."}, {"found_name": "Quintal", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2407, "target_cluster_name": "quintaes", "source_book": "llm_generated", "evidence_snippet": "A quintal is a unit of weight, typically measured using scales.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "A quintal is a unit of weight, typically measured using scales."}]}, {"canonical_name": "Fidalgo", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 18, "members": [{"entity_id": "fidalgo", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Fidalgo", "category": "PERSON", "subcategory": "SCHOLAR", "count": 12, "variants": ["Fidalgo"], "contexts": ["led a maritime expedition", "published a map in 1816"]}, {"entity_id": "fidalgo", "book_id": "coloquios_da_orta_1563", "name": "fidalgo", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["fidalgo"], "contexts": ["nobleman"]}, {"entity_id": "fidalgo", "book_id": "polyanthea_medicinal"