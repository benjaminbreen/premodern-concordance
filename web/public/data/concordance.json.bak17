": 0.5, "target_cluster_id": 1541, "target_cluster_name": "ecliptic", "source_book": "llm_generated", "evidence_snippet": "The Moon's orbit is related to the ecliptic.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Moon's orbit is related to the ecliptic."}, {"found_name": "Elliptical orbit", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2341, "target_cluster_name": "elliptical orbit", "source_book": "llm_generated", "evidence_snippet": "The Moon follows an elliptical orbit around the Earth.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Moon follows an elliptical orbit around the Earth."}, {"found_name": "Gravity", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 77, "target_cluster_name": "gravity", "source_book": "llm_generated", "evidence_snippet": "The Moon's motion is governed by gravity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Moon's motion is governed by gravity."}, {"found_name": "Lunar attraction", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4539, "target_cluster_name": "lunar attraction", "source_book": "llm_generated", "evidence_snippet": "Lunar attraction is a direct consequence of the Moon's gravitational influence.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Lunar attraction is a direct consequence of the Moon's gravitational influence."}, {"found_name": "Astronomy", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 276, "target_cluster_name": "astronomy", "source_book": "llm_generated", "evidence_snippet": "The study of the Moon is a core part of astronomy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The study of the Moon is a core part of astronomy."}]}, {"canonical_name": "convulfoens", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 116, "members": [{"entity_id": "convulsers", "book_id": "english_physician_1652", "name": "Convulsers", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["Convulsers", "Con∣vulsion"], "contexts": ["causing convulsions", "condition helped by powder in wine"]}, {"entity_id": "convulfoens", "book_id": "polyanthea_medicinal", "name": "convulfoens", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 114, "variants": ["convulfoens", "Conves", "Convul", "Convulf.", "Convulfai", "Convulfao", "Convulfaó", "Convulfaõ", "Convulfaō", "Convulfio", "Convulfione", "Convulfoens", "Convulfoes", "Convulfoés", "Convulsaao", "Convulsai", "Convulsao", "Convulsaō", "Convulsione", "Convulsoens", "Convulsões", "Convulíao", "Convulſao", "Convulſaó", "convulfam", "convulfao", "convulfaó", "convulfio", "convulfiofit", "convulfionem", "convulfionibus", "convulfivos", "convulfo", "convulfoens dos nervos", "convulfoes", "convulfoés", "convulfus", "convulfão", "convulloés tetanicas", "convulortu", "convulsa", "convulsao", "convulsaó", "convulsio", "convulsio lethalis", "convulsivo", "convulsoens", "convulsoes", "convulsos", "convulsão", "convulsões", "convulſao", "convulſoens Tetanicas", "convulſoés", "de convulortu", "motus convulfivos"], "contexts": ["convulsions", "medical condition treated with sudorifics"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Convulsers", "target_book": "polyanthea_medicinal", "target_name": "convulfoens", "similarity": 0.897}], "id": 1503, "stable_key": "clu_57c39c8354c3de1b", "ground_truth": {"modern_name": "convulsions", "confidence": "high", "type": "disease", "description": "A medical condition characterized by sudden, involuntary muscle contractions.", "wikipedia_extract": "A convulsion is a medical condition where the body muscles contract and relax rapidly and repeatedly, resulting in uncontrolled shaking. Because epileptic seizures typically include convulsions, the term convulsion is often used as a synonym for seizure. However, not all epileptic seizures result in convulsions, and not all convulsions are caused by epileptic seizures. Non-epileptic convulsions have no relation with epilepsy, and are caused by non-epileptic seizures. Convulsions can be caused by epilepsy, infections (including a severe form of listeriosis which is caused by eating food contaminated by Listeria monocytogenes), brain trauma, or other medical conditions. They can also occur from an electric shock or improperly enriched air for scuba diving."}, "cross_references": [{"found_name": "Torturada boca", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": null, "target_cluster_name": null, "source_book": "polyanthea_medicinal", "evidence_snippet": "Parleſia da boca,&do roſto, a quevulgarmente chamão Torturada boca. Tratado 2. fol. 124. CAP. XVIII. Da Parleſia do ſeſſo. Tratado 2. fol. 127. CAP. XIX. Da Convulſao, & Eſpaſmo. Tratado 2. fol. 129. ", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "vulgar name for paralysis of the mouth and face"}]}, {"canonical_name": "rins", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 116, "members": [{"entity_id": "rins", "book_id": "coloquios_da_orta_1563", "name": "rins", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 7, "variants": ["rins", "rijs"], "contexts": ["body part", "kidneys, body organs"]}, {"entity_id": "rins", "book_id": "polyanthea_medicinal", "name": "rins", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 109, "variants": ["rins", "Rins", "os rins", "rins dehum homem", "rinsas"], "contexts": ["organ of the urinary system", "kidneys"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "rins", "target_book": "polyanthea_medicinal", "target_name": "rins", "similarity": 1.0}], "id": 1504, "stable_key": "clu_0510e2737fca32bb", "ground_truth": {"modern_name": "Kidneys", "confidence": "high", "type": "substance", "description": "Organs of the urinary system responsible for filtering blood.", "wikipedia_extract": "In humans, the kidneys are two reddish-brown bean-shaped blood-filtering organs that are a multilobar, multipapillary form of mammalian kidneys, usually without signs of external lobulation. They are located on the left and right in the retroperitoneal space, and in adult humans are about 12 centimetres (4+1⁄2 inches) in length. They receive blood from the paired renal arteries; blood exits into the paired renal veins. Each kidney is attached to a ureter, a tube that carries excreted urine to the bladder. The kidney participates in the control of the volume of various body fluids, fluid osmolality, acid–base balance, various electrolyte concentrations, and removal of toxins. Filtration occurs in the glomerulus: one-fifth of the blood volume that enters the kidneys is filtered."}, "cross_references": [{"found_name": "Organs", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 141, "target_cluster_name": "organs", "source_book": "llm_generated", "evidence_snippet": "The kidneys are a type of organ.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The kidneys are a type of organ."}]}, {"canonical_name": "caldo", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 111, "members": [{"entity_id": "caldo", "book_id": "historia_medicinal_monardes_1574", "name": "caldo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["caldo", "caldo de ave"], "contexts": ["broth, a liquid preparation", "broth"]}, {"entity_id": "caldo", "book_id": "polyanthea_medicinal", "name": "caldo", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 106, "variants": ["caldo", "calda", "caldade", "caldo de frangao", "caldo de frangaó", "caldo de frangaõ", "caldo de frangaō", "caldo de frangão", "caldo de gallinha", "caldo de gallo velho", "caldo degallinha", "caldode frangao", "caldode frangaó", "caldode frangão", "caldode gallinha", "caldodefranga", "caldodegallinha", "caldos", "caldos de Aveya", "caldos de cevada", "caldos de cágados", "caldos de gallinha", "caldos de goma", "caldos deaguados farelos", "caldos degoma", "caldosgordos"], "contexts": ["simple broth used as medicine", "broth given to facilitate purging"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "caldo", "target_book": "polyanthea_medicinal", "target_name": "caldo", "similarity": 0.89}], "id": 1505, "stable_key": "clu_05e4d1870a5e13f8", "ground_truth": {"modern_name": "broth", "confidence": "high", "type": "substance", "description": "A simple liquid preparation, often used as medicine or as a base.", "wikipedia_extract": "Broth, also known as bouillon (French pronunciation: [bujɔ̃] ), is a savory liquid made of water in which meat, fish, or vegetables have been simmered for a period of time. It can be eaten alone, but it is most commonly used to prepare other dishes, such as soups, gravies, and sauces. Commercially prepared liquid broths are available, typically chicken, beef, fish, and vegetable varieties. Dehydrated broth in the form of bouillon cubes was commercialized beginning in the early 20th century. Many cooks and food writers use the terms broth and stock interchangeably. In 1974, James Beard (an American cook) wrote that stock, broth, and bouillon \"are all the same thing\"."}, "cross_references": [{"found_name": "Grana", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1036, "target_cluster_name": "Grana", "source_book": "llm_generated", "evidence_snippet": "Broth can be made from grains or used to cook grains.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Broth can be made from grains or used to cook grains.", "is_reverse": true}, {"found_name": "Meat", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 219, "target_cluster_name": "carne", "source_book": "llm_generated", "evidence_snippet": "Broth is typically made by simmering meat.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Broth is typically made by simmering meat."}, {"found_name": "Food", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 615, "target_cluster_name": "alimentos", "source_book": "llm_generated", "evidence_snippet": "Broth is a type of food.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Broth is a type of food."}, {"found_name": "Beverage", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 321, "target_cluster_name": "licor", "source_book": "llm_generated", "evidence_snippet": "Broth can be consumed as a beverage.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Broth can be consumed as a beverage."}, {"found_name": "Decoctions", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 786, "target_cluster_name": "cozimentos", "source_book": "llm_generated", "evidence_snippet": "Broth is a type of decoction, a liquid made by boiling or simmering ingredients.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Broth is a type of decoction, a liquid made by boiling or simmering ingredients."}, {"found_name": "cozimento", "link_type": "derivation", "link_strength": 0.4, "target_cluster_id": 1654, "target_cluster_name": "cozimento", "source_book": "ricettario_fiorentino_1597", "evidence_snippet": ", cotte che le tono; o vero per feruirfi dell huixiore , nel quale Tono Hate cotte. Quelle , che fi cuo- cono per adoperarle cotte, ricercano minor cottura^^che quel 1^, de le quali (i adoperala decoz", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "reverse: derived from", "is_reverse": true}]}, {"canonical_name": "Ceylão", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 100, "members": [{"entity_id": "ceylan", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Ceylan", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Ceylan", "Ceylon"], "contexts": ["island included in total", "island with average air temperature data"]}, {"entity_id": "ceylão", "book_id": "coloquios_da_orta_1563", "name": "Ceylão", "category": "PLACE", "subcategory": "COUNTRY", "count": 97, "variants": ["Ceylão", "Ceilam", "Ceilão", "CeylSo", "Ceylao", "Ceylon", "Ceyláo"], "contexts": ["island nation", "island nation (Sri Lanka)"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Ceylan", "target_book": "coloquios_da_orta_1563", "target_name": "Ceylão", "similarity": 0.906}], "id": 1506, "stable_key": "clu_12728a3f0df10827", "ground_truth": {"modern_name": "Sri Lanka", "confidence": "high", "type": "place", "description": "Island nation in South Asia, formerly known as Ceylon.", "wikipedia_extract": "Sri Lanka, officially the Democratic Socialist Republic of Sri Lanka, formerly known as Ceylon, is an island country in South Asia. It is located in the Indian Ocean, southwest of the Bay of Bengal, and is separated from India by the Gulf of Mannar and the Palk Strait. Sri Lanka shares a maritime border with the Maldives to the southwest and India to the northwest, and lies across the Bay of Bengal from Bangladesh and Myanmar to the northeast and the Andaman and Nicobar Islands of India to the east. Its capital is Sri Jayawardenepura Kotte, while Colombo is its largest city and the political, financial and cultural centre. Sri Lanka's population is 22 million; with the Sinhalese people, who speak the Sinhala language, forming the vast majority—while Tamil is spoken by the large Tamil minority. Other long-established ethnic groups include the Moors, Indian Tamils, Burghers, Malays, Chinese, and Vedda."}, "cross_references": [{"found_name": "Zeilan", "link_type": "same_referent", "link_streng