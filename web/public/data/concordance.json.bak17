s": [{"entity_id": "saturn", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Saturn", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 47, "variants": ["Saturn"], "contexts": ["planet in the solar system", "planet with rings"]}, {"entity_id": "saturn", "book_id": "first_principles_spencer_1862", "name": "Saturn", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Saturn"], "contexts": ["planet with rapid axial movement", "planet in the Solar System"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Saturn", "target_book": "first_principles_spencer_1862", "target_name": "Saturn", "similarity": 1.0}], "id": 1560, "stable_key": "clu_5951973b66eca1ce", "ground_truth": {"modern_name": "Saturn", "confidence": "low", "type": "animal", "note": "The context 'planet in the solar system' strongly suggests the celestial body, not an animal. The 'animal' classification is likely an error in the provided data.", "wikidata_id": "Q843104", "wikidata_description": "family of insects", "wikipedia_url": "https://en.wikipedia.org/wiki/Saturniidae", "wikipedia_extract": "Saturniidae, members of which are commonly named the saturniids, is a family of Lepidoptera with an estimated 2,300 described species. The family contains some of the largest species of moths in the world. Notable members include the emperor moths, royal moths, and giant silk moths (or wild silk moths). Adults are characterized by large, lobed wings, heavy bodies covered in hair-like scales, and reduced mouthparts. They lack a frenulum, but the hindwings overlap the forewings to produce the effect of an unbroken wing surface. Saturniids are sometimes brightly colored and often have translucent eyespots or \"windows\" on their wings."}, "cross_references": [{"found_name": "Astronomy", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 276, "target_cluster_name": "astronomy", "source_book": "llm_generated", "evidence_snippet": "Saturn is a planet, a subject of astronomical study.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Saturn is a planet, a subject of astronomical study."}, {"found_name": "Celestial body", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3227, "target_cluster_name": "celestial body", "source_book": "llm_generated", "evidence_snippet": "Saturn is a celestial body.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Saturn is a celestial body."}, {"found_name": "Genus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 263, "target_cluster_name": "genus", "source_book": "llm_generated", "evidence_snippet": "Saturn is a genus in biological classification, and the entity refers to the family Saturniidae, which contains multiple genera.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Saturn is a genus in biological classification, and the entity refers to the family Saturniidae, which contains multiple genera."}, {"found_name": "Class (taxonomy)", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 735, "target_cluster_name": "classes", "source_book": "llm_generated", "evidence_snippet": "Saturniidae is a family within the order Lepidoptera, which is a class in biological taxonomy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Saturniidae is a family within the order Lepidoptera, which is a class in biological taxonomy."}]}, {"canonical_name": "Cough", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 48, "members": [{"entity_id": "cough", "book_id": "english_physician_1652", "name": "Cough", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 47, "variants": ["Cough", "Coughs", "cough", "coughing"], "contexts": ["cough rid away by the herb", "condition helped by bugloss electuary"]}, {"entity_id": "cough", "book_id": "first_principles_spencer_1862", "name": "cough", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["cough"], "contexts": ["sudden expulsion of air from lungs"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Cough", "target_book": "first_principles_spencer_1862", "target_name": "cough", "similarity": 0.841}], "id": 1561, "stable_key": "clu_b22d07fb0c66ae0c", "ground_truth": {"modern_name": "Cough", "confidence": "high", "type": "disease", "modern_term": "Cough", "wikidata_id": "Q35805", "wikidata_description": "medical symptom, reflex to clear large breathing passages", "wikipedia_extract": "A cough is a sudden expulsion of air through the large breathing passages which can help clear them of fluids, irritants, foreign particles and microbes. As a protective reflex, coughing can be repetitive with the cough reflex following three phases: an inhalation, a forced exhalation against a closed glottis, and a violent release of air from the lungs following opening of the glottis, usually accompanied by a distinctive sound. Coughing into one's elbow or toward the ground—rather than forward at breathing height—can reduce the spread of infectious droplets in the air. Frequent coughing usually indicates the presence of a disease. Many viruses and bacteria benefit, from an evolutionary perspective, by causing the host to cough, which helps to spread the disease to new hosts. Irregular coughing is usually caused by a respiratory tract infection but can also be triggered by choking, smoking, air pollution, asthma, gastroesophageal reflux disease, post-nasal drip, chronic bronchitis, lung tumors, heart failure and medications such as angiotensin-converting-enzyme inhibitors (ACE inhibitors) and beta blockers.", "wikipedia_url": "https://en.wikipedia.org/wiki/Cough"}, "cross_references": [{"found_name": "Wheesing", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2097, "target_cluster_name": "Wheesing", "source_book": "llm_generated", "evidence_snippet": "Wheezing is a high-pitched whistling sound made while breathing, often associated with a cough, particularly in respiratory conditions.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "Wheezing is a high-pitched whistling sound made while breathing, often associated with a cough, particularly in respiratory conditions."}, {"found_name": "consumption", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 73, "target_cluster_name": "consumption", "source_book": "llm_generated", "evidence_snippet": "A persistent cough is a hallmark symptom of phthisis, particularly pulmonary tuberculosis.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: A persistent cough is a hallmark symptom of phthisis, particularly pulmonary tuberculosis.", "is_reverse": true}, {"found_name": "Pleurisy", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 188, "target_cluster_name": "Pleurisy", "source_book": "llm_generated", "evidence_snippet": "Cough is a common symptom of pleurisy, as the inflammation can irritate the lungs and chest cavity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Cough is a common symptom of pleurisy, as the inflammation can irritate the lungs and chest cavity.", "is_reverse": true}, {"found_name": "Asthma", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 550, "target_cluster_name": "Asthma", "source_book": "llm_generated", "evidence_snippet": "Asthma is a chronic respiratory disease characterized by inflammation and narrowing of the airways, often leading to coughing, wheezing, and shortness of breath.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Asthma is a chronic respiratory disease characterized by inflammation and narrowing of the airways, often leading to coughing, wheezing, and shortness of breath."}, {"found_name": "Pneumonia", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3755, "target_cluster_name": "pneumonia", "source_book": "llm_generated", "evidence_snippet": "Pneumonia is an infection that inflames the air sacs in one or both lungs, frequently causing a cough, often with phlegm or pus.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Pneumonia is an infection that inflames the air sacs in one or both lungs, frequently causing a cough, often with phlegm or pus."}]}, {"canonical_name": "Bogota", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 92, "members": [{"entity_id": "bogota", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bogota", "category": "PLACE", "subcategory": "CITY", "count": 45, "variants": ["Bogota", "BOGOTA"], "contexts": ["city with population 172,000", "origin of flours"]}, {"entity_id": "bogota", "book_id": "kosmos_humboldt_1845", "name": "Bogota", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Bogota"], "contexts": ["location of subterranean thunder", "city in Colombia"]}, {"entity_id": "santa-fe_de_bogota", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Santa-Fe de Bogota", "category": "PLACE", "subcategory": "CITY", "count": 42, "variants": ["Santa-Fe de Bogota", "S. Fe de Bogota", "SaNTA-Fe DE BoGOTA", "Sanla-Fe de Bogoià", "Sanla-Fe de Bogota", "Santa Fe de Bogota", "Santa Fé de Bogota", "Santa-Fede Bogota", "Santa-Fé de Bogota"], "contexts": ["city in Colombia", "city and capital of Nouvelle-Grenade"]}, {"entity_id": "santa_fe_de_bogota", "book_id": "kosmos_humboldt_1845", "name": "Santa Fe de Bogota", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Santa Fe de Bogota"], "contexts": ["location with specific altitude and temperature", "location with specific latitude and altitude"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bogota", "target_book": "kosmos_humboldt_1845", "target_name": "Bogota", "similarity": 1.0}], "id": 1562, "stable_key": "clu_c0ac942d4f7d5ea7", "ground_truth": {"modern_name": "Bogotá", "confidence": "high", "type": "place", "country": "Colombia", "wikidata_id": "Q10432089", "wikidata_description": "genus of insects", "wikipedia_extract": "Colombia, officially the Republic of Colombia, is a country primarily located in South America with insular regions in North America. The Colombian mainland is bordered by the Caribbean Sea to the north, Venezuela to the east and northeast, Brazil to the southeast, Peru and Ecuador to the south and southwest, the Pacific Ocean to the west, and Panama to the northwest. Colombia is divided into 32 departments. The Capital District of Bogotá is also the country's largest city hosting the main financial and cultural hub. Other major urban areas include Medellín, Cali, Barranquilla, Cartagena, Bucaramanga, Pereira, Santa Marta, Cúcuta, Ibagué, Villavicencio and Manizales. It covers an area of 1,141,748 square kilometers (440,831 sq mi) and has a population of around 52 million.", "wikipedia_url": "https://en.wikipedia.org/wiki/Colombia"}, "member_count": 4, "cross_references": [{"found_name": "Popayan", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1548, "target_cluster_name": "Popayan", "source_book": "llm_generated", "evidence_snippet": "Bogotá was the capital of the Viceroyalty of New Granada, of which Popayán was a major city and administrative center.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Bogotá was the capital of the Viceroyalty of New Granada, of which Popayán was a major city and administrative center.", "is_reverse": true}, {"found_name": "Antioquia", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1757, "target_cluster_name": "Antioquia", "source_book": "llm_generated", "evidence_snippet": "Antioquia was a historical province and is now a department of Colombia, of which Bogotá is the capital.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Antioquia was a historical province and is now a department of Colombia, of which Bogotá is the capital."}, {"found_name": "Equatorial America", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1437, "target_cluster_name": "equatorial America", "source_book": "llm_generated", "evidence_snippet": "Bogotá is located in Equatorial America.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Bogotá is located in Equatorial America."}, {"found_name": "Brazil", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 96, "target_cluster_name": "Brasil", "source_book": "llm_generated", "evidence_snippet": "Brazil is a neighboring country to Colombia, where Bogotá is located.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Brazil is a neighboring country to Colombia, where Bogotá is located."}, {"found_name": "Rio Magdalena", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1621, "target_cluster_name": "Rio Magdalena", "source_book": "llm_generated", "evidence_snippet": "Bogotá is the capital of Colombia, and the Magdalena River is its principal river.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Bogotá is the capital of Colombia, and the Magdalena River is its principal river.", "is_reverse": true}, {"found_name": "Los Pastos", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2114, "target_cluster_name": "Los Pastos", "source_book": "llm_generated", "evidence_snippet": "Bogotá is the capital of Colombia, the country in which Pasto is located. Both are major cities within the same nation.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Bogotá is the capital of Colombia, the country in which Pasto is located. Both are major cities within the same nation.", "is_reverse": true}]}, {"canonical_name": "frialdade", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 48, "members": [{"entity_id": "frialdades", "book_id": "historia_medicinal_monardes_1574", "name": "frialdades", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["frialdades"], "contexts": ["coldness of the womb", "coldnesses"]}, {"entity_id": "frialdade", "book_id": "polyanthea_medicinal", "name": "frialdade", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 45, "variants": ["frialdade", "Frialdade", "fria"], "contexts": ["excess of coldness affecting memory", "quality of the body"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "frialdades", "target_book": "polyanthea_medicinal", "target_name": "frialdade", "similarity": 0.951}], "id": 1563, "stable_key": "clu_aeeca3c83020fa5b", "ground_truth": {"modern_name": "coldness", "confidence": "high", "type": "CONCEPT", "description": "A bodily quality or state associated with low temperature or lack of heat.", "note": "Refers to the humoral concept of coldness affecting the body.", "wikipedia_extract": "In statistical thermodynamics, thermodynamic beta, also known as coldness, is the reciprocal of the thermodynamic temperature of a system: {\\displaystyle \\beta \\equiv {\\frac {1}{k_{\\rm {B}}T}}} (where T is the temperature and kB is Boltzmann constant). Thermodynamic beta has units reciprocal to that of energy (in SI units, reciprocal joules, {\\displaystyle [\\beta ]={\\textrm {J}}^{-1}} ). In non-thermal units, it can also be measured in byte per joule, or more conveniently, gigabyte per nanojoule; 1 K−1 is equivalent to about 13,062 gigabytes per nanojoule; at room temperature: T = 300K, β ≈ 44 GB/nJ ≈ 39 eV−1 ≈ 2.4×1020 J−1. The conversion factor is 1 GB/nJ = Thermodynamic beta is essentially the connection between the information theory and statistical mechanics interpretation of a physical system through its entropy and the thermodynamics associated with its energy. It expresses the response of entropy to an increase in energy. If a small amount of energy is added to the system, then β describes the amount the system will randomize."}, "cross_references": []}, {"canonical_name": "Almecega", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 48, "members": [{"entity_id": "almecega", "book_id": "coloquios_da_orta_1563", "name": "almecega", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["almecega", "almécega"], "contexts": ["ingredient in falcon plaster", "mastic, used in oil preparation"]}, {"entity_id": "almecega", "book_id": "polyanthea_medicinal", "name": "Almecega", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 43, "variants": ["almecega", "Almecega"], "contexts": ["ingredient in a pill for vomiting", "spice used in a preparation"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "almecega", "target_book": "polyanthea_medicinal", "target_name": "Almecega", "similarity": 0.845}], "id": 1564, "stable_key": "clu_734310c5c28b8ae4", "ground_truth": {"modern_name": "mastic", "confidence": "high", "type": "PLANT", "linnaean": "Pistacia lentiscus", "family": "Anacardiaceae", "description": "Aromatic resin from the mastic tree, used medicinally and as a spice.", "note": "Also known as Almaciga. 'Almecega do Brasil' likely refers to related species or similar resins.", "wikipedia_extract": "Pistacia lentiscus (also lentisk or mastic) is a dioecious evergreen shrub or small tree of the genus Pistacia native to the Mediterranean Basin. It grows up to 4 m (13 ft) tall and is cultivated for its aromatic resin, mainly on the Greek island of Chios, around the Turkish town of Çeşme and northern parts of Iraq. The plant is evergreen, from 1 to 5 m (3 ft 3 in to 16 ft 5 in) high, with a strong smell of resin, growing in dry and rocky areas in North Africa and Mediterranean Europe. It resists mild to heavy frosts but prefers milder winters and grows on all types of soils, and can grow well in limestone areas and even in salty or saline environments, making it more abundant near the sea. It is also found in woodlands, dehesas (almost deforested pasture areas), Kermes oak woods, wooded areas dominated by other oaks, garrigues, maquis shrublands, hills, gorges, canyons, and rocky hillsides of the entire Mediterranean area. It is a typical species of Mediterranean mixed communities which include myrtle, Kermes oak, Mediterranean dwarf palm, buckthorn and sarsaparilla, and serves as protection and food for birds and other fauna in this ecosystem."}, "cross_references": []}, {"canonical_name": "aceto", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 48, "members": [{"entity_id": "aceto", "book_id": "ricettario_fiorentino_1597", "name": "aceto", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 42, "variants": ["aceto", "Aceto", "Aceto bianco", "Aceto bianco forte", "Aceto bianico", "Aceto biianico", "Aceto buonodi", "Aceto fciUiticQ", "Aceto for. Un^onjii.", "Aceto fortilsimo", "Aceto fortissimo", "Aceto scilliticoso", "Acetobuono di vino", "Acetofi", "Acetoia", "aceto bianco forte", "aceto fenzjt", "aceto fo", "aceto forte", "aceto ftiliato"], "contexts": ["liquid used to kill cantherelle", "liquid producing vapors and rust"]}, {"entity_id": "aceto", "book_id": "polyanthea_medicinal", "name": "aceto", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 6, "variants": ["aceto", "acetofo", "acetopuro"], "contexts": ["vinegar, used in remedies", "used in preparations"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "aceto", "target_book": "polyanthea_medicinal", "target_name": "aceto", "similarity": 0.868}], "id": 1565, "stable_key": "clu_8437d3c06d1b2e1a", "ground_truth": {"modern_name": "vinegar", "confidence": "high", "type": "chemical", "wikidata_id": "Q407153", "wikidata_description": "chemical compound", "wikipedia_url": "https://en.wikipedia.org/wiki/Ethyl%20acetate", "wikipedia_extract": "Ethyl acetate (commonly abbreviated EtOAc, ETAC or EA) is the organic compound with the formula CH3CO2CH2CH3, simplified to C4H8O2. This flammable, colorless liquid has a characteristic sweet smell (similar to pear drops) and is used in glues, nail polish removers, and the decaffeination process of tea and coffee. Ethyl acetate is the ester of ethanol and acetic acid; it is manufactured on a large scale for use as a solvent. Ethyl acetate was first synthesized by the Count de Lauraguais in 1759 by distilling a mixture of ethanol and acetic acid. In 2004, an estimated 1.3 million tonnes were produced worldwide. The combined annual production in 1985 of Japan, North America, and Europe was about 400,000 tonnes."}, "cross_references": [{"found_name": "Acid", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1608, "target_cluster_name": "acidos", "source_book": "llm_generated", "evidence_snippet": "Vinegar is a type of acid (acetic acid).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Vinegar is a type of acid (acetic acid)."}, {"found_name": "Alcohol", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 131, "target_cluster_name": "alcohol", "source_book": "llm_generated", "evidence_snippet": "Vinegar is produced by the oxidation of alcohol.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Vinegar is produced by the oxidation of alcohol."}, {"found_name": "Donkey milk", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3187, "target_cluster_name": "leite azedo", "source_book": "llm_generated", "evidence_snippet": "Both are described as 'leite azedo' (sour milk) in Portuguese, suggesting a shared characteristic of sourness or fermentation.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are described as 'leite azedo' (sour milk) in Portuguese, suggesting a shared characteristic of sourness or fermentation."}, {"found_name": "Squill vinegar", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4433, "target_cluster_name": "vinagre Eſquilitico", "source_book": "llm_generated", "evidence_snippet": "A specific type of vinegar.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "A specific type of vinegar."}]}, {"canonical_name": "fangue", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 47, "members": [{"entity_id": "fangue", "book_id": "ricettario_fiorentino_1597", "name": "fangue", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["fangue"], "contexts": ["blood, an improper part of animals", "removed from fat"]}, {"entity_id": "fangue", "book_id": "polyanthea_medicinal", "name": "fangue", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 44, "variants": ["fangue", "faguin", "fange", "fangu", "fangue albicante", "fangue muyto quente", "fanguedos foros", "fanguemenstrual", "fanguine", "fanguinem", "fanguinis", "fanguis", "fangué", "fingue"], "contexts": ["bodily fluid, likely blood", "blood corrupted by waste"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "fangue", "target_book": "polyanthea_medicinal", "target_name": "fangue", "similarity": 1.0}], "id": 1566, "stable_key": "clu_ad00c60e96254f7d-2", "ground_truth": {"modern_name": "blood", "confidence": "high", "type": "substance", "description": "The red bodily fluid circulating in humans and animals.", "wikipedia_extract": "Blood is a body fluid in the circulatory system of humans and other vertebrates that delivers necessary substances such as nutrients and oxygen to the cells, and transports metabolic waste products away from those same cells. Blood is composed of blood cells suspended in plasma. Plasma, which constitutes 55% of blood fluid, is mostly water (92% by volume), and contains proteins, glucose, mineral ions, and hormones. The blood cells are mainly red blood cells (erythrocytes), white blood cells (leukocytes), and (in mammals) platelets (thrombocytes). The most abundant cells are red blood cells. These contain hemoglobin, which facilitates oxygen transport by reversibly binding to it, increasing its solubility."}, "cross_references": [{"found_name": "sangue", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1488, "target_cluster_name": "sangue", "source_book": "llm_generated", "evidence_snippet": "This is a direct synonym for 'blood' in Portuguese.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "This is a direct synonym for 'blood' in Portuguese."}, {"found_name": "bodily fluid", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 144, "target_cluster_name": "moisture", "source_book": "llm_generated", "evidence_snippet": "Blood is a specific type of bodily fluid.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Blood is a specific type of bodily fluid."}, {"found_name": "humors", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 28, "target_cluster_name": "humores", "source_book": "llm_generated", "evidence_snippet": "In premodern medicine, blood was considered one of the four cardinal humors.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "In premodern medicine, blood was considered one of the four cardinal humors."}, {"found_name": "choleric humor", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 601, "target_cluster_name": "Choller", "source_book": "llm_generated", "evidence_snippet": "Blood was associated with the choleric humor in humoral theory.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Blood was associated with the choleric humor in humoral theory."}, {"found_name": "cold humors", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1773, "target_cluster_name": "humores frios", "source_book": "llm_generated", "evidence_snippet": "Blood was associated with the cold humors in humoral theory.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Blood was associated with the cold humors in humoral theory."}, {"found_name": "melancholic humors", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1814, "target_cluster_name": "humores melancolicos", "source_book": "llm_generated", "evidence_snippet": "Blood was associated with the melancholic humors in humoral theory.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Blood was associated with the melancholic humors in humoral theory."}, {"found_name": "viscous humors", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2229, "target_cluster_name": "viſta", "source_book": "llm_generated", "evidence_snippet": "Blood was considered a viscous humor in humoral theory.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Blood was considered a viscous humor in humoral theory."}]}, {"canonical_name": "Vera-Cruz", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 46, "members": [{"entity_id": "vera-cruz", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Vera-Cruz", "category": "PLACE", "subcategory": "CITY", "count": 45, "variants": ["Vera-Cruz", "Veia-Cruz", "Vera Cruz", "Vera-Crut", "Vera-Gruz", "Vrra-Cruz", "la Vera-Cruz"], "contexts": ["destination city", "city for financial transactions"]}, {"entity_id": "vera_cruz", "book_id": "coloquios_da_orta_1563", "name": "Vera Cruz", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Vera Cruz"], "contexts": ["primitive name of Santa Cruz"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Vera-Cruz", "target_book": "coloquios_da_orta_1563", "target_name": "Vera Cruz", "similarity": 0.731}], "id": 1567, "stable_key": "clu_80805884e5a72eb7", "ground_truth": {"modern_name": "Veracruz", "confidence": "high", "type": "place", "country": "Mexico", "wikidata_id": "Q173270", "wikidata_description": "city of Veracruz, Mexico"}, "cross_references": []}, {"canonical_name": "Portocabello", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 46, "members": [{"entity_id": "portocabello", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Portocabello", "category": "PLACE", "subcategory": "CITY", "count": 44, "variants": ["Portocabello", "PORTO-CABELLO", "Por'obelo", "Porlo-Cabello", "Porto-Cabello", "Porto-Cahello", "Portobello", "Portobelo", "Pprlo-Cabello"], "contexts": ["city linked astronomically", "location with a granitic mountain chain"]}, {"entity_id": "porto_cabello", "book_id": "kosmos_humboldt_1845", "name": "Porto Cabello", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Porto Cabello"], "contexts": ["city near Trincheras hot springs", "city in Venezuela"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Portocabello", "target_book": "kosmos_humboldt_1845", "target_name": "Porto Cabello", "similarity": 0.854}], "id": 1568, "stable_key": "clu_266084074b01ee0a", "ground_truth": {"modern_name": "Puerto Cabello", "confidence": "high", "type": "place", "country": "Venezuela", "wikidata_id": "Q995695", "wikidata_description": "city in Venezuela", "wikipedia_url": "https://en.wikipedia.org/wiki/Puerto%20Cabello", "wikipedia_extract": "Puerto Cabello (Spanish pronunciation: [ˈpweɾto kaˈβeʝo] ) is a city on the north coast of Venezuela. It is located in Carabobo State, about 210 km west of Caracas. As of 2011, the city had a population of around 182,400. The city is home to the largest and busiest port in the country and is thus a vital cog in the country's vast oil industry. The word 'cabello' translates to 'hair'. The Spanish took to saying that the sea was so calm there that a ship could be moored to the dock with a single hair."}, "cross_references": [{"found_name": "Caracas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1497, "target_cluster_name": "Caracas", "source_book": "llm_generated", "evidence_snippet": "Caracas is the capital of Venezuela, and Puerto Cabello is a major port city within Venezuela, located relatively near Caracas.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Caracas is the capital of Venezuela, and Puerto Cabello is a major port city within Venezuela, located relatively near Caracas."}]}, {"canonical_name": "secco", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 8, "total_mentions": 64, "members": [{"entity_id": "seco", "book_id": "coloquios_da_orta_1563", "name": "seco", "category": "CONCEPT", "subcategory": "QUALITY", "count": 7, "variants": ["seco", "seca", "secco"], "contexts": ["quality of substances", "implied quality of substances"]}, {"entity_id": "secco", "book_id": "polyanthea_medicinal", "name": "secco", "category": "CONCEPT", "subcategory": "QUALITY", "count": 39, "variants": ["secco", "seca", "seccos", "seco"], "contexts": ["quality of being dry", "quality affecting the brain"]}, {"entity_id": "secura", "book_id": "coloquios_da_orta_1563", "name": "secura", "category": "CONCEPT", "subcategory": "QUALITY", "count": 3, "variants": ["secura"], "contexts": ["dryness", "quality of dryness"]}, {"entity_id": "secura", "book_id": "polyanthea_medicinal", "name": "secura", "category": "CONCEPT", "subcategory": "QUALITY", "count": 5, "variants": ["secura"], "contexts": ["dryness, a quality of substances", "Bodily quality of dryness"]}, {"entity_id": "dryness", "book_id": "origin_of_species_darwin_1859", "name": "dryness", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["dryness"], "contexts": ["environmental quality affecting plant growth"]}, {"entity_id": "dryness", "book_id": "principles_of_psychology_james_1890", "name": "dryness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["dryness"], "contexts": ["extreme quality in the dry direction"]}, {"entity_id": "dryness", "book_id": "kosmos_humboldt_1845", "name": "dryness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["dryness"], "contexts": ["observed in Northern Asia"]}, {"entity_id": "aridity", "book_id": "polyanthea_medicinal", "name": "aridity", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["aridity"], "contexts": ["quality of dryness"]}, {"entity_id": "dryness", "book_id": "connexion_physical_sciences_somerville_1858", "name": "dryness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["dryness"], "contexts": ["quality of lacking moisture"]}, {"entity_id": "sequedad", "book_id": "historia_medicinal_monardes_1574", "name": "sequedad", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["sequedad"], "contexts": ["quality of dryness", "dryness"]}, {"entity_id": "sequedad", "book_id": "coloquios_da_orta_1563", "name": "sequedad", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["sequedad"], "contexts": ["quality of dryness"]}, {"entity_id": "dry", "book_id": "principles_of_psychology_james_1890", "name": "Dry", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["Dry"], "contexts": ["quality of wine"]}, {"entity_id": "dry", "book_id": "ricettario_fiorentino_1597", "name": "Dry", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["Dry"], "contexts": ["quality of dryness"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "seco", "target_book": "polyanthea_medicinal", "target_name": "secco", "similarity": 0.929}], "id": 1569, "stable_key": "clu_6517a1d284222bc5", "ground_truth": {"modern_name": "dryness", "confidence": "high", "type": "concept", "note": "In humoral theory, 'dryness' was considered a fundamental quality of the four elements and humors, impacting physiology and the environment.", "wikidata_id": "Q5309747", "wikidata_description": "medical condition in which there is a decrease in normal lubrication of the skin or mucous membranes", "wikipedia_url": "https://en.wikipedia.org/wiki/Dryness%20%28medical%29", "wikipedia_extract": "Dryness is a medical condition in which there is local or more generalized decrease in normal lubrication of the skin or mucous membranes. Examples of local dryness include dry mouth, dry eyes, dry skin (xeroderma), diabetic foot and vaginal dryness. These often have specific causes and treatments. It is possible to have dry eyes without any other signs or symptoms, but this usually causes a syndrome of eye symptoms called keratoconjunctivitis sicca. More generalized dryness can be caused by e.g. dehydration (that is, more general loss of body fluids), anticholinergic drugs and Sjögren syndrome."}, "member_count": 13, "cross_references": [{"found_name": "Dry", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 38, "target_cluster_name": "dry", "source_book": "llm_generated", "evidence_snippet": "The entity 'dryness' is the abstract concept derived from the adjective 'dry'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The entity 'dryness' is the abstract concept derived from the adjective 'dry'."}]}, {"canonical_name": "Cevada", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 45, "members": [{"entity_id": "cevada", "book_id": "coloquios_da_orta_1563", "name": "cevada", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["cevada"], "contexts": ["barley, an ingredient", "grain used in a preparation for pain relief"]}, {"entity_id": "cevada", "book_id": "polyanthea_medicinal", "name": "Cevada", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 39, "variants": ["Cevada", "cevada", "ceveda", "cevoida"], "contexts": ["grain used in preparations", "barley"]}, {"entity_id": "cevadá", "book_id": "polyanthea_medicinal", "name": "cevadá", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["cevadá"], "contexts": ["grain used in decoction"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "cevada", "target_book": "polyanthea_medicinal", "target_name": "Cevada", "similarity": 0.636}, {"source_book": "coloquios_da_orta_1563", "source_name": "cevada", "target_book": "polyanthea_medicinal", "target_name": "cevadá", "similarity": 0.98}], "id": 1570, "stable_key": "clu_4f24a21053ea7b30", "ground_truth": {"modern_name": "Barley", "confidence": "high", "type": "PLANT", "linnaean": "Hordeum vulgare", "family": "Poaceae", "description": "Grain used as food and for medicinal preparations.", "wikipedia_extract": "Barley (Hordeum vulgare), a member of the grass family, is a major cereal grain grown in temperate climates globally. One of the first cultivated grains, it was domesticated in the Fertile Crescent around 9000 BC, giving it nonshattering spikelets and making it much easier to harvest. Its use then spread throughout Eurasia by 2000 BC. Barley prefers relatively low temperatures and well-drained soil to grow. It is relatively tolerant of drought and soil salinity, but is less winter-hardy than wheat or rye. In 2023, barley was fourth among grains in quantity produced, 146 million tonnes, behind maize, rice, and wheat."}, "cross_references": [{"found_name": "Corn", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 426, "target_cluster_name": "Corn", "source_book": "llm_generated", "evidence_snippet": "Barley and corn are both cereal grains, important in historical agriculture and diet.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Barley and corn are both cereal grains, important in historical agriculture and diet.", "is_reverse": true}, {"found_name": "Meal", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2698, "target_cluster_name": "Meal", "source_book": "llm_generated", "evidence_snippet": "Barley is a grain that is milled into flour or meal, and historical usage may conflate the terms.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Barley is a grain that is milled into flour or meal, and historical usage may conflate the terms.", "is_reverse": true}, {"found_name": "Farelos", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 287, "target_cluster_name": "Farelos", "source_book": "llm_generated", "evidence_snippet": "Bran is a component of cereal grains, including barley.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Bran is a component of cereal grains, including barley.", "is_reverse": true}, {"found_name": "Grains", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2320, "target_cluster_name": "grãos", "source_book": "llm_generated", "evidence_snippet": "Barley is a type of grain.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Barley is a type of grain."}, {"found_name": "Barley flour", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 614, "target_cluster_name": "farinha de cevada", "source_book": "llm_generated", "evidence_snippet": "Barley flour is derived from barley.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Barley flour is derived from barley."}, {"found_name": "Wheat", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 102, "target_cluster_name": "Wheat", "source_book": "llm_generated", "evidence_snippet": "Barley and wheat are both major cereal grains, often cultivated and discussed together.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Barley and wheat are both major cereal grains, often cultivated and discussed together."}, {"found_name": "Rice", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1695, "target_cluster_name": "Arroz", "source_book": "llm_generated", "evidence_snippet": "Barley, wheat, and rice are all staple cereal grains.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Barley, wheat, and rice are all staple cereal grains."}, {"found_name": "trigo", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1828, "target_cluster_name": "trigo", "source_book": "llm_generated", "evidence_snippet": "Wheat and Barley are both major cereal grains, often cultivated and used for similar purposes (e.g., bread, flour).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Wheat and Barley are both major cereal grains, often cultivated and used for similar purposes (e.g., bread, flour).", "is_reverse": true}, {"found_name": "milho miudo", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2880, "target_cluster_name": "milho miudo", "source_book": "llm_generated", "evidence_snippet": "Millet and barley are both cereal grains.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Millet and barley are both cereal grains.", "is_reverse": true}]}, {"canonical_name": "inchaços", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 5, "total_mentions": 89, "members": [{"entity_id": "inchaços", "book_id": "coloquios_da_orta_1563", "name": "inchaços", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 4, "variants": ["inchaços", "inchaços grandes"], "contexts": ["swellings", "swellings or edema"]}, {"entity_id": "inchaços", "book_id": "polyanthea_medicinal", "name": "inchaços", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 41, "variants": ["inchaços", "Inchaços", "inchada", "inchadas", "inchados", "inchar", "inchaçao", "inchaçaó depès", "inchaço", "inchaçoens", "inchação", "inchaçõe", "inchações"], "contexts": ["swellings", "swellings on plague victims"]}, {"entity_id": "dropsies", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "dropsies", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["dropsies"], "contexts": ["medical condition involving fluid accumulation"]}, {"entity_id": "dropsie", "book_id": "english_physician_1652", "name": "Dropsie", "category": "DISEASE", "subcategory": "CHRONIC", "count": 41, "variants": ["Dropsie", "Dropsies", "Dropsy"], "contexts": ["condition treated by the bark", "disease characterized by fluid accumulation"]}, {"entity_id": "dropsy", "book_id": "coloquios_da_orta_1563", "name": "dropsy", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["dropsy"], "contexts": ["chronic condition of fluid accumulation"]}, {"entity_id": "dropsy", "book_id": "first_principles_spencer_1862", "name": "dropsy", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["dropsy"], "contexts": ["condition in legs affected by gravity"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "inchaços", "target_book": "polyanthea_medicinal", "target_name": "inchaços", "similarity": 1.0}], "id": 1571, "stable_key": "clu_9d7984b38266ea84", "ground_truth": {"modern_name": "Swelling", "confidence": "high", "type": "disease", "modern_term": "Edema", "wikidata_id": "Q953049", "wikidata_description": "human disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Papilledema", "note": "While 'dropsy' is an older term, it directly refers to edema, especially when localized or generalized fluid accumulation.", "wikipedia_extract": "Papilledema or papilloedema is optic disc swelling that is caused by increased intracranial pressure due to any cause. The swelling is usually bilateral and can occur over a period of hours to weeks. Unilateral presentation is extremely rare. In intracranial hypertension, the optic disc swelling most commonly occurs bilaterally. When papilledema is found on fundoscopy, further evaluation is warranted because vision loss can result if the underlying condition is not treated. Further evaluation with a CT scan or MRI of the brain and/or spine is usually done."}, "member_count": 6, "cross_references": []}, {"canonical_name": "Elleboro negro", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 45, "members": [{"entity_id": "elleboro_nero", "book_id": "ricettario_fiorentino_1597", "name": "Elleboro nero", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["Elleboro nero", "ELLEBORO NERO", "Elleboro", "ellebori", "elleboro"], "contexts": ["black hellebore", "black hellebore, a medicinal herb"]}, {"entity_id": "elleboro_negro", "book_id": "polyanthea_medicinal", "name": "Elleboro negro", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 39, "variants": ["Elleboro negro", "Elleboro", "Elleboro branco", "Elleborum", "elleborismo", "elleboro", "elleboro branco", "elleboro negro", "elleborobranco", "raiz de elleboro negro", "raizes de elleboro negro", "raizesde Elleboro negro"], "contexts": ["root used in a preparation", "black hellebore root for tobacco remedy"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Elleboro nero", "target_book": "polyanthea_medicinal", "target_name": "Elleboro negro", "similarity": 0.959}], "id": 1572, "stable_key": "clu_fc40a8f82c935fb8", "ground_truth": {"modern_name": "Black Hellebore", "confidence": "high", "type": "plant", "description": "A poisonous plant (Helleborus niger) with medicinal uses, especially its root.", "note": "Commonly referred to as 'Elleboro negro' or 'Eleboro negro'.", "wikipedia_extract": "Veratrum nigrum, the black false hellebore, is a widespread Eurasian species of perennial flowering plant in the family Melanthiaceae. Despite its common name, V. nigrum is not closely related to the true hellebores, nor does it resemble them. The plant was widely known even in ancient times. For example, Lucretius (ca. 99 BCE – ca. 55 BCE) and Pliny the Elder (23 AD – August 25, 79) both knew of its medicinal emetic as well as deadly toxic properties. Veratrum nigrum is native to Eurasia from France to Korea including Germany, Poland, Russia, China, and Mongolia. The plant can exist in hardiness zones 4 through 7."}, "cross_references": []}, {"canonical_name": "Ætius", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 61, "members": [{"entity_id": "ætius", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Ætius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 6, "variants": ["Ætius"], "contexts": ["Byzantine medical writer", "ancient medical writer"]}, {"entity_id": "ætius", "book_id": "polyanthea_medicinal", "name": "Ætius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 38, "variants": ["Ætius", "Aeitius", "Aetius", "Atius", "Etius", "Ætins"], "contexts": ["medical writer", "ancient authority cited"]}, {"entity_id": "aecio", "book_id": "coloquios_da_orta_1563", "name": "Aecio", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 7, "variants": ["Aecio"], "contexts": ["ancient authority who spoke about amber", "ancient medical authority"]}, {"entity_id": "aeçio", "book_id": "coloquios_da_orta_1563", "name": "Aeçio", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Aeçio"], "contexts": ["ancient medical authority", "Greek physician"]}, {"entity_id": "aecio", "book_id": "polyanthea_medicinal", "name": "Aecio", "category": "PERSON", "subcategory": "AUTHORITY", "count": 8, "variants": ["Aecio"], "contexts": ["ancient medical authority", "cited medical authority"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ætius", "target_book": "polyanthea_medicinal", "target_name": "Ætius", "similarity": 1.0}], "id": 1573, "stable_key": "clu_8dda7c73af2aa4ca", "ground_truth": {"modern_name": "Aetius of Amida", "confidence": "high", "type": "person", "birth_year": 502, "death_year": 575, "description": "Byzantine medical writer, compiled influential medical encyclopedia.", "wikidata_id": "Q381956", "wikidata_description": "early 6th-century Byzantine physician", "wikipedia_url": "https://en.wikipedia.org/wiki/A%C3%ABtius%20of%20Amida", "wikipedia_extract": "Aëtius of Amida (; Ancient Greek: Ἀέτιος Ἀμιδηνός; Latin: Aëtius Amidenus; fl. mid-5th century to mid-6th century) was a Byzantine Greek physician and medical writer, particularly distinguished by the extent of his erudition. His birth and death years are not known, but his writings appear to date from the end of the 5th century or the beginning of the 6th. Aëtius was probably a Christian. If so, he would be among the earliest recorded Greek Christian physicians. He is sometimes confused with Aëtius of Antioch, a famous Arian who lived in the time of the Emperor Julian."}, "member_count": 5, "cross_references": [{"found_name": "Galen", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 29, "target_cluster_name": "Galen", "source_book": "llm_generated", "evidence_snippet": "Aetius of Amida was a Byzantine physician whose medical compilation extensively referenced and preserved Galen's teachings.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Aetius of Amida was a Byzantine physician whose medical compilation extensively referenced and preserved Galen's teachings.", "is_reverse": true}, {"found_name": "Alexander of Tralles", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1707, "target_cluster_name": "Tralianus", "source_book": "llm_generated", "evidence_snippet": "Both were prominent Byzantine physicians known for their extensive medical compilations.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were prominent Byzantine physicians known for their extensive medical compilations."}, {"found_name": "Aretaeus of Cappadocia", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3204, "target_cluster_name": "Areteus", "source_book": "llm_generated", "evidence_snippet": "Both were significant Greek physicians whose works were influential in later medical traditions.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were significant Greek physicians whose works were influential in later medical traditions."}, {"found_name": "Dioscorides", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 33, "target_cluster_name": "Dioscorides", "source_book": "llm_generated", "evidence_snippet": "Both were highly regarded medical writers whose works were foundational for pharmacology and materia medica.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were highly regarded medical writers whose works were foundational for pharmacology and materia medica."}, {"found_name": "Hippocrates", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 31, "target_cluster_name": "Hippocrates", "source_book": "llm_generated", "evidence_snippet": "Both were foundational figures in Greek medicine, with Hippocrates being the earlier, seminal figure and Aetius building upon and compiling earlier medical knowledge.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were foundational figures in Greek medicine, with Hippocrates being the earlier, seminal figure and Aetius building upon and compiling earlier medical knowledge."}, {"found_name": "Pareus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2093, "target_cluster_name": "Pareus", "source_book": "llm_generated", "evidence_snippet": "Both were prominent physicians whose collected works were important medical texts in the premodern period.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were prominent physicians whose collected works were important medical texts in the premodern period.", "is_reverse": true}]}, {"canonical_name": "betonica", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 44, "members": [{"entity_id": "betony", "book_id": "english_physician_1652", "name": "Betony", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Betony"], "contexts": ["herb used for various ailments and preparations", "little inferior to betony"]}, {"entity_id": "betonica", "book_id": "polyanthea_medicinal", "name": "betonica", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 40, "variants": ["betonica", "Betonica"], "contexts": ["herb used in preparation", "herb used in fomentation"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Betony", "target_book": "polyanthea_medicinal", "target_name": "betonica", "similarity": 0.887}], "id": 1574, "stable_key": "clu_b5b335da2a10e694", "ground_truth": {"modern_name": "Betony", "confidence": "high", "type": "plant", "linnaean": "Stachys officinalis", "family": "Lamiaceae", "description": "A herb with traditional medicinal uses.", "wikipedia_extract": "Betonica officinalis, common name betony is a species of flowering plant in the mint family Lamiaceae, native to Europe, western Asia, and northern Africa. Other vernacular names include wood betony, common hedgenettle, purple betony, bishopwort, or bishop's wort. It was until recently usually included in the genus Stachys as its synonym Stachys officinalis, but Betonica was separated at genus rank from Stachys when a detailed examination showed clear consistent differences in both the foliage and flowers, valid at a higher rank than the previous treatment as just a subgenus. This has been confirmed by genetic study, which shows Betonica is separate from Stachys and more closely related to the hemp-nettles Galeopsis. The Latin specific epithet officinalis refers to plants which had a culinary or medicinal use. Betonica officinalis is a rhizotomous, patch-forming, grassland herbaceous perennial growing to 30–60 cm (12–24 in) tall."}, "cross_references": [{"found_name": "epithimo", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 616, "target_cluster_name": "epithimo", "source_book": "llm_generated", "evidence_snippet": "Betony and Cuscuta epithymum were both recognized in historical pharmacopoeias and herbal traditions, often grouped with other medicinal herbs, indicating a shared context of use.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Betony and Cuscuta epithymum were both recognized in historical pharmacopoeias and herbal traditions, often grouped with other medicinal herbs, indicating a shared context of use.", "is_reverse": true}]}, {"canonical_name": "glass", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 44, "members": [{"entity_id": "glass", "book_id": "connexion_physical_sciences_somerville_1858", "name": "glass", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 42, "variants": ["Glass", "glass"], "contexts": ["fragile transparent material", "material interacting with liquids"]}, {"entity_id": "glass", "book_id": "first_principles_spencer_1862", "name": "glass", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["glass"], "contexts": ["material affected by heat", "amorphous solid material"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "glass", "target_book": "first_principles_spencer_1862", "target_name": "glass", "similarity": 0.838}], "id": 1575, "stable_key": "clu_210fa6191bb31b69", "ground_truth": {"modern_name": "Glass", "confidence": "high", "type": "mineral", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "", "wikipedia_extract": ""}, "cross_references": [{"found_name": "Crystal", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 696, "target_cluster_name": "Crystal", "source_book": "llm_generated", "evidence_snippet": "Glass is an amorphous solid, often considered a supercooled liquid, and shares many physical properties and manufacturing processes with crystals, particularly rock crystal, which it was historically used to imitate.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Glass is an amorphous solid, often considered a supercooled liquid, and shares many physical properties and manufacturing processes with crystals, particularly rock crystal, which it was historically used to imitate."}, {"found_name": "Rock crystal", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1034, "target_cluster_name": "rock crystal", "source_book": "llm_generated", "evidence_snippet": "Glass was historically used as a substitute for rock crystal due to its transparency and ability to be shaped, and texts often discuss them in relation to each other for this reason.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Glass was historically used as a substitute for rock crystal due to its transparency and ability to be shaped, and texts often discuss them in relation to each other for this reason."}, {"found_name": "Iceland spar", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1763, "target_cluster_name": "Iceland spar", "source_book": "llm_generated", "evidence_snippet": "Iceland spar (a form of calcite) was a transparent mineral studied for its optical properties, and glass was sometimes compared to it or used in experiments involving similar optical phenomena.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Iceland spar (a form of calcite) was a transparent mineral studied for its optical properties, and glass was sometimes compared to it or used in experiments involving similar optical phenomena."}]}, {"canonical_name": "cauterio", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 44, "members": [{"entity_id": "cauterios", "book_id": "historia_medicinal_monardes_1574", "name": "cauterios", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["cauterios"], "contexts": ["medical practice of burning"]}, {"entity_id": "cauterio", "book_id": "polyanthea_medicinal", "name": "cauterio", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 43, "variants": ["cauterio", "cauteriis", "cauterijs", "cauterio actuali", "cauterios", "cauteriums", "cauterizando", "cauterizar", "cauterizaremos", "cauterization", "cauterizemos", "cauterizão"], "contexts": ["device for burning tissue", "medical instrument"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "cauterios", "target_book": "polyanthea_medicinal", "target_name": "cauterio", "similarity": 0.894}], "id": 1576, "stable_key": "clu_e0755b12f6acfc73", "ground_truth": {"modern_name": "Cauterization", "confidence": "high", "type": "concept", "description": "Medical practice of burning tissue to stop bleeding or treat disease.", "wikipedia_extract": "Cauterization (or cauterisation, or cautery) is a medical practice or technique of burning a part of a body to remove or close off a part of it. It destroys some tissue in an attempt to mitigate bleeding and damage, remove an undesired growth, or minimize other potential medical harm, such as infections when antibiotics are unavailable. The practice was once a widespread wound treatment. Its utility before the advent of antibiotics was said to be effective at more than one level: Cautery was historically believed to prevent infection, but current research shows that cautery actually increases the risk of infection by causing more tissue damage and providing a more hospitable environment for bacterial growth. Actual cautery refers to the metal device, generally heated to a dull red glow, that a physician applies to produce blisters, to stop bleeding of a blood vessel, and for other similar purposes. The main forms of cauterization used today are electrocautery and chemical cautery—both are, for example, prevalent in cosmetic removal of warts and stopping nosebleeds."}, "cross_references": [{"found_name": "cautery", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2817, "target_cluster_name": "cautery", "source_book": "llm_generated", "evidence_snippet": "The historical name 'cauterio' is a direct synonym for cauterization.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "The historical name 'cauterio' is a direct synonym for cauterization."}, {"found_name": "Bloodletting", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 43, "target_cluster_name": "bloodletting", "source_book": "llm_generated", "evidence_snippet": "Both cauterization and bloodletting were common historical medical interventions aimed at treating illness and balancing bodily humors.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both cauterization and bloodletting were common historical medical interventions aimed at treating illness and balancing bodily humors."}, {"found_name": "Fomentation", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 501, "target_cluster_name": "fomentaçao", "source_book": "llm_generated", "evidence_snippet": "Fomentation (applying heat or moisture) and cauterization are both physical therapeutic techniques used in historical medicine.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Fomentation (applying heat or moisture) and cauterization are both physical therapeutic techniques used in historical medicine."}, {"found_name": "Surgery", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3083, "target_cluster_name": "operations", "source_book": "llm_generated", "evidence_snippet": "Cauterization is a specific technique that falls under the broader category of historical surgery.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Cauterization is a specific technique that falls under the broader category of historical surgery."}, {"found_name": "Therapeutic sweating", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2074, "target_cluster_name": "Suores", "source_book": "llm_generated", "evidence_snippet": "Both cauterization and therapeutic sweating were methods used in historical medicine to expel unwanted substances or humors from the body.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both cauterization and therapeutic sweating were methods used in historical medicine to expel unwanted substances or humors from the body."}]}, {"canonical_name": "violas", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 44, "members": [{"entity_id": "violas", "book_id": "coloquios_da_orta_1563", "name": "violas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["violas"], "contexts": ["plant species Orta might have seen cultivated"]}, {"entity_id": "violas", "book_id": "polyanthea_medicinal", "name": "violas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 43, "variants": ["violas", "violetas"], "contexts": ["type of flower", "plant used in medicinal baths"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "violas", "target_book": "polyanthea_medicinal", "target_name": "violas", "similarity": 1.0}], "id": 1577, "stable_key": "clu_2fcba8143928c7b4", "ground_truth": {"modern_name": "Violet", "confidence": "high", "type": "plant", "linnaean": "Viola spp.", "family": "Violaceae", "note": "The term 'violas' in the context of early modern Portuguese and Latin texts generally refers to plants of the genus Viola, commonly known as violets."}, "cross_references": []}, {"canonical_name": "palpitações do coraçao", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 44, "members": [{"entity_id": "temblores_de_coraçon", "book_id": "coloquios_da_orta_1563", "name": "temblores de coraçon", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["temblores de coraçon"], "contexts": ["heart tremors"]}, {"entity_id": "palpitações_do_coraçao", "book_id": "polyanthea_medicinal", "name": "palpitações do coraçao", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 43, "variants": ["palpitações do coraçao", "Palpitatio cordis", "Palpitation.cordis", "Palpitatione cordis", "Palpitationecordis", "Palpitaçao", "Palpitaçoens do coraçao", "Palpitaçãodocoraçao", "palpitaçoens do coraçao", "palpitações", "palpitações do coração", "palpitações docoraçao", "palpitaçõesdo coraçao"], "contexts": ["heart palpitations", "heart palpitations as a symptom of poison"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "temblores de coraçon", "target_book": "polyanthea_medicinal", "target_name": "palpitações do coraçao", "similarity": 0.911}], "id": 1578, "stable_key": "clu_3664384ad81ea3b6", "ground_truth": {"modern_name": "Heart Palpitations", "confidence": "high", "type": "disease", "description": "Sensation of the heart beating too hard, too fast, or irregularly.", "wikipedia_extract": "Palpitations occur when a person becomes aware of their heartbeat. The heartbeat may feel hard, fast, or uneven in their chest. Symptoms include a very fast or irregular heartbeat. Palpitations are a sensory symptom. They are often described as a skipped beat, a rapid flutter, or a pounding in the chest or neck. Palpitations are not always the result of a physical problem with the heart and can be linked to anxiety."}, "cross_references": []}, {"canonical_name": "Hypocondriacos", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 2, "total_mentions": 43, "members": [{"entity_id": "hypochondria", "book_id": "english_physician_1652", "name": "Hypochondria", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["Hypochondria"], "contexts": ["disease listed with numbers"]}, {"entity_id": "hypocondriacos", "book_id": "polyanthea_medicinal", "name": "Hypocondriacos", "category": "DISEASE", "subcategory": "CHRONIC", "count": 42, "variants": ["Hypocondriacos", "Hypo", "HypoCArarata", "Hypocondriac", "Hypocondriaca", "Hypocondriacas", "Hyppocondriacos", "affectos hypocondriacos", "hypocondria", "hypocondriaca", "hypocondriacas", "hypocondriacos", "ventofidades hypocondriacas", "ventosidades hypocondriacas", "ventoſidades hypocondriacas"], "contexts": ["patients with hypochondria", "people suffering from hypochondria"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Hypochondria", "target_book": "polyanthea_medicinal", "target_name": "Hypocondriacos", "similarity": 0.903}], "id": 1579, "stable_key": "clu_67f7fe1a7570527b", "ground_truth": {"modern_name": "Hypochondria", "confidence": "high", "type": "disease", "description": "A chronic condition characterized by excessive anxiety about one's health.", "wikipedia_extract": "Hypochondriasis or hypochondria is a condition in which a person is excessively and unduly worried about having a serious illness. Hypochondria is an old concept whose meaning has repeatedly changed over its lifespan. It has been claimed that this debilitating condition results from an inaccurate perception of the condition of body or mind despite the absence of an actual medical diagnosis. An individual with hypochondriasis is known as a hypochondriac. Hypochondriacs become unduly alarmed about any physical or psychological symptoms they detect, no matter how minor the symptom may be, and are convinced that they have, or are about to be diagnosed with, a serious illness. Often, hypochondria persists even after a physician has evaluated a person and reassured them that their concerns about symptoms do not have an underlying medical basis or, if there is a medical illness, their concerns are far in excess of what is appropriate for the level of disease."}, "cross_references": [{"found_name": "Grief", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1325, "target_cluster_name": "grief", "source_book": "llm_generated", "evidence_snippet": "While distinct, prolonged grief could manifest with physical symptoms and anxieties that might be interpreted as hypochondria in historical contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "While distinct, prolonged grief could manifest with physical symptoms and anxieties that might be interpreted as hypochondria in historical contexts."}]}, {"canonical_name": "Rio Janeiro", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 43, "members": [{"entity_id": "rio_janeiro", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Rio Janeiro", "category": "PLACE", "subcategory": "CITY", "count": 42, "variants": ["Rio Janeiro", "Rio-Janeiro", "Rio-Jaueiro"], "contexts": ["city where decrees were issued", "port that received slaves"]}, {"entity_id": "rio_de_janeiro", "book_id": "coloquios_da_orta_1563", "name": "Rio de Janeiro", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Rio de Janeiro"], "contexts": ["location of astronomical observation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Rio Janeiro", "target_book": "coloquios_da_orta_1563", "target_name": "Rio de Janeiro", "similarity": 0.962}], "id": 1580, "stable_key": "clu_e86258d958c3f0d2", "ground_truth": {"modern_name": "Rio de Janeiro", "confidence": "high", "type": "place", "description": "A major city and port in Brazil, formerly the capital.", "wikipedia_extract": "Rio de Janeiro, also known simply as Rio, is the capital of the state of Rio de Janeiro. It is the second-most-populous city in Brazil after São Paulo and the sixth-most-populous city in the Americas. Founded in 1565, the city was initially the seat of the Captaincy of Rio de Janeiro, a domain of the Portuguese Empire. In 1763, it became the capital of the State of Brazil. In 1808, when the Portuguese Royal Court moved to Brazil, Rio de Janeiro became the seat of the court of Queen Maria I of Portugal. Under the leadership of her son, prince regent John of Braganza, Maria raised Brazil to the dignity of a kingdom within the United Kingdom of Portugal, Brazil, and Algarves."}, "cross_references": [{"found_name": "Brazil", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 96, "target_cluster_name": "Brasil", "source_book": "llm_generated", "evidence_snippet": "Rio de Janeiro is the capital of the state of Brazil.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Rio de Janeiro is the capital of the state of Brazil."}, {"found_name": "Alagoas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4472, "target_cluster_name": "alagoas", "source_book": "llm_generated", "evidence_snippet": "Alagoas is a state in Brazil, and Rio de Janeiro is the capital of the state of Rio de Janeiro, indicating a regional relationship within Brazil.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Alagoas is a state in Brazil, and Rio de Janeiro is the capital of the state of Rio de Janeiro, indicating a regional relationship within Brazil."}, {"found_name": "Bahia", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2546, "target_cluster_name": "Bahia", "source_book": "llm_generated", "evidence_snippet": "Bahia is a state in Brazil, and Rio de Janeiro is the capital of the state of Rio de Janeiro, indicating a regional relationship within Brazil.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Bahia is a state in Brazil, and Rio de Janeiro is the capital of the state of Rio de Janeiro, indicating a regional relationship within Brazil."}]}, {"canonical_name": "Hartmanus", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 43, "members": [{"entity_id": "hartmann", "book_id": "principles_of_psychology_james_1890", "name": "Hartmann", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Hartmann"], "contexts": ["made excessive applications of inference principle", "philosopher discussing unconscious thought"]}, {"entity_id": "hartmanus", "book_id": "polyanthea_medicinal", "name": "Hartmanus", "category": "PERSON", "subcategory": "SCHOLAR", "count": 41, "variants": ["Hartmanus", "Harchman", "Harihman.", "Harthmano", "Harthmanus", "Hartm.", "Hartman", "Hartman.", "Hartmanis", "Hartmano"], "contexts": ["author of Practica Chymiatric", "author on memory loss"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Hartmann", "target_book": "polyanthea_medicinal", "target_name": "Hartmanus", "similarity": 0.864}], "id": 1581, "stable_key": "clu_644b9fd83e0b9190", "ground_truth": {"modern_name": "Georg Ernst Stahl", "confidence": "medium", "type": "person", "birth_year": 1659, "death_year": 1734, "description": "German physician and chemist, vitalist theorist", "note": "While 'Hartmannus' appears in a 1652 text, Georg Ernst Stahl is a prominent figure in early modern chemistry and medicine known for his 'Practica Chymica'. The reference to 'Hartmann' in James's 'Principles of Psychology' might be a different individual, but given the context of early modern texts and scientific principles, Stahl is a more likely candidate for the scientific/medical association.", "wikidata_id": "Q57566", "wikidata_description": "German physician and chemist (1659-1734)", "wikipedia_url": "https://en.wikipedia.org/wiki/Georg%20Ernst%20Stahl", "wikipedia_extract": "Georg Ernst Stahl (22 October 1659 – 24 May 1734) was a German chemist, physician and philosopher. He was a supporter of vitalism, and until the late 18th century his works on phlogiston were accepted as an explanation for chemical processes. Raised as a son to a Lutheran pastor, he was brought up in a very pious and religious household. From an early age he expressed profound interest in chemistry, by age 15 mastering a set of university lecture notes on chemistry and eventually a difficult treatise by Johann Kunckel. He had two wives, who both died from puerperal fever in 1696 and 1706. He also had a son Johnathan and a daughter who died in 1708."}, "cross_references": [{"found_name": "Friedrich Hoffmann", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3610, "target_cluster_name": "Frederic Hoffman", "source_book": "llm_generated", "evidence_snippet": "Friedrich Hoffmann was a contemporary physician and chemist who, like Stahl, was a prominent figure in German medical and scientific circles during the late 17th and early 18th centuries. Hoffmann's work on the 'animal spirit' and his development of 'Hoffmann's drops' are significant in the history of medicine and chemistry, areas where Stahl also made substantial contributions.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Friedrich Hoffmann was a contemporary physician and chemist who, like Stahl, was a prominent figure in German medical and scientific circles during the late 17th and early 18th centuries. Hoffmann's work on the 'animal spirit' and his development of 'Hoffmann's drops' are significant in the history of medicine and chemistry, areas where Stahl also made substantial contributions."}, {"found_name": "Antoine Lavoisier", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 475, "target_cluster_name": "Lavoisier", "source_book": "llm_generated", "evidence_snippet": "Antoine Lavoisier is famously known for overturning Stahl's phlogiston theory with his theory of combustion based on oxygen. Their work represents a critical transition in the history of chemistry, from the phlogiston era to modern chemistry.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Antoine Lavoisier is famously known for overturning Stahl's phlogiston theory with his theory of combustion based on oxygen. Their work represents a critical transition in the history of chemistry, from the phlogiston era to modern chemistry."}, {"found_name": "Georgius Agricola", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 907, "target_cluster_name": "Agricola", "source_book": "llm_generated", "evidence_snippet": "Georgius Agricola, a 16th-century German scholar, is considered the 'father of metallurgy and mineralogy.' While Stahl's primary focus was chemistry and medicine, Agricola's foundational work in related earth sciences and his systematic approach to observation and description in his field make him a relevant precursor in the broader context of German scientific inquiry.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Georgius Agricola, a 16th-century German scholar, is considered the 'father of metallurgy and mineralogy.' While Stahl's primary focus was chemistry and medicine, Agricola's foundational work in related earth sciences and his systematic approach to observation and description in his field make him a relevant precursor in the broader context of German scientific inquiry."}, {"found_name": "Johannes Baptista van Helmont", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1706, "target_cluster_name": "Helmonte", "source_book": "llm_generated", "evidence_snippet": "Johannes Baptista van Helmont was a 17th-century Flemish chemist and physician whose work on gases and his concept of 'vital force' influenced later vitalist thinkers like Stahl. Van Helmont's experimental approach and his ideas about the fundamental nature of matter and life laid some groundwork for Stahl's own theories.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Johannes Baptista van Helmont was a 17th-century Flemish chemist and physician whose work on gases and his concept of 'vital force' influenced later vitalist thinkers like Stahl. Van Helmont's experimental approach and his ideas about the fundamental nature of matter and life laid some groundwork for Stahl's own theories."}]}, {"canonical_name": "moon", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 43, "members": [{"entity_id": "moon", "book_id": "kosmos_humboldt_1845", "name": "moon", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 35, "variants": ["moon", "Moon"], "contexts": ["celestial body with volcanic traces", "natural satellite of Earth"]}, {"entity_id": "moon", "book_id": "first_principles_spencer_1862", "name": "Moon", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 8, "variants": ["Moon", "moon"], "contexts": ["Earth's natural satellite", "celestial body with monthly cycle"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "moon", "target_book": "first_principles_spencer_1862", "target_name": "Moon", "similarity": 0.985}], "id": 1582, "stable_key": "clu_7dee111fff33372b", "ground_truth": {"modern_name": "Moon", "confidence": "high", "type": "place", "country": "N/A"}, "cross_references": [{"found_name": "Earth", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 533, "target_cluster_name": "earth", "source_book": "llm_generated", "evidence_snippet": "The Moon is a celestial body that orbits the Earth.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Moon is a celestial body that orbits the Earth."}]}, {"canonical_name": "Milky Way", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 43, "members": [{"entity_id": "milky_way", "book_id": "kosmos_humboldt_1845", "name": "Milky Way", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 11, "variants": ["Milky Way"], "contexts": ["celestial band of stars", "band of stars in the night sky"]}, {"entity_id": "milky_way", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Milky Way", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 32, "variants": ["milky way", "Milky Way"], "contexts": ["celestial band of stars", "our galaxy"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Milky Way", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Milky Way", "similarity": 1.0}], "id": 1583, "stable_key": "clu_23aae0518336caaf", "ground_truth": {"modern_name": "Milky Way", "confidence": "high", "type": "place", "wikidata_id": "Q321", "wikidata_description": "galaxy containing our Solar System", "wikipedia_url": "https://en.wikipedia.org/wiki/Milky%20Way", "wikipedia_extract": "The Milky Way or Milky Way Galaxy is the galaxy that includes the Solar System, with the name describing the galaxy's appearance from Earth: a hazy band of light seen in the night sky formed from stars in other arms of the galaxy, which are so far away that they cannot be individually distinguished by the naked eye. The Milky Way is a barred spiral galaxy with a D25 isophotal diameter estimated at 26.8 ± 1.1 kiloparsecs (87,400 ± 3,600 light-years), but only about 1,000 light-years thick at the spiral arms (more at the bar). Recent simulations suggest that a dark matter area, also containing some visible stars, may extend up to a diameter of almost 2 million light-years (613 kpc). The Milky Way has several satellite galaxies and is part of the Local Group of galaxies, forming part of the Virgo Supercluster which is itself a component of the Laniakea Supercluster. It is estimated to contain 100–400 billion stars and at least that number of planets. The Solar System is located at a radius of about 27,000 light-years (8.3 kpc) from the Galactic Center, on the inner edge of the Orion Arm, one of the spiral-shaped concentrations of gas and dust."}, "cross_references": [{"found_name": "Andromeda", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2613, "target_cluster_name": "Andromeda", "source_book": "llm_generated", "evidence_snippet": "Andromeda is a galaxy often discussed in relation to the Milky Way, sometimes as a neighboring galaxy or as a point of comparison in astronomical texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Andromeda is a galaxy often discussed in relation to the Milky Way, sometimes as a neighboring galaxy or as a point of comparison in astronomical texts."}, {"found_name": "Alpha Centauri", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3153, "target_cluster_name": "Centaur", "source_book": "llm_generated", "evidence_snippet": "Alpha Centauri is the closest star system to the Solar System, which is located within the Milky Way.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Alpha Centauri is the closest star system to the Solar System, which is located within the Milky Way."}, {"found_name": "Earth", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 533, "target_cluster_name": "earth", "source_book": "llm_generated", "evidence_snippet": "The Milky Way is the galaxy that contains the Earth and the Solar System.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Milky Way is the galaxy that contains the Earth and the Solar System."}]}, {"canonical_name": "remedios", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 43, "members": [{"entity_id": "remédios", "book_id": "coloquios_da_orta_1563", "name": "remédios", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["remédios", "remedio"], "contexts": ["medicinal treatments", "medicine"]}, {"entity_id": "remedios", "book_id": "polyanthea_medicinal", "name": "remedios", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 41, "variants": ["remedios", "remedios compoftos", "remedios eficazes", "remedios fortes", "remedios ordinarios", "remedium", "remédios"], "contexts": ["Medicines derived from leaves", "medicines"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "remédios", "target_book": "polyanthea_medicinal", "target_name": "remedios", "similarity": 0.931}], "id": 1584, "stable_key": "clu_8955b4220081e5a8", "ground_truth": {"modern_name": "Medicines", "confidence": "high", "type": "concept", "description": "Substances used for therapeutic purposes to treat illness or disease.", "wikipedia_extract": "Medication (also called medicament, medicine, pharmaceutical drug, medicinal product, medicinal drug, or simply drug) is a drug used to diagnose, cure, treat, or prevent disease. Drug therapy (pharmacotherapy) is an important part of the medical field and relies on the science of pharmacology for continual advancement and on pharmacy for appropriate management. Drugs are classified in many ways. One of the key divisions is by level of control, which distinguishes prescription drugs (those that a pharmacist dispenses only on the medical prescription) from over-the-counter drugs (those that consumers can order for themselves). Medicines may be classified by mode of action, route of administration, biological system affected, or therapeutic effects. The World Health Organization keeps a list of essential medicines."}, "cross_references": [{"found_name": "Medicamentos", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 719, "target_cluster_name": "Medicamentos", "source_book": "llm_generated", "evidence_snippet": "Direct translation of 'Medicines' in Spanish.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "Direct translation of 'Medicines' in Spanish."}, {"found_name": "Antidote", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 880, "target_cluster_name": "antidotos", "source_book": "llm_generated", "evidence_snippet": "Antidotes are a specific type of medicine used to counteract poisons.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Antidotes are a specific type of medicine used to counteract poisons."}, {"found_name": "Compound remedies", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3740, "target_cluster_name": "compostos", "source_book": "llm_generated", "evidence_snippet": "Compound remedies are a specific category of medicines made from multiple ingredients.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Compound remedies are a specific category of medicines made from multiple ingredients."}, {"found_name": "Poisonous medicines", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4432, "target_cluster_name": "medicinas venenosas", "source_book": "llm_generated", "evidence_snippet": "Poisonous medicines are a specific category of medicines with harmful effects, often used therapeutically in small doses or as poisons.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Poisonous medicines are a specific category of medicines with harmful effects, often used therapeutically in small doses or as poisons."}, {"found_name": "Theriac", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 309, "target_cluster_name": "Theriaca", "source_book": "llm_generated", "evidence_snippet": "Theriac is a complex historical compound medicine.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Theriac is a complex historical compound medicine."}, {"found_name": "Alexipharmic", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2089, "target_cluster_name": "Alexipharmacum", "source_book": "llm_generated", "e