accharum ofBcinarum"], "contexts": ["scientific name for sugarcane", "sugarcane plant"]}, {"entity_id": "saccharum", "book_id": "polyanthea_medicinal", "name": "Saccharum", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Saccharum"], "contexts": ["sweet substance, possibly sugar"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Saccharum ofBcinarum", "target_book": "polyanthea_medicinal", "target_name": "Saccharum", "similarity": 0.898}], "id": 3049, "stable_key": "clu_630b1486d16b77d3", "ground_truth": {"modern_name": "Sugarcane", "confidence": "high", "type": "plant", "linnaean": "Saccharum officinarum Linnaeus", "family": "Poaceae", "note": "The text contains 'Saccharum ofBcinarum', which is likely a OCR error for 'Saccharum officinarum'.", "wikidata_id": "Q3391243", "wikidata_description": "species of plant"}, "cross_references": [{"found_name": "cana", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 2298, "target_cluster_name": "cana", "source_book": "llm_generated", "evidence_snippet": "historical Portuguese name for sugarcane", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "historical Portuguese name for sugarcane"}, {"found_name": "sugar", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 546, "target_cluster_name": "sucre", "source_book": "llm_generated", "evidence_snippet": "primary product derived from sugarcane", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "primary product derived from sugarcane"}]}, {"canonical_name": "aldeas", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "aldeas", "book_id": "relation_historique_humboldt_vol3_1825", "name": "aldeas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["aldeas"], "contexts": ["small rural settlements", "settlement type"]}, {"entity_id": "aldeas", "book_id": "polyanthea_medicinal", "name": "Aldeas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Aldeas"], "contexts": ["small villages", "villages within the kingdom"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "aldeas", "target_book": "polyanthea_medicinal", "target_name": "Aldeas", "similarity": 0.894}], "id": 3050, "stable_key": "clu_187222949458072c", "ground_truth": {"modern_name": "aldea", "confidence": "high", "type": "place", "description": "A small rural settlement or village.", "wikipedia_extract": "A hamlet is a human settlement that is smaller than a town or village. This is often simply an informal description of a smaller settlement or possibly a subdivision or satellite entity to a larger settlement. Sometimes, a hamlet is defined for official or administrative purposes. The word and concept of a hamlet can be traced back to Norman England, where the Old French hamelet came to apply to small human settlements. The word comes from Anglo-Norman hamelet, corresponding to Old French hamelet, the diminutive of Old French hamel meaning a little village. This, in turn, is a diminutive of Old French ham, possibly borrowed from (West Germanic) Franconian languages."}, "cross_references": [{"found_name": "casa", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1272, "target_cluster_name": "casa", "source_book": "llm_generated", "evidence_snippet": "An aldea is a small rural settlement, often consisting of a collection of houses, and is thus closely related to the concept of a house as a building within a community.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: An aldea is a small rural settlement, often consisting of a collection of houses, and is thus closely related to the concept of a house as a building within a community.", "is_reverse": true}]}, {"canonical_name": "Blumenbach", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "blumenbach", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Blumenbach", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Blumenbach"], "contexts": ["collector of human race skeletons"]}, {"entity_id": "blumenbach", "book_id": "kosmos_humboldt_1845", "name": "Blumenbach", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Blumenbach"], "contexts": ["scientist known for comparative anatomy", "master who classified races"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Blumenbach", "target_book": "kosmos_humboldt_1845", "target_name": "Blumenbach", "similarity": 1.0}], "id": 3051, "stable_key": "clu_8835cbcc148dd3c8", "ground_truth": {"modern_name": "Johann Friedrich Blumenbach", "confidence": "high", "type": "person", "birth_year": 1752, "death_year": 1840, "description": "German physician, naturalist, comparative anatomist, and anthropologist.", "wikidata_id": "Q58588", "wikidata_description": "German physician, naturalist, physiologist, and anthropologist (1752 – 1840)", "wikipedia_url": "https://en.wikipedia.org/wiki/Johann%20Friedrich%20Blumenbach", "wikipedia_extract": "Johann Friedrich Blumenbach (11 May 1752 – 22 January 1840) was a German physician, naturalist, physiologist, and anthropologist. He is considered to be a main founder of zoology and anthropology as comparative, scientific disciplines. He has been called the \"founder of racial classifications\". He was one of the first to explore the study of the human being as an aspect of natural history. His teachings in comparative anatomy were applied to his classification of human races, of which he claimed there were five: Caucasian, Mongolian, Malayan, Ethiopian, and American. He was a member of what modern historians call the Göttingen school of history."}, "cross_references": []}, {"canonical_name": "Faleiro", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "faleiro", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Faleiro", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Faleiro"], "contexts": ["famous mathematician"]}, {"entity_id": "faleiro", "book_id": "coloquios_da_orta_1563", "name": "Faleiro", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Faleiro", "Falcio"], "contexts": ["bacharel who accompanied Magalhães", "astrologer, cosmographer"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Faleiro", "target_book": "coloquios_da_orta_1563", "target_name": "Faleiro", "similarity": 0.711}], "id": 3052, "stable_key": "clu_705801c3d42aa5cd", "ground_truth": {"modern_name": "Fernão de Oliveira", "confidence": "high", "type": "person", "birth_year": 1507, "description": "Portuguese mathematician and navigator, possibly associated with Magellan.", "note": "The context 'bacharel who accompanied Magalhães' strongly points to Fernão de Oliveira, a mathematician who sailed with Magellan's expedition. 'Faleiro' might be a corruption or a misremembered name. It is important to note that while the association is strong, the name in the text is 'Faleiro', hence the 'medium' confidence on the name itself.", "wikidata_id": "Q5445183", "wikidata_description": "Priest and grammarian"}, "cross_references": [{"found_name": "Portuguezes", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 218, "target_cluster_name": "Portuguezes", "source_book": "llm_generated", "evidence_snippet": "Fernão de Oliveira was a Portuguese humanist, historian, and cartographer.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Fernão de Oliveira was a Portuguese humanist, historian, and cartographer.", "is_reverse": true}]}, {"canonical_name": "titicaca", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "lac_alpin_de_titicaca", "book_id": "relation_historique_humboldt_vol3_1825", "name": "lac alpin de Titicaca", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["lac alpin de Titicaca"], "contexts": ["alpine lake"]}, {"entity_id": "titi-caca", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Titi-caca", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Titi-caca"], "contexts": ["basin name"]}, {"entity_id": "titicaca", "book_id": "kosmos_humboldt_1845", "name": "titicaca", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["titicaca", "Titicaca"], "contexts": ["South American lake", "highlands where skulls were found"]}, {"entity_id": "lac_de_tilicaca", "book_id": "relation_historique_humboldt_vol3_1825", "name": "lac de Tilicaca", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["lac de Tilicaca"], "contexts": ["lake in South America"]}, {"entity_id": "lake_of_titicaca", "book_id": "kosmos_humboldt_1845", "name": "Lake of Titicaca", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Lake of Titicaca"], "contexts": ["lake in Bolivia"]}, {"entity_id": "lac_de_titicaca", "book_id": "relation_historique_humboldt_vol3_1825", "name": "lac de Titicaca", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["lac de Titicaca"], "contexts": ["lake name"]}, {"entity_id": "lake_titicaca", "book_id": "kosmos_humboldt_1845", "name": "Lake Titicaca", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Lake Titicaca"], "contexts": ["lake near mountains measured by Pentland"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "lac alpin de Titicaca", "target_book": "kosmos_humboldt_1845", "target_name": "titicaca", "similarity": 0.91}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Titi-caca", "target_book": "kosmos_humboldt_1845", "target_name": "titicaca", "similarity": 0.661}], "id": 3053, "stable_key": "clu_667b0a6e2857210a", "ground_truth": {"modern_name": "Lake Titicaca", "confidence": "high", "type": "place", "country": "Peru, Bolivia", "wikidata_id": "Q1628083", "wikidata_description": "species of amphibian", "wikipedia_extract": "Waru Waru is a type of raised field agriculture developed by pre-Hispanic people in the Andes region of South America from Ecuador to Bolivia. This regional agricultural technique is also referred to as camellones in Spanish. Functionally similar agricultural techniques have been developed in other parts of the world. This type of altiplano field agriculture consists of parallel canals alternated by raised planting beds, which would be strategically located on floodplains or near a water source so that the fields could be properly irrigated. These flooded fields were composed of soil that was rich in nutrients due to the presence of aquatic plants and other organic materials. Through the process of mounding up this soil to create planting beds, natural, recyclable fertilizer was made available in a region where nitrogen-rich soils were rare.", "wikipedia_url": "https://en.wikipedia.org/wiki/Waru_Waru"}, "member_count": 7, "cross_references": []}, {"canonical_name": "SantaCatharina", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "sainte-catherine", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Sainte-Catherine", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Sainte-Catherine"], "contexts": ["island"]}, {"entity_id": "santacatharina", "book_id": "polyanthea_medicinal", "name": "SantaCatharina", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["SantaCatharina", "Santa Catherina", "Santa Clara"], "contexts": ["landmark near a patien