ipedia_extract": "The bladder (from Old English  blædre 'bladder, blister, pimple') is a hollow organ in humans and other vertebrates that stores urine from the kidneys. In placental mammals, urine enters the bladder via the ureters and exits via the urethra during urination. In humans, the bladder is a distensible organ that sits on the pelvic floor. The typical adult human bladder will hold between 300 and 500 ml (10 and 17 fl oz) before the urge to empty occurs, but can hold considerably more. The Latin phrase for \"urinary bladder\" is vesica urinaria, and the term vesical or prefix vesico- appear in connection with associated structures such as vesical veins. The modern Latin word for \"bladder\" – cystis – appears in associated terms such as cystitis (inflammation of the bladder)."}, "cross_references": [{"found_name": "Bladder", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 608, "target_cluster_name": "Bladder", "source_book": "llm_generated", "evidence_snippet": "The entity 'Bladder' is explicitly noted as having the historical name 'bexiga'.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "reverse: The entity 'Bladder' is explicitly noted as having the historical name 'bexiga'.", "is_reverse": true}, {"found_name": "Kidneys", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 74, "target_cluster_name": "Kidneys", "source_book": "llm_generated", "evidence_snippet": "The bladder is a related organ in the urinary system, responsible for storing urine produced by the kidneys.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The bladder is a related organ in the urinary system, responsible for storing urine produced by the kidneys.", "is_reverse": true}, {"found_name": "Urine", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2908, "target_cluster_name": "Urine", "source_book": "llm_generated", "evidence_snippet": "Urine is stored in the bladder before excretion.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Urine is stored in the bladder before excretion.", "is_reverse": true}, {"found_name": "Stones", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2704, "target_cluster_name": "Stones", "source_book": "llm_generated", "evidence_snippet": "Calculi (stones) are often found in the bladder.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Calculi (stones) are often found in the bladder.", "is_reverse": true}]}, {"canonical_name": "Indios", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 115, "members": [{"entity_id": "indios", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Indios", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Indios"], "contexts": ["people of all castes", "indigenous people"]}, {"entity_id": "indios", "book_id": "historia_medicinal_monardes_1574", "name": "Indios", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 76, "variants": ["Indios", "Indianos", "Indio", "Indios Caribes", "Indíos", "indios"], "contexts": ["indigenous people of the Americas", "indigenous people who make the oil"]}, {"entity_id": "índios", "book_id": "coloquios_da_orta_1563", "name": "índios", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 36, "variants": ["índios", "Indianos", "indianos", "indios", "Índios", "Índios de Cuba"], "contexts": ["people of India", "people who value amber"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Indios", "target_book": "historia_medicinal_monardes_1574", "target_name": "Indios", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Indios", "target_book": "coloquios_da_orta_1563", "target_name": "índios", "similarity": 0.956}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Indios", "target_book": "coloquios_da_orta_1563", "target_name": "índios", "similarity": 0.956}], "id": 544, "stable_key": "clu_60f2f46691a9b6ea", "ground_truth": {"modern_name": "Indigenous peoples of the Americas", "confidence": "high", "type": "person", "description": "Peoples native to the Americas, often described in early colonial texts.", "note": "The term 'Indios' was used by Europeans to refer to both the indigenous peoples of the Americas and the inhabitants of India.", "wikidata_id": "Q36747", "wikidata_description": "peoples indigenous to the Western Hemisphere", "wikipedia_url": "https://en.wikipedia.org/wiki/Indigenous%20peoples%20of%20the%20Americas", "wikipedia_extract": "The Indigenous peoples of the Americas are the peoples who are native to the Americas or the Western Hemisphere. Their ancestors are among the pre-Columbian population of South or North America, including Central America and the Caribbean. Indigenous peoples live throughout the Americas. While often minorities in their countries, Indigenous peoples are the majority in Greenland and close to a majority in Bolivia and Guatemala. There are at least 1,000 different Indigenous languages of the Americas. Some languages, including Quechua, Arawak, Aymara, Guaraní, Nahuatl, and some Mayan languages, have millions of speakers and are recognized as official by governments in Bolivia, Peru, Paraguay, and Greenland."}, "cross_references": [{"found_name": "Conquistadores", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1981, "target_cluster_name": "Conquistadores", "source_book": "llm_generated", "evidence_snippet": "Conquistadors were the primary European agents responsible for the conquest and colonization of Indigenous peoples of the Americas.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Conquistadors were the primary European agents responsible for the conquest and colonization of Indigenous peoples of the Americas.", "is_reverse": true}, {"found_name": "Rodriguez", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2198, "target_cluster_name": "Rodriguez", "source_book": "llm_generated", "evidence_snippet": "Cabeza de Vaca spent years among various indigenous groups in North America and wrote extensively about them.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Cabeza de Vaca spent years among various indigenous groups in North America and wrote extensively about them.", "is_reverse": true}]}, {"canonical_name": "pimenta", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 115, "members": [{"entity_id": "pimienta", "book_id": "historia_medicinal_monardes_1574", "name": "pimienta", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 14, "variants": ["pimienta", "PIMIENTA", "Pimienta", "Pimienta Oriental", "Pimienta comun", "Pimienta luenga", "Pimienta negra", "Pimientos"], "contexts": ["spice from the Moluccas Islands", "spice from the Indies"]}, {"entity_id": "pimenta", "book_id": "coloquios_da_orta_1563", "name": "pimenta", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 73, "variants": ["pimenta", "PIMENTA BRANCA", "PIMENTA PRETA", "Pimenta", "pimenta branca", "pimenta negra", "pimenta preta", "pimenta verde"], "contexts": ["spice Ruano wants to know about", "spice used for comparison of heat"]}, {"entity_id": "pimenta_redonda", "book_id": "polyanthea_medicinal", "name": "pimenta redonda", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["pimenta redonda"], "contexts": ["round pepper"]}, {"entity_id": "raiz_da_pimenta", "book_id": "coloquios_da_orta_1563", "name": "raiz da pimenta", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["raiz da pimenta"], "contexts": ["root of the pepper plant"]}, {"entity_id": "pimenta", "book_id": "polyanthea_medicinal", "name": "Pimenta", "category":