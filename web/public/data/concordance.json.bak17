neo", "Méditerâneo", "mediterrânicos"], "contexts": ["sea with commercial cities trading spices", "sea navigated by merchants"]}, {"entity_id": "mediterranean", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Mediterranean", "category": "PLACE", "subcategory": "REGION", "count": 8, "variants": ["Mediterranean"], "contexts": ["sea with imperceptible tides", "sea where gale occurred"]}, {"entity_id": "la_méditerranée", "book_id": "relation_historique_humboldt_vol3_1825", "name": "La Méditerranée", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["la Méditerranée", "La Méditerranée"], "contexts": ["sea basin in early navigation", "sea with a specific surface area"]}, {"entity_id": "mediterraâneo", "book_id": "coloquios_da_orta_1563", "name": "Mediterraâneo", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Mediterraâneo", "mar Mediterrâneo"], "contexts": ["sea where spice reached peoples", "sea"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Mediterranean", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Méditerranée", "similarity": 0.95}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Mediterranean", "target_book": "kosmos_humboldt_1845", "target_name": "Mediterranean", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Mediterranean", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mediterranean Sea", "similarity": 0.974}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Méditerranée", "target_book": "kosmos_humboldt_1845", "target_name": "Mediterranean", "similarity": 0.95}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Méditerranée", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mediterranean Sea", "similarity": 0.94}, {"source_book": "kosmos_humboldt_1845", "source_name": "Mediterranean", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mediterranean Sea", "similarity": 0.974}], "id": 256, "stable_key": "clu_794f28ffec58a73a", "ground_truth": {"modern_name": "Mediterranean Sea", "confidence": "high", "type": "place", "country": "Multiple", "wikidata_id": "Q72499", "wikidata_description": "loosely defined region of lands around the Mediterranean Sea", "wikipedia_url": "https://en.wikipedia.org/wiki/Mediterranean%20basin", "wikipedia_extract": "In biogeography, the Mediterranean basin ( MED-ih-tə-RAY-nee-ən), also known as the Mediterranean region or sometimes Mediterranea, is the region of lands around the Mediterranean Sea that mostly have a Mediterranean climate, with mild to cool, rainy winters and warm to hot, dry summers, which supports characteristic Mediterranean forests, woodlands, and scrub vegetation. The Mediterranean basin covers portions of three continents: Africa, Asia, and Europe. It is not the same as the drainage basin of the Mediterranean Sea; the drainage basin is larger, as rivers including the Nile and Rhône reach further into Africa and Europe. Conversely, the Mediterranean basin includes regions not in the drainage basin, such as Iraq, Jordan, and Portugal. It has a varied and contrasting topography. The Mediterranean region offers a varied landscape of high mountains, rocky shores, impenetrable scrub, semi-arid steppes, coastal wetlands, sandy beaches and a myriad of islands of various shapes and sizes dotted amidst the clear blue sea."}, "member_count": 8, "cross_references": [{"found_name": "Itália", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 88, "target_cluster_name": "Itália", "source_book": "llm_generated", "evidence_snippet": "Italy is a peninsula that extends into the Mediterranean Sea.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Italy is a peninsula that extends into the Mediterranean Sea.", "is_reverse": true}, {"found_name": "Alexandria", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 92, "target_cluster_name": "Alexandria", "source_book": "llm_generated", "evidence_snippet": "Alexandria is described as the largest city on the Mediterranean coast.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Alexandria is described as the largest city on the Mediterranean coast.", "is_reverse": true}, {"found_name": "Nil", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 128, "target_cluster_name": "Nil", "source_book": "llm_generated", "evidence_snippet": "The Nile River flows into the Mediterranean Sea.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Nile River flows into the Mediterranean Sea.", "is_reverse": true}, {"found_name": "Veneza", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1662, "target_cluster_name": "Veneza", "source_book": "llm_generated", "evidence_snippet": "Venice is a major maritime republic historically situated on the Mediterranean Sea.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Venice is a major maritime republic historically situated on the Mediterranean Sea.", "is_reverse": true}, {"found_name": "Africa", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3, "target_cluster_name": "Africa", "source_book": "llm_generated", "evidence_snippet": "Africa is a continent bordering the Mediterranean Sea.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Africa is a continent bordering the Mediterranean Sea."}, {"found_name": "Asia", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 231, "target_cluster_name": "Asie", "source_book": "llm_generated", "evidence_snippet": "Asia is a continent bordering the Mediterranean Sea.", "confidence": 0.85, "auto_label": "llm_related", "f