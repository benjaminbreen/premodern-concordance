rences": [{"found_name": "ruybarbo de las In- y, ¿e 19 dias", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "historia_medicinal_monardes_1574", "evidence_snippet": "30 ‘fe hinchs de ſus loores y buenos efectos , deſter»- — randoelvſodel ruybarbe de Berbería y toman» , a dao ado ta: uy bar dole lu nombre, llamandole ruybarbo de las In- y, ¿e 19 dias,que afsi lo ll", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for Ruybarbo"}, {"found_name": "Mechoacan", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "historia_medicinal_monardes_1574", "evidence_snippet": "30 ‘fe hinchs de ſus loores y buenos efectos , deſter»- — randoelvſodel ruybarbe de Berbería y toman» , a dao ado ta: uy bar dole lu nombre, llamandole ruybarbo de las In- y, ¿e 19 dias,que afsi lo ll", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "alternative name for Ruybarbo"}, {"found_name": "rapam chini", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "chamam rapam chini, e os Mouros muytos nesta terra lhe chamam somente ravam^ mas todos confessam não aver outro, senão o da China; que he asi, que nam ha ruibarbo trazido de Berbéria nem rapam indico;", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for rapam"}, {"found_name": "uvas decao", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": null, "target_cluster_name": null, "source_book": "polyanthea_medicinal", "evidence_snippet": "porque efte remedio tem virtude elpeci- ficaparaos que ourinao langue,& paraos que odeyraó tambem pelaboca.As pirolas que fe fazem de hum eſcropulo de ruybarbo , outro de alcaçuz , feyto tudo em pò , ", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "vernacular name for cumode ensaio menor"}, {"found_name": "rapam", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "chamam rapam chini, e os Mouros muytos nesta terra lhe chamam somente ravam^ mas todos confessam não aver outro, senão o da China; que he asi, que nam ha ruibarbo trazido de Berbéria nem rapam indico;", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "vernacular name"}]}, {"canonical_name": "Yellow Jaundice", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 3, "total_mentions": 81, "members": [{"entity_id": "yellow_jaundice", "book_id": "english_physician_1652", "name": "Yellow Jaundice", "category": "DISEASE", "subcategory": "CHRONIC", "count": 78, "variants": ["Yellow Jaundice", "Black Jaundice", "Jaun", "Jaundice", "Jaun∣dice", "Yelloow Jaundice", "black Jaundice", "yel-low Jaundice", "yellow Jaundice", "yellow Jaun∣dice", "yellow-Jaundice", "yel­low Jaundice", "yel∣low Jaundice"], "contexts": ["disease affecting the gall", "disease caused by choller"]}, {"entity_id": "yellow_jaundice", "book_id": "ricettario_fiorentino_1597", "name": "Yellow Jaundice", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["Yellow Jaundice"], "contexts": ["disease of liver obstruction"]}, {"entity_id": "yellow_jaundice", "book_id": "polyanthea_medicinal", "name": "yellow Jaundice", "category": "DISEASE", "subcategory": "CHRONIC", "count": 2, "variants": ["yellow Jaundice"], "contexts": ["disease of liver obstruction"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Yellow Jaundice", "target_book": "ricettario_fiorentino_1597", "target_name": "Yellow Jaundice", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Yellow Jaundice", "target_book": "polyanthea_medicinal", "target_name": "yellow Jaundice", "similarity": 0.98}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Yellow Jaundice", "target_book": "polyanthea_medicinal", "target_name": "yellow Jaundice", "similarity": 0.98}], "id": 561, "stable_key": "clu_20814577204fcef1", "ground_truth": {"modern_name": "jaundice", "confidence": "high", "type": "disease", "description": "Yellowing of skin and eyes due to liver problems.", "note": "Specifically 'Yellow Jaundice' refers to the condition.", "wikipedia_extract": "Jaundice, also known as icterus, is a yellowish or, less frequently, greenish pigmentation of the skin and sclera due to high bilirubin levels. Jaundice in adults typically indicates the presence of underlying diseases involving abnormal heme metabolism, liver dysfunction, or biliary-tract obstruction. The prevalence of jaundice in adults is rare, while jaundice in babies is common, with an estimated 80% affected during their first week of life. The most commonly associated symptoms of jaundice are itchiness, pale feces, and dark urine. Normal levels of bilirubin in blood are below 1.0 mg/dl (17 μmol/L), while levels over 2–3 mg/dl (34–51 μmol/L) typically result in jaundice. High blood bilirubin is divided into two types: unconjugated and conjugated bilirubin."}, "cross_references": []}, {"canonical_name": "Humors", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 3, "total_mentions": 80, "members": [{"entity_id": "humor", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "humor", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["humor"], "contexts": ["viscous quality holding parts together", "bodily fluid in ancient medicine"]}, {"entity_id": "humors", "book_id": "english_physician_1652", "name": "Humors", "category": "CONCEPT", "subcategory": "THEORY", "count": 77, "variants": ["Humors", "Hu†mors", "humors"], "contexts": ["bodily fluids influencing health", "bodily fluids in humoral theory"]}, {"entity_id": "hilaritate", "book_id": "polyanthea_medicinal", "name": "hilaritate", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["hilaritate"], "contexts": ["cheerfulness"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "humor", "target_book": "english_physician_1652", "target_name": "Humors", "similarity": 0.852}, {"source_book": "english_physician_1652", "source_name": "Humors", "target_book": "polyanthea_medicinal", "target_name": "hilaritate", "similarity": 0.901}], "id": 562, "stable_key": "clu_cb377b0c332a9945-2", "ground_truth": {"modern_name": "humoral theory", "confidence": "high", "type": "concept", "description": "A medical theory explaining health based on bodily fluids (humors).", "wikipedia_extract": "Humorism, the humoral theory, or humoralism, was a system of medicine detailing a supposed makeup and workings of the human body, adopted by Ancient Greek and Roman physicians and philosophers. Humorism began to fall out of favor in the 17th century and it was definitively disproved with the discovery of microbes. The concept of \"humors\" may have origins in Ancient Egyptian medicine, or Mesopotamia, though it was not systemized until ancient Greek thinkers. The word humor is a translation of Greek χυμός, chymos (literally 'juice' or 'sap', metaphorically 'flavor'). Early texts on Indian Ayurveda medicine presented a theory of three or four humors (doṣas), which they sometimes linked with the five elements (pañca-bhūta): earth, water, fire, air, and space. The concept of \"humors\" (chemical systems regulating human behaviour) became more prominent from the writing of medical theorist Alcmaeon of Croton (c. 540–500 BC)."}, "cross_references": [{"found_name": "Astrological medicine", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 569, "target_cluster_name": "astrological medicine", "source_book": "llm_generated", "evidence_snippet": "Humoral theory was a foundational concept in astrological medicine, which linked bodily humors to celestial influences.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Humoral theory was a foundational concept in astrological medicine, which linked bodily humors to celestial influences."}, {"found_name": "Bloodletting", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 43, "target_cluster_name": "bloodletting", "source_book": "llm_generated", "evidence_snippet": "Bloodletting was a common medical practice derived from humoral theory, intended to rebalance the body's humors.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Bloodletting was a common medical practice derived from humoral theory, intended to rebalance the body's humors."}, {"found_name": "Classical elements", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2703, "target_cluster_name": "Elements", "source_book": "llm_generated", "evidence_snippet": "Humoral theory was closely associated with the classical elements (earth, air, fire, water), which were believed to constitute the humors.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Humoral theory was closely associated with the classical elements (earth, air, fire, water), which were believed to constitute the humors."}, {"found_name": "Cold humors", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 785, "target_cluster_name": "humores frios", "source_book": "llm_generated", "evidence_snippet": "This is a direct component of humoral theory, referring to one of the types of humors.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "This is a direct component of humoral theory, referring to one of the types of humors."}, {"found_name": "Hot temperament", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 351, "target_cluster_name": "temperamento quente", "source_book": "llm_generated", "evidence_snippet": "Temperaments in humoral theory were defined by the dominance of specific humors, which were associated with qualities like hot or cold.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Temperaments in humoral theory were defined by the dominance of specific humors, which were associated with qualities like hot or cold."}, {"found_name": "Human Physiology", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1000, "target_cluster_name": "Physiologie des Menschen", "source_book": "llm_generated", "evidence_snippet": "Humoral theory was an early, albeit incorrect, model of human physiology.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Humoral theory was an early, albeit incorrect, model of human physiology."}, {"found_name": "Medicine", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 209, "target_cluster_name": "Medicina", "source_book": "llm_generated", "evidence_snippet": "Humoral theory was a dominant medical paradigm for centuries.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Humoral theory was a dominant medical paradigm for centuries."}, {"found_name": "Oyl of Spike", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "english_physician_1652", "evidence_snippet": "swounings, not only being drunk, but applied to the Temples, or Nostrils to be smelt unto but it is not safe to use it where the Body repleat with Blood and Humors, becaus of the hot and subtil spirit", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for 'Chimical Oyl drawn from Lavender'"}, {"found_name": "Chimical Oyl", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "english_physician_1652", "evidence_snippet": "swounings, not only being drunk, but applied to the Temples, or Nostrils to be smelt unto but it is not safe to use it where the Body repleat with Blood and Humors, becaus of the hot and subtil spirit", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "type of oil, synonym for 'Oyl of Spike'"}]}, {"canonical_name": "virtude", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 80, "members": [{"entity_id": "virtud", "book_id": "historia_medicinal_monardes_1574", "name": "virtud", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["virtud", "virtud especifica", "virtud medicinal", "virtudes medici-nales", "virtudes medicinales"], "contexts": ["virtue or power of the bone", "quality of the root"]}, {"entity_id": "virtude", "book_id": "coloquios_da_orta_1563", "name": "virtude", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["virtude", "virtudes"], "contexts": ["virtue associated with the size of the stone", "medicinal efficacy"]}, {"entity_id": "virtude", "book_id": "polyanthea_medicinal", "name": "virtude", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 71, "variants": ["virtude", "virtu", "virtud", "virtude alimenticia", "virtude analo", "virtude do enfermo", "virtude generativa", "virtude purgativa", "virtude restaurativa", "virtudereſtaurativa", "virtudes", "virtudes das plantas", "virtudes ſeminaes", "virtues", "virtute"], "contexts": ["inherent power or quality", "efficacy or power"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "virtud", "target_book": "coloquios_da_orta_1563", "target_name": "virtude", "similarity": 0.989}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "virtud", "target_book": "polyanthea_medicinal", "target_name": "virtude", "similarity": 0.989}, {"source_book": "coloquios_da_orta_1563", "source_name": "virtude", "target_book": "polyanthea_medicinal", "target_name": "virtude", "similarity": 1.0}], "id": 563, "stable_key": "clu_1f25dd92705a7dd3", "ground_truth": {"modern_name": "Virtue", "confidence": "high", "type": "concept", "note": "This refers to the inherent power, efficacy, or quality of a substance or entity in early modern medicine."}, "cross_references": [{"found_name": "vertue", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 2161, "target_cluster_name": "vertue", "source_book": "llm_generated", "evidence_snippet": "Portuguese equivalent of Virtue.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "reverse: Portuguese equivalent of Virtue.", "is_reverse": true}, {"found_name": "Eſtibio", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "polyanthea_medicinal", "evidence_snippet": "ſede,, vemapplicaros mesmos remedios.que nos vomitos verdes dos homés;por,, que tema mesmacauſa. ‫دو‬ TRATA 17 1 TRATADO SEGUNDO Das qualidades , & virtudes do Antimonio, ou Eſtibio preparado , a que ", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "a synonym for Antimonio, discussed for its qualities and virtues"}]}, {"canonical_name": "Vitriolo", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 78, "members": [{"entity_id": "vitriol", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Vitriol", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["Vitriol"], "contexts": ["mineral solution that crystallizes", "acid that dissolves ice"]}, {"entity_id": "vitriol", "book_id": "english_physician_1652", "name": "Vitriol", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Vitriol"], "contexts": ["chemical substance"]}, {"entity_id": "vitriolo", "book_id": "polyanthea_medicinal", "name": "Vitriolo", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 73, "variants": ["Vitriolo", "Ovitriolo branco", "Vitriol", "Vitriolatorum", "Vitrioli", "Vitriolialbi", "Vitriolico", "Vitriolo branco", "Vitriolobranco", "vitriato", "vitrioli", "vitriolicas", "vitriolico", "vitriolicos", "vitriolo", "vitriolo branco", "vitriolobran", "vitriolobranco"], "contexts": ["a substance used in medicine", "mineral substance used as emetic"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Vitriol", "target_book": "english_physician_1652", "target_name": "Vitriol", "similarity": 0.863}, {"source_book": "english_physician_1652", "source_name": "Vitriol", "target_book": "polyanthea_medicinal", "target_name": "Vitriolo", "similarity": 0.938}], "id": 564, "stable_key": "clu_2b38e442c6704748", "ground_truth": {"modern_name": "Vitriol", "confidence": "high", "type": "chemical", "note": "Vitriol was a general term for sulfates of metals, often used in alchemy and early chemistry/medicine.", "wikidata_id": "Q4118", "wikidata_description": "chemical compound", "wikipedia_url": "https://en.wikipedia.org/wiki/Sulfuric%20acid", "wikipedia_extract": "Sulfuric acid (American spelling and the preferred IUPAC name) or sulphuric acid (Commonwealth spelling), known in antiquity as oil of vitriol, is a mineral acid composed of the elements sulfur, oxygen, and hydrogen, with the molecular formula H2SO4. It is a colorless, odorless, and viscous liquid that is miscible with water. Pure sulfuric acid does not occur naturally due to its strong affinity to water vapor; it is hygroscopic and readily absorbs water vapor from the air. Concentrated sulfuric acid is a strong oxidant with powerful dehydrating properties, making it highly corrosive towards other materials, from rocks to metals. Phosphorus pentoxide is a notable exception in that it is not dehydrated by sulfuric acid but, to the contrary, dehydrates sulfuric acid to sulfur trioxide. Upon addition of sulfuric acid to water, a considerable amount of heat is released; thus, the reverse procedure of adding water to the acid is generally avoided since the heat released may boil the solution, spraying droplets of hot acid during the process."}, "cross_references": [{"found_name": "Oil of Vitriol", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 3828, "target_cluster_name": "oyl of Vitriol", "source_book": "llm_generated", "evidence_snippet": "The description explicitly states that Vitriol was known in antiquity as 'oil of vitriol'.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "The description explicitly states that Vitriol was known in antiquity as 'oil of vitriol'."}, {"found_name": "Acid", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1608, "target_cluster_name": "acidos", "source_book": "llm_generated", "evidence_snippet": "Vitriol (sulfuric acid) is a specific type of acid, and the text mentions it as a 'mineral acid'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Vitriol (sulfuric acid) is a specific type of acid, and the text mentions it as a 'mineral acid'."}, {"found_name": "Alkali", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 863, "target_cluster_name": "alkalies", "source_book": "llm_generated", "evidence_snippet": "Acids and alkalis are fundamental chemical opposites, often discussed in relation to each other in premodern chemistry and alchemy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Acids and alkalis are fundamental chemical opposites, often discussed in relation to each other in premodern chemistry and alchemy."}, {"found_name": "Sulfur", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 313, "target_cluster_name": "Sulphur", "source_book": "llm_generated", "evidence_snippet": "Sulfur is a primary elemental component of sulfuric acid (Vitriol).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Sulfur is a primary elemental component of sulfuric acid (Vitriol)."}, {"found_name": "chumbo", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1692, "target_cluster_name": "chumbo", "source_book": "llm_generated", "evidence_snippet": "Vitriol (sulfuric acid or sulfates) was often discussed alongside metallic substances like lead in alchemical and medicinal contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Vitriol (sulfuric acid or sulfates) was often discussed alongside metallic substances like lead in alchemical and medicinal contexts.", "is_reverse": true}, {"found_name": "epithimas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1914, "target_cluster_name": "epithimas", "source_book": "llm_generated", "evidence_snippet": "Vitriol (and its variant caparroſa) was a substance often discussed alongside other mineral and metallic preparations, including those involving antimony, with which epithyme had associations.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Vitriol (and its variant caparroſa) was a substance often discussed alongside other mineral and metallic preparations, including those involving antimony, with which epithyme had associations.", "is_reverse": true}]}, {"canonical_name": "bexigas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 78, "members": [{"entity_id": "enfermedades_dela_bexiga", "book_id": "historia_medicinal_monardes_1574", "name": "enfermedades dela bexiga", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["enfermedades dela bexiga"], "contexts": ["diseases of the bladder"]}, {"entity_id": "bexigas", "book_id": "coloquios_da_orta_1563", "name": "bexigas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 5, "variants": ["bexigas", "bexiguas"], "contexts": ["smallpox-like disease", "disease with pustules"]}, {"entity_id": "bexigas", "book_id": "polyanthea_medicinal", "name": "bexigas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 67, "variants": ["bexigas", "Bechicis", "Bexigas", "Bexigas com cova nomeyo", "bechigas", "bexigas mortaes", "bexigas venenoſas", "bexigofo", "bexigoso", "bezigas"], "contexts": ["medical condition, blisters", "disease treated by cordial"]}, {"entity_id": "chagas_da_bexiga", "book_id": "polyanthea_medicinal", "name": "chagas da bexiga", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 5, "variants": ["chagas da bexiga"], "contexts": ["ulcers of the bladder", "sores of the bladder"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "enfermedades dela bexiga", "target_book": "coloquios_da_orta_1563", "target_name": "bexigas", "similarity": 0.917}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "enfermedades dela bexiga", "target_book": "polyanthea_medicinal", "target_name": "bexigas", "similarity": 0.917}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "enfermedades dela bexiga", "target_book": "polyanthea_medicinal", "target_name": "chagas da bexiga", "similarity": 0.889}, {"source_book": "coloquios_da_orta_1563", "source_name": "bexigas", "target_book": "polyanthea_medicinal", "target_name": "bexigas", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "bexigas", "target_book": "polyanthea_medicinal", "target_name": "chagas da bexiga", "similarity": 0.908}], "id": 565, "stable_key": "clu_ea42fb8949df9547", "ground_truth": {"modern_name": "Smallpox", "confidence": "high", "type": "disease", "modern_term": "Variola", "note": "While 'bexigas' can refer to bladder issues, in the context of Monardes and other early modern texts, it strongly points to smallpox, especially when combined with 'chagas' (sores/blisters).", "wikidata_id": "Q12214", "wikidata_description": "eradicated human disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Smallpox", "wikipedia_extract": "Smallpox was an infectious disease caused by Variola virus (often called Smallpox virus), which belongs to the genus Orthopoxvirus. The last naturally occurring case was diagnosed in October 1977, and the World Health Organization (WHO) certified the global eradication of the disease in 1980, making smallpox the only human disease to have been eradicated as of 2022. The initial symptoms of the disease included fever and vomiting. This was followed by formation of ulcers in the mouth and a skin rash. Over a number of days, the skin rash turned into the characteristic fluid-filled blisters with a dent in the center. The bumps then scabbed over and fell off, leaving scars."}, "cross_references": [{"found_name": "Measles", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2228, "target_cluster_name": "sarampãos", "source_book": "llm_generated", "evidence_snippet": "Measles (sarampãos) is a common childhood infectious disease that shares some epidemiological and symptomatic similarities with smallpox, often being discussed in proximity in historical medical texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Measles (sarampãos) is a common childhood infectious disease that shares some epidemiological and symptomatic similarities with smallpox, often being discussed in proximity in historical medical texts."}, {"found_name": "Plague", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 588, "target_cluster_name": "peste", "source_book": "llm_generated", "evidence_snippet": "Plague (peste) was another devastating epidemic disease that frequently occurred alongside or in the same historical periods as smallpox, leading to comparisons and shared discussions in medical literature.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Plague (peste) was another devastating epidemic disease that frequently occurred alongside or in the same historical periods as smallpox, leading to comparisons and shared discussions in medical literature."}, {"found_name": "Fever", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 273, "target_cluster_name": "fiebres", "source_book": "llm_generated", "evidence_snippet": "Fever (fevers) is a common symptom and a general category of illness that was frequently associated with and a primary indicator of many infectious diseases, including smallpox, in premodern medical discourse.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Fever (fevers) is a common symptom and a general category of illness that was frequently associated with and a primary indicator of many infectious diseases, including smallpox, in premodern medical discourse."}]}, {"canonical_name": "unguento", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 3, "total_mentions": 75, "members": [{"entity_id": "unguentos", "book_id": "historia_medicinal_monardes_1574", "name": "unguentos", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 4, "variants": ["unguentos", "unguento"], "contexts": ["ointments for treating ailments", "preparations in apothecaries"]}, {"entity_id": "unguenti", "book_id": "ricettario_fiorentino_1597", "name": "unguenti", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["unguenti"], "contexts": ["ointments, a type of compound medicine", "ointments"]}, {"entity_id": "unguento", "book_id": "polyanthea_medicinal", "name": "unguento", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 69, "variants": ["unguento", "Unguento acquirido", "Unguento fingular", "UnguentoArmario", "Unguentoda Condeça", "Unguentos", "migalha de unguento Aureo", "unguento Alabastrino", "unguento Aureo", "unguento Roſado", "unguento Sandalino", "unguento branco", "unguento confortativo", "unguento da Condeça", "unguento daCondeça", "unguento de Althea", "unguento de Aragão", "unguento de chumbo", "unguento de chumbode almofariz", "unguento de ras", "unguento deAlsa", "unguento dedialthea", "unguento do baço", "unguento peytoral", "unguento populcaó", "unguento populeao", "unguento populeo", "unguento refrigerante", "unguento refumptivo", "unguento reſumptivo", "unguento rofado", "unguento rosado", "unguento roſado", "unguento sandolino", "unguentoApoftolorum", "unguentoArmario", "unguentoRotadoduas", "unguentoalvo canforado", "unguentoda Condeça", "unguentodaCondeça", "unguentode Althea", "unguentode chumbo", "unguentopopuleaō", "unguentos"], "contexts": ["an ointment remedy", "ointment for sores"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "unguentos", "target_book": "ricettario_fiorentino_1597", "target_name": "unguenti", "similarity": 0.895}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "unguentos", "target_book": "polyanthea_medicinal", "target_name": "unguento", "similarity": 0.891}, {"source_book": "ricettario_fiorentino_1597", "source_name": "unguenti", "target_book": "polyanthea_medicinal", "target_name": "unguento", "similarity": 0.949}], "id": 566, "stable_key": "clu_66b4713e3a62a735", "ground_truth": {"modern_name": "ointment", "confidence": "high", "type": "preparation", "description": "A semi-solid medicinal preparation for external application.", "note": "The term 'unguento' is Italian for ointment.", "wikipedia_extract": "A topical medication is a medication that is applied to a particular place on or in the body. Most often topical medication means application to body surfaces such as the skin or mucous membranes to treat ailments via a large range of classes including creams, foams, gels, lotions, and ointments. Many topical medications are epicutaneous, meaning that they are applied directly to the skin. Topical medications may also be inhalational, such as asthma medications, or applied to the surface of tissues other than the skin, such as eye drops applied to the conjunctiva, or ear drops placed in the ear, or medications applied to the surface of a tooth. The word topical derives from Greek τοπικός topikos, \"of a place\". Topical drug delivery is a route of administering drugs via the skin to provide topical therapeutic effects."}, "cross_references": [{"found_name": "liniment", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2249, "target_cluster_name": "linimento", "source_book": "llm_generated", "evidence_snippet": "Liniments are topical medications, similar in application and purpose to ointments, but typically liquid or semi-liquid.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Liniments are topical medications, similar in application and purpose to ointments, but typically liquid or semi-liquid."}, {"found_name": "linimento", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2249, "target_cluster_name": "linimento", "source_book": "llm_generated", "evidence_snippet": "Ointments are topical preparations applied to the skin for medicinal purposes, similar to liniments, but typically have a thicker, greasy consistency.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Ointments are topical preparations applied to the skin for medicinal purposes, similar to liniments, but typically have a thicker, greasy consistency.", "is_reverse": true}]}, {"canonical_name": "Agarico", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 75, "members": [{"entity_id": "agarico", "book_id": "historia_medicinal_monardes_1574", "name": "Agarico", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Agarico"], "contexts": ["plant mixed with the root", "agaric, a strong emetic"]}, {"entity_id": "agarico", "book_id": "ricettario_fiorentino_1597", "name": "Agarico", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 21, "variants": ["Agarico", "Agarico buono", "Agarico trocifca", "agarico"], "contexts": ["purgative medicine", "herb used in trochisci for purging"]}, {"entity_id": "agarico", "book_id": "polyanthea_medicinal", "name": "Agarico", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 51, "variants": ["Agarico", "Agarici", "Agarico trocifcado", "Agarico trociscado", "agaric", "agarico", "agarico trocifcado", "agarico trociſcado", "agaricotro", "agaricotrocifcado"], "contexts": ["purgative remedy for headaches", "agaric for pills"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Agarico", "target_book": "ricettario_fiorentino_1597", "target_name": "Agarico", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Agarico", "target_book": "polyanthea_medicinal", "target_name": "Agarico", "similarity": 1.0}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Agarico", "target_book": "polyanthea_medicinal", "target_name": "Agarico", "similarity": 1.0}], "id": 567, "stable_key": "clu_a5ba863c1af679a8", "ground_truth": {"modern_name": "Agaric fungus", "confidence": "high", "type": "plant", "family": "Agaricaceae", "description": "A purgative fungus used in historical medicine.", "note": "Refers to the medicinal properties of various fungi, particularly from the genus Fomes.", "wikipedia_extract": "Laricifomes officinalis, also known as agarikon, eburiko, or the quinine conk, is a wood-decay fungus that grows in large conks on the trunks of trees. It causes brown heart rot on conifers in Eurasia, Morocco, and North America. This fungus is the only member of the genus Laricifomes. There has been a history of human use of the fungus, from textiles, to ritualistic masks, and medicinal use; the name \"quinine conk\" refers to its bitter taste. There is recent scientific evidence of it having potency against several viruses. This mushroom is also known as Fomitopsis officinalis."}, "cross_references": [{"found_name": "zucchero", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 254, "target_cluster_name": "Sugar", "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "fine aggi ugni te , facci la decozzi one di liero I cpithymo , che habbi vn boi- di capra* lore, éc leua da fuoco ^ & ag- giugni Heìl boro nero Agarico Saie indo cioè zucchero . 31.^. Lafcia freddare,", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "alternative name for Sale indo"}, {"found_name": "Sale indo", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 254, "target_cluster_name": "Sugar", "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "b, Fa ma({à. PILLOLE I N D E DI Hdy fecondo Mefite, IVlHeUcboro . nero(canalato& jfan.jjv. cauato ;l midollo Polypodio Epithymo St^cadc Agarico Lapislazzoli la- nate Colocynthida f • S • Sale indo cio", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "alternative name for zucchero can"}, {"found_name": "fungos", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 158, "target_cluster_name": "fungos", "source_book": "llm_generated", "evidence_snippet": "Agaric fungus is a specific type of fungus, often referring to mushrooms.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Agaric fungus is a specific type of fungus, often referring to mushrooms.", "is_reverse": true}, {"found_name": "Bellirici", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "fine aggi ugni te , facci la decozzi one di liero I cpithymo , che habbi vn boi- di capra* lore, éc leua da fuoco ^ & ag- giugni Heìl boro nero Agarico Saie indo cioè zucchero . 31.^. Lafcia freddare,", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "alternative name for Mirabolani del Montano"}]}, {"canonical_name": "baromètre", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 3, "total_mentions": 72, "members": [{"entity_id": "baromètre", "book_id": "relation_historique_humboldt_vol3_1825", "name": "baromètre", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 43, "variants": ["baromètre", "BAROMÈTRE", "baromètres", "baromètres portatifs", "barométriques"], "contexts": ["instrument for measuring atmospheric pressure", "instrument used for measurement"]}, {"entity_id": "barometer", "book_id": "kosmos_humboldt_1845", "name": "barometer", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 13, "variants": ["Barometer", "barometer"], "contexts": ["instrument measuring atmospheric pressure", "device for measuring atmospheric pressure"]}, {"entity_id": "barometrical", "book_id": "kosmos_humboldt_1845", "name": "barometrical", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["barometrical"], "contexts": ["related to barometric pressure measurement"]}, {"entity_id": "barometer", "book_id": "connexion_physical_sciences_somerville_1858", "name": "barometer", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 15, "variants": ["barometer", "Barometer"], "contexts": ["measures atmospheric pressure", "instrument for measuring atmospheric pressure"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "baromètre", "target_book": "kosmos_humboldt_1845", "target_name": "barometer", "similarity": 0.913}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "baromètre", "target_book": "kosmos_humboldt_1845", "target_name": "barometrical", "similarity": 0.882}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "baromètre", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "barometer", "similarity": 0.913}, {"source_book": "kosmos_humboldt_1845", "source_name": "barometer", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "barometer", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "barometrical", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "barometer", "similarity": 0.933}], "id": 568, "stable_key": "clu_6c2aa5405927bf2c", "ground_truth": {"modern_name": "Barometer", "confidence": "high", "type": "object", "wikipedia_extract": "An altimeter or an altitude meter is an instrument used to measure the altitude of an object above a fixed level. The measurement of altitude is called altimetry, which is related to the term bathymetry, the measurement of depth under water. In 1931, the US Army Air corps and General Electric together tested a sonic altimeter for aircraft, which was considered more reliable and accurate than one that relied on air pressure when heavy fog or rain was present. The new altimeter used a series of high-pitched sounds like those made by a bat to measure the distance from the aircraft to the surface, which on return to the aircraft was converted to feet shown on a gauge inside the aircraft cockpit. A radar altimeter measures altitude more directly, using the time taken for a radio signal to reflect from the surface back to the aircraft. Alternatively, Frequency Modulated Continuous-wave radar can be used.", "wikipedia_url": "https://en.wikipedia.org/wiki/Altimeter"}, "cross_references": [{"found_name": "chronometers", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 853, "target_cluster_name": "chronomètres", "source_book": "llm_generated", "evidence_snippet": "Both are timekeeping and measurement devices, with 'chronomètres' being the French spelling of 'chronometers'.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "Both are timekeeping and measurement devices, with 'chronomètres' being the French spelling of 'chronometers'."}, {"found_name": "Thermometer", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 320, "target_cluster_name": "Thermometer", "source_book": "llm_generated", "evidence_snippet": "Both a