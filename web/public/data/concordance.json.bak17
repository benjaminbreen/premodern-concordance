_cluster_id": 1538, "target_cluster_name": "ervas", "source_book": "llm_generated", "evidence_snippet": "This is a specific type of herb, emphasizing its aromatic properties, which aligns with the general description of herbs.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: This is a specific type of herb, emphasizing its aromatic properties, which aligns with the general description of herbs.", "is_reverse": true}]}, {"canonical_name": "caroços", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "caroços", "book_id": "coloquios_da_orta_1563", "name": "caroços", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["caroços", "cardos"], "contexts": ["part of the fruit", "pits of fruits"]}, {"entity_id": "caroços_deginjas", "book_id": "polyanthea_medicinal", "name": "caroços deginjas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["caroços deginjas"], "contexts": ["plum kernels"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "caroços", "target_book": "polyanthea_medicinal", "target_name": "caroços deginjas", "similarity": 0.887}], "id": 2869, "stable_key": "clu_0d5d774398fbb33b", "ground_truth": {"modern_name": "plum kernels", "confidence": "high", "type": "plant", "note": "The term 'caroços' translates to 'kernels' or 'stones', and 'caroços deginjas' specifically refers to plum kernels."}, "cross_references": []}, {"canonical_name": "nabo", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 4, "total_mentions": 9, "members": [{"entity_id": "nabo", "book_id": "coloquios_da_orta_1563", "name": "nabo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["nabo", "nabos"], "contexts": ["turnip, a vegetable", "vegetable cut by a knife"]}, {"entity_id": "naboca", "book_id": "polyanthea_medicinal", "name": "naboca", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["naboca"], "contexts": ["root of pellitory"]}, {"entity_id": "turnip", "book_id": "english_physician_1652", "name": "Turnip", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Turnip", "Turnep"], "contexts": ["root vegetable", "Turnep Leavs"]}, {"entity_id": "turnip", "book_id": "origin_of_species_darwin_1859", "name": "Turnip", "category": "PLANT", "subcategory": "HERB", "count": 2, "variants": ["turnip", "Turnip"], "contexts": ["domestic variety with thickened stems", "analogous variations"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "nabo", "target_book": "polyanthea_medicinal", "target_name": "naboca", "similarity": 0.91}], "id": 2870, "stable_key": "clu_96cdd3d4798114b6", "ground_truth": {"modern_name": "Turnips", "confidence": "high", "type": "plant", "linnaean": "Brassica rapa subsp. rapa", "family": "Brassicaceae", "description": "A root vegetable widely cultivated and used in food and remedies.", "wikipedia_extract": "The turnip or white turnip (Brassica rapa subsp. rapa) is a root vegetable commonly grown in temperate climates worldwide for its white, fleshy taproot. Small, tender varieties are grown for human consumption, while larger varieties are grown as feed for livestock. The name turnip – used in many regions – may also be used to refer to rutabaga (or neep or swede), which is a different but related vegetable. The origin of the word turnip is uncertain, though it is hypothesised that it could be a compound of turn as in turned/rounded on a lathe and neep, derived from Latin napus, the word for the plant. According to An Universal Etymological English Dictionary (1721), turn refers to \"round napus to distinguish it from the napi, which were generally long\". The most common type of turnip is mostly white-skinned except for the upper 1 to 6 centimetres (1⁄2 to 2+1⁄2 inches)."}, "member_count": 4, "cross_references": [{"found_name": "Radish", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2152, "target_cluster_name": "rabãos", "source_book": "llm_generated", "evidence_snippet": "Turnips and radishes are both root vegetables belonging to the Brassicaceae family, often cultivated and used similarly in culinary contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Turnips and radishes are both root vegetables belonging to the Brassicaceae family, often cultivated and used similarly in culinary contexts."}, {"found_name": "Cabbage", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2175, "target_cluster_name": "cabbage", "source_book": "llm_generated", "evidence_snippet": "Turnips and cabbage are both common vegetables belonging to the Brassicaceae family, sharing a close botanical and culinary relationship.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Turnips and cabbage are both common vegetables belonging to the Brassicaceae family, sharing a close botanical and culinary relationship."}, {"found_name": "nabo", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "origin_of_species_darwin_1859", "evidence_snippet": "unknown influences. In the vegetable kingdom we have a case of analogous variation, in the enlarged stems, or roots as commonly called, of the Swedish turnip and Ruta baga, plants which several botani", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for Turnip"}, {"found_name": "Ruta baga", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "origin_of_species_darwin_1859", "evidence_snippet": "unknown influences. In the vegetable kingdom we have a case of analogous variation, in the enlarged stems, or roots as commonly called, of the Swedish turnip and Ruta baga, plants which several botani", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "a plant that is related to or a variety of Turnip"}]}, {"canonical_name": "náos", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "náos", "book_id": "coloquios_da_orta_1563", "name": "náos", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 4, "variants": ["náos"], "contexts": ["ships used by the Chinese", "ships used by merchants"]}, {"entity_id": "náo", "book_id": "polyanthea_medicinal", "name": "náo", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["náo"], "contexts": ["stopped by Remora"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "náos", "target_book": "polyanthea_medicinal", "target_name": "náo", "similarity": 0.903}], "id": 2871, "stable_key": "clu_3a6de248f6a4e5de", "ground_truth": {"modern_name": "ship", "confidence": "high", "type": "object", "note": "The Portuguese word 'náo' or 'náos' (plural) historically referred to a type of ship, particularly those used in trade and exploration during the early modern period."}, "cross_references": []}, {"canonical_name": "ponente", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "ponente", "book_id": "coloquios_da_orta_1563", "name": "ponente", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["ponente"], "contexts": ["western regions", "direction of the west"]}, {"entity_id": "ponente", "book_id": "ricettario_fiorentino_1597", "name": "Ponente", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Ponente"], "contexts": ["region producing musk"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "ponente", "target_book": "ricettario_fiorentino_1597", "target_name": "Ponente", "similarity": 0.567}], "id": 2872, "stable_key": "clu_91816a699fe34669", "ground_truth": {"modern_name": "west", "confidence": "high", "type": "concept", "note": "In early modern texts, 'ponente' (or 'Ponente') refers to the west or western regions, often in a geographical or directional sense. The context of 'region producing musk' further solidifies this directional interpretation, as certain Western or Eastern regions might have been known for specific products.", "wikidata_id": "", "wikidata_description": "family name"}, "cross_references": []}, {"canonical_name": "estoraque", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "estoraque", "book_id": "coloquios_da_orta_1563", "name": "estoraque", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["estoraque", "esioraque"], "contexts": ["substance from Ethiopia", "substance similar to lacre"]}, {"entity_id": "estoraque", "book_id": "polyanthea_medicinal", "name": "estoraque", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["estoraque"], "contexts": ["aromatic resin used in medicine", "storax, ingredient in pills"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "estoraque", "target_book": "polyanthea_medicinal", "target_name": "estoraque", "similarity": 1.0}], "id": 2873, "stable_key": "clu_bf0373ce9a3835b8", "ground_truth": {"modern_name": "Storax", "confidence": "high", "type": "plant", "description": "Aromatic resin from trees, used in perfumery and medicine.", "note": "'Estoraque' is the Portuguese/Spanish term for storax, a resin derived from trees of the genus Styrax.", "wikipedia_extract": "Storax (Latin: storax; Greek: στύραξ, stúrax), often commercially sold as styrax, is a natural fragrant resin isolated from the wounded bark of Liquidambar orientalis Mill. (Asia Minor) and Liquidambar styraciflua L. (Eastern US, Mexico, Central America) (Altingiaceae). It is distinct from benzoin (also called \"storax\"), a similar resin obtained from the Styracaceae plant family. Purified storax contains about 33–50% storesin, an alcoholic resin,  5–15% cinnamic acid, 5–15% cinnamyl cinnamate, about 10% phenylpropyl cinnamate, as well small amounts of ethyl cinnamate, benzyl cinnamate, and styrene. Some may contain traces of vanillin or triterpenic acids (oleanolic and 3-epioleanolic acids). Storax has a balsamic, floral/lilac, and leathery smell. It and its derivatives (resinoid, essential oil, absolute) are used as flavors and fragrances, as well as in pharmaceuticals (Friar's Balsam)."}, "cross_references": [{"found_name": "Balsam", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3751, "target_cluster_name": "balfamo", "source_book": "llm_generated", "evidence_snippet": "Storax is a natural fragrant resin, and 'Balsam' is a related category of fragrant resins.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Storax is a natural fragrant resin, and 'Balsam' is a related category of fragrant resins."}, {"found_name": "Frankincense", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 653, "target_cluster_name": "incenso", "source_book": "llm_generated", "evidence_snippet": "Storax is a natural fragrant resin, and 'Frankincense' is another type of fragrant resin often discussed in similar contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Storax is a natural fragrant resin, and 'Frankincense' is another type of fragrant resin often discussed in similar contexts."}, {"found_name": "Myrrh", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 583, "target_cluster_name": "Myrrha", "source_book": "llm_generated", "evidence_snippet": "Storax is a natural fragrant resin, and 'Myrrh' is another type of fragrant resin often discussed in similar contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Storax is a natural fragrant resin, and 'Myrrh' is another type of fragrant resin often discussed in similar contexts."}]}, {"canonical_name": "faca", "category": "OBJECT", "subcategory": "TOOL", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "faca", "book_id": "coloquios_da_orta_1563", "name": "faca", "category": "OBJECT", "subcategory": "TOOL", "count": 3, "variants": ["faca", "facas"], "contexts": ["knife, a cutting tool", "tool for cutting"]}, {"entity_id": "faca", "book_id": "polyanthea_medicinal", "name": "faca", "category": "OBJECT", "subcategory": "TOOL", "count": 2, "variants": ["faca"], "contexts": ["brought a knife", "tool for cutting testicles"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "faca", "target_book": "polyanthea_medicinal", "target_name": "faca", "similarity": 1.0}], "id": 2874, "stable_key": "clu_8fca22e156cdc9b2", "ground_truth": {"modern_name": "knife", "confidence": "high", "type": "object"}, "cross_references": []}, {"canonical_name": "simples", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "simples", "book_id": "coloquios_da_orta_1563", "name": "simples", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["simples"], "contexts": ["medicines from India", "single medicinal ingredient"]}, {"entity_id": "simplices", "book_id": "polyanthea_medicinal", "name": "Simplices", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Simplices"], "contexts": ["simple remedies"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "simples", "target_book": "polyanthea_medicinal", "target_name": "Simplices", "similarity": 0.932}], "id": 2875, "stable_key": "clu_db551c5b32287ce2", "ground_truth": {"modern_name": "Simple remedies", "confidence": "high", "type": "concept", "description": "Medicinal substances derived from single, unprocessed natural sources.", "note": "'Simples' refers to single, uncompounded medicinal ingredients, often plants.", "wikipedia_extract": "The doctrine of signatures, also known as the doctrine of correspondences, is a biomedicinal theory of pseudoscience. It states that herbs or animals have physical or behavioral traits that mirror the ailment it can successfully treat. Theological justifications, such as that of botanist William Cole, were that God would want to show men what plants would be useful for. The doctrine of signatures has a debated origin. Many historians believe it begins with primitive thinking methods, while other historians believe it originated with Dioscorides and was popularized in the 16th and 17th centuries after Jakob Böhme coined the doctrine of signatures in his book The Signature of All Things. This theory is a possible explanation for the ancient discovery of medicinal properties; however, there is no definitive proof as to whether the medicinal property or the connection in physical/behavioral traits was realized first."}, "cross_references": [{"found_name": "Plants", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 16, "target_cluster_name": "Plants", "source_book": "llm_generated", "evidence_snippet": "'Simples' are a category of medicinal plants, making 'Plants' a direct synonym in a broader sense.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "'Simples' are a category of medicinal plants, making 'Plants' a direct synonym in a broader sense."}, {"found_name": "ervas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1538, "target_cluster_name": "ervas", "source_book": "llm_generated", "evidence_snippet": "Herbs were a primary component of 'simple remedies' in premodern medicine, indicating a strong functional relationship.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Herbs were a primary component of 'simple remedies' in premodern medicine, indicating a strong functional relationship.", "is_reverse": true}]}, {"canonical_name": "buxo", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "buxo", "book_id": "coloquios_da_orta_1563", "name": "buxo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["buxo"], "contexts": ["plant used for comparison of color", "plant resembling the tree"]}, {"entity_id": "buxo", "book_id": "polyanthea_medicinal", "name": "buxo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["buxo"], "contexts": ["box tree", "elder plant"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "buxo", "target_book": "polyanthea_medicinal", "target_name": "buxo", "similarity": 1.0}], "id": 2876, "stable_key": "clu_d4e4ef3be614be24", "ground_truth": {"modern_name": "Box tree", "confidence": "high", "type": "plant", "linnaean": "Buxus sempervirens", "family": "Buxaceae", "description": "Shrub with evergreen leaves, used for comparison and its wood.", "note": "Mentions of 'elder plant' might indicate a confusion or a less common usage.", "wikipedia_extract": "Buxus sempervirens, the common box, European box, or boxwood, is a species of flowering plant in the genus Buxus, native to western and southern Europe, northwest Africa, and southwest Asia, from southern England south to northern Morocco, and east through the northern Mediterranean region to Turkey. Buxus colchica of western Caucasus and B. hyrcana of northern Iran and eastern Caucasus are commonly treated as synonyms of B. sempervirens. Buxus sempervirens is an evergreen shrub or small tree growing 1 to 9 m (3 to 30 ft) tall, with a trunk up to 20 centimetres (8 in) in diameter (exceptionally to 10 m tall and 45 cm diameter). Arranged in opposite pairs along the stems, the leaves are green to yellow-green, oval, 1.5–3 cm long, and 0.5–1.3 cm broad. The monoecious flowers are inconspicuous but highly scented, greenish-yellow, with no petals, and are insect pollinated; the fruit is a three-lobed capsule containing three to six seeds. The species typically grows on soils derived from chalk, limestone, usually as an understorey in forests of larger trees, most commonly associated with European beech (Fagus sylvatica) forests, but also sometimes in open dry montane scrub, particularly in the Mediterranean region."}, "cross_references": [{"found_name": "arvore", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1632, "target_cluster_name": "arvore", "source_book": "llm_generated", "evidence_snippet": "Box tree is a tree.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Box tree is a tree.", "is_reverse": true}]}, {"canonical_name": "Zerumbet", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "zerumbet", "book_id": "coloquios_da_orta_1563", "name": "Zerumbet", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Zerumbet", "ZERUMBET", "zerumbet"], "contexts": ["subject of colloquy", "plant with debated identity"]}, {"entity_id": "zurumbet", "book_id": "ricettario_fiorentino_1597", "name": "Zurumbet", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Zurumbet"], "contexts": ["a type of ginger or spice", "ingredient in a preparation"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Zerumbet", "target_book": "ricettario_fiorentino_1597", "target_name": "Zurumbet", "similarity": 0.895}], "id": 2877, "stable_key": "clu_dbff154057a4fc43", "ground_truth": {"modern_name": "Zerumbet ginger", "confidence": "high", "type": "plant", "linnaean": "Zingiber zerumbet Smith", "family": "Zingiberaceae", "note": "Zerumbet (or Zurumbet) is a historical name for Zingiber zerumbet, a species of ginger known for its medicinal and culinary uses, often mentioned in early modern botanical and pharmacopoeial texts.", "wikidata_id": "Q60980", "wikidata_description": "species of plant"}, "cross_references": [{"found_name": "zedoaria", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 767, "target_cluster_name": "zedoaria", "source_book": "llm_generated", "evidence_snippet": "Zerumbet ginger (Zingiber zerumbet) is another rhizomatous plant from the Zingiberaceae family, closely related to Zedoary. They share botanical characteristics and historical uses.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Zerumbet ginger (Zingiber zerumbet) is another rhizomatous plant from the Zingiberaceae family, closely related to Zedoary. They share botanical characteristics and historical uses.", "is_reverse": true}, {"found_name": "Amomum", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2029, "target_cluster_name": "Amomum", "source_book": "llm_generated", "evidence_snippet": "Zerumbet ginger is a species within the genus Zingiber, which is in the same family (Zingiberaceae) as Amomum. Both are known for their aromatic properties.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Zerumbet ginger is a species within the genus Zingiber, which is in the same family (Zingiberaceae) as Amomum. Both are known for their aromatic properties.", "is_reverse": true}, {"found_name": "Zingiberales", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2852, "target_cluster_name": "Scitaminea", "source_book": "llm_generated", "evidence_snippet": "Zerumbet ginger is a member of the order Zingiberales.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Zerumbet ginger is a member of the order Zingiberales."}, {"found_name": "Turmeric", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1807, "target_cluster_name": "Curcuma", "source_book": "llm_generated", "evidence_snippet": "Zerumbet ginger and turmeric are both rhizomatous plants in the Zingiberaceae family, often used for culinary and medicinal purposes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Zerumbet ginger and turmeric are both rhizomatous plants in the Zingiberaceae family, often used for culinary and medicinal purposes."}, {"found_name": "Galangal", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 270, "target_cluster_name": "Galbano", "source_book": "llm_generated", "evidence_snippet": "Zerumbet ginger and galangal are both rhizomatous plants in the Zingiberaceae family, often used for culinary and medicinal purposes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Zerumbet ginger and galangal are both rhizomatous plants in the Zingiberaceae family, often used for culinary and medicinal purposes."}]}, {"canonical_name": "carminativo", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "carminativo", "book_id": "coloquios_da_orta_1563", "name": "carminativo", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["carminativo", "carminativa"], "contexts": ["medicinal property of 'folio indo'", "property of linaloes"]}, {"entity_id": "carminativas", "book_id": "coloquios_da_orta_1563", "name": "carminativas", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["carminativas"], "contexts": ["medicinal property for gas"]}, {"entity_id": "carminativas", "book_id": "polyanthea_medicinal", "name": "carminativas", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["carminativas"], "contexts": ["medicines to expel gas"]}, {"entity_id": "carminativos", "book_id": "polyanthea_medicinal", "name": "Carminativos", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Carminativos"], "contexts": ["medicines to dispel windiness"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "carminativo", "target_book": "polyanthea_medicinal", "target_name": "carminativas", "similarity": 0.91}, {"source_book": "coloquios_da_orta_1563", "source_name": "carminativo", "target_book": "polyanthea_medicinal", "target_name": "Carminativos", "similarity": 0.909}, {"source_book": "coloquios_da_orta_1563", "source_name": "carminativas", "target_book": "polyanthea_medicinal", "target_name": "carminativas", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "carminativas", "target_book": "polyanthea_medicinal", "target_name": "Carminativos", "similarity": 0.929}], "id": 2878, "stable_key": "clu_d7188c6ff1f374c7", "ground_truth": {"modern_name": "carminative", "confidence": "high", "type": "concept", "wikidata_id": "Q1734091", "wikidata_description": "herb or preparation intended to either prevent formation of gas in the gastrointestinal tract or facilitate the expulsion of said gas, thereby combatting flatulence"}, "cross_references": []}, {"canonical_name": "Agnocasto", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "agnocasto", "book_id": "coloquios_da_orta_1563", "name": "agnocasto", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["agnocasto", "agnO'Casto"], "contexts": ["plant used to repress carnal desires", "plant distinguished from negundo"]}, {"entity_id": "agnocasto", "book_id": "polyanthea_medicinal", "name": "Agnocasto", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Agnocasto", "Agnocafto", "agnocasto"], "contexts": ["chaste tree", "chaste tree, herb"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "agnocasto", "target_book": "polyanthea_medicinal", "target_name": "Agnocasto", "similarity": 0.98}], "id": 2879, "stable_key": "clu_00c3e67d228078fd", "ground_truth": {"modern_name": "Chaste tree", "confidence": "high", "type": "plant", "linnaean": "Vitex agnus-castus", "family": "Lamiaceae", "description": "Shrub whose berries were used to reduce libido and for medicinal purposes.", "note": "'Agnocasto' is the Italian/Portuguese name for Vitex agnus-castus.", "wikipedia_extract": "Vitex agnus-castus (also called vitex,  chaste tree / chastetree, chasteberry, Abraham's balm, lilac chastetree, or monk's pepper) is a plant native of the Mediterranean region. It is one of the few temperate-zone species of Vitex, which is on the whole a genus of tropical and subtropical flowering plants. Vitex is a cross-pollinating plant, but its self-pollination has been recorded. Theophrastus mentioned the shrub several times, as ágnos (ἄγνος) in Enquiry into Plants. It has been long believed to be an anaphrodisiac – leading to its name as \"chaste tree\" – but its effectiveness for such action remains unproven. The shrub was utilized for religious rituals in ancient Greece and among the Philistines in modern-day Israel."}, "cross_references": [{"found_name": "Vitex", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2930, "target_cluster_name": "Vitex", "source_book": "llm_generated", "evidence_snippet": "A direct translation/cognate of 'Chaste tree' in Portuguese, indicating the same plant.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: A direct translation/cognate of 'Chaste tree' in Portuguese, indicating the same plant.", "is_reverse": true}]}, {"canonical_name": "milho miudo", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "milho", "book_id": "coloquios_da_orta_1563", "name": "milho", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["milho"], "contexts": ["plant", "seeds similar to long pepper"]}, {"entity_id": "milho_miudo", "book_id": "polyanthea_medicinal", "name": "milho miudo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["milho miudo"], "contexts": ["small millet used in syrup", "ingredient in a preparation"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "milho", "target_book": "polyanthea_medicinal", "target_name": "milho miudo", "similarity": 0.924}], "id": 2880, "stable_key": "clu_e76bec39b57bec9b", "ground_truth": {"modern_name": "millet", "confidence": "high", "type": "plant", "description": "A small-grained cereal grass, used as food and in preparations.", "note": "The term 'milho miudo' specifically refers to small millet.", "wikipedia_extract": "Millets () are a highly varied group of small-seeded grasses, widely grown around the world as cereal crops or grains for fodder and human food. Most millets belong to the tribe Paniceae. Millets are important crops in the semi-arid tropics of Asia and Africa, especially in India, Mali, Nigeria, and Niger, with 97% of production in developing countries. The crop is favoured for its productivity and short growing season under hot dry conditions. The millets are sometimes understood to include the widely cultivated sorghum; apart from that, pearl millet is the most commonly cultivated of the millets. Finger millet, proso millet, barnyard millet, little millet, kodo millet, browntop millet and foxtail millet are other important crop species."}, "cross_references": [{"found_name": "Grains", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2320, "target_cluster_name": "grãos", "source_book": "llm_generated", "evidence_snippet": "Millet is a type of grain.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Millet is a type of grain."}, {"found_name": "Barley", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1570, "target_cluster_name": "Cevada", "source_book": "llm_generated", "evidence_snippet": "Millet and barley are both cereal grains.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Millet and barley are both cereal grains."}, {"found_name": "Wheat", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 102, "target_cluster_name": "Wheat", "source_book": "llm_generated", "evidence_snippet": "Millet and wheat are both cereal grains.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Millet and wheat are both cereal grains."}]}, {"canonical_name": "Carlos Magno", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "carlos_magno", "book_id": "coloquios_da_orta_1563", "name": "Carlos Magno", "category": "PERSON", "subcategory": "PATRON", "count": 2, "variants": ["Carlos Magno"], "contexts": ["recipient of a gift", "historical ruler mentioned with numbers"]}, {"entity_id": "carlos_magno", "book_id": "polyanthea_medicinal", "name": "Carlos Magno", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Carlos Magno", "Alexandre Magno"], "contexts": ["Emperor who received root from an Angel", "Emperor Charles the Great"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Carlos Magno", "target_book": "polyanthea_medicinal", "target_name": "Carlos Magno", "similarity": 0.766}], "id": 2881, "stable_key": "clu_2d75ef2e5c0c5b40", "ground_truth": {"modern_name": "Charlemagne", "confidence": "high", "type": "person", "birth_year": 747, "death_year": 814, "description": "Frankish king and Holy Roman Emperor, historical figure", "wikidata_id": "Q3044", "wikidata_description": "king of Franks, regarded as the first Holy Roman Emperor (747–814)"}, "cross_references": [{"found_name": "Emperadores", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2523, "target_cluster_name": "Emperadores", "source_book": "llm_generated", "evidence_snippet": "Charlemagne was crowned Emperor of the Romans, a foundational figure in the concept of Emperor in Western Europe.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Charlemagne was crowned Emperor of the Romans, a foundational figure in the concept of Emperor in Western Europe.", "is_reverse": true}, {"found_name": "Julian", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2663, "target_cluster_name": "Julian", "source_book": "llm_generated", "evidence_snippet": "Both Julian and Charlemagne were significant rulers who sought to revive or reform aspects of the Roman Empire, albeit in different historical contexts and with different approaches. Their reigns represent attempts to consolidate power and influence.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both Julian and Charlemagne were significant rulers who sought to revive or reform aspects of the Roman Empire, albeit in different historical contexts and with different approaches. Their reigns represent attempts to consolidate power and influence.", "is_reverse": true}, {"found_name": "Albertus Magnus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2461, "target_cluster_name": "Alberto Magno", "source_book": "llm_generated", "evidence_snippet": "Both were prominent figures in European history and intellectual life, Albertus Magnus as a philosopher and theologian, and Charlemagne as an emperor and patron of learning.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were prominent figures in European history and intellectual life, Albertus Magnus as a philosopher and theologian, and Charlemagne as an emperor and patron of learning."}, {"found_name": "Alexander the Great", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 697, "target_cluster_name": "Alexandre", "source_book": "llm_generated", "evidence_snippet": "Both were legendary military leaders and conquerors who left a significant mark on history and culture.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were legendary military leaders and conquerors who left a significant mark on history and culture."}, {"found_name": "Averroes", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 952, "target_cluster_name": "Averroes", "source_book": "llm_generated", "evidence_snippet": "Both were influential figures in their respective spheres, Averroes in Islamic philosophy and medicine, and Charlemagne in European politics and the Carolingian Renaissance.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were influential figures in their respective spheres, Averroes in Islamic philosophy and medicine, and Charlemagne in European politics and the Carolingian Renaissance."}, {"found_name": "Avicenna", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1492, "target_cluster_name": "Avicena", "source_book": "llm_generated", "evidence_snippet": "Both were highly influential figures, Avicenna in Islamic medicine and philosophy, and Charlemagne in shaping the political and cultural landscape of Europe.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were highly influential figures, Avicenna in Islamic medicine and philosophy, and Charlemagne in shaping the political and cultural landscape of Europe."}, {"found_name": "Charles V, Holy Roman Emperor", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 771, "target_cluster_name": "Carlos V.", "source_book": "llm_generated", "evidence_snippet": "Both were Holy Roman Emperors who wielded significant power and influence over vast territories in Europe.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were Holy Roman Emperors who wielded significant power and influence over vast territories in Europe."}, {"found_name": "Constantine", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3293, "target_cluster_name": "Constantino", "source_book": "llm_generated", "evidence_snippet": "Both were pivotal rulers who significantly impacted the religious and political landscape of their respective eras, Constantine with Christianity and Charlemagne with the consolidation of the Holy Roman Empire.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were pivotal rulers who significantly impacted the religious and political landscape of their respective eras, Constantine with Christianity and Charlemagne with the consolidation of the Holy Roman Empire."}, {"found_name": "Emperor", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2523, "target_cluster_name": "Emperadores", "source_book": "llm_generated", "evidence_snippet": "Charlemagne was an Emperor, and this term refers to the role he held.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Charlemagne was an Emperor, and this term refers to the role he held."}]}, {"canonical_name": "mumia", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "múmia", "book_id": "coloquios_da_orta_1563", "name": "múmia", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["múmia"], "contexts": ["main ingredient in a 'solda'"]}, {"entity_id": "mumia", "book_id": "polyanthea_medicinal", "name": "mumia", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 4, "variants": ["mumia", "Mumia", "Mumia hominisfani", "Mumiade"], "contexts": ["mummy, ingredient in oil", "mummy, medicinal substance"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "múmia", "target_book": "polyanthea_medicinal", "target_name": "mumia", "similarity": 0.86}], "id": 2882, "stable_key": "clu_4e2c60a631f383b0", "ground_truth": {"modern_name": "mummy", "confidence": "high", "type": "substance", "description": "Preserved human or animal remains used as a medicinal substance.", "wikipedia_extract": "A mummy is a dead human or an animal whose soft tissues and organs have been preserved by either intentional or accidental exposure to chemicals, extreme cold, very low humidity, or lack of air, so that the recovered body does not decay further if kept in cool and dry conditions. Some authorities restrict the use of the term to bodies deliberately embalmed with chemicals, but the use of the word to cover accidentally desiccated bodies goes back to at least the early 17th century. Mummies of humans and animals have been found on every continent, both as a result of natural preservation through unusual conditions, and as cultural artifacts. Over one million animal mummies have been found in Egypt, many of which are cats. Many of the Egyptian animal mummies are sacred ibis, and radiocarbon dating suggests the Egyptian ibis mummies that have been analyzed were from a time frame that falls between approximately 450 and 250 BC. The earliest discovered evidence of deliberate mummification in human cultures now extends to approximately 10,000 B.C. and is documented to have existed across Southeast Asia, China, New Guinea, and Australia in burials discovered there, and is prompting research to cultures documented to 20,000 years ago for evidence of use of the same mummification methods."}, "cross_references": [{"found_name": "Earths", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1183, "target_cluster_name": "earths", "source_book": "llm_generated", "evidence_snippet": "The term 'mummy' (mumia) was historically used to refer to a substance derived from mummified bodies, which was often mixed with or considered akin to certain earths or powders used in medicine.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The term 'mummy' (mumia) was historically used to refer to a substance derived from mummified bodies, which was often mixed with or considered akin to certain earths or powders used in medicine."}]}, {"canonical_name": "rosalgar", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "rosalgar", "book_id": "coloquios_da_orta_1563", "name": "rosalgar", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["rosalgar"], "contexts": ["medicine administered"]}, {"entity_id": "rosalgar", "book_id": "polyanthea_medicinal", "name": "rosalgar", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 4, "variants": ["rosalgar", "rosalgar branco", "roſalgar"], "contexts": ["preparation, a refined poison", "arsenic"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "rosalgar", "target_book": "polyanthea_medicinal", "target_name": "rosalgar", "similarity": 0.526}], "id": 2883, "stable_key": "clu_2a9759c25f4a6cd6", "ground_truth": {"modern_name": "Realgar", "confidence": "high", "type": "mineral", "wikidata_id": "Q109746", "wikidata_description": "arsenic sulfide mineral"}, "cross_references": [{"found_name": "Terra santa", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2176, "target_cluster_name": "Terra santa", "source_book": "llm_generated", "evidence_snippet": "Realgar is a mineral form of arsenic sulfide, often found alongside stibnite (antimony sulfide), and historically confused or associated with antimony preparations due to similar appearances and uses.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Realgar is a mineral form of arsenic sulfide, often found alongside stibnite (antimony sulfide), and historically confused or associated with antimony preparations due to similar appearances and uses.", "is_reverse": true}, {"found_name": "Crocus metallorum", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 669, "target_cluster_name": "Crocus metallorum", "source_book": "llm_generated", "evidence_snippet": "Crocus metallorum, often referring to antimony trisulfide, was a substance with similar alchemical and medicinal applications to realgar. Both were considered potent substances with transformative properties.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Crocus metallorum, often referring to antimony trisulfide, was a substance with similar alchemical and medicinal applications to realgar. Both were considered potent substances with transformative properties."}]}, {"canonical_name": "impotencias", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "impotentes", "book_id": "coloquios_da_orta_1563", "name": "impotentes", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["impotentes"], "contexts": ["effect of camphor on men"]}, {"entity_id": "impotencias", "book_id": "polyanthea_medicinal", "name": "impotencias", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 4, "variants": ["impotencias", "impotencia"], "contexts": ["impotence", "inability to sleep"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "impotentes", "target_book": "polyanthea_medicinal", "target_name": "impotencias", "similarity": 0.967}], "id": 2884, "stable_key": "clu_ba0d5f7ccc1e357e", "ground_truth": {"modern_name": "impotence", "confidence": "high", "type": "disease", "description": "Inability to achieve or maintain sexual erection; general inability.", "wikipedia_extract": "Erectile dysfunction (ED), also referred to as impotence, is a form of sexual dysfunction in males characterized by the persistent or recurring inability to achieve or maintain a penile erection with sufficient rigidity and duration for satisfactory sexual activity. It is the most common sexual problem in males and can cause psychological distress due to its impact on self-image and sexual relationships. The term erectile dysfunction does not encompass other erection-related disorders, such as priapism. The majority of ED cases are attributed to physical risk factors and predictive factors. These factors can be categorized as vascular, neurological, local penile, hormonal, and drug-induced. Notable predictors of ED include aging, cardiovascular disease, diabetes mellitus, high blood pressure, obesity, abnormal lipid levels in the blood, hypogonadism, smoking, depression, and medication use."}, "cross_references": []}, {"canonical_name": "Cadmia", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "cadmia", "book_id": "ricettario_fiorentino_1597", "name": "Cadmia", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 4, "variants": ["Cadmia", "cadmi3", "cadmia", "cadmia naturale"], "contexts": ["mineral substance for heating", "cadmia, a zinc ore"]}, {"entity_id": "cadmium", "book_id": "connexion_physical_sciences_somerville_1858", "name": "cadmium", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["cadmium"], "contexts": ["metal producing a spectrum"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Cadmia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "cadmium", "similarity": 0.918}], "id": 2885, "stable_key": "clu_19825a6d180a1633", "ground_truth": {"modern_name": "Cadmium", "confidence": "high", "type": "chemical", "note": "The substance 'Cadmia' in early modern texts could refer to calamine (a zinc ore) or more broadly to zinc oxide or even impure zinc metal. The mention of a 'metal producing a spectrum' in Somerville's text strongly points to elemental cadmium, likely discovered in the early 19th century and named after the ore from which it was derived (cadmia)."}, "cross_references": [{"found_name": "Greci", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1663, "target_cluster_name": "Greci", "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "tondi, la qualefi difcer- ne dalla falla , come è detto : e però nelle ricette degli Arabi, douefi legge Tuzia, fi pigli la pompholige,<S: in quel/e de Greci , la cadmia della iorta , che é detto. DEL", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "reverse: mentioned in Greek recipes, equivalent to Tuzia", "is_reverse": true}, {"found_name": "Zinc", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 288, "target_cluster_name": "Zinc", "source_book": "llm_generated", "evidence_snippet": "Cadmium is a chemical element in the same group (Group 12) of the periodic table as zinc.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Cadmium is a chemical element in the same group (Group 12) of the periodic table as zinc.", "is_reverse": true}]}, {"canonical_name": "Scariola", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "scariola", "book_id": "ricettario_fiorentino_1597", "name": "Scariola", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Scariola"], "contexts": ["herb used in syrup", "ingredient in a syrup"]}, {"entity_id": "scariola", "book_id": "polyanthea_medicinal", "name": "Scariola", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Scariola"], "contexts": ["plant juice used in remedies"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Scariola", "target_book": "polyanthea_medicinal", "target_name": "Scariola", "similarity": 1.0}], "id": 2886, "stable_key": "clu_dad3bbd264e3606f", "ground_truth": {"modern_name": "Scariola", "confidence": "high", "type": "plant", "description": "A genus of plants, often referring to wild lettuce, used medicinally.", "note": "Likely refers to a species within the *Lactuca* genus, commonly known as wild lettuce.", "wikipedia_extract": "Lactuca, commonly known as lettuce, is a genus of flowering plants in the family Asteraceae. The genus includes at least 50 species, distributed worldwide, but mainly in temperate Eurasia. Its best-known representative is the garden lettuce (Lactuca sativa), with its many varieties. \"Wild lettuce\" commonly refers to the wild-growing relatives of common garden lettuce. Many species are common weeds. Lactuca species are diverse and take a wide variety of forms. They are annuals, biennials, perennials, or shrubs."}, "cross_references": []}, {"canonical_name": "Carlina", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "carlina", "book_id": "ricettario_fiorentino_1597", "name": "carlina", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["carlina"], "contexts": ["root collected and dried", "herb mentioned in the passage"]}, {"entity_id": "carlina", "book_id": "polyanthea_medicinal", "name": "Carlina", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Carlina", "Carlinu"], "contexts": ["root used as a remedy", "root used as antidote and for pestilence"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "carlina", "target_book": "polyanthea_medicinal", "target_name": "Carlina", "similarity": 0.875}], "id": 2887, "stable_key": "clu_1b00fbeffdbc5fc3", "ground_truth": {"modern_name": "Carlina", "confidence": "high", "type": "plant", "linnaean": "Carlina acaulis", "family": "Asteraceae", "note": "Carlina acaulis (carline thistle) is a well-known medicinal plant with a long history of use, particularly its root.", "wikidata_id": "Q1136447", "wikidata_description": "genus of plants"}, "cross_references": [{"found_name": "Cistus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4305, "target_cluster_name": "cistus", "source_book": "llm_generated", "evidence_snippet": "Carlina is a genus of flowering plants in the family Asteraceae, commonly known as carline thistles. Cistus is a genus of flowering plants in the rockrose family, Cistaceae. Both are Mediterranean shrubs and often found in similar habitats, and historically, their medicinal uses might have been confused or grouped together due to superficial similarities in appearance or habitat.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Carlina is a genus of flowering plants in the family Asteraceae, commonly known as carline thistles. Cistus is a genus of flowering plants in the rockrose family, Cistaceae. Both are Mediterranean shrubs and often found in similar habitats, and historically, their medicinal uses might have been confused or grouped together due to superficial similarities in appearance or habitat."}]}, {"canonical_name": "epatica", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "epatico", "book_id": "ricettario_fiorentino_1597", "name": "epatico", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["epatico"], "contexts": ["type of aloe juice"]}, {"entity_id": "epatica", "book_id": "polyanthea_medicinal", "name": "epatica", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["epatica"], "contexts": ["ingredient in a decoction for fever", "liverwort, a plant"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "epatico", "target_book": "polyanthea_medicinal", "target_name": "epatica", "similarity": 0.977}], "id": 2888, "stable_key": "clu_342ff50c28237c78", "ground_truth": {"modern_name": "liverwort", "confidence": "high", "type": "plant", "family": "Marchantiophyta", "description": "A small, non-vascular plant often used for liver ailments.", "note": "Historically, the term also referred to plants with lobed leaves, resembling the liver.", "wikipedia_extract": "Liverworts are a group of non-vascular land plants forming the division Marchantiophyta ( ). They may also be referred to as  hepatics. Like mosses and hornworts, they have a gametophyte-dominant life cycle, in which cells of the plant carry only a single set of genetic information. The division name was derived from the genus name Marchantia, named  after his father by French botanist Jean Marchant. It is estimated that there are about 9000 species of liverwort. Some of the more familiar species grow as a flattened leafless thallus, but most species are leafy with a form very much like a flattened moss."}, "cross_references": [{"found_name": "mosses", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2317, "target_cluster_name": "mosses", "source_book": "llm_generated", "evidence_snippet": "Liverworts are closely related to mosses, often grouped together in the division Bryophyta (sensu lato).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Liverworts are closely related to mosses, often grouped together in the division Bryophyta (sensu lato).", "is_reverse": true}, {"found_name": "sun", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 196, "target_cluster_name": "sun", "source_book": "pseudodoxia_epidemica_browne_1646", "evidence_snippet": "notwithstanding obtaineth that name from the figure of its leaves, and is one kind of Liverwort, or _Hepatica_. In _Milium Solis_, the Epithete of the Sun hath enlarged its opinion; which hath indeed ", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "reverse: a type of", "is_reverse": true}]}, {"canonical_name": "fol", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "fole", "book_id": "ricettario_fiorentino_1597", "name": "fole", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["fole"], "contexts": ["sun exposure"]}, {"entity_id": "fol", "book_id": "polyanthea_medicinal", "name": "fol", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["fol"], "contexts": ["page number indicator", "folio"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "fole", "target_book": "polyanthea_medicinal", "target_name": "fol", "similarity": 0.943}], "id": 2889, "stable_key": "clu_43d60f0d9b0b6be5", "ground_truth": {"modern_name": "Page", "confidence": "high", "type": "concept", "note": "The term 'fol' or 'fole' in early modern texts, especially when referring to page numbers (e.g., 'fol. 4'), is the abbreviation for 'folio', meaning a leaf of paper in a book, and by extension, a page.", "wikidata_id": "Q25632106", "wikidata_description": "concept in virtual memory"}, "cross_references": []}, {"canonical_name": "althea", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "althea", "book_id": "ricettario_fiorentino_1597", "name": "Althea", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Althea"], "contexts": ["herb used in plaster"]}, {"entity_id": "althea", "book_id": "polyanthea_medicinal", "name": "althea", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Althea", "althea"], "contexts": ["ingredient in unguento", "unguent used in a liniment"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Althea", "target_book": "polyanthea_medicinal", "target_name": "althea", "similarity": 0.82}], "id": 2890, "stable_key": "clu_d51a7dad640ac8f8", "ground_truth": {"modern_name": "Marshmallow", "confidence": "high", "type": "plant", "linnaean": "Althaea officinalis", "family": "Malvaceae", "note": "Althea is the classical Latin name for Althaea officinalis, commonly known as marshmallow, which has a long history of medicinal use.", "wikidata_id": "Q158496", "wikidata_description": "species of plant"}, "cross_references": []}, {"canonical_name": "inflamaçãodo cerebro", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "inflamaçãodo_cerebro", "book_id": "polyanthea_medicinal", "name": "inflamaçãodo cerebro", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 4, "variants": ["inflamaçãodo cerebro", "inflammaçaodo cerebro", "inflamma