49, "target_cluster_name": "Naples", "source_book": "llm_generated", "evidence_snippet": "Naples is the capital of the Campania region, which is located in southern Italy, adjacent to Calabria.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Naples is the capital of the Campania region, which is located in southern Italy, adjacent to Calabria.", "is_reverse": true}, {"found_name": "Sicily", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1843, "target_cluster_name": "Sicily", "source_book": "llm_generated", "evidence_snippet": "Calabria is a peninsula in Southern Italy, directly north of Sicily, and historically and geographically closely linked to the island.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Calabria is a peninsula in Southern Italy, directly north of Sicily, and historically and geographically closely linked to the island.", "is_reverse": true}, {"found_name": "Lombardie", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2049, "target_cluster_name": "Lombardie", "source_book": "llm_generated", "evidence_snippet": "Calabria is a region in southern Italy, historically associated with the Lombards, who also gave their name to Lombardy. Desiderius was king of the Lombards in northern Italy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Calabria is a region in southern Italy, historically associated with the Lombards, who also gave their name to Lombardy. Desiderius was king of the Lombards in northern Italy.", "is_reverse": true}, {"found_name": "Italy", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 88, "target_cluster_name": "Itália", "source_book": "llm_generated", "evidence_snippet": "Calabria is a region within Italy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Calabria is a region within Italy."}, {"found_name": "tiriamjabim