 family Passerellidae Two species in the Passerine family Estrildidae: Hedge sparrow, also known as the dunnock or hedge accentor in the family Prunellidae Sparrow (American poet) (born 1953), American poet, activist, musician, and rabble-rouser Robert Brown (footballer) (born 1856), Scottish footballer known by the nickname 'Sparrow' The Sparrow (1914 film), a 1914 French silent film Sparrows (1926 film), starring Mary Pickford The Sparrow (1972 film), Arabic title Al Asfour, a 1972 Egyptian film by director Youssef Chahine Sparrow (1993 film), a 1993 Italian drama film directed by Franco Zeffirelli Sparrow (2008 film), a Hong Kong film Sparrow (2010 film), a horror film directed by Shaun Troke Sparrows (2015 film), an Icelandic film directed by Rúnar Rúnarsson The Sparrow (novel), a 1996 science fiction novel by Mary Doria Russell The Sparrow (1967 play), by Alan Ayckbourn The Sparrow (2007 play), about a teenage girl with a troubled past Sparrows (album), by Anathallo, 2002 Sparrow (album), by Ashley Monroe, 2018 The Sparrows (band), a predecessor band to Steppenwolf that included John Kay Sparrows (band), a Canadian post hardcore trio Sparrow Quartet, American acoustic music group \"Sparrow\", by The Boo Radleys from Everything's Alright Forever \"Sparrow\", by Charlotte Church from Three \"Sparrow\", by Mo-dettes from The Story So Far \"Sparrow\", by Simon & Garfunkel from Wednesday Morning, 3 A.M."}, "cross_references": [{"found_name": "Birds", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 5, "target_cluster_name": "birds", "source_book": "llm_generated", "evidence_snippet": "Sparrows are a type of bird.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Sparrows are a type of bird."}]}, {"canonical_name": "mechanical power", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "mechanical_energies", "book_id": "principles_of_psychology_james_1890", "name": "mechanical energies", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mechanical energies"], "contexts": ["energy related to motion and force"]}, {"entity_id": "mechanical_power", "book_id": "connexion_physical_sciences_somerville_1858", "name": "mechanical power", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["mechanical power"], "contexts": ["power derived from mechanical systems", "force from motion"]}, {"entity_id": "mechanical_powers", "book_id": "first_principles_spencer_1862", "name": "mechanical powers", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mechanical powers"], "contexts": ["fundamental forces in mechanics"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "mechanical energies", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "mechanical power", "similarity": 0.917}, {"source_book": "principles_of_psychology_james_1890", "source_name": "mechanical energies", "target_book": "first_principles_spencer_1862", "target_name": "mechanical powers", "similarity": 0.889}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "mechanical power", "target_book": "first_principles_spencer_1862", "target_name": "mechanical powers", "similarity": 0.956}], "id": 1370, "stable_key": "clu_b31fea10cb7ed765", "ground_truth": {"modern_name": "Mechanical Energy", "confidence": "high", "type": "concept", "note": "The terms 'mechanical energies', 'mechanical power', and 'mechanical powers' all relate to the concept of energy associated with motion and forces.", "wikidata_id": "Q184550", "wikidata_description": "potential and kinetic energy associated with the position and movement of a physical object"}, "cross_references": [{"found_name": "Force", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 59, "target_cluster_name": "Force", "source_book": "llm_generated", "evidence_snippet": "Mechanical energy is a form of force, and historical texts often discuss them in close relation, particularly in the context of work and motion.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Mechanical energy is a form of force, and historical texts often discuss them in close relation, particularly in the context of work and motion."}]}, {"canonical_name": "ship", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "navio", "book_id": "polyanthea_medicinal", "name": "navio", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["navio"], "contexts": ["vessel for sea travel"]}, {"entity_id": "ship", "book_id": "connexion_physical_sciences_somerville_1858", "name": "ship", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["ship"], "contexts": ["vessel for water transport", "vessel for sea travel"]}, {"entity_id": "ship", "book_id": "first_principles_spencer_1862", "name": "ship", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["ship"], "contexts": ["vessel for sea travel"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "navio", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "ship", "similarity": 0.958}, {"source_book": "polyanthea_medicinal", "source_name": "navio", "target_book": "first_principles_spencer_1862", "target_name": "ship", "similarity": 0.958}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "ship", "target_book": "first_principles_spencer_1862", "target_name": "ship", "similarity": 1.0}], "id": 1371, "stable_key": "clu_85b5c0b3687c8ca3", "ground_truth": {"modern_name": "ship", "confidence": "high", "type": "object", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_extract": "A ship  is a large watercraft designed for travel across the surface of a body of water, carrying cargo or passengers, or in support of specialized tasks such as warfare, oceanography and fishing. Ships are generally distinguished from boats, based on size, shape, load capacity and purpose. Ships have supported exploration, trade, warfare, migration, colonization, and science. Ship transport is responsible for the largest portion of world commerce. The word ship has meant, depending on era and context, either simply a large vessel or specifically a full-rigged ship with three or more masts, each of which is square rigged. The earliest historical evidence of boats is found in Egypt during the 4th millennium BC."}, "cross_references": []}, {"canonical_name": "Dorpat", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "dorpat", "book_id": "principles_of_psychology_james_1890", "name": "Dorpat", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Dorpat"], "contexts": ["location of Bartels' research"]}, {"entity_id": "dorpat", "book_id": "kosmos_humboldt_1845", "name": "Dorpat", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Dorpat"], "contexts": ["location of observation"]}, {"entity_id": "dorpat", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Dorpat", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Dorpat"], "contexts": ["location of astronomical observation", "city where star occultation was observed"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Dorpat", "target_book": "kosmos_humboldt_1845", "target_name": "Dorpat", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Dorpat", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Dorpat", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Dorpat", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Dorpat", "similarity": 1.0}], "id": 1372, "stable_key": "clu_669cf112fcee3415", "ground_truth": {"modern_name": "Tartu", "confidence": "high", "type": "place", "country": "Estonia", "note": "Dorpat is the historical German name for Tartu.", "wikidata_id": "Q13972", "wikidata_description": "second most populous city in Estonia", "wikipedia_url": "https://en.wikipedia.org/wiki/Tartu", "wikipedia_extract": "Tartu is the second largest city in Estonia after Tallinn. Tartu has a population of 97,759 (as of 2024). It is 186 kilometres (116 miles) southeast of Tallinn and 245 kilometres (152 miles) northeast of Riga, Latvia. Tartu lies on the Emajõgi river, which connects the two largest lakes in Estonia, Lake Võrtsjärv and Lake Peipus. From the 13th century until the end of the 19th century, Tartu was known in most of the world by variants of its historical name Dorpat. Tartu, the largest urban centre of southern Estonia, is often considered the \"intellectual capital city\" of the country, especially as it is home to the nation's oldest and most renowned university, the University of Tartu (founded in 1632)."}, "cross_references": []}, {"canonical_name": "distances", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "distances", "book_id": "principles_of_psychology_james_1890", "name": "DISTANCES", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["DISTANCES"], "contexts": ["space between points"]}, {"entity_id": "distances", "book_id": "kosmos_humboldt_1845", "name": "distances", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["distances"], "contexts": ["spatial separation between celestial bodies"]}, {"entity_id": "distances", "book_id": "connexion_physical_sciences_somerville_1858", "name": "distances", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["distances"], "contexts": ["space between objects", "computed from parallax"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "DISTANCES", "target_book": "kosmos_humboldt_1845", "target_name": "distances", "similarity": 0.92}, {"source_book": "principles_of_psychology_james_1890", "source_name": "DISTANCES", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "distances", "similarity": 0.92}, {"source_book": "kosmos_humboldt_1845", "source_name": "distances", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "distances", "similarity": 1.0}], "id": 1373, "stable_key": "clu_fc53437a101a13bf", "ground_truth": {"modern_name": "Distance", "confidence": "high", "type": "concept"}, "cross_references": [{"found_name": "Apparent diameter", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3634, "target_cluster_name": "Apparent diameter", "source_book": "llm_generated", "evidence_snippet": "Apparent diameter is a measure of the angular size of an object, which is directly related to its physical size and its distance from the observer.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Apparent diameter is a measure of the angular size of an object, which is directly related to its physical size and its distance from the observer."}, {"found_name": "Diameter", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2457, "target_cluster_name": "diameter", "source_book": "llm_generated", "evidence_snippet": "Diameter is a measure of size, and when combined with apparent diameter, allows for the calculation of distance.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Diameter is a measure of size, and when combined with apparent diameter, allows for the calculation of distance."}, {"found_name": "Elevation", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 380, "target_cluster_name": "elevation", "source_book": "llm