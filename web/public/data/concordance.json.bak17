vidence_snippet": "Charles Lyell and Charles Darwin were close friends and colleagues. Lyell's work on geology, particularly his concept of uniformitarianism, profoundly influenced Darwin's thinking on evolution and natural selection. Darwin dedicated 'On the Origin of Species' to Lyell.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Charles Lyell and Charles Darwin were close friends and colleagues. Lyell's work on geology, particularly his concept of uniformitarianism, profoundly influenced Darwin's thinking on evolution and natural selection. Darwin dedicated 'On the Origin of Species' to Lyell."}, {"found_name": "Geologists", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 956, "target_cluster_name": "geologists", "source_book": "llm_generated", "evidence_snippet": "Charles Lyell was a foundational figure in the field of geology, and his work defined much of the discipline during his lifetime.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Charles Lyell was a foundational figure in the field of geology, and his work defined much of the discipline during his lifetime."}, {"found_name": "Roderick Impey Murchison", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2183, "target_cluster_name": "Murchison", "source_book": "llm_generated", "evidence_snippet": "Roderick Impey Murchison was a prominent geologist and contemporary of Charles Lyell. They were colleagues and sometimes rivals in the geological community, both contributing significantly to the understanding of geological strata and time scales.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Roderick Impey Murchison was a prominent geologist and contemporary of Charles Lyell. They were colleagues and sometimes rivals in the geological community, both contributing significantly to the understanding of geological strata and time scales."}]}, {"canonical_name": "calcareous spar", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "calcareous_spar", "book_id": "kosmos_humboldt_1845", "name": "calcareous spar", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["calcareous spar"], "contexts": ["crystalline form of calcium carbonate", "crystalline body that expands and contracts"]}, {"entity_id": "calcareous_spar", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Calcareous spar", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Calcareous spar", "calcareous spar"], "contexts": ["diamagnetic crystal, a form of calcite", "mineral retaining magnetic character at high temperature"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "calcareous spar", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Calcareous spar", "similarity": 0.949}], "id": 3140, "stable_key": "clu_e5279b5171f6d651", "ground_truth": {"modern_name": "calcite", "confidence": "high", "type": "mineral"}, "cross_references": [{"found_name": "Iceland spar", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1763, "target_cluster_name": "Iceland spar", "source_book": "llm_generated", "evidence_snippet": "Iceland spar is a transparent variety of calcite.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Iceland spar is a transparent variety of calcite.", "is_reverse": true}]}, {"canonical_name": "saline contents", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "saline_contents", "book_id": "kosmos_humboldt_1845", "name": "saline contents", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["saline contents"], "contexts": ["measure of water density", "salt dissolved in water"]}, {"entity_id": "saline_solution", "book_id": "connexion_physical_sciences_somerville_1858", "name": "saline solution", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["saline solution"], "contexts": ["solution used in Wollaston's experiment", "solution with salt and water"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "saline contents", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "saline solution", "similarity": 0.883}], "id": 3141, "stable_key": "clu_1be072ff5399e75e", "ground_truth": {"modern_name": "saline solution", "confidence": "high", "type": "chemical", "wikidata_id": "Q275792", "wikidata_description": "saline water for medical purposes"}, "cross_references": []}, {"canonical_name": "negative electricity", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "negative_electricity", "book_id": "kosmos_humboldt_1845", "name": "negative electricity", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["negative electricity"], "contexts": ["type of electrical charge"]}, {"entity_id": "negative_electricity", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Negative electricity", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Negative electricity", "negative electricity"], "contexts": ["type of electrical charge", "defined, mode of exciting"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "negative electricity", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Negative electricity", "similarity": 0.991}], "id": 3142, "stable_key": "clu_222247566d528e1b", "ground_truth": {"modern_name": "Negative electric charge", "confidence": "high", "type": "concept", "note": "Refers to the type of electrical charge carried by electrons.", "wikipedia_extract": "In economics, negative pricing can occur when demand for a product drops or supply increases to an extent that owners or suppliers are prepared to pay others to accept it, in effect setting the price to a negative number. This can happen because it costs money to transport, store, and dispose of a product even when there is little demand to buy it, or because halting production would be more expensive than selling at a negative price. Negative prices are usual for waste such as garbage and nuclear waste. For example, a nuclear power plant may \"sell\" radioactive waste to a processing facility for a negative price; in other words, the power plant is paying the processing facility to take the unwanted radioactive waste. The phenomenon can also occur in energy prices, including electricity prices, natural gas prices, and oil prices. Natural gas prices in the Permian Basin, West Texas, went below zero for the first time in 2019.", "wikipedia_url": "https://en.wikipedia.org/wiki/Negative_pricing"}, "cross_references": []}, {"canonical_name": "Galle, Dr.", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "galle,_dr_", "book_id": "kosmos_humboldt_1845", "name": "Galle, Dr.", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 2, "variants": ["Galle, Dr."], "contexts": ["scientist mentioned", "medical practitioner"]}, {"entity_id": "dr__galle", "book_id": "kosmos_humboldt_1845", "name": "Dr. Galle", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Dr. Galle"], "contexts": ["discovered new planet"]}, {"entity_id": "dr__galle", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Dr. Galle", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["Dr. Galle"], "contexts": ["astronomer who found Neptune"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Galle, Dr.", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Dr. Galle", "similarity": 0.93}, {"source_book": "kosmos_humboldt_1845", "source_name": "Dr. Galle", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Dr. Galle", "similarity": 0.805}], "id": 3143, "stable_key": "clu_40b53c17cee68741", "ground_truth": {"modern_name": "Johann Galle", "confidence": "high", "type": "person", "birth_year": 1812, "death_year": 1910, "description": "German astronomer who discovered Neptune", "wikidata_id": "Q95219", "wikidata_description": "German historian"}, "cross_references": [{"found_name": "Mr. Adams", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1022, "target_cluster_name": "Mr. Adams", "source_book": "llm_generated", "evidence_snippet": "Galle was the astronomer who, based on Adams's calculations, discovered Neptune.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Galle was the astronomer who, based on Adams's calculations, discovered Neptune.", "is_reverse": true}]}, {"canonical_name": "nebulous stars", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "nebulous_stars", "book_id": "kosmos_humboldt_1845", "name": "nebulous stars", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["nebulous stars"], "contexts": ["stars surrounded by nebulae", "stars appearing like nebulae"]}, {"entity_id": "nebulous_stars", "book_id": "connexion_physical_sciences_somerville_1858", "name": "nebulous stars", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["nebulous stars"], "contexts": ["stars appearing like nebulae", "celestial bodies with a hazy appearance"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "nebulous stars", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "nebulous stars", "similarity": 1.0}], "id": 3144, "stable_key": "clu_c21ee176c963bc6b", "ground_truth": {"modern_name": "Nebulous stars", "confidence": "high", "type": "objec