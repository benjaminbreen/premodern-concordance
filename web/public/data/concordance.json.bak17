k": "coloquios_da_orta_1563", "target_name": "Musa", "similarity": 0.945}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Moses", "target_book": "coloquios_da_orta_1563", "target_name": "Moysés", "similarity": 0.923}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Moses", "target_book": "first_principles_spencer_1862", "target_name": "Moses", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Musa", "target_book": "first_principles_spencer_1862", "target_name": "Moses", "similarity": 0.945}, {"source_book": "coloquios_da_orta_1563", "source_name": "Moysés", "target_book": "first_principles_spencer_1862", "target_name": "Moses", "similarity": 0.923}], "id": 673, "stable_key": "clu_8abb8e9b3fa0aa7d", "ground_truth": {"modern_name": "Moses", "confidence": "high", "type": "person", "description": "Biblical figure, author of scripture, and fig reference.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Moses", "wikipedia_extract": "In Abrahamic religions, Moses was the Hebrew prophet who led the Israelites out of slavery in the Exodus from Egypt. He is considered the most important prophet in Judaism and Samaritanism, and one of the most important prophets in Christianity, Islam, the Baháʼí Faith, and other Abrahamic religions. According to the Abrahamic scriptures, God dictated the Mosaic Law to Moses, which he wrote down and which formed part of the Torah. According to the Book of Exodus, Moses was born in a period when his people, the Israelites, who were an enslaved minority, were increasing in population; consequently, the Egyptian Pharaoh was worried that they might ally themselves with Egypt's enemies. When Pharaoh ordered all newborn Hebrew boys to be killed in order to reduce the population of the Israelites, Moses' Hebrew mother, Jochebed, secretly hid him in the bulrushes along the Nile river. The Pharaoh's daughter discovered the infant there and adopted him as a foundling."}, "cross_references": [{"found_name": "Aaron", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2496, "target_cluster_name": "Aarons", "source_book": "llm_generated", "evidence_snippet": "Aaron was the brother of Moses and a prominent figure in the Exodus narrative.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Aaron was the brother of Moses and a prominent figure in the Exodus narrative."}, {"found_name": "Abraham", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1067, "target_cluster_name": "Ibrahim", "source_book": "llm_generated", "evidence_snippet": "Abraham is a foundational patriarch in Judaism, Christianity, and Islam, and is often discussed in relation to Moses as a key figure in the lineage of prophets.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Abraham is a foundational patriarch in Judaism, Christianity, and Islam, and is often discussed in relation to Moses as a key figure in the lineage of prophets."}, {"found_name": "Adam", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 326, "target_cluster_name": "Adam", "source_book": "llm_generated", "evidence_snippet": "Adam is the first man in Abrahamic religions, and is often discussed in theological contexts alongside other significant prophets like Moses.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Adam is the first man in Abrahamic religions, and is often discussed in theological contexts alongside other significant prophets like Moses."}, {"found_name": "Daniel", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3848, "target_cluster_name": "Daniel", "source_book": "llm_generated", "evidence_snippet": "Daniel is a prophet in the Hebrew Bible and is often discussed in relation to other major prophets like Moses.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Daniel is a prophet in the Hebrew Bible and is often discussed in relation to other major prophets like Moses."}, {"found_name": "Esdras", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4382, "target_cluster_name": "Esdras", "source_book": "llm_generated", "evidence_snippet": "Esdras (Ezra) is a significant figure in Jewish history and scripture, often discussed in conjunction with other Mosaic-era figures and prophets.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Esdras (Ezra) is a significant figure in Jewish history and scripture, often discussed in conjunction with other Mosaic-era figures and prophets."}, {"found_name": "Eve", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2086, "target_cluster_name": "Eve", "source_book": "llm_generated", "evidence_snippet": "Eve, as the first woman in Abrahamic traditions, is often discussed in theological contexts alongside other foundational figures like Moses.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Eve, as the first woman in Abrahamic traditions, is often discussed in theological contexts alongside other foundational figures like Moses."}, {"found_name": "Jesus Christ", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 13, "target_cluster_name": "Christ", "source_book": "llm_generated", "evidence_snippet": "Jesus Christ is a central figure in Christianity, which views Moses as a key prophet and precursor. Discussions of Jesus often involve comparisons or contrasts with Mosaic law and prophecy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Jesus Christ is a central figure in Christianity, which views Moses as a key prophet and precursor. Discussions of Jesus often involve comparisons or contrasts with Mosaic law and prophecy."}, {"found_name": "Profetas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cl