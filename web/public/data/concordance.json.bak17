cinal_monardes_1574", "source_name": "carbon", "target_book": "polyanthea_medicinal", "target_name": "carbonum", "similarity": 0.973}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "carbon", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "carbon", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "carbonum", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "carbon", "similarity": 0.973}], "id": 11, "stable_key": "clu_28fa5d0bf79c5484", "ground_truth": {"modern_name": "Carbon", "confidence": "high", "type": "chemical", "note": "References to 'carbon', 'carboni', and 'carbone' in chemical and scientific contexts indicate the element carbon. 'Carbonate' is a compound derived from it.", "wikidata_id": "Q623", "wikidata_description": "chemical element with symbol C and atomic number 6; common element of all known life", "wikipedia_url": "https://en.wikipedia.org/wiki/Carbon", "wikipedia_extract": "Carbon (from Latin  carbo 'coal') is a chemical element;  it has symbol C and atomic number 6. It is nonmetallic and tetravalent—meaning that its atoms are able to form up to four covalent bonds due to its valence shell exhibiting 4 electrons. It belongs to group 14 of the periodic table. Carbon makes up about 0.025 percent of Earth's crust. Three isotopes occur naturally, 12C and 13C being stable, while 14C is a radionuclide, decaying with a half-life of 5,700 years. Carbon is one of the few elements known since antiquity."}, "cross_references": [{"found_name": "Carbonic acid", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 260, "target_cluster_name": "carbonic acid", "source_book": "llm_generated", "evidence_snippet": "Carbonic acid is a compound of carbon.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Carbonic acid is a compound of carbon."}, {"found_name": "phosphorus", "link_type": "conceptual_overlap", "link_str