, "is_reverse": true}, {"found_name": "Acid", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1608, "target_cluster_name": "acidos", "source_book": "llm_generated", "evidence_snippet": "Alkalies are defined in opposition to and reaction with acids.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Alkalies are defined in opposition to and reaction with acids."}, {"found_name": "Base", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 753, "target_cluster_name": "Fundament", "source_book": "llm_generated", "evidence_snippet": "The historical definition of 'base' in chemistry is closely related to and often used interchangeably with 'alkali'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The historical definition of 'base' in chemistry is closely related to and often used interchangeably with 'alkali'."}, {"found_name": "ammoniaque", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1029, "target_cluster_name": "ammoniaque", "source_book": "llm_generated", "evidence_snippet": "Ammonia is a base, and historically, bases were often grouped under the term 'alkali'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Ammonia is a base, and historically, bases were often grouped under the term 'alkali'.", "is_reverse": true}, {"found_name": "salts", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1114, "target_cluster_name": "salts", "source_book": "llm_generated", "evidence_snippet": "Alkalies are a class of chemical compounds that react with acids to form salts. Historically, the distinction and relationship between acids and alkalis were central to chemical understanding, and their reactions produced salts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Alkalies are a class of chemical compounds that react with acids to form salts. Historically, the distinction and relationship between acids and alkalis were central to chemical understanding, and their reactions produced salts.", "is_reverse": true}, {"found_name": "Soda", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1186, "target_cluster_name": "Soda", "source_book": "llm_generated", "evidence_snippet": "Sodium is a highly reactive alkali metal. Historical texts often discuss 'alkali' as a general category of substances, and sodium compounds (like soda ash) were key examples of alkalis.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Sodium is a highly reactive alkali metal. Historical texts often discuss 'alkali' as a general category of substances, and sodium compounds (like soda ash) were key examples of alkalis.", "is_reverse": true}, {"found_name": "pyrophoric substances", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "kosmos_humboldt_1845", "evidence_snippet": "phases of chemical science, bitumen, pyrites, the moist admixture of finely-pulverized sulphur and iron, pyrophoric substances, and the metals of the alkalies and earths, have in turn been designated ", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "a type of substance considered a cause of volcanic phenomena"}]}, {"canonical_name": "Aphelion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "aphelion", "book_id": "kosmos_humboldt_1845", "name": "aphelion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["aphelion"], "contexts": ["point farthest from the Sun in orbit"]}, {"entity_id": "aphelion", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Aphelion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["Aphelion", "aphelion"], "contexts": ["point farthest from the sun in orbit", "point of farthest approach from sun"]}, {"entity_id": "aphelion", "book_id": "first_principles_spencer_1862", "name": "aphelion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["aphelion"], "contexts": ["point farthest from the sun"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "aphelion", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Aphelion", "similarity": 0.868}, {"source_book": "kosmos_humboldt_1845", "source_name": "aphelion", "target_book": "first_principles_spencer_1862", "target_name": "aphelion", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Aphelion", "target_book": "first_principles_spencer_1862", "target_name": "aphelion", "similarity": 0.868}], "id": 864, "stable_key": "clu_95c85177f5b05502", "ground_truth": {"modern_name": "Aphelion", "confidence": "high", "type": "concept", "wikidata_id": "Q10414642", "wikidata_description": "genus of insects", "wikipedia_extract": "An apsis (from Ancient Greek  ἁψίς (hapsís) 'arch, vault' (third declension); pl. apsides  AP-sih-deez) is the farthest or nearest point in the orbit of a planetary body about its primary body. The line of apsides (also called apse line, or major axis of the orbit) is the line connecting the two extreme values. Apsides pertaining to orbits around different bodies have distinct names to differentiate themselves from other apsides. Apsides pertaining to geocentric orbits, orbits around the Earth, are at the farthest point called the apogee, and at the nearest point the perigee, as with orbits of satellites and the Moon around Earth. Apsides pertaining to orbits around the Sun are named aphelion for the farthest and perihelion for the nearest point in a heliocentric orbit. Earth's two apsides are the farthest point, aphelion, and the nearest point, perihelion, of its orbit around the host Sun."}, "cross_references": [{"found_name": "latitude", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 551, "target_cluster_name": "latitude", "source_book": "llm_generated", "evidence_snippet": "Aphelion is a point in an orbit, and latitude can be used to describe positions relative to orbital planes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Aphelion is a point in an orbit, and latitude can be used to describe positions relative to orbital planes.", "is_reverse": true}, {"found_name": "grego", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 773, "target_cluster_name": "grego", "source_book": "connexion_physical_sciences_somerville_1858", "evidence_snippet": "the ellipse. NOTE 49, p. 9. _Apsides._ The points P and A, fig. 10, at the extremities of the major axis of an orbit. P is commonly called the perihelion, a Greek term signifying _round the sun_; and ", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "reverse: a point on the major axis of an orbit, defined by a Greek term", "is_reverse": true}, {"found_name": "Perihelion", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 700, "target_cluster_name": "Perihelion", "source_book": "llm_generated", "evidence_snippet": "Aphelion is the point in an orbit farthest from the sun, while perihelion is the point closest to the sun. Both are specific points in an elliptical orbit defined by the apsides.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Aphelion is the point in an orbit farthest from the sun, while perihelion is the point closest to the sun. Both are specific points in an elliptical orbit defined by the apsides.", "is_reverse": true}, {"found_name": "Meridian", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 97, "target_cluster_name": "Meridian", "source_book": "llm_generated", "evidence_snippet": "Aphelion is the point in the orbit of a celestial body at which it is furthest from the Sun. Understanding aphelion requires knowledge of orbital paths and positions, often defined relative to celestial meridians.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Aphelion is the point in the orbit of a celestial body at which it is furthest from the Sun. Understanding aphelion requires knowledge of orbital paths and positions, often defined relative to celestial meridians.", "is_reverse": true}, {"found_name": "solar system", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1528, "target_cluster_name": "solar system", "source_book": "llm_generated", "evidence_snippet": "Aphelion is the point in the orbit of a planet or other celestial body at which it is furthest from the Sun. It is directly related to the Sun's gravitational influence on orbiting bodies.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Aphelion is the point in the orbit of a planet or other celestial body at which it is furthest from the Sun. It is directly related to the Sun's gravitational influence on orbiting bodies.", "is_reverse": true}, {"found_name": "astronomy", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 276, "target_cluster_name": "astronomy", "source_book": "llm_generated", "evidence_snippet": "Aphelion is a specific astronomical term referring to the point in an orbit farthest from the sun.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Aphelion is a specific astronomical term referring to the point in an orbit farthest from the sun.", "is_reverse": true}, {"found_name": "direction", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 503, "target_cluster_name": "direction", "source_book": "llm_generated", "evidence_snippet": "Aphelion refers to the point in an orbit farthest from the sun, indicating a specific position and thus a direct