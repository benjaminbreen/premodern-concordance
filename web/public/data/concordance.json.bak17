, "variants": ["physical optics"], "contexts": ["branch of physics studying light"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Physiological optics", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "physical optics", "similarity": 0.945}], "id": 3536, "stable_key": "clu_d25a44b77864f73b", "ground_truth": {"modern_name": "Physiological optics", "confidence": "high", "type": "concept"}, "cross_references": []}, {"canonical_name": "darkness", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "darkness", "book_id": "principles_of_psychology_james_1890", "name": "darkness", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["darkness"], "contexts": ["absence of light"]}, {"entity_id": "darkness", "book_id": "first_principles_spencer_1862", "name": "darkness", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["darkness"], "contexts": ["absence of light"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "darkness", "target_book": "first_principles_spencer_1862", "target_name": "darkness", "similarity": 1.0}], "id": 3537, "stable_key": "clu_7211966a5b504747", "ground_truth": {"modern_name": "Darkness", "confidence": "high", "type": "concept", "wikidata_id": "Q204170", "wikidata_description": "lack of light", "wikipedia_url": "https://en.wikipedia.org/wiki/Darkness", "wikipedia_extract": "Darkness is the condition resulting from a lack of illumination, or an absence of visible light. Human vision is unable to distinguish colors in conditions of very low luminance because the hue-sensitive photoreceptor cells on the retina are inactive when light levels are insufficient, in the range of visual perception referred to as scotopic vision. The emotional response to darkness has led to metaphorical usages of the term in many cultures, often to convey feelings of unhappiness or forebording. \"Darkness\" may also refer to night, which occurs when the Sun is more than 18° below the horizon. The perception of darkness differs from the mere absence of light that sometimes lead to afterimages. In perceiving, the eye is active, and the part of the retina that is unstimulated produces a complementary afterimage."}, "cross_references": [{"found_name": "light", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3819, "target_cluster_name": "light", "source_book": "llm_generated", "evidence_snippet": "Directly opposite concept to light.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Directly opposite concept to light.", "is_reverse": true}]}, {"canonical_name": "twilight", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "twilight", "book_id": "principles_of_psychology_james_1890", "name": "twilight", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["twilight"], "contexts": ["period of dim light before sunrise or after sunset", "low light condition"]}, {"entity_id": "twilight", "book_id": "kosmos_humboldt_1845", "name": "twilight", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["twilight"], "contexts": ["period of light after sunset"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "twilight", "target_book": "kosmos_humboldt_1845", "target_name": "twilight", "similarity": 1.0}], "id": 3538, "stable_key": "clu_9bfee481e4a81d71", "ground_truth": {"modern_name": "Twilight", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "female given name"}, "cross_references": []}, {"canonical_name": "pressure-sensation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "pressure-sensation", "book_id": "principles_of_psychology_james_1890", "name": "pressure-sensation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["pressure-sensation"], "contexts": ["tactile sensation", "sensory modality"]}, {"entity_id": "feelings_of_pressure", "book_id": "first_principles_spencer_1862", "name": "feelings of pressure", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["feelings of pressure"], "contexts": ["subjective experience of pressure"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "pressure-sensation", "target_book": "first_principles_spencer_1862", "target_name": "feelings of pressure", "similarity": 0.921}], "id": 3539, "stable_key": "clu_da4ca189d0c66790", "ground_truth": {"modern_name": "Pressure sensation", "confidence": "high", "type": "concept", "wikidata_id": "Q78010383", "wikidata_description": "scientific article published on 02 March 2002"}, "cross_references": []}, {"canonical_name": "Quantity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "quantity", "book_id": "principles_of_psychology_james_1890", "name": "Quantity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["quantity", "Quantity"], "contexts": ["pertaining to differences in amount", "relation between things"]}, {"entity_id": "quantity", "book_id": "kosmos_humboldt_1845", "name": "quantity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["quantity"], "contexts": ["relation comprising number and size"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Quantity", "target_book": "kosmos_humboldt_1845", "target_name": "quantity", "similarity": 0.942}], "id": 3540, "stable_key": "clu_9dfbe4c3f67733cb", "ground_truth": {"modern_name": "Quantity", "confidence": "high", "type": "concept"}, "cross_references": []}, {"canonical_name": "mixed", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "mixed", "book_id": "principles_of_psychology_james_1890", "name": "mixed", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["MIXED", "mixed"], "contexts": ["type of association", "most parts inert"]}, {"entity_id": "mixed", "book_id": "first_principles_spencer_1862", "name": "mixed", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mixed"], "contexts": ["combining vocal and instrumental music"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "mixed", "target_book": "first_principles_spencer_1862", "target_name": "mixed", "similarity": 1.0}], "id": 3541, "stable_key": "clu_317e5dc8937aeab9", "ground_truth": {"modern_name": "mixed", "confidence": "high", "type": "concept", "note": "The term 'mixed' in these contexts refers to the combination or blending of different elements, whether psychological, musical, or conceptual, rather than a specific technical term.", "wikidata_id": "Q2749", "wikidata_description": "city in Bavaria, Germany", "wikipedia_url": "https://en.wikipedia.org/wiki/Augsburg", "wikipedia_extract": "Augsburg (UK:  OWGZ-burg, also US:  AWGZ-; German: [ˈaʊksbʊʁk] ; Swabian German: Ougschburg) is a city in the Swabia region of Bavaria, Germany, around 50 kilometres (31 mi) west of the state capital, Munich. It is a university town and the regional seat of the Regierungsbezirk Swabia with a well-preserved Altstadt (historical city centre). Augsburg is an urban district and home to the institutions of the Landkreis Augsburg. It is the third-largest city in Bavaria (after Munich and Nuremberg), with a population of 304,000 and 885,000 in its metropolitan area. After Neuss, Trier, Worms, Cologne and Xanten, Augsburg is one of Germany's oldest cities, founded in 15 BC by the Romans as Augusta Vindelicorum and named after the Roman emperor Augustus. It was a Free Imperial City from 1276 to 1803 and the home of the patrician Fugger and Welser families that dominated European banking in the 16th century."}, "cross_references": []}, {"canonical_name": "luminiferous ether", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "luminiferous_ether", "book_id": "principles_of_psychology_james_1890", "name": "luminiferous ether", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["luminiferous ether"], "contexts": ["hypothetical medium for light", "hypothetical medium for light propagation"]}, {"entity_id": "luminiferous_ether", "book_id": "connexion_physical_sciences_somerville_1858", "name": "luminiferous ether", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["luminiferous ether"], "contexts": ["medium for light propagation"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "luminiferous ether", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "luminiferous ether", "similarity": 1.0}], "id": 3542, "stable_key": "clu_c927aee90a825390", "ground_truth": {"modern_name": "Luminiferous Ether", "confidence": "high", "type": "concept", "wikipedia_extract": "The etheric body, ether-body, or æther body is a subtle body propounded in esoteric and occult philosophies as the first or lowest layer in the human energy field or aura. The etheric body is said to be in immediate contact with the physical body and to sustain it and connect it with \"higher\" bodies. It is also said to consist of a finer substance, more pure and composed of smaller particles, than the ordinary matter of the physical plane. (See the book Occult Chemistry by C.W. Leadbeater) The English term \"etheric\" in this context seems to derive from the Theosophical writings of Madame Blavatsky, but its use was formalised by C.W. Leadbeater and Annie Besant due to the elimination of Hindu terminology from the system of seven planes and bodies.", "wikipedia_url": "https://en.wikipedia.org/wiki/Etheric_body"}, "cross_references": []}, {"canonical_name": "iron filings", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "iron_filings", "book_id": "principles_of_psychology_james_1890", "name": "iron filings", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["iron filings"], "contexts": ["small pieces of iron"]}, {"entity_id": "iron_filings", "book_id": "connexion_physical_sciences_somerville_1858", "name": "iron filings", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["iron filings"], "contexts": ["suspended by electric current", "material used to visualize magnetic forces"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "iron filings", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "iron filings", "similarity": 1.0}], "id": 3543, "stable_key": "clu_0d4a992dd4d690e4", "ground_truth": {"modern_name": "iron filings", "confidence": "high", "type": "mineral", "note": "In early modern texts, 'iron filings' refers to small particles of iron, often used in experiments demonstrating magnetism or electrical phenomena.", "wikidata_id": "Q132093", "wikidata_description": "fine iron powder", "wikipedia_url": "https://en.wikipedia.org/wiki/Iron%20filings", "wikipedia_extract": "Iron filings are very small pieces of iron that look like a powder with a dark-grey appearance. As the name suggests, iron filings can be obtained from metal working operations as the scrap material filed off larger iron and steel parts. They are very often used in science demonstrations to show the direction of a magnetic field. Since iron is a ferromagnetic material, a magnetic field induces each particle to become a tiny bar magnet. The south pole of each particle then attracts the north poles of its neighbors, and this process is repeated over a wide area to create chains of filings parallel to the direction of the magnetic field. Iron filings are used in many places, including schools, where they test the reaction of the filings to magnets."}, "cross_references": []}, {"canonical_name": "shot", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "shot-gun", "book_id": "principles_of_psychology_james_1890", "name": "shot-gun", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["shot-gun"], "contexts": ["firearm used in analogy"]}, {"entity_id": "shot", "book_id": "first_principles_spencer_1862", "name": "shot", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["shot"], "contexts": ["projectile from a fowling-piece", "projectile with whizzing sound"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "shot-gun", "target_book": "first_principles_spencer_1862", "target_name": "shot", "similarity": 0.913}], "id": 3544, "stable_key": "clu_8360c3ccb0c8b2dc", "ground_truth": {"modern_name": "shot", "confidence": "high", "type": "object", "note": "In this context, 'shot' refers to ammunition fired from a gun, particularly small projectiles like those used in shotguns."}, "cross_references": [{"found_name": "cannon", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 507, "target_cluster_name": "cannon", "source_book": "llm_generated", "evidence_snippet": "Shot is a projectile fired from a cannon.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Shot is a projectile fired from a cannon.", "is_reverse": true}]}, {"canonical_name": "locomotive", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "locomotive", "book_id": "principles_of_psychology_james_1890", "name": "locomotive", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["locomotive"], "contexts": ["a machine for transport"]}, {"entity_id": "locomotive", "book_id": "first_principles_spencer_1862", "name": "locomotive", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["locomotive"], "contexts": ["steam-powered engine for transport", "machine impelled by force"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "locomotive", "target_book": "first_principles_spencer_1862", "target_name": "locomotive", "similarity": 1.0}], "id": 3545, "stable_key": "clu_8d64efea87266880", "ground_truth": {"modern_name": "locomotive", "confidence": "high", "type": "object", "note": "Refers to early steam-powered engines designed for transportation, particularly on railways.", "wikidata_id": "Q726543", "wikidata_description": "organ system that gives humans the ability to move using their muscular and skeletal systems"}, "cross_references": []}, {"canonical_name": "lines", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "lines", "book_id": "principles_of_psychology_james_1890", "name": "lines", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["lines"], "contexts": ["straight marks connecting points"]}, {"entity_id": "lines", "book_id": "connexion_physical_sciences_somerville_1858", "name": "lines", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["lines"], "contexts": ["paths described by bodies", "straight paths of light"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "lines", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "lines", "similarity": 1.0}], "id": 3546, "stable_key": "clu_244f2de446d4088b", "ground_truth": {"modern_name": "line", "confidence": "high", "type": "concept", "note": "The term 'lines' in early modern texts can refer to geometric lines, paths of motion, or even conceptual relationships. Given the contexts, 'line' as a geometric or conceptual entity is the most fitting.", "wikidata_id": "Q125604313", "wikidata_description": "scientific article published in 2019"}, "cross_references": []}, {"canonical_name": "inspiration", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "inspiration", "book_id": "principles_of_psychology_james_1890", "name": "inspiration", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["inspiration"], "contexts": ["process inhibited by superior laryngeal nerve"]}, {"entity_id": "inspirations", "book_id": "principles_of_psychology_james_1890", "name": "inspirations", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["inspirations"], "contexts": ["part of the breathing cycle"]}, {"entity_id": "inspirations", "book_id": "first_principles_spencer_1862", "name": "inspirations", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["inspirations"], "contexts": ["act of breathing in"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "inspiration", "target_book": "first_principles_spencer_1862", "target_name": "inspirations", "similarity": 0.973}, {"source_book": "principles_of_psychology_james_1890", "source_name": "inspirations", "target_book": "first_principles_spencer_1862", "target_name": "inspirations", "similarity": 1.0}], "id": 3547, "stable_key": "clu_44429182b3e08bbd", "ground_truth": {"modern_name": "inspiration", "confidence": "high", "type": "concept", "note": "Refers to the act of inhaling or the process of breathing in, as described in physiological contexts."}, "cross_references": []}, {"canonical_name": "anatomical connection", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "anatomical_connection", "book