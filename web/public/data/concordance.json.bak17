ry": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["appearance", "Appearance"], "contexts": ["the phenomenal world perceived by senses", "outward look or semblance"]}, {"entity_id": "appearances", "book_id": "first_principles_spencer_1862", "name": "appearances", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["appearances"], "contexts": ["outward or superficial aspect"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "appearances", "target_book": "first_principles_spencer_1862", "target_name": "appearance", "similarity": 0.894}, {"source_book": "principles_of_psychology_james_1890", "source_name": "appearances", "target_book": "first_principles_spencer_1862", "target_name": "appearances", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "appearance", "target_book": "first_principles_spencer_1862", "target_name": "appearance", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "appearance", "target_book": "first_principles_spencer_1862", "target_name": "appearances", "similarity": 0.894}], "id": 2433, "stable_key": "clu_8ed6eacc18235136", "ground_truth": {"modern_name": "appearance", "confidence": "high", "type": "concept", "wikidata_id": "Q57199699", "wikidata_description": "manifestation of a divine or supernatural entity"}, "cross_references": [{"found_name": "Beauty", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3955, "target_cluster_name": "Beauty", "source_book": "llm_generated", "evidence_snippet": "Beauty is a specific aspect of appearance.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Beauty is a specific aspect of appearance."}, {"found_name": "Figure", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3849, "target_cluster_name": "figure", "source_book": "llm_generated", "evidence_snippet": "Figure is a component of appearance, particularly in a visual or geometric sense.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Figure is a component of appearance, particularly in a visual or geometric sense."}, {"found_name": "Image", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2026, "target_cluster_name": "image", "source_book": "llm_generated", "evidence_snippet": "An image is a representation of appearance.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "An image is a representation of appearance."}]}, {"canonical_name": "acidez", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "acidity", "book_id": "principles_of_psychology_james_1890", "name": "acidity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["acidity"], "contexts": ["quality of fruits"]}, {"entity_id": "acidez", "book_id": "polyanthea_medicinal", "name": "acidez", "category": "CONCEPT", "subcategory": "QUALITY", "count": 5, "variants": ["acidez"], "contexts": ["quality", "quality of being acidic"]}, {"entity_id": "acidity", "book_id": "polyanthea_medicinal", "name": "acidity", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["acidity"], "contexts": ["implied by 'acido-falinos'"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "acidity", "target_book": "polyanthea_medicinal", "target_name": "acidez", "similarity": 0.97}, {"source_book": "principles_of_psychology_james_1890", "source_name": "acidity", "target_book": "polyanthea_medicinal", "target_name": "acidity", "similarity": 1.0}], "id": 2434, "stable_key": "clu_3284a3df3a46e13f", "ground_truth": {"wikipedia_extract": "An acid is a molecule or ion capable of either donating a proton (i.e. hydrogen cation, H+), known as a Brønsted–Lowry acid, or forming a covalent bond with an electron pair, known as a Lewis acid. The first category of acids are the proton donors, or Brønsted–Lowry acids. In the special case of aqueous solutions, proton donors form the hydronium ion H3O+ and are known as Arrhenius acids. Brønsted and Lowry generalized the Arrhenius theory to include non-aqueous solvents. A Brønsted–Lowry or Arrhenius acid usually contains a hydrogen atom bonded to a chemical structure that is still energetically favorable after loss of H+. Aqueous Arrhenius acids have characteristic properties that provide a practical description of an acid."}, "cross_references": [{"found_name": "acrimonia", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 621, "target_cluster_name": "acrimonia", "source_book": "llm_generated", "evidence_snippet": "Acidity is a direct translation of acridity in Portuguese.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Acidity is a direct translation of acridity in Portuguese.", "is_reverse": true}, {"found_name": "Azedos", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 1593, "target_cluster_name": "Azedos", "source_book": "llm_generated", "evidence_snippet": "Direct Spanish translation of 'acidity', a core component of sourness.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Direct Spanish translation of 'acidity', a core component of sourness.", "is_reverse": true}, {"found_name": "amargofo", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2478, "target_cluster_name": "amargofo", "source_book": "llm_generated", "evidence_snippet": "While distinct, acidity is a related taste quality that can sometimes be confused with or co-occur with bitterness.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: While distinct, acidity is a related taste quality that can sometimes be confused with or co-occur with bitterness.", "is_reverse": true}]}, {"canonical_name": "Magnetic storms", "