id": 1688, "target_cluster_name": "gengibre", "source_book": "coloquios_da_orta_1563", "evidence_snippet": "porque não vades debalde, diguovos que se chama gengivre acerca de nós, e acerca dos Arábios e Pérsios e Turcos, gim:{ibil, e os Guzarates e Decanins e Bengallas, quando he verde lhe chamam adrac, e s", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "local name for ginger"}, {"found_name": "Indian", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2500, "target_cluster_name": "Indian", "source_book": "llm_generated", "evidence_snippet": "Bengal is a major region within historical India.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Bengal is a major region within historical India.", "is_reverse": true}, {"found_name": "Persia", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 168, "target_cluster_name": "Persia", "source_book": "coloquios_da_orta_1563", "evidence_snippet": "ay muita quantidade em Cam- baya e em Bengala e em outras muitas partes (i), mas a de Çocotora he muito mais louvada, e he mercadoria pêra a Turquia, a Pérsia e Arabía, e pêra toda a Europa; e por iss", "confidence": 0.65, "auto_label": "contested_identity", "found_relationship": "reverse: region where aloe is found, distinct from Socotra", "is_reverse": true}, {"found_name": "gotim", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "ha outros que chamam gotim, e sam redon- dos, e sam os que nós chamamos belericos: e os quebulos que purgam a freima (que os ha em Bisnager e Cambaia e Bengala) chamamse aretca. E asi tendes ahi cinqu", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "alternative name for bellericos"}, {"found_name": "emblecos", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "o mirabolano, dito anpale, posto que he achado em Goa, porque não usam delle em física, não chamam em Goa mais que as três maneiras já ditas, e as de Bengala e Bisnager e Cambaia; e a este que elles c", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "a synonym for anvale, used by the author."}, {"found_name": "Patane", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "delles façam odres. E quanto he aos rinocerotes (a que os índios Do cate ^b chamam gandas), não os ha domésticos nesta terra; e pode ser que os aja bravos em Bengala ou no Patane, e nas terras que tem", "confidence": 0.65, "auto_label": "contested_identity", "found_relationship": "region where rhinoceros may be found"}, {"found_name": "mirabolano", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "o mirabolano, dito anpale, posto que he achado em Goa, porque não usam delle em física, não chamam em Goa mais que as três maneiras já ditas, e as de Bengala e Bisnager e Cambaia; e a este que elles c", "confidence": 0.65, "auto_label": "contested_identity", "found_relationship": "a substance mentioned in the context of Goa and its uses, possibly related to or compared with anpile and emblicos."}]}, {"canonical_name": "Paulus Ægineta", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 52, "members": [{"entity_id": "paulus_ægineta", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Paulus Ægineta", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Paulus Ægineta"], "contexts": ["ancient physician from Ægina"]}, {"entity_id": "paulus_aegineta", "book_id": "english_physician_1652", "name": "Pau