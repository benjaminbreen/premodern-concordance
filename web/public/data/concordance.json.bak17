ty": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Trogus Pompeius", "target_book": "kosmos_humboldt_1845", "target_name": "Trogus, Pompeius", "similarity": 0.944}], "id": 2503, "stable_key": "clu_23bd8a8c92edc0a0", "ground_truth": {"modern_name": "Trogus Pompeius", "confidence": "high", "type": "person", "description": "Roman historian whose work on ancient history was abridged by Justin.", "wikidata_id": "Q316119", "wikidata_description": "Gallo-Roman historian who flourished during the reign of the emperor Augustus", "wikipedia_url": "https://en.wikipedia.org/wiki/Gnaeus%20Pompeius%20Trogus", "wikipedia_extract": "Gnaeus Pompeius Trogus (fl. 1st century BC), also anglicized as Pompey Trogue, was a Gallo-Roman historian from the Celtic Vocontii tribe in Narbonese Gaul who lived during the reign of the emperor Augustus. He was nearly contemporary with Livy. Pompeius Trogus's grandfather served under Pompey in his war against Sertorius. Owing to Pompey's influence, he was able to obtain Roman citizenship and his family adopted their patron's praenomen and nomen Gnaeus Pompeius. Trogus's father served under Julius Caesar as his secretary and interpreter."}, "cross_references": []}, {"canonical_name": "Pythagoreans", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "pythagoreans", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Pythagoreans", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Pythagoreans"], "contexts": ["ancient philosophical school"]}, {"entity_id": "pythagoreans", "book_id": "kosmos_humboldt_1845", "name": "Pythagoreans", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Pythagoreans"], "contexts": ["ancient Greek philosophical school", "studied heavenly bodies and comets"]}, {"entity_id": "pythagorean", "book_id": "kosmos_humboldt_1845", "name": "Pythagorean", "category": "CONCEPT"