: "clu_7b1db0f31484d0a2", "ground_truth": {"modern_name": "Solstice", "confidence": "high", "type": "concept", "wikidata_id": "Q109312907", "wikidata_description": "Spanish hardstyle musician and DJ"}, "cross_references": [{"found_name": "Aphelion", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 864, "target_cluster_name": "Aphelion", "source_book": "llm_generated", "evidence_snippet": "Aphelion is the point in the orbit of a celestial body at which it is furthest from the Sun. Solstices are points in Earth's orbit where the Sun reaches its highest or lowest point in the sky, marking the longest and shortest days of the year. Both relate to specific points in celestial motion and their observable effects.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Aphelion is the point in the orbit of a celestial body at which it is furthest from the Sun. Solstices are points in Earth's orbit where the Sun reaches its highest or lowest point in the sky, marking the longest and shortest days of the year. Both relate to specific points in celestial motion and their observable effects."}, {"found_name": "Ecliptic", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1541, "target_cluster_name": "ecliptic", "source_book": "llm_generated", "evidence_snippet": "The ecliptic is the apparent path of the Sun on the celestial sphere over the course of a year. The solstices are two specific points on the ecliptic, marking the extreme northern and southern declinations of the Sun.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The ecliptic is the apparent path of the Sun on the celestial sphere over the course of a year. The solstices are two specific points on the ecliptic, marking the extreme northern and southern declinations of the Sun."}, {"found_name": "Astronomy", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 276, "target_cluster_name": "astronomy", "source_book": "llm_generated", "evidence_snippet": "Solstices are fundamental astronomical events related to the Earth's axial tilt and its orbit around the Sun, studied within the field of astronomy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Solstices are fundamental astronomical events related to the Earth's axial tilt and its orbit around the Sun, studied within the field of astronomy."}, {"found_name": "Chronology", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2825, "target_cluster_name": "Chronology", "source_book": "llm_generated", "evidence_snippet": "Solstices mark specific points in the annual cycle and are used as markers for chronological systems and calendars.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Solstices mark specific points in the annual cycle and are used as markers for chronological systems and calendars."}, {"found_name": "Latitude", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 551, "target_cluster_name": "latitude", "source_book": "llm_generated", "evidence_snippet": "The latitude of a location on Earth influences the apparent position of the Sun at the solstices and the length of daylight experienced.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The latitude of a location on Earth influences the apparent position of the Sun at the solstices and the length of daylight experienced."}]}, {"canonical_name": "magnetic lines of force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "magnetic_lines", "book_id": "kosmos_humboldt_1845", "name": "magnetic lines", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["magnetic lines"], "contexts": ["lines representing magnetic field"]}, {"entity_id": "magnetic_lines_of_force", "book_id": "connexion_physical_sciences_somerville_1858", "name": 