, {"source_book": "ricettario_fiorentino_1597", "source_name": "Tamarindi", "target_book": "polyanthea_medicinal", "target_name": "Tamarindos", "similarity": 0.917}], "id": 233, "stable_key": "clu_4c8adcce3c8af344", "ground_truth": {"modern_name": "Tamarind", "confidence": "high", "type": "plant", "linnaean": "Tamarindus indica", "family": "Fabaceae", "description": "A tropical tree valued for its edible fruit.", "note": "Refers to the fruit and tree of the Tamarindus indica.", "wikipedia_extract": "Tamarind (Tamarindus indica) is a leguminous tree bearing edible fruit that is indigenous to tropical Africa and naturalized in Asia. The genus Tamarindus is monotypic, meaning that it contains only this species. It belongs to the family Fabaceae. The tamarind tree produces brown, pod-like fruits that contain a sweet, tangy pulp, which is used in cuisines around the world. The pulp is also used in traditional medicine and as a dye. The wood can be used for woodworking, and tamarind seed oil can be extracted from the seeds."}, "cross_references": [{"found_name": "Fabaceae", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2184, "target_cluster_name": "Leguminosa", "source_book": "llm_generated", "evidence_snippet": "Tamarind belongs to the family Fabaceae.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Tamarind belongs to the family Fabaceae."}, {"found_name": "Legumes", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1901, "target_cluster_name": "legumes", "source_book": "llm_generated", "evidence_snippet": "Tamarind is a leguminous tree and its fruit is a legume.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Tamarind is a leguminous tree and its fruit is a legume."}, {"found_name": "Fruit trees", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4032, "target_cluster_name": "Fruit-trees", "source_book": "llm_generated", "evidence_