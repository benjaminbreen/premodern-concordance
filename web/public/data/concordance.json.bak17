["French for compass"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "compass", "target_book": "principles_of_psychology_james_1890", "target_name": "compass-points", "similarity": 0.886}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "compass", "target_book": "kosmos_humboldt_1845", "target_name": "compass", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "compass", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Compass", "similarity": 0.992}, {"source_book": "principles_of_psychology_james_1890", "source_name": "compass-points", "target_book": "kosmos_humboldt_1845", "target_name": "compass", "similarity": 0.886}, {"source_book": "principles_of_psychology_james_1890", "source_name": "compass-points", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Compass", "similarity": 0.885}, {"source_book": "kosmos_humboldt_1845", "source_name": "compass", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Compass", "similarity": 0.992}], "id": 428, "stable_key": "clu_c99e69fe406c85ac", "ground_truth": {"modern_name": "compass", "confidence": "high", "type": "object", "wikidata_id": "Q2476036", "wikidata_description": "American independent record label based in Nashville, Tennessee", "wikipedia_url": "https://en.wikipedia.org/wiki/Compass%20Records", "wikipedia_extract": "A compass is a device that shows the cardinal directions used for navigation and geographic orientation. It typically consists of a magnetized needle or another element, such as a compass card or compass rose, that pivots to align itself with magnetic north. Other methods may be used, including gyroscopes, magnetometers, and GPS receivers. Compasses often show angles in degrees: north corresponds to 0°, and the angles increase clockwise, so east is 90°, south is 180°, and west is 270°. These numbers allow the compass to show azimuths or bearings which are commonly stated in degrees. If local variation between magnetic north and true north is known, then direction of magnetic north also gives direction of true north.", "note": "The term 'boussole' is the French word for compass."}, "member_count": 6, "cross_references": [{"found_name": "Mariner's compass", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 3157, "target_cluster_name": "Mariner’s compass", "source_book": "llm_generated", "evidence_snippet": "A specific type of compass used by mariners, but fundamentally the same object.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "A specific type of compass used by mariners, but fundamentally the same object."}, {"found_name": "magnet", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 628, "target_cluster_name": "magnet", "source_book": "llm_generated", "evidence_snippet": "Magnets are essential components of many types of compasses.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Magnets are essential components of many types of compasses."}, {"found_name": "magnetic needle", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 740, "target_cluster_name": "magnetic needle", "source_book": "llm_generated", "evidence_snippet": "The primary component of a magnetic compass that aligns with the Earth's magnetic field.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The primary component of a magnetic compass that aligns with the Earth's magnetic field."}, {"found_name": "Needle", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 732, "target_cluster_name": "Needle", "source_book": "llm_generated", "evidence_snippet": "A needle, specifically a magnetized one, is the core element of a magnetic compass.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "A needle, specifically a magnetized one