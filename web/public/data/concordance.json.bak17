es": [{"source_book": "coloquios_da_orta_1563", "source_name": "costo", "target_book": "ricettario_fiorentino_1597", "target_name": "COSTO", "similarity": 0.683}, {"source_book": "coloquios_da_orta_1563", "source_name": "costo", "target_book": "polyanthea_medicinal", "target_name": "costo", "similarity": 1.0}, {"source_book": "ricettario_fiorentino_1597", "source_name": "COSTO", "target_book": "polyanthea_medicinal", "target_name": "costo", "similarity": 0.683}], "id": 729, "stable_key": "clu_b06349b300f365f6", "ground_truth": {"modern_name": "Costmary", "confidence": "medium", "type": "plant", "linnaean": "Tanacetum balsamita", "family": "Asteraceae", "description": "Aromatic herb, sometimes used medicinally.", "note": "The term 'costo' in early modern texts often referred to Costmary (Tanacetum balsamita), also known as 'alecost'.", "wikipedia_extract": "Tanacetum balsamita is a perennial temperate herb known as costmary, alecost, balsam herb, bible leaf, or mint geranium. A fragrant plant native to southern Europe and western Asia, it has been used over centuries for culinary, aromatic, and traditional medicine purposes. Costmary is a perennial with oval serrated leaves and can grow up to 2 m (6.6 ft) high. During summer, it shows small, yellow, button-shaped blossoms which appear in clusters. The English name 'costmary' stems from 'costus of Saint Mary'. Also, in other languages, it is associated with the Virgin Mary, most probably because it was thought to be a treatment for women's diseases in folk medicine."}, "cross_references": []}, {"canonical_name": "northern hemisphere", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 20, "members": [{"entity_id": "southern_hemisphere", "book_id": "origin_of_species_darwin_1859", "name": "southern hemisphere", "category": "PLACE", "subcategory": "REGION", "count": 5, "variants": ["southern hemisphere"], "contexts": ["geographic region", "geographical region"]}, {"entity_id": "southern_hemisphere", "book_id": "kosmos_humboldt_1845", "name": "southern hemisphere", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["southern hemisphere"], "contexts": ["hemisphere with magnetic phenomena", "geographic region"]}, {"entity_id": "northern_hemisphere", "book_id": "connexion_physical_sciences_somerville_1858", "name": "northern hemisphere", "category": "PLACE", "subcategory": "REGION", "count": 9, "variants": ["northern hemisphere"], "contexts": ["half of celestial sphere north of ecliptic", "half of the Earth north of the equator"]}, {"entity_id": "northern_hemisphere", "book_id": "origin_of_species_darwin_1859", "name": "northern hemisphere", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["northern hemisphere"], "contexts": ["hemisphere north of the equator"]}, {"entity_id": "northern_hemisphere", "book_id": "kosmos_humboldt_1845", "name": "northern hemisphere", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["northern hemisphere"], "contexts": ["part of Earth's surface"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "southern hemisphere", "target_book": "kosmos_humboldt_1845", "target_name": "southern hemisphere", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "southern hemisphere", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "northern hemisphere", "similarity": 0.938}, {"source_book": "kosmos_humboldt_1845", "source_name": "southern hemisphere", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "northern hemisphere", "similarity": 0.938}, {"source_book": "origin_of_species_darwin_1859", "source_name": "northern hemisphere", "target_book": "kosmos_humboldt_1845", "target_name": "northern hemisphere", "similarity": 1.0}], "id": 730, "stable_key": "clu_38eaf44e493961a0", "ground_truth": {"modern_name": "Northern Hemisphere", "confidence": "high", "type": "