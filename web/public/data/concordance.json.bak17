646", "name": "Æolian", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Æolian"], "contexts": ["related to wind or air"]}, {"entity_id": "æolian", "book_id": "first_principles_spencer_1862", "name": "Æolian", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Æolian"], "contexts": ["musical mode answering to keys"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Æolian", "target_book": "first_principles_spencer_1862", "target_name": "Æolian", "similarity": 1.0}], "id": 3839, "stable_key": "clu_6a5c4f1f21e81ae7", "ground_truth": {"modern_name": "Aeolian", "confidence": "high", "type": "concept", "wikidata_id": "Q215839", "wikidata_description": "processes due to wind activity", "wikipedia_url": "https://en.wikipedia.org/wiki/Aeolian_processes", "wikipedia_extract": "Aeolian sound or Aeolian tone is sound that is produced by wind when it passes over or through objects. Historically, Aeolus was the Greek ruler of the winds, and the Ancient Greeks believed these sounds were the voice of Aeolus. The earliest known observations about Aeolian sounds from a \"scientific\" viewpoint were made by Athanasius Kircher in 1650. An Aeolian tone is produced when air passes over an obstacle, resulting in trailing vortices with oscillatory behavior. These eddies can have strong periodic components, resulting in a steady tone. This phenomenon is the main topic of aeroacoustics."}, "cross_references": []}, {"canonical_name": "Opalls", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "opalls", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Opalls", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Opalls"], "contexts": ["mineral with attractive quality"]}, {"entity_id": "opal", "book_id": "kosmos_humboldt_1845", "name": "opal", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, 