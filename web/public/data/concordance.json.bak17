e_book": "llm_generated", "evidence_snippet": "Marble is a crystalline rock.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Marble is a crystalline rock.", "is_reverse": true}, {"found_name": "Tourmaline", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1699, "target_cluster_name": "Tourmaline", "source_book": "llm_generated", "evidence_snippet": "Tourmaline is a crystalline silicate mineral, and crystalline rocks are composed of such minerals.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Tourmaline is a crystalline silicate mineral, and crystalline rocks are composed of such minerals.", "is_reverse": true}]}, {"canonical_name": "Sat.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "sat_", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Sat.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Sat."], "contexts": ["satellite"]}, {"entity_id": "sat_", "book_id": "kosmos_humboldt_1845", "name": "Sat.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Sat."], "contexts": ["Macrobius's work"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Sat.", "target_book": "kosmos_humboldt_1845", "target_name": "Sat.", "similarity": 1.0}], "id": 3031, "stable_key": "clu_8fa433b86336bc3f", "ground_truth": {"modern_name": "Satellite", "confidence": "high", "type": "concept", "note": "The context 'Macrobius's work' suggests a celestial body, likely a satellite.", "wikidata_id": "Q2537", "wikidata_description": "celestial body that orbits a planet or other smaller body in turn directly orbiting a star"}, "cross_references": [{"found_name": "Celestial body", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3227, "target_cluster_name": "celestial body", "source_book": "llm_generated", "evidence_snippet": "A satellite is a type of celestial body that orbits another larger celestial body.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "A satellite is a type of celestial body that orbits another larger celestial body."}]}, {"canonical_name": "Saratow", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "saratow", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Saratow", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Saratow"], "contexts": ["city for observation", "city in Russia"]}, {"entity_id": "saratow", "book_id": "kosmos_humboldt_1845", "name": "Saratow", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Saratow"], "contexts": ["city in Eastern Russia"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Saratow", "target_book": "kosmos_humboldt_1845", "target_name": "Saratow", "similarity": 1.0}], "id": 3032, "stable_key": "clu_5206bf02277f1687", "ground_truth": {"modern_name": "Saratov", "confidence": "high", "type": "place", "country": "Russia", "wikidata_id": "Q5332", "wikidata_description": "city in Saratov Oblast, Russia", "wikipedia_extract": "Saratov (UK:  sə-RAH-tof, US:  -⁠təf; Russian: Саратов, pronounced [sɐˈratəf] ) is the largest city and administrative center of Saratov Oblast, Russia, and a major port on the Volga River. As of the 2021 Census, Saratov had a population of 901,361, making it the 17th-largest city in Russia by population. Saratov is 389 kilometres (242 mi) north of Volgograd, 442 kilometres (275 mi) south of Samara, and 858 kilometres (533 mi) southeast of Moscow. The city stands near the site of Uvek, a city of the Golden Horde. Tsar Feodor I of Russia likely developed Saratov as a fortress to secure Russia's southeastern border. Saratov developed as a shipping port along the Volga and was historically important to the Volga Germans, who settled in large numbers in the city before they were expelled before and during World War II."}, "cross_references": []}, {"canonical_name": "Memorias", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "memorias", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Memorias", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Memorias", "Memorias de los Navcgantes"], "contexts": ["book with astronomical data", "title of a work"]}, {"entity_id": "memorias", "book_id": "coloquios_da_orta_1563", "name": "Memorias", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Memorias"], "contexts": ["memoirs written by Báber", "writings by Báber"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Memorias", "target_book": "coloquios_da_orta_1563", "target_name": "Memorias", "similarity": 1.0}], "id": 3033, "stable_key": "clu_aad6984540b53d7b", "ground_truth": {"modern_name": "Memoirs", "confidence": "high", "type": "text", "note": "This refers to written accounts or records, fitting the context of 'book with astronomical data' and 'memoirs written by Báber'.", "wikidata_id": "Q2963729", "wikidata_description": "book on China compiled by Athanasius Kircher from various Jesuit reports"}, "cross_references": [{"found_name": "Tom. III", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 661, "target_cluster_name": "Tom. III", "source_book": "llm_generated", "evidence_snippet": "Memoirs are a type of written work that could be published as a volume.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Memoirs are a type of written work that could be published as a volume.", "is_reverse": true}]}, {"canonical_name": "la Cyrénaïque", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "la_cyrénaïque", "book_id": "relation_historique_humboldt_vol3_1825", "name": "la Cyrénaïque", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["la Cyrénaïque", "Cyrénaïque"], "contexts": ["region in North Africa", "ancient region in North Africa"]}, {"entity_id": "cyrenaica", "book_id": "coloquios_da_orta_1563", "name": "Cyrenaica", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Cyrenaica"], "contexts": ["peninsula in North Africa", "ancient region in North Africa"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "la Cyrénaïque", "target_book": "coloquios_da_orta_1563", "target_name": "Cyrenaica", "similarity": 0.94}], "id": 3034, "stable_key": "clu_d22880d3df0241c6", "ground_truth": {"modern_name": "Cyrenaica", "confidence": "high", "type": "place", "country": "Libya", "wikidata_id": "Q165198", "wikidata_description": "eastern coastal region of Libya", "wikipedia_extract": "Cyrenaica ( SY-rə-NAY-ik-ə-,-SIRR-ə) or Kyrenaika (Arabic: برقة, romanized: Barqah, Koine Greek: Κυρηναϊκή [ἐπαρχία], romanized: Kūrēnaïkḗ [eparkhíā], after the city of Cyrene), is the eastern region of Libya. Cyrenaica includes all of the eastern part of Libya between the 16th and 25th meridians east, including the Kufra District. The coastal region, also known as Pentapolis (\"Five Cities\") in antiquity, was part of the Roman province of Crete and Cyrenaica, later divided into Libya Pentapolis and Libya Sicca. During the Islamic period, the area came to be known as Barqa, after the city of Barca. Cyrenaica became an Italian colony in 1911. After the 1934 formation of Italian Libya, the Cyrenaica province was designated as one of the three primary provinces of the country.", "wikipedia_url": "https://en.wikipedia.org/wiki/Cyrenaica"}, "cross_references": [{"found_name": "Egypto", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 232, "target_cluster_name": "Egypto", "source_book": "llm_generated", "evidence_snippet": "Cyrenaica is a region in eastern Libya, historically linked to Egypt through ancient empires and trade routes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Cyrenaica is a region in eastern Libya, historically linked to Egypt through ancient empires and trade routes.", "is_reverse": true}]}, {"canonical_name": "Bali", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "bali", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bali", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Bali", "Baliamas"], "contexts": ["island in Indonesia", "islands mentioned in relation to Gulf-stream"]}, {"entity_id": "bali", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Bali", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Bali"], "contexts": ["island where catastrophe occurred in 1808", "location of volcanic eruption"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bali", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bali", "similarity": 1.0}], "id": 3035, "stable_key": "clu_8cef345e6dbe00ff", "ground_truth": {"modern_name": "Bali", "confidence": "high", "type": "place", "country": "Indonesia"}, "cross_references": []}, {"canonical_name": "Krusenstern", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "krusenstern", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Krusenstern", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Krusenstern", "Krusensiern"], "contexts": ["leader of a voyage", "scholar cited for hydrographic memoirs"]}, {"entity_id": "krusenstern", "book_id": "kosmos_humboldt_1845", "name": "Krusenstern", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Krusenstern"], "contexts": ["saw fire-ball train shine for an hour", "cited for geographical data"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Krusenstern", "target_book": "kosmos_humboldt_1845", "target_name": "Krusenstern", "similarity": 1.0}], "id": 3036, "stable_key": "clu_40410ec9c64793d6", "ground_truth": {"modern_name": "Adam Johann von Krusenstern", "confidence": "high", "type": "person", "birth_year": 1770, "death_year": 1846, "description": "Estonian-Russian navigator and admiral who led the first Russian circumnavigation.", "wikidata_id": "Q160888", "wikidata_description": "Baltic German admiral and explorer in Russian service, who led the first Russian circumnavigation of the globe (1770–1846)"}, "cross_references": []}, {"canonical_name": "ananas", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "ananas", "book_id": "relation_historique_humboldt_vol3_1825", "name": "ananas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["ananas", "Ananas communs"], "contexts": ["food plants", "common pineapple plant"]}, {"entity_id": "anana", "book_id": "coloquios_da_orta_1563", "name": "anana", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["anana", "ananaz"], "contexts": ["king of fruits", "pineapple"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "ananas", "target_book": "coloquios_da_orta_1563", "target_name": "anana", "similarity": 0.889}], "id": 3037, "stable_key": "clu_415e5885f71628a9", "ground_truth": {"modern_name": "Pineapple", "confidence": "high", "type": "plant", "linnaean": "Ananas comosus", "family": "Bromeliaceae", "wikidata_id": "Q1493", "wikidata_description": "tile bearing bromeliad", "wikipedia_url": "https://en.wikipedia.org/wiki/Pineapple", "wikipedia_extract": "The pineapple (Ananas comosus) is a tropical plant with an edible fruit; it is the most economically significant plant in the family Bromeliaceae. The pineapple is indigenous to South America, where it has been cultivated for many centuries. The introduction of the pineapple plant to Europe in the 17th century made it a significant cultural icon of luxury. Since the 1820s, pineapple has been commercially grown in greenhouses and many tropical plantations. The fruit, particularly its juice, has diverse uses in cuisines and desserts. Pineapples grow as a small shrub; the individual flowers of the unpollinated plant fuse to form a multiple fruit."}, "cross_references": []}, {"canonical_name": "Hatuey", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "hatuey", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Hatuey", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Hatuey", "Hatney"], "contexts": ["Cacique against whom war was waged", "cacique who fled from Haiti"]}, {"entity_id": "hatty", "book_id": "coloquios_da_orta_1563", "name": "Hatty", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Hatty"], "contexts": ["author of Traité de mineralogie", "cited author on mineralogy"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Hatuey", "target_book": "coloquios_da_orta_1563", "target_name": "Hatty", "similarity": 0.884}], "id": 3038, "stable_key": "clu_d5371aa06e17d48f", "ground_truth": {"modern_name": "Hatuey", "confidence": "high", "type": "person", "death_year": 1512, "description": "Taíno cacique, led rebellion against Spanish conquistadors", "note": "The 'author of Traité de mineralogie' is likely a misattribution or an error in the source text's contextualization of Hatuey.", "wikidata_id": "Q540324", "wikidata_description": "hispaniolan Cacique (died 1512)", "wikipedia_url": "https://en.wikipedia.org/wiki/Hatuey", "wikipedia_extract": "Hatuey (), also Hatüey (; died February 2, 1512), was a Taíno Cacique (chief) of the Hispaniolan cacicazgo of Guanaba (in present-day La Gonave, Haiti). He lived from the late 15th until the early 16th century. Chief Hatuey and many of his tribesmen travelled from present-day La Gonave by canoe to Cuba to warn the Taíno in Cuba about the Spaniards that were arriving to conquer the island. He later attained legendary status for leading a group of natives in a fight against the invasion of the Spaniards, thus becoming one of the first fighters against Spanish colonialism in the New World. He is celebrated as \"Cuba's first national hero\". In 1511, Diego Velázquez set out from Hispaniola to conquer what is now known as present-day La Gonave, Haiti and Dominican Republic to subjugate the indigenous people, the Taíno,  who had previously been recorded by Christopher Columbus."}, "cross_references": []}, {"canonical_name": "cigarros", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "cigarros", "book_id": "relation_historique_humboldt_vol3_1825", "name": "cigarros", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["cigarros", "cigares"], "contexts": ["rolled tobacco product", "tobacco product"]}, {"entity_id": "cigarette", "book_id": "principles_of_psychology_james_1890", "name": "cigarette", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["cigarette"], "contexts": ["tobacco product", "object that produces smoke"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "cigarros", "target_book": "principles_of_psychology_james_1890", "target_name": "cigarette", "similarity": 0.918}], "id": 3039, "stable_key": "clu_321fef9805c4e71d", "ground_truth": {"modern_name": "cigar", "confidence": "high", "type": "object", "note": "The term 'cigarette' is also present in the cluster, but 'cigarros' is the primary term and directly translates to 'cigars'.", "wikidata_id": "Q1346603", "wikidata_description": "genus of insects", "wikipedia_url": "https://en.wikipedia.org/wiki/Cigaritis", "wikipedia_extract": "Cigaritis is a genus of butterflies in the family Lycaenidae. Its species are found in the Afrotropical realm, the Indomalayan realm and adjacent regions of Asia. Cigaritis includes species that used to be placed in two other genera: Apharitis Riley, 1925 and Spindasis Wallengren, 1857. The latter were synonymised with Cigaritis by Heath et al., 2002, and this synonymy is followed in recent works. Cigaritis arooni (Murayama & Kimura, 1990) northern Thailand Cigaritis baghirmii (Stempffer, 1946) Cigaritis bergeri (Bouyer, 2003) DRC, Katanga, Sandoa Cigaritis buchanani (Rothschild, 1921) Cigaritis ducarmei (Bouyer, 2008) Congo Cigaritis dufranei (Bouyer, 1991) Zaïre Cigaritis elima (Moore, 1877) India and Sri Lanka Cigaritis elwesi Evans, [1925] northwestern India Cigaritis epargyros (Eversmann, 1854) Arabia, Afghanistan and northern China Cigaritis evansii (Tytler, 1915) India ( Assam) Cigaritis greeni (Heron, 1896) Sri Lanka Cigaritis ictis (Hewitson, 1865) Sri Lanka and India Cigaritis junodi (D'Abrera, 1980) South Africa Cigaritis kutu (Corbet, 1940) Malaysia Cigaritis kuyaniana (Matsumura, 1919) Taiwan Cigaritis larseni (Bouyer, 2012) Cameroon to Ghana Cigaritis learmondi (Tytler, 1940) Myanmar and Thailand Cigaritis leechi (Swinhoe, 1912) China Cigaritis lilacinus (Moore, 1884) Myanmar Cigaritis lohita (Horsfield, [1829]) Cigaritis lunulifera (Moore, 1879) India Cigaritis lutosus (Plötz, 1880) Ghana Cigaritis maximus (Elwes, [1893]) Myanmar, Thailand and Laos Cigaritis meghamalaiensis Sadasivan & Naicker, 2023 Southern India (Western Ghats) [= Cigaritis conjuncta Kunte & Sengupta, 2024, See Sadasivan & Sengupta, 2024]."}, "cross_references": [{"found_name": "Pipe", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1142, "target_cluster_name": "Pipe", "source_book": "llm_generated", "evidence_snippet": "The entity 'Pipe' refers to the plant genus Piper, which includes species used to produce pepper. The candidate 'cigar' is a smoking implement, and historically, pipes were also used for smoking tobacco. While not directly related to the plant itself, the term 'pipe' in common parlance often refers to a smoking device, creating a potential semantic link through common usage and historical context of smoking implements.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The entity 'Pipe' refers to the plant genus Piper, which includes species used to produce pepper. The candidate 'cigar' is a smoking implement, and historically, pipes were also used for smoking tobacco. While not directly related to the plant itself, the term 'pipe' in common parlance often refers to a smoking device, creating a potential semantic link through common usage and historical context of smoking implements.", "is_reverse": true}]}, {"canonical_name": "palmeta", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "palmeta", "book_id": "relation_historique_humboldt_vol3_1825", "name": "palmeta", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["palmeta", "palmito"], "contexts": ["palm groves mentioned by historians", "cylinders carried by Zambos"]}, {"entity_id": "palmeta", "book_id": "kosmos_humboldt_1845", "name": "palmeta", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["palmeta"], "contexts": ["term for palm trees", "plant associated with pineta"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "palmeta", "target_book": "kosmos_humboldt_1845", "target_name": "palmeta", "similarity": 1.0}], "id": 3040, "stable_key": "clu_7679966165e61e64", "ground_truth": {"modern_name": "Palm tree", "confidence": "medium", "type": "plant", "family": "Arecaceae", "note": "'Palmeta' can refer to a palm grove or 