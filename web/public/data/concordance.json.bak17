rs": [{"entity_id": "bananes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "bananes", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 12, "variants": ["bananes"], "contexts": ["foodstuff", "fruit grown in the country"]}, {"entity_id": "banana", "book_id": "kosmos_humboldt_1845", "name": "banana", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["banana"], "contexts": ["plant family in tropical regions", "plant requiring hot climate"]}, {"entity_id": "banana", "book_id": "connexion_physical_sciences_somerville_1858", "name": "banana", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["banana"], "contexts": ["tropical fruit-bearing plant"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "bananes", "target_book": "kosmos_humboldt_1845", "target_name": "banana", "similarity": 0.921}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "bananes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "banana", "similarity": 0.921}, {"source_book": "kosmos_humboldt_1845", "source_name": "banana", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "banana", "similarity": 1.0}], "id": 792, "stable_key": "clu_4e2f73833f0dabb7", "ground_truth": {"modern_name": "Bananas", "confidence": "low", "type": "plant", "description": "Tropical fruit-bearing plants.", "note": "The mention of 'beans' in the Darwin context seems an outlier and likely a misattribution or a secondary example. The dominant context is 'bananes'.", "wikipedia_extract": "A banana is an elongated, edible fruit—botanically a berry—produced by several kinds of large treelike herbaceous flowering plants in the genus Musa. In some countries, cooking bananas are called plantains, distinguishing them from dessert bananas. The fruit is variable in size, color and firmness, but is usually elongated and curved, with soft flesh rich in starch covered with a peel, which may have a variety of colors when ripe. It grows upward in clusters near the top of the plant. Almost all modern edible seedless (parthenocarp) cultivated bananas come from two wild species – Musa acuminata and Musa balbisiana, or their hybrids. Musa species are native to tropical Indomalaya and Australia; they were probably domesticated in New Guinea."}, "cross_references": []}, {"canonical_name": "vaches", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "vaches", "book_id": "relation_historique_humboldt_vol3_1825", "name": "vaches", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 7, "variants": ["vaches", "vache", "vaches à bosse"], "contexts": ["female cattle", "livestock import"]}, {"entity_id": "vacas", "book_id": "historia_medicinal_monardes_1574", "name": "vacas", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["vacas"], "contexts": ["cows that die in the lowlands"]}, {"entity_id": "vacas", "book_id": "coloquios_da_orta_1563", "name": "vacas", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 7, "variants": ["vacas", "vaca", "vacca"], "contexts": ["comparison for elephant population", "comparison for elephant numbers"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "vaches", "target_book": "historia_medicinal_monardes_1574", "target_name": "vacas", "similarity": 0.935}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "vacas", "target_book": "coloquios_da_orta_1563", "target_name": "vacas", "similarity": 0.895}], "id": 793, "stable_key": "clu_678cd1a6bfb7b299", "ground_truth": {"modern_name": "Cow", "confidence": "high", "type": "animal", "linnaean": "Bos taurus", "family": "Bovidae", "description": "Domesticated bovine animal, raised for milk, meat, and labor.", "wikipedia_extract": "Cattle (Bos taurus) are large, domesticated, bovid ungulates widely kept as livestock. They are prominent modern members of the subfamily Bovinae and the most widespread species of the genus Bos. Mature female cattle are called cows and mature males are called bulls. Taurine cattle are widely distributed across Europe and temperate areas of Asia, the Americas, and Australia. Zebus are found mainly in India and tropical areas of Asia, America, and Australia. Sanga cattle are found primarily in sub-Saharan Africa."}, "cross_references": [{"found_name": "Cattle", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 101, "target_cluster_name": "cattle", "source_book": "llm_generated", "evidence_snippet": "The term 'Cattle' is a direct synonym for 'Cow' when referring to the species as a whole, especially in a livestock context.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "The term 'Cattle' is a direct synonym for 'Cow' when referring to the species as a whole, especially in a livestock context."}, {"found_name": "ox", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1343, "target_cluster_name": "ox", "source_book": "llm_generated", "evidence_snippet": "An ox is a castrated male bovine, often used for draft work, and is closely related to cows within the same species.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "An ox is a castrated male bovine, often used for draft work, and is closely related to cows within the same species."}, {"found_name": "insects", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 4, "target_cluster_name": "insects", "source_book": "llm_generated", "evidence_snippet": "French for 'cows', mammals, not insects. This is an error in the candidate list.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "reverse: French for 'cows', mammals, not insects. This is an error in the candidate list.", "is_reverse": true}, {"found_name": "calf", "link_type": "conceptual_overlap", "l