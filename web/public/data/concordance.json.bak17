ta_description": "chemical element with symbol Sb and atomic number of 51", "wikipedia_extract": "Antimony potassium tartrate, also known as potassium antimonyl tartrate, potassium antimontarterate, or tartar emetic, has the formula K2Sb2(C4H2O6)2. The compound has long been known as a powerful emetic, and was used in the treatment of schistosomiasis and leishmaniasis. It is used as a resolving agent. It typically is obtained as a hydrate. The first treatment application against trypanosomiasis was tested in 1906, and the compound's use to treat other tropical diseases was researched. The treatment of leishmania with antimony potassium tartrate started in 1913.", "wikipedia_url": "https://en.wikipedia.org/wiki/Antimony", "note": "This likely refers to a distilled preparation containing antimony compounds."}, "member_count": 10, "cross_references": [{"found_name": "Terra santa", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2176, "target_cluster_name": "Terra santa", "source_book": "llm_generated", "evidence_snippet": "Direct translation/cognate of Antimony.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: Direct translation/cognate of Antimony.", "is_reverse": true}, {"found_name": "Crocus metallorum", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 669, "target_cluster_name": "Crocus metallorum", "source_book": "llm_generated", "evidence_snippet": "Crocus metallorum is a historical name for antimony sulfide, a compound of antimony, and thus closely related to the element antimony itself.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Crocus metallorum is a historical name for antimony sulfide, a compound of antimony, and thus closely related to the element antimony itself."}, {"found_name": "metal", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 87, "target_cluster_name": "metal", "source_book": "llm_generated", "eviden