s_somerville_1858", "name": "lamp", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["lamp"], "contexts": ["used to raise the temperature of surfaces", "source of heat"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "tallow-candle", "target_book": "historia_medicinal_monardes_1574", "target_name": "candil", "similarity": 0.903}, {"source_book": "principles_of_psychology_james_1890", "source_name": "tallow-candle", "target_book": "coloquios_da_orta_1563", "target_name": "candil", "similarity": 0.903}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "candil", "target_book": "coloquios_da_orta_1563", "target_name": "candil", "similarity": 1.0}], "id": 1275, "stable_key": "clu_bf939dd8bfa712c6", "ground_truth": {"modern_name": "lamp", "confidence": "medium", "type": "object", "note": "The term 'candil' can refer to a candle or a lamp. Given the context of 'heating' and 'unit of weight', 'lamp' is a more encompassing modern referent. However, 'tallow-candle' suggests a more specific interpretation related to candles.", "wikidata_id": "Q2110", "wikidata_description": "province of Indonesia, on the island of Sumatra"}, "member_count": 5, "cross_references": [{"found_name": "candle", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3089, "target_cluster_name": "candle", "source_book": "llm_generated", "evidence_snippet": "A lamp is a device that produces light, often by burning a fuel like oil or wax, similar to a candle.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "A lamp is a device that produces light, often by burning a fuel like oil or wax, similar to a candle."}]}, {"canonical_name": "Mr. Joule", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "mr__c_", "book_id": "principles_of_psychology_james_1890", "name": "Mr. C.", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Mr. C."], "contexts": ["performed experiments on association times"]}, {"entity_id": "mr__joule", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Mr. Joule", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Mr. Joule"], "contexts": ["scientist who proved mechanical equivalent of heat", "agrees with observed phenomena of heat"]}, {"entity_id": "mr__joule", "book_id": "first_principles_spencer_1862", "name": "Mr. Joule", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Mr. Joule"], "contexts": ["scientist who measured heat and work"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Mr. C.", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mr. Joule", "similarity": 0.863}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Mr. C.", "target_book": "first_principles_spencer_1862", "target_name": "Mr. Joule", "similarity": 0.863}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Mr. Joule", "target_book": "first_principles_spencer_1862", "target_name": "Mr. Joule", "similarity": 1.0}], "id": 1276, "stable_key": "clu_ccdd61b65f6da56a", "ground_truth": {"modern_name": "James Prescott Joule", "confidence": "high", "type": "person", "birth_year": 1818, "death_year": 1889, "description": "English physicist, known for work on electricity and thermodynamics.", "wikidata_id": "Q8962", "wikidata_description": "English physicist and brewer (1818–1889)", "wikipedia_url": "https://en.wikipedia.org/wiki/James%20Prescott%20Joule", "wikipedia_extract": "James Prescott Joule (; 24 December 1818 –  11 October 1889) was an English physicist. Joule studied the nature of heat and discovered its relationship to mechanical work. This led to the law of conservation of energy, which in turn led to the development of the first law of thermodynamics. The SI unit of energy, the joule (J), is named after him. He worked with Lord Kelvin to develop an absolute thermodynamic temperature scale, which came to be called the Kelvin scale. Joule also made observations of magnetostriction, and he found the relationship between the current through a resistor and the heat dissipated, which is also called Joule's first law."}, "cross_references": [{"found_name": "Grove", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1923, "target_cluster_name": "Grove", "source_book": "llm_generated", "evidence_snippet": "Grove's concept of the 'correlation of forces' was a precursor to Joule's experimental work on the mechanical equivalent of heat, a key aspect of the conservation of energy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Grove's concept of the 'correlation of forces' was a precursor to Joule's experimental work on the mechanical equivalent of heat, a key aspect of the conservation of energy.", "is_reverse": true}, {"found_name": "Dalton", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2442, "target_cluster_name": "Dalton", "source_book": "llm_generated", "evidence_snippet": "James Prescott Joule was a physicist known for his work on the nature of heat and its relation to mechanical work, leading to the development of the first law of thermodynamics. John Dalton's earlier work on the atomic theory and the properties of gases laid some of the groundwork for later developments in thermodynamics and statistical mechanics.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: James Prescott Joule was a physicist known for his work on the nature of heat and its relation to mechanical work, leading to the development of the first law of thermodynamics. John Dalton's earlier work on the atomic theory and the properties of gases laid some of the groundwork for later developments in thermodynamics and statistical mechanics.", "is_reverse": true}, {"found_name": "M. Seebeck", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2615, "target_cluster_name": "M. Seebeck", "source_book": "llm_generated", "evidence_snippet": "Augustus Seebeck and James Prescott Joule were both prominent physicists in the 19th century who made significant contributions to the understanding of electricity and magnetism, particularly in the area of thermoelectricity and the relationship between heat and electrical energy. They were contemporaries and their work was often discussed and compared in scientific circles.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Augustus Seebeck and James Prescott Joule were both prominent physicists in the 19th century who made significant contributions to the understanding of electricity and magnetism, particularly in the area of thermoelectricity and the relationship between heat and electrical energy. They were contemporaries and their work was often discussed and compared in scientific circles.", "is_reverse": true}]}, {"canonical_name": "dias", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 6, "total_mentions": 11, "members": [{"entity_id": "days", "book_id": "principles_of_psychology_james_1890", "name": "days", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["days"], "contexts": ["unit of time"]}, {"entity_id": "dias", "book_id": "coloquios_da_orta_1563", "name": "dias", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["dias"], "contexts": ["unit of time"]}, {"entity_id": "days", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Days", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Days", "days"], "contexts": ["unit of time", "units of time"]}, {"entity_id": "day", "book_id": "principles_of_psychology_james_1890", "name": "day", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["day"], "contexts": ["daytime period"]}, {"entity_id": "day", "book_id": "connexion_physical_sciences_somerville_1858", "name": "day", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["day"], "contexts": ["period of light determined by rotation", "period of light from the sun"]}, {"entity_id": "day", "book_id": "first_principles_spencer_1862", "name": "day", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["day"], "contexts": ["concept name in Pawnee language"]}, {"entity_id": "dia", "book_id": "historia_medicinal_monardes_1574", "name": "dia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["dia"], "contexts": ["time of day for drinking"]}, {"entity_id": "dia", "book_id": "polyanthea_medicinal", "name": "dia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["dia"], "contexts": ["time of day"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "days", "target_book": "coloquios_da_orta_1563", "target_name": "dias", "similarity": 0.918}, {"source_book": "principles_of_psychology_james_1890", "source_name": "days", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Days", "similarity": 0.974}, {"source_book": "coloquios_da_orta_1563", "source_name": "dias", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Days", "similarity": 0.906}], "id": 1277, "stable_key": "clu_2bfadb450bad3f48", "ground_truth": {"modern_name": "day", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Day", "wikipedia_extract": "A day is the time period of a full rotation of the Earth with respect to the Sun. On average, this is 24 hours (86,400 seconds). As a day passes at a given location it experiences morning, afternoon, evening, and night. This daily cycle drives circadian rhythms in many organisms, which are vital to many life processes. A collection of sequential days is organized into calendars as dates, almost always into weeks, months and years. A solar calendar organizes dates based on the Sun's annual cycle, giving consistent start dates for the four seasons from year to year."}, "member_count": 8, "cross_references": [{"found_name": "Diurnal", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3948, "target_cluster_name": "Diurnal", "source_book": "llm_generated", "evidence_snippet": "The term 'diurnal' directly relates to the daily cycle, meaning occurring or active during the day.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The term 'diurnal' directly relates to the daily cycle, meaning occurring or active during the day."}]}, {"canonical_name": "velocity of light", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "velocity_of_light", "book_id": "principles_of_psychology_james_1890", "name": "velocity of light", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["velocity of light"], "contexts": ["speed at which light travels"]}, {"entity_id": "velocity_of_light", "book_id": "kosmos_humboldt_1845", "name": "velocity of light", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["velocity of light"], "contexts": ["speed of light propagation"]}, {"entity_id": "velocity_of_light", "book_id": "connexion_physical_sciences_somerville_1858", "name": "velocity of light", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["velocity of light", "Velocity of Light"], "contexts": ["speed at which light travels", "speed of light"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "velocity of light", "target_book": "kosmos_humboldt_1845", "target_name": "velocity of light", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "velocity of light", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "velocity of light", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "velocity of light", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "velocity of light", "similarity": 1.0}], "id": 1278, "stable_key": "clu_a7587998a33cb5c3", "ground_truth": {"modern_name": "speed of light", "confidence": "high", "type": "concept", "wikidata_id": "Q2111", "wikidata_description": "speed of electromagnetic waves in vacuum"}, "cross_references": [{"found_name": "Time", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 223, "target_cluster_name": "time", "source_book": "llm_generated", "evidence_snippet": "The speed of light is defined as the distance light travels in a given unit of time, making time a fundamental related concept.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The speed of light is defined as the distance light travels in a given unit of time, making time a fundamental related concept."}]}, {"canonical_name": "año", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 7, "members": [{"entity_id": "year", "book_id": "principles_of_psychology_james_1890", "name": "year", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["year"], "contexts": ["period of twelve months"]}, {"entity_id": "año", "book_id": "historia_medicinal_monardes_1574", "name": "año", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["año"], "contexts": ["time period", "years"]}, {"entity_id": "year", "book_id": "connexion_physical_sciences_somerville_1858", "name": "year", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["year"], "contexts": ["time for Earth's orbit around the Sun", "period of 365 days"]}, {"entity_id": "1870", "book_id": "principles_of_psychology_james_1890", "name": "1870", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["1870"], "contexts": ["year of Schiff's experiments"]}, {"entity_id": "1870", "book_id": "coloquios_da_orta_1563", "name": "1870", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["1870"], "contexts": ["year of botanical description"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "year", "target_book": "historia_medicinal_monardes_1574", "target_name": "año", "similarity": 0.969}, {"source_book": "principles_of_psychology_james_1890", "source_name": "year", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "year", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "año", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "year", "similarity": 0.969}], "id": 1279, "stable_key": "clu_9b2ad9b788beb9a2", "ground_truth": {"modern_name": "year", "confidence": "high", "type": "concept", "note": "The numbers '1867' and '1870' clearly refer to specific years, used in the context of historical dates for scientific works.", "wikidata_id": "Q577", "wikidata_description": "the orbital period of the Earth: the estimated period of time for the Earth's orbit around the Sun and observed at a fixed geographic point (averaging 365.24 days); base later modified to define or adjust various calendars", "wikipedia_url": "https://en.wikipedia.org/wiki/Year", "wikipedia_extract": "A year is a unit of time based on how long it takes the Earth to orbit the Sun. In scientific use, the tropical year (approximately 365 solar days, 5 hours, 48 minutes, 45 seconds) and the sidereal year (about 20 minutes longer) are more exact. The modern calendar year, as reckoned according to the Gregorian calendar, approximates the tropical year by using a system of leap years. The term 'year' is also used to indicate other periods of roughly similar duration, such as the lunar year (a roughly 354-day cycle of twelve of the Moon's phases – see lunar calendar), as well as periods loosely associated with the calendar or astronomical year, such as the seasonal year, the fiscal year, the academic year, etc. Due to the Earth's axial tilt, the course of a year sees the passing of the seasons, marked by changes in weather, the hours of daylight, and, consequently, vegetation and soil fertility. In temperate and subpolar regions around the planet, four seasons are generally recognized: spring, summer, autumn, and winter."}, "member_count": 5, "cross_references": [{"found_name": "Age", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 174, "target_cluster_name": "age", "source_book": "llm_generated", "evidence_snippet": "A period of time, often measured in years.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "A period of time, often measured in years."}, {"found_name": "Chronology", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2825, "target_cluster_name": "Chronology", "source_book": "llm_generated", "evidence_snippet": "The study of the arrangement of events in time, often using years as a unit.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The study of the arrangement of events in time, often using years as a unit."}, {"found_name": "Christian Era", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1945, "target_cluster_name": "Christian era", "source_book": "llm_generated", "evidence_snippet": "A system of reckoning years.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "A system of reckoning years."}, {"found_name": "Ecliptic", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1541, "target_cluster_name": "ecliptic", "source_book": "llm_generated", "evidence_snippet": "The apparent path of the Sun over the course of a year.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The apparent path of the Sun over the course of a year."}]}, {"canonical_name": "Munich", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "munich", "book_id": "kosmos_humboldt_1845", "name": "Munich", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Munich"], "contexts": ["location where Lamont saw satellites", "city in Germany"]}, {"entity_id": "munich", "book_id": "coloquios_da_orta_1563", "name": "Munich", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Munich"], "contexts": ["city of publication"]}, {"entity_id": "munich", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Munich", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Munich"], "contexts": ["city where Fraunhofer worked"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Munich", "target_book": "coloquios_da_orta_1563", "target_name": "Munich", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Munich", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Munich", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Munich", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Munich", "similarity": 1.0}], "id": 1280, "stable_key": "clu_5355b1f036488b1a", "ground_truth": {"modern_name": "Munich", "confidence": "high", "type": "place", "country": "Germany", "note": "The context of Fraunhofer working there solidifies the identification with the German city.", "wikidata_id": "Q1726", "wikidata_description": "capital and most populous city of Bavaria, Germany", "wikipedia_url": "https://en.wikipedia.org/wiki/Munich", "wikipedia_extract": "Munich is the capital and most populous city of Bavaria, Germany. As of 30 November 2024, its population was 1,604,384, making it the third-largest city in Germany after Berlin and Hamburg. Munich is the largest city in Germany that is not a state of its own, and it ranks as the 11th-largest city in the European Union. The metropolitan area has around 3 million inhabitants, and the broader Munich Metropolitan Region is home to about 6.2 million people. It is the third largest metropolitan region by GDP in the European Union. Munich is located on the river Isar north of the Alps."}, "cross_references": [{"found_name": "Berlin", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 267, "target_cluster_name": "Berlin", "source_book": "llm_generated", "evidence_snippet": "Munich is the third-largest city in Germany after Berlin and Hamburg.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Munich is the third-largest city in Germany after Berlin and Hamburg."}]}, {"canonical_name": "magnetic meridian", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "magnetic_meridian", "book_id": "kosmos_humboldt_1845", "name": "magnetic meridian", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["magnetic meridian"], "contexts": ["line of magnetic north-south", "line of magnetic force"]}, {"entity_id": "magnetic_meridians", "book_id": "connexion_physical_sciences_somerville_1858", "name": "magnetic meridians", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["magnetic meridians"], "contexts": ["lines of magnetic force on Earth"]}, {"entity_id": "magnetic_meridian", "book_id": "first_principles_spencer_1862", "name": "magnetic meridian", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["magnetic meridian"], "contexts": ["line of magnetic force"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "magnetic meridian", "target_book": "connexio