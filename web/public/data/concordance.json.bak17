lment"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Infection", "target_book": "historia_medicinal_monardes_1574", "target_name": "infection", "similarity": 0.979}], "id": 1792, "stable_key": "clu_06ff02a80ff1b467", "ground_truth": {"modern_name": "Infection", "confidence": "high", "type": "disease", "modern_term": "Infection", "wikidata_id": "Q166231", "wikidata_description": "invasion of and multiplication in a host by disease-causing pathogens or organisms, and the reaction of host tissues"}, "cross_references": [{"found_name": "pestilentes", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 688, "target_cluster_name": "pestilentes", "source_book": "llm_generated", "evidence_snippet": "Pestilence is a disease that is typically caused by infection.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Pestilence is a disease that is typically caused by infection.", "is_reverse": true}, {"found_name": "leycenços", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3215, "target_cluster_name": "leycenços", "source_book": "llm_generated", "evidence_snippet": "Erysipelas is a bacterial infection, making 'Infection' a direct and relevant category.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Erysipelas is a bacterial infection, making 'Infection' a direct and relevant category.", "is_reverse": true}, {"found_name": "Buuas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2225, "target_cluster_name": "Buuas", "source_book": "llm_generated", "evidence_snippet": "Bubonic plague is a type of infection, making 'infection' a related broader category.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Bubonic plague is a type of infection, making 'infection' a related broader category.", "is_reverse": true}]}, {"canonical_name": "Woods", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 18, "members": [{"entity_id": "woods", "book_id": "english_physician_1652", "name": "Woods", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 17, "variants": ["Woods"], "contexts": ["habitat for Alder-Tree", "habitat for Yellow-Archangel"]}, {"entity_id": "woods", "book_id": "principles_of_psychology_james_1890", "name": "woods", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["woods"], "contexts": ["areas covered with trees"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Woods", "target_book": "principles_of_psychology_james_1890", "target_name": "woods", "similarity": 0.968}], "id": 1793, "stable_key": "clu_94d5d7004fce0c9f", "ground_truth": {"modern_name": "woods", "confidence": "high", "type": "place", "description": "An area characterized by the presence of trees.", "wikipedia_extract": "A woodland ( ) is, in the broad sense, land covered with woody plants (trees and shrubs), or in a narrow sense, synonymous with wood (or in the U.S., the plurale tantum woods), a low-density forest forming open habitats with plenty of sunlight and limited shade (see differences between British, American and Australian English explained below). Some savannas may also be woodlands, such as savanna woodland, where trees and shrubs form a light canopy. Woodlands may support an understory of shrubs and herbaceous plants including grasses. Woodland may form a transition to shrubland under drier conditions or during early stages of primary or secondary succession. Higher-density areas of trees with a largely closed canopy that provides extensive and nearly continuous shade are often referred to as forests. Extensive efforts by conservationist groups have been made to preserve woodlands from urbanization and agriculture."}, "cross_references": [{"found_name": "Forest", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 466, "target_cluster_name": "Forrests", "source_book": "llm_generated", "evidence_snippet": "The description explicitly states that 'wood' (or 'woods') is synonymous with 'wood' in a narrow sense, and 'woodland' is land covered with woody plants, differentiating it from a 'forest' only by density and light penetration.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The description explicitly states that 'wood' (or 'woods') is synonymous with 'wood' in a narrow sense, and 'woodland' is land covered with woody plants, differentiating it from a 'forest' only by density and light penetration."}]}, {"canonical_name": "Electuary", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 18, "members": [{"entity_id": "electuary", "book_id": "english_physician_1652", "name": "Electuary", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 9, "variants": ["Electuary", "Electuaries"], "contexts": ["sweetened medicinal paste", "used for gout"]}, {"entity_id": "electuario", "book_id": "polyanthea_medicinal", "name": "electuario", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 9, "variants": ["electuario", "electuario rofado", "electuarios"], "contexts": ["medicinal confection taken at night", "type of medicinal preparation"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Electuary", "target_book": "polyanthea_medicinal", "target_name": "electuario", "similarity": 0.893}], "id": 1794, "stable_key": "clu_88ecfbdedfda4168", "ground_truth": {"modern_name": "electuary", "confidence": "high", "type": "substance", "description": "A sweet, paste-like medicinal preparation mixed with honey or syrup.", "wikipedia_extract": "An electuary is a medicine consisting of a powder or other ingredient mixed with something sweet such as honey to make it more palatable. In German and Swiss cultures, electuary (German: Latwerge or Latwerg) is also more generally a thickened juice and honey preparation with a thick, viscous consistency that is used in for culinary purposes, such as a (bread) spread or as a sauce ingredient. In the Indian Ayurveda tradition, electuaries are called Lēhya (लेह्य) (literally, \"lickable\"). There are several different types of electuary: laxative electuary, joyful electuary, etc. The fermentation of mixed herbs in honey and their effects on each other are said to increase the medical properties already present and to create new ones. Avicenna (1999)."}, "cross_references": [{"found_name": "Conserve", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 683, "target_cluster_name": "Conserve", "source_book": "llm_generated", "evidence_snippet": "Both are preparations made with fruit or herbs preserved with sugar or honey.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are preparations made with fruit or herbs preserved with sugar or honey."}]}, {"canonical_name": "Clusius", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 18, "members": [{"entity_id": "clusius", "book_id": "english_physician_1652", "name": "Clusius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Clusius"], "contexts": ["Renaissance botanist", "affirms pear-tree mistletoe prevalence"]}, {"entity_id": "clusius", "book_id": "coloquios_da_orta_1563", "name": "Clusius", "category": "PERSON", "subcategory": "SCHOLAR", "count": 16, "variants": ["Clusius"], "contexts": ["notes on amber origin", "received amomo, drew Exoticorum"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Clusius", "target_book": "coloquios_da_orta_1563", "target_name": "Clusius", "similarity": 0.612}], "id": 1795, "stable_key": "clu_0ae8f3648411751c", "ground_truth": {"modern_name": "Carolus Clusius", "confidence": "high", "type": "person", "birth_year": 1526, "death_year": 1609, "description": "Renaissance botanist and physician, explored flora of Iberian Peninsula.", "wikidata_id": "Q18983571", "wikidata_description": "street in Voorhout, the Netherlands"}, "cross_references": [{"found_name": "Portuguezes", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 218, "target_cluster_name": "Portuguezes", "source_book": "llm_generated", "evidence_snippet": "Carolus Clusius was a Flemish botanist who spent significant time in Portugal and studied its flora, thus having a connection to the Portuguese context.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Carolus Clusius was a Flemish botanist who spent significant time in Portugal and studied its flora, thus having a connection to the Portuguese context.", "is_reverse": true}, {"found_name": "Dodon", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2273, "target_cluster_name": "Dodon", "source_book": "llm_generated", "evidence_snippet": "Clusius was a prominent botanist and contemporary of Dodoens, and they corresponded and influenced each other's work.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Clusius was a prominent botanist and contemporary of Dodoens, and they corresponded and influenced each other's work.", "is_reverse": true}]}, {"canonical_name": "Divergence of Character", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 18, "members": [{"entity_id": "divergence_of_character", "book_id": "origin_of_species_darwin_1859", "name": "Divergence of Character", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 17, "variants": ["Divergence of Character", "divergence of character"], "contexts": ["evolutionary splitting of lineages", "evolutionary process of species differentiation"]}, {"entity_id": "divergence_of_character", "book_id": "first_principles_spencer_1862", "name": "divergence of character", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["divergence of character"], "context