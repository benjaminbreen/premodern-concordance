y_id": "neptune", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Neptune", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Neptune"], "contexts": ["Escalier de Neptune"]}, {"entity_id": "neptune", "book_id": "kosmos_humboldt_1845", "name": "Neptune", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 6, "variants": ["Neptune"], "contexts": ["primary planet in the solar system", "planet beyond Uranus"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Neptune", "target_book": "kosmos_humboldt_1845", "target_name": "Neptune", "similarity": 1.0}], "id": 2411, "stable_key": "clu_78508b11dff76cfc", "ground_truth": {"modern_name": "Neptune", "confidence": "high", "type": "object", "wikidata_id": "", "wikidata_description": "given name", "wikipedia_extract": "The Neptunes were an American record production duo composed of Pharrell Williams and Chad Hugo, formed in Virginia Beach, Virginia, in 1992. Williams often provided backing vocals and music video appearances on the duo's productions, while Hugo remained behind the scenes. Since their inception, the Neptunes have produced songs for several music industry artists, including Clipse, Jay-Z, Kelis, N.O.R.E., Britney Spears, Justin Timberlake, Nelly, Ludacris, T.I., Robin Thicke, Usher, Gwen Stefani, and Snoop Dogg, among others. In 2009, Billboard ranked the Neptunes number one on their list of the top 10 producers of the decade. In January 2020, the Neptunes were announced to be inducted into the Songwriters Hall of Fame as a part of the 2020 class, and in May 2021, Hugo and Williams received Honorary Doctorates from Berklee College of Music and Boston Conservatory at Berklee. Williams and Hugo met at a summer camp for the school of the Gifted and Talented in Virginia Beach, Virginia, where Williams played drums and Hugo played tenor saxophone.", "wikipedia_url": "https://en.wikipedia.org/wiki/The_Neptunes"}, "cross_references":