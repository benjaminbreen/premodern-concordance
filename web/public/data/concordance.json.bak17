me": "Kotzebue", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Kotzebue"], "contexts": ["voyages mentioned for sea water temperature"]}, {"entity_id": "kotzebue", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Kotzebue", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Kotzebue"], "contexts": ["explorer who found temperature stratum", "discovered stratum in the ocean"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Kotzebue", "target_book": "kosmos_humboldt_1845", "target_name": "Kotzebue", "similarity": 0.699}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Kotzebue", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Kotzebue", "similarity": 0.699}, {"source_book": "kosmos_humboldt_1845", "source_name": "Kotzebue", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Kotzebue", "similarity": 1.0}], "id": 1160, "stable_key": "clu_6019401d6d99ff06", "ground_truth": {"modern_name": "Otto von Kotzebue", "confidence": "high", "type": "person", "birth_year": 1787, "death_year": 1846, "description": "Naval officer and explorer, known for voyages and scientific observations.", "wikidata_id": "Q58828", "wikidata_description": "Baltic German explorer (1787–1846)", "wikipedia_url": "https://en.wikipedia.org/wiki/Otto%20von%20Kotzebue", "wikipedia_extract": "Otto von Kotzebue (Russian: О́тто Евста́фьевич Коцебу́; 30 December 1787 – 15 February 1846) was a Baltic German naval officer in the Imperial Russian Navy. He commanded two naval expeditions into the Pacific for the purposes of exploration and scientific investigation. The first expedition explored Oceania and the western coast of North America and passed through the Bering Strait in search of a passage across the Arctic Ocean. His second voyage was intended as a military resupply mission to Kamchatka but again included significant explorations of the west coast of North America and Oceania. Kotzebue was born and raised in Reval (Tallinn), in the Governorate of Estonia of the Russian Empire. He was the second son of German writer and diplomat August von Kotzebue."}, "cross_references": []}, {"canonical_name": "Charles II", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "charles_ii", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Charles II", "category": "PERSON", "subcategory": "PATRON", "count": 3, "variants": ["Charles II", "Charles III", "Roi Charles III"], "contexts": ["king during a period of Portuguese gains", "King Charles III"]}, {"entity_id": "charles_ii_of_england", "book_id": "principles_of_psychology_james_1890", "name": "Charles II of England", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Charles II of England"], "contexts": ["monarch at whose court phenomenon was shown"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Charles II", "target_book": "principles_of_psychology_james_1890", "target_name": "Charles II of England", "similarity": 0.939}], "id": 1161, "stable_key": "clu_01015cf08384ff93", "ground_truth": {"modern_name": "Charles II of England", "confidence": "high", "type": "person", "birth_year": 1630, "death_year": 1685, "description": "King of England, Scotland, and Ireland, associated with scientific patronage.", "note": "The context 'King Charles' is ambiguous but strongly points to Charles II given the other references.", "wikidata_id": "Q122553", "wikidata_description": "King of England, Scotland, and Ireland from 1660 to 1685", "wikipedia_url": "https://en.wikipedia.org/wiki/Charles%20II%20of%20England", "wikipedia_extract": "Charles II (29 May 1630 – 6 February 1685) was King of Scotland from 1649 until 1651 and King of England, Scotland, and Ireland from the 1660 Restoration of the monarchy until his death in 1685. Charles II was the eldest surviving child of Charles I of England, Scotland and Ireland and Henrietta Maria of France. After Charles I's execution at Whitehall on 30 January 1649, at the climax of the English Civil War, the Parliament of Scotland proclaimed Charles II king on 5 February 1649. However, England entered the period known as the English Interregnum or the English Commonwealth with a republican government eventually led by Oliver Cromwell. Cromwell defeated Charles II at the Battle of Worcester on 3 September 1651, and Charles fled to mainland Europe. Cromwell became Lord Protector of England, Scotland and Ireland."}, "cross_references": [{"found_name": "Louis XIV", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1091, "target_cluster_name": "Louis XIV", "source_book": "llm_generated", "evidence_snippet": "Charles II was a contemporary monarch and had significant political interactions with Louis XIV, particularly during his exile and after the Restoration.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Charles II was a contemporary monarch and had significant political interactions with Louis XIV, particularly during his exile and after the Restoration."}, {"found_name": "Lewis", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2944, "target_cluster_name": "Lewis", "source_book": "llm_generated", "evidence_snippet": "Louis IX was the grandfather of Charles II of England, a significant dynastic and political relationship.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Louis IX was the grandfather of Charles II of England, a significant dynastic and political relationship.", "is_reverse": true}]}, {"canonical_name": "formations calcaires", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "formations_calcaires", "book_id": "relation_historique_humboldt_vol3_1825", "name": "form