on", "similarity": 0.891}], "id": 3640, "stable_key": "clu_a0428c0b842e484d", "ground_truth": {"modern_name": "Earth's flattening", "confidence": "high", "type": "concept"}, "cross_references": []}, {"canonical_name": "Lalande", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "lalande", "book_id": "kosmos_humboldt_1845", "name": "Lalande", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Lalande"], "contexts": ["astronomer, author of 'Astron.'"]}, {"entity_id": "lalande", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Lalande", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Lalande"], "contexts": ["computed epochs of planet conjunctions", "computed epochs of conjunctions"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Lalande", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Lalande", "similarity": 1.0}], "id": 3641, "stable_key": "clu_5d4ac8804a7ba368", "ground_truth": {"modern_name": "Joseph Jérôme Le Français de Lalande", "confidence": "high", "type": "person", "birth_year": 1732, "death_year": 1807, "description": "French astronomer known for astronomical tables and star catalog", "wikidata_id": "Q168419", "wikidata_description": "French astronomer (*1732 – †1807)"}, "cross_references": []}, {"canonical_name": "Formentera", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "formentera", "book_id": "kosmos_humboldt_1845", "name": "Formentera", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Formentera"], "contexts": ["location of pendulum observations"]}, {"entity_id": "formentera", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Formentera", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Formentera"], "contexts": ["southern Balearic Island", "location for meridian measurement"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Formentera", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Formentera", "similarity": 1.0}], "id": 3642, "stable_key": "clu_9b3bdfb0680415e0", "ground_truth": {"modern_name": "Formentera", "confidence": "high", "type": "place", "country": "Spain", "wikidata_id": "Q52626", "wikidata_description": "municipality of Baleares, Spain, containing the island of the same name", "wikipedia_extract": "Formentera (Balearic Catalan: [fuɾmənˈteɾə], Spanish: [foɾmenˈteɾa]) is a Spanish island located in the Mediterranean Sea, which belongs to the Balearic Islands autonomous community together with Mallorca, Menorca, and Ibiza. Formentera is the smallest and most southerly island of the Pityusic Islands group (comprising Ibiza and Formentera itself, as well as various small islets). It covers an area of 83.24 square kilometres (32.14 sq mi), including offshore islets. At the 2011 Census, the population was 10,583; according to the Census of 1 January 2021, it counted 11,891 inhabitants, while the official estimate at 1 January 2023 was 11,389. The island's name is said to derive from the Latin word frumentarium, meaning \"granary\". The island was occupied in prehistoric times, going back to 2,000–1,600 BC.", "wikipedia_url": "https://en.wikipedia.org/wiki/Formentera"}, "cross_references": []}, {"canonical_name": "magnetic influence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "magnetic_influences", "book_id": "kosmos_humboldt_1845", "name": "magnetic influences", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["magnetic influences"], "contexts": ["phenomenon investigated in experiments"]}, {"entity_id": "magnetic_influence", "book_id": "connexion_physical_sciences_somerville_1858", "name": "magnetic influence", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["magnetic influence"], "contexts": ["effect of magnetic fields"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "magnetic influences", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "magnetic influence", "similarity": 0.958}], "id": 3643, "stable_key": "clu_468fdc3f28cd7072", "ground_truth": {"modern_name": "Magnetic influence", "confidence": "high", "type": "concept", "wikidata_id": "Q58366054", "wikidata_description": "scholarly article by Randall C. Brooks published May 1987 in Annals of Science"}, "cross_references": []}, {"canonical_name": "conducting power", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "conducting_power", "book_id": "kosmos_humboldt_1845", "name": "conducting power", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["conducting power"], "contexts": ["ability to transfer heat"]}, {"entity_id": "conducting_power", "book_id": "connexion_physical_sciences_somerville_1858", "name": "conducting power", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["conducting power"], "contexts": ["ability of a substance to conduct electricity", "ability to transmit electrical force"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "conducting power", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "conducting power", "similarity": 1.0}], "id": 3644, "stable_key": "clu_5d94143c13e68a04", "ground_truth": {"modern_name": "Thermal conductivity", "confidence": "high", "type": "concept", "note": "The texts also refer to electrical conductivity, but thermal conductivity is the primary scientific concept related to heat transfer.", "wikidata_id": "Q487005", "wikidata_description": "capacity of a material to conduct heat", "wikipedia_url": "https://en.wikipedia.org/wiki/Thermal%20conductivity%20and%20resistivity", "wikipedia_extract": "The thermal conductivity of a material is a measure of its ability to conduct heat. It is commonly denoted by and, in SI units, is measured in W·m−1·K−1. It quantifies the proportionality between the heat flux (heat flow rate per unit area, W·m−2) and the temperature gradient (K·m−1) in the direction of heat transport. The reciprocal of thermal conductivity is called thermal resistivity. Materials with high thermal conductivity transfer heat more efficiently than those with low thermal conductivity. Heat transport can arise from different microscopic mechanisms: In metals, thermal conductivity is typically dominated by free electrons, whereas in dielectric materials such as diamond it is largely due to lattice vibrations."}, "cross_references": []}, {"canonical_name": "curve", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "curves", "book_id": "kosmos_humboldt_1845", "name": "curves", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["curves"], "contexts": ["graphical representations of magnetic lines"]}, {"entity_id": "curve", "book_id": "connexion_physical_sciences_somerville_1858", "name": "curve", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["curve"], "contexts": ["path of storm movement", "mathematical representation of a path"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "curves", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "curve", "similarity": 0.914}], "id": 3645, "stable_key": "clu_5bf4b18f683ebd1b", "ground_truth": {"modern_name": "Curve", "confidence": "high", "type": "concept", "note": "The context of magnetic lines and storm paths indicates a mathematical or graphical representation of phenomena."}, "cross_references": [{"found_name": "circle", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1061, "target_cluster_name": "circle", "source_book": "llm_generated", "evidence_snippet": "A circle is a specific type of curve.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: A circle is a specific type of curve.", "is_reverse": true}, {"found_name": "t.", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1348, "target_cluster_name": "t.", "source_book": "llm_generated", "evidence_snippet": "The abbreviation 't.' for tangent is a mathematical notation used to denote a specific type of curve or line segment in geometry and trigonometry.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The abbreviation 't.' for tangent is a mathematical notation used to denote a specific type of curve or line segment in geometry and trigonometry.", "is_reverse": true}]}, {"canonical_name": "Thermo-electric currents", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "thermo-electric_currents", "book_id": "kosmos_humboldt_1845", "name": "thermo-electric currents", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["thermo-electric currents"], "contexts": ["currents generated by heat difference"]}, {"entity_id": "thermo-electric_currents", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Thermo-electric currents", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["Thermo-electric currents"], "contexts": ["electrical currents generated by heat", "electrical currents generated by temperature differences"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "thermo-electric currents", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Thermo-electric currents", "similarity": 0.992}], "id": 3646, "stable_key": "clu_08f184c476a539a4", "ground_truth": {"modern_name": "Thermoelectric effect", "confidence": "high", "type": "concept", "note": "This refers to the generation of electric current due to a temperature difference."}, "cross_references": []}, {"canonical_name": "revolution round the sun", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "revolution_of_the_sun", "book_id": "kosmos_humboldt_1845", "name": "revolution of the Sun", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["revolution of the Sun"], "contexts": ["apparent movement of the Sun"]}, {"entity_id": "revolution_round_the_sun", "book_id": "connexion_physical_sciences_somerville_1858", "name": "revolution round the sun", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["revolution round the sun"], "contexts": ["earth's orbit around the sun", "orbital motion of a planet around the sun"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "revolution of the Sun", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "revolution round the sun", "similarity": 0.894}], "id": 3647, "stable_key": "clu_875b5fbecf3cde70", "ground_truth": {"modern_name": "Heliocentric model", "confidence": "high", "type": "concept", "note": "The phrase 'revolution round the sun' refers to the Earth's orbit, as understood in the heliocentric model."}, "cross_references": [{"found_name": "Kepler’s law", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2895, "target_cluster_name": "Kepler’s law", "source_book": "llm_generated", "evidence_snippet": "Kepler's laws describe planetary motion within a heliocentric framework.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Kepler's laws describe planetary motion within a heliocentric framework.", "is_reverse": true}]}, {"canonical_name": "Observatory", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "observatory", "book_id": "kosmos_humboldt_1845", "name": "Observatory", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Observatory"], "contexts": ["place for astronomical observations"]}, {"entity_id": "observatory", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Observatory", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["observatory", "Observatory"], "contexts": ["building for astronomical observation", "scientific observation institution"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Observatory", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Observatory", "similarity": 1.0}], "id": 3648, "stable_key": "clu_4d491b4b780f9fc2", "ground_truth": {"modern_name": "Observatory", "confidence": "high", "type": "concept", "wikidata_id": "Q62832", "wikidata_description": "location used for observing terrestrial or celestial events", "wikipedia_url": "https://en.wikipedia.org/wiki/Observatory", "wikipedia_extract": "An observatory is a location used for observing terrestrial, marine, or celestial events. Astronomy, climatology/meteorology, geophysics, oceanography and volcanology are examples of disciplines for which observatories have been constructed. The term observatoire has been used in French since at least 1976 to denote any institution that compiles and presents data on a particular subject (such as public health observatory) or for a particular geographic area (European Audiovisual Observatory). Astronomical observatories are mainly divided into four categories according to location: space-based, airborne, ground-based, and underground-based. Historically, ground-based observatories were as simple as containing a mural instrument (for measuring the angle between stars) or Stonehenge (which has some alignments on astronomical phenomena). Astronomical observatories may be private or they may be public."}, "cross_references": []}, {"canonical_name": "Greenwich Observatory", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "observatory_at_greenwich", "book_id": "kosmos_humboldt_1845", "name": "Observatory at Greenwich", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Observatory at Greenwich"], "contexts": ["astronomical observatory"]}, {"entity_id": "greenwich_observatory", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Greenwich Observatory", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Greenwich Observatory"], "contexts": ["observatory for lunar observations", "observatory location"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Observatory at Greenwich", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Greenwich Observatory", "similarity": 0.967}], "id": 3649, "stable_key": "clu_ae6574a393440237", "ground_truth": {"modern_name": "Royal Observatory, Greenwich", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q192988", "wikidata_description": "observatory in Greenwich, London, UK"}, "cross_references": []}, {"canonical_name": "explosion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "explosion", "book_id": "kosmos_humboldt_1845", "name": "explosion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["explosion"], "contexts": ["sudden release of energy"]}, {"entity_id": "explosion", "book_id": "connexion_physical_sciences_somerville_1858", "name": "explosion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["explosion"], "contexts": ["sudden release of energy", "rapid release of energy"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "explosion", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "explosion", "similarity": 1.0}], "id": 3650, "stable_key": "clu_6c96a9e770757d13", "ground_truth": {"modern_name": "Explosion", "confidence": "high", "type": "concept", "wikidata_id": "Q179057", "wikidata_description": "sudden release of energy through high temperatures and gas expansion"}, "cross_references": [{"found_name": "electric explosions", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1093, "target_cluster_name": "electric explosions", "source_book": "llm_generated", "evidence_snippet": "The term 'electric explosions' is used as a historical synonym for electrical discharge, highlighting its explosive nature.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The term 'electric explosions' is used as a historical synonym for electrical discharge, highlighting its explosive nature.", "is_reverse": true}, {"found_name": "combustion", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 866, "target_cluster_name": "combustion", "source_book": "llm_generated", "evidence_snippet": "Combustion can lead to explosions, especially when rapid and contained.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Combustion can lead to explosions, especially when rapid and contained.", "is_reverse": true}, {"found_name": "thunder", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2062, "target_cluster_name": "thunder", "source_book": "llm_generated", "evidence_snippet": "The rapid expansion of air that causes thunder is akin to an explosion.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The rapid expansion of air that causes thunder is akin to an explosion.", "is_reverse": true}, {"found_name": "volcanic action", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2000, "target_cluster_name": "volcanic action", "source_book": "llm_generated", "evidence_snippet": "Volcanic eruptions are a form of explosion.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Volcanic eruptions are a form of explosion.", "is_reverse": true}, {"found_name": "destruction", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2527, "target_cluster_name": "destruction", "source_book": "llm_generated", "evidence_snippet": "An explosion is a rapid and violent destruction of something.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: An explosion is a rapid and violent destruction of something.", "is_reverse": true}]}, {"canonical_name": "Challis", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "challis", "book_id": "kosmos_humboldt_1845", "name": "Challis", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Challis"], "contexts": ["Professor at Cambridge"]}, {"entity_id": "challis", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Challis", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Challis"], "contexts": ["questioned Brewster's analysis of light", "Professor, questioned Brewster's analysis of light"]}, {"entity_id": "professor_challis", "book_id": "kosmos_humboldt_1845", "name": "Professor Challis", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Professor Challis"], "contexts": ["scientist at Cambridge"]}, {"entity_id": "professor_challis", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Professor Challis", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Professor Challis"], "contexts": ["questioned light analysis"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Challis", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Challis", "similarity": 1.0}], "id": 3651, "stable_key": "clu_1259c3ab6448b837", "ground_truth": {"modern_name": "James Challis", "confidence": "high", "type": "person", "birth_year": 1803, "death_year": 1883, "description": "English astronomer and physicist, Cambridge professor.", "wikidata_id": "Q731321", "wikidata_description": "British astronomer (1803-1882)", "wikipedia_url": "https://en.wikipedia.org/wiki/James%20Challis", "wikipedia_extract": "James Challis FRS (12 December 1803 – 3 December 1882) was an English clergyman, physicist and astronomer. Plumian Professor of Astronomy and Experimental Philosophy and the director of the Cambridge Observatory, he investigated a wide range of physical phenomena though made few lasting contributions outside astronomy. He is best remembered for his missed opportunity to discover the planet Neptune in 1846. Challis was born in Braintree, Essex where his father, John Challis, was a stonemason. After attending various local schools, he graduated from Trinity College, Cambridge in 1825 as Senior Wrangler and first Smith's prizeman. He was elected a fellow of Trinity in 1826 and was ordained in 1830."}, "member_count": 4, "cross_references": [{"found_name": "Mr. Adams", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1022, "target_cluster_name": "Mr. Adams", "source_book": "llm_generated", "evidence_snippet": "Challis was a colleague of Adams at the Cambridge Observatory and assisted Adams in his astronomical work, including the search for Neptune.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Challis was a colleague of Adams at the Cambridge Observatory and assisted Adams in his astronomical work, including the search for Neptune.", "is_reverse": true}]}, {"canonical_name": "St. Vincent", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "st__vincent", "book_id": "kosmos_humboldt_1845", "name": "St. Vincent", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["St. Vincent"], "contexts": ["volcano in the small Antilles"]}, {"entity_id": "st__vincent", "book_id": "connexion_physical_sciences_somerville_1858", "name": "St. Vincent", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["St. Vincent"], "contexts": ["island with a volcano"]}, {"entity_id": "vincent,_st_", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Vincent, St.", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Vincent, St."], "contexts": ["location of extinct volcano revival"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "St. Vincent", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "St. Vincent", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "St. Vincent", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Vincent, St.", "similarity": 0.944}], "id": 3652, "stable_key": "clu_65e54c817fdfb1e6", "ground_truth": {"modern_name": "Saint Vincent", "confidence": "high", "type": "place", "country": "Saint Vincent and the Grenadines"}, "cross_references": []}, {"canonical_name": "Chaudes Aigues", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "chaudes_aigues", "book_id": "kosmos_humboldt_1845", "name": "Chaudes Aigues", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Chaudes Aigues"], "contexts": ["location of a hot spring"]}, {"entity_id": "chaudes_aigues", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Chaudes Aigues", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Chaudes Aigues"], "contexts": ["location of a thermal spring", "location with a specific temperature"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Chaudes Aigues", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Chaudes Aigues", "similarity": 1.0}], "id": 3653, "stable_key": "clu_4342fba4380b3528", "ground_truth": {"modern_name": "Chaudes-Aigues", "confidence": "high", "type": "place", "country": "France", "wikidata_id": "Q269112", "wikidata_description": "commune in Cantal, France", "wikipedia_url": "https://en.wikipedia.org/wiki/Chaudes-Aigues", "wikipedia_extract": "Chaudes-Aigues (French: [ʃod.z‿ɛɡ]; Occitan: Chaudas Aigas, lit. '\"Hot Waters\"') is a commune in the Cantal department in south-central France. It is a spa town, famous for its hot spring waters. The commune is situated in the Massif Central in Aubrac. Its inhabitants are called the Caldaguès, from the Latin meaning 'hot waters', or in French, eaux chaudes; hence the name of the commune, Chaudes-Aigues As its name suggests, there are thirty natural hot water sources with temperatures ranging from 45°C to more than 80°C. The most famous is the source of the Par river with a water temperature of 82°C - the hottest in Europe - with a flow in the region of 450,000 litres a day."}, "cross_references": [{"found_name": "fonte", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 394, "target_cluster_name": "fonte", "source_book": "llm_generated", "evidence_snippet": "Chaudes-Aigues is a commune in the Cantal department in south-central France, known for its hot springs. The entity 'Spring' (fonte) can refer to a natural source of water, often associated with geological features like those found in Chaudes-Aigues.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Chaudes-Aigues is a commune in the Cantal department in south-central France, known for its hot springs. The entity 'Spring' (fonte) can refer to a natural source of water, often associated with geological features like those found in Chaudes-Aigues.", "is_reverse": true}, {"found_name": "hot springs", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 436, "target_cluster_name": "hot springs", "source_book": "llm_generated", "evidence_snippet": "Chaudes-Aigues is a commune in the Cantal department in south-central France, known for its hot springs.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Chaudes-Aigues is a commune in the Cantal department in south-central France, known for its hot springs.", "is_reverse": true}]}, {"canonical_name": "granular", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "granular", "book_id": "kosmos_humboldt_1845", "name": "granular", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["granular"], "contexts": ["composed of small grains"]}, {"entity_id": "granular", "book_id": "polyanthea_medicinal", "name": "granular", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["Granular", "granular"], "contexts": ["forming into granules by dropping", "chemical process of preparing medicines"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "granular", "target_book": "polyanthea_medicinal", "target_name": "granular", "similarity": 1.0}], "id": 3654, "stable_key": "clu_ae7ff7bb2911e413", "ground_truth": {"modern_name": "Granular", "confidence": "high", "type": "concept", "note": "Refers to a texture or form consisting of small grains or granules, applicable in both general description and medicinal preparations."}, "cross_references": [{"found_name": "sedimentary rocks", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2128, "target_cluster_name": "sedimentary rocks", "source_book": "llm_generated", "evidence_snippet": "Many sedimentary rocks are characterized by their granular texture, formed from accumulated particles.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Many sedimentary rocks are characterized by their granular texture, formed from accumulated particles.", "is_reverse": true}, {"found_name": "lignite", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1760, "target_cluster_name": "lignites", "source_book": "kosmos_humboldt_1845", "evidence_snippet": "and upper chalk, as the last of the flotz strata, which begin with mountain limestone; tertiary formations in three divisions, which are designated by granular limestone, lignite, and south Apennine g", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of formation"}, {"found_name": "granular limestone", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "kosmos_humboldt_1845", "evidence_snippet": "and upper chalk, as the last of the flotz strata, which begin with mountain limestone; tertiary formations in three divisions, which are designated by granular limestone, lignite, and south Apennine g", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of formation"}, {"found_name": "south Apennine gravel", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "kosmos_humboldt_1845", "evidence_snippet": "and upper chalk, as the last of the flotz strata, which begin with mountain limestone; tertiary formations in three divisions, which are designated by granular limestone, lignite, and south Apennine g", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of formation"}]}, {"canonical_name": "Sardine", "category": "ANIMAL", "subcategory": "FISH", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "sardine", "book_id": "kosmos_humboldt_1845", "name": "sardine", "category": "ANIMAL", "subcategory": "FISH", "count": 1, "variants": ["sardine"], "contexts": ["specific type of fish fossil"]}, {"entity_id": "sardine", "book_id": "ricettario_fiorentino_1597", "name": "Sardine", "category": "ANIMAL", "subcategory": "FISH", "count": 2, "variants": ["Sardine"], "contexts": ["sardonyx stone", "fish name"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "sardine", "target_book": "ricettario_fiorentino_1597", "target_name": "Sardine", "similarity": 0.987}], "id": 3655, "stable_key": "clu_8842bbddc8a17e7b", "ground_truth": {"wikipedia_extract": "Sardine and pilchard are common names for various species of small, oily forage fish in the herring suborder Clupeoidei. The term \"sardine\" was first used in English during the early 15th century; a somewhat dubious etymology says it comes from the Italian island of Sardinia, around which sardines were once supposedly abundant. The terms \"sardine\" and \"pilchard\" are not precise, and what is meant depends on the region. The United Kingdom's Sea Fish Industry Authority, for example, classifies sardines as young pilchards. One criterion suggests fish shorter in length than 15 cm (6 in) are sardines, and larger fish are pilchards. The FAO/WHO Codex standard for canned sardines cites 21 species that may be classed as sardines."}, "cross_references": [{"found_name": "Fish", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 94, "target_cluster_name": "Fish", "source_book": "llm_generated", "evidence_snippet": "Sardines are small, oily fish.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Sardines are small, oily fish.", "is_reverse": true}, {"found_name": "cor- ninole", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "auuerren- do che il mele fia tre volte più che gli fpezii,che VI fi mettono LATTOVARO DI ]^ j^^^ Argherite bianche Fràmenti di zaffiro\" Hiacinto Sardine cioè cor- ninole. Granati Smeraldi Zedoaria Dor", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for Sardine"}]}, {"ca