 "clu_3631094748c98ab8", "ground_truth": {"modern_name": "function", "confidence": "high", "type": "concept"}, "cross_references": [{"found_name": "Development", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 960, "target_cluster_name": "development", "source_book": "llm_generated", "evidence_snippet": "Development can be understood as a process involving a series of functions or changes over time.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Development can be understood as a process involving a series of functions or changes over time."}, {"found_name": "Digestion", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 338, "target_cluster_name": "digestion", "source_book": "llm_generated", "evidence_snippet": "Digestion is a specific biological function.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Digestion is a specific biological function."}, {"found_name": "Emotion and Will", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3531, "target_cluster_name": "Emotion and Will", "source_book": "llm_generated", "evidence_snippet": "Emotions and will are often considered aspects of mental functioning.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Emotions and will are often considered aspects of mental functioning."}]}, {"canonical_name": "grief", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "sorrow", "book_id": "principles_of_psychology_james_1890", "name": "sorrow", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["sorrow"], "contexts": ["inward emotional state", "broad genus of æsthetic feeling"]}, {"entity_id": "grief", "book_id": "first_principles_spencer_1862", "name": "grief", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["grief"], "contexts": ["deep sorrow", "intense sorrow"]}, {"entity_id": "sorrow", "book_id": "first_principles_spencer_1862", "name": "sorrow", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["sorrow"], "contexts": ["feeling of sadness", "feeling of deep sadness"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "sorrow", "target_book": "first_principles_spencer_1862", "target_name": "grief", "similarity": 0.932}, {"source_book": "principles_of_psychology_james_1890", "source_name": "sorrow", "target_book": "first_principles_spencer_1862", "target_name": "sorrow", "similarity": 1.0}], "id": 2305, "stable_key": "clu_115610c837cc313b", "ground_truth": {"modern_name": "Grief", "confidence": "high", "type": "concept", "note": "Directly refers to the emotional state of sorrow or deep sadness.", "wikidata_id": "Q1026040", "wikidata_description": "reaction to loss of someone or something close or important", "wikipedia_url": "https://en.wikipedia.org/wiki/Grief", "wikipedia_extract": "Grief is the response to the loss of something deemed important, in particular the death of a person or animal to which a bond or affection was formed. Although conventionally focused on the emotional response to loss, grief also has physical, cognitive, behavioral, social, cultural, spiritual, political and philosophical dimensions. While the terms are often used interchangeably, bereavement refers to the state of loss, while grief is the reaction to that loss. The grief associated with death is familiar to most people, but individuals grieve in connection with a variety of losses throughout their lives, such as unemployment, ill health or the end of a relationship. Loss can be categorized as either physical or abstract; physical loss is related to something that the individual can touch or measure, such as losing a spouse through death, while other types of loss are more abstract, possibly relating to aspects of a person's social interactions. Modern research has moved beyond rigid stage-based models, such as Kübler-Ross's five stages, toward more flexible frameworks."}, "cross_references": [{"found_name": "anger", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1206, "target_cluster_name": "anger", "source_book": "llm_generated", "evidence_snippet": "Grief and anger are both powerful emotions that can arise from loss or perceived injustice, and are often discussed together in the context of emotional responses.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Grief and anger are both powerful emotions that can arise from loss or perceived injustice, and are often discussed together in the context of emotional responses.", "is_reverse": true}, {"found_name": "Affection", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3559, "target_cluster_name": "affection", "source_book": "llm_generated", "evidence_snippet": "Affection is a bond or positive feeling towards someone or something, which is often the object of grief when lost.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Affection is a bond or positive feeling towards someone or something, which is often the object of grief when lost."}, {"found_name": "Feeling", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 245, "target_cluster_name": "feeling", "source_book": "llm_generated", "evidence_snippet": "Grief is a complex emotional feeling experienced in response to loss.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Grief is a complex emotional feeling experienced in response to loss."}, {"found_name": "Hope", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3087, "target_cluster_name": "hope", "source_book": "llm_generated", "evidence_snippet": "The loss of hope or the absence of hope can be a significant aspect of grief.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The loss of hope or the absence of hope can be a significant aspect of grief."}, {"found_name": "Emotion and Will", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3531, "target_cluster_name": "Emotion and Will", "source_book": "llm_generated", "evidence_snippet": "Grief is a powerful emotion that can influence and be influenced by the will and one's actions.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Grief is a powerful emotion that can influence and be influenced by the will and one's actions."}]}, {"canonical_name": "phenomenon", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "phenomenon", "book_id": "principles_of_psychology_james_1890", "name": "phenomenon", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["phenomenon", "PHENOMENON"], "contexts": ["the bare PHENOMENON", "observable aspect of reality"]}, {"entity_id": "phenomenal", "book_id": "principles_of_psychology_james_1890", "name": "phenomenal", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["phenomenal"], "contexts": ["existing only as perceived by the mind"]}, {"entity_id": "phenomenon", "book_id": "first_principles_spencer_1862", "name": "phenomenon", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Phenomenon", "phenomenon"], "contexts": ["appearance, thing as it is perceived", "observable event or fact"]}, {"entity_id": "phenomenal", "book_id": "first_principles_spencer_1862", "name": "Phenomenal", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Phenomenal"], "contexts": ["distinguished from the Real"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "phenomenon", "target_book": "first_principles_spencer_1862", "target_name": "phenomenon", "similarity": 1.0}, {"source_book": "princip