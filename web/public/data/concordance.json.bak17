 ["hysteric subjects"], "contexts": ["subjects experimented on by M. Janet"]}, {"entity_id": "hysteric_crisis", "book_id": "principles_of_psychology_james_1890", "name": "hysteric crisis", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["hysteric crisis"], "contexts": ["episode of psychological distress"]}, {"entity_id": "mulheres_hystericas", "book_id": "polyanthea_medicinal", "name": "mulheres hystericas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 5, "variants": ["mulheres hystericas", "hysterica"], "contexts": ["hysterical women patients", "female condition"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "hysterics", "target_book": "polyanthea_medicinal", "target_name": "mulheres hystericas", "similarity": 0.905}, {"source_book": "principles_of_psychology_james_1890", "source_name": "hysteric patient", "target_book": "polyanthea_medicinal", "target_name": "mulheres hystericas", "similarity": 0.883}, {"source_book": "principles_of_psychology_james_1890", "source_name": "hysteric subjects", "target_book": "polyanthea_medicinal", "target_name": "mulheres hystericas", "similarity": 0.89}, {"source_book": "principles_of_psychology_james_1890", "source_name": "hysteric crisis", "target_book": "polyanthea_medicinal", "target_name": "mulheres hystericas", "similarity": 0.899}], "id": 1996, "stable_key": "clu_685f51491a9f1059", "ground_truth": {"modern_name": "Hysteria", "confidence": "high", "type": "disease", "description": "A historical medical diagnosis for a range of psychological and physical symptoms in women.", "note": "A historical medical term encompassing a variety of psychological and physical symptoms, particularly in women.", "wikipedia_extract": "Hysteria is a term used to mean ungovernable emotional excess and can refer to a temporary state of mind or emotion. In the nineteenth century, female hysteria was considered a diagnosable physical illness in women. It is assumed that the basis for diagnosis operated under the belief that women are predisposed to mental and behavioral conditions; an interpretation of sex-related differences in stress responses. In the twentieth century, it shifted to being considered a mental illness. Influential physicians the likes of Sigmund Freud and Jean-Martin Charcot had dedicated research to hysteria patients. Currently, most physicians do not accept hysteria as a medical diagnosis."}, "cross_references": []}, {"canonical_name": "Unknowable", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "unknowable", "book_id": "principles_of_psychology_james_1890", "name": "Unknowable", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Unknowable"], "contexts": ["principle for perplexities", "philosophical concept of the unknowable entity"]}, {"entity_id": "unknown", "book_id": "principles_of_psychology_james_1890", "name": "unknown", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["unknown"], "contexts": ["that which is not known"]}, {"entity_id": "unknowable", "book_id": "first_principles_spencer_1862", "name": "Unknowable", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["Unknowable"], "contexts": ["philosophical concept of what cannot be known", "that which cannot be understood"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Unknowable", "target_book": "first_principles_spencer_1862", "target_name": "Unknowable", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "unknown", "target_book": "first_principles_spencer_1862", "target_name": "Unknowable", "similarity": 0.934}], "id": 1997, "stable_key": "clu_9615db5446b6b51c", "ground_truth": {"modern_name": "Unknowable", "confidence": "high", "type": "concept", "wikidata_id": "Q61834404", "wikidata_description": "article by Richard Elwes published August 2010 in New Scientist"}, "cross_references": [{"found_name": "Inconceivable", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3572, "target_cluster_name": "inconceivable", "source_book": "llm_generated", "evidence_snippet": "The term 'Unknowable' directly relates to the concept of 'Inconceivable' as that which cannot be conceived or grasped by the mind.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The term 'Unknowable' directly relates to the concept of 'Inconceivable' as that which cannot be conceived or grasped by the mind."}]}, {"canonical_name": "palms", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "palms", "book_id": "kosmos_humboldt_1845", "name": "palms", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 9, "variants": ["palms"], "contexts": ["majestic tropical trees", "trees found in certain climates"]}, {"entity_id": "palms", "book_id": "connexion_physical_sciences_somerville_1858", "name": "palms", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["palms"], "contexts": ["tropical trees", "plants with one seed-lobe"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "palms", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "palms", "similarity": 1.0}], "id": 1998, "stable_key": "clu_ce01a32ad671e302", "ground_truth": {"modern_name": "Palm tree", "confidence": "high", "type": "plant", "family": "Arecaceae"}, "cross_references": [{"found_name": "palm", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1467, "target_cluster_name": "palm", "source_book": "llm_generated", "evidence_snippet": "The term 'palms' is used colloquially to refer to plants with a tree-like form within the Arecaceae family, which are also called palm trees.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: The term 'palms' is used colloquially to refer to plants with a tree-like form within the Arecaceae family, which are also called palm trees.", "is_reverse": true}]}, {"canonical_name": "winds", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "winds", "book_id": "kosmos_humboldt_1845", "name": "winds", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["winds"], "contexts": ["atmospheric movements", "movement of air"]}, {"entity_id": "winds", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Winds", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["winds", "Winds"], "contexts": ["movement of air", "extra-tropical"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "winds", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Winds", "similarity": 0.976}], "id": 1999, "stable_key": "clu_54f6abc9beb480e6", "ground_truth": {"modern_name": "Wind", "confidence": "high", "type": "concept"}, "cross_references": [{"found_name": "Atmospheric currents", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1184, "target_cluster_name": "atmospheric currents", "source_book": "llm_generated", "evidence_snippet": "Atmospheric currents are a specific type of wind, often discussed in relation to meteorological phenomena.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Atmospheric currents are a specific type of wind, often discussed in relation to meteorological phenomena."}, {"found_name": "Climate", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 613, "target_cluster_name": "climate", "source_book": "llm_generated", "evidence_snippet": "Climate is heavily influenced by prevailing wind patterns and their long-term behavior.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship":