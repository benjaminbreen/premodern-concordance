ion": "Hero of Homer's Odyssey, a classical literary figure.", "wikidata_id": "Q47231", "wikidata_description": "legendary Greek king of Ithaca"}, "cross_references": [{"found_name": "Orpheus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2666, "target_cluster_name": "Orpheus", "source_book": "llm_generated", "evidence_snippet": "Ulysses (Odysseus) is a central figure in Greek epic poetry, and his journey through the underworld, a place Orpheus famously visited, creates a thematic link.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Ulysses (Odysseus) is a central figure in Greek epic poetry, and his journey through the underworld, a place Orpheus famously visited, creates a thematic link.", "is_reverse": true}]}, {"canonical_name": "Apocalyps", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "apocalyps", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Apocalyps", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Apocalyps"], "contexts": ["mentioned in relation to gems", "biblical book"]}, {"entity_id": "apocalypse", "book_id": "coloquios_da_orta_1563", "name": "Apocalypse", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Apocalypse"], "contexts": ["text with accompanying commentaries"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Apocalyps", "target_book": "coloquios_da_orta_1563", "target_name": "Apocalypse", "similarity": 0.974}], "id": 3251, "stable_key": "clu_a115fdc3b612f6d2", "ground_truth": {"modern_name": "Apocalypse", "confidence": "high", "type": "concept", "note": "The term 'Apocalyps' is an archaic spelling of 'Apocalypse', referring to a religious or prophetic revelation."}, "cross_references": [{"found_name": "Evangelho", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1304, "target_cluster_name": "Evangelho", "source_book": "llm_generated", "evidence_snippet": "The Gospel of Thomas is a non-canonical text, often discussed in relation to canonical apocalyptic literature and its theological implications.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Gospel of Thomas is a non-canonical text, often discussed in relation to canonical apocalyptic literature and its theological implications.", "is_reverse": true}, {"found_name": "Apologue", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1396, "target_cluster_name": "Apologue", "source_book": "llm_generated", "evidence_snippet": "The term 'apology' derives from the Greek 'apologia' meaning 'speaking in defense'. The 'Apocalypse' (also from Greek) refers to a revelation or unveiling, often associated with divine pronouncements and prophetic visions, which can be seen as a form of 'speaking forth' or 'revealing' a truth, thus sharing a conceptual root in the act of communication or declaration, albeit with different specific meanings.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The term 'apology' derives from the Greek 'apologia' meaning 'speaking in defense'. The 'Apocalypse' (also from Greek) refers to a revelation or unveiling, often associated with divine pronouncements and prophetic visions, which can be seen as a form of 'speaking forth' or 'revealing' a truth, thus sharing a conceptual root in the act of communication or declaration, albeit with different specific meanings.", "is_reverse": true}]}, {"canonical_name": "Zeilan", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "zeilan", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Zeilan", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Zeilan"], "contexts": ["country of the King using Loadstone", "source of best cinnamon"]}, {"entity_id": "zeilan", "book_id": "ricettario_fiorentino_1597", "name": "Zeilan", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Zeilan"], "contexts": ["place where cassia originates"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Zeilan", "target_book": "ricettario_fiorentino_1597", "target_name": "Zeilan", "similarity": 0.895}], "id": 3252, "stable_key": "clu_857c3fa0a9bc420b", "ground_truth": {"modern_name": "Sri Lanka", "confidence": "high", "type": "place", "country": "Sri Lanka", "wikidata_id": "Q370239", "wikidata_description": "species of flowering plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Cinnamomum%20verum", "wikipedia_extract": "Sri Lanka, officially the Democratic Socialist Republic of Sri Lanka, formerly known as Ceylon, is an island country in South Asia. It is located in the Indian Ocean, southwest of the Bay of Bengal, and is separated from India by the Gulf of Mannar and the Palk Strait. Sri Lanka shares a maritime border with the Maldives to the southwest and India to the northwest, and lies across the Bay of Bengal from Bangladesh and Myanmar to the northeast and the Andaman and Nicobar Islands of India to the east. Its capital is Sri Jayawardenepura Kotte, while Colombo is its largest city and the political, financial and cultural centre. Sri Lanka's population is 22 million; with the Sinhalese people, who speak the Sinhala language, forming the vast majority—while Tamil is spoken by the large Tamil minority. Other long-established ethnic groups include the Moors, Indian Tamils, Burghers, Malays, Chinese, and Vedda."}, "cross_references": [{"found_name": "Ceylão", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1506, "target_cluster_name": "Ceylão", "source_book": "llm_generated", "evidence_snippet": "Ceylão is the historical Portuguese name for Sri Lanka.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "Ceylão is the historical Portuguese name for Sri Lanka."}, {"found_name": "Taprobana", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2498, "target_cluster_name": "Taprobana", "source_book": "llm_generated", "evidence_snippet": "Zeilan is a historical name for Sri Lanka.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: Zeilan is a historical name for Sri Lanka.", "is_reverse": true}, {"found_name": "Bay of Bengal", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4061, "target_cluster_name": "Mer du Bengal", "source_book": "llm_generated", "evidence_snippet": "Sri Lanka is located southwest of the Bay of Bengal.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Sri Lanka is located southwest of the Bay of Bengal."}, {"found_name": "India", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 17, "target_cluster_name": "India", "source_book": "llm_generated", "evidence_snippet": "Sri Lanka is separated from India by the Gulf of Mannar and the Palk Strait.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Sri Lanka is separated from India by the Gulf of Mannar and the Palk Strait."}, {"found_name": "Indian Ocean", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 362, "target_cluster_name": "Indian Ocean", "source_book": "llm_generated", "evidence_snippet": "Sri Lanka is an island country in the Indian Ocean.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Sri Lanka is an island country in the Indian Ocean."}]}, {"canonical_name": "Leeches", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "leeches", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Leeches", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Leeches"], "contexts": ["creatures causing blood effusion", "segmented annelid worms"]}, {"entity_id": "leech", "book_id": "english_physician_1652", "name": "Leech", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Leech"], "contexts": ["creature used for bloodletting"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Leeches", "target_book": "english_physician_1652", "target_name": "Leech", "similarity": 0.907}], "id": 3253, "stable_key": "clu_ec40a3da1fca6421", "ground_truth": {"modern_name": "Leech", "confidence": "medium", "type": "animal", "note": "The term 'Leaõ' is Portuguese for lion. However, the context 'creature used for bloodletting' strongly suggests a leech, which is a common medical practice. The dual meaning makes it ambiguous without further context.", "wikidata_id": "Q43012", "wikidata_description": "sovereign island country and city-state in maritime Southeast Asia", "wikipedia_extract": "The lion (Panthera leo) is a large cat of the genus Panthera, currently ranging only in Sub-Saharan Africa and India. It has a muscular, broad-chested body; a short, rounded head; round ears; and a dark, hairy tuft at the tip of its tail. It is sexually dimorphic; adult male lions are larger than females and have a prominent mane that which extends from the head to the shoulders and chest. The lion inhabits grasslands, savannahs, and shrublands. It is an apex and keystone predator, preying mostly on medium-sized and large ungulates. It is usually more diurnal than other wild cats, but when persecuted, it adapts to being active at night and at twilight.", "wikipedia_url": "https://en.wikipedia.org/wiki/Lion"}, "cross_references": []}, {"canonical_name": "Sponge", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "sponge", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Sponge", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Sponge"], "contexts": ["organism that swells in stomach", "porous marine organism"]}, {"entity_id": "sponge", "book_id": "first_principles_spencer_1862", "name": "sponge", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["sponge"], "contexts": ["aquatic invertebrate with porous body"]}, {"entity_id": "sponges", "book_id": "connexion_physical_sciences_somerville_1858", "name": "sponges", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["sponges"], "contexts": ["aquatic invertebrates"]}, {"entity_id": "sponges", "book_id": "first_principles_spencer_1862", "name": "sponges", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["sponges"], "contexts": ["marine invertebrates"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Sponge", "target_book": "first_principles_spencer_1862", "target_name": "sponge", "similarity": 0.799}], "id": 3254, "stable_key": "clu_64f7ecb494b2718f", "ground_truth": {"modern_name": "Sponge", "confidence": "high", "type": "animal", "note": "Refers to sponges as organisms, aquatic invertebrates, and marine invertebrates. One context mentions a sponge swelling in the stomach, possibly referring to a medicinal preparation or a misidentification.", "wikidata_id": "Q18960", "wikidata_description": "phylum of animals", "wikipedia_extract": "Sponges or sea sponges are primarily marine invertebrates of the animal phylum Porifera (; meaning 'pore bearer'). They are sessile filter feeders that are bound to the seabed, and are one of the most ancient members of macrobenthos, with many historical species being important reef-building organisms. Sponges are multicellular organisms consisting of jelly-like mesohyl sandwiched between two thin layers of cells, and usually have tube-like bodies full of pores and channels that allow water to circulate through them. They have unspecialized cells that can transform into other types and that often migrate between the main cell layers and the mesohyl in the process. They do not have complex nervous, digestive or circulatory systems. Instead, most rely on maintaining a constant water flow through their bodies to obtain food and oxygen and to remove wastes, usually via flagella movements of the so-called \"collar cells\".", "wikipedia_url": "https://en.wikipedia.org/wiki/Sponge"}, "member_count": 4, "cross_references": [{"found_name": "corals", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2830, "target_cluster_name": "corals", "source_book": "llm_generated", "evidence_snippet": "Sponges are simple multicellular marine animals. While not closely related taxonomically to corals (which are cnidarians), they share the characteristic of being sessile marine invertebrates and were often discussed together in early natural history texts as examples of simple animal life found in the sea.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Sponges are simple multicellular marine animals. While not closely related taxonomically to corals (which are cnidarians), they share the characteristic of being sessile marine invertebrates and were often discussed together in early natural history texts as examples of simple animal life found in the sea.", "is_reverse": true}]}, {"canonical_name": "Tiberius", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tiberius", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Tiberius", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Tiberius"], "contexts": ["emperor related to glass story", "wore laurel for protection"]}, {"entity_id": "tiberius", "book_id": "kosmos_humboldt_1845", "name": "Tiberius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Tiberius"], "contexts": ["Roman emperor during earthquake"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Tiberius", "target_book": "kosmos_humboldt_1845", "target_name": "Tiberius", "similarity": 0.829}], "id": 3255, "stable_key": "clu_8fb84748455ae028", "ground_truth": {"modern_name": "Tiberius", "confidence": "high", "type": "person", "birth_year": -42, "death_year": 37, "description": "Roman Emperor, associated with stories about glass and earthquakes.", "wikidata_id": "Q1407", "wikidata_description": "second Roman Emperor from 14 to 37 AD"}, "cross_references": []}, {"canonical_name": "Saphire", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "saphire", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Saphire", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Saphire"], "contexts": ["emits effluvium without diminution of weight", "stone preservative against inchantments"]}, {"entity_id": "sapphirus", "book_id": "polyanthea_medicinal", "name": "Sapphirus", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Sapphirus"], "contexts": ["blue stone with virtue against carbuncles"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Saphire", "target_book": "polyanthea_medicinal", "target_name": "Sapphirus", "similarity": 0.939}], "id": 3256, "stable_key": "clu_44d72d1e9d547fd9", "ground_truth": {"modern_name": "Sapphire", "confidence": "high", "type": "mineral", "note": "The spelling 'Saphire' is an archaic variation."}, "cross_references": []}, {"canonical_name": "Tinder", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tinder", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Tinder", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Tinder"], "contexts": ["material for lighting fires", "material for igniting gunpowder"]}, {"entity_id": "tinder", "book_id": "connexion_physical_sciences_somerville_1858", "name": "tinder", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["tinder"], "contexts": ["material ignited by compression"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Tinder", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "tinder", "similarity": 0.902}], "id": 3257, "stable_key": "clu_511fcd3bf60cc2f7", "ground_truth": {"modern_name": "Tinder", "confidence": "high", "type": "substance", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_extract": "Fire making, fire lighting or fire craft is the process of artificially starting a fire. It requires completing the fire triangle, usually by heating tinder above its autoignition temperature. Fire is an essential tool for human survival and the use of fire was important in early human cultural history since the Lower Paleolithic. Today, it is a key component of Scouting, woodcraft and bushcraft. The earliest evidence for fire-making dates to about 400,000 years ago at a Neanderthal site in eastern England where burnt soil was found along with fire-cracked flint handaxes and two fragments of iron pyrite, used to strike sparks with flint. The next oldest evidence comes from around 50,000 years ago and later, when evidence for fire making can be found in dozens of Neanderthal hand axes from France exhibiting use-wear traces suggesting these tools were struck with the mineral pyrite to produce sparks.", "wikipedia_url": "https://en.wikipedia.org/wiki/Fire_making"}, "cross_references": []}, {"canonical_name": "Gesner", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "gesner", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Gesner", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Gesner"], "contexts": ["described a stony plant", "names a plant"]}, {"entity_id": "gesner", "book_id": "english_physician_1652", "name": "Gesner", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Gesner"], "contexts": ["Renaissance naturalist"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Gesner", "target_book": "english_physician_1652", "target_name": "Gesner", "similarity": 1.0}], "id": 3258, "stable_key": "clu_0e405ae6617de52e", "ground_truth": {"modern_name": "Conrad Gessner", "confidence": "high", "type": "person", "birth_year": 1516, "death_year": 1565, "description": "Swiss physician and naturalist, known for his encyclopedic works."}, "cross_references": [{"found_name": "Aldrovandus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2256, "target_cluster_name": "Aldrovandus", "source_book": "llm_generated", "evidence_snippet": "Both were prominent naturalists and collectors in the 16th century, with Aldrovandi being a significant influence on Gessner's work.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were prominent naturalists and collectors in the 16th century, with Aldrovandi being a significant influence on Gessner's work.", "is_reverse": true}, {"found_name": "Dodon", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2273, "target_cluster_name": "Dodon", "source_book": "llm_generated", "evidence_snippet": "Gessner was a highly influential naturalist and physician, and a key figure in the development of botany during the same period as Dodoens. They were part of the same intellectual tradition.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Gessner was a highly influential naturalist and physician, and a key figure in the development of botany during the same period as Dodoens. They were part of the same intellectual tradition.", "is_reverse": true}, {"found_name": "Mizaldus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2710, "target_cluster_name": "Mizaldus", "source_book": "llm_generated", "evidence_snippet": "Both were prominent naturalists and physicians of the Renaissance, known for their extensive writings on botany and medicine.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were prominent naturalists and physicians of the Renaissance, known for their extensive writings on botany and medicine.", "is_reverse": true}]}, {"canonical_name": "Aconite", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "aconite", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Aconite", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Aconite"], "contexts": ["poisonous plant"]}, {"entity_id": "aconitum", "book_id": "coloquios_da_orta_1563", "name": "Aconitum", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Aconitum"], "contexts": ["genus of a poisonous plant"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Aconite", "target_book": "coloquios_da_orta_1563", "target_name": "Aconitum", "similarity": 0.882}], "id": 3259, "stable_key": "clu_8c78f581e802e66a", "ground_truth": {"modern_name": "Aconitum", "confidence": "high", "type": "plant", "linnaean": "Aconitum", "family": "Ranunculaceae", "wikidata_id": "Q155904", "wikidata_description": "genus of flowering plants in the buttercup family Ranunculaceae", "wikipedia_url": "https://en.wikipedia.org/wiki/Aconitum", "wikipedia_extract": "Aconitum (), also known as aconite, monkshood, wolfsbane, leopard's bane, devil's helmet, or blue rocket, is a genus of over 250 species of flowering plants belonging to the family Ranunculaceae. These herbaceous, frequently toxic perennial plants are chiefly native to the mountainous parts of the Northern Hemisphere in North America, Europe, and Asia, growing in the moisture-retentive but well-draining soils of mountain meadows. Most Aconitum species are extremely poisonous and must be handled very carefully. Several Aconitum hybrids, such as the Arendsii form of Aconitum carmichaelii, have won gardening awards—such as the Royal Horticultural Society's Award of Garden Merit. The name aconitum comes from the Greek word ἀκόνιτον, which may derive from the Greek akon for dart or javelin, the tips of which were poisoned with the substance, or from akonae, because of the rocky ground on which the plant was thought to grow. The Greek name lycoctonum, which translates literally to \"wolf's bane\", is thought to indicate the use of its juice to poison arrows or baits used to kill wolves."}, "cross_references": []}, {"canonical_name": "Mandrake", "category": "PLANT", "subcategory": "ROOT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "mandrake", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Mandrake", "category": "PLANT", "subcategory": "ROOT", "count": 2, "variants": ["Mandrake"], "contexts": ["plant root", "root representing mankind"]}, {"entity_id": "mandrake", "book_id": "english_physician_1652", "name": "Mandrake", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Mandrake"], "contexts": ["herb with narcotic properties"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mandrake", "target_book": "english_physician_1652", "target_name": "Mandrake", "similarity": 0.836}], "id": 3260, "stable_key": "clu_3f9c1b79d8c26477", "ground_truth": {"modern_name": "Mandrake", "confidence": "high", "type": "plant", "linnaean": "Mandragora officinarum", "family": "Solanaceae", "wikidata_id": "Q2651366", "wikidata_description": "plant root", "wikipedia_url": "https://en.wikipedia.org/wiki/Mandragora_officinarum", "wikipedia_extract": "Mandragora officinarum is the type species of the plant genus Mandragora in the nightshade family Solanaceae. It is often known as mandrake, although this name is also used for other plants. As of 2015, sources differed significantly in the species they use for Mandragora plants native to the Mediterranean region. The main species found around the Mediterranean is called Mandragora autumnalis, the autumn mandrake. In a broader circumscription, all the plants native to the regions around the Mediterranean Sea are placed in M. officinarum, which thus includes M."}, "cross_references": []}, {"canonical_name": "worms", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "worms", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "worms", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Worms", "worms"], "contexts": ["invertebrate animals", "invertebrate creatures"]}, {"entity_id": "worm", "book_id": "principles_of_psychology_james_1890", "name": "worm", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["worm"], "contexts": ["contrasts suffering self with universe"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "worms", "target_book": "principles_of_psychology_james_1890", "target_name": "worm", "similarity": 0.961}], "id": 3261, "stable_key": "clu_d7d19b3a62fdbace", "ground_truth": {"modern_name": "Worms", "confidence": "high", "type": "animal", "note": "In early modern texts, 'worms' could refer to parasitic organisms within the body or to various invertebrate animals such as annelids or even insect larvae. Given the context of 'contrasts suffering self with universe', it's likely referring to both parasitic and free-living invertebrates, encompassing a broad category.", "wikidata_id": "Q47253", "wikidata_description": "any animal with a long, pipe-like body and no limbs"}, "cross_references": [{"found_name": "lombrichi", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2638, "target_cluster_name": "lombrichi", "source_book": "llm_generated", "evidence_snippet": "Earthworms are a specific type of worm.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Earthworms are a specific type of worm.", "is_reverse": true}, {"found_name": "flies", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2679, "target_cluster_name": "flies", "source_book": "llm_generated", "evidence_snippet": "While distinct, some larval forms of flies (maggots) were historically sometimes referred to or grouped with 'worms' due to their appearance and habitat.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: While distinct, some larval forms of flies (maggots) were historically sometimes referred to or grouped with 'worms' due to their appearance and habitat.", "is_reverse": true}]}, {"canonical_name": "Cock", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "cock", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Cock", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["Cock"], "contexts": ["bird with a comb", "male chicken"]}, {"entity_id": "cock", "book_id": "origin_of_species_darwin_1859", "name": "cock", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["cock"], "contexts": ["example of male weapon importance"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Cock", "target_book": "origin_of_species_darwin_1859", "target_name": "cock", "similarity": 0.908}], "id": 3262, "stable_key": "clu_bc2fcaedf8539407", "ground_truth": {"modern_name": "Rooster", "confidence": "high", "type": "animal", "wikidata_id": "Q688973", "wikidata_description": "heraldic animal"}, "cross_references": [{"found_name": "Ovum Centeninum", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "pseudodoxia_epidemica_browne_1646", "evidence_snippet": "which are termed Cocks eggs. [SN: Ovum Centeninum, _or the last egg which is a very little one._] It is not indeed impossible that from the sperm of a Cock, Hen, or other Animal, being once in putresc", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "alternative name for 'Cocks eggs'"}]}, {"canonical_name": "Incubation", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "incubation", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Incubation", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["incubation", "Incubation"], "contexts": ["process of hatching eggs"]}, {"entity_id": "incubation", "book_id": "first_principles_spencer_1862", "name": "incubation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["incubation"], "contexts": ["process exhibiting force connection"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Incubation", "target_book": "first_principles_spencer_1862", "target_name": "incubation", "similarity": 0.973}], "id": 3263, "stable_key": "clu_69902eba99f36138", "ground_truth": {"modern_name": "Incubation", "confidence": "high", "type": "concept", "note": "The term 'incubation' in early modern texts could refer to the process of egg hatching or, more broadly, to a period of development or gestation, including for diseases or ideas.", "wikidata_id": "Q12823380", "wikidata_description": "developmental process of animals (birds, fish, reptiles, monotremes etc.) from eggs"}, "cross_references": []}, {"canonical_name": "English", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "english", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "English", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["English"], "contexts": ["language of the people"]}, {"entity_id": "english", "book_id": "first_principles_spencer_1862", "name": "English", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["English"], "contexts": ["modern language form", "language with inflexions lost by contraction"]}, {"entity_id": "english_tongue", "book_id": "english_physician_1652", "name": "English Tongue", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["English Tongue"], "contexts": ["written so much of it in the English Tongue", "language used for writing"]}, {"entity_id": "english_language", "book_id": "first_principles_spencer_1862", "name": "English language", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["English language"], "contexts": ["specific language with complex subdivisions"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "English", "target_book": "first_principles_spencer_1862", "target_name": "English", "similarity": 1.0}], "id": 3264, "stable_key": "clu_6fbb9a623ca52655", "ground_truth": {"modern_name": "English language", "confidence": "high", "type": "concept", "note": "Refers to the English language as a linguistic and cultural entity.", "wikidata_id": "Q1860", "wikidata_description": "West Germanic language", "wikipedia_url": "https://en.wikipedia.org/wiki/English%20language", "wikipedia_extract": "English is a West Germanic language that emerged in early medieval England and has since become a global lingua franca. The namesake of the language is the Angles, one of the Germanic peoples who migrated to Britain after the end of Roman rule. English is the most spoken language in the world, primarily due to the global influences of the former British Empire (succeeded by the Commonwealth of Nations) and the United States. It is the most widely learned second language in the world, with more second-language speakers than native speakers. However, English is only the third-most spoken native language, after Mandarin Chinese and Spanish. English is either the official language, or one of the official languages, in 57 sovereign states and 30 dependent territories, making it the most geographically widespread language in the world."}, "member_count": 4, "cross_references": [{"found_name": "language", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 294, "target_cluster_name": "language", "source_book": "llm_generated", "evidence_snippet": "This is a specific instance of the broader concept of language.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: This is a specific instance of the broader concept of language.", "is_reverse": true}, {"found_name": "Latina", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1122, "target_cluster_name": "Latina", "source_book": "llm_generated", "evidence_snippet": "The English language evolved significantly from its Old English roots, incorporating vast amounts of Latin and French (derived from Latin) vocabulary and grammatical structures.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The English language evolved significantly from its Old English roots, incorporating vast amounts of Latin and French (derived from Latin) vocabulary and grammatical structures.", "is_reverse": true}, {"found_name": "translation", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1136, "target_cluster_name": "translation", "source_book": "llm_generated", "evidence_snippet": "The entity 'translation' is defined in relation to source and target languages, and 'English language' is an example of such a language.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The entity 'translation' is defined in relation to source and target languages, and 'English language' is an example of such a language.", "is_reverse": true}]}, {"canonical_name": "sensibilities", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "sensuality", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Sensuality", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Sensuality"], "contexts": ["indulgence of physical desires"]}, {"entity_id": "sensibilities", "book_id": "principles_of_psychology_james_1890", "name": "sensibilities", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["sensibilities"], "contexts": ["capacity to feel or perceive"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Sensuality", "target_book": "principles_of_psychology_james_1890", "target_name": "sensibilities", "similarity": 0.922}], "id": 3265, "stable_key": "clu_4a3b4a28461959d9", "ground_truth": {"modern_name": "Sensibility", "confidence": "high", "type": "concept", "note": "Refers to the capacity to feel, perceive, or experience emotions and sensations, often with connotations of refinement or susceptibility.", "wikidata_id": "Q1195509", "wikidata_description": "acute perception of or responsiveness toward something, such as the emotions of another"}, "cross_references": []}, {"canonical_name": "Tree of Life", "category": "PLANT", "subcategory": "TREE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tree_of_life", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Tree of life", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Tree of life"], "contexts": ["biblical tree granting immortality"]}, {"entity_id": "tree_of_life", "book_id": "origin_of_species_darwin_1859", "name": "Tree of Life", "category": "PLANT", "subcategory": "TREE", "count": 2, "variants": ["Tree of Life"], "contexts": ["metaphor for evolutionary relationships", "metaphorical tree representing life's diversity"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Tree of life", "target_book": "origin_of_species_darwin_1859", "target_name": "Tree of Life", "similarity": 0.857}], "id": 3266, "stable_key": "clu_8beee57bca63e7cc", "ground_truth": {"modern_name": "Tree of Life", "confidence": "high", "type": "concept", "note": "Refers to both the biblical concept and Darwin's metaphorical use for evolutionary relationships. In early modern biology, it could also refer to specific symbolic plants or genera.", "wikidata_id": "Q2051175", "wikidata_description": "species of plant"}, "cross_references": []}, {"canonical_name": "petitio principii", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "petitio_principii", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Petitio principii", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Petitio principii"], "contexts": ["logical fallacy of assuming the premise"]}, {"entity_id": "petitio_principii", "book_id": "first_principles_spencer_1862", "name": "petitio principii", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["petitio principii"], "contexts": ["logical fallacy of assuming the conclusion"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Petitio principii", "target_book": "first_principles_spencer_1862", "target_name": "petitio principii", "similarity": 0.983}], "id": 3267, "stable_key": "clu_adaac01f2891b031", "ground_truth": {"modern_name": "Begging the question", "confidence": "high", "type": "concept", "wikidata_id": "Q219429", "wikidata_description": "type of fallacy, where a proposition is assumed as a premise, which itself needs a proof and directly entails the conclusion", "wikipedia_url": "https://en.wikipedia.org/wiki/Begging%20the%20question", "wikipedia_extract": "In classical rhetoric and logic, begging the question or assuming the conclusion (Latin: petītiō principiī) is an informal fallacy that occurs when an argument's premises assume the truth of the conclusion. Historically, begging the question refers to a fault in a dialectical argument in which the speaker assumes some premise that has not been demonstrated to be true. In modern usage, it has come to refer to an argument in which the premises assume the conclusion without supporting it. This makes it an example of circular reasoning. “Wool sweaters are better than nylon jackets as fall attire because wool sweaters have higher wool content\". The claim here is that wool sweaters are better than nylon jackets as fall attire."}, "cross_references": []}, {"canonical_name": "Citron", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "citron", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Citron", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Citron"], "contexts": ["smell believed to cause generation in Heaven"]}, {"entity_id": "citron", "book_id": "english_physician_1652", "name": "Citron", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Citron", "Citrons"], "contexts": ["seed to balance coldness", "bark used for preserving"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Citron", "target_book": "english_physician_1652", "target_name": "Citron", "similarity": 1.0}], "id": 3268, "stable_key": "clu_59f01bee901af4a9", "ground_truth": {"modern_name": "Citron", "confidence": "high", "type": "plant", "linnaean": "Citrus medica Linnaeus", "family": "Rutaceae", "wikidata_id": "Q150064", "wikidata_description": "species of citrus plant"}, "cross_references": [{"found_name": "limon", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1314, "target_cluster_name": "limon", "source_book": "llm_generated", "evidence_snippet": "Citron is a closely related citrus fruit, often grouped with lemons and limes in historical botanical and medicinal texts due to shared characteristics and uses.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Citron is a closely related citrus fruit, often grouped with lemons and limes in historical botanical and medicinal texts due to shared characteristics and uses.", "is_reverse": true}]}, {"canonical_name": "Divine Wisdom", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "wisdom_of_god", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Wisdom of God", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Wisdom of God"], "contexts": ["divine understanding and order"]}, {"entity_id": "divine_wisdom", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Divine Wisdom", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Divine Wisdom"], "contexts": ["creator's selection of laws", "attributed with selecting laws of nature"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Wisdom of God", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Divine Wisdom", "similarity": 0.947}], "id": 3269, "stable_key": "clu_fb447b466b09e35e", "ground_truth": {"modern_name": "Divine wisdom", "confidence": "high", "type": "concept", "wikidata_id": "Q106859960", "wikidata_description": "painting by Unidentified Artist"}, "cross_references": [{"found_name": "creation", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 12, "target_cluster_name": "creation", "source_book": "llm_generated", "evidence_snippet": "Creationism is a religious belief centered on divine acts of creation, and divine wisdom is a concept closely associated with the nature and intent of a creator.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Creationism is a religious belief centered on divine acts of creation, and divine wisdom is a concept closely associated with the nature and intent of a creator.", "is_reverse": true}, {"found_name": "Theology", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 512, "target_cluster_name": "Theology", "source_book": "llm_generated", "evidence_snippet": "Theology is the study of divinity and often explores divine wisdom.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Theology is the study of divinity and often explores divine wisdom.", "is_reverse": true}, {"found_name": "vertue", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2161, "target_cluster_name": "vertue", "source_book": "llm_generated", "evidence_snippet": "Divine wisdom is often associated with the ultimate source of virtue and moral guidance.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Divine wisdom is often associated with the ultimate source of virtue and moral guidance.", "is_reverse": true}, {"found_name": "Divinity", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2345, "target_cluster_name": "Divinity", "source_book": "llm_generated", "evidence_snippet": "Divine wisdom is a specific attribute or manifestation of Divinity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Divine wisdom is a specific attribute or manifestation of Divinity.", "is_reverse": true}]}, {"canonical_name": "foxes", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "foxes", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Foxes", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Foxes"], "contexts": ["vulpine animals"]}, {"entity_id": "foxes", "book_id": "origin_of_species_darwin_1859", "name": "foxes", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["foxes"], "contexts": ["wild canid species", "wild canids"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Foxes", "target_book": "origin_of_species_darwin_1859", "target_name": "foxes", "similarity": 0.896}], "id": 3270, "stable_key": "clu_f78c0ebe565ca6b8", "ground_truth": {"modern_name": "Fox", "confidence": "high", "type": "animal", "wikidata_id": "Q8332", "wikidata_description": "species of mammal", "wikipedia_url": "https://en.wikipedia.org/wiki/Red%20fox", "wikipedia_extract": "The red fox (Vulpes vulpes) is the largest of the true foxes and one of the most widely distributed members of the order Carnivora. It is present across the entire Northern Hemisphere, including most of North America, Europe and Asia, as well as parts of North Africa. Its range has expanded alongside human settlement, with the species having been introduced to Australia, where it preys on native small and medium-sized rodents and marsupials. The red fox is listed as of least concern on the IUCN Red List. Because of its impact on native species, it is also included on the list of the \"world's 100 worst invasive species\". The red fox originated in Eurasia during the Middle Pleistocene at least 400,000 years ago and later colonised North America sometime prior to 130,000 years ago."}, "cross_references": [{"found_name": "Wolf", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1969, "target_cluster_name": "Wolf", "source_book": "llm_generated", "evidence_snippet": "Wolves and foxes are both canids and often appear together in discussions of wild animals, hunting, and folklore.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Wolves and foxes are both canids and often appear together in discussions of wild animals, hunting, and folklore.", "is_reverse": true}]}, {"canonical_name": "Compoſitione medicamentorum", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "de_compositione_medicamentorum", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "De Compositione Medicamentorum", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["De Compositione Medicamentorum"], "contexts": ["work by Scribonius Largus"]}, {"entity_id": "compoſitione_medicamentorum", "book_id": "polyanthea_medicinal", "name": "Compoſitione medicamentorum", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["Compoſitione medicamentorum", "Compofitione medicamentorum"], "contexts": ["composition of medicines"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "De Compositione Medicamentorum", "target_book": "polyanthea_medicinal", "target_name": "Compoſitione medicamentorum", "similarity": 0.899}], "id": 3271, "stable_key": "clu_9f694a3cc27ad580", "ground_truth": {"modern_name": "Composition of Medicines", "confidence": "high", "type": "text", "note": "This refers to a classical medical text on the preparation of remedies.", "wikidata_id": "Q543881", "wikidata_description": "Byzantine compendium on medical science"}, "cross_references": []}, {"canonical_name": "Memphis", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "memphis", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Memphis", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Memphis"], "contexts": ["ancient Egyptian city"]}, {"entity_id": "memphis", "book_id": "coloquios_da_orta_1563", "name": "Memphis", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Memphis"], "contexts": ["celebre city, debated location", "city"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Memphis", "target_book": "coloquios_da_orta_1563", "target_name": "Memphis", "similarity": 1.0}], "id": 3272, "stable_key": "clu_791f81929c365d60", "ground_truth": {"modern_name": "Memphis", "confidence": "high", "type": "place", "country": "Egypt", "wikidata_id": "Q5715", "wikidata_description": "ancient capital of Inebu-hedj, Egypt"}, "cross_references": []}, {"canonical_name": "Thales", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "thales", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Thales", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Thales"], "contexts": ["ancient Greek philosopher"]}, {"entity_id": "thales", "book_id": "kosmos_humboldt_1845", "name": "Thales", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Thales"], "contexts": ["ancient philosopher", "Ancient Greek philosopher, founder of Ionic natural philosophy"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Thales", "target_book": "kosmos_humboldt_1845", "target_name": "Thales", "similarity": 1.0}], "id": 3273, "stable_key": "clu_83744f614d086d4b", "ground_truth": {"modern_name": "Thales", "confidence": "high", "type": "person", "birth_year": -624, "death_year": -546, "description": "Ancient Greek philosopher and one of the Seven Sages of Greece.", "wikipedia_extract": "Thales of Miletus ( THAY-leez; Ancient Greek: Θαλῆς; c. 626/623  – c. 548/545 BC) was an Ancient Greek pre-Socratic philosopher from Miletus in Ionia, Asia Minor. Thales was one of the Seven Sages, founding figures of Ancient Greece. Beginning in eighteenth-century historiography, many came to regard him as the first philosopher in the Greek tradition, breaking from the prior use of mythology to explain the world and instead using natural philosophy. He is thus otherwise referred to as the first to have engaged in mathematics, science, and deductive reasoning.", "wikipedia_url": "https://en.wikipedia.org/wiki/Thales_of_Miletus"}, "cross_references": []}, {"canonical_name": "agnus castus", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "agnus_castus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Agnus Castus", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Agnus Castus"], "contexts": ["plant name, synonym for Vitex"]}, {"entity_id": "agnus_castus", "book_id": "coloquios_da_orta_1563", "name": "agnus castus", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["agnus castus", "agno casto"], "contexts": ["plant that weakens Venus's influence", "herb"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Agnus Castus", "target_book": "coloquios_da_orta_1563", "target_name": "agnus castus", "similarity": 0.926}], "id": 3274, "stable_key": "clu_3b53b908937b1dbf", "ground_truth": {"modern_name": "Chaste tree", "confidence": "high", "type": "plant", "linnaean": "Vitex agnus-castus L.", "family": "Verbenaceae", "wikipedia_extract": "Vitex is a genus of flowering plants in the family Lamiaceae. It has about 200–250 species; as of August 2025 the Plants of the World Online database accepts 211 species. Common names include chaste tree or chastetree, traditionally referring to V. agnus-castus, but often applied to other species, as well, and pūriri for the New Zealand species V. lucens. Species of Vitex are native throughout the tropics and subtropics, with a few species in warm-temperate Eurasia and one in New Zealand.", "wikipedia_url": "https://en.wikipedia.org/wiki/Vitex"}, "cross_references": [{"found_name": "Vitex", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2930, "target_cluster_name": "Vitex", "source_book": "llm_generated", "evidence_snippet": "A common historical synonym for Chaste tree, often used in botanical and medicinal texts.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: A common historical synonym for Chaste tree, often used in botanical and medicinal texts.", "is_reverse": true}]}, {"canonical_name": "melancholic", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "melancholly", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "melancholly", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["melancholly"], "contexts": ["a state of low spirits or depression"]}, {"entity_id": "melancholic", "book_id": "principles_of_psychology_james_1890", "name": "melancholic", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["melancholic"], "contexts": ["alteration particularly of a melancholic sort", "type of emotional alteration"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "melancholly", "target_book": "principles_of_psychology_james_1890", "target_name": "melancholic", "similarity": 0.968}], "id": 3275, "stable_key": "clu_62d1a3c18415a8e5-2", "ground_truth": {"modern_name": "Melancholy", "confidence": "high", "type": "disease", "description": "A state of prolonged sadness, low spirits, or humors.", "note": "Historically linked to the 'melancholic humor'.", "wikipedia_extract": "Melancholia or melancholy (Ancient Greek: μελαγχολία, romanized: melancholía; from μέλαινα χολή, mélaina cholḗ, 'black bile') is a concept found throughout ancient, medieval, and premodern medicine in Europe that describes a condition characterized by markedly depressed mood, bodily complaints, and sometimes hallucinations and delusions. Besides a pathological condition, melancholy could also refer to a mood or temperament and at times it was even used as a description of the human condition in general. Melancholy (or more precisely the 'black bile', from which melancholy derives its name) was regarded as one of the four temperaments matching the four humours. Until the 18th century, doctors and other scholars classified melancholic conditions as such by their perceived common cause – an excess of a notional fluid known as \"black bile\", which was commonly linked to the spleen. Hippocrates and other ancient physicians described melancholia as a distinct disease with mental and physical symptoms, including persistent fears and despondencies, poor appetite, abulia, sleeplessness, irritability, and agitation. Later, fixed delusions were added by Galen and other physicians to the list of symptoms."}, "cross_references": [{"found_name": "Mania", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1323, "target_cluster_name": "Madness", "source_book": "llm_generated", "evidence_snippet": "Historically, melancholy was often seen as one pole of a spectrum that included mania. The concept of 'bipolar disorder' (though not termed as such historically) often involved alternating states of depression (melancholy) and mania.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Historically, melancholy was often seen as one pole of a spectrum that included mania. The concept of 'bipolar disorder' (though not termed as such historically) often involved alternating states of depression (melancholy) and mania."}, {"found_name": "Grief", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1325, "target_cluster_name": "grief", "source_book": "llm_generated", "evidence_snippet": "Grief is a natural emotional response to loss, and prolonged or excessive grief could historically be considered a form of melancholy or lead to it. The two are closely linked in terms of emotional experience and potential progression.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Grief is a natural emotional response to loss, and prolonged or excessive grief could historically be considered a form of melancholy or lead to it. The two are closely linked in terms of emotional experience and potential progression."}, {"found_name": "Ephi-\naltes", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "english_physician_1652", "evidence_snippet": "effectual for such as in their sleep are troubled with the Diseas called Ephi∣altes or Incubus, but we do commonly cal it the Night-Mare; a diseas which Melancholly persons are subject unto; It is als", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for the Night-Mare"}, {"found_name": "Incubus", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "english_physician_1652", "evidence_snippet": "effectual for such as in their sleep are troubled with the Diseas called Ephi∣altes or Incubus, but we do commonly cal it the Night-Mare; a diseas which Melancholly persons are subject unto; It is als", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for the Night-Mare"}]}, {"canonical_name": "Saturno", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "saturn", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Saturn", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Saturn"], "contexts": ["Roman god"]}, {"entity_id": "saturno", "book_id": "historia_medicinal_monardes_1574", "name": "Saturno", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Saturno"], "contexts": ["planet influencing disease", "planetary influence on disease"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Saturn", "target_book": "historia_medicinal_monardes_1574", "target_name": "Saturno", "similarity": 0.988}], "id": 3276, "stable_key": "clu_4980c2e5d63a508c", "ground_truth": {"modern_name": "Saturn", "confidence": "high", "type": "person", "description": "Roman god of agriculture and time; also a planet.", "note": "Refers to both the Roman deity and the planet, which had astrological significance.", "wikipedia_extract": "Saturn is the sixth planet from the Sun and the second largest in the Solar System, after Jupiter. It is a gas giant, with an average radius of about 9 times that of Earth. It has an eighth of the average density of Earth, but is over 95 times more massive. Even though Saturn is almost as big as Jupiter, Saturn has less than a third of its mass. Saturn orbits the Sun at a distance of 9.59 AU (1,434 million km), with an orbital period of 29.45 years. Saturn's interior is thought to be composed of a rocky core, surrounded by a deep layer of metallic hydrogen, an intermediate layer of liquid hydrogen and liquid helium, and an outer layer of gas."}, "cross_references": []}, {"canonical_name": "Divisões", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "division", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "division", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["division"], "contexts": ["negative quality, from evil principle"]}, {"entity_id": "divisões", "book_id": "coloquios_da_orta_1563", "name": "Divisões", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Divisões"], "contexts": ["work by Rasis", "Division of the world by papal bull"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "division", "target_book": "coloquios_da_orta_1563", "target_name": "Divisões", "similarity": 0.884}], "id": 3277, "stable_key": "clu_b28aebf083327406", "ground_truth": {"modern_name": "Division", "confidence": "medium", "type": "concept", "note": "The context suggests a philosophical or medical concept of division, possibly related to classification or differentiation."}, "cross_references": [{"found_name": "faculty", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1299, "target_cluster_name": "faculty", "source_book": "llm_generated", "evidence_snippet": "A faculty is a type of division within a university structure, making 'Division' a closely related concept.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: A faculty is a type of division within a university structure, making 'Division' a closely related concept.", "is_reverse": true}]}, {"canonical_name": "Princes", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "princes", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Princes", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Princes"], "contexts": ["rulers with power over oracles"]}, {"entity_id": "princes", "book_id": "english_physician_1652", "name": "Princes", "category": "PERSON", "subcategory": "PATRON", "count": 2, "variants": ["Princes"], "contexts": ["supported Mathiolus' work", "supported the art"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Princes", "target_book": "english_physician_1652", "target_name": "Princes", "similarity": 1.0}], "id": 3278, "stable_key": "clu_1c025956fb17f454", "ground_truth": {"modern_name": "Patronage", "confidence": "high", "type": "concept", "note": "The context implies rulers or wealthy individuals who supported scholars and their work, rather than the individuals themselves.", "wikidata_id": "Q516590", "wikidata_description": "honorary person or organization that supports another organization or person or effort"}, "cross_references": []}, {"canonical_name": "Horse dung", "category": "SUBSTANCE", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "horse-dung", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "horse-dung", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 1, "variants": ["horse-dung"], "contexts": ["excrement from horses"]}, {"entity_id": "horse_dung", "book_id": "english_physician_1652", "name": "Horse dung", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Horse dung", "Horse-dung"], "contexts": ["bed for distilling medicine", "animal excrement used for compost"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "horse-dung", "target_book": "english_physician_1652", "target_name": "Horse dung", "similarity": 0.81}], "id": 3279, "stable_key": "clu_78dd18a1f1d621b0", "ground_truth": {"modern_name": "Horse dung", "confidence": "high", "type": "animal", "wikidata_id": "Q127549096", "wikidata_description": "scholarly article"}, "cross_references": [{"found_name": "venenos", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2363, "target_cluster_name": "venenos", "source_book": "llm_generated", "evidence_snippet": "Similar to dog feces, horse dung was sometimes associated with medicinal or toxic properties in historical texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Similar to dog feces, horse dung was sometimes associated with medicinal or toxic properties in historical texts.", "is_reverse": true}]}, {"canonical_name": "Pots", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tongs", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Tongs", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Tongs"], "contexts": ["culinary utensil acquiring magnetism"]}, {"entity_id": "pots", "book_id": "english_physician_1652", "name": "Pots", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Pots"], "contexts": ["used to keep lohochs", "containers for ointments"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Tongs", "target_book": "english_physician_1652", "target_name": "Pots", "similarity": 0.911}], "id": 3280, "stable_key": "clu_07762b7b310c3712", "ground_truth": {"modern_name": "Pots", "confidence": "medium", "type": "object", "note": "The term 'Tongs' in the context of acquiring magnetism and 'Pots' for keeping lohochs suggests a variety of containers or tools, with 'pots' being the more general and likely referent when combined with the 'lohochs' context. However, the inclusion of 'tongs' makes the precise object ambiguous."}, "cross_references": [{"found_name": "flask", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 125, "target_cluster_name": "flask", "source_book": "llm_generated", "evidence_snippet": "Pots are containers, often made of ceramic, that share functional similarities with flasks in storing and holding substances.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Pots are containers, often made of ceramic, that share functional similarities with flasks in storing and holding substances.", "is_reverse": true}, {"found_name": "bagno Maria", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 953, "target_cluster_name": "bagno Maria", "source_book": "llm_generated", "evidence_snippet": "Pots are often used within a bain-marie to hold substances being heated.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Pots are often used within a bain-marie to hold substances being heated.", "is_reverse": true}, {"found_name": "alambicco", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1192, "target_cluster_name": "alambicco", "source_book": "llm_generated", "evidence_snippet": "General term for vessels, which would include the components of an alembic.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: General term for vessels, which would include the components of an alembic.", "is_reverse": true}]}, {"canonical_name": "Levinus Lemnius", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "levinus_lemnius", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Levinus Lemnius", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Levinus Lemnius"], "contexts": ["believed in antiquity of compass knowledge"]}, {"entity_id": "levinus_lemnius", "book_id": "polyanthea_medicinal", "name": "Levinus Lemnius", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Levinus Lemnius"], "contexts": ["early modern scholar", "Levinus Lemniusde Occultis natura miraculis"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Levinus Lemnius", "target_book": "polyanthea_medicinal", "target_name": "Levinus Lemnius", "similarity": 1.0}], "id": 3281, "stable_key": "clu_4132dd2ed9f57fa6", "ground_truth": {"modern_name": "Levinus Lemnius", "confidence": "high", "type": "person", "birth_year": 1506, "death_year": 1568, "description": "Dutch physician and humanist, known for his writings on natural philosophy.", "wikidata_id": "Q3237230", "wikidata_description": "Dutch writer (1505-1568)", "wikipedia_url": "https://en.wikipedia.org/wiki/Levinus%20Lemnius", "wikipedia_extract": "Levinus Lemnius  (20 May 1505 in Zierikzee – 1 July 1568 in Zierikzee) was a Dutch physician and author. Lemnius studied medicine at the University of Leuven under Rembert Dodoens and Konrad Gesner; and under Vesalius at Padua. He also travelled to Switzerland and England. After his wife's death, he became a priest. Occulta naturae miracula (1559, Antwerp) by the University and State Library Düsseldorf) This was translated as De gli occvlti miracoli, Les Occultes Merveilles et Secretz de Nature (online text, The secret miracles of nature, and Wunderbarliche Geheimnisse der Natur online text). De habitu et constitutione corporis (1561, Antwerp)."}, "cross_references": []}, {"canonical_name": "steel magnet", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "magnetem", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "magnetem", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["magnetem"], "contexts": ["Latin for magnet"]}, {"entity_id": "steel_magnet", "book_id": "connexion_physical_sciences_somerville_1858", "name": "steel magnet", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["steel magnet"], "contexts": ["stationary magnet made of steel", "material used for magnets"]}, {"entity_id": "magnete", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Magnete", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Magnete"], "contexts": ["re-impregnated by the Earth"]}, {"entity_id": "magneta", "book_id": "coloquios_da_orta_1563", "name": "magneta", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["magneta"], "contexts": ["magnetite"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "magnetem", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "steel magnet", "similarity": 0.903}], "id": 3282, "stable_key": "clu_efd2a0e53cc427e1", "ground_truth": {"modern_name": "magnetite", "confidence": "high", "type": "mineral", "note": "The early modern texts likely refer to naturally occurring lodestone or specially treated iron (steel magnet) exhibiting magnetic properties, both of which are forms of magnetite or related iron oxides.", "wikidata_id": "Q181395", "wikidata_description": "iron ore mineral", "wikipedia_url": "https://en.wikipedia.org/wiki/Magnetite", "wikipedia_extract": "Magnetite is a mineral and one of the main iron ores, with the chemical formula Fe2+Fe3+2O4. It is one of the oxides of iron, and is ferrimagnetic; it is attracted to a magnet and can be magnetized to become a permanent magnet itself. With the exception of extremely rare native iron deposits, it is the most magnetic of all the naturally occurring minerals on Earth. Naturally magnetized pieces of magnetite, called lodestone, will attract small pieces of iron, which is how ancient peoples first discovered the property of magnetism. Magnetite is black or brownish-black with a metallic luster, has a Mohs hardness of 5–6 and leaves a black streak. Small grains of magnetite are very common in igneous and metamorphic rocks."}, "member_count": 4, "cross_references": []}, {"canonical_name": "Cleopatra", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "cleopatra", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Cleopatra", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Cleopatra"], "contexts": ["historical figure associated with Anthony"]}, {"entity_id": "cleopatra", "book_id": "historia_medicinal_monardes_1574", "name": "Cleopatra", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Cleopatra"], "contexts": ["historical figure", "drank poison to avoid triumph of Pompey"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Cleopatra", "target_book": "historia_medicinal_monardes_1574", "target_name": "Cleopatra", "similarity": 1.0}], "id": 3283, "stable_key": "clu_dfbd268074b00e89", "ground_truth": {"modern_name": "Cleopatra", "confidence": "high", "type": "person", "birth_year": -69, "death_year": -30, "description": "Last active ruler of the Ptolemaic Kingdom of Egypt.", "wikipedia_extract": "Cleopatra VII Thea Philopator (Koine Greek: Κλεοπάτρα Θεά Φιλοπάτωρ, lit. 'Cleopatra father-loving goddess'; 70/69 BC – 10 or 12 August 30 BC) was Queen of the Ptolemaic Kingdom of Egypt from 51 to 30 BC, and the last active Hellenistic pharaoh. A member of the Ptolemaic dynasty, she was a descendant of its founder Ptolemy I Soter, a Macedonian Greek general and companion of Alexander the Great. Her first language was Koine Greek, and she is the only Ptolemaic ruler known to have learned the Egyptian language, among several others. After her death, Egypt became a province of the Roman Empire, marking the end of the Hellenistic period in the Mediterranean, which had begun during the reign of Alexander (336–323 BC). Born in Alexandria, Cleopatra was the daughter of Ptolemy XII Auletes, who named her his heir before his death in 51 BC.", "wikipedia_url": "https://en.wikipedia.org/wiki/Cleopatra"}, "cross_references": []}, {"canonical_name": "specific forms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "specifical_forms", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "specifical forms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["specifical forms"], "contexts": ["attributed causes for effects"]}, {"entity_id": "specific_forms", "book_id": "origin_of_species_darwin_1859", "name": "specific forms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["specific forms"], "contexts": ["distinct biological species", "biological entities with defined characteristics"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "specifical forms", "target_book": "origin_of_species_darwin_1859", "target_name": "specific forms", "similarity": 0.914}], "id": 3284, "stable_key": "clu_2f329d474f4ef5d1", "ground_truth": {"modern_name": "species", "confidence": "high", "type": "concept", "note": "The context of Darwin's 'Origin of Species' strongly suggests the biological concept of species, while Browne's usage in 'Pseudodoxia Epidemica' also points to distinct kinds or forms.", "wikidata_id": "Q2984250", "wikidata_description": "Group of animals capable of interbreeding", "wikipedia_url": "https://en.wikipedia.org/wiki/Species%20concept"}, "cross_references": []}, {"canonical_name": "Remora", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "remora", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Remora", "category": "ANIMAL", "subcategory": "FISH", "count": 1, "variants": ["Remora"], "contexts": ["fish whose salt was used in a magical preparation"]}, {"entity_id": "remora", "book_id": "polyanthea_medicinal", "name": "Remora", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Remora", "Rémora"], "contexts": ["fish that stops ships", "fish with singular virtue"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Remora", "target_book": "polyanthea_medicinal", "target_name": "Remora", "similarity": 0.708}], "id": 3285, "stable_key": "clu_85a5074cefc448cc", "ground_truth": {"modern_name": "Remora", "confidence": "high", "type": "animal"}, "cross_references": [{"found_name": "Fish", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 94, "target_cluster_name": "Fish", "source_book": "llm_generated", "evidence_snippet": "Remora are fish known for their symbiotic relationship with larger marine animals.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Remora are fish known for their symbiotic relationship with larger marine animals.", "is_reverse": true}]}, {"canonical_name": "Lucretius", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "lucretius", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Lucretius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Lucretius"], "contexts": ["poet whose style was emulated"]}, {"entity_id": "lucretius", "book_id": "polyanthea_medicinal", "name": "Lucretius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Lucretius"], "contexts": ["ancient philosopher and poet"]}, {"entity_id": "lucret_", "book_id": "polyanthea_medicinal", "name": "Lucret.", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Lucret."], "contexts": ["ancient authority cited in text"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Lucretius", "target_book": "polyanthea_medicinal", "target_name": "Lucretius", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Lucretius", "target_book": "polyanthea_medicinal", "target_name": "Lucret.", "similarity": 0.875}], "id": 3286, "stable_key": "clu_fe935467b50090bb", "ground_truth": {"modern_name": "Lucretius", "confidence": "high", "type": "person", "birth_year": -100, "death_year": -55, "description": "Roman philosopher and poet, author of De rerum natura.", "wikidata_id": "Q47154", "wikidata_description": "1st-century BC Roman poet and philosopher", "wikipedia_url": "https://en.wikipedia.org/wiki/Lucretius", "wikipedia_extract": "Titus Lucretius Carus ( TY-təs loo-KREE-shəs; Latin: [ˈtitʊs lʊˈkreːtɪ.ʊs ˈkaːrʊs]; c. 99 – October 15, 55 BC) was a Roman poet and philosopher. His only known work is the philosophical poem De rerum natura, a didactic work about the tenets and philosophy of Epicureanism, which usually is translated into English as On the Nature of Things—and somewhat less often as On the Nature of the Universe. Very little is known about Lucretius's life; the only certainty is that he was either a friend or client of Gaius Memmius, to whom the poem was addressed and dedicated. De rerum natura was a considerable influence on the Augustan poets, particularly Virgil (in his Aeneid and Georgics, and to a lesser extent on the Eclogues) and Horace. The work was almost lost during the Middle Ages, but was rediscovered in 1417 in a monastery in Germany by Poggio Bracciolini."}, "cross_references": []}, {"canonical_name": "Petronius", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "petronius", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Petronius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Petronius"], "contexts": ["ancient source on glass malleability"]}, {"entity_id": "petronius", "book_id": "polyanthea_medicinal", "name": "Petronius", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Petronius"], "contexts": ["cited author on French disease", "ancient authority on Gallic diseases"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Petronius", "target_book": "polyanthea_medicinal", "target_name": "Petronius", "similarity": 1.0}], "id": 3287, "stable_key": "clu_2a15371ce6b3dc9f", "ground_truth": {"modern_name": "Petronius", "confidence": "high", "type": "person", "description": "Roman author, likely Gaius Petronius Arbiter, cited for historical and scientific observations.", "wikidata_id": "Q47180", "wikidata_description": "1st century AD Roman courtier and author of the Satyricon (27–66)", "wikipedia_url": "https://en.wikipedia.org/wiki/Petronius", "wikipedia_extract": "Gaius Petronius Arbiter (; Classical Latin: [ˈɡaː.i.ʊs pɛˈt̪roː.ni.ʊˈs ar.bɪ.t̪ɛr]; c. 27 – c. 66 AD; sometimes Titus Petronius Niger) was a Roman courtier during the reign of Nero (r. 54–68). He is generally believed to be the author of the Satyricon, a satirical novel believed to have been written during the Neronian era. He is one of the most important characters in Henryk Sienkiewicz' historical novel Quo Vadis (1895)."}, "cross_references": []}, {"canonical_name": "apple", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "apple", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Apple", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Apple"], "contexts": ["fruit from apple trees"]}, {"entity_id": "apple", "book_id": "origin_of_species_darwin_1859", "name": "apple", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["apple"], "contexts": ["tree host for missletoe", "fruit-bearing tree"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Apple", "target_book": "origin_of_species_darwin_1859", "target_name": "apple", "similarity": 0.98}], "id": 3288, "stable_key": "clu_8a787fe0ebf076c4", "ground_truth": {"modern_name": "apple", "confidence": "high", "type": "plant", "linnaean": "Malus domestica Borkh.", "family": "Rosaceae"}, "cross_references": []}, {"canonical_name": "Holly-trees", "category": "PLANT", "subcategory": "TREE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "holly", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Holly", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Holly"], "contexts": ["evergreen tree"]}, {"entity_id": "holly-trees", "book_id": "origin_of_species_darwin_1859", "name": "Holly-trees", "category": "PLANT", "subcategory": "TREE", "count": 2, "variants": ["holly-trees", "Holly-trees"], "contexts": ["plant species with separate male and female individuals", "sexes of trees"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Holly", "target_book": "origin_of_species_darwin_1859", "target_name": "Holly-trees", "similarity": 0.941}], "id": 3289, "stable_key": "clu_82b71ab51f65deca", "ground_truth": {"modern_name": "holly", "confidence": "high", "type": "plant", "linnaean": "Ilex aquifolium Linnaeus", "family": "Aquifoliaceae", "note": "The description of male and female individuals and evergreen nature strongly points to Ilex aquifolium.", "wikipedia_extract": "Charles Hardin Holley (September 7, 1936 – February 3, 1959), known professionally by his stage name Buddy Holly, was an American singer, songwriter, and musician who was a central and pioneering figure of rock and roll. He was born to a musical family in Lubbock, Texas, during the Great Depression, and learned to play guitar and sing alongside his two siblings. Holly made his first appearance on local television in 1952, and the following year he formed the group Buddy and Bob with his friend Bob Montgomery. In 1955, after opening once for Elvis Presley, Holly decided to pursue a career in music. He played with Presley three times that year, and his band's style shifted from country and western to rock and roll. In October that year, when Holly opened for Bill Haley & His Comets, he was spotted by Nashville scout Eddie Crandall, who helped him get a contract with Decca Records.", "wikipedia_url": "https://en.wikipedia.org/wiki/Buddy_Holly"}, "cross_references": []}, {"canonical_name": "Missel-thrush", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "missel_trush", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Missel Trush", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["Missel Trush"], "contexts": ["kind of thrush that feeds on mistletoe"]}, {"entity_id": "missel-thrush", "book_id": "origin_of_species_darwin_1859", "name": "Missel-thrush", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["missel-thrush", "Missel-thrush"], "contexts": ["bird species"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Missel Trush", "target_book": "origin_of_species_darwin_1859", "target_name": "Missel-thrush", "similarity": 0.926}], "id": 3290, "stable_key": "clu_63824bf4ef24c04c", "ground_truth": {"modern_name": "Mistletoe thrush", "confidence": "high", "type": "animal", "wikipedia_extract": "Thrush (1902–13 December 1925) was a British Thoroughbred racehorse. He was trained by E. Robson and won fifteen of his twenty-two starts. His wins included the Great Foal Plate, Sussex Stakes, King's Stand Stakes and July Cup. Thrush was owned by Captain J. Orr-Ewing.", "wikipedia_url": "https://en.wikipedia.org/wiki/Thrush_(racehorse)"}, "cross_references": []}, {"canonical_name": "seal", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "seal", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Seal", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Seal"], "contexts": ["animal skin with protective quality"]}, {"entity_id": "seal", "book_id": "origin_of_species_darwin_1859", "name": "seal", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["seal"], "contexts": ["animal with flipper bones", "mammal with flippers"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Seal", "target_book": "origin_of_species_darwin_1859", "target_name": "seal", "similarity": 0.861}], "id": 3291, "stable_key": "clu_04d4ed60b7275b05", "ground_truth": {"modern_name": "Seal", "confidence": "high", "type": "animal", "wikidata_id": "Q162919", "wikidata_description": "mark of a personal distinctive emblem intended to guarantee the authenticity of the author of a document onto which it is printed, embossed or affixed", "wikipedia_url": "https://en.wikipedia.org/wiki/Seal%20%28emblem%29", "wikipedia_extract": "A seal is a device for making an impression in wax, clay, paper, or some other medium, including an embossment on paper, and is also the impression thus made. The original purpose was to authenticate a document, or to prevent interference with a package or envelope by applying a seal which had to be broken to open the container (hence the modern English verb \"to seal\", which implies secure closing without an actual wax seal). The seal-making device is also referred to as the seal matrix or die; the imprint it creates as the seal impression (or, more rarely, the sealing). If the impression is made purely as a relief resulting from the greater pressure on the paper where the high parts of the matrix touch, the seal is known as a dry seal; in other cases ink or another liquid or liquefied medium is used, in another color than the paper. In most traditional forms of dry seal the design on the seal matrix is in intaglio (cut below the flat surface) and therefore the design on the impressions made is in relief (raised above the surface). The design on the impression will reverse (be a mirror-image of) that of the matrix, which is especially important when script is included in the design, as it very often is."}, "cross_references": [{"found_name": "carnivorous mammals", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1335, "target_cluster_name": "carnivorous mammals", "source_book": "llm_generated", "evidence_snippet": "Seals are pinnipeds, a group of marine mammals that belong to the order Carnivora.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Seals are pinnipeds, a group of marine mammals that belong to the order Carnivora.", "is_reverse": true}]}, {"canonical_name": "squirrels", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "squirrel", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Squirrel", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Squirrel"], "contexts": ["viviparous animal with clavicles"]}, {"entity_id": "squirrels", "book_id": "origin_of_species_darwin_1859", "name": "squirrels", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["squirrels"], "contexts": ["family of mammals with varying tail and skin structures", "rodent with specific structure"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Squirrel", "target_book": "origin_of_species_darwin_1859", "target_name": "squirrels", "similarity": 0.924}], "id": 3292, "stable_key": "clu_5af33790ae184a38", "ground_truth": {"modern_name": "Squirrel", "confidence": "high", "type": "animal", "wikidata_id": "Q1302028", "wikidata_description": "heraldic animal"}, "cross_references": [{"found_name": "Rodents", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2366, "target_cluster_name": "Rodents", "source_book": "llm_generated", "evidence_snippet": "Squirrels are a common and well-known type of rodent.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Squirrels are a common and well-known type of rodent.", "is_reverse": true}]}, {"canonical_name": "Constantino", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "constantine", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Constantine", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Constantine"], "contexts": ["time period of Absyrtus"]}, {"entity_id": "constantino", "book_id": "coloquios_da_orta_1563", "name": "Constantino", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Constantino", "dom Constantino"], "contexts": ["founder of Constantinople", "viceroy who received plant"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Constantine", "target_book": "coloquios_da_orta_1563", "target_name": "Constantino", "similarity": 0.986}], "id": 3293, "stable_key": "clu_40fa9d584ecc21b9", "ground_truth": {"modern_name": "Constantine", "confidence": "high", "type": "person", "birth_year": 272, "death_year": 337, "description": "Roman Emperor and founder of Constantinople.", "note": "Refers to Constantine the Great.", "wikidata_id": "Q8413", "wikidata_description": "Roman emperor from 306 to 337 and first to convert to Christianity (272–337)", "wikipedia_extract": "Constantine I (27 February 272 – 22 May 337), also known as Constantine the Great, or known mononymously as Constantine, was Roman emperor from AD 306 to 337 and the first Roman emperor to convert to Christianity. He played a pivotal role in elevating the status of Christianity in Rome, the Edict of Milan decriminalising Christian practice and ceasing Christian persecution. This was a turning point in the Christianisation of the Roman Empire. He founded the city of Constantinople (now Istanbul) and made it the capital of the Empire, which it remained for over a millennium. Born in Naissus, a city located in the province of Moesia Superior (now Niš, Serbia), Constantine was the son of Flavius Constantius, a Roman army officer from Moesia Superior, who would become one of the four emperors of the Tetrarchy. His mother, Helena, was a woman of low birth, probably from Bithynia.", "wikipedia_url": "https://en.wikipedia.org/wiki/Constantine_the_Great"}, "cross_references": [{"found_name": "Julian", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2663, "target_cluster_name": "Julian", "source_book": "llm_generated", "evidence_snippet": "Julian was the nephew and successor of Constantine the Great, and his reign was deeply influenced by Constantine's legacy, particularly regarding Christianity and the administration of the empire. Julian's attempts to reverse Constantine's Christian policies make their relationship historically significant.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Julian was the nephew and successor of Constantine the Great, and his reign was deeply influenced by Constantine's legacy, particularly regarding Christianity and the administration of the empire. Julian's attempts to reverse Constantine's Christian policies make their relationship historically significant.", "is_reverse": true}, {"found_name": "Carlos Magno", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2881, "target_cluster_name": "Carlos Magno", "source_book": "llm_generated", "evidence_snippet": "Both were pivotal rulers who significantly impacted the religious and political landscape of their respective eras, Constantine with Christianity and Charlemagne with the consolidation of the Holy Roman Empire.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were pivotal rulers who significantly impacted the religious and political landscape of their respective eras, Constantine with Christianity and Charlemagne with the consolidation of the Holy Roman Empire.", "is_reverse": true}, {"found_name": "Justinian", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2927, "target_cluster_name": "Justinian", "source_book": "llm_generated", "evidence_snippet": "Constantine I (the Great) was a significant Roman Emperor who preceded Justinian I and established Constantinople as the new capital, influencing the Eastern Roman Empire that Justinian would later rule.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Constantine I (the Great) was a significant Roman Emperor who preceded Justinian I and established Constantinople as the new capital, influencing the Eastern Roman Empire that Justinian would later rule.", "is_reverse": true}]}, {"canonical_name": "vefica", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "vescicle", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "vescicle", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["vescicle"], "contexts": ["small bladder-like structure"]}, {"entity_id": "vefica", "book_id": "polyanthea_medicinal", "name": "vefica", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["vefica", "veficæ"], "contexts": ["bladder affected by diabetes", "bladder"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "vescicle", "target_book": "polyanthea_medicinal", "target_name": "vefica", "similarity": 0.895}], "id": 3294, "stable_key": "clu_ee805bd0b494ee9f", "ground_truth": {"modern_name": "Vesicle", "confidence": "high", "type": "concept"}, "cross_references": []}, {"canonical_name": "gaseous emanations", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "emanations", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "emanations", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["eman