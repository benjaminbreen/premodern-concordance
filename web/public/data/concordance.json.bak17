rated", "evidence_snippet": "Medlar is a fruit that is often compared to pears in terms of its texture and culinary uses, and both are pome fruits within the Rosaceae family.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Medlar is a fruit that is often compared to pears in terms of its texture and culinary uses, and both are pome fruits within the Rosaceae family.", "is_reverse": true}, {"found_name": "Fruit trees", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4032, "target_cluster_name": "Fruit-trees", "source_book": "llm_generated", "evidence_snippet": "Pear is a type of fruit tree.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Pear is a type of fruit tree."}, {"found_name": "Tree", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 24, "target_cluster_name": "Tree", "source_book": "llm_generated", "evidence_snippet": "Pear grows on a tree.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Pear grows on a tree."}, {"found_name": "camuesas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3690, "target_cluster_name": "camuesas", "source_book": "llm_generated", "evidence_snippet": "The description explicitly states that quince fruit is similar in appearance to a pear and that both belong to the same subtribe (Malinae) within the Rosaceae family.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The description explicitly states that quince fruit is similar in appearance to a pear and that both belong to the same subtribe (Malinae) within the Rosaceae family.", "is_reverse": true}]}, {"canonical_name": "limbs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "limbs", "book_id": "english_physician_1652", "name": "Limbs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants"