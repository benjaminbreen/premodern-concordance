": "unit for reporting measurement of magnetic field strength"}, "cross_references": []}, {"canonical_name": "Walter", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "walter", "book_id": "kosmos_humboldt_1845", "name": "Walter", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Walter"], "contexts": ["author on volcanic activity", "author on volcanic activity decrease"]}, {"entity_id": "walterus", "book_id": "polyanthea_medicinal", "name": "Walterus", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Walterus"], "contexts": ["author of medicinal text"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Walter", "target_book": "polyanthea_medicinal", "target_name": "Walterus", "similarity": 0.914}], "id": 3123, "stable_key": "clu_88ceb918e7844549", "ground_truth": {"modern_name": "Walter", "confidence": "medium", "type": "person", "description": "Author on volcanic activity and medicinal texts", "note": "Ambiguity exists between different historical figures named Walter who wrote on these topics.", "wikidata_id": "", "wikidata_description": "family name"}, "cross_references": []}, {"canonical_name": "Copenhagen", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "copenhagen", "book_id": "kosmos_humboldt_1845", "name": "Copenhagen", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Copenhagen"], "contexts": ["capital of Denmark", "city further north than Pekin"]}, {"entity_id": "copenhagen", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Copenhagen", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Copenhagen"], "contexts": ["location of Oersted's professorship"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Copenhagen", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Copenhagen", "similarity": 1.0}], "id": 3124, "stable_key": "clu_d385c9ed12386741", "ground_truth": {"modern_name": "Copenhagen", "confidence": "high", "type": "place", "country": "Denmark", "wikidata_id": "Q1748", "wikidata_description": "capital and largest city of Denmark", "wikipedia_url": "https://en.wikipedia.org/wiki/Copenhagen", "wikipedia_extract": "Copenhagen (Danish: København [kʰøpm̩ˈhɑwˀn] ) is the capital and most populous city of both the country of Denmark and the wider Kingdom of Denmark, with a population of 667,000 people in the municipality and 1.4 million in the urban area. The city is situated mainly on the island of Zealand (Sjælland), with a smaller part on the island of Amager. Copenhagen is separated from Malmö, Sweden, by the Øresund strait. The Øresund Bridge connects the two cities by rail and road. Originally a Viking fishing village established in the 10th century in the vicinity of what is now Gammel Strand, Copenhagen became the capital of Denmark in the early 15th century. During the 16th century, the city served as the de facto capital of the Kalmar Union and the seat of the Union's monarchy, which governed most of the modern-day Nordic region as part of a Danish confederation with Sweden and Norway."}, "cross_references": []}, {"canonical_name": "Coraboeuf", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "coraboeuf", "book_id": "kosmos_humboldt_1845", "name": "Coraboeuf", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Coraboeuf"], "contexts": ["geodetic operations, no level difference", "involved in geodetic operations"]}, {"entity_id": "corva", "book_id": "polyanthea_medicinal", "name": "Corva", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Corva"], "contexts": ["nickname of a patient's mother"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Coraboeuf", "target_book": "polyanth