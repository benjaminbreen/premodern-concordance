dges": [], "id": 2562, "stable_key": "clu_16900abc39b3615c", "ground_truth": {"modern_name": "Charles Mason", "confidence": "medium", "type": "person", "birth_year": 1730, "death_year": 1805, "description": "English surveyor, astronomer, and geographer, notable for Mason-Dixon line.", "note": "Multiple individuals named Mason existed during this period. This identification is based on the context of surveying and geographic contributions, which strongly aligns with Charles Mason.", "wikidata_id": "Q108877225", "wikidata_description": "Rector of Grace Church in Boston, Mass"}, "cross_references": []}, {"canonical_name": "Irkutsk", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "irkutsk", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Irkutsk", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Irkutsk"], "contexts": ["city in Siberia"]}, {"entity_id": "irkutsk", "book_id": "kosmos_humboldt_1845", "name": "Irkutsk", "category": "PLACE", "subcategory": "CITY", "count": 5, "variants": ["Irkutsk"], "contexts": ["city near Lake Baikal", "city in Asiatic Continent"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Irkutsk", "target_book": "kosmos_humboldt_1845", "target_name": "Irkutsk", "similarity": 1.0}], "id": 2563, "stable_key": "clu_8d99acde044c0efe", "ground_truth": {"modern_name": "Irkutsk", "confidence": "high", "type": "place", "country": "Russia", "wikidata_id": "Q6576", "wikidata_description": "capital city of Irkutsk Oblast, Siberia, in eastern Russia", "wikipedia_url": "https://en.wikipedia.org/wiki/Irkutsk", "wikipedia_extract": "Irkutsk ( eer-KOOTSK; Russian: Иркутск, IPA: [ɪrˈkutsk]; Buryat and Mongolian: Эрхүү, Erhüü [ɛrˈxuː]) is the largest city and administrative center of Irkutsk Oblast, Russia. With a population of 587,891 as of the 2010 Census, Irkutsk is the 25th-largest city in Russia by population, the fifth-largest in the Siberian Federal District, and one of the largest cities in Siberia. Located in the south of the eponymous oblast, the city proper lies on the Angara River, a tributary of the Yenisei, about 850 kilometres (530 mi) to the south-east of Krasnoyarsk and about 520 kilometres (320 mi) north of Ulaanbaatar. The Trans-Siberian Highway (Federal M53 and M55 Highways) and Trans-Siberian Railway connect Irkutsk to other regions in Russia and Mongolia. Many distinguished Russians were sent into exile in Irkutsk for their part in the Decembrist revolt of 1825, and the city became an exile-post for the rest of the century. Some historic wooden houses still survive."}, "cross_references": [{"found_name": "Tobolsk", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2550, "target_cluster_name": "Tobolsk", "source_book": "llm_generated", "evidence_snippet": "Irkutsk was a major administrative and trade center in Siberia, historically linked to Tobolsk as part of the Russian expansion into the region.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Irkutsk was a major administrative and trade center in Siberia, historically linked to Tobolsk as part of the Russian expansion into the region.", "is_reverse": true}, {"found_name": "Astrakhan", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2753, "target_cluster_name": "Astrakhan", "source_book": "llm_generated", "evidence_snippet": "Astrakhan is a city in Russia, located near the Volga River delta on the Caspian Sea. Irkutsk is also a major city in Russia, located in Siberia. Both are significant administrative and economic centers within Russia, and historically, Astrakhan was a key trading post on routes connecting Europe and Asia, similar to Irkutsk's role in Siberian expansion and trade.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Astrakhan is a city in Russia, located near the Volga River delta on the Caspian Sea. Irkutsk is also a major city in Russia, located in Siberia. Both are significant administrative and economic centers within Russia, and historically, Astrakhan was a key trading post on routes connecting Europe and Asia, similar to Irkutsk's role in Siberian expansion and trade."}, {"found_name": "Barnaul", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2798, "target_cluster_name": "Barnaul", "source_book": "llm_generated", "evidence_snippet": "Barnaul is a city in Siberia, Russia, located on the Ob River. Irkutsk is also a major city in Siberia, located on the Angara River. Both cities are important industrial and cultural centers in the Siberian region of Russia and share geographical proximity and historical development within the context of Russian expansion into Siberia.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Barnaul is a city in Siberia, Russia, located on the Ob River. Irkutsk is also a major city in Siberia, located on the Angara River. Both cities are important industrial and cultural centers in the Siberian region of Russia and share geographical proximity and historical development within the context of Russian expansion into Siberia."}]}, {"canonical_name": "M. Bessel", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "m__bessel", "book_id": "relation_historique_humboldt_vol3_1825", "name": "M. Bessel", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["M. Bessel"], "contexts": ["published important result on barometric oscillations"]}, {"entity_id": "m__bessel", "book_id": "connexion_physical_sciences_somerville_1858", "name": "M. Bessel", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["M. Bessel"], "contexts": ["astronomer who studied Saturn's ring", "astronomer calculating obliquity variation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "M. Bessel", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "M. Bessel", "similarity": 1.0}], "id": 2564, "stable_key": "clu_b5c64c42f038e2c2", "ground_truth": {"modern_name": "Friedrich Bessel", "confidence": "high", "type": "person", "birth_year": 1784, "death_year": 1846, "description": "German astronomer who made significant contributions to stellar parallax and astronomy.", "note": "The description of studying barometric oscillations is less commonly associated with Bessel, but his astronomical work on Saturn's rings and his prominence in the scientific community make him the most likely referent."}, "cross_references": [{"found_name": "Friedrich Georg Wilhelm von Struve", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2068, "target_cluster_name": "Struve", "source_book": "llm_generated", "evidence_snippet": "Both were prominent astronomers and mathematicians of the 19th century, known for their contributions to geodesy and stellar astronomy. They were contemporaries and likely knew of each other's work.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were prominent astronomers and mathematicians of the 19th century, known for their contributions to geodesy and stellar astronomy. They were contemporaries and likely knew of each other's work."}, {"found_name": "Friedrich Wilhelm Argelander", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1851, "target_cluster_name": "Argelander", "source_book": "llm_generated", "evidence_snippet": "Both were prominent astronomers of the 19th century. Bessel is known for his work on stellar parallax and the Bessel function, while Argelander is known for his star catalog and work on stellar magnitudes. They were contemporaries and part of the same scientific community.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were prominent astronomers of the 19th century. Bessel is known for his work on stellar parallax and the Bessel function, while Argelander is known for his star catalog and work on stellar magnitudes. They were contemporaries and part of the same scientific community."}]}, {"canonical_name": "palhas", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "hachas", "book_id": "historia_medicinal_monardes_1574", "name": "hachas", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["hachas"], "contexts": ["objects made from wax"]}, {"entity_id": "palhas", "book_id": "polyanthea_medicinal", "name": "palhas", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 5, "variants": ["palhas"], "contexts": ["straw", "straws, attracted by amber and diamond"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "hachas", "target_book": "polyanthea_medicinal", "target_name": "palhas", "similarity": 0.886}], "id": 2565, "stable_key": "clu_764e27187143feb0", "ground_truth": {"modern_name": "Straw", "confidence": "low", "type": "object", "note": "'Palhas' can refer to various dry stalks of grain, including straw. 'Hachas' is a misspelling or OCR error and does not fit the context of objects made from wax or straw."}, "cross_references": [{"found_name": "Panno", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 654, "target_cluster_name": "Panno", "source_book": "llm_generated", "evidence_snippet": "Straw was historically used as a material for clothing and accessories like hats.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Straw was historically used as a material for clothing and accessories like hats.", "is_reverse": true}]}, {"canonical_name": "Tripoli", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "tripoli", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Tripoli", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Tripoli"], "contexts": ["city with sugar consumption"]}, {"entity_id": "tripoli", "book_id": "coloquios_da_orta_1563", "name": "Tripoli", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Tripoli"], "contexts": ["city spices were transported to", "city mentioned in footnote"]}, {"entity_id": "tripol", "book_id": "coloquios_da_orta_1563", "name": "Tripol", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Tripol"], "contexts": ["city in Syria"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Tripoli", "target_book": "coloquios_da_orta_1563", "target_name": "Tripoli", "similarity": 0.903}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Tripoli", "target_book": "coloquios_da_orta_1563", "target_name": "Tripol", "similarity": 0.882}], "id": 2566, "stable_key": "clu_8ddb7e54c60db64b", "ground_truth": {"modern_name": "Tripoli", "confidence": "high", "type": "place", "description": "Mediterranean port cities in Libya and Lebanon.", "note": "Refers to both Tripoli in Libya and Tripoli (also known as Tarabulus al-Sham or Tripoli of Syria) in Lebanon.", "wikipedia_extract": "Tripoli, historically known as Tripoli-of-the-West, is the capital and largest city of Libya, with a population of about 1.317 million people in 2021. It is located in the northwest of Libya on the edge of the desert, on a point of rocky land projecting into the Mediterranean Sea and forming a bay. It includes the port of Tripoli and the country's largest commercial and manufacturing center. It is also the site of the University of Tripoli. Tripoli was founded in the 7th century BC by the Phoenicians, who gave it the Libyco-Berber name Oyat (Punic: 𐤅𐤉‬‬𐤏‬𐤕, romanized: Wyʿt), before passing into the hands of the Greek rulers of Cyrenaica as Oea (Ancient Greek: Ὀία, romanized: Oía). Due to the city's long history, there are many sites of archeological significance in Tripoli."}, "cross_references": []}, {"canonical_name": "conduction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "conduction", "book_id": "principles_of_psychology_james_1890", "name": "conduction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["conduction"], "contexts": ["transfer of heat or electricity", "transmission of nerve impulses"]}, {"entity_id": "conduction", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Conduction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Conduction"], "contexts": ["transfer of electricity"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "conduction", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Conduction", "similarity": 0.989}], "id": 2567, "stable_key": "clu_41b385c49d06582c", "ground_truth": {"modern_name": "Conduction", "confidence": "high", "type": "concept"}, "cross_references": [{"found_name": "friction", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 155, "target_cluster_name": "friction", "source_book": "llm_generated", "evidence_snippet": "Friction generates heat, and heat transfer through conduction is a related physical process that occurs as a result of friction.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Friction generates heat, and heat transfer through conduction is a related physical process that occurs as a result of friction.", "is_reverse": true}, {"found_name": "cooling", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 720, "target_cluster_name": "cooling", "source_book": "llm_generated", "evidence_snippet": "Conduction is a primary mechanism by which cooling (heat transfer) occurs.", "confidence": 0.85, "auto_label": "llm_related", 