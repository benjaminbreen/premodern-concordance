ame": "gneiss", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1625, "target_cluster_name": "gneiss", "source_book": "kosmos_humboldt_1845", "evidence_snippet": "from the silurian or cambrian sea. On what did these so-called 'most ancient' formations rest, if gneiss and mica schist must be regarded as changed sedimentary strata? Dare we hazard a conjecture on ", "confidence": 0.65, "auto_label": "contested_identity", "found_relationship": "A type of rock that may be changed sedimentary strata"}, {"found_name": "mica schist", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "kosmos_humboldt_1845", "evidence_snippet": "from the silurian or cambrian sea. On what did these so-called 'most ancient' formations rest, if gneiss and mica schist must be regarded as changed sedimentary strata? Dare we hazard a conjecture on ", "confidence": 0.65, "auto_label": "contested_identity", "found_relationship": "A type of rock that may be changed sedimentary strata"}]}, {"canonical_name": "mastodontes", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 3, "total_mentions": 10, "members": [{"entity_id": "mastodon", "book_id": "origin_of_species_darwin_1859", "name": "Mastodon", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["Mastodon"], "contexts": ["extinct mammal species", "extinct elephant-like mammal"]}, {"entity_id": "mastodons", "book_id": "origin_of_species_darwin_1859", "name": "mastodons", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["mastodons"], "contexts": ["extinct elephant-like mammals", "extinct mammal name"]}, {"entity_id": "mastodontes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "mastodontes", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 3, "variants": ["Mastodontes", "mastodontes"], "contexts": ["bones of Mastodontes", "extinct mammal bones found"]}, {"entity_id": "mastodon", "book_id": "kosmos_humboldt_1845", "name": "mastodon", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["mastodon", "Mastodon"], "contexts": ["extinct mammal genus", "extinct prehistoric mammal"]}, {"entity_id": "mastodons", "book_id": "kosmos_humboldt_1845", "name": "mastodons", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["mastodons"], "contexts": ["extinct elephant-like mammal"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Mastodon", "target_book": "kosmos_humboldt_1845", "target_name": "mastodon", "similarity": 0.746}, {"source_book": "origin_of_species_darwin_1859", "source_name": "mastodons", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "mastodontes", "similarity": 0.93}, {"source_book": "origin_of_species_darwin_1859", "source_name": "mastodons", "target_book": "kosmos_humboldt_1845", "target_name": "mastodon", "similarity": 0.931}, {"source_book": "origin_of_species_darwin_1859", "source_name": "mastodons", "target_book": "kosmos_humboldt_1845", "target_name": "mastodons", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "mastodontes", "target_book": "kosmos_humboldt_1845", "target_name": "mastodons", "similarity": 0.93}], "id": 914, "stable_key": "clu_e7dab61e3503cda8", "ground_truth": {"modern_name": "Mastodon", "confidence": "high", "type": "animal", "linnaean": "Mammut americanum", "family": "Mammutidae", "description": "An extinct genus of elephant-like mammals.", "wikipedia_extract": "A mastodon (from Ancient Greek  μαστός (mastós) 'breast' and  ὀδούς (odoús) 'tooth') is a member of the genus Mammut (German for 'mammoth'), which was endemic to North America and lived from the late Miocene to the early Holocene. Mastodons belong to the order Proboscidea, the same order as elephants and mammoths (which belong to the family Elephantidae). Mammut is the type genus of the extinct family Mammutidae, which diverged from the ancestors of modern elephants at least 28 million years ago, during the Oligocene. Like other members of Mammutidae, the molar teeth of mastodons have zygodont morphology (where parallel pairs of cusps are merged into sharp ridges), which strongly differ from those of elephantids. In comparison to its likely ancestor Zygolophodon, Mammut is characterized by particularly long and upward curving upper tusks, reduced or absent tusks on the lower jaw, as well as the shortening of the mandibular symphysis (the frontmost part of the lower jaw), the latter two traits also having evolved in parallel separately in elephantids. Mastodons had an overall stockier skeletal build, a lower-domed skull, and a longer tail compared to elephantids."}, "cross_references": [{"found_name": "Elephant", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 839, "target_cluster_name": "Elephants", "source_book": "llm_generated", "evidence_snippet": "Mastodons belong to the order Proboscidea, the same order as elephants.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Mastodons belong to the order Proboscidea, the same order as elephants."}, {"found_name": "Mylodon", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4001, "target_cluster_name": "Mylodon", "source_book": "llm_generated", "evidence_snippet": "Mylodon is another extinct megafauna, often discussed alongside mastodons in paleontological contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Mylodon is another extinct megafauna, often discussed alongside mastodons in paleontological contexts."}, {"found_name": "Mammals", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 266, "target_cluster_name": "mammals", "source_book": "llm_generated", "evidence_snippet": "Mastodons are a type of mammal.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Mastodons are a type of mammal."}]}, {"canonical_name": "grasses", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 10, "members": [{"entity_id": "grasses", "book_id": "origin_of_species_darwin_1859", "name": "Grasses", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Grasses"], "contexts": ["family of monocotyledonous plants", "plant family"]}, {"entity_id": "grasses", "book_id": "kosmos_humboldt_1845", "name": "grasses", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["grasses"], "contexts": ["plants found in uniform plains", "vegetation covering mountain plateaux"]}, {"entity_id": "grasses", "book_id": "connexion_physical_sciences_somerville_1858", "name": "grasses", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["grasses"], "contexts": ["social plants covering large tracts", "plants with one seed-lobe"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Grasses", "target_book": "kosmos_humboldt_1845", "target_name": "grasses", "similarity": 0.96}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Grasses", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "grasses", "similarity": 0.96}, {"source_book": "kosmos_humboldt_1845", "source_name": "grasses", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "grasses", "similarity": 1.0}], "id": 915, "stable_key": "clu_d55e20b1a87c8d12", "ground_truth": {"modern_name": "Poaceae", "confidence": "high", "type": "plant", "linnaean": "Poaceae", "family": "Poaceae", "note": "The term 'grasses' in these contexts refers to the plant family Poaceae, commonly known as grasses.", "wikidata_id": "", "wikidata_description": "psychoactive herb from the Cannabis plant used for medical or recreational purposes", "wikipedia_url": "", "wikipedia_extract": ""}, "cross_references": [{"found_name": "Grass", "link_type": "same_referent