 2489, "stable_key": "clu_a2d0712399704ae1", "ground_truth": {"modern_name": "Government", "confidence": "high", "type": "concept"}, "cross_references": [{"found_name": "State", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2916, "target_cluster_name": "State", "source_book": "llm_generated", "evidence_snippet": "Government is the system of rule that operates within a state.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Government is the system of rule that operates within a state.", "is_reverse": true}, {"found_name": "Authority", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 355, "target_cluster_name": "Authority", "source_book": "llm_generated", "evidence_snippet": "Government is a primary institution through which authority is exercised in a civil state.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Government is a primary institution through which authority is exercised in a civil state.", "is_reverse": true}, {"found_name": "social", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1023, "target_cluster_name": "social", "source_book": "llm_generated", "evidence_snippet": "'Social' relates to the organization and interaction of people within a society, and 'government' is a primary mechanism for structuring and managing these social interactions.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: 'Social' relates to the organization and interaction of people within a society, and 'government' is a primary mechanism for structuring and managing these social interactions.", "is_reverse": true}, {"found_name": "position", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1100, "target_cluster_name": "position", "source_book": "llm_generated", "evidence_snippet": "Government is a system that establishes and maintains positions of power and authori