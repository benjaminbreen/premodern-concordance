 "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "reddish", "book_id": "english_physician_1652", "name": "reddish", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["reddish"], "contexts": ["colour of Vipers Buglofs buds"]}, {"entity_id": "redness", "book_id": "principles_of_psychology_james_1890", "name": "redness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["redness"], "contexts": ["quality of being red"]}, {"entity_id": "redness", "book_id": "connexion_physical_sciences_somerville_1858", "name": "redness", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["redness"], "contexts": ["color indicating high temperature"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "reddish", "target_book": "principles_of_psychology_james_1890", "target_name": "redness", "similarity": 0.886}, {"source_book": "english_physician_1652", "source_name": "reddish", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "redness", "similarity": 0.886}, {"source_book": "principles_of_psychology_james_1890", "source_name": "redness", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "redness", "similarity": 1.0}], "id": 1326, "stable_key": "clu_27697870422f1797", "ground_truth": {"modern_name": "Redness", "confidence": "high", "type": "concept", "wikidata_id": "Q1166142", "wikidata_description": "symptom", "wikipedia_url": "https://en.wikipedia.org/wiki/Erythema", "wikipedia_extract": "Erythema (Ancient Greek: ἐρύθημα, from Greek  erythros 'red') is redness of the skin or mucous membranes, caused by hyperemia (increased blood flow) in superficial capillaries. It occurs with any skin injury, infection, or inflammation. Examples of erythema not associated with pathology include nervous blushes. It can be caused by infection, massage, electrical treatment, acne medication, allergies, psoriasis, mast cell activation syndrome (MCAS), exercise, solar radiation (sunburn), photosensitization, acute radiation syndrome, mercury toxicity, blister agents, niacin administration, or waxing and tweezing of the hairs—any of which can cause the affected capillaries to dilate, resulting in redness. Erythema is a common side effect of radiotherapy treatment due to patient exposure to ionizing radiation. Erythema disappears on finger pressure (blanching), whereas purpura or bleeding in the skin and pigmentation do not."}, "cross_references": []}, {"canonical_name": "dissolve", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "dissolves", "book_id": "english_physician_1652", "name": "Dissolves", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["Dissolves"], "contexts": ["to break down or liquefy"]}, {"entity_id": "disoluere", "book_id": "ricettario_fiorentino_1597", "name": "Disoluere", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["Disoluere"], "contexts": ["process of dissolving"]}, {"entity_id": "dissolve", "book_id": "polyanthea_medicinal", "name": "dissolve", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 2, "variants": ["dissolve", "disolvendo"], "contexts": ["action of mercury on humors", "medical manipulation"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Dissolves", "target_book": "polyanthea_medicinal", "target_name": "dissolve", "similarity": 0.891}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Disoluere", "target_book": "polyanthea_medicinal", "target_name": "dissolve", "similarity": 0.906}], "id": 1327, "stable_key": "clu_66604fd0dff01882", "ground_truth": {"modern_name": "dissolution", "confidence": "high", "type": "concept", "wikidata_id": "Q3133701", "wikidata_description": "process of a solute dissolving in a solvent", "wikipedia_url": "https://en.wikipedia.org/wiki/Pralaya", "wikipedia_extract": "Pralaya (Sanskrit: प्रलय, romanized: Pralaya, lit. 'Destruction') is a concept in Hindu eschatology. Generally referring to four different phenomena, it is most commonly used to indicate the event of the dissolution of the entire universe that follows a kalpa (a period of 4.32 billion years) called the Brahmapralaya. Pralaya also refers to Nityapralaya, the continuous destruction of all animate and inanimate beings that occurs on a daily basis, Prakritapralaya, the great flood produced by Prakriti (Nature) that ends all of creation after the completion of 1,000 Chaturyuga (four-age) cycles, and Atyantikapralaya, the dissolution of one's Atman (Self) due to its union with Brahman (Ultimate Reality). A concept that has been referenced in literature since the Upanishads, the concept of pralaya has been widely discussed in Hindu cosmology as well as philosophy. Hindu cosmology posits an endless cycle of the periodic creation and destruction of the universe."}, "cross_references": [{"found_name": "Creationism", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 12, "target_cluster_name": "creation", "source_book": "llm_generated", "evidence_snippet": "Pralaya is a concept of cosmic dissolution in Hindu eschatology, which is a counterpart to the concept of creation.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Pralaya is a concept of cosmic dissolution in Hindu eschatology, which is a counterpart to the concept of creation."}, {"found_name": "Genesis", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2958, "target_cluster_name": "Genesis", "source_book": "llm_generated", "evidence_snippet": "Pralaya, the dissolution of the universe, is a concept that follows creation and precedes a new genesis in Hindu cosmology.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Pralaya, the dissolution of the universe, is a concept that follows creation and precedes a new genesis in Hindu cosmology."}, {"found_name": "Resurrection", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3941, "target_cluster_name": "Resurrection", "source_book": "llm_generated", "evidence_snippet": "Pralaya, the dissolution of the universe, is often followed by a renewal or recreation, conceptually similar to a resurrection.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Pralaya, the dissolution of the universe, is often followed by a renewal or recreation, conceptually similar to a resurrection."}, {"found_name": "Time", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 223, "target_cluster_name": "time", "source_book": "llm_generated", "evidence_snippet": "Pralaya is a cyclical event occurring after vast periods of time (kalpas) in Hindu eschatology.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Pralaya is a cyclical event occurring after vast periods of time (kalpas) in Hindu eschatology."}]}, {"canonical_name": "Müller", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "müller", "book_id": "origin_of_species_darwin_1859", "name": "Müller", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Müller"], "contexts": ["remarked on young animals differing", "on Alpine Australian plants"]}, {"entity_id": "müller", "book_id": "principles_of_psychology_james_1890", "name": "Müller", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Müller"], "contexts": ["suggested cessation of cause gives feeling of void"]}, {"entity_id": "muller", "book_id": "kosmos_humboldt_1845", "name": "Muller", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Muller"], "contexts": ["editor of 'Archiv fur Anatomie und Physiologie'"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Müller", "target_book": "principles_of_psychology_james_1890", "target_name": "Müller", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Müller", "target_book": "kosmos_humboldt_1845", "target_name": "Muller", "similarity": 0.833}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Müller", "target_book": "kosmos_humboldt_1845", "target_name": "Muller", "similarity": 0.833}], "id": 1328, "stable_key": "clu_046f47b37908ae14", "ground_truth": {"modern_name": "Johannes Peter Müller", "confidence": "high", "type": "person", "birth_year": 1801, "death_year": 1858, "description": "German physiologist and ichthyologist, significant figure in biology.", "note": "Given the context of scientific texts and the era, the prominent German physiologist Johannes Peter Müller is the most likely referent. The specific mention of editing an anatomical journal further supports this."}, "cross_references": [{"found_name": "Alexander von Humboldt", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 42, "target_cluster_name": "Humboldt", "source_book": "llm_generated", "evidence_snippet": "Johannes Peter Müller was a prominent physiologist and comparative anatomist, and Alexander von Humboldt was a highly influential naturalist and explorer whose work in geography and natural sciences significantly impacted the scientific landscape in which Müller worked.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Johannes Peter Müller was a prominent physiologist and comparative anatomist, and Alexander von Humboldt was a highly influential naturalist and explorer whose work in geography and natural sciences significantly impacted the scientific landscape in which Müller worked."}, {"found_name": "Carl Linnaeus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2721, "target_cluster_name": "Linnæus", "source_book": "llm_generated", "evidence_snippet": "Müller's work in physiology and anatomy built upon the systematic classification of organisms, a field heavily influenced by Linnaeus's foundational work in taxonomy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Müller's work in physiology and anatomy built upon the systematic classification of organisms, a field heavily influenced by Linnaeus's foundational work in taxonomy."}, {"found_name": "Galen", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 29, "target_cluster_name": "Galen", "source_book": "llm_generated", "evidence_snippet": "Müller's extensive work in comparative anatomy and physiology engaged with and often revised the ancient theories of Galen, a cornerstone of medical understanding for centuries.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Müller's extensive work in comparative anatomy and physiology engaged with and often revised the ancient theories of Galen, a cornerstone of medical understanding for centuries."}, {"found_name": "Hippocrates", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 31, "target_cluster_name": "Hippocrates", "source_book": "llm_generated", "evidence_snippet": "As a foundational figure in Western medicine, Hippocrates represents the ancient tradition of medical observation and theory that Müller, as a modern physiologist, would have been aware of and potentially built upon or reacted against.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "As a foundational figure in Western medicine, Hippocrates represents the ancient tradition of medical observation and theory that Müller, as a modern physiologist, would have been aware of and potentially built upon or reacted against."}]}, {"canonical_name": "Staffordshire", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "staffordshire", "book_id": "origin_of_species_darwin_1859", "name": "Staffordshire", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Staffordshire"], "contexts": ["location of investigation", "location where insects affect birds"]}, {"entity_id": "staffordshire", "book_id": "kosmos_humboldt_1845", "name": "Staffordshire", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Staffordshire"], "contexts": ["county in England"]}, {"entity_id": "staffordshire", "book_id": "first_principles_spencer_1862", "name": "Staffordshire", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Staffordshire"], "contexts": ["pottery-manufacture"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Staffordshire", "target_book": "kosmos_humboldt_1845", "target_name": "Staffordshire", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Staffordshire", "target_book": "first_principles_spencer_1862", "target_name": "Staffordshire", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Staffordshire", "target_book": "first_principles_spencer_1862", "target_name": "Staffordshire", "similarity": 1.0}], "id": 1329, "stable_key": "clu_81acb50f7318423f", "ground_truth": {"modern_name": "Staffordshire", "confidence": "high", "type": "place", "country": "United Kingdom", "wikipedia_extract": "Cheadle is a market town and civil parish in the Staffordshire Moorlands District of Staffordshire, England. It is located between Uttoxeter, Leek, Ashbourne and Stoke-on-Trent. Dating back to Anglo-Saxon times, it lies within the historic Staffordshire Hundred of Totmonslow. In 2011 the parish had a population of 12,165. Cheadle is first attested in the Domesday Book of 1086, in the forms Celle and Cedla. The first part of the name comes from the Common Brittonic word which survives in modern Welsh as coed (\"woodland\"), and was thus once a place-name meaning \"wood\".", "wikipedia_url": "https://en.wikipedia.org/wiki/Cheadle,_Staffordshire"}, "cross_references": [{"found_name": "England", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 65, "target_cluster_name": "England", "source_book": "llm_generated", "evidence_snippet": "Staffordshire is a county in England.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Staffordshire is a county in England."}]}, {"canonical_name": "organic world", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "organic_world", "book_id": "origin_of_species_darwin_1859", "name": "organic world", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["organic world"], "contexts": ["the realm of living organisms"]}, {"entity_id": "organic_world", "book_id": "principles_of_psychology_james_1890", "name": "organic world", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["organic world"], "contexts": ["living organisms and their properties"]}, {"entity_id": "organic_world", "book_id": "kosmos_humboldt_1845", "name": "organic world", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["organic world"], "contexts": ["the realm of living things"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "organic world", "target_book": "principles_of_psychology_james_1890", "target_name": "organic world", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "organic world", "target_book": "kosmos_humboldt_1845", "target_name": "organic world", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "organic world", "target_book": "kosmos_humboldt_1845", "target_name": "organic world", "similarity": 1.0}], "id": 1330, "stable_key": "clu_72ee84fa272d155d", "ground_truth": {"modern_name": "organic world", "confidence": "high", "type": "concept"}, "cross_references": [{"found_name": "Animal Kingdom", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2373, "target_cluster_name": "animal kingdom", "source_book": "llm_generated", "evidence_snippet": "The 'organic world' is a broad term encompassing all living organisms, and the 'Animal Kingdom' is a major division within it.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The 'organic world' is a broad term encompassing all living organisms, and the 'Animal Kingdom' is a major division within it."}, {"found_name": "Animal life", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2437, "target_cluster_name": "animal life", "source_book": "llm_generated", "evidence_snippet": "The 'organic world' refers to all living things, and 'animal life' is a significant component of this.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The 'organic world' refers to all living things, and 'animal life' is a significant component of this."}, {"found_name": "Botany", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1098, "target_cluster_name": "botany", "source_book": "llm_generated", "evidence_snippet": "Botany is the scientific study of plants, which are a fundamental part of the 'organic world'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Botany is the scientific study of plants, which are a fundamental part of the 'organic world'."}, {"found_name": "Fauna", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 809, "target_cluster_name": "fauna", "source_book": "llm_generated", "evidence_snippet": "Fauna refers to all the animal life of a particular region or time, a subset of the 'organic world'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Fauna refers to all the animal life of a particular region or time, a subset of the 'organic world'."}]}, {"canonical_name": "domestic pigeon", "category": "ANIMAL", "subcategory": "BIRD", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "domestic_pigeon", "book_id": "origin_of_species_darwin_1859", "name": "domestic pigeon", "category": "ANIMAL", "subcategory": "BIRD", "count": 2, "variants": ["domestic pigeon"], "contexts": ["pigeon kept by humans", "common domesticated bird"]}, {"entity_id": "pigeon", "book_id": "principles_of_psychology_james_1890", "name": "pigeon", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["pigeon"], "contexts": ["bird studied for brain function"]}, {"entity_id": "pigeon", "book_id": "kosmos_humboldt_1845", "name": "pigeon", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["pigeon"], "contexts": ["animal dodo was proven to be"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "domestic pigeon", "target_book": "principles_of_psychology_james_1890", "target_name": "pigeon", "similarity": 0.912}, {"source_book": "origin_of_species_darwin_1859", "source_name": "domestic pigeon", "target_book": "kosmos_humboldt_1845", "target_name": "pigeon", "similarity": 0.912}, {"source_book": "principles_of_psychology_james_1890", "source_name": "pigeon", "target_book": "kosmos_humboldt_1845", "target_name": "pigeon", "similarity": 1.0}], "id": 1331, "stable_key": "clu_53536ac2f748dedb", "ground_truth": {"modern_name": "Columba livia", "confidence": "high", "type": "animal", "wikidata_id": "Q42326", "wikidata_description": "species of pigeon; the wild bird from which domesticated pigeons derive", "wikipedia_url": "https://en.wikipedia.org/wiki/Rock%20dove", "wikipedia_extract": "The rock dove (Columba livia), also known as the common pigeon or \"rock pigeon\", is a member of the bird family Columbidae (doves and pigeons). In common usage, it is often simply referred to as the \"pigeon\", although the rock dove is the wild form of the bird; the pigeons familiar to most people are the domesticated forms of the wild rock dove. Wild rock doves are uniformly pale grey with two black bars on each wing, with few differences being seen between males and females; i.e. they are not strongly sexually dimorphic. The domestic pigeon, often, but invalidly, called \"Columba livia domestica\", which includes about 1,000 different breeds, is descended from this species. Escaped domestic pigeons are the origin of feral pigeons around the world."}, "cross_references": [{"found_name": "pombos", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1919, "target_cluster_name": "pombos", "source_book": "llm_generated", "evidence_snippet": "Columba livia is the scientific name for the rock dove, which is the specific species described by the entity 'Doves (historical name: pombos)'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Columba livia is the scientific name for the rock dove, which is the specific species described by the entity 'Doves (historical name: pombos)'.", "is_reverse": true}]}, {"canonical_name": "Ascension", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "ascension", "book_id": "origin_of_species_darwin_1859", "name": "Ascension", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Ascension"], "contexts": ["barren island with few native plants", "plants of"]}, {"entity_id": "ascension", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Ascension", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Ascension"], "contexts": ["island"]}, {"entity_id": "ascension", "book_id": "kosmos_humboldt_1845", "name": "Ascension", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Ascension"], "contexts": ["island of formation"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Ascension", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Ascension", 