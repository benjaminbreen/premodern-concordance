erville_1858", "target_name": "United States", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "United States", "target_book": "kosmos_humboldt_1845", "target_name": "United States", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "United States", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "United States", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "United States", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "United States", "similarity": 1.0}], "id": 83, "stable_key": "clu_efcf50dde094eea9", "ground_truth": {"modern_name": "United States", "confidence": "high", "type": "place", "country": "United States", "wikidata_id": "Q30", "wikidata_description": "country located primarily in North America", "wikipedia_url": "https://en.wikipedia.org/wiki/United%20States", "note": "While 'United States of North America' was a more formal designation, the modern referent is the United States.", "wikipedia_extract": "The United States of America (USA), also known as the United States (U.S.) or America, is a country primarily located in North America. It is a federal republic of 50 states and a federal capital district, Washington, D.C. The 48 contiguous states border Canada to the north and Mexico to the south, with the semi-exclave of Alaska in the northwest and the archipelago of Hawaii in the Pacific Ocean. The United States also asserts sovereignty over five major island territories and various uninhabited islands in Oceania and the Caribbean. It is a megadiverse country, with the world's third-largest land area and third-largest population, exceeding 341 million. Paleo-Indians first migrated from North Asia to North America at least 15,000 years ago, and formed various civilizations."}, "member_count": 7, "cross_references": [{"found_name": "Canada", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 736, "target_cluster_name": "Canada", "source_book": "llm_generated", "evidence_snippet": "Canada shares a long border with the United States and has been historically and geographically intertwined with it.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Canada shares a long border with the United States and has been historically and geographically intertwined with it."}, {"found_name": "Mexico", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 39, "target_cluster_name": "Mexique", "source_book": "llm_generated", "evidence_snippet": "Mexico shares a long border with the United States and has been historically and geographically intertwined with it.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Mexico shares a long border with the United States and has been historically and geographically intertwined with it."}]}, {"canonical_name": "atoms", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 5, "total_mentions": 37, "members": [{"entity_id": "elemental_atoms", "book_id": "origin_of_species_darwin_1859", "name": "elemental atoms", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["elemental atoms"], "contexts": ["fundamental particles of matter"]}, {"entity_id": "atoms", "book_id": "first_principles_spencer_1862", "name": "atoms", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 20, "variants": ["atoms"], "contexts": ["hypothetical fundamental units of matter", "indivisible particles of matter"]}, {"entity_id": "atoms", "book_id": "principles_of_psychology_james_1890", "name": "atoms", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["atoms"], "contexts": ["fundamental particles of matter", "fundamental particles"]}, {"entity_id": "atoms", "book_id": "kosmos_humboldt_1845", "name": "atoms", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["atoms", "Atoms"], "contexts": ["fundamental particles in mechanical construction", "hypothetical construction of matter"]}, {"entity_id": "atoms_of_matter", "book_id": "first_principles_spencer_1862", "name": "atoms of matter", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["atoms of matter"], "contexts": ["re-arrangement generates electricity"]}, {"entity_id": "atoms_of_matter", "book_id": "principles_of_psychology_james_1890", "name": "Atoms of matter", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Atoms of matter"], "contexts": ["basic physical units"]}, {"entity_id": "atoms", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Atoms", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 8, "variants": ["Atoms", "atoms"], "contexts": ["fundamental particles of matter and medium", "fundamental particles of matter"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "elemental atoms", "target_book": "first_principles_spencer_1862", "target_name": "atoms", "similarity": 0.968}, {"source_book": "principles_of_psychology_james_1890", "source_name": "atoms", "target_book": "kosmos_humboldt_1845", "target_name": "atoms", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "atoms", "target_book": "first_principles_spencer_1862", "target_name": "atoms of matter", "similarity": 0.97}, {"source_book": "kosmos_humboldt_1845", "source_name": "atoms", "target_book": "first_principles_spencer_1862", "target_name": "atoms of matter", "similarity": 0.97}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Atoms of matter", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Atoms", "similarity": 0.974}], "id": 84, "stable_key": "clu_c4a96010ebf95140", "ground_truth": {"modern_name": "atom", "confidence": "high", "type": "chemical", "note": "Early modern texts often refer to atoms as fundamental, indivisible particles, reflecting the philosophical rather than the modern quantum mechanical understanding.", "wikidata_id": "Q9121", "wikidata_description": "smallest unit of a chemical element", "wikipedia_url": "https://en.wikipedia.org/wiki/Atom", "wikipedia_extract": "Atoms are the basic particles of the chemical elements and the fundamental building blocks of matter. An atom consists of a nucleus of protons and generally neutrons, surrounded by an electromagnetically bound swarm of electrons. The chemical elements are distinguished from each other by the number of protons that are in their atoms. For example, any atom that contains 11 protons is sodium, and any atom that contains 29 protons is copper. Atoms with the same number of protons but a different number of neutrons are called isotopes of the same element. Atoms are extremely small, typically around 100 picometers across."}, "cross_references": [{"found_name": "molecules", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 364, "target_cluster_name": "molecules", "source_book": "principles_of_psychology_james_1890", "evidence_snippet": "this is all the resultant effect of variations in the _combination_ of certain simple elements of consciousness that always remain the same. These mental atoms or molecules are what Locke called 'simp", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for mental atoms"}, {"found_name": "chemists", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1124, "target_cluster_name": "chemists", "source_book": "first_principles_spencer_1862", "evidence_snippet": "seems impossible on any other condition than the existence of ultimate atoms; and though the combining weights of the respective elements are termed by chemists their “equivalents,” for the purpose of", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "reverse: assumed ultimate constituents, related to combining weights termed equivalents", "is_reverse": true}, {"found_name": "combining weights", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "first_principles_spencer_1862", "evidence_snippet": "specific weights, and therefore of specific sizes. The general law of definite proportions seems impossible on any other condition than the existence of ultimate atoms; and though the combining weight", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "of respective elements, termed 'equivalents'"}]}, {"canonical_name": "heart", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 5, "total_mentions": 35, "members": [{"entity_id": "heart", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "heart", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 6, "variants": ["heart"], "contexts": ["central organ of circulation", "organ associated with irascible passions"]}, {"entity_id": "heart", "book_id": "principles_of_psychology_james_1890", "name": "heart", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 11, "variants": ["heart"], "contexts": ["organ that pumps blood", "organ that stops and palpitates"]}, {"entity_id": "heart", "book_id": "kosmos_humboldt_1845", "name": "heart", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["heart"], "contexts": ["softened by nature when shaken", "organ shaken by sorrow"]}, {"entity_id": "heart", "book_id": "polyanthea_medicinal", "name": "heart", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["heart"], "contexts": ["organ affected by suffocation"]}, {"entity_id": "heart", "book_id": "first_principles_spencer_1862", "name": "heart", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 14, "variants": ["heart"], "contexts": ["initially aggregation of cells forming cavity and walls", "pulsating blood-vessel in embryo"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "heart", "target_book": "principles_of_psychology_james_1890", "target_name": "heart", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "heart", "target_book": "kosmos_humboldt_1845", "target_name": "heart", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "heart", "target_book": "polyanthea_medicinal", "target_name": "heart", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "heart", "target_book": "first_principles_spencer_1862", "target_name": "heart", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "heart", "target_book": "kosmos_humboldt_1845", "target_name": "heart", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "heart", "target_book": "polyanthea_medicinal", "target_name": "heart", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "heart", "target_book": "first_principles_spencer_1862", "target_name": "heart", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "heart", "target_book": "polyanthea_medicinal", "target_name": "heart", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "heart", "target_book": "first_principles_spencer_1862", "target_name": "heart", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "heart", "target_book": "first_principles_spencer_1862", "target_name": "heart", "similarity": 1.0}], "id": 85, "stable_key": "clu_33a86d0a2a695750", "ground_truth": {"modern_name": "heart", "confidence": "high", "type": "animal", "note": "Early modern texts treat the heart as a central organ for circulation and emotion, reflecting a blend of anatomical understanding and philosophical concepts.", "wikidata_id": "Q1072", "wikidata_description": "inner organ for the circulation of blood", "wikipedia_url": "https://en.wikipedia.org/wiki/Heart", "wikipedia_extract": "The heart is a muscular organ found in humans and other animals. This organ pumps blood through the blood vessels. The heart and blood vessels together make up the circulatory system. The pumped blood carries oxygen and nutrients to the tissue, while carrying metabolic waste such as carbon dioxide to the lungs. In humans, the heart is approximately the size of a closed fist and is located between the lungs, in the middle compartment of the chest, called the mediastinum. In humans, the heart is divided into four chambers: upper left and right atria and lower left and right ventricles."}, "cross_references": [{"found_name": "Aorta", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2696, "target_cluster_name": "Arteria magna", "source_book": "llm_generated", "evidence_snippet": "The aorta is the main artery that carries blood from the heart to the rest of the body.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The aorta is the main artery that carries blood from the heart to the rest of the body."}, {"found_name": "Artery", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1775, "target_cluster_name": "arterias", "source_book": "llm_generated", "evidence_snippet": "Arteries are blood vessels that carry blood away from the heart.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Arteries are blood vessels that carry blood away from the heart."}, {"found_name": "Blood", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1488, "target_cluster_name": "sangue", "source_book": "llm_generated", "evidence_snippet": "The heart pumps blood throughout the body.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The heart pumps blood throughout the body."}, {"found_name": "Blood vessels", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1267, "target_cluster_name": "blood-vessels", "source_book": "llm_generated", "evidence_snippet": "The heart is the central organ of the circulatory system, which includes blood vessels.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The heart is the central organ of the circulatory system, which includes blood vessels."}, {"found_name": "Capillaries", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3860, "target_cluster_name": "Capillaries", "source_book": "llm_generated", "evidence_snippet": "Capillaries are the smallest blood vessels, connecting arteries and veins, and are part of the circulatory system originating from the heart.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Capillaries are the smallest blood vessels, connecting arteries and veins, and are part of the circulatory system originating from the heart."}, {"found_name": "Circulation of the blood", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4168, "target_cluster_name": "circulation", "source_book": "llm_generated", "evidence_snippet": "The heart is the primary organ responsible for the circulation of the blood.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The heart is the primary organ responsible for the circulation of the blood."}, {"found_name": "Internal organs", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1428, "target_cluster_name": "internal organ", "source_book": "llm_generated", "evidence_snippet": "The heart is a vital internal organ.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The heart is a vital internal organ."}]}, {"canonical_name": "Variation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 34, "members": [{"entity_id": "variation", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "variation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["variation", "Variation"], "contexts": ["magnetic variation", "deviation of magnetic needle from true north"]}, {"entity_id": "variation", "book_id": "origin_of_species_darwin_1859", "name": "Variation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 26, "variants": ["Variation", "variation"], "contexts": ["change in species over time", "differences in inherited traits"]}, {"entity_id": "variation", "book_id": "kosmos_humboldt_1845", "name": "variation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["variation"], "contexts": ["magnetic declination"]}, {"entity_id": "variation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "variation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Variation", "variation"], "contexts": ["perturbation of lunar orbit", "perturbation in lunar orbit"]}, {"entity_id": "variation", "book_id": "first_principles_spencer_1862", "name": "variation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["variation"], "contexts": ["difference or change"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "variation", "target_book": "origin_of_species_darwin_1859", "target_name": "Variation", "similarity": 0.951}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "variation", "target_book": "kosmos_humboldt_1845", "target_name": "variation", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "variation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "variation", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "variation", "target_book": "first_principles_spencer_1862", "target_name": "variation", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Variation", "target_book": "kosmos_humboldt_1845", "target_name": "variation", "similarity": 0.951}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Variation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "variation", "similarity": 0.951}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Variation", "target_book": "first_principles_spencer_1862", "target_name": "variation", "similarity": 0.951}, {"source_book": "kosmos_humboldt_1845", "source_name": "variation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "variation", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "variation", "target_book": "first_principles_spencer_1862", "target_name": "variation", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "variation", "target_book": "first_principles_spencer_1862", "target_name": "variation", "similarity": 1.0}], "id": 86, "stable_key": "clu_7c462733575d98cb", "ground_truth": {"modern_name": "Variation", "confidence": "high", "type": "concept", "note": "The context 'magnetic variation' points to magnetic declination, but 'change in species over time' and 'magnetic variation' indicate the broader concept of change or deviation.", "wikidata_id": "Q1130761", "wikidata_description": "concept in linguistics, more than one way of saying the same thing", "wikipedia_url": "https://en.wikipedia.org/wiki/Variation%20%28linguistics%29", "wikipedia_extract": "Variation is a characteristic of language: there is more than one way of saying the same thing in a given language. Variation can exist in domains such as pronunciation (e.g., more than one way of pronouncing the same phoneme or the same word), lexicon (e.g., multiple words with the same meaning), grammar (e.g., different syntactic constructions expressing the same grammatical function), and other features. Different communities or individuals speaking the same language may differ from each other in their choices of which of the available linguistic features to use, and how often (inter-speaker variation), and the same speaker may make different choices on different occasions (intra-speaker variation). While diversity of variation exists, there are also some general boundaries on variation. For instance, speakers across distinct dialects of a language tend to preserve the same word order or fit new sounds into the language's established inventory of phonemes (the study of such restrictions known as phonotactics, morphotactics, etc.); however, exceptions to these restrictions are possible too. Linguistic variation does not equate to ungrammatical usage of the language, but speakers are still (often unconsciously) sensitive to what is and is not possible in their native lect."}, "cross_references": [{"found_name": "Divergence of Character", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1796, "target_cluster_name": "Divergence of Character", "source_book": "llm_generated", "evidence_snippet": "The entity 'Variation' is defined as the existence of multiple ways of saying the same thing, which directly relates to the concept of 'Divergence of Character' as a manifestation of variation in language or other systems.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The entity 'Variation' is defined as the existence of multiple ways of saying the same thing, which directly relates to the concept of 'Divergence of Character' as a manifestation of variation in language or other systems."}]}, {"canonical_name": "metal", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 9, "total_mentions": 76, "members": [{"entity_id": "metal", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Metal", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Metal"], "contexts": ["molten substance in which crystal swims", "lustrous, cond