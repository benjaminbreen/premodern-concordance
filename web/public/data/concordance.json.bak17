}, "cross_references": [{"found_name": "Helvigius", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 985, "target_cluster_name": "Helvigius", "source_book": "llm_generated", "evidence_snippet": "Both were prominent astronomers who made significant contributions to the study of the Moon and celestial mapping. Cassini was Hevelius's predecessor and successor as Royal Astronomer in Danzig, and they corresponded and influenced each other's work.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were prominent astronomers who made significant contributions to the study of the Moon and celestial mapping. Cassini was Hevelius's predecessor and successor as Royal Astronomer in Danzig, and they corresponded and influenced each other's work.", "is_reverse": true}, {"found_name": "Alexis Bouvard", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3594, "target_cluster_name": "M. Bouvard", "source_book": "llm_generated", "evidence_snippet": "Both were astronomers working in France during the same period, and Cassini was director of the Paris Observatory where Bouvard also worked.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were astronomers working in France during the same period, and Cassini was director of the Paris Observatory where Bouvard also worked."}, {"found_name": "Alexis Petit", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1454, "target_cluster_name": "Petit", "source_book": "llm_generated", "evidence_snippet": "Both were astronomers working in France during the same period, and Cassini was director of the Paris Observatory where Petit also worked.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were astronomers working in France during the same period, and Cassini was director of the Paris Observatory where Petit also worked."}, {"found_name": "Charles Messier", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2002, "target_cluster_name": "Messier", "source_book": "llm_generated", "evidence_snippet": "Messier was a famous comet hunter and cataloger of nebulae who worked in Paris during the later part of Cassini's directorship of the Paris Observatory. Cassini's work laid foundational groundwork for Messier's catalog.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Messier was a famous comet hunter and cataloger of nebulae who worked in Paris during the later part of Cassini's directorship of the Paris Observatory. Cassini's work laid foundational groundwork for Messier's catalog."}, {"found_name": "Galileo Galilei", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 931, "target_cluster_name": "Galileo", "source_book": "llm_generated", "evidence_snippet": "Cassini succeeded Galileo as a prominent observational astronomer in Italy and later France, building upon and extending Galileo's work in astronomy, particularly in planetary observation and the study of Jupiter's moons.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Cassini succeeded Galileo as a prominent observational astronomer in Italy and later France, building upon and extending Galileo's work in astronomy, particularly in planetary observation and the study of Jupiter's moons."}, {"found_name": "Messier", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2002, "target_cluster_name": "Messier", "source_book": "llm_generated", "evidence_snippet": "Giovanni Domenico Cassini was an Italian-French astronomer whose work at the Paris Observatory, where Messier later worked, laid groundwork for astronomical cataloging.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Giovanni Domenico Cassini was an Italian-French astronomer whose work at the Paris Observatory, where Messier later worked, laid groundwork for astronomical cataloging.", "is_reverse": true}]}, {"canonical_name": "hypothesis", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "hypothesis", "book_id": "origin_of_species_darwin_1859", "name": "hypothesis", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["hypothesis"], "contexts": ["proposed explanation for phenomena"]}, {"entity_id": "hypothesis", "book_id": "principles_of_psychology_james_1890", "name": "hypothesis", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["hypothesis"], "contexts": ["proposed explanation for phenomena", "proposed explanation to be tested"]}, {"entity_id": "hypothesis", "book_id": "kosmos_humboldt_1845", "name": "hypothesis", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["hypothesis"], "contexts": ["alternative to a scientific theory", "convenient or bold idea"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "hypothesis", "target_book": "principles_of_psychology_james_1890", "target_name": "hypothesis", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "hypothesis", "target_book": "kosmos_humboldt_1845", "target_name": "hypothesis", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "hypothesis", "target_book": "kosmos_humboldt_1845", "target_name": "hypothesis", "similarity": 1.0}], "id": 1082, "stable_key": "clu_953b92350dd8e925", "ground_truth": {"modern_name": "hypothesis", "confidence": "high", "type": "concept", "wikidata_id": "Q5961247", "wikidata_description": "US nonprofit organization that develops and stewards technologies and practices to annotate the web", "wikipedia_url": "https://en.wikipedia.org/wiki/Hypothes.is", "wikipedia_extract": "Hypothes.is is an open-source software project that aims to collect comments about statements made in any web-accessible content, and filter and rank those comments to assess each statement's credibility. It has been summarized as \"a peer review layer for the entire Internet.\" The project is a system which allows annotation of web pages, using comments contributed by individuals and a reputation system for rating the comments. The plan is that the comments will be stored in the Internet Archive. Normal use is with a browser plug-in (Chrome) or a bookmarklet (others), and the plan is that links to specific comments will also be viewable without needing a plug-in. The project is led by Dan Whaley, co-founder of GetThere, one of the first online travel booking systems in 1995. Its advisors have included John Perry Barlow, Charles Bazerman, Philip Bourne and Brewster Kahle."}, "cross_references": [{"found_name": "Conceivability", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4248, "target_cluster_name": "conceivability", "source_book": "llm_generated", "evidence_snippet": "A hypothesis must be conceivable to be formulated.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "A hypothesis must be conceivable to be formulated."}, {"found_name": "Conception", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 282, "target_cluster_name": "conception", "source_book": "llm_generated", "evidence_snippet": "The formation of a hypothesis is a form of conception.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The formation of a hypothesis is a form of conception."}]}, {"canonical_name": "Cornea", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "cornea", "book_id": "origin_of_species_darwin_1859", "name": "cornea", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["cornea"], "contexts": ["outer transparent layer of eye"]}, {"entity_id": "cornea", "book_id": "principles_of_psychology_james_1890", "name": "cornea", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["cornea"], "contexts": ["transparent outer layer of eye"]}, {"entity_id": "cornea", "book_id": "polyanthea_medicinal", "name": "Cornea", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["Cornea"], "contexts": ["third tunic of the eye", "part of the eye affected by Sugillaçaō"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "cornea", "target_book": "principles_of_psychology_james_1890", "target_name": "cornea", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "cornea", "target_book": "polyanthea_medicinal", "target_name": "Cornea", "similarity": 0.963}, {"source_book": "principles_of_psychology_james_1890", "source_name": "cornea", "target_book": "polyanthea_medicinal", "target_name": "Cornea", "similarity": 0.963}], "id": 1083, "stable_key": "clu_c63737c32523f349", "ground_truth": {"modern_name": "cornea", "confidence": "high", "type": "anatomy", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Cornea", "wikipedia_extract": "The cornea is the transparent front part of the eyeball which covers the iris, pupil, and anterior chamber. Along with the anterior chamber and lens, the cornea refracts light, accounting for approximately two-thirds of the eye's total optical power. In humans, the refractive power of the cornea is approximately 43 dioptres. The cornea can be reshaped by surgical procedures such as LASIK. While the cornea contributes most of the eye's focusing power, its focus is fixed. Accommodation (the refocusing of light to better view near objects) is accomplished by changing the geometry of the lens."}, "cross_references": [{"found_name": "Eye", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 81, "target_cluster_name": "eye", "source_book": "llm_generated", "evidence_snippet": "The cornea is a part of the eye.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The cornea is a part of the eye."}, {"found_name": "Eyes", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 81, "target_cluster_name": "eye", "source_book": "llm_generated", "evidence_snippet": "The cornea is a part of the eye.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The cornea is a part of the eye."}, {"found_name": "Iris", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2909, "target_cluster_name": "Iris", "source_book": "llm_generated", "evidence_snippet": "The cornea is adjacent to and covers the iris.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The cornea is adjacent to and covers the iris."}, {"found_name": "Optic Nerve", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1021, "target_cluster_name": "optic nerves", "source_book": "llm_generated", "evidence_snippet": "The cornea is part of the optical system of the eye, working in conjunction with the optic nerve.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The cornea is part of the optical system of the eye, working in conjunction with the optic nerve."}, {"found_name": "Optical axis", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 979, "target_cluster_name": "Optic axis", "source_book": "llm_generated", "evidence_snippet": "The cornea is a key component in the optical axis of the eye, responsible for light refraction.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The cornea is a key component in the optical axis of the eye, responsible for light refraction."}]}, {"canonical_name": "Marine plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "marine_productions", "book_id": "origin_of_species_darwin_1859", "name": "marine productions", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["marine productions"], "contexts": ["organisms living in the sea"]}, {"entity_id": "cellular_marine_plants", "book_id": "kosmos_humboldt_1845", "name": "cellular marine plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["cellular marine plants"], "contexts": ["simple aquatic plants"]}, {"entity_id": "marine_plants", "book_id": "kosmos_humboldt_1845", "name": "marine plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["marine plants"], "contexts": ["plants found in chalk strata"]}, {"entity_id": "marine_plants", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Marine plants", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Marine Plants", "Marine plants"], "contexts": ["plants growing in the sea", "plants distributed in the sea"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "marine productions", "target_book": "kosmos_humboldt_1845", "target_name": "marine plants", "similarity": 0.881}, {"source_book": "origin_of_species_darwin_1859", "source_name": "marine productions", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Marine plants", "similarity": 0.881}, {"source_book": "kosmos_humboldt_1845", "source_name": "cellular marine plants", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Marine plants", "similarity": 0.899}, {"source_book": "kosmos_humboldt_1845", "source_name": "marine plants", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Marine plants", "similarity": 0.989}], "id": 1084, "stable_key": "clu_5b85ac0dda65b3cf", "ground_truth": {"modern_name": "Marine flora", "confidence": "medium", "type": "plant", "note": "While 'Marine plants' is the most direct, 'marine productions' and 'cellular marine plants' suggest a broader inclusion. 'Balis maritima' could be a specific species, but the cluster is broad.", "wikidata_id": "Q111240775", "wikidata_description": "plants that live in marine habitats", "wikipedia_url": "https://en.wikipedia.org/wiki/Marine%20plant", "wikipedia_extract": "Marine primary production is the chemical synthesis in the ocean of organic compounds from atmospheric or dissolved carbon dioxide. It principally occurs through the process of photosynthesis, which uses light as its source of energy, but it also occurs through chemosynthesis, which uses the oxidation or reduction of inorganic chemical compounds as its source of energy. Almost all life on Earth relies directly or indirectly on primary production. The organisms responsible for primary production are called primary producers or autotrophs. Most marine primary production is generated by a diverse collection of marine microorganisms called algae and cyanobacteria. Together these form the principal primary producers at the base of the ocean food chain and produce half of the world's oxygen."}, "cross_references": [{"found_name": "Fucus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2402, "target_cluster_name": "fucus", "source_book": "llm_generated", "evidence_snippet": "Fucus is a genus of brown algae, commonly known as rockweeds, which are prominent marine plants.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Fucus is a genus of brown algae, commonly known as rockweeds, which are prominent marine plants."}, {"found_name": "Floras", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2595, "target_cluster_name": "Floras", "source_book": "llm_generated", "evidence_snippet": "Marine flora is a specific type of flora, defined by its habitat (marine environments).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Marine flora is a specific type of flora, defined by its habitat (marine environments).", "is_reverse": true}, {"found_name": "Corallines", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2938, "target_cluster_name": "Corallines", "source_book": "llm_generated", "evidence_snippet": "Corallines are marine organisms, and 'Marine flora' is a broad category encompassing all plant and plant-like life in the sea. Corallines would be a specific component of marine flora.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Corallines are marine organisms, and 'Marine flora' is a broad category encompassing all plant and plant-like life in the sea. Corallines would be a specific component of marine flora.", "is_reverse": true}]}, {"canonical_name": "palato", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "palate", "book_id": "origin_of_species_darwin_1859", "name": "palate", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["palate"], "contexts": ["roof of the mouth"]}, {"entity_id": "palate", "book_id": "principles_of_psychology_james_1890", "name": "palate", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["palate"], "contexts": ["roof of the mouth"]}, {"entity_id": "palato", "book_id": "polyanthea_medicinal", "name": "palato", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["palato", "pala"], "contexts": ["palate", "palate, affected by nerve damage"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "palate", "target_book": "principles_of_psychology_james_1890", "target_name": "palate", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "palate", "target_book": "polyanthea_medicinal", "target_name": "palato", "similarity": 0.961}, {"source_book": "principles_of_psychology_james_1890", "source_name": "palate", "target_book": "polyanthea_medicinal", "target_name": "palato", "similarity": 0.961}], "id": 1085, "stable_key": "clu_128f77a376271190", "ground_truth": {"modern_name": "Palate", "confidence": "high", "type": "anatomy", "description": "The roof of the mouth, a part of the oral anatomy.", "wikipedia_extract": "The palate () is the roof of the mouth in humans and other mammals. It separates the oral cavity from the nasal cavity. A similar structure is found in crocodilians, but in most other tetrapods, the oral and nasal cavities are not truly separated. The palate is divided into two parts, the anterior, bony hard palate and the posterior, fleshy soft palate (or velum). The maxillary nerve branch of the trigeminal nerve supplies sensory innervation to the palate. If the fusion is incomplete,  a cleft palate results."}, "cross_references": [{"found_name": "boca", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 649, "target_cluster_name": "boca", "source_book": "llm_generated", "evidence_snippet": "The palate forms the roof of the mouth.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The palate forms the roof of the mouth.", "is_reverse": true}, {"found_name": "Mouth", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 237, "target_cluster_name": "Mouth", "source_book": "llm_generated", "evidence_snippet": "The palate is the roof of the mouth.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The palate is the roof of the mouth."}, {"found_name": "Cavity (anatomical)", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1477, "target_cluster_name": "cavities", "source_book": "llm_generated", "evidence_snippet": "The palate forms the roof of the oral cavity and separates it from the nasal cavity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The palate forms the roof of the oral cavity and separates it from the nasal cavity."}, {"found_name": "Nose", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 225, "target_cluster_name": "nariz", "source_book": "llm_generated", "evidence_snippet": "The palate separates the oral cavity from the nasal cavity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The palate separates the oral cavity from the nasal cavity."}]}, {"canonical_name": "Liverpool", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "liverpool", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Liverpool", "category": "PLACE", "subcategory": "CITY", "count": 5, "variants": ["Liverpool"], "contexts": ["city in England", "port for voyages"]}, {"entity_id": "liverpool", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Liverpool", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Liverpool"], "contexts": ["home of Mr. Lassell"]}, {"entity_id": "liverpool", "book_id": "first_principles_spencer_1862", "name": "Liverpool", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Liverpool"], "contexts": ["Liverpool has assumed the office of importing cotton"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Liverpool", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Liverpool", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Liverpool", "target_book": "first_principles_spencer_1862", "target_name": "Liverpool", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Liverpool", "target_book": "first_principles_spencer_1862", "target_name": "Liverpool", "similarity": 1.0}], "id": 1086, "stable_key": "clu_c2b4a49597ef3f70", "ground_truth": {"modern_name": "Liverpool", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q24826", "wikidata_description": "city in Merseyside, England, United Kingdom", "wikipedia_url": "https://en.wikipedia.org/wiki/Liverpool", "wikipedia_extract": "Liverpool is a port city and metropolitan borough in Merseyside, England. It is situated on the eastern side of the Mersey Estuary, near the Irish Sea, 178 miles (286 km) north-west of London. It had a population of 508,961 in 2024 and is the administrative, cultural and economic centre of the Liverpool City Region, a combined authority area with a population of over 1.5 million. Established as a borough in Lancashire in 1207, Liverpool became significant in the late 17th century when the Port of Liverpool was heavily involved in the Atlantic slave trade. The port also imported cotton for the Lancashire textile mills, and became a major departure point for English and Irish emigrants to North America. Liverpool rose to global economic importance at the forefront of the Industrial Revolution in the 19th century and was home to the first inter-city railway, the first non-combustible warehouse system (the Royal Albert Dock), and a pioneering elevated electrical railway; it was granted city status in 1880 and was moved from Lancashire to the newly created county of Merseyside in 1974."}, "cross_references": [{"found_name": "England", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 65, "target_cluster_name": "England", "source_book": "llm_generated", "evidence_snippet": "Liverpool is a city within England.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Liverpool is a city within England."}, {"found_name": "Glasgow", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1234, "target_cluster_name": "Glasgow", "source_book": "llm_generated", "evidence_snippet": "Liverpool is a major city in England, historically and geographically closely linked to Glasgow as another significant port city in the United Kingdom.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Liverpool is a major city in England, historically and geographically closely linked to Glasgow as another significant port city in the United Kingdom.", "is_reverse": true}, {"found_name": "Lancashire", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2170, "target_cluster_name": "Lancashire", "source_book": "llm_generated", "evidence_snippet": "Liverpool is a major city located within Lancashire.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Liverpool is a major city located within Lancashire.", "is_reverse": true}]}, {"canonical_name": "steppes", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "steppes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "steppes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["steppes"], "contexts": ["grassy plains", "plains"]}, {"entity_id": "steppes", "book_id": "kosmos_humboldt_1845", "name": "steppes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["steppes"], "contexts": ["dreary barrenness of the steppes", "grasslands in Northern Asia"]}, {"entity_id": "steppes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "steppes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["steppes"], "contexts": ["large areas of flat grassland"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "steppes", "target_book": "kosmos_humboldt_1845", "target_name": "steppes", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "steppes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "steppes", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "steppes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "steppes", "similarity": 1.0}], "id": 1087, "stable_key": "clu_5252bc7ce0d79301", "ground_truth": {"modern_name": "steppe", "confidence": "high", "type": "place", "country": "Various (Eurasia)"}, "cross_references": []}, {"canonical_name": "Gibraltar", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "gibraltar", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Gibraltar", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Gibraltar"], "contexts": ["city in Maracaybo province", "city in Venezuela"]}, {"entity_id": "straits_of_gibraltar", "book_id": "kosmos_humboldt_1845", "name": "Straits of Gibraltar", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Straits of Gibraltar"], "contexts": ["strait connecting Atlantic and Mediterranean"]}, {"entity_id": "straits_of_gibraltar", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Straits of Gibraltar", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Straits of Gibraltar"], "contexts": ["narrow strait influencing tides"]}, {"entity_id": "gibraltar,_the_straits_of", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Gibraltar, the Straits of", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Gibraltar, the Straits of"], "contexts": ["turning aside the tidal wave"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Gibraltar", "target_book": "kosmos_humboldt_1845", "target_name": "Straits of Gibraltar", "similarity": 0.95}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Gibraltar", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Straits of Gibraltar", "similarity": 0.95}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Gibraltar", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Gibraltar, the Straits of", "similarity": 0.938}, {"source_book": "kosmos_humboldt_1845", "source_name": "Straits of Gibraltar", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Straits of Gibraltar", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Straits of Gibraltar", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Gibraltar, the Straits of", "similarity": 0.972}], "id": 1088, "stable_key": "clu_6ef3f476c3f3a130", "ground_truth": {"modern_name": "Strait of Gibraltar", "confidence": "high", "type": "place", "country": "Spain", "wikidata_id": "Q36124", "wikidata_description": "strait that connects the Atlantic Ocean to the Mediterranean Sea", "wikipedia_url": "https://en.wikipedia.org/wiki/Strait%20of%20Gibraltar", "wikipedia_extract": "The Strait of Gibraltar, also known as the Straits of Gibraltar, is a narrow strait that connects the Atlantic Ocean to the Mediterranean Sea and separates Europe from Africa. The two continents are separated by 7.7 nautical miles (14.2 kilometers, 8.9 miles) at its narrowest point. Ferries cross between the two continents every day in as little as 35 minutes. The Strait's depth ranges between 300 and 900 metres (980 and 2,950 feet; 160 and 490 fathoms). The strait lies in the territorial waters of Morocco, Spain, and the British overseas territory of Gibraltar. Under the United Nations Convention on the Law of the Sea, foreign vessels and aircraft have the freedom of navigation and overflight to cross the strait of Gibraltar in case of continuous transit."}, "cross_references": [{"found_name": "Africa", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3, "target_cluster_name": "Africa", "source_book": "llm_generated", "evidence_snippet": "The Strait of Gibraltar separates Europe from Africa.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Strait of Gibraltar separates Europe from Africa."}, {"found_name": "Europe", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 30, "target_cluster_name": "Europe", "source_book": "llm_generated", "evidence_snippet": "The Strait of Gibraltar separates Europe from Africa.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Strait of Gibraltar separates Europe from Africa."}, {"found_name": "Atlantic Ocean", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 318, "target_cluster_name": "Atlantic", "source_book": "llm_generated", "evidence_snippet": "The Strait of Gibraltar connects the Atlantic Ocean to the Mediterranean Sea.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Strait of Gibraltar connects the Atlantic Ocean to the Mediterranean Sea."}, {"found_name": "Mediterranean Sea", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 256, "target_cluster_name": "Méditerranée", "source_book": "llm_generated", "evidence_snippet": "The Strait of Gibraltar connects the Atlantic Ocean to the Mediterranean Sea.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Strait of Gibraltar connects the Atlantic Ocean to the Mediterranean Sea."}]}, {"canonical_name": "Montpellier", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "montpellier", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Montpellier", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Montpellier"], "contexts": ["city for temperature comparison", "location of oscillation extent observations"]}, {"entity_id": "montpellier", "book_id": "kosmos_humboldt_1845", "name": "Montpellier", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Montpellier"], "contexts": ["city with mild winter temperature", "city with mean winter temperature"]}, {"entity_id": "montpellier", "book_id": "coloquios_da_orta_1563", "name": "Montpellier", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Montpellier"], "contexts": ["city in France"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Montpellier", "target_book": "kosmos_humboldt_1845", "target_name": "Montpellier", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Montpellier", "target_book": "coloquios_da_orta_1563", "target_name": "Montpellier", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Montpellier", "target_book": "coloquios_da_orta_1563", "target_name": "Montpellier", "similarity": 1.0}], "id": 1089, "stable_key": "clu_420c5296b05af1ab", "ground_truth": {"modern_name": "Montpellier", "confidence": "high", "type": "place", "description": "City in southern France known for its university and climate.", "wikipedia_extract": "Montpellier (UK: ; US: ) is a city in southern France near the Mediterranean Sea. One of the largest urban centres in the region of Occitania, Montpellier is the prefecture of the department of Hérault. As of 2023, 310,240 people live in the city proper, while its metropolitan area has a population of 813,272 as of 2020. Montpellier is the third-largest French city near the Mediterranean coast, behind Marseille and Nice, and the seventh-largest city of France overall. The inhabitants are called Montpelliérains. In the Middle Ages, Montpellier was an important city of the Crown of Aragon (and was the birthplace of James I), and then of Majorca, before its sale to France in 1349."}, "cross_references": []}, {"canonical_name": "pyrites", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "pyrites", "book_id": "relation_historique_humboldt_vol3_1825", "name": "pyrites", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["pyrites"], "contexts": ["iron sulfide mineral", "Sulfide mineral, often iron pyrite"]}, {"entity_id": "pyrites", "book_id": "kosmos_humboldt_1845", "name": "pyrites", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["pyrites"], "contexts": ["mineral found in hailstones", "mineral in volcanic phenomena"]}, {"entity_id": "iron_pyrites", "book_id": "kosmos_humboldt_1845", "name": "iron pyrites", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["iron pyrites"], "contexts": ["mineral causing brownish-red crusts on rocks"]}, {"entity_id": "iron_pyrites", "book_id": "first_principles_spencer_1862", "name": "iron pyrites", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["iron pyrites"], "contexts": ["mineral forming nodules in chalk"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "pyrites", "target_book": "kosmos_humboldt_1845", "target_name": "pyrites", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "pyrites", "target_book": "kosmos_humboldt_1845", "target_name": "iron pyrites", "similarity": 0.887}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "pyrites", "target_book": "first_principles_spencer_1862", "target_name": "iron pyrites", "similarity": 0.887}, {"source_book": "kosmos_humboldt_1845", "source_name": "pyrites", "target_book": "first_principles_spencer_1862", "target_name": "iron pyrites", "similarity": 0.887}, {"source_book": "kosmos_humboldt_1845", "source_name": "iron pyrites", "target_book": "first_principles_spencer_1862", "target_name": "iron pyrites", "similarity": 1.0}], "id": 1090, "stable_key": "clu_acab2588de7e4901", "ground_truth": {"modern_name": "Pyrite", "confidence": "high", "type": "mineral", "wikidata_id": "Q50769", "wikidata_description": "iron(II) disulfide mineral", "wikipedia_url": "https://en.wikipedia.org/wiki/Pyrite", "wikipedia_extract": "The mineral pyrite ( PY-ryte), or iron pyrite, also known as fool's gold, is an iron sulfide with the chemical formula FeS2 (iron (II) disulfide). Pyrite is the most abundant sulfide mineral. Pyrite's metallic luster and pale brass-yellow hue give it a superficial resemblance to gold, hence the well-known nickname of fool's gold. The color has also led to the nicknames brass, brazzle, and brazil, primarily used to refer to pyrite found in coal. The name pyrite is derived from the Greek πυρίτης λίθος (pyritēs lithos), 'stone or mineral which strikes fire', in turn from πῦρ (pŷr), 'fire'. In ancient Roman times, this name was applied to several types of stone that would create sparks when struck against steel; Pliny the Elder described one of them as being brassy, almost certainly a reference to what is now called pyrite."}, "cross_references": [{"found_name": "Sulfur", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1820, "target_cluster_name": "Sulfur", "source_book": "llm_generated", "evidence_snippet": "Pyrite is a mineral composed of iron and sulfur, historically known as 'fool's gold'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Pyrite is a mineral composed of iron and sulfur, historically known as 'fool's gold'.", "is_reverse": true}, {"found_name": "Brass", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 440, "target_cluster_name": "Brass", "source_book": "llm_generated", "evidence_snippet": "Pyrite's metallic luster and pale brass-yellow hue give it a superficial resemblance to gold, hence the well-known nickname 'fool's gold'. Brass is also a yellow metal alloy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Pyrite's metallic luster and pale brass-yellow hue give it a superficial resemblance to gold, hence the well-known nickname 'fool's gold'. Brass is also a yellow metal alloy."}]}, {"canonical_name": "Louis XIV", "category": "PERSON", "subcategory": "PATRON", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "louis_xiv", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Louis XIV", "category": "PERSON", "subcategory": "PATRON", "count": 3, "variants": ["Louis XIV"], "contexts": ["commissioned canal construction", "Lorsque Louis XIV voulut embellir"]}, {"entity_id": "luiz_xiv", "book_id": "coloquios_da_orta_1563", "name": "Luiz XIV", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Luiz XIV"], "contexts": ["king of France, received ambassadors"]}, {"entity_id": "luis_xiv_", "book_id": "polyanthea_medicinal", "name": "Luis XIV.", "category": "PERSON", "subcategory": "PATRON", "count": 3, "variants": ["Luis XIV.", "Luis XIV"], "contexts": ["King of France", "King of France who rewarded scholars"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Louis XIV", "target_book": "coloquios_da_orta_1563", "target_name": "Luiz XIV", "similarity": 0.915}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Louis XIV", "target_book": "polyanthea_medicinal", "target_name": "Luis XIV.", "similarity": 0.942}, {"source_book": "coloquios_da_orta_1563", "source_name": "Luiz XIV", "target_book": "polyanthea_medicinal", "target_name": "Luis XIV.", "similarity": 0.927}], "id": 1091, "stable_key": "clu_d3dee68e749318ce", "ground_truth": {"modern_name": "Louis XIV", "confidence": "high", "type": "person", "description": "King of France, patron of arts and sciences and ambitious builder.", "wikipedia_extract": "Louis XIV (Louis-Dieudonné; 5 September 1638 – 1 September 1715), also known as Louis the Great (Louis le Grand [lwi lə ɡʁɑ̃]) or the Sun King (le Roi Soleil [lə ʁwa sɔlɛj]), was King of France from 1643 until his death in 1715. His reign lasted 72 years and 110 days, which is the longest of any monarch in history. An emblem of the age of absolutism in Europe, Louis XIV's legacy includes French colonial expansion, the conclusion of the Thirty Years' War involving the Habsburgs, and a controlling influence on the style of fine arts and architecture in France, including the transformation of the Palace of Versailles into a center of royal power and politics. Louis XIV's pageantry and opulence helped define the French Baroque style of art and architecture and promoted his image as supreme leader of France in the early modern period. Louis XIV began his personal rule of France in 1661 after the death of his chief minister Cardinal Mazarin. A believer in the divine right of kings, Louis XIV continued Louis XIII's work of creating a centralized state governed from a capital."}, "cross_references": [{"found_name": "French", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 877, "target_cluster_name": "French", "source_book": "llm_generated", "evidence_snippet": "Louis XIV was a King of France, and thus a prominent figure associated with the French nation and its history.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Louis XIV was a King of France, and thus a prominent figure associated with the French nation and its history.", "is_reverse": true}, {"found_name": "Charles VIII of France", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2633, "target_cluster_name": "Carlos VIII", "source_book": "llm_generated", "evidence_snippet": "Charles VIII was a King of France, and Louis XIV was also a King of France. The succession of French monarchs is a direct and significant relationship.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Charles VIII was a King of France, and Louis XIV was also a King of France. The succession of French monarchs is a direct and significant relationship."}, {"found_name": "Charles II", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1161, "target_cluster_name": "Charles II", "source_book": "llm_generated", "evidence_snippet": "Charles II was a contemporary monarch and had significant political interactions with Louis XIV, particularly during his exile and after the Restoration.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Charles II was a contemporary monarch and had significant political interactions with Louis XIV, particularly during his exile and after the Restoration.", "is_reverse": true}]}, {"canonical_name": "electrometer", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "électromètre", "book_id": "relation_historique_humboldt_vol3_1825", "name": "électromètre", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["électromètre", "électromètre de Volta"], "contexts": ["instrument for measuring electricity", "instrument used to measure atmospheric electricity"]}, {"entity_id": "electrometer", "book_id": "kosmos_humboldt_1845", "name": "electrometer", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 3, "variants": ["electrometer"], "contexts": ["device for measuring electric charge", "instrument for measuring electric charge"]}, {"entity_id": "electrometers", "book_id": "kosmos_humboldt_1845", "name": "electrometers", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["electrometers"], "contexts": ["instrument for measuring electricity"]}, {"entity_id": "electrometer", "book_id": "first_principles_spencer_1862", "name": "electrometer", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["electrometer"], "contexts": ["instrument for measuring electric potential"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "électromètre", "target_book": "kosmos_humboldt_1845", "target_name": "electrometer", "similarity": 0.976}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "électromètre", "target_book": "kosmos_humboldt_1845", "target_name": "electrometers", "similarity": 0.941}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "électromètre", "target_book": "first_principles_spencer_1862", "target_name": "electrometer", "similarity": 0.976}, {"source_book": "kosmos_humboldt_1845", "source_name": "electrometer", "target_book": "first_principles_spencer_1862", "target_name": "electrometer", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "electrometers", "target_book": "first_principles_spencer_1862", "target_name": "electrometer", "similarity": 0.964}], "id": 1092, "stable_key": "clu_ed8ca594b446273d", "ground_truth": {"modern_name": "Electrometer", "confidence": "high", "type": "object", "note": "The presence of 'électromètre' and the description 'device for measuring electric charge' confirm this identification. 'Electrodes' are related but distinct; however, the dominant term is electrometer.", "wikidata_id": "Q1982706", "wikidata_description": "instrument for measuring electric charge", "wikipedia_url": "https://en.wikipedia.org/wiki/Electrometer", "wikipedia_extract": "An electrometer is an electrical instrument for measuring electric charge or electrical potential difference. There are many different types, ranging from historical handmade mechanical instruments to high-precision electronic devices. Modern electrometers based on vacuum tube or solid-state technology can be used to make voltage and charge measurements with very low leakage currents, down to 1 femtoampere. A simpler but related instrument, the electroscope, works on similar principles but only indicates the relative magnitudes of voltages or charges. The gold-leaf electroscope was one of the instruments used to indicate electric charge. It is still used for science demonstrations but has been superseded in most applications by electronic measuring instruments."}, "cross_references": [{"found_name": "Thermometer", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 320, "target_cluster_name": "Thermometer", "source_book": "llm_generated", "evidence_snippet": "Both are scientific instruments used for measurement, though of different physical quantities.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both are scientific instruments used for measurement, though of different physical quantities.", "is_reverse": true}, {"found_name": "electrical machine", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 493, "target_cluster_name": "electrical machine", "source_book": "llm_generated", "evidence_snippet": "Electrometers are instruments used to measure electric potential, often used in conjunction with electrostatic generators to quantify their output.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Electrometers are instruments used to measure electric potential, often used in conjunction with electrostatic generators to quantify their output.", "is_reverse": true}, {"found_name": "hygromètre à baleine", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 830, "target_cluster_name": "hygromètre à baleine", "source_book": "llm_generated", "evidence_snippet": "Electrometers can be used in some types of hygrometers to measure electrical changes in substances as they absorb moisture.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Electrometers can be used in some types of hygrometers to measure electrical changes in substances as they absorb moisture.", "is_reverse": true}, {"found_name": "Galvanometer", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2211, "target_cluster_name": "galvanometer", "source_book": "llm_generated", "evidence_snippet": "Both electrometers and galvanometers are electrical measuring instruments. While galvanometers typically measure current, and electrometers measure charge or potential, they are closely related in the history and development of electrical measurement devices.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both electrometers and galvanometers are electrical measuring instruments. While galvanometers typically measure current, and electrometers measure charge or potential, they are closely related in the history and development of electrical measurement devices."}, {"found_name": "Lightning", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2213, "target_cluster_name": "lightning", "source_book": "llm_generated", "evidence_snippet": "Lightning is a natural phenomenon involving a massive discharge of static electricity, a concept directly related to the measurement capabilities of an electrometer.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Lightning is a natural phenomenon involving a massive discharge of static electricity, a concept directly related to the measurement capabilities of an electrometer."}]}, {"canonical_name": "electric explosions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "explosions_électriques", "book_id": "relation_historique_humboldt_vol3_1825", "name": "explosions électriques", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["explosions électriques"], "contexts": ["electrical discharge phenomenon", "electrical phenomena"]}, {"entity_id": "electric_explosions", "book_id": "kosmos_humboldt_1845", "name": "electric explosions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["electric explosions"], "contexts": ["phenomenon of lightning", "sudden release of electrical energy"]}, {"entity_id": "electric_explosions", "book_id": "connexion_physical_sciences_somerville_1858", "name": "electric explosions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["electric explosions"], "contexts": ["violent phenomena produced by storms"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "explosions électriques", "target_book": "kosmos_humboldt_1845", "target_name": "electric explosions", "similarity": 0.98}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "explosions électriques", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "electric explosions", "similarity": 0.98}, {"source_book": "kosmos_humboldt_1845", "source_name": "electric explosions", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "electric explosions", "similarity": 1.0}], "id": 1093, "stable_key": "clu_0f3afea025d1618a", "ground_truth": {"modern_name": "Electrical discharge", "confidence": "high", "type": "concept", "wikidata_id": "Q577484", "wikidata_description": "metal fabrication process whereby a desired shape is obtained by using electrical discharges to remove material", "wikipedia_url": "https://en.wikipedia.org/wiki/Electrical%20discharge%20machining", "wikipedia_extract": "Electrical discharge machining (EDM), also known as spark machining, spark eroding, die sinking, wire burning or wire erosion, is a metal fabrication process whereby a desired shape is obtained by using electrical discharges (sparks). Material is removed from the work piece by a series of rapidly recurring current discharges between two electrodes, separated by a dielectric liquid and subject to an electric voltage. One of the electrodes is called the tool-electrode(simply the tool or electrode), while the other is called the workpiece-electrode, or work piece. The process depends upon the tool and work piece not making physical contact. Extremely hard materials like carbides, ceramics, titanium alloys and heat treated tool steels that are very difficult to machine using conventional machining can be precisely machined by EDM. When the voltage between the two electrodes is increased, the intensity of the electric field in the volume between the electrodes becomes greater, causing dielectric break down of the liquid, and produces an electric arc."}, "cross_references": [{"found_name": "Explosion", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 3650, "target_cluster_name": "explosion", "source_book": "llm_generated", "evidence_snippet": "The term 'electric explosions' is used as a historical synonym for electrical discharge, highlighting its explosive nature.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The term 'electric explosions' is used as a historical synonym for electrical discharge, highlighting its explosive nature."}, {"found_name": "electric currents", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3070, "target_cluster_name": "electric currents", "source_book": "llm_generated", "evidence_snippet": "Electrical discharge is a rapid flow of electric current.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Electrical discharge is a rapid flow of electric current.", "is_reverse": true}, {"found_name": "thunder", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2062, "target_cluster_name": "thunder", "source_book": "llm_generated", "evidence_snippet": "Thunder is the sound produced by the rapid expansion of air heated by an electrical discharge (lightning).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Thunder is the sound produced by the rapid expansion of air heated by an electrical discharge (lightning).", "is_reverse": true}, {"found_name": "Atmospheric electricity", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3166, "target_cluster_name": "atmospheric electricity", "source_book": "llm_generated", "evidence_snippet": "Atmospheric electricity is a specific form of electrical phenomena that can manifest as electrical discharge.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Atmospheric electricity is a specific form of electrical phenomena that can manifest as electrical discharge."}, {"found_name": "Electric current", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 726, "target_cluster_name": "electric currents", "source_book": "llm_generated", "evidence_snippet": "Electrical discharge is a transient flow of electric current.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Electrical discharge is a transient flow of electric current."}, {"found_name": "Electrical phenomena", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3624, "target_cluster_name": "electrical phenomena", "source_book": "llm_generated", "evidence_snippet": "Electrical discharge is a type of electrical phenomenon.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Electrical discharge is a type of electrical phenomenon."}]}, {"canonical_name": "Indus", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "indus", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Indus", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Indus"], "contexts": ["river forming a limit", "river in Asia"]}, {"entity_id": "indus", "book_id": "coloquios_da_orta_1563", "name": "Indus", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Indus"], "contexts": ["river called Milan or Sinteu", "Latin name for a river"]}, {"entity_id": "indus", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Indus", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Indus"], "contexts": ["river delta where land was raised", "constellation traversed by comet"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Indus", "target_book": "coloquios_da_orta_1563", "target_name": "Indus", "similarity": 0.86}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Indus", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Indus", "similarity": 0.86}, {"source_book": "coloquios_da_orta_1563", "source_name": "Indus", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Indus", "similarity": 1.0}], "id": 1094, "stable_key": "clu_ab212d492d67deaf", "ground_truth": {"modern_name": "Indus River", "confidence": "high", "type": "place", "country": "Pakistan", "wikidata_id": "Q260018", "wikidata_description": "species of mammal"}, "cross_references": []}, {"canonical_name": "Quinine", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "quinine", "book_id": "relation_historique_humboldt_vol3_1825", "name": "quinine", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["quinine"], "contexts": ["supposed substance in Byrsonima Moureila"]}, {"entity_id": "quinine", "book_id": "principles_of_psychology_james_1890", "name": "quinine", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["quinine"], "contexts": ["substance applied to tongue"]}, {"entity_id": "quinine", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Quinine", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["quinine", "Quinine"], "contexts": ["source of fluorescent light", "solution producing fluorescence and dispersion"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "quinine", "target_book": "principles_of_psychology_james_1890", "target_name": "quinine", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "quinine", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Quinine", "similarity": 0.795}, {"source_book": "principles_of_psychology_james_1890", "source_name": "quinine", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Quinine", "similarity": 0.795}], "id": 1095, "stable_key": "clu_e04e05e36242d39b", "ground_truth": {"wikipedia_extract": "Quinine is a medication used to treat malaria and babesiosis. This includes the treatment of malaria due to Plasmodium falciparum that is resistant to chloroquine when artesunate is not available. While sometimes used for nocturnal leg cramps, quinine is not recommended for this purpose due to the risk of serious side effects. It can be taken by mouth or intravenously. Malaria resistance to quinine occurs in certain areas of the world. Quinine is also used as an ingredient in tonic water and other beverages to impart a bitter taste."}, "cross_references": []}, {"canonical_name": "Abel Rémusat", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "mm__abel_remusat", "book_id": "relation_historique_humboldt_vol3_1825", "name": "MM. Abel Remusat", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["MM. Abel Remusat"], "contexts": ["savante researcher of languages"]}, {"entity_id": "abel_rémusat", "book_id": "kosmos_humboldt_1845", "name": "Abel Rémusat", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Abel Rémusat"], "contexts": ["translator and scholar of Chinese", "author of scientific text"]}, {"entity_id": "abel_remusat", "book_id": "kosmos_humboldt_1845", "name": "Abel Remusat", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Abel Remusat"], "contexts": ["made known Thianschan mountains", "author of 'Lettre a M. Cordier'"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "MM. Abel Remusat", "target_book": "kosmos_humboldt_1845", "target_name": "Abel Rémusat", "similarity": 0.896}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "MM. Abel Remusat", "target_book": "kosmos_humboldt_1845", "target_name": "Abel Remusat", "similarity": 0.856}], "id": 1096, "stable_key": "clu_03c0835810d3581d", "ground_truth": {"modern_name": "Abel Rémusat", "confidence": "high", "type": "person", "birth_year": 1788, "death_year": 1832, "description": "French sinologist, orientalist, and linguist.", "wikidata_id": "Q716743", "wikidata_description": "French sinologist (1788-1832)", "wikipedia_url": "https://en.wikipedia.org/wiki/Jean-Pierre%20Abel-R%C3%A9musat", "wikipedia_extract": "Jean-Pierre Abel-Rémusat (French pronunciation: [ʒɑ̃ pjɛʁ abɛl ʁemyza]; 5 September 1788 – 2 June 1832) was a French sinologist best known as the first Chair of Sinology at the Collège de France. Rémusat studied medicine as a young man, but his discovery of a Chinese herbal treatise enamored him with the Chinese language, and he spent five years teaching himself to read it. After publishing several well-received articles on Chinese topics, a chair in Chinese was created at the Collège de France in 1814 and Rémusat was placed in it. Rémusat was born in Paris on 5 September 1788 and was educated for the medical profession, earning a doctorate in medicine in 1813. While studying medicine, Rémusat discovered a Chinese herbal treatise in the collection of the Abbé Tersan and was immediately fascinated by it. He taught himself to read it by tirelessly studying the traditional Chinese dictionary Zhengzitong."}, "cross_references": [{"found_name": "Augustin Pyramus de Candolle", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 721, "target_cluster_name": "De Candolle", "source_book": "llm_generated", "evidence_snippet": "Both were prominent figures in 19th-century natural history and science, with Rémusat being a sinologist and de Candolle a botanist. They likely interacted within the scientific circles of Paris.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were prominent figures in 19th-century natural history and science, with Rémusat being a sinologist and de Candolle a botanist. They likely interacted within the scientific circles of Paris."}, {"found_name": "Georges Cuvier", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 119, "target_cluster_name": "Cuvier", "source_book": "llm_generated", "evidence_snippet": "Both were prominent figures in 19th-century natural history and science in Paris. Cuvier was a leading zoologist and paleontologist, and Rémusat was a sinologist. They would have been contemporaries and likely acquainted within the scientific community.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were prominent figures in 19th-century natural history and science in Paris. Cuvier was a leading zoologist and paleontologist, and Rémusat was a sinologist. They would have been contemporaries and likely acquainted within the scientific community."}, {"found_name": "Alexander von Humboldt", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 42, "target_cluster_name": "Humboldt", "source_book": "llm_generated", "evidence_snippet": "Both were leading scientists of the 19th century. Humboldt was a renowned naturalist and explorer, while Rémusat was a pioneering sinologist. They were contemporaries and likely interacted within the scientific and intellectual circles of Europe.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were leading scientists of the 19th century. Humboldt was a renowned naturalist and explorer, while Rémusat was a pioneering sinologist. They were contemporaries and likely interacted within the scientific and intellectual circles of Europe."}]}, {"canonical_name": "espelho", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "miroir", "book_id": "relation_historique_humboldt_vol3_1825", "name": "miroir", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["miroir"], "contexts": ["reflective surface used for observation"]}, {"entity_id": "espelho", "book_id": "polyanthea_medicinal", "name": "espelho", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 4, "variants": ["espelho", "espelho quebrado", "espeçelho"], "contexts": ["object used for observation", "mirror"]}, {"entity_id": "mirrors", "book_id": "connexion_physical_sciences_somerville_1858", "name": "mirrors", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["mirrors"], "contexts": ["surfaces that reflect light"]}, {"entity_id": "mirror", "book_id": "connexion_physical_sciences_somerville_1858", "name": "mirror", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["mirror"], "contexts": ["instrument used in experiments"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "miroir", "target_book": "polyanthea_medicinal", "target_name": "espelho", "similarity": 0.961}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "miroir", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "mirrors", "similarity": 0.91}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "miroir", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "mirror", "similarity": 0.959}, {"source_book": "polyanthea_medicinal", "source_name": "espelho", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "mirrors", "similarity": 0.917}, {"source_book": "polyanthea_medicinal", "source_name": "espelho", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "mirror", "similarity": 0.963}], "id": 1097, "stable_key": "clu_22d6c3fe7a321a09", "ground_truth": {"modern_name": "Mirror", "confidence": "high", "type": "object", "wikidata_id": "", "wikidata_description": "family name"}, "cross_references": [{"found_name": "Glass", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 22, "target_clust