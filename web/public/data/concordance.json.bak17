ated", "found_relationship": "reverse: Adam is explicitly described as the first human being.", "is_reverse": true}]}, {"canonical_name": "Lima", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 45, "members": [{"entity_id": "lima", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Lima", "category": "PLACE", "subcategory": "CITY", "count": 33, "variants": ["Lima"], "contexts": ["city in Peru", "capital of Peru"]}, {"entity_id": "lima", "book_id": "kosmos_humboldt_1845", "name": "Lima", "category": "PLACE", "subcategory": "CITY", "count": 9, "variants": ["Lima"], "contexts": ["capital of Peru", "city near magnetic equator intersection"]}, {"entity_id": "lima", "book_id": "historia_medicinal_monardes_1574", "name": "Lima", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Lima"], "contexts": ["city where the letter was written", "city in Peru"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Lima", "target_book": "kosmos_humboldt_1845", "target_name": "Lima", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Lima", "target_book": "historia_medicinal_monardes_1574", "target_name": "Lima", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Lima", "target_book": "historia_medicinal_monardes_1574", "target_name": "Lima", "similarity": 1.0}], "id": 605, "stable_key": "clu_233ef58496bf7dbe", "ground_truth": {"modern_name": "Lima", "confidence": "high", "type": "place", "description": "Capital city of Peru, located on the Pacific coast.", "wikipedia_extract": "Lima is the capital and largest city of Peru. It is located in the valleys of the Chillón, Rímac and Lurín Rivers, in the desert zone of the central coastal part of the country, overlooking the Pacific Ocean. The city is considered the political, cultural, financial and commercial center of Peru. Due to its geostrategic importance, the Globalization and World Cities Research Network has categorized it as a \"beta\" tier city. Jurisdictionally, the metropolis extends mainly within the province of Lima and in a smaller portion, to the west, within the Constitutional Province of Callao, where the seaport and the Jorge Chávez Airport are located. Both provinces have had regional autonomy since 2002."}, "cross_references": [{"found_name": "Andes", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 207, "target_cluster_name": "Andes", "source_book": "llm_generated", "evidence_snippet": "Lima is located in the valleys of rivers that originate in the Andes mountains, and the Andes form a major geographical feature of Peru, the country of which Lima is the capital.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Lima is located in the valleys of rivers that originate in the Andes mountains, and the Andes form a major geographical feature of Peru, the country of which Lima is the capital."}]}, {"canonical_name": "North America", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 4, "total_mentions": 47, "members": [{"entity_id": "north_america", "book_id": "origin_of_species_darwin_1859", "name": "North America", "category": "PLACE", "subcategory": "COUNTRY", "count": 27, "variants": ["North America"], "contexts": ["birds and insects in North America", "continent with cave systems"]}, {"entity_id": "north_america", "book_id": "kosmos_humboldt_1845", "name": "North America", "category": "PLACE", "subcategory": "COUNTRY", "count": 14, "variants": ["North America"], "contexts": ["location of observed meteor showers", "location of phenomenon"]}, {"entity_id": "north_america", "book_id": "connexion_physical_sciences_somerville_1858", "name": "North America", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["North America"], "contexts": ["continent with plains", "independent Christian states like those of Union"]}, {"entity_id": "north_america