nd_relationship": "reverse: 61 Cygni is another star system that was historically significant in early measurements of stellar parallax and distance, similar to Alpha Centauri.", "is_reverse": true}, {"found_name": "Parallax", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1731, "target_cluster_name": "Parallax", "source_book": "llm_generated", "evidence_snippet": "61 Cygni was one of the first stars whose distance was measured using parallax, and its distance is often expressed in parsecs.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: 61 Cygni was one of the first stars whose distance was measured using parallax, and its distance is often expressed in parsecs.", "is_reverse": true}, {"found_name": "Aldebaran", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3027, "target_cluster_name": "Aldebaran", "source_book": "llm_generated", "evidence_snippet": "Both are stars, with Aldebaran being a prominent star often discussed in astronomical contexts alongside other celestial bodies.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are stars, with Aldebaran being a prominent star often discussed in astronomical contexts alongside other celestial bodies."}, {"found_name": "Celestial body", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3227, "target_cluster_name": "celestial body", "source_book": "llm_generated", "evidence_snippet": "61 Cygni is a specific example of a celestial body.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "61 Cygni is a specific example of a celestial body."}, {"found_name": "double star", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "kosmos_humboldt_1845", "evidence_snippet": "that the Earth is a distance of one foot from the Sun; Uranus is then 19 feet, and Vega Lyrae is 158 geographical miles from it. The distance of the star 61 Cygni, made known by Bessel, has led approx", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of"}]}, {"canonical_name": "mass", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "mass", "book_id": "kosmos_humboldt_1845", "name": "mass", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["mass"], "contexts": ["quantity of matter", "measure of matter in celestial bodies"]}, {"entity_id": "mass", "book_id": "connexion_physical_sciences_somerville_1858", "name": "mass", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 15, "variants": ["Mass", "mass"], "contexts": ["measure of matter", "quantity of matter in an object"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "mass", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "mass", "similarity": 1.0}], "id": 1746, "stable_key": "clu_c7d546b8c1d4eb42", "ground_truth": {"modern_name": "Mass", "confidence": "high", "type": "concept"}, "cross_references": []}, {"canonical_name": "Refraction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "refraction", "book_id": "kosmos_humboldt_1845", "name": "refraction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["refraction"], "contexts": ["bending of light"]}, {"entity_id": "refraction", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Refraction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 19, "variants": ["refraction", "Refraction"], "contexts": ["bending of light", "bending of light through different densities"]}, {"entity_id": "refractions", "book_id": "connexion_physical_sciences_somerville_1858", "name": "refractions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["refractions"], "contexts": ["bending of light"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "refraction", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Refraction", "similarity": 0.983}, {"source_book": "kosmos_humboldt_1845", "source_name": "refraction", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "refractions", "similarity": 0.948}], "id": 1747, "stable_key": "clu_77a381b408428091", "ground_truth": {"modern_name": "Refraction", "confidence": "high", "type": "concept", "wikidata_id": "Q72277", "wikidata_description": "in physics, the change in direction of a wave at the interface between two media", "wikipedia_url": "https://en.wikipedia.org/wiki/Refraction", "wikipedia_extract": "In physics, refraction is the redirection of a wave as it passes from one medium to another. The redirection can be caused by the wave's change in speed or by a change in the medium. Refraction of light is the most commonly observed phenomenon, but other waves such as sound waves and water waves also experience refraction. How much a wave is refracted is determined by the change in wave speed and the initial direction of wave propagation relative to the direction of change in speed. Optical prisms and lenses use refraction to redirect light, as does the human eye. The refractive index of materials varies with the wavelength of light, and thus the angle of the refraction also varies correspondingly."}, "cross_references": [{"found_name": "Interference of light", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3159, "target_cluster_name": "interference of light", "source_book": "llm_generated", "evidence_snippet": "Both phenomena describe the behavior of light waves.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both phenomena describe the behavior of light waves."}, {"found_name": "Conduction", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2567, "target_cluster_name": "conduction", "source_book": "llm_generated", "evidence_snippet": "Both refraction and conduction describe the transmission of energy or waves through a medium, though through different mechanisms.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both refraction and conduction describe the transmission of energy or waves through a medium, though through different mechanisms."}]}, {"canonical_name": "cura", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "curava", "book_id": "historia_medicinal_monardes_1574", "name": "curava", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["curava"], "contexts": ["illness the Cacique was being treated for"]}, {"entity_id": "cura", "book_id": "polyanthea_medicinal", "name": "cura", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 20, "variants": ["cura", "Cura", "cura , quocumque à morfu tempore"], "contexts": ["the act of healing", "process of healing"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "curava", "target_book": "polyanthea_medicinal", "target_name": "cura", "similarity": 0.916}], "id": 1748, "stable_key": "clu_e64c80da29026fad", "ground_truth": {"modern_name": "Cure", "confidence": "high", "type": "concept", "description": "The process of healing or the act of treating an illness.", "wikipedia_extract": "A cure is a substance or procedure that resolves a medical condition. This may include a medication, a surgical operation, a lifestyle change, or even a philosophical shift that alleviates a person's suffering or achieves a state of healing. The medical condition can be a disease, mental illness or genetic disorder. An incurable disease is not necessarily a terminal illness, and conversely, a curable illness can still be fatal. The cure fraction or cure rate—the proportion of people with a disease who are cured by a given treatment—is determined by comparing disease-free survival in treated individuals against a matched control group without the disease. Another method for determining the cure fraction and/or \"cure time\" involves measuring when the hazard rate in a diseased group returns to the hazard rate observed in the general population."}, "cross_references": [{"found_name": "Ulmeiro", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 3691, "target_cluster_name": "Olmo", "source_book": "polyanthea_medicinal", "evidence_snippet": "em que nafcem as moſcas ;& tem differentes nomes , porque huns the chamão Ulmeiro , outros Choupo , outros Salgueiro. A entrecaſca do pao do Ulmeiro cura o feu cozimento todas aschagas interiores,& ex", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for the tree with medicinal bark"}, {"found_name": "Choupo", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1215, "target_cluster_name": "Poplar", "source_book": "polyanthea_medicinal", "evidence_snippet": "em que nafcem as moſcas ;& tem differentes nomes , porque huns the chamão Ulmeiro , outros Choupo , outros Salgueiro. A entrecaſca do pao do Ulmeiro cura o feu cozimento todas aschagas interiores,& ex", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for the tree with medicinal bark"}, {"found_name": "Salgueiro", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1059, "target_cluster_name": "Willow", "source_book": "polyanthea_medicinal", "evidence_snippet": "em que nafcem as moſcas ;& tem differentes nomes , porque huns the chamão Ulmeiro , outros Choupo , outros Salgueiro. A entrecaſca do pao do Ulmeiro cura o feu cozimento todas aschagas interiores,& ex", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for the tree with medicinal bark"}]}, {"canonical_name": "páo", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 9, "total_mentions": 48, "members": [{"entity_id": "páo", "book_id": "coloquios_da_orta_1563", "name": "páo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 15, "variants": ["páo"], "contexts": ["source of camphor", "wood of the camphor tree"]}, {"entity_id": "paó", "book_id": "polyanthea_medicinal", "name": "paó", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["paó"], "contexts": ["bread, can be harmful to nerves", "food item"]}, {"entity_id": "timber", "book_id": "origin_of_species_darwin_1859", "name": "timber", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["timber"], "contexts": ["wood from trees"]}, {"entity_id": "bois", "book_id": "relation_historique_humboldt_vol3_1825", "name": "bois", "category": "PLANT", "subcategory": "TREE", "count": 7, "variants": ["bois", "bois de charpente", "bois de construction", "bois de saule"], "contexts": ["material for bundles", "fragments found in sandstone"]}, {"entity_id": "woods", "book_id": "kosmos_humboldt_1845", "name": "woods", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["woods"], "contexts": ["areas with many trees"]}, {"entity_id": "wood", "book_id": "connexion_physical_sciences_somerville_1858", "name": "wood", "category": "PLANT", "subcategory": "TREE", "count": 6, "variants": ["wood"], "contexts": ["material of floating balls", "material for making pipes"]}, {"entity_id": "timber", "book_id": "first_principles_spencer_1862", "name": "timber", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["timber"], "contexts": ["material imported for railways"]}, {"entity_id": "wood", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Wood", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Wood", "wood"], "contexts": ["material that putrifies", "material that can be converted into iron"]}, {"entity_id": "wood", "book_id": "english_physician_1652", "name": "Wood", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Wood"], "contexts": ["splinters of wood drawn forth", "material of the Poplar tree"]}, {"entity_id": "wood", "book_id": "kosmos_humboldt_1845", "name": "wood", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["wood"], "contexts": ["material for floating device", "hard fibrous material of trees"]}, {"entity_id": "wood", "book_id": "coloquios_da_orta_1563", "name": "wood", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["wood"], "contexts": ["aloes wood"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "páo", "target_book": "polyanthea_medicinal", "target_name": "paó", "similarity": 0.921}], "id": 1749, "stable_key": "clu_508e98f1ee660f9f", "ground_truth": {"modern_name": "Wood", "confidence": "high", "type": "concept", "note": "The context of 'timber', 'bois', and 'woods' consistently refers to the material derived from trees, used for construction, fuel, or as a habitat.", "wikidata_id": "Q105596644", "wikidata_description": "study of wood as a material and its physical, chemical, and biological characteristics", "wikipedia_url": "https://en.wikipedia.org/wiki/Wood%20science", "description": "The hard fibrous material forming the main substance of the trunk or branches of a tree or shrub.", "wikipedia_extract": "Wood is a structural tissue/material found as xylem in the stems and roots of trees and other woody plants. Being a natural material, it is characterized as an organic material – a natural composite of cellulosic fibers that are strong in tension and embedded in a matrix of lignin and hemicelluloses that resists compression. Wood is sometimes defined as only the secondary xylem in the stems of trees, or more broadly to include the same type of tissue elsewhere, such as in the roots of trees or shrubs. In a living tree, it performs a mechanical-support function, enabling woody plants to grow large or to stand up by themselves. It also conveys water and nutrients among the leaves, other growing tissues, and the roots. Wood may also refer to other plant materials with comparable properties, and to material engineered from wood, woodchips, or fibers."}, "member_count": 11, "cross_references": [{"found_name": "Vegetation", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 2157, "target_cluster_name": "Vegetation", "source_book": "llm_generated", "evidence_snippet": "Portuguese for 'Wood', a material derived from trees, a form of plant life.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "reverse: Portuguese for 'Wood', a material derived from trees, a form of plant life.", "is_reverse": true}, {"found_name": "Branches", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 806, "target_cluster_name": "Branches", "source_book": "llm_generated", "evidence_snippet": "Branches are a source of wood.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Branches are a source of wood.", "is_reverse": true}, {"found_name": "Bark", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1836, "target_cluster_name": "Bark", "source_book": "llm_generated", "evidence_snippet": "Bark is the outer layer of woody plants, often harvested and used alongside wood.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Bark is the outer layer of woody plants, often harvested and used alongside wood."}, {"found_name": "Fir-trees", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2182, "target_cluster_name": "Fir-trees", "source_book": "llm_generated", "evidence_snippet": "Wood is the material derived from trees, including fir trees.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Wood is the material derived from trees, including fir trees.", "is_reverse": true}, {"found_name": "Ash-tree", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2502, "target_cluster_name": "Ash-tree", "source_book": "llm_generated", "evidence_snippet": "Ash is a source of wood.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Ash is a source of wood.", "is_reverse": true}, {"found_name": "cedro", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2508, "target_cluster_name": "cedro", "source_book": "llm_generated", "evidence_snippet": "Cedar is a source of wood.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Cedar is a source of wood.", "is_reverse": true}, {"found_name": "rama", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2629, "target_cluster_name": "rama", "source_book": "llm_generated", "evidence_snippet": "A branch is a component of wood.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: A branch is a component of wood.", "is_reverse": true}, {"found_name": "freixo", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2632, "target_cluster_name": "freixo", "source_book": "llm_generated", "evidence_snippet": "Ash trees are a source of wood.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Ash trees are a source of wood.", "is_reverse": true}, {"found_name": "cobras de capelo", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "todavia ha muytas serpen- tes, a que chama o vulgo cobras de capelo; e nós em latim as podemos chamar regulus serpens; e pêra estas deu Deos nella este pao da cobra; e soubese aproveitar pêra a morde-", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for a type of serpent"}, {"found_name": "calambac", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "cantidade delle; e o mais fino chamase calambac U 59 O ucio que chamam na Europa chamase na índia cate; he mezinha muyto usada dos índios; fazse de hum pao muyto pesado; he mercadoria pêra Malaca e pê", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for the finest quality of the known entity"}, {"found_name": "regulus serpens", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "todavia ha muytas serpen- tes, a que chama o vulgo cobras de capelo; e nós em latim as podemos chamar regulus serpens; e pêra estas deu Deos nella este pao da cobra; e soubese aproveitar pêra a morde-", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "Latin name for cobras de capelo"}, {"found_name": "apas", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "e os mercado- res onde achão a lúcida, que he sua, não comprão a outra que se gasta em gente mesquinha, em comeres e mezinhas ; alguns a comem com o. pão, a que chamão apas. RUANO o cheiro he todo hum", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "vernacular name for 'pão'"}, {"found_name": "cate", "link_type": "derivation", "link_strength": 0.4, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "cantidade delle; e o mais fino chamase calambac U 59 O ucio que chamam na Europa chamase na índia cate; he mezinha muyto usada dos índios; fazse de hum pao muyto pesado; he mercadoria pêra Malaca e pê", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "Indian name for something made from a heavy wood, likely related to the known entity"}]}, {"canonical_name": "pimenta longa", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "pimenta_longa", "book_id": "coloquios_da_orta_1563", "name": "pimenta longa", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 14, "variants": ["pimenta longa", "PIMENTA LONGA", "pimenta longua"], "contexts": ["topic of colloquy", "Long pepper, a spice"]}, {"entity_id": "pimenta_longa", "book_id": "polyanthea_medicinal", "name": "pimenta longa", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["pimenta longa"], "contexts": ["spice for pill preparation", "ingredient in pills"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "pimenta longa", "target_book": "polyanthea_medicinal", "target_name": "pimenta longa", "similarity": 1.0}], "id": 1750, "stable_key": "clu_02aab75d35aedbe4", "ground_truth": {"modern_name": "Long Pepper", "confidence": "high", "type": "plant", "description": "A spice, a dried berry of the Piper longum plant.", "wikipedia_extract": "Long pepper (Piper longum),  sometimes called Indian long pepper or pippali, is a flowering vine in the family Piperaceae, cultivated for its fruit, which is usually dried and used as a spice and seasoning. Long pepper has a taste similar to, but sweeter and more pungent than, that of its close relative Piper nigrum – from which black, green and white pepper are obtained. The fruit of the pepper consists of many minuscule fruits – each about the size of a poppy seed – embedded in the surface of a flower spike that closely resembles a hazel tree catkin. Like Piper nigrum, the fruits contain the compound piperine, which contributes to their pungency. Another species of long pepper, Piper retrofractum, is native to Java, Indonesia. The fruits of this plant are often confused with chili peppers, which belong to the genus Capsicum, originally from the Americas."}, "cross_references": [{"found_name": "fel", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 3706, "target_cluster_name": "fel", "source_book": "coloquios_da_orta_1563", "evidence_snippet": "Jilfil, e asi a chamam os Arábios físicos e o vulgar. Se Avicena (se- gundo tralada o Belunense) a chama, Jul/ul, e darfulful á pimenta longa % tf ai fel, e Serapio • % que eram Arábios, to- davia me ", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "reverse: synonym for", "is_reverse": true}, {"found_name": "CuBEBAS", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 765, "target_cluster_name": "CuBEBAS", "source_book": "llm_generated", "evidence_snippet": "Both Cubeb pepper and Long Pepper are historical spices used in similar culinary and medicinal contexts, often grouped together as 'peppers' distinct from black pepper.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both Cubeb pepper and Long Pepper are historical spices used in similar culinary and medicinal contexts, often grouped together as 'peppers' distinct from black pepper.", "is_reverse": true}, {"found_name": "Cubeb pepper", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 765, "target_cluster_name": "CuBEBAS", "source_book": "llm_generated", "evidence_snippet": "Both are types of peppers used historically as spices, belonging to the Piperaceae family.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are types of peppers used historically as spices, belonging to the Piperaceae family."}, {"found_name": "Pepper", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 545, "target_cluster_name": "pimenta", "source_book": "llm_generated", "evidence_snippet": "Long pepper is a specific type of pepper, and 'Pepper' is a broader category that would encompass it.", "confidence": 0.85, "auto_label": "llm_related", "found