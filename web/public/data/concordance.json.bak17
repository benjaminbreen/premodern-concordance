ype": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1296, "target_cluster_name": "Apostles", "source_book": "llm_generated", "evidence_snippet": "The Apostles were the principal disciples of Jesus Christ.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Apostles were the principal disciples of Jesus Christ."}, {"found_name": "Devil", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2681, "target_cluster_name": "Devil", "source_book": "llm_generated", "evidence_snippet": "In Christian theology, the Devil is a primary antagonist of Jesus Christ.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "In Christian theology, the Devil is a primary antagonist of Jesus Christ."}, {"found_name": "Demon", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1104, "target_cluster_name": "demon", "source_book": "llm_generated", "evidence_snippet": "Demons are often depicted as followers or agents of the Devil, and thus in opposition to Jesus Christ.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Demons are often depicted as followers or agents of the Devil, and thus in opposition to Jesus Christ."}, {"found_name": "Eve", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2086, "target_cluster_name": "Eve", "source_book": "llm_generated", "evidence_snippet": "Eve is a significant figure in the biblical narrative that precedes and informs the story of Jesus Christ.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Eve is a significant figure in the biblical narrative that precedes and informs the story of Jesus Christ."}, {"found_name": "Adam", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 326, "target_cluster_name": "Adam", "source_book": "llm_generated", "evidence_snippet": "Adam is a significant figure in the biblical narrative that precedes and inf