et": "Newfoundland and Labrador is a region within North America.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Newfoundland and Labrador is a region within North America."}, {"found_name": "Canada", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 736, "target_cluster_name": "Canada", "source_book": "llm_generated", "evidence_snippet": "Newfoundland and Labrador is a province of Canada.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Newfoundland and Labrador is a province of Canada."}]}, {"canonical_name": "Parry", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "parry", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Parry", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Parry"], "contexts": ["captain mentioned in reference"]}, {"entity_id": "parry", "book_id": "kosmos_humboldt_1845", "name": "Parry", "category": "PERSON", "subcategory": "SCHOLAR", "count": 6, "variants": ["Parry"], "contexts": ["saw northern light arch during day", "observed northern light"]}, {"entity_id": "parry", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Parry", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Parry"], "contexts": ["attempted to reach the north pole"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Parry", "target_book": "kosmos_humboldt_1845", "target_name": "Parry", "similarity": 0.726}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Parry", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Parry", "similarity": 0.726}, {"source_book": "kosmos_humboldt_1845", "source_name": "Parry", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Parry", "similarity": 1.0}], "id": 1040, "stable_key": "clu_67314860911a4588", "ground_truth": {"modern_name": "William Parry", "confidence": "high", "type": "person", "birth_year": 1790, "death_year": 1855, "description": "British admiral and Arctic explorer who led expeditions to the North Pole.", "wikidata_id": "Q437310", "wikidata_description": "English naval officer and Arctic explorer (1790–1855)", "wikipedia_url": "https://en.wikipedia.org/wiki/Edward%20Parry%20%28Royal%20Navy%20officer%2C%20born%201790%29", "wikipedia_extract": "Sir William Edward Parry  (19 December 1790 – 8 July 1855) was a Royal Navy officer and explorer best known for his 1819–1820 expedition through the Parry Channel, probably the most successful in the long quest for the Northwest Passage, until it was finally negotiated by Roald Amundsen in 1906. In 1827, Parry attempted one of the earliest expeditions to the North Pole. He reached 82° 45' N, setting a record for human exploration Farthest North that stood for nearly five decades before being surpassed at 83° 20' N by Albert Hastings Markham in 1875. Parry was born in Bath, Somerset, the son of Caleb Hillier Parry and Sarah Rigby. He was educated at King Edward's School. At the age of thirteen he joined the flagship of Admiral Sir William Cornwallis in the Channel fleet as a first-class volunteer, in 1806 became a midshipman, and in 1810 received promotion to the rank of lieutenant in the frigate Alexander, which spent the next three years in the protection of the Spitsbergen whale fishery."}, "cross_references": []}, {"canonical_name": "nutrition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 6, "total_mentions": 11, "members": [{"entity_id": "nutrition", "book_id": "principles_of_psychology_james_1890", "name": "nutrition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["nutrition"], "contexts": ["process of nourishing the body", "bodily processes of nourishment"]}, {"entity_id": "nutrition", "book_id": "kosmos_humboldt_1845", "name": "nutrition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["nutrition"], "contexts": ["process of providing nourishment"]}, {"entity_id": "nutrition", "book_id": "first_principles_spencer_1862", "name": "nutrition", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["nutrition"], "contexts": ["process of nourishing the body", "process of nourishing and maintaining tissues"]}, {"entity_id": "nourishment", "book_id": "english_physician_1652", "name": "Nourishment", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Nourishment"], "contexts": ["substance drawn by plants"]}, {"entity_id": "nutrímento", "book_id": "coloquios_da_orta_1563", "name": "nutrímento", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["nutrímento"], "contexts": ["nourishment of the figuo"]}, {"entity_id": "nourishment", "book_id": "connexion_physical_sciences_somerville_1858", "name": "nourishment", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["nourishment"], "contexts": ["substances providing sustenance"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "nutrition", "target_book": "kosmos_humboldt_1845", "target_name": "nutrition", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "nutrition", "target_book": "first_principles_spencer_1862", "target_name": "nutrition", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "nutrition", "target_book": "first_principles_spencer_1862", "target_name": "nutrition", "similarity": 1.0}], "id": 1041, "stable_key": "clu_c480d7c64e1976a6", "ground_truth": {"modern_name": "nutrition", "confidence": "high", "type": "concept", "wikidata_id": "Q17652193", "wikidata_description": "science that interprets the nutrients and other substances in food in relation to maintenance, growth, reproduction, health and disease of an organism", "wikipedia_url": "https://en.wikipedia.org/wiki/Nutritional%20science", "note": "The term 'nourishment' and its Portuguese equivalent 'nutrímento' directly refer to the biological process of providing or receiving sustenance, which is the modern concept of nutrition.", "wikipedia_extract": "Nutritional science (also nutrition science, sometimes short nutrition, dated trophology) is the science that studies the physiological process of nutrition (primarily human nutrition), interpreting the nutrients and other substances in food in relation to maintenance, growth, reproduction, health and disease of an organism. Before nutritional science emerged as an independent study disciplines, mainly chemists worked in this area. The chemical composition of food was examined. Macronutrients, especially protein, fat and carbohydrates, have been the focus components of the study of (human) nutrition since the 19th century. Until the discovery of vitamins and vital substances, the quality of nutrition was measured exclusively by the intake of nutritional energy. The early years of the 20th century were summarized by Kenneth John Carpenter in his Short History of Nutritional Science as \"the vitamin era\"."}, "member_count": 6, "cross_references": [{"found_name": "Appetite", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2030, "target_cluster_name": "Appetite", "source_book": "llm_generated", "evidence_snippet": "Appetite is a direct physiological precursor and driver of nutrition.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Appetite is a direct physiological precursor and driver of nutrition."}, {"found_name": "Digestion", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 338, "target_cluster_name": "digestion", "source_book": "llm_generated", "evidence_snippet": "Digestion is the process by which food is broken down to be absorbed and utilized for nutrition.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Digestion is the process by which food is broken down to be absorbed and utilized for nutrition."}, {"found_name": "Animal economy", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4068, "target_cluster_name": "économie animale", "source_book": "llm_generated", "evidence_snippet": "Animal economy refers to the physiological processes within an organism, of which nutrition is a fundamental part.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Animal economy refers to the physiological processes within an organism, of which nutrition is a fundamental part."}, {"found_name": "Bodily functions", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3004, "target_cluster_name": "organic actions", "source_book": "llm_generated", "evidence_snippet": "Nutrition is a core bodily function essential for maintaining life and health.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Nutrition is a core bodily function essential for maintaining life and health."}, {"found_name": "Economy of nature", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1147, "target_cluster_name": "economy of nature", "source_book": "llm_generated", "evidence_snippet": "The economy of nature encompasses the broader ecological and physiological balances, within which nutrition plays a vital role.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The economy of nature encompasses the broader ecological and physiological balances, within which nutrition plays a vital role."}, {"found_name": "Absorption", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2054, "target_cluster_name": "absorption", "source_book": "llm_generated", "evidence_snippet": "Absorption is the critical step in nutrition where nutrients are taken into the body.", "confidence": 0.85, "auto_label": "llm_related", "found_