tionship": "reverse: Bitter taste is one of the fundamental categories of taste.", "is_reverse": true}, {"found_name": "amargofo", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2478, "target_cluster_name": "amargofo", "source_book": "llm_generated", "evidence_snippet": "Bitterness is one of the fundamental categories of taste.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Bitterness is one of the fundamental categories of taste.", "is_reverse": true}]}, {"canonical_name": "Leibnitz", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "leibnitz", "book_id": "principles_of_psychology_james_1890", "name": "Leibnitz", "category": "PERSON", "subcategory": "SCHOLAR", "count": 7, "variants": ["Leibnitz"], "contexts": ["philosopher who discussed perception", "philosopher and mathematician"]}, {"entity_id": "leibnitz", "book_id": "kosmos_humboldt_1845", "name": "Leibnitz", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Leibnitz"], "contexts": ["philosopher on planetary volume increase", "author of 'Deutschen Schriften'"]}, {"entity_id": "leibnitz", "book_id": "first_principles_spencer_1862", "name": "Leibnitz", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Leibnitz"], "contexts": ["suggested matter composed of unextended monads"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Leibnitz", "target_book": "kosmos_humboldt_1845", "target_name": "Leibnitz", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Leibnitz", "target_book": "first_principles_spencer_1862", "target_name": "Leibnitz", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Leibnitz", "target_book": "first_principles_spencer_1862", "target_name": "Leibnitz", "similarity": 1.0}], "id": 859, "stable_key": "clu_e5797ef9f672c4e7", "ground_truth": {"modern_name": "Gottfried Wilhelm Leibniz", "confidence": "high", "type": "person", "birth_year": 1646, "death_year": 1716, "description": "German philosopher, mathematician, and scientist, influential figure in rationalism.", "wikidata_id": "Q9047", "wikidata_description": "German mathematician and philosopher (1646–1716)", "wikipedia_url": "https://en.wikipedia.org/wiki/Gottfried%20Wilhelm%20Leibniz", "wikipedia_extract": "Gottfried Wilhelm Leibniz (or Leibnitz; 1 July 1646 [O.S. 21 June] – 14 November 1716) was a German polymath active as a mathematician, philosopher, scientist, and diplomat who is credited, alongside Isaac Newton, with the creation of calculus in addition to many other branches of mathematics, such as binary arithmetic and statistics. Leibniz has been called the \"last universal genius\" due to his vast expertise across fields, which became a rarity after his lifetime with the coming of the Industrial Revolution and the spread of specialized labour. He is a prominent figure in both the history of philosophy and the history of mathematics. He wrote works on philosophy, theology, ethics, politics, law, history, philology, games, music, and other studies. Leibniz also made major contributions to physics and technology, and anticipated notions that surfaced much later in probability theory, biology, medicine, geology, psychology, linguistics and computer science."}, "cross_references": [{"found_name": "Isaac Newton", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 71, "target_cluster_name": "Newton", "source_book": "llm_generated", "evidence_snippet": "Co-creator of calculus, a major figure in mathematics and science during the same period.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Co-creator of calculus, a major figure in mathematics and science during the same period."}, {"found_name": "mathematicians", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1337, "target_cluster_name": "mathematicians", "source_book": "llm_generated", "evidence_snippet": "Leibniz was a prominent mathematician and philosopher who independently developed calculus.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Leibniz was a prominent mathematician and philosopher who independently developed calculus.", "is_reverse": true}]}, {"canonical_name": "inertia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "inertia", "book_id": "principles_of_psychology_james_1890", "name": "inertia", "category": "CONCEPT", "subcategory": "THEORY", "count": 4, "variants": ["inertia"], "contexts": ["tendency to remain at rest", "tendency to remain unchanged"]}, {"entity_id": "inertia", "book_id": "connexion_physical_sciences_somerville_1858", "name": "inertia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["inertia"], "contexts": ["resistance to change in motion", "property of air affecting sound"]}, {"entity_id": "inertia", "book_id": "first_principles_spencer_1862", "name": "inertia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["inertia"], "contexts": ["resistance to change in motion", "law of motion in physics"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "inertia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "inertia", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "inertia", "target_book": "first_principles_spencer_1862", "target_name": "inertia", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "inertia", "target_book": "first_principles_spencer_1862", "target_name": "inertia", "similarity": 1.0}], "id": 860, "stable_key": "clu_b65e2ed2e2780930", "ground_truth": {"modern_name": "Inertia", "confidence": "high", "type": "concept", "wikidata_id": "Q90390997", "wikidata_description": "UK musical group"}, "cross_references": [{"found_name": "Acceleration", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2252, "target_cluster_name": "acceleration", "source_book": "llm_generated", "evidence_snippet": "Inertia is the resistance to acceleration. Newton's second law of motion (F=ma) directly relates force, mass (a measure of inertia), and acceleration.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Inertia is the resistance to acceleration. Newton's second law of motion (F=ma) directly relates force, mass (a measure of inertia), and acceleration."}, {"found_name": "Attraction (physics)", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4186, "target_cluster_name": "attractions", "source_book": "llm_generated", "evidence_snippet": "Inertia is a fundamental property of matter, alongside forces like attraction, that governs motion.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Inertia is a fundamental property of matter, alongside forces like attraction, that governs motion."}, {"found_name": "Force", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 59, "target_cluster_name": "Force", "source_book": "llm_generated", "evidence_snippet": "Inertia is the property of matter that resists changes in its state of motion, which are caused by forces. Newton's laws of motion, which define inertia, are fundamentally about forces and motion.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Inertia is the property of matter that resists changes in its state of motion, which are caused by forces. Newton's laws of motion, which define inertia, are fundamentally about forces and motion."}, {"found_name": "Action and reaction", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 961, "target_cluster_name": "Action and reaction", "source_book": "llm_generated", "evidence_snippet": "Newton's third law of motion, 'action and reaction', is closely related to inertia (Newton's first and second laws) in describing the dynamics of interacting bodies.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Newton's third law of motion, 'action and reaction', is closely related to inertia (Newton's first and second laws) in describing the dynamics of interacting bodies."}]}, {"canonical_name": "molecular motion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "molecular_motion", "book_id": "principles_of_psychology_james_1890", "name": "molecular motion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["molecular motion"], "contexts": ["movement of molecules"]}, {"entity_id": "molecular_motion", "book_id": "kosmos_humboldt_1845", "name": "molecular motion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["molecular motion"], "contexts": ["motion of ultimate portions of matter", "motion of small particles"]}, {"entity_id": "molecular_motion", "book_id": "first_principles_spencer_1862", "name": "molecular motion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["molecular motion"], "contexts": ["motion among the units of sensible masses", "movement of particles within matter"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "molecular motion", "target_book": "kosmos_humboldt_1845", "target_name": "molecular motion", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "molecular motion", "target_book": "first_principles_spencer_1862", "target_name": "molecular motion", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "molecular motion", "target_book": "first_principles_spencer_1862", "target_name": "mol