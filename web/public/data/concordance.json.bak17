"found_relationship": "reverse: Rock crystal is a variety of quartz, and amethyst is a purple variety of quartz, making them closely related mineral forms.", "is_reverse": true}]}, {"canonical_name": "Dorta", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "dorta", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Dorta", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Dorta"], "contexts": ["made observations in Brazil", "scholar who made observations"]}, {"entity_id": "de_l'isle", "book_id": "relation_historique_humboldt_vol3_1825", "name": "De l'Isle", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["De l'Isle", "M. de l'Isle"], "contexts": ["early geographer", "papers containing Boudier's observations"]}, {"entity_id": "dollond", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Dollond", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Dollond"], "contexts": ["maker of thermometer"]}, {"entity_id": "delisle", "book_id": "kosmos_humboldt_1845", "name": "Delisle", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Delisle"], "contexts": ["scholar on Earth's circumference statements"]}, {"entity_id": "dollond", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Dollond", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Dollond"], "contexts": ["perfected achromatic telescope"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Dorta", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Dollond", "similarity": 0.859}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "De l'Isle", "target_book": "kosmos_humboldt_1845", "target_name": "Delisle", "similarity": 0.531}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Dollond", "target_book