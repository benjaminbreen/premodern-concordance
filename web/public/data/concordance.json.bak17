rget_book": "first_principles_spencer_1862", "target_name": "gas", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "gas", "target_book": "polyanthea_medicinal", "target_name": "gas", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "gas", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "gas", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "gas", "target_book": "first_principles_spencer_1862", "target_name": "gas", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "gas", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "gas", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "gas", "target_book": "first_principles_spencer_1862", "target_name": "gas", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "gas", "target_book": "first_principles_spencer_1862", "target_name": "gas", "similarity": 1.0}], "id": 171, "stable_key": "clu_4c00c092b41f27d3", "ground_truth": {"modern_name": "Gas", "confidence": "high", "type": "concept", "note": "The term 'gas' in early modern texts referred to a state of matter, sometimes associated with vapors or aerial substances, and the contexts align with this scientific understanding, even if the specific properties or understanding differed from modern chemistry.", "wikidata_id": "Q131271", "wikidata_description": "species of bacterium", "wikipedia_url": "https://en.wikipedia.org/wiki/Streptococcus%20pyogenes", "wikipedia_extract": "Streptococcus pyogenes is a species of Gram-positive, aerotolerant bacteria in the genus Streptococcus. These bacteria are extracellular, and made up of non-motile and non-sporing cocci (round cells) that tend to link in chains. They are clinically important for humans, as they are an infrequent, but usually pathogenic, part of the skin microbiota that can cause group A streptococcal infection. S. pyogenes  is the predominant species harboring the Lancefield group A antigen, and is often called group A Streptococcus (GAS). However, both Streptococcus dysgalactiae and the Streptococcus anginosus group can possess group A antigen as well."}, "cross_references": [{"found_name": "air", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 109, "target_cluster_name": "air", "source_book": "llm_generated", "evidence_snippet": "Air is a gas, and historically, the concept of 'air' was often conflated with or considered a primary example of a gas.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Air is a gas, and historically, the concept of 'air' was often conflated with or considered a primary example of a gas.", "is_reverse": true}, {"found_name": "Gases", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 725, "target_cluster_name": "gases", "source_book": "llm_generated", "evidence_snippet": "This is a plural form and a direct synonym for 'gas' in many contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "This is a plural form and a direct synonym for 'gas' in many contexts."}, {"found_name": "ice", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 275, "target_cluster_name": "ice", "source_book": "llm_generated", "evidence_snippet": "Ice is the solid state of water, which can also exist as a gas (steam). The relationship between solid, liquid, and gaseous states of the same substance is a fundamental concept.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Ice is the solid state of water, which can also exist as a gas (steam). The relationship between solid, liquid, and gaseous states of the same substance is a fundamental concept.", "is_reverse": true}, {"found_name": "Lungs", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 66, "target_cluster_name": "Lun