ysical_sciences_somerville_1858", "name": "vulture", "category": "ANIMAL", "subcategory": "BIRD", "count": 1, "variants": ["vulture"], "contexts": ["bird that spots prey from afar"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Vulture", "target_book": "kosmos_humboldt_1845", "target_name": "vulture", "similarity": 0.902}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Vulture", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "vulture", "similarity": 0.902}, {"source_book": "kosmos_humboldt_1845", "source_name": "vulture", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "vulture", "similarity": 1.0}], "id": 1443, "stable_key": "clu_fdcf07fed1d76b9e", "ground_truth": {"modern_name": "Vulture", "confidence": "high", "type": "animal", "note": "The mention of 'bearded vulture' and 'confined to the Alps' suggests Gyps fulvus or Gypaetus barbatus, but 'Vulture' generally refers to the family Accipitridae or Cathartidae.", "wikidata_id": "Q123120", "wikidata_description": "common name for several types of scavenging birds of prey", "wikipedia_extract": "Old World vultures are vultures that are found in the Old World, i.e. the continents of Europe, Asia and Africa, and which belong to the family Accipitridae, which also includes eagles, buzzards, kites, and hawks. Old World vultures are not closely related to the superficially similar New World vultures and condors, and do not share that group's good sense of smell. The similarities between the two groups of vultures are due to convergent evolution, rather than a close relationship. They were widespread in both the Old World and North America during the Neogene. Old World vultures are probably a polyphyletic group within Accipitridae, belonging to two separate not closely related groups within the family.", "wikipedia_url": "https://en.wikipedia.org/wiki/Vulture"}, "cross_references": [{"found_name": "Eagle", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1416, "target_cluster_name": "Eagle", "source_book": "llm_generated", "evidence_snippet": "Vultures belong to the same family (Accipitridae) as eagles, buzzards, kites, and hawks.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Vultures belong to the same family (Accipitridae) as eagles, buzzards, kites, and hawks."}, {"found_name": "Hawks", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 395, "target_cluster_name": "Hawks", "source_book": "llm_generated", "evidence_snippet": "Vultures belong to the same family (Accipitridae) as hawks.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Vultures belong to the same family (Accipitridae) as hawks."}]}, {"canonical_name": "squelettes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "squelettes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "squelettes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["squelettes"], "contexts": ["bones found in tumuli"]}, {"entity_id": "human_remains", "book_id": "kosmos_humboldt_1845", "name": "human remains", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["human remains"], "contexts": ["parts of the human body"]}, {"entity_id": "cadaver", "book_id": "polyanthea_medicinal", "name": "cadaver", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["cadaver"], "contexts": ["dead body"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "squelettes", "target_book": "kosmos_humboldt_1845", "target_name": "human remains", "similarity": 0.924}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "squelettes", "target_book": "polyanthea_medicinal", "target_name": "cadaver", "similarity": 0.907}, {"source_book": "kosmos_humboldt_1845"