0.939}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Swallows", "target_book": "principles_of_psychology_james_1890", "target_name": "swallow", "similarity": 0.939}, {"source_book": "english_physician_1652", "source_name": "Swallow", "target_book": "origin_of_species_darwin_1859", "target_name": "swallow", "similarity": 0.861}, {"source_book": "english_physician_1652", "source_name": "Swallow", "target_book": "principles_of_psychology_james_1890", "target_name": "swallow", "similarity": 0.861}, {"source_book": "origin_of_species_darwin_1859", "source_name": "swallow", "target_book": "principles_of_psychology_james_1890", "target_name": "swallow", "similarity": 1.0}], "id": 499, "stable_key": "clu_a78aa1285b9c8daa", "ground_truth": {"wikipedia_extract": "The swallows, martins, and saw-wings, or Hirundinidae, are a family of passerine songbirds found around the world on all continents, including occasionally in Antarctica. Highly adapted to aerial feeding, they have a distinctive appearance. The term \"swallow\" is used as the common name for Hirundo rustica in the United Kingdom and Ireland. Around 90 species of Hirundinidae are known, divided into 21 genera, with the greatest diversity found in Africa, which is also thought to be where they evolved as hole-nesters. They also occur on a number of oceanic islands. A number of European and North American species are long-distance migrants; by contrast, the West and South African swallows are nonmigratory."}, "cross_references": []}, {"canonical_name": "dreams", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "dreams", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Dreams", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Dreams"], "contexts": ["mental experiences during sleep"]}, {"entity_id": "dreams", "book_id": "english_physician_1652", "name": "Dreams", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Dreams"], "contexts": ["sequences of images, ideas, emotions"]}, {"entity_id": "dreams", "book_id": "principles_of_psychology_james_1890", "name": "dreams", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["dreams"], "contexts": ["mental experiences during sleep"]}, {"entity_id": "sonho", "book_id": "polyanthea_medicinal", "name": "sonho", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sonho"], "contexts": ["dream"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Dreams", "target_book": "english_physician_1652", "target_name": "Dreams", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Dreams", "target_book": "principles_of_psychology_james_1890", "target_name": "dreams", "similarity": 0.988}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Dreams", "target_book": "polyanthea_medicinal", "target_name": "sonho", "similarity": 0.915}, {"source_book": "english_physician_1652", "source_name": "Dreams", "target_book": "principles_of_psychology_james_1890", "target_name": "dreams", "similarity": 0.988}, {"source_book": "english_physician_1652", "source_name": "Dreams", "target_book": "polyanthea_medicinal", "target_name": "sonho", "similarity": 0.915}, {"source_book": "principles_of_psychology_james_1890", "source_name": "dreams", "target_book": "polyanthea_medicinal", "target_name": "sonho", "similarity": 0.906}], "id": 500, "stable_key": "clu_891f4ba763ba6f95", "ground_truth": {"wikipedia_extract": "A dream is a succession of images, dynamic scenes and situations, ideas, emotions, and sensations that usually occur involuntarily in the mind during certain stages of sleep. Humans spend more than two hours dreaming per night, and each dream lasts around 5–20 minutes. The content and function of dreams have been topics of scientific, philosophical and religious interest throughout recorded history. Dream interpretation, practiced by the Babylonians in the third millennium BCE and even earlier by the ancient Sumerians, figures prominently in religious texts in several traditions, and has played a lead role in psychotherapy. Dreamwork is similar, but does not seek to conclude with definite meaning. The scientific study of dreams is called oneirology."}, "cross_references": []}, {"canonical_name": "fomentaçao", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "fomentations", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "fomentations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fomentations"], "contexts": ["relieve the head"]}, {"entity_id": "fomentaciones", "book_id": "historia_medicinal_monardes_1574", "name": "fomentaciones", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fomentaciones"], "contexts": ["therapeutic application of heat or liquid"]}, {"entity_id": "fomentações", "book_id": "coloquios_da_orta_1563", "name": "fomentações", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["fomentações"], "contexts": ["used to treat beribéri"]}, {"entity_id": "fomentaçao", "book_id": "polyanthea_medicinal", "name": "fomentaçao", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["fomentaçao"], "contexts": ["application of warm liquids", "application of oil to the nape"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "fomentations", "target_book": "historia_medicinal_monardes_1574", "target_name": "fomentaciones", "similarity": 0.991}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "fomentations", "target_book": "coloquios_da_orta_1563", "target_name": "fomentações", "similarity": 0.99}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "fomentations", "target_book": "polyanthea_medicinal", "target_name": "fomentaçao", "similarity": 0.941}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "fomentaciones", "target_book": "coloquios_da_orta_1563", "target_name": "fomentações", "similarity": 0.998}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "fomentaciones", "target_book": "polyanthea_medicinal", "target_name": "fomentaçao", "similarity": 0.943}, {"source_book": "coloquios_da_orta_1563", "source_name": "fomentações", "target_book": "polyanthea_medicinal", "target_name": "fomentaçao", "similarity": 0.946}], "id": 501, "stable_key": "clu_8e19728993bb5f2a", "ground_truth": {"modern_name": "Fomentation", "confidence": "high", "type": "concept", "note": "This refers to the therapeutic application of moist heat or warm liquids to the body.", "wikidata_id": "Q58775427", "wikidata_description": "", "wikipedia_extract": "Ayurveda is a pseudoscientific alternative medicine system with historical roots in the Indian subcontinent. It is heavily practised throughout India and Nepal, where as much as 80% of the population report using ayurveda. Toxic metals including lead and mercury are used as ingredients in many ayurvedic medicines. Ayurveda therapies have varied and evolved over more than two millennia. Therapies include herbal medicines, special diets, meditation, yoga, massage, laxatives, enemas, and medical oils. Early Ayurvedic preparations were entirely based on complex herbal compounds based on the materia medica of South Asia.", "wikipedia_url": "https://en.wikipedia.org/wiki/Ayurveda"}, "cross_references": [{"found_name": "Infusion", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3850, "target_cluster_name": "infusion", "source_book": "llm_generated", "evidence_snippet": "Infusions are often used as the liquid base for fomentations.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Infusions are often used as the liquid base for fomentations."}, {"found_name": "cauterio", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1576, "target_cluster_name": "cauterio", "source_book": "llm_generated", "evidence_snippet": "Fomentation (applying heat or moisture) and cauterization are both physical therapeutic techniques used in historical medicine.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Fomentation (applying heat or moisture) and cauterization are both physical therapeutic techniques used in historical medicine.", "is_reverse": true}, {"found_name": "balneis", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2167, "target_cluster_name": "balneis", "source_book": "llm_generated", "evidence_snippet": "Fomentation, the application of heat or moisture, could be a component of bathing practices.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Fomentation, the application of heat or moisture, could be a component of bathing practices.", "is_reverse": true}]}, {"canonical_name": "verde", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "green", "book_id": "english_physician_1652", "name": "green", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["green"], "contexts": ["state of borrage herb used"]}, {"entity_id": "verdes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "verdes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["verdes"], "contexts": ["description of islets"]}, {"entity_id": "verde", "book_id": "coloquios_da_orta_1563", "name": "verde", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["verde"], "contexts": ["color of drying anil", "color of emeralds and jaspe"]}, {"entity_id": "verde", "book_id": "ricettario_fiorentino_1597", "name": "verde", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["verde"], "contexts": ["quality of oil"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "green", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "verdes", "similarity": 0.883}, {"source_book": "english_physician_1652", "source_name": "green", "target_book": "coloquios_da_orta_1563", "target_name": "verde", "similarity": 0.94}, {"source_book": "english_physician_1652", "source_name": "green", "target_book": "ricettario_fiorentino_1597", "target_name": "verde", "similarity": 0.94}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "verdes", "target_book": "coloquios_da_orta_1563", "target_name": "verde", "similarity": 0.914}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "verdes", "target_book": "ricettario_fiorentino_1597", "target_name": "verde", "similarity": 0.914}, {"source_book": "coloquios_da_orta_1563", "source_name": "verde", "target_book": "ricettario_fiorentino_1597", "target_name": "verde", "similarity": 1.0}], "id": 502, "stable_key": "clu_a87bb2ac0e425670", "ground_truth": {"modern_name": "green", "confidence": "high", "type": "concept", "description": "The color of plants, emeralds, and certain other substances.", "wikipedia_extract": "Green is the color between cyan and yellow on the visible spectrum. It is evoked by light which has a dominant wavelength of roughly 495–570 nm. In subtractive color systems, used in painting and color printing, it is created by a combination of yellow and cyan; in the RGB color model, used on television and computer screens, it is one of the additive primary colors, along with red and blue, which are mixed in different combinations to create all other colors. By far the largest contributor to green in nature is chlorophyll, the chemical by which plants photosynthesize and convert sunlight into chemical energy. Many creatures have adapted to their green environments by taking on a green hue themselves as camouflage. Several minerals have a green color, including the emerald, which is colored green by its chromium content."}, "cross_references": [{"found_name": "esmeraldas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 107, "target_cluster_name": "esmeralda", "source_book": "coloquios_da_orta_1563", "evidence_snippet": "interpre- * Itto é, esmeraldas de procedeoda oriental oa do Velho Mando; e nfio o que oe liTit» eapedaea chamam boje esmeralda oriental t que é uma variedade verde do coryndon, exce- pcionalmente rara", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of"}, {"found_name": "landes", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "porque sabem a bolotas de sovereiro, que em nossa terra chamam landes; e os caroços, scilicet, o miolo delles, dizem que mata as lombrigas, quando he verde, e tem rezão, porque amargam (i). RUANO Se a", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "called in our land"}, {"found_name": "esmeralda oriental", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "interpre- * Itto é, esmeraldas de procedeoda oriental oa do Velho Mando; e nfio o que oe liTit» eapedaea chamam boje esmeralda oriental t que é uma variedade verde do coryndon, exce- pcionalmente rara", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of"}, {"found_name": "coryndon", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "interpre- * Itto é, esmeraldas de procedeoda oriental oa do Velho Mando; e nfio o que oe liTit» eapedaea chamam boje esmeralda oriental t que é uma variedade verde do coryndon, exce- pcionalmente rara", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of"}, {"found_name": "peitacas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "que elles chamam peitacas); a folha he como de huma lança pequena, dividida pello meo com dous fios, e outros que se tecem pêra as ilharguas; he muyto verde o arvore, e muyto grande e bem copado; di- ", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of"}]}, {"canonical_name": "direction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 5, "members": [{"entity_id": "direction", "book_id": "english_physician_1652", "name": "Direction", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["Direction"], "contexts": ["astrological prediction"]}, {"entity_id": "direction", "book_id": "principles_of_psychology_james_1890", "name": "direction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["direction"], "contexts": ["orientation of difference"]}, {"entity_id": "direction", "book_id": "kosmos_humboldt_1845", "name": "direction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["direction"], "contexts": ["orientation in space"]}, {"entity_id": "direction", "book_id": "connexion_physical_sciences_somerville_1858", "name": "direction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["direction"], "contexts": ["path of motion", "opposite movement in hemispheres"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Direction", "target_book": "principles_of_psychology_james_1890", "target_name": "direction", "similarity": 0.983}, {"source_book": "english_physician_1652", "source_name": "Direction", "target_book": "kosmos_humboldt_1845", "targe