rget_book": "principles_of_psychology_james_1890", "target_name": "senses", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "senses", "target_book": "first_principles_spencer_1862", "target_name": "senses", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "senses", "target_book": "origin_of_species_darwin_1859", "target_name": "senses", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "senses", "target_book": "principles_of_psychology_james_1890", "target_name": "senses", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "senses", "target_book": "first_principles_spencer_1862", "target_name": "senses", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "senses", "target_book": "principles_of_psychology_james_1890", "target_name": "senses", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "senses", "target_book": "first_principles_spencer_1862", "target_name": "senses", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "senses", "target_book": "first_principles_spencer_1862", "target_name": "senses", "similarity": 1.0}], "id": 133, "stable_key": "clu_94ca61a97148dfbf", "ground_truth": {"wikipedia_extract": "A sense is a biological system used by an organism for sensation, the process of  gathering information about the surroundings through the detection of stimuli. Although, in some cultures, five human senses were traditionally identified as such (namely sight, smell, touch, taste, and hearing), many more are now recognized. Senses used by non-human organisms are even greater in variety and number. During sensation, sense organs collect various stimuli (such as a sound or smell) for transduction, meaning transformation into a form that can be understood by the brain. Sensation and perception are fundamental to nearly every aspect of an organism's cognition, behavior and thought. In organisms, a sensory organ consists of a group of interrelated sensory cells that respond to a specific type of physical stimulus."}, "cross_references": []}, {"canonical_name": "Feet", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 5, "total_mentions": 18, "members": [{"entity_id": "feet", "book_id": "english_physician_1652", "name": "Feet", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 8, "variants": ["Feet"], "contexts": ["body part affected by gout", "body part refreshed by Alder-Tree leaves"]}, {"entity_id": "feet", "book_id": "origin_of_species_darwin_1859", "name": "Feet", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["Feet", "feet"], "contexts": ["part of runt pigeon anatomy", "terminal part of the leg"]}, {"entity_id": "feet", "book_id": "kosmos_humboldt_1845", "name": "feet", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["feet"], "contexts": ["unit of measurement", "unit of depth measurement"]}, {"entity_id": "pés", "book_id": "coloquios_da_orta_1563", "name": "pés", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["pés"], "contexts": ["affected by pain and black nails"]}, {"entity_id": "feet", "book_id": "first_principles_spencer_1862", "name": "feet", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["feet"], "contexts": ["locomotion organs in quadrupeds"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Feet", "target_book": "origin_of_species_darwin_1859", "target_name": "Feet", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Feet", "target_book": "kosmos_humboldt_1845", "target_name": "feet", "similarity": 0.974}, {"source_book": "english_physician_1652", "source_name": "Feet", "target_book": "coloquios_da_orta_1563", "target_name": "pés", "similarity": 0.959}, {"source_book": "english_physician_1652", "source_name