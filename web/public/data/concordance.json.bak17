nfidence": 0.85, "auto_label": "llm_related", "found_relationship": "Cubeb pepper is a type of pepper, specifically Piper cubeba, and is often discussed alongside other peppercorns in historical texts."}, {"found_name": "Long Pepper", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1750, "target_cluster_name": "pimenta longa", "source_book": "llm_generated", "evidence_snippet": "Long Pepper is another distinct type of pepper (Piper longum) that was historically important and often grouped with black pepper.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Long Pepper is another distinct type of pepper (Piper longum) that was historically important and often grouped with black pepper."}, {"found_name": "Spices", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2144, "target_cluster_name": "especiarias", "source_book": "llm_generated", "evidence_snippet": "Pepper is a fundamental spice, and 'Spices' is a broad category that would encompass pepper in historical contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Pepper is a fundamental spice, and 'Spices' is a broad category that would encompass pepper in historical contexts."}]}, {"canonical_name": "sharp", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "sharp", "book_id": "english_physician_1652", "name": "sharp", "category": "CONCEPT", "subcategory": "QUALITY", "count": 7, "variants": ["sharp", "Sharpness", "sharpness"], "contexts": ["taste quality of Water-Cresses", "quality of substance"]}, {"entity_id": "sharp", "book_id": "principles_of_psychology_james_1890", "name": "sharp", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["sharp"], "contexts": ["sensation of pointedness"]}, {"entity_id": "f_sharp", "book_id": "principles_of_psychology_james_1890", "name": "f sharp", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["f sharp"], "contexts": ["musical note"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "sharp", "target_book": "principles_of_psychology_james_1890", "target_name": "sharp", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "sharp", "target_book": "principles_of_psychology_james_1890", "target_name": "f sharp", "similarity": 0.908}], "id": 2172, "stable_key": "clu_abb04f9fee69d789", "ground_truth": {"modern_name": "Sharp", "confidence": "high", "type": "concept", "description": "Possessing a keen edge or point; intense taste or sensation.", "wikipedia_extract": "Venomous Concept is an American hardcore punk band formed by Kevin Sharp of Brutal Truth and Shane Embury of Napalm Death in 2004. Sharp and Embury were joined by Danny Herrera and Buzz Osborne, who was later replaced by Danny Lilker. They have released five studio albums to date: Retroactive Abortion (2004), Poisoned Apple (2008), Kick Me Silly VCIII (2016), \"Politics Versus the Erection\" (2020) and \"The Good Ship Lollipop\" (2023). They have also released two split albums: one with Japanese grindcore band 324 (2006), and the other with Australian extreme metal band Blood Duster (2008). The band's name is a play on Poison Idea, in the style of name-mangling Japanese hardcore acts. In February 2004, Kevin Sharp was the tour driver for Napalm Death on The Art of Noise tour with Nile, Strapping Young Lad, Dark Tranquillity and The Berzerker."}, "cross_references": []}, {"canonical_name": "Passions of the Heart", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "passions_of_the_heart", "book_id": "english_physician_1652", "name": "Passions of the Heart", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 6, "variants": ["Passions of the Heart", "passions", "passions of it", "passions of the Heart", "passions of the Mother"], "contexts": ["condition troubled by borrage", "helped by a drink"]}, {"entity_id": "passions", "book_id": "principles_of_psychology_james_1890", "name": "passions", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["passions"], "contexts": ["engendered by association of ideas", "strong emotional states"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Passions of the Heart", "target_book": "principles_of_psychology_james_1890", "target_name": "passions", "similarity": 0.922}], "id": 2173, "stable_key": "clu_f9a441935b1f1c61", "ground_truth": {"modern_name": "Emotional disturbance", "confidence": "medium", "type": "concept", "note": "The term 'passions of the heart' in early modern texts referred to strong emotions or emotional disturbances, not a specific disease in the modern sense. It's closer to a psychological or emotional state.", "wikidata_id": "Q12046440", "wikidata_description": "symptom"}, "cross_references": [{"found_name": "Mania", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1612, "target_cluster_name": "Mania", "source_book": "llm_generated", "evidence_snippet": "Mania is characterized by abnormally elevated affect and rapidly changing emotions, fitting the description of an emotional disturbance.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Mania is characterized by abnormally elevated affect and rapidly changing emotions, fitting the description of an emotional disturbance.", "is_reverse": true}, {"found_name": "Grief", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1325, "target_cluster_name": "grief", "source_book": "llm_generated", "evidence_snippet": "Grief is a profound emotional response to loss, and can be considered a specific type of emotional disturbance.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Grief is a profound emotional response to loss, and can be considered a specific type of emotional disturbance."}]}, {"canonical_name": "mala Franc^os", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 13, "members": [{"entity_id": "mal_frances", "book_id": "historia_medicinal_monardes_1574", "name": "mal Frances", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["mal Frances"], "contexts": ["name for the disease"]}, {"entity_id": "mala_franc^os", "book_id": "coloquios_da_orta_1563", "name": "mala Franc^os", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 8, "variants": ["mala Franc^os", "mal dei frangues", "mal france", "mal francei", "malpa francesa"], "contexts": ["name for syphilis meaning French disease", "name for a disease, likely syphilis"]}, {"entity_id": "taiparias", "book_id": "coloquios_da_orta_1563", "name": "taiparias", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["taiparias"], "contexts": ["disease prevalent in the new land"]}, {"entity_id": "talparias", "book_id": "polyanthea_medicinal", "name": "talparias", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["talparias"], "contexts": ["ulcers, dissolved by mercury", "tumors or swellings"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "mal Frances", "target_book": "coloquios_da_orta_1563", "target_name": "mala Franc^os", "similarity": 0.885}], "id": 2174, "stable_key": "clu_3f8f70077597ba4c", "ground_truth": {"modern_name": "Syphilis", "confidence": "high", "type": "disease", "modern_term": "Syphilis", "note": "The term 'mala Franc^os' or 'mal Frances' was a common historical name for syphilis, meaning 'French evil'.", "wikidata_id": "Q18966640", "wikidata_description": "human disease"}, "member_count": 4, "cross_references": [{"found_name": "morbo napolitano", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2860, "target_cluster_name": "morbo napolitano", "source_book": "llm_generated", "evidence_snippet": "This is listed as a historical name for syphilis in the provided candidate list.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: This is listed as a historical name for syphilis in the provided candidate list.", "is_reverse": true}]}, {"canonical_name": "cabbage", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "cabbages", "book_id": "english_physician_1652", "name": "cabbages", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Cabbages", "cabbages"], "contexts": ["common garden vegetable", "vegetable eaten boiled for opening body"]}, {"entity_id": "cabbage", "book_id": "origin_of_species_darwin_1859", "name": "cabbage", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 6, "variants": ["cabbage"], "contexts": ["cultivated plant with wild ancestor", "plant with distinct leaves and flowers"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "cabbages", "target_book": "origin_of_species_darwin_1859", "target_name": "cabbage", "similarity": 0.949}], "id": 2175, "stable_key": "clu_4206d8bd8596e8ca", "ground_truth": {"modern_name": "Cabbage", "confidence": "high", "type": "plant", "linnaean": "Brassica oleracea Linnaeus", "family": "Brassicaceae", "wikidata_id": "Q58677", "wikidata_description": "genus of plants"}, "cross_references": [{"found_name": "nabo", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2870, "target_cluster_name": "nabo", "source_book": "llm_generated", "evidence_snippet": "Turnips and cabbage are both common vegetables belonging to the Brassicaceae family, sharing a close botanical and culinary relationship.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Turnips and cabbage are both common vegetables belonging to the Brassicaceae family, sharing a close botanical and culinary relationship.", "is_reverse": true}]}, {"canonical_name": "Terra santa", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "terra_sacratissima", "book_id": "english_physician_1652", "name": "Terra sacratissima", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Terra sacratissima"], "contexts": ["philosophical term for a substance"]}, {"entity_id": "terra_santa", "book_id": "polyanthea_medicinal", "name": "Terra santa", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 7, "variants": ["Terra santa", "Terra Santa"], "contexts": ["name for prepared antimony", "name given to valuable powders"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Terra sacratissima", "target_book": "polyanthea_medicinal", "target_name": "Terra santa", "similarity": 0.941}], "id": 2176, "stable_key": "clu_6ab5f7beb1c91b8c", "ground_truth": {"modern_name": "Antimony", "confidence": "high", "type": "mineral", "description": "A metallic element, often prepared and used in alchemical and medicinal contexts.", "note": "Refers to preparations of antimony, often for alchemical or medicinal use.", "wikipedia_extract": "Antimony is a chemical element with the symbol Sb (from Latin  stibium) and atomic number 51. A lustrous grey metal or metalloid, it occurs in nature mainly in the form of the sulfide mineral stibnite (Sb2S3). Antimony compounds have been known since ancient times and were powdered for use as medicine and cosmetics, often known by the Arabic name kohl. China is the largest producer of antimony and its compounds, with most production coming from the Xikuangshan Mine in Hunan. The industrial methods for refining antimony from stibnite are roasting followed by reduction with carbon, or direct reduction of stibnite with iron. The most common applications for metallic antimony are in alloys with lead and tin, which have improved properties for solders, bullets, and plain bearings."}, "cross_references": [{"found_name": "Antimonio", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 40, "target_cluster_name": "Antimonio", "source_book": "llm_generated", "evidence_snippet": "Direct translation/cognate of Antimony.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "Direct translation/cognate of Antimony."}, {"found_name": "Terra Lemnia", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 482, "target_cluster_name": "Terra Lemnia", "source_book": "llm_generated", "evidence_snippet": "Both are earth-like substances historically used in medicine, often associated with specific geographical origins and believed to have medicinal properties.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are earth-like substances historically used in medicine, often associated with specific geographical origins and believed to have medicinal properties."}, {"found_name": "Crocus metallorum", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 669, "target_cluster_name": "Crocus metallorum", "source_book": "llm_generated", "evidence_snippet": "Crocus metallorum is a preparation derived from antimony, specifically antimony sulfide, and was a significant medicinal compound in historical pharmacopoeias.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Crocus metallorum is a preparation derived from antimony, specifically antimony sulfide, and was a significant medicinal compound in historical pharmacopoeias."}, {"found_name": "Realgar", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2883, "target_cluster_name": "rosalgar", "source_book": "llm_generated", "evidence_snippet": "Realgar is a mineral form of arsenic sulfide, often found alongside stibnite (antimony sulfide), and historically confused or associated with antimony preparations due to similar appearances and uses.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Realgar is a mineral form of arsenic sulfide, often found alongside stibnite (antimony sulfide), and historically confused or associated with antimony preparations due to similar appearances and uses."}]}, {"canonical_name": "hypocistide", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "hypocistis", "book_id": "english_physician_1652", "name": "Hypocistis", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Hypocistis"], "contexts": ["used for binding effect"]}, {"entity_id": "hypocistide", "book_id": "ricettario_fiorentino_1597", "name": "hypocistide", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["hypocistide", "Hipocifti", "Hy pociftide", "Hypocifti", "Hypocistide", "Hypocìftide", "hypociftide"], "contexts": ["substance discussed", "plant for pounding with liquid"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Hypocistis", "target_book": "ricettario_fiorentino_1597", "target_name": "hypocistide", "similarity": 0.956}], "id": 2177, "stable_key": "clu_d1068a1b9b187cfa", "ground_truth": {"modern_name": "Hypocistis", "confidence": "high", "type": "plant", "linnaean": "Cistanche phelypaea", "family": "Orobanchaceae", "description": "Parasitic plant extract used for binding and in medicinal preparations.", "wikipedia_extract": "Cistanche phelypaea, also spelled Cistanche phelipaea, is a species of plant in the family Orobanchaceae. It has a wide range of distribution from the Arabian Peninsula and the Syrian Desert in the east, through the Sahara, Cyprus, Crete and the southwest of the Iberian Peninsula, to Macaronesia in the west. Cistanche phelypaea is a chlorophyll-free, obligate parasitic plant with stout fleshy flowering stems bearing bright yellow flowers and rising to 20–50 cm (7.9–19.7 in) tall from a generally swollen base. The stem is glabrous and yellow to purple gray. Leaves are ovate-lanceolate, obtuse, glabrous and normally brown in color. Inflorescence is dense, more or less cylindrical."}, "cross_references": []}, {"canonical_name": "natural system", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "natural_system", "book_id": "origin_of_species_darwin_1859", "name": "natural system", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 8, "variants": ["Natural System", "Natural system", "natural system"], "contexts": ["classification based on natural relationships", "classification of species"]}, {"entity_id": "systems_of_nature", "book_id": "kosmos_humboldt_1845", "name": "Systems of Nature", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Systems of Nature"], "contexts": ["title for catalogues of organized beings"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "natural system", "target_book": "kosmos_humboldt_1845", "target_name": "Systems of Nature", "similarity": 0.896}], "id": 2178, "stable_key": "clu_747d4e06751c908b", "ground_truth": {"modern_name": "Natural System", "confidence": "high", "type": "concept", "wikidata_id": "Q106865236", "wikidata_description": "naturally-occurring system"}, "cross_references": [{"found_name": "Economy of nature", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1147, "target_cluster_name": "economy of nature", "source_book": "llm_generated", "evidence_snippet": "The 'Natural System' is a historical term often used synonymously with or as a precursor to the concept of the 'Economy of Nature', referring to the interconnectedness and balance within the natural world.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The 'Natural System' is a historical term often used synonymously with or as a precursor to the concept of the 'Economy of Nature', referring to the interconnectedness and balance within the natural world."}]}, {"canonical_name": "Huber", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "huber", "book_id": "origin_of_species_darwin_1859", "name": "Huber", "category": "PERSON", "subcategory": "SCHOLAR", "count": 8, "variants": ["Huber"], "contexts": ["observer of ant behavior", "statements trusted by the author"]}, {"entity_id": "huber", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Huber", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Huber"], "contexts": ["added information to a translation"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Huber", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Huber", "similarity": 1.0}], "id": 2179, "stable_key": "clu_7061a76998ba1ee2", "ground_truth": {"modern_name": "François Huber", "confidence": "high", "type": "person", "birth_year": 1750, "death_year": 1831, "description": "Swiss naturalist who studied ants and bees."}, "cross_references": []}, {"canonical_name": "morphology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "morphology", "book_id": "origin_of_species_darwin_1859", "name": "morphology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["MORPHOLOGY", "morphology", "Morphology"], "contexts": ["study of form and structure", "study of the form and structure of organisms"]}, {"entity_id": "morphology", "book_id": "kosmos_humboldt_1845", "name": "morphology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["morphology"], "contexts": ["study of form and structure"]}, {"entity_id": "organic_morphology", "book_id": "kosmos_humboldt_1845", "name": "organic morphology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["organic morphology"], "contexts": ["study of