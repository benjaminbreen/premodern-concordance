larity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "snow", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Snow", "similarity": 0.979}, {"source_book": "kosmos_humboldt_1845", "source_name": "snow", "target_book": "first_principles_spencer_1862", "target_name": "snow", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Snow", "target_book": "first_principles_spencer_1862", "target_name": "snow", "similarity": 0.979}], "id": 106, "stable_key": "clu_3f78ca0f45f5efd2", "ground_truth": {"modern_name": "Snow", "confidence": "high", "type": "mineral", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Snow", "wikipedia_extract": "Snow consists of individual ice crystals that grow while suspended in the atmosphere—usually within clouds—and then fall, accumulating on the ground where they undergo further changes. It consists of frozen crystalline water throughout its life cycle, starting when, under suitable conditions, the ice crystals form in the atmosphere, increase to millimeter size, precipitate and accumulate on surfaces, then metamorphose in place, and ultimately melt, slide, or sublimate away. Snowstorms organize and develop by feeding on sources of atmospheric moisture and cold air. Snowflakes nucleate around particles in the atmosphere by attracting supercooled water droplets, which freeze in hexagonal-shaped crystals. Snowflakes take on a variety of shapes, basic among these are platelets, needles, columns, and rime. As snow accumulates into a snowpack, it may blow into drifts."}, "cross_references": [{"found_name": "Ice", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 275, "target_cluster_name": "ice", "source_book": "llm_generated", "evidence_snippet": "Snow is composed of ice crystals.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Snow is composed of ice crystals."}, {"found_name": "Protococcus", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "kosmos_humboldt_1845", "evidence_snippet": "icy crevices of the glaciers on Mount Rosa, the Grindelwald, and the Upper Aar; the Chionaea nivalis (formerly known as Protococcus), exist in the polar snow as well as in that of our high mountains. ", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "formerly known as Chionaea nivalis"}]}, {"canonical_name": "esmeralda", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 6, "total_mentions": 37, "members": [{"entity_id": "emerald", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Emerald", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Emerald"], "contexts": ["stone that breaks during copulation", "gem"]}, {"entity_id": "emerald", "book_id": "kosmos_humboldt_1845", "name": "emerald", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["emerald"], "contexts": ["stone from which obelists were cut"]}, {"entity_id": "esmeralda", "book_id": "coloquios_da_orta_1563", "name": "esmeralda", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 16, "variants": ["esmeralda", "esmeraldas", "esmeraldas do Peru", "esmeraldas occidentaes", "esmeraldas orientaes"], "contexts": ["gemstone", "type of gemstone"]}, {"entity_id": "esmeralda", "book_id": "polyanthea_medicinal", "name": "Esmeralda", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 7, "variants": ["Esmeralda", "elmeraldas", "esmeralda", "esmeraldas", "eſmeraldas"], "contexts": ["powdered emerald attracts poison", "gemstone with occult virtue"]}, {"entity_id": "emerald", "book_id": "connexion_physical_sciences_somerville_1858", "name": "emerald", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["emerald"], "contexts": ["negative crystal with two optic axes"]}, {"entity_id"