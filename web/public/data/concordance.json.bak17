, "name": "vapours", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["vapours"], "contexts": ["gaseous state of matter"]}, {"entity_id": "vapour", "book_id": "first_principles_spencer_1862", "name": "vapour", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 6, "variants": ["vapour"], "contexts": ["gaseous state of water", "raised from sea by solar forces"]}, {"entity_id": "vapour_of_water", "book_id": "first_principles_spencer_1862", "name": "vapour of water", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["vapour of water"], "contexts": ["gaseous state of water"]}, {"entity_id": "atmospheric_vapour", "book_id": "first_principles_spencer_1862", "name": "atmospheric vapour", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["atmospheric vapour"], "contexts": ["water diffused in a gaseous state"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Vapour", "target_book": "first_principles_spencer_1862", "target_name": "vapour", "similarity": 0.991}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Vapour", "target_book": "first_principles_spencer_1862", "target_name": "vapour of water", "similarity": 0.884}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Vapour", "target_book": "first_principles_spencer_1862", "target_name": "atmospheric vapour", "similarity": 0.931}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Aqueous vapour", "target_book": "first_principles_spencer_1862", "target_name": "vapour", "similarity": 0.959}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Aqueous vapour", "target_book": "first_principles_spencer_1862", "target_name": "vapour of water", "similarity": 0.927}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Aqueous vapour", "target_book": "first_principles_spencer_1862", "target_name": "atmospheric vapour", "similarity": 0.961}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "mercurial vapour", "target_book": "first_principles_spencer_1862", "target_name": "vapour", "similarity": 0.883}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "mercurial vapour", "target_book": "first_principles_spencer_1862", "target_name": "atmospheric vapour", "similarity": 0.882}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "vapours", "target_book": "first_principles_spencer_1862", "target_name": "vapour", "similarity": 0.969}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "vapours", "target_book": "first_principles_spencer_1862", "target_name": "vapour of water", "similarity": 0.887}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "vapours", "target_book": "first_principles_spencer_1862", "target_name": "atmospheric vapour", "similarity": 0.935}], "id": 1655, "stable_key": "clu_7b5f0a45468b4f28", "ground_truth": {"modern_name": "Vapor", "confidence": "high", "type": "concept", "note": "This cluster refers to the gaseous state of matter, particularly relevant in early thermodynamics and chemistry. 'Aqueous vapour' is water in gaseous form.", "wikidata_id": "Q255722", "wikidata_description": "a substance in the gas phase at a temperature lower than its critical point", "wikipedia_url": "https://en.wikipedia.org/wiki/Vapor", "wikipedia_extract": "In physics, a vapor (American English) or vapour (Commonwealth English; see spelling differences) is a substance in the gas phase at a temperature lower than its critical temperature, which means that the vapor can be condensed to a liquid by increasing the pressure on it without reducing the temperature of the vapor. A vapor is different from an aerosol. An aerosol is a suspension of tiny particles of liquid, solid, or both within a gas. For example, water has a critical temperature of 647 K (374 °C; 705 °F), which is the highest temperature at which liquid water can exist at any pressure. In the atmosphere at ordinary temperatures gaseous water (known as water vapor) will condense into a liquid if its partial pressure is increased sufficiently. A vapor may coexist with a liquid (or a solid)."}, "cross_references": [{"found_name": "Air", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 109, "target_cluster_name": "air", "source_book": "llm_generated", "evidence_snippet": "Vapor is a substance in the gas phase, and air is a mixture of gases.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Vapor is a substance in the gas phase, and air is a mixture of gases."}, {"found_name": "Gas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 171, "target_cluster_name": "gas", "source_book": "llm_generated", "evidence_snippet": "Vapor is a substance in the gas phase.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Vapor is a substance in the gas phase."}, {"found_name": "Gaseous substances", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2321, "target_cluster_name": "gaseous", "source_book": "llm_generated", "evidence_snippet": "Vapor is a substance in the gas phase.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Vapor is a substance in the gas phase."}, {"found_name": "Gases", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 725, "target_cluster_name": "gases", "source_book": "llm_generated", "evidence_snippet": "Vapor is a substance in the gas phase.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Vapor is a substance in the gas phase."}]}, {"canonical_name": "Ramusio", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 30, "members": [{"entity_id": "ramuzius", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Ramuzius", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Ramuzius"], "contexts": ["author on dish composition"]}, {"entity_id": "ramusio", "book_id": "coloquios_da_orta_1563", "name": "Ramusio", "category": "PERSON", "subcategory": "SCHOLAR", "count": 29, "variants": ["Ramusio", "Ramasio", "Ramu-sio", "Ramudo", "Ramásio"], "contexts": ["version of Marco Polo's phrase", "included merchant's relation in his book"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ramuzius", "target_book": "coloquios_da_orta_1563", "target_name": "Ramusio", "similarity": 0.876}], "id": 1656, "stable_key": "clu_7919c3d4ae10b95a", "ground_truth": {"modern_name": "Giovanni Battista Ramusio", "confidence": "high", "type": "person", "birth_year": 1485, "death_year": 1557, "description": "Venetian geographer and editor known for his 'Navigazioni e Viaggi'.", "note": "The name 'Ramusio' is clearly linked to the author of a major collection of travel narratives, 'Navigazioni et Viaggi'. The 'Ramuzius' spelling is a Latinized variant.", "wikidata_id": "Q1378950", "wikidata_description": "Venetian geographer and writer (1485-1557)", "wikipedia_url": "https://en.wikipedia.org/wiki/Giovanni%20Battista%20Ramusio", "wikipedia_extract": "Giovanni Battista Ramusio (Italian pronunciation: [dʒoˈvanni batˈtista raˈmuːzjo]; July 20, 1485 – July 10, 1557) was an Italian geographer and travel writer. Born in Treviso, Italy, at that time in the Republic of Venice, Ramusio was the son of Paolo Ramusio, a magistrate of the Venetian city-state. In 1505 young Giovanni took a position as secretary to  Aloisio Mocenigo, of the patrician Mocenigo family, then serving as the Republic's ambassador to France. Ramusio would spend the rest of his career in Venetian service. He was keenly interested in geography, and his position ensured that he would receive news of all the latest discoveries from explorers around Europe as they were sent back to Venice. A learned man, fluent in several languages, he began to compile these documents and translated them into Italian, then the most widely understood of the European languages."}, "cross_references": [{"found_name": "Marco Polo", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 596, "target_cluster_name": "Marco Polo", "source_book": "llm_generated", "evidence_snippet": "Ramusio was a geographer and editor who compiled and published accounts of voyages, including those of explorers like Marco Polo, making their discoveries accessible to a wider audience.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Ramusio was a geographer and editor who compiled and published accounts of voyages, including those of explorers like Marco Polo, making their discoveries accessible to a wider audience.", "is_reverse": true}]}, {"canonical_name": "May", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 30, "members": [{"entity_id": "may", "book_id": "english_physician_1652", "name": "May", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 28, "variants": ["May"], "contexts": ["month when plant flowers", "month when Alder-Tree flowers"]}, {"entity_id": "may", "book_id": "kosmos_humboldt_1845", "name": "May", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["May"], "contexts": ["month associated with frosts and flowering", "month with specific cold days"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "May", "target_book": "kosmos_humboldt_1845", "target_name": "May", "similarity": 1.0}], "id": 1657, "stable_key": "clu_7f92c34daf5e7480", "ground_truth": {"modern_name": "May", "confidence": "high", "type": "concept", "note": "This refers to the month of May, a common reference point in historical texts for timing natural events like plant flowering or seasonal weather patterns.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/May", "wikipedia_extract": "May is the fifth month of the year in the Julian  and Gregorian calendars. Its length is 31 days. May is a month of spring in the Northern Hemisphere, and autumn in the Southern Hemisphere. Therefore, May in the Southern Hemisphere is the seasonal equivalent of November in the Northern Hemisphere and vice versa. Late May typically marks the start of the summer vacation season in the United States (Memorial Day) and Canada (Victoria Day) that ends on Labor Day, the first Monday of September. May (in Latin, Maius) was named for the Greek goddess Maia, who was identified with the Roman era goddess of fertility, Bona Dea, whose festival was held in May."}, "cross_references": [{"found_name": "Autumn", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 911, "target_cluster_name": "Autumn", "source_book": "llm_generated", "evidence_snippet": "The description explicitly states that May is autumn in the Southern Hemisphere, making it seasonally equivalent to November in the Northern Hemisphere.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The description explicitly states that May is autumn in the Southern Hemisphere, making it seasonally equivalent to November in the Northern Hemisphere."}, {"found_name": "Agriculture", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 403, "target_cluster_name": "agriculture", "source_book": "llm_generated", "evidence_snippet": "May is a significant month for agricultural activities in many parts of the world, particularly in the Northern Hemisphere.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "May is a significant month for agricultural activities in many parts of the world, particularly in the Northern Hemisphere."}, {"found_name": "Horticulture", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 3960, "target_cluster_name": "horticulture", "source_book": "llm_generated", "evidence_snippet": "Similar to agriculture, May is a key month for horticultural practices such as planting and tending gardens.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Similar to agriculture, May is a key month for horticultural practices such as planting and tending gardens."}, {"found_name": "June", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 69, "target_cluster_name": "June", "source_book": "llm_generated", "evidence_snippet": "May and June are consecutive months in the Gregorian calendar, and their temporal proximity often leads to discussions of seasonal changes and agricultural cycles.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: May and June are consecutive months in the Gregorian calendar, and their temporal proximity often leads to discussions of seasonal changes and agricultural cycles.", "is_reverse": true}, {"found_name": "Spring", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1680, "target_cluster_name": "Spring", "source_book": "llm_generated", "evidence_snippet": "May is a month that falls within the season of Spring.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: May is a month that falls within the season of Spring.", "is_reverse": true}, {"found_name": "April", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 129, "target_cluster_name": "April", "source_book": "llm_generated", "evidence_snippet": "April is the month immediately preceding May.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "April is the month immediately preceding May."}]}, {"canonical_name": "spinal cord", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 35, "members": [{"entity_id": "spinal_cord", "book_id": "principles_of_psychology_james_1890", "name": "spinal cord", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 28, "variants": ["spinal cord", "Spinal cord"], "contexts": ["central nervous system pathway", "part of the central nervous system"]}, {"entity_id": "spinal_column", "book_id": "first_principles_spencer_1862", "name": "spinal column", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["spinal column"], "contexts": ["part of the vertebral column"]}, {"entity_id": "spinal_segment", "book_id": "first_principles_spencer_1862", "name": "spinal segment", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["spinal segment"], "contexts": ["part of the vertebral column"]}, {"entity_id": "s_c", "book_id": "principles_of_psychology_james_1890", "name": "S C", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["S C"], "contexts": ["spinal cord", "Spinal cord in diagram"]}, {"entity_id": "s_b_a", "book_id": "connexion_physical_sciences_somerville_1858", "name": "S b a", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["S b a"], "contexts": ["angle in parallax measurement"]}, {"entity_id": "s_a_b", "book_id": "connexion_physical_sciences_somerville_1858", "name": "S a b", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["S a b"], "contexts": ["angle in parallax measurement"]}, {"entity_id": "s_c", "book_id": "connexion_physical_sciences_somerville_1858", "name": "S C", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["S C"], "contexts": ["line segment in parallax calculation"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "spinal cord", "target_book": "first_principles_spencer_1862", "target_name": "spinal column", "similarity": 0.896}, {"source_book": "principles_of_psychology_james_1890", "source_name": "spinal cord", "target_book": "first_principles_spencer_1862", "target_name": "spinal segment", "similarity": 0.904}], "id": 1658, "stable_key": "clu_f1ac340b097b935a", "ground_truth": {"modern_name": "Spinal cord", "confidence": "high", "type": "object", "note": "While 'spinal column' and 'spinal segment' are related, the primary referent is the 'spinal cord' given the frequency and context of 'central nervous system pathway'.", "wikidata_id": "Q2997445", "wikidata_description": "body organ", "wikipedia_url": "https://en.wikipedia.org/wiki/Anterior%20grey%20column"}, "member_count": 7, "cross_references": [{"found_name": "Nervous system", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1588, "target_cluster_name": "nervous system", "source_book": "llm_generated", "evidence_snippet": "The spinal cord is a primary component of the nervous system.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The spinal cord is a primary component of the nervous system."}, {"found_name": "Motor neuron", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2581, "target_cluster_name": "motor nerve", "source_book": "llm_generated", "evidence_snippet": "Motor neurons are a type of nerve cell that originates in the spinal cord and transmits signals to muscles.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Motor neurons are a type of nerve cell that originates in the spinal cord and transmits signals to muscles."}, {"found_name": "Nervous tissue", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2577, "target_cluster_name": "nerve-tissue", "source_book": "llm_generated", "evidence_snippet": "The spinal cord is composed of nervous tissue.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The spinal cord is composed of nervous tissue."}]}, {"canonical_name": "fome", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 6, "total_mentions": 35, "members": [{"entity_id": "fome", "book_id": "coloquios_da_orta_1563", "name": "fome", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 2, "variants": ["fome"], "contexts": ["condition of captive animals", "condition of starvation"]}, {"entity_id": "fome", "book_id": "polyanthea_medicinal", "name": "fome", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 28, "variants": ["fome", "Fome", "fome insaciavel"], "contexts": ["symptom of increased appetite", "symptom of intense sleepiness"]}, {"entity_id": "famine", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Famine", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Famine"], "contexts": ["condition signified by maggots"]}, {"entity_id": "famine", "book_id": "origin_of_species_darwin_1859", "name": "famine", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["famine"], "contexts": ["widespread scarcity of food"]}, {"entity_id": "fame", "book_id": "historia_medicinal_monardes_1574", "name": "fame", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["fame"], "contexts": ["hunger"]}, {"entity_id": "fame", "book_id": "polyanthea_medicinal", "name": "fame", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["fame"], "contexts": ["hunger"]}, {"entity_id": "famine", "book_id": "first_principles_spencer_1862", "name": "famine", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["famine"], "contexts": ["widespread scarcity of food"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "fome", "target_book": "polyanthea_medicinal", "target_name": "fome", "similarity": 0.877}], "id": 1659, "stable_key": "clu_755abbf7a830f3ae", "ground_truth": {"modern_name": "Hunger", "confidence": "high", "type": "disease", "modern_term": "Starvation", "note": "While 'starvation' is the extreme form, 'hunger' is the direct translation and the concept itself.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_extract": "Muselmann (German plural Muselmänner) was a term used amongst prisoners of German Nazi concentration camps during the Holocaust of World War II to refer to those suffering from a combination of starvation (known also as \"hunger disease\") and exhaustion, as well as those who were resigned to their impending death. The Muselmann prisoners exhibited severe emaciation and physical weakness, an apathetic listlessness regarding their own fate, and unresponsiveness to their surroundings owing to their barbaric treatment. Some scholars argue that the term possibly comes from the Muselmanns' inability to stand for any time due to the loss of leg muscle, thus leading them to spend much of their time in a prone position. Muselmann also literally means \"a Muslim\" in Yiddish and a number of other languages (albeit with spelling differences), and ultimately derives from the Old Turkish word for Muslim, مسلمان (müsliman). \"Muselmann\" seemingly derives from the German: Muselman, a historical term for \"Muslim\" (literally 'mussulman') which is now considered derogatory. If this derivation is correct, \"Muselmann\" would literally mean \"Muslim man\" (Muselman + Mann); but how this term later came to be used to denote starving concentration camp prisoners is uncertain.", "wikipedia_url": "https://en.wikipedia.org/wiki/Hunger"}, "member_count": 7, "cross_references": [{"found_name": "Exhaustion", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3509, "target_cluster_name": "exhaustion", "source_book": "llm_generated", "evidence_snippet": "The description of 'Muselmann' explicitly links starvation ('hunger disease') with exhaustion.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The description of 'Muselmann' explicitly links starvation ('hunger disease') with exhaustion."}]}, {"canonical_name": "doença", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 30, "members": [{"entity_id": "doença", "book_id": "coloquios_da_orta_1563", "name": "doença", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["doença"], "contexts": ["a specific illness"]}, {"entity_id": "doença", "book_id": "polyanthea_medicinal", "name": "doença", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 29, "variants": ["doença", "Doença"], "contexts": ["forget the illness", "medical condition"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "doença", "target_book": "polyanthea_medicinal", "target_name": "doença", "similarity": 1.0}], "id": 1660, "stable_key": "clu_adcf376a0883aa64", "ground_truth": {"modern_name": "Disease", "confidence": "high", "type": "disease", "modern_term": "Disease", "note": " 'Doença' is the Portuguese word for disease and is used generically in the provided contexts. It refers to illness in general, not a specific condition."}, "cross_references": []}, {"canonical_name": "remedio", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 29, "members": [{"entity_id": "remedio", "book_id": "historia_medicinal_monardes_1574", "name": "remedio", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["remedio", "remedios chirurgicales"], "contexts": ["cure or treatment", "remedy"]}, {"entity_id": "remedio", "book_id": "polyanthea_medicinal", "name": "remedio", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 25, "variants": ["remedio", "remedios mornos", "remediospurgativos"], "contexts": ["A cure or treatment", "treatment or cure"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "remedio", "target_book": "polyanthea_medicinal", "target_name": "remedio", "similarity": 1.0}], "id": 1661, "stable_key": "clu_cea96dfd7f2f8592", "ground_truth": {"modern_name": "Remedy", "confidence": "high", "type": "concept", "description": "A medicine or treatment for a disease or injury.", "note": "'Remedio' is the Spanish/Portuguese word for remedy.", "wikipedia_extract": "Remedio is an Israeli cybersecurity company based in Tel Aviv. Founded in 2019 by cybersecurity entrepreneurs Tal Kollender, Gilad Raz, and Yakov Kogan, the company develops an AI-driven platform for device posture management, automated configuration hardening, and risk remediation. Remedio began in 2019 under the name GYTPOL, founded by Tal Kollender (CEO), Gilad Raz, and Yakov Kogan. That same year, Israel Aerospace Industries (IAI) became the company’s first customer. GYTPOL’s platform addressed the problem of hidden misconfigurations on enterprise endpoints. Check Point Software Technologies, a multinational cybersecurity company, was its first cybersecurity customer."}, "cross_references": [{"found_name": "lingua arietis", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "polyanthea_medicinal", "evidence_snippet": "molhados empartes iguaes deagua rofada , & cumo de ervamoura , em que tenhão desfeyto quatro grãos de laudano opiado , & huma onçade vinagrerofado,he bom remedio Asfor lhas,& raizes de Arnoglofia , ch", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "alternative name for Arnoglofia"}, {"found_name": "tanchagem macho", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": null, "target_cluster_name": null, "source_book": "polyanthea_medicinal", "evidence_snippet": "molhados empartes iguaes deagua rofada , & cumo de ervamoura , em que tenhão desfeyto quatro grãos de laudano opiado , & huma onçade vinagrerofado,he bom remedio Asfor lhas,& raizes de Arnoglofia , ch", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "vulgar name for Arnoglofia"}]}, {"canonical_name": "Veneza", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 29, "members": [{"entity_id": "veneza", "book_id": "coloquios_da_orta_1563", "name": "Veneza", "category": "PLACE", "subcategory": "CITY", "count": 27, "variants": ["Veneza", "Venetia", "Venezia"], "contexts": ["city of origin for ships", "received gifts from sultans of Egypt"]}, {"entity_id": "veneza", "book_id": "polyanthea_medicinal", "name": "Veneza", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Veneza"], "contexts": ["city where plague recurred", "city where a plague occurred"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Veneza", "target_book": "polyanthea_medicinal", "target_name": "Veneza", "similarity": 1.0}], "id": 1662, "stable_key": "clu_b3ce368969aca756-2", "ground_truth": {"modern_name": "Venice", "confidence": "high", "type": "place", "description": "Major city-state in Italy, a historical center of trade and culture.", "wikipedia_extract": "Venice is a city in northeastern Italy and the capital of the region of Veneto. It is built on a group of 126 islands that are separated by expanses of open water and by canals; portions of the city are linked by 472 bridges. The islands are in the shallow Venetian Lagoon, an enclosed bay lying between the mouths of the Po and the Piave rivers (more exactly between the Brenta and the Sile). As of 2025, the city proper (comune of Venice) has 249,466 inhabitants, nearly 50,000 of whom live in the historical island city of Venice (centro storico), while most of the population resides on the mainland (terraferma), and about 25,000 live on other islands in the lagoon (estuario). Together with the cities of Padua and Treviso, Venice is included in the Padua-Treviso-Venice Metropolitan Area (PATREVE), which is considered a statistical metropolitan area, with a total population of 2.6 million. The name is derived from the ancient Veneti people who inhabited the region by the 10th century BC."}, "cross_references": [{"found_name": "Italy", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 88, "target_cluster_name": "Itália", "source_book": "llm_generated", "evidence_snippet": "Venice is a city in northeastern Italy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Venice is a city in northeastern Italy."}, {"found_name": "Mediterranean Sea", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 256, "target_cluster_name": "Méditerranée", "source_book": "llm_generated", "evidence_snippet": "Venice is a major maritime republic historically situated on the Mediterranean Sea.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Venice is a major maritime republic historically situated on the Mediterranean Sea."}, {"found_name": "Genoa", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 419, "target_cluster_name": "Genève", "source_book": "llm_generated", "evidence_snippet": "Both Venice and Genoa were major maritime republics and rivals in the Mediterranean.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both Venice and Genoa were major maritime republics and rivals in the Mediterranean."}, {"found_name": "Constantinople", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 778, "target_cluster_name": "Constantinopla", "source_book": "llm_generated", "evidence_snippet": "Venice and Constantinople were major trading centers and rivals in the Eastern Mediterranean.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Venice and Constantinople were major trading centers and rivals in the Eastern Mediterranean."}]}, {"canonical_name": "Greci", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 29, "members": [{"entity_id": "greci", "book_id": "ricettario_fiorentino_1597", "name": "Greci", "category": "PERSON", "subcategory": "AUTHORITY", "count": 27, "variants": ["Greci", "Grcci"], "contexts": ["ancient Greek inventors and scholars", 