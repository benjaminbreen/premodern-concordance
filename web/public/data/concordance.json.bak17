e_book": "principles_of_psychology_james_1890", "source_name": "rheumatism", "target_book": "coloquios_da_orta_1563", "target_name": "rheumatismo", "similarity": 0.969}, {"source_book": "principles_of_psychology_james_1890", "source_name": "rheumatism", "target_book": "polyanthea_medicinal", "target_name": "Rheumatismos", "similarity": 0.965}, {"source_book": "coloquios_da_orta_1563", "source_name": "rheumatismo", "target_book": "polyanthea_medicinal", "target_name": "Rheumatismos", "similarity": 0.943}], "id": 796, "stable_key": "clu_41cb232fcbf3d2e6", "ground_truth": {"modern_name": "Rheumatism", "confidence": "high", "type": "disease", "description": "Inflammatory condition causing pain and stiffness in joints.", "wikipedia_extract": "Rheumatism  (from the Ancient Greek ῥεῦμα, rheûma) or rheumatic disorders are conditions causing chronic, often intermittent pain affecting the joints or connective tissue. Rheumatism does not designate any specific disorder, but covers at least 200 different conditions, including arthritis and  \"non-articular rheumatism\", also known as \"regional pain syndrome\" or \"soft tissue rheumatism\". There is a close overlap between the term soft tissue disorder and rheumatism. Sometimes the term \"soft tissue rheumatic disorders\" is used to describe these conditions. The term \"Rheumatic Diseases\" is used in MeSH to refer to connective tissue disorders. The branch of medicine devoted to the diagnosis and therapy of rheumatism is called rheumatology."}, "cross_references": [{"found_name": "Ciatica", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1501, "target_cluster_name": "Ciatica", "source_book": "llm_generated", "evidence_snippet": "Historically, sciatica was often conflated with or considered a form of rheumatism due to the shared symptom of pain in the limbs and back.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Historically, sciatica was often conflated with or considered a form of rheumatism due to the shared symptom of pain in the limbs and back.", "is_reverse": true}]}, {"canonical_name": "Phil. Trans.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 23, "members": [{"entity_id": "philos__trans_", "book_id": "principles_of_psychology_james_1890", "name": "Philos. Trans.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Philos. Trans."], "contexts": ["publication reference"]}, {"entity_id": "phil__trans_", "book_id": "kosmos_humboldt_1845", "name": "Phil. Trans.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 8, "variants": ["Phil. Trans."], "contexts": ["scientific journal publishing astronomical observations", "publication of the Royal Society"]}, {"entity_id": "philos__trans_", "book_id": "kosmos_humboldt_1845", "name": "Philos. Trans.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["Philos. Trans."], "contexts": ["publication for astronomical data", "publication of the Royal Society"]}, {"entity_id": "phil__trans_", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Phil. Trans.", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Phil. Trans."], "contexts": ["publication title"]}, {"entity_id": "philosophical_transactions", "book_id": "principles_of_psychology_james_1890", "name": "Philosophical Transactions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Philosophical Transactions"], "contexts": ["scientific journal", "publication of the Royal Society"]}, {"entity_id": "philosophical_transactions", "book_id": "kosmos_humboldt_1845", "name": "Philosophical Transactions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Philosophical Transactions"], "contexts": ["publication of experimental sciences", "scientific journal publishing article on compass"]}, {"entity_id": "philosophical_transactions", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Philosophical Transactions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Philosophical Transactions"], "contexts": ["journal where Herschel published"]}, {"entity_id": "philos__transactions", "book_id": "principles_of_psychology_james_1890", "name": "Philos. Transactions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Philos. Transactions"], "contexts": ["journal of the Royal Society"]}, {"entity_id": "philos__transactions", "book_id": "kosmos_humboldt_1845", "name": "Philos. Transactions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Philos. Transactions"], "contexts": ["scientific journal"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Philos. Trans.", "target_book": "kosmos_humboldt_1845", "target_name": "Phil. Trans.", "similarity": 0.888}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Philos. Trans.", "target_book": "kosmos_humboldt_1845", "target_name": "Philos. Trans.", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Philos. Trans.", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Phil. Trans.", "similarity": 0.888}, {"source_book": "kosmos_humboldt_1845", "source_name": "Phil. Trans.", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Phil. Trans.", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Philos. Trans.", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Phil. Trans.", "similarity": 0.888}], "id": 797, "stable_key": "clu_7142656277063de4", "ground_truth": {"modern_name": "Philosophical Transactions of the Royal Society", "confidence": "high", "type": "text", "wikidata_id": "Q913162", "wikidata_description": "British scientific journal published by the Royal Society", "wikipedia_url": "https://en.wikipedia.org/wiki/Philosophical%20Transactions%20of%20the%20Royal%20Society", "note": "This refers to the scientific journal published by the Royal Society.", "wikipedia_extract": "Philosophical Transactions of the Royal Society is a scientific journal published by the Royal Society. In its earliest days, it was a private venture of the Royal Society's secretary. It was established in 1665, making it the second journal in the world exclusively devoted to science, after the Journal des sçavans, and therefore also the world's longest-running scientific journal. It became an official society publication in 1752. The use of the word philosophical in the title refers to natural philosophy, which was the equivalent of what would now be generally called science. In 1887 the journal expanded and divided into two separate publications, one serving the physical sciences (Philosophical Transactions of the Royal Society A: Mathematical, Physical and Engineering Sciences) and the other focusing on the life sciences (Philosophical Transactions of the Royal Society B: Biological Sciences)."}, "member_count": 9, "cross_references": [{"found_name": "Annales de Chimie", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1778, "target_cluster_name": "Annales de Chimie", "source_book": "llm_generated", "evidence_snippet": "Both are historical scientific journals, representing important publications in chemistry and broader science respectively.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are historical scientific journals, representing important publications in chemistry and broader science respectively."}, {"found_name": "Comptes Rendus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1905, "target_cluster_name": "Comptes Rendus", "source_book": "llm_generated", "evidence_snippet": "Both are historical scientific journals, with Comptes Rendus being a significant publication from the French Academy of Sciences.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are historical scientific journals, with Comptes Rendus being a significant publication from the French Academy of Sciences."}]}, {"canonical_name": "elasticity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 15, "members": [{"entity_id": "elasticity", "book_id": "principles_of_psychology_james_1890", "name": "elasticity", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["elasticity"], "contexts": ["property of returning to shape"]}, {"entity_id": "elastic_forces", "book_id": "kosmos_humboldt_1845", "name": "elastic forces", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["elastic forces"], "contexts": ["forces that can return to original shape", "forces related to tension and compression"]}, {"entity_id": "elasticity", "book_id": "connexion_physical_sciences_somerville_1858", "name": "elasticity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 11, "variants": ["Elasticity", "elasticity"], "contexts": ["ability to return to original shape", "ability to regain original shape after deformation"]}, {"entity_id": "elastic_force", "book_id": "connexion_physical_sciences_somerville_1858", "name": "elastic force", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["elastic force"], "contexts": ["pressure exerted by gas particles"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "elasticity", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "elasticity", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "elasticity", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "elastic force", "similarity": 0.906}, {"source_book": "kosmos_humboldt_1845", "source_na