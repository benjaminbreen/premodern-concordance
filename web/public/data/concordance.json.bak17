cross_references": [{"found_name": "James Prescott Joule", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1276, "target_cluster_name": "Mr. Joule", "source_book": "llm_generated", "evidence_snippet": "Augustus Seebeck and James Prescott Joule were both prominent physicists in the 19th century who made significant contributions to the understanding of electricity and magnetism, particularly in the area of thermoelectricity and the relationship between heat and electrical energy. They were contemporaries and their work was often discussed and compared in scientific circles.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Augustus Seebeck and James Prescott Joule were both prominent physicists in the 19th century who made significant contributions to the understanding of electricity and magnetism, particularly in the area of thermoelectricity and the relationship between heat and electrical energy. They were contemporaries and their work was often discussed and compared in scientific circles."}]}, {"canonical_name": "aggregation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "aggregation", "book_id": "kosmos_humboldt_1845", "name": "aggregation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["aggregation"], "contexts": ["state of being collected together"]}, {"entity_id": "aggregation", "book_id": "first_principles_spencer_1862", "name": "aggregation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["aggregation"], "contexts": ["grouping together", "process of coming together"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "aggregation", "target_book": "first_principles_spencer_1862", "target_name": "aggregation", "similarity": 1.0}], "id": 2616, "stable_key": "clu_ea720247fdd61551", "ground_truth": {"modern_name": "Aggregation", "confidence": "high", "type": "concept", "wikidata_id": "Q23007394", "wikidata_description": "act of collecting together physical or conceptual objects"}, "cross_references": [{"found_name": "crystallization", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 986, "target_cluster_name": "crystallization", "source_book": "llm_generated", "evidence_snippet": "Crystallization is a specific form of aggregation where particles arrange into a regular structure.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Crystallization is a specific form of aggregation where particles arrange into a regular structure.", "is_reverse": true}, {"found_name": "Association of Ideas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1992, "target_cluster_name": "association of ideas", "source_book": "llm_generated", "evidence_snippet": "The Doctrine of Association, a key concept in psychology and philosophy, posits that ideas or experiences that occur together become linked in the mind, leading to their subsequent recall together. This is a specific form of aggregation of mental content.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Doctrine of Association, a key concept in psychology and philosophy, posits that ideas or experiences that occur together become linked in the mind, leading to their subsequent recall together. This is a specific form of aggregation of mental content."}]}, {"canonical_name": "Matheo", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "matheo", "book_id": "historia_medicinal_monardes_1574", "name": "Matheo", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Matheo", "Matheo de Gradi", "Matheo filuatico", "Matheo ſiluatico"], "contexts": ["scholar discussing Iron's temperature", "Matheo filuatico says thus"]}, {"entity_id": "matth_", "book_id": "polyanthea_medicinal", "name": "Matth.", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Matth."], "contexts": ["Biblical author, Gospel of Matthew", "author cited"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Matheo", "target_book": "polyanthea_medicinal", "target_name": "Matth.", "similarity": 0.863}], "id": 2617, "stable_key": "clu_e88896b78445c506", "ground_truth": {"modern_name": "Matthew", "confidence": "medium", "type": "person", "description": "Biblical author of the Gospel of Matthew.", "note": "The context 'scholar discussing Iron's temperature' suggests a specific author or physician. However, 'Matheo' and 'Matth.' are common abbreviations and could refer to various individuals, including the Apostle Matthew if a quote is being referenced indirectly.", "wikidata_id": "Q43600", "wikidata_description": "Christian evangelist and apostle"}, "cross_references": []}, {"canonical_name": "dolores frios", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "dolores_frios", "book_id": "historia_medicinal_monardes_1574", "name": "dolores frios", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 3, "variants": ["dolores frios", "dolor de frio", "dolores frios y ventosos"], "contexts": ["cold pains treated by the water", "pain caused by cold"]}, {"entity_id": "tremor_de_frio", "book_id": "polyanthea_medicinal", "name": "tremor de frio", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 2, "variants": ["tremor de frio"], "contexts": ["symptom of fever", "symptom of shivering with cold"]}, {"entity_id": "frios_dolorificos", "book_id": "polyanthea_medicinal", "name": "frios dolorificos", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["frios dolorificos"], "contexts": ["symptom of excess acidity of pancreatic juice"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "dolores frios", "target_book": "polyanthea_medicinal", "target_name": "tremor de frio", "similarity": 0.88}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "dolores frios", "target_book": "polyanthea_medicinal", "target_name": "frios dolorificos", "similarity": 0.978}], "id": 2618, "stable_key": "clu_4b96e670a36ee798", "ground_truth": {"modern_name": "Cold sweats", "confidence": "high", "type": "disease", "description": "A symptom characterized by cold, clammy perspiration, often associated with illness.", "note": "This cluster includes terms referring to cold pains and cold sweats in Spanish and English.", "wikipedia_extract": "Sweating sickness, also known as the sweats, English sweating sickness, English sweat or sudor anglicus in Latin, was a mysterious and contagious disease that struck England and later continental Europe in a series of epidemics beginning in 1485. Other major outbreaks of the English sweating sickness occurred in 1508, 1517, and 1528, with the last outbreak in 1551, after which the disease apparently vanished. The onset of symptoms was sudden, and death or recovery often occurred within 8–10 hours. Sweating sickness epidemics were unique compared with other disease outbreaks of the time: whereas other epidemics were typically urban and long-lasting, cases of sweating sickness spiked and receded very quickly, significantly affecting rural populations. Its cause remains unknown, although it has been suggested that an unknown species of hantavirus was responsible. John Caius was a physician in Shrewsbury in 1551, when an outbreak occurred, and he described the symptoms and signs of the disease in A Boke or Counseill Against the Disease Commonly Called the Sweate, or Sweatyng Sicknesse (1552), which is the main historical source of knowledge of the disease."}, "cross_references": []}, {"canonical_name": "Levante", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "levante", "book_id": "historia_medicinal_monardes_1574", "name": "Levante", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Levante"], "contexts": ["region from which Cañafistola used to come", "origin of Ruybarbo"]}, {"entity_id": "levante", "book_id": "ricettario_fiorentino_1597", "name": "Levante", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Levante"], "contexts": ["region producing good musk", "Eastern Mediterranean region"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Levante", "target_book": "ricettario_fiorentino_1597", "target_name": "Levante", "similarity": 1.0}], "id": 2619, "stable_key": "clu_9e23489407850742", "ground_truth": {"modern_name": "Levant", "confidence": "high", "type": "place", "description": "A region in the Eastern Mediterranean or its origin of goods.", "note": "Refers to the Eastern Mediterranean region and its products.", "wikipedia_extract": "The Levant is a subregion of West Asia along the Eastern Mediterranean, that forms part of the Middle East. The term is often used in conjunction with historical or cultural references. In its narrowest sense, used in archaeology and other contexts, the Levant refers to Cyprus and land bordering the Mediterranean Sea in West Asia that includes the Syria region, Lebanon, Jordan, Palestine, Israel, and south Cilicia (Turkey). In its widest historical sense, the Levant included all the Eastern Mediterranean; extending from Greece to Egypt and Cyrenaica (Eastern Libya). The Levant represents the land bridge between Africa and Eurasia, has been described as the crossroads of West Asia, Eastern Mediterranean, and Northeast Africa, and geologically as the \"northwest of the Arabian plate\". In the 13th and 14th centuries, levante was used for Italian maritime commerce in the Eastern Mediterranean, including Greece, Anatolia, Syria-Palestine, and Egypt, that is the lands east of Venice."}, "cross_references": [{"found_name": "Oriente", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1590, "target_cluster_name": "Oriente", "source_book": "llm_generated", "evidence_snippet": "The Levant is a region historically considered part of the 'Eastern world'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Levant is a region historically considered part of the 'Eastern world'.", "is_reverse": true}, {"found_name": "Syria", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1702, "target_cluster_name": "Syria", "source_book": "llm_generated", "evidence_snippet": "Syria is a core part of the historical Levant.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Syria is a core part of the historical Levant."}, {"found_name": "Creta", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 510, "target_cluster_name": "Creta", "source_book": "llm_generated", "evidence_snippet": "Crete is an island within the Eastern Mediterranean, often included in broader definitions of the Levant.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Crete is an island within the Eastern Mediterranean, often included in broader definitions of the Levant."}]}, {"canonical_name": "Señores", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "señores", "book_id": "historia_medicinal_monardes_1574", "name": "Señores", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Señores", "señores"], "contexts": ["lords or gentlemen", "rulers who can be poisoned"]}, {"entity_id": "senhores", "book_id": "coloquios_da_orta_1563", "name": "senhores", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["senhores", "Senhor Deos", "seniorem"], "contexts": ["lords", "Latin for senior"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Señores", "target_book": "coloquios_da_o