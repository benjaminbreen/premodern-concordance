al_name": "sangrias", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 3, "total_mentions": 277, "members": [{"entity_id": "sangrar", "book_id": "historia_medicinal_monardes_1574", "name": "sangrar", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 4, "variants": ["sangrar", "sangría", "sangrías"], "contexts": ["bloodletting", "medical practice for illness"]}, {"entity_id": "sangria", "book_id": "historia_medicinal_monardes_1574", "name": "sangria", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sangria"], "contexts": ["bloodletting, to be avoided"]}, {"entity_id": "sangria", "book_id": "coloquios_da_orta_1563", "name": "sangria", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 14, "variants": ["sangria", "sangrar", "sangrarme", "sangreio", "sangrese", "sangria no artelho"], "contexts": ["bloodletting practice", "implied medical practice"]}, {"entity_id": "sangrias", "book_id": "polyanthea_medicinal", "name": "sangrias", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 258, "variants": ["sangrias", "Sangria", "Sangrias", "Sangriasbaixas", "sangra", "sangrada", "sangrado", "sangraf", "sangraflem", "sangralla", "sangrallas", "sangrallo", "sangrando", "sangrar", "sangrarem", "sangraremos", "sangrarmos", "sangrem", "sangremos", "sangria", "sangriada", "sangrias altas", "sangrias arteriosas", "sangrias bayxas", "sangrias copiosas", "sangrias dos braços", "sangrias dos pès", "sangrou"], "contexts": ["bloodletting, a medical procedure", "bloodletting"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "sangrar", "target_book": "coloquios_da_orta_1563", "target_name": "sangria", "similarity": 0.885}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "sangrar", "target_book": "polyanthea_medicinal", "target_name": "sangrias", "similarity": 0.904}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "sangria", "target_book": "coloquios_da_orta_1563", "target_name": "sangria", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "sangria", "target_book": "polyanthea_medicinal", "target_name": "sangrias", "similarity": 0.919}, {"source_book": "coloquios_da_orta_1563", "source_name": "sangria", "target_book": "polyanthea_medicinal", "target_name": "sangrias", "similarity": 0.919}], "id": 523, "stable_key": "clu_787232392859187f", "ground_truth": {"modern_name": "Bloodletting", "confidence": "high", "type": "practice", "description": "A medical procedure involving the withdrawal of blood.", "wikipedia_extract": "Bloodletting (or blood-letting) is the deliberate withdrawal of blood from a patient to prevent or cure illness and disease. Bloodletting, whether by a physician or by leeches, was based on an ancient system of medicine in which blood and other bodily fluids were regarded as \"humors\" that had to remain in proper balance to maintain health. It was the most common medical practice performed by surgeons from antiquity until the late 19th century, a span of over 2,000 years. In Europe, the practice continued to be relatively common until the end of the 19th century. The practice has been abandoned by modern-style medicine for all except a few very specific medical conditions. In the beginning of the 19th century, studies had begun to show the harmful effects of bloodletting."}, "cross_references": [{"found_name": "bloodletting", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 43, "target_cluster_name": "bloodletting", "source_book": "llm_generated", "evidence_snippet": "This is a direct Spanish synonym for bloodletting, commonly used in historical medical texts.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: This is a direct Spanish synonym for bloodletting, commonly used in historical medical texts.", "is_reverse": true}, {"found_name": "Astrological medicine", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 569, "target_cluster_name": "astrological medicine", "source_book": "llm_generated", "evidence_snippet": "Bloodletting was a common practice within the framework of astrological medicine, where treatments were often timed and prescribed based on celestial influences.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Bloodletting was a common practice within the framework of astrological medicine, where treatments were often timed and prescribed based on celestial influences."}]}, {"canonical_name": "Hydropeſia", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 2, "total_mentions": 272, "members": [{"entity_id": "hydropí", "book_id": "historia_medicinal_monardes_1574", "name": "hydropí", "category": "DISEASE", "subcategory": "CHRONIC", "count": 1, "variants": ["hydropí"], "contexts": ["dropsy caused by internal obstructions"]}, {"entity_id": "hydropeſia", "book_id": "polyanthea_medicinal", "name": "Hydropeſia", "category": "DISEASE", "subcategory": "CHRONIC", "count": 271, "variants": ["Hydropeſia", "HyDropefia", "Hydro", "Hydroceph.", "Hydrocephalo", "Hydrocephalos", "Hydrocephalus", "Hydrop.", "Hydrop.pector.", "Hydrope", "Hydrope Ascite", "Hydrope Pectoris", "Hydrope Tympanite", "Hydrope-", "Hydropefia", "Hydropefia Afcitica", "Hydropefia Anasarca", "Hydropefia anazarca", "Hydropefia do bofe", "Hydropefia do peyto", "Hydropefia dopéyto", "Hydropefia uterina", "Hydropefiado", "Hydropefiado peito", "Hydropefias", "Hydropele", "Hydropem", "Hydropepectoris", "Hydropepsias", "Hydropepulmon.", "Hydropeques", "Hydropesia", "Hydropeſia Afcitis", "Hydropeſia Anafarca", "Hydropeſia Aſcitica", "Hydropeſia Timpanitis", "Hydropeſia do Peyto", "Hydropeſia he uterina", "Hydropeſiada cabeça", "Hydropeſias", "Hydropeſias Tympaniticas", "Hydropeſias humoraes", "Hydropeſſa", "Hydrophobia", "Hydropi", "Hydropica", "Hydropico", "Hydropicobeber", "Hydropicos", "Hydropis Afcita", "Hydropoft", "Hydrops", "Hydropspectoris", "Hydroptico", "hydrocephalos", "hydrope", "hydropefia", "hydropefia capital", "hydropefiada cabeça", "hydropefias", "hydropem", "hydropeſia", "hydropeſia do peito", "hydropeſias", "hydropeſias do peyto", "hydropica", "hydropico", "hydropicos", "hydrops", "hyrops"], "contexts": ["illness treated by Quintilio's powders", "dropsy, caused by watery humor"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "hydropí", "target_book": "polyanthea_medicinal", "target_name": "Hydropeſia", "similarity": 0.918}, {"source_book": "coloquios_da_orta_1563", "source_name": "hydroforbia", "target_book": "polyanthea_medicinal", "target_name": "Hydropeſia", "similarity": 0.895}], "id": 524, "stable_key": "clu_7c166543e5a30565", "ground_truth": {"modern_name": "Dropsy", "confidence": "high", "type": "disease", "description": "A condition characterized by abnormal accumulation of fluid in body tissues.", "note": "Includes variations like Hydropeſia, Hydropick diseases, Hydropicos, hydropí, hydroforbia, and hidropici.", "wikipedia_extract": "Edema (American English), also spelled oedema (Commonwealth English), and also known as fluid retention, swelling, dropsy and hydropsy, is the build-up of fluid in the body's tissue. Most commonly, the legs or arms are affected. Symptoms may include skin that feels tight, the area feeling heavy, and joint stiffness. Other symptoms depend on the underlying cause. Causes may include venous insufficiency, heart failure, kidney problems, low protein levels, liver problems, deep vein thrombosis, infections, kwashiorkor, angioedema, certain medications, and lymphedema. It may also occur in immobile patients (stroke, spinal cord injury, aging), or with temporary immobility such as prolonged sitting or standing, and during menstruation or pregnancy."}, "member_count": 2, "cross_references": [{"found_name": "vinho de enforcado", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "polyanthea_medicinal", "evidence_snippet": "vinho branco delgado , a que chamão de enforcado ,huma canada,&dentro neſte vinho deytem duas onças decinzade gieſta brava , & deſte vinhocoadodarão ao Hydropico quatro onças todososdias emjejum. Se (", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "a type of thin white wine"}]}, {"canonical_name": "veas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 5, "total_mentions": 280, "members": [{"entity_id": "venas", "book_id": "kosmos_humboldt_1845", "name": "venas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["venas"], "contexts": ["Latin for veins"]}, {"entity_id": "veas", "book_id": "coloquios_da_orta_1563", "name": "veas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["veas"], "contexts": ["veins"]}, {"entity_id": "veas", "book_id": "polyanthea_medicinal", "name": "veas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 259, "variants": ["veas", "Nas veas", "Veas Jugulares", "Venam", "tunica das veas", "vasa", "veade", "veas Caroticas", "veas Jugulares", "veas Lacteas", "veas Leonicas", "veas Meseraicas", "veas Meſeraicas", "veas Moferaicas", "veas Paraſtatas", "veas Pneumonicas", "veas Ureteras", "veas altas", "veas bayxas", "veas capilares", "veas capillares", "veas da teſta", "veas exteriores", "veas grandes", "veas hemorrhoidaes", "veas hemorroidaes", "veas inferiores", "veas interiores", "veas jugulares", "veas lacteas", "veas lumbares", "veas mayores", "veas meleraicas", "veas menores", "veas meſeraicas", "veas pequenas", "veas ureteras", "veas uterinas", "veasEſpermaticas", "veasMeferaicas", "vena", "venam", "vene", "venä", "ves"], "contexts": ["veins", "blood vessels"]}, {"entity_id": "veins", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Veins", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 6, "variants": ["Veins", "veins"], "contexts": ["body parts leeches fasten upon", "convey spirits into brain"]}, {"entity_id": "vein", "book_id": "english_physician_1652", "name": "Vein", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 11, "variants": ["Vein", "Veins"], "contexts": ["blood vessel where bleeding is stopped", "blood vessel"]}, {"entity_id": "vein", "book_id": "polyanthea_medicinal", "name": "vein", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["vein", "veins"], "contexts": ["part of circulatory system", "blood vessels"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "venas", "target_book": "coloquios_da_orta_1563", "target_name": "veas", "similarity": 0.972}, {"source_book": "kosmos_humboldt_1845", "source_name": "venas", "target_book": "polyanthea_medicinal", "target_name": "veas", "similarity": 0.972}, {"source_book": "coloquios_da_orta_1563", "source_name": "veas", "target_book": "polyanthea_medicinal", "target_name": "veas", "similarity": 1.0}], "id": 525, "stable_key": "clu_99a653965c1fb9ab", "ground_truth": {"modern_name": "Veins", "confidence": "high", "type": "anatomy", "description": "Blood vessels that carry blood towards the heart.", "wikipedia_extract": "A vein () is a blood vessel in the circulatory system of humans and most other animals that carries blood towards the heart. Most veins carry deoxygenated blood from the tissues back to the heart; exceptions are those of the pulmonary and fetal circulations which carry oxygenated blood to the heart. In the systemic circulation, arteries carry oxygenated blood away from the heart, and veins return deoxygenated blood to the heart, in the deep veins. There are three sizes of veins: large, medium, and small. Smaller veins are called venules, and the smallest the post-capillary venules are microscopic that make up the veins of the microcirculation. Veins are often closer to the skin than arteries."}, "member_count": 6, "cross_references": [{"found_name": "Blood vessels", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1267, "target_cluster_name": "blood-vessels", "source_book": "llm_generated", "evidence_snippet": "Veins are a type of blood vessel.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Veins are a type of blood vessel."}, {"found_name": "Artery", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1775, "target_cluster_name": "arterias", "source_book": "llm_generated", "evidence_snippet": "Arteries and veins are both major types of blood vessels, often discussed together in anatomical contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Arteries and veins are both major types of blood vessels, often discussed together in anatomical contexts."}, {"found_name": "Capillaries", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3860, "target_cluster_name": "Capillaries", "source_book": "llm_generated", "evidence_snippet": "Capillaries are a type of blood vessel that connect arteries and veins, forming a continuous network within the circulatory system.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Capillaries are a type of blood vessel that connect arteries and veins, forming a continuous network within the circulatory system."}, {"found_name": "coraçao", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1519, "target_cluster_name": "coraçao", "source_book": "llm_generated", "evidence_snippet": "Veins carry blood back to the heart.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Veins carry blood back to the heart.", "is_reverse": true}]}, {"canonical_name": "estomago", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 261, "members": [{"entity_id": "estomago", "book_id": "historia_medicinal_monardes_1574", "name": "estomago", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 10, "variants": ["estomago", "estomagos"], "contexts": ["the stomach, where food is vomited", "organ of digestion"]}, {"entity_id": "estômago", "book_id": "coloquios_da_orta_1563", "name": "estômago", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 17, "variants": ["estômago", "estamago", "estamagô", "estomago", "estomaguo", "estô-mago", "estômag"], "contexts": ["stomach", "body part that amber benefits"]}, {"entity_id": "estomago", "book_id": "polyanthea_medicinal", "name": "estomago", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 234, "variants": ["estomago", "Estomago", "Osofago", "Stomago", "esofago", "esto", "estoma", "estomaco", "estomagos", "estômago", "stoma", "stomago"], "contexts": ["organ that expels contents", "part of the digestive system"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "estomago", "target_book": "coloquios_da_orta_1563", "target_name": "estômago", "similarity": 0.946}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "estomago", "target_book": "polyanthea_medicinal", "target_name": "estomago", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "estômago", "target_book": "polyanthea_medicinal", "target_name": "estomago", "similarity": 0.946}], "id": 526, "stable_key": "clu_f97eb5dc22aad2e8-2", "ground_truth": {"modern_name": "Stomach", "confidence": "high", "type": "anatomical_part", "description": "The organ responsible for digestion and processing food.", "note": "Includes variations in spelling and the mention of its 'tunicas' (linings).", "wikipedia_extract": "The stomach is a muscular, hollow organ in the upper gastrointestinal tract of humans and many other animals, including several invertebrates. The Ancient Greek name for the stomach is gaster which is used as gastric in medical terms related to the stomach. The stomach has a dilated structure and functions as a vital organ in the digestive system. The stomach is involved in the gastric phase of digestion, following the cephalic phase in which the sight and smell of food and the act of chewing are stimuli. In the stomach a chemical breakdown of food takes place by means of secreted  digestive enzymes and gastric acid. It also plays a role in regulating gut microbiota, influencing digestion and overall health."}, "cross_references": [{"found_name": "Nizamaluquo", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "error quando cheguei á índia, e dahi a alguns dias foy ver o Nizamoxa a quem vulgarmente cha- mão Nizamaluquo: querendolhe fazer huma composiçam pêra o estamago lho receitei, e dizendo que Jblium indu", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "vulgar name for Nizamoxa"}]}, {"canonical_name": "Medicos", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 9, "total_mentions": 447, "members": [{"entity_id": "docters", "book_id": "english_physician_1652", "name": "Docters", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 5, "variants": ["Docters", "Doctor", "Doctors"], "contexts": ["medical practitioners", "medical practitioners who commanded an operation"]}, {"entity_id": "medicos", "book_id": "relation_historique_humboldt_vol3_1825", "name": "medicos", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["medicos"], "contexts": ["medical practitioners in Havana"]}, {"entity_id": "medicos", "book_id": "polyanthea_medicinal", "name": "Medicos", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 250, "variants": ["Medicos", "Medi", "Medi.co", "Medic", "Medic.", "Medici", "Medicis", "Medico", "Medicode", "Medicol", "Medicomuyto", "Medicorum", "Medicos Catholicos", "Medicos letrados", "Medicos modernos", "Medicos principiantes", "Medicosgran", "Medicum", "Medicus", "hum Medico", "medico", "medicos",