dt_1845", "name": "volcanoes", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 21, "variants": ["volcanoes", "Volcanoes"], "contexts": ["vents in Earth's crust releasing lava", "mountains that erupt lava"]}, {"entity_id": "volcá", "book_id": "historia_medicinal_monardes_1574", "name": "volcá", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["volcá"], "contexts": ["volcano near Nicaragua sulphur"]}, {"entity_id": "volcanic_eruptions", "book_id": "connexion_physical_sciences_somerville_1858", "name": "volcanic eruptions", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["volcanic eruptions"], "contexts": ["expulsion of molten rock and gases", "recorded geological events"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "volcan", "target_book": "kosmos_humboldt_1845", "target_name": "volcanoes", "similarity": 0.95}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "volcan", "target_book": "historia_medicinal_monardes_1574", "target_name": "volcá", "similarity": 0.946}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "volcan", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "volcanic eruptions", "similarity": 0.89}, {"source_book": "kosmos_humboldt_1845", "source_name": "volcanoes", "target_book": "historia_medicinal_monardes_1574", "target_name": "volcá", "similarity": 0.913}, {"source_book": "kosmos_humboldt_1845", "source_name": "volcanoes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "volcanic eruptions", "similarity": 0.94}], "id": 299, "stable_key": "clu_e54403f6fb6d1b38", "ground_truth": {"modern_name": "volcano", "confidence": "high", "type": "object", "wikidata_id": "Q8072", "wikidata_description": "natural, surface vent or fissure usually in a mountainous form", "wikipedia_url": "https://en.wikipedia.org/wiki/Volcano", "wikipedia_extract": "A volcano is commonly defined as a vent or fissure in the crust of a planetary-mass object, such as Earth, that allows hot lava, volcanic ash, and gases to escape from a magma chamber below the surface. On Earth, volcanoes are most often found where tectonic plates are diverging or converging, and because most of Earth's plate boundaries are underwater, most volcanoes are found underwater. For example, a mid-ocean ridge, such as the Mid-Atlantic Ridge, has volcanoes caused by divergent tectonic plates whereas the Pacific Ring of Fire has volcanoes caused by convergent tectonic plates. Volcanoes resulting from divergent tectonic activity are usually non-explosive whereas those resulting from convergent tectonic activity cause violent eruptions. Volcanoes can also form where there is stretching and thinning of the crust's plates, such as in the East African Rift, the Wells Gray-Clearwater volcanic field, and the Rio Grande rift in North America. Volcanism away from plate boundaries most likely arises from upwelling diapirs from the core–mantle boundary called mantle plumes, 3,000 kilometres (1,900 mi) deep within Earth."}, "cross_references": [{"found_name": "Salses", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1819, "target_cluster_name": "salses", "source_book": "llm_generated", "evidence_snippet": "Salses are mud volcanoes, a type of volcanic feature.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Salses are mud volcanoes, a type of volcanic feature."}, {"found_name": "mud volcanoes", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "kosmos_humboldt_1845", "evidence_snippet": "wells, mud volcanoes and lava currents from craters of eruption and even in producing alterations in the level of the sea.* [footnote] * [See Daubeney 'On Volcanoes', 2d edit., 3848, p. 539, etc., on ", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of"}]}, {"canonical_name": "Syncope", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 4, "total_mentions": 27, "members": [{"entity_id": "syncope", "book_id": "principles_of_psychology_james_1890", "name": "syncope", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 4, "variants": ["syncope"], "contexts": ["temporary loss of consciousness", "sudden temporary loss of consciousness"]}, {"entity_id": "syncopes", "book_id": "coloquios_da_orta_1563", "name": "syncopes", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["syncopes"], "contexts": ["fainting spells"]}, {"entity_id": "syncope", "book_id": "polyanthea_medicinal", "name": "Syncope", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 21, "variants": ["Syncope", "Sincopaes", "Sincopal", "Sincopes", "Syncopem", "Syncopes", "sincopes", "sincopizantes", "syncope", "syncoptico", "síncopes"], "contexts": ["fainting", "fainting spell"]}, {"entity_id": "syncope", "book_id": "first_principles_spencer_1862", "name": "syncope", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["syncope"], "contexts": ["temporary loss of consciousness"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "syncope", "target_book": "coloquios_da_orta_1563", "target_name": "syncopes", "similarity": 0.961}, {"source_book": "principles_of_psychology_james_1890", "source_name": "syncope", "target_book": "polyanthea_medicinal", "target_name": "Syncope", "similarity": 0.967}, {"source_book": "principles_of_psychology_james_1890", "source_name": "syncope", "target_book": "first_principles_spencer_1862", "target_name": "syncope", "similarity": 0.833}, {"source_book": "coloquios_da_orta_1563", "source_name": "syncopes", "target_book": "polyanthea_medicinal", "target_name": "Syncope", "similarity": 0.945}, {"source_book": "polyanthea_medicinal", "source_name": "Syncope", "target_book": "first_pr