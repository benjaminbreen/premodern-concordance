: 0.953}, {"source_book": "origin_of_species_darwin_1859", "source_name": "West Indies", "target_book": "kosmos_humboldt_1845", "target_name": "West Indies", "similarity": 0.86}, {"source_book": "origin_of_species_darwin_1859", "source_name": "West Indies", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "West Indies", "similarity": 0.86}, {"source_book": "kosmos_humboldt_1845", "source_name": "West Indies", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "West Indies", "similarity": 1.0}], "id": 497, "stable_key": "clu_db5d78141d63ad6e", "ground_truth": {"modern_name": "East Indies", "confidence": "high", "type": "place", "country": "Indonesia, India, Southeast Asia", "note": "Includes 'West Indies' which is a different geographical region, but likely a contextual error in the source text rather than a separate referent for this cluster.", "wikidata_id": "Q213137", "wikidata_description": "region encompassing South (Em(Indian subcontinent) and Southeast Asia", "wikipedia_url": "https://en.wikipedia.org/wiki/East%20Indies", "wikipedia_extract": "The East Indies (or simply the Indies) is a term used in historical narratives of the Age of Discovery. The Indies broadly referred to various lands in the East or the Eastern Hemisphere, particularly the islands and mainlands found in and around the Indian Ocean by Portuguese explorers, soon after the Cape Route was discovered. In a narrow sense, the term was used to refer to the Malay Archipelago, which today comprises the Philippine Archipelago, Indonesian Archipelago, Borneo, and New Guinea. Historically, the term was used in the Age of Discovery to refer to the coasts of the landmasses comprising the Indian subcontinent and the Indochinese Peninsula along with the Malay Archipelago. During the era of European colonization, territories of the Spanish Empire in Asia were known as the Spanish East Indies for 333 years before the American conquest and later the independence of the Philippines. Dutch occupied colonies in the area were known for about 300 years as the Dutch East Indies until Indonesian independence."}, "cross_references": [{"found_name": "India", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 17, "target_cluster_name": "India", "source_book": "llm_generated", "evidence_snippet": "Historically, the term 'East Indies' often encompassed regions of South and Southeast Asia, including parts of India.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Historically, the term 'East Indies' often encompassed regions of South and Southeast Asia, including parts of India.", "is_reverse": true}, {"found_name": "Malabar", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 216, "target_cluster_name": "Malabar", "source_book": "llm_generated", "evidence_snippet": "The Malabar Coast is a significant part of the historical region known as the East Indies.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Malabar Coast is a significant part of the historical region known as the East Indies.", "is_reverse": true}, {"found_name": "Java", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 78, "target_cluster_name": "Java", "source_book": "llm_generated", "evidence_snippet": "Java is a major island within the historical and geographical region known as the East Indies.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Java is a major island within the historical and geographical region known as the East Indies.", "is_reverse": true}, {"found_name": "Persia", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 168, "target_cluster_name": "Persia", "source_book": "llm_generated", "evidence_snippet": "While geographically distinct, the East Indies were a region of significant trade and interaction with Persia during the premodern period.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: While geographically distinct, the East Indies were a region of significant trade and interaction with Persia during the premodern period.", "is_reverse": true}, {"found_name": "Arabia", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 169, "target_cluster_name": "Arabia", "source_book": "llm_generated", "evidence_snippet": "Arabia was a significant point on trade routes connecting Europe to the East Indies.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Arabia was a significant point on trade routes connecting Europe to the East Indies.", "is_reverse": true}, {"found_name": "Borneo", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 184, "target_cluster_name": "Borneo", "source_book": "llm_generated", "evidence_snippet": "Borneo is a major island within the East Indies archipelago.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Borneo is a major island within the East Indies archipelago.", "is_reverse": true}, {"found_name": "Egypto", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 232, "target_cluster_name": "Egypto", "source_book": "llm_generated", "evidence_snippet": "While geographically distinct, both Egypt and the East Indies were significant regions in historical trade routes and European colonial interests.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: While geographically distinct, both Egypt and the East Indies were significant regions in historical trade routes and European colonial interests.", "is_reverse": true}, {"found_name": "Sumatra", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 330, "target_cluster_name": "Sumatra", "source_book": "llm_generated", "evidence_snippet": "Sumbawa is an island located in the East Indies.", "confidence"