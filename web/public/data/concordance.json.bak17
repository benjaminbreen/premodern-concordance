h": {"modern_name": "Samuel", "confidence": "medium", "type": "person", "description": "Biblical prophet and figure", "note": "Refers to the biblical figure Samuel, but the 'feather merchant' context is unclear.", "wikidata_id": "", "wikidata_description": "family name"}, "cross_references": []}, {"canonical_name": "Demosthenes", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "demosthenes", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Demosthenes", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Demosthenes"], "contexts": ["Greek orator"]}, {"entity_id": "demóstenes", "book_id": "historia_medicinal_monardes_1574", "name": "Demóstenes", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Demóstenes"], "contexts": ["drank poison to avoid cruel death"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Demosthenes", "target_book": "historia_medicinal_monardes_1574", "target_name": "Demóstenes", "similarity": 0.898}], "id": 3813, "stable_key": "clu_198ded555af9be05", "ground_truth": {"modern_name": "Demosthenes", "confidence": "high", "type": "person", "birth_year": -384, "death_year": -322, "description": "Ancient Greek orator, known for his speeches and death by poison.", "wikidata_id": "Q798024", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Demosthenesia", "wikipedia_extract": "Demosthenesia is a genus of flowering plants belonging to the family Ericaceae. Its native range is Peru to Bolivia and Brazil. The genus name of Demosthenesia is in honour of Demosthenes (384–322 BC), a Greek politician. Demosthenesia amicorum (Sleumer) Sleumer Demosthenesia buxifolia (Fielding & Gardner) A.C.Sm. Demosthenesia fabulosa (Sleumer) A.C.Sm. Demosthenesia mandonii (Britton) A.C.Sm."}, "cross_references": []}, {"canonical_name": "natural Magician", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "natural_magician", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "natural Magician", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["natural Magician"], "contexts": ["practitioner of natural magic"]}, {"entity_id": "magia_natural", "book_id": "polyanthea_medicinal", "name": "Magia natural", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Magia natural"], "contexts": ["natural magic"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "natural Magician", "target_book": "polyanthea_medicinal", "target_name": "Magia natural", "similarity": 0.885}], "id": 3814, "stable_key": "clu_18f9cf9fe564cb9e", "ground_truth": {"modern_name": "Natural magic", "confidence": "high", "type": "concept", "wikidata_id": "Q6980728", "wikidata_description": "Occult practices directly using the natural world instead of spirits"}, "cross_references": []}, {"canonical_name": "Dioclesian", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "dioclesian", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Dioclesian", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Dioclesian"], "contexts": ["Roman Emperor"]}, {"entity_id": "dioclesian", "book_id": "english_physician_1652", "name": "Dioclesian", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Dioclesian"], "contexts": ["Roman Emperor"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Dioclesian", "target_book": "english_physician_1652", "target_name": "Dioclesian", "similarity": 0.708}], "id": 3815, "stable_key": "clu_75eddcf47d834ad6", "ground_truth": {"modern_name": "Diocletian", "confidence": "high", "type": "person", "birth_year": 244, "death_year": 311, "description": "Roman Emperor, known for his reforms and persecution of Christians.", "wikidata_id": "Q43107", "wikidata_description": "Augustus of the Eastern Roman Empire (244-311)"}, "cross_references": []}, {"canonical_name": "Caius", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "caius", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Caius", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Caius"], "contexts": ["blind man cured by divine intervention"]}, {"entity_id": "caſaris", "book_id": "polyanthea_medicinal", "name": "Caſaris", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Caſaris"], "contexts": ["person with heart condition"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Caius", "target_book": "polyanthea_medicinal", "target_name": "Caſaris", "similarity": 0.868}], "id": 3816, "stable_key": "clu_46ae3e59a304c4f4", "ground_truth": {"modern_name": "Gaius", "confidence": "low", "type": "person", "description": "Latin jurist and physician, potentially confused with Caius of Rome.", "note": "The name 'Caius' is common. In a medical context, it might refer to the Roman jurist Gaius, but without further context, it's ambiguous. 'Caſaris' could be a misspelling or a different name.", "wikidata_id": "Q53628544", "wikidata_description": "genus of mygalomorph spiders"}, "cross_references": []}, {"canonical_name": "Jordan", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "jordan", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Jordan", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Jordan"], "contexts": ["river for cleansing"]}, {"entity_id": "jordan", "book_id": "kosmos_humboldt_1845", "name": "Jordan", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Jordan"], "contexts": ["river in the Middle East"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Jordan", "target_book": "kosmos_humboldt_1845", "target_name": "Jordan", "similarity": 1.0}], "id": 3817, "stable_key": "clu_238e8a3365203559", "ground_truth": {"modern_name": "Jordan River", "confidence": "high", "type": "place", "country": "Israel, Palestine, Jordan", "note": "The contexts clearly point to the biblical and geographical Jordan River. The mention of 'river mouth between Savannah and Charlestown' might be a misidentification or a metaphorical use of the name, but the dominant referent is the Middle Eastern river.", "wikidata_id": "Q22487538", "wikidata_description": "river in Capital Regional District, British Columbia, Canada", "wikipedia_extract": "The Jordan River or River Jordan (Arabic: نَهْر الْأُرْدُنّ, Nahr al-ʾUrdunn; Hebrew: נְהַר הַיַּרְדֵּן, Nəhar hayYardēn), also known as Nahr Al-Sharieat (Arabic: نهر الشريعة), is a 251-kilometre-long (156 mi) endorheic river in the Levant that flows roughly north to south through the Sea of Galilee and drains to the Dead Sea. The river passes by or through Jordan, Syria, Israel, and Palestine. Jordan and the Israeli-occupied Golan Heights border the river to the east, while Israel and the Israeli-occupied West Bank lie to its west. Both Jordan and the West Bank derive their names in relation to the river. The river holds major significance in Judaism and Christianity. According to the Bible, the Israelites crossed it into the Promised Land and Jesus of Nazareth was baptized by John the Baptist in it."}, "cross_references": []}, {"canonical_name": "Colocynthis", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "colocynthis", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Colocynthis", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Colocynthis"], "contexts": ["plant for decoction"]}, {"entity_id": "colocynthis", "book_id": "english_physician_1652", "name": "Colocynthis", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Colocynthis"], "contexts": ["herb used in learned receipts"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Colocynthis", "target_book": "english_physician_1652", "target_name": "Colocynthis", "similarity": 1.0}], "id": 3818, "stable_key": "clu_e152a87d07fe476c-2", "ground_truth": {"modern_name": "Colocynth", "confidence": "high", "type": "plant", "linnaean": "Citrullus colocynthis", "family": "Cucurbitaceae", "description": "A bitter gourd plant used as an ingredient in medicinal preparations.", "note": "Includes singular and plural forms in Italian and English.", "wikipedia_extract": "Citrullus colocynthis, with many common names including colocynth, bitter apple, bitter cucumber, vine of Sodom, or wild gourd, is a poisonous desert viny plant native to the Mediterranean Basin and West Asia, especially the Levant, Turkey (especially in regions such as İzmir), and Nubia. It resembles a common watermelon vine but bears small, hard fruits with a bitter pulp. The plant contains cytotoxic cucurbitacins and is thus unsafe to use as an herbal medicine. It originally bore the scientific name Colocynthis citrullus. The vine ranges from 2.4–3 metres (8–10 feet) in length. The roots are large, fleshy, and perennial, leading to a high survival rate due to the long tap root."}, "cross_references": [{"found_name": "Coloquintida", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1831, "target_cluster_name": "Coloquintida", "source_book": "llm_generated", "evidence_snippet": "Coloquintida is listed as a historical name for Colocynth.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "Coloquintida is listed as a historical name for Colocynth."}, {"found_name": "Bryony", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 940, "target_cluster_name": "Brionia", "source_book": "llm_generated", "evidence_snippet": "Both Colocynth and Bryony are types of gourds or cucurbits, often with medicinal or toxic properties, and are sometimes confused or grouped together in historical texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both Colocynth and Bryony are types of gourds or cucurbits, often with medicinal or toxic properties, and are sometimes confused or grouped together in historical texts."}, {"found_name": "Melon", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2227, "target_cluster_name": "melões", "source_book": "llm_generated", "evidence_snippet": "Colocynth is a species within the Cucurbitaceae family, which also includes melons. They share a botanical relationship.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Colocynth is a species within the Cucurbitaceae family, which also includes melons. They share a botanical relationship."}, {"found_name": "Watermelon", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1963, "target_cluster_name": "melancia", "source_book": "llm_generated", "evidence_snippet": "Colocynth (Citrullus colocynthis) is closely related botanically to the watermelon (Citrullus lanatus), both belonging to the same genus.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Colocynth (Citrullus colocynthis) is closely related botanically to the watermelon (Citrullus lanatus), both belonging to the same genus."}]}, {"canonical_name": "light", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "light", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "light", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["light"], "contexts": ["positive quality, from good principle"]}, {"entity_id": "lumine", "book_id": "polyanthea_medicinal", "name": "lumine", "categ