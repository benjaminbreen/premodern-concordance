nerated", "evidence_snippet": "Faith, particularly in a religious context, is frequently understood as an attribute or faculty of the soul, representing a connection to the divine or a conviction beyond empirical proof.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Faith, particularly in a religious context, is frequently understood as an attribute or faculty of the soul, representing a connection to the divine or a conviction beyond empirical proof."}, {"found_name": "Emotion and Will", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3531, "target_cluster_name": "Emotion and Will", "source_book": "llm_generated", "evidence_snippet": "Historical discussions of the soul often include its role as the seat of emotions and the source of volition or will, making these closely related concepts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Historical discussions of the soul often include its role as the seat of emotions and the source of volition or will, making these closely related concepts."}, {"found_name": "Divinity", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2345, "target_cluster_name": "Divinity", "source_book": "llm_generated", "evidence_snippet": "The soul was often considered the part of a human being that could connect with or reflect the divine, making 'Divinity' a related concept in theological and philosophical contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The soul was often considered the part of a human being that could connect with or reflect the divine, making 'Divinity' a related concept in theological and philosophical contexts."}, {"found_name": "Eternity", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3298, "target_cluster_name": "Eternity", "source_book": "llm_generated", "evidence_snippet": "The concept of the soul's immortality or its existence beyond temporal bounds directly links it to the notion of 'Eternity'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The concept of the soul's immortality or its existence beyond temporal bounds directly links it to the notion of 'Eternity'."}, {"found_name": "Evil", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3793, "target_cluster_name": "evil", "source_book": "llm_generated", "evidence_snippet": "The soul was often seen as the battleground between good and evil, or as capable of succumbing to or resisting evil influences, making 'Evil' a conceptually related entity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The soul was often seen as the battleground between good and evil, or as capable of succumbing to or resisting evil influences, making 'Evil' a conceptually related entity."}, {"found_name": "Free will", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3567, "target_cluster_name": "free-will", "source_book": "llm_generated", "evidence_snippet": "The capacity for free will was frequently attributed to the soul, making it a core concept in discussions about human agency and moral responsibility, and thus related to the soul.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The capacity for free will was frequently attributed to the soul, making it a core concept in discussions about human agency and moral responsibility, and thus related to the soul."}, {"found_name": "vertue", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2161, "target_cluster_name": "vertue", "source_book": "llm_generated", "evidence_snippet": "Virtue is frequently discussed in relation to the state and cultivation of the soul, seen as the seat of moral character and action.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Virtue is frequently discussed in relation to the state and cultivation of the soul, seen as the seat of moral character and action.", "is_reverse": true}, {"found_name": "pure Ego", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "principles_of_psychology_james_1890", "evidence_snippet": "so-called self-love is but a name for his insensibility to all but this one set of things. It may be that he needs a pure principle of subjectivity, a soul or pure Ego (he certainly needs a stream of ", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "a synonym for subjectivity"}]}, {"canonical_name": "lepra", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 3, "total_mentions": 60, "members": [{"entity_id": "lepra", "book_id": "historia_medicinal_monardes_1574", "name": "Lepra", "category": "DISEASE", "subcategory": "CHRONIC", "count": 2, "variants": ["Lepra"], "contexts": ["disease name, possibly referring to leprosy", "skin disease"]}, {"entity_id": "lepra", "book_id": "coloquios_da_orta_1563", "name": "lepra", "category": "DISEASE", "subcategory": "CHRONIC", "count": 5, "variants": ["lepra"], "contexts": ["disease caused by milk and fish", "leprosy, treated with the stone"]}, {"entity_id": "lepra", "book_id": "polyanthea_medicinal", "name": "lepra", "category": "DISEASE", "subcategory": "CHRONIC", "count": 53, "variants": ["lepra", "Lepra", "lepra Græcorum", "lepra branca", "lepram", "lepras", "lepras rebeldes", "leprous"], "contexts": ["skin disease", "leprosy"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Lepra", "target_book": "coloquios_da_orta_1563", "target_name": "lepra", "similarity": 0.99}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Lepra", "target_book": "polyanthea_medicinal", "target_name": "lepra", "similarity": 0.99}, {"source_book": "coloquios_da_orta_1563", "source_name": "lepra", "target_book": "polyanthea_medicinal", "target_name": "lepra", "similarity": 1.0}], "id": 579, "stable_key": "clu_a5b72a6abc431417", "ground_truth": {"modern_name": "Leprosy", "confidence": "high", "type": "disease", "description": "A chronic infectious disease affecting skin and nerves.", "note": "Covers historical understanding and terminology for leprosy.", "wikipedia_extract": "Leprosy, also known as Hansen's disease (HD), is a long-term infection by the bacteria Mycobacterium leprae or Mycobacterium lepromatosis. Infection can lead to damage of the nerves, respiratory tract, skin, and eyes. This nerve damage may result in the loss of nociception, which can lead to the loss of parts of a person's extremities from repeated injuries or infection through unnoticed wounds. An infected person may also experience muscle weakness and loss of eyesight. Leprosy symptoms may begin within one year or take 20 years or more. Leprosy is spread between people, although extensive contact is necessary."}, "cross_references": [{"found_name": "sarna", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 610, "target_cluster_name": "Itch", "source_book": "historia_medicinal_monardes_1574", "evidence_snippet": "las coſas que del reſultan, Arm grandeobra,que ſea vniuerſal,o que ſea particu delcuera lar:enlacabeca,olo que llaman Mirarchia:y aſsi po. enlosquetienz Lepra,delos Arabes, o Elepan cialis de los Grie", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for itching/infection of the skin, related to Lepra"}, {"found_name": "leprolos", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 1291, "target_cluster_name": "leprolos", "source_book": "llm_generated", "evidence_snippet": "Leprosy is the English translation of the historical term 'lepra'.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "reverse: Leprosy is the English translation of the historical term 'lepra'.", "is_reverse": true}, {"found_name": "peynes", "link_type": "conceptual_overlap", "link_s