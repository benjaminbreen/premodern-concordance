torique_humboldt_vol3_1825", "source_name": "Orinoco", "target_book": "kosmos_humboldt_1845", "target_name": "Orinoco", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Orinoco", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Orinoco", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Orinoco", "target_book": "first_principles_spencer_1862", "target_name": "Orinoco", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Alto Orinoco", "target_book": "kosmos_humboldt_1845", "target_name": "Orinoco", "similarity": 0.919}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Alto Orinoco", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Orinoco", "similarity": 0.919}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Alto Orinoco", "target_book": "first_principles_spencer_1862", "target_name": "Orinoco", "similarity": 0.919}, {"source_book": "kosmos_humboldt_1845", "source_name": "Orinoco", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Orinoco", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Orinoco", "target_book": "first_principles_spencer_1862", "target_name": "Orinoco", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Orinoco", "target_book": "first_principles_spencer_1862", "target_name": "Orinoco", "similarity": 1.0}], "id": 322, "stable_key": "clu_899b6531614420cd", "ground_truth": {"modern_name": "Orinoco River", "confidence": "high", "type": "place", "country": "Venezuela, Colombia", "wikidata_id": "Q131792", "wikidata_description": "river in South America", "wikipedia_url": "https://en.wikipedia.org/wiki/Orinoco", "wikipedia_extract": "The Orinoco (Spanish pronunciation: [oɾiˈnoko]) is one of the longest rivers in South America at 2,140 km (1,330 mi). Its drainage basin, sometimes known as the Orinoquia, covers approximately 1,000,000 km2 (390,000 sq mi), with 65% of it in Venezuela and 35% in Colombia. It is the fourth largest river in the world by discharge volume of water (39,000 m3/s (1,400,000 cu ft/s) at delta) due to the high precipitation throughout its catchment area (2,300 millimetres per are [0.084 in/sq ft]). The Orinoco River and its tributaries are the major transportation system for eastern and interior Venezuela and the Llanos of Colombia. The environment and wildlife in the Orinoco's basin are extremely diverse. The river's name is derived from the Warao term for \"a place to paddle\", derived from the terms güiri (paddle) and noko (place) i.e."}, "cross_references": [{"found_name": "Caracas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1497, "target_cluster_name": "Caracas", "source_book": "llm_generated", "evidence_snippet": "Caracas is the capital of Venezuela, the country where a significant portion of the Orinoco River's drainage basin is located. Historical texts often discuss rivers in relation to the major cities and political entities within their regions.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Caracas is the capital of Venezuela, the country where a significant portion of the Orinoco River's drainage basin is located. Historical texts often discuss rivers in relation to the major cities and political entities within their regions."}, {"found_name": "Amazone", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1520, "target_cluster_name": "Amazone", "source_book": "llm_generated", "evidence_snippet": "The Amazon and Orinoco river systems are connected by the Cassiquiare Canal.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Amazon and Orinoco river systems are connected by the Cassiquiare Canal.", "is_reverse": true}, {"found_name": "Cassiopeia", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2438, "target_cluster_name": "Cassiopeia", "source_book": "llm_generated", "evidence_snippet": "The Cassiquiare River is a natural distributary of the upper Orinoco.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Cassiquiare River is a natural distributary of the upper Orinoco.", "is_reverse": true}]}, {"canonical_name": "quartz", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 5, "total_mentions": 40, "members": [{"entity_id": "quarz_cristallin", "book_id": "relation_historique_humboldt_vol3_1825", "name": "quarz cristallin", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["quarz cristallin"], "contexts": ["Crystalline quartz mineral"]}, {"entity_id": "quartz", "book_id": "kosmos_humboldt_1845", "name": "quartz", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 9, "variants": ["quartz"], "contexts": ["heterogeneous substance in pendulum experiments", "round blocks"]}, {"entity_id": "quartz", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Quartz", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 7, "variants": ["Quartz", "quartz"], "contexts": ["positive crystal with one optic axis", "crystal with optical properties"]}, {"entity_id": "quartz", "book_id": "first_principles_spencer_1862", "name": "quartz", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["quartz"], "contexts": ["hard crystalline mineral", "mineral component of granite"]}, {"entity_id": "quarz", "book_id": "relation_historique_humboldt_vol3_1825", "name": "quarz", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 15, "variants": ["quarz"], "contexts": ["grains suspended in the atmosphere", "mineral found in veins"]}, {"entity_id": "quartzose", "book_id": "kosmos_humboldt_1845", "name": "quartzose", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["quartzose"], "contexts": ["type of rock"]}, {"entity_id": "quarz_hyalin", "book_id": "relation_historique_humboldt_vol3_1825", "name": "quarz hyalin", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["quarz hyalin"], "contexts": ["clear quartz"]}, {"entity_id": "quartzo_hyalíno", "book_id": "coloquios_da_orta_1563", "name": "quartzo hyalíno", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["quartzo hyalíno", "quartzo", "quartzo twerdeaio"], "contexts": ["another name for clear crystal", "greenish quartz sometimes called berylo"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "quarz cristallin", "target_book": "kosmos_humboldt_1845", "target_name": "quartz", "similarity": 0.92}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "quarz cristallin", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Quartz", "similarity": 0.9}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "quarz cristallin", "target_book": "first_principles_spencer_1862", "target_name": "quartz", "similarity": 0.92}, {"source_book": "kosmos_humboldt_1845", "source_name": "quartz", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Quartz", "similarity": 0.978}, {"source_book": "kosmos_humboldt_1845", "source_name": "quartz", "target_book": "first_principles_spencer_1862", "target_name": "quartz", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Quartz", "target_book": "first_principles_spencer_1862", "target_name": "quartz", "similarity": 0.978}], "id": 323, "stable_key": "clu_902705e6291a58ee", "ground_truth": {"modern_name": "Quartz", "confidence": "high", "type": "mineral", "wikidata_id": "Q43010", "wikidata_description": "mineral made of silicon and oxygen", "wikipedia_url": "https://en.wikipedia.org/wiki/Quartz", "note": "The term 'quarz' is a variant spelling. 'quartzose' refers to material composed of quartz.", "wikipedia_extract": "Quartz is a hard mineral composed of silica (silicon dioxide). Its atoms are linked in a continuous framework of SiO4 silicon–oxygen tetrahedra, with each oxygen atom being shared between two tetrahedra, giving an overall chemical formula of SiO2. Therefore, quartz is classified structurally as a framework silicate mineral and compositionally as an oxide mineral. Quartz is the second most common mineral or mineral group in Earth's lithosphere, comprising about 12% by mass. Quartz exists in two forms, the normal α-quartz and the high-temperature β-quartz, both of which are chiral. The transformation from α-quartz to β-quartz takes place abruptly at 573 °C (846 K; 1,063 °F)."}, "member_count": 8, "cross_references": [{"found_name": "Amethyst", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2673, "target_cluster_name": "Amethyst", "source_book": "llm_generated", "evidence_snippet": "Amethyst is a purple variety of quartz, a specific type of quartz.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Amethyst is a purple variety of quartz, a specific type of quartz."}, {"found_name": "Crystal", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 696, "target_cluster_name": "Crystal", "source_book": "llm_generated", "evidence_snippet": "Quartz is a crystalline mineral, and crystals are a common form in which quartz is found.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Quartz is a crystalline mineral, and crystals are a common form in which quartz is found."}, {"found_name": "Gems", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1119, "target_cluster_name": "gemms", "source_book": "llm_generated", "evidence_snippet": "Quartz, in its various forms like amethyst and citrine, is often used as a gemstone.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Quartz, in its various forms like amethyst and citrine, is often used as a gemstone."}, {"found_name": "Iceland spar", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1763, "target_cluster_name": "Iceland spar", "source_book": "llm_generated", "evidence_snippet": "Iceland spar is a transparent variety of calcite, which is chemically similar to quartz (calcium carbonate vs. silicon dioxide) and often discussed alongside other minerals in geological and mineralogical texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Iceland spar is a transparent variety of calcite, which is chemically similar to quartz (calcium carbonate vs. silicon dioxide) and often discussed alongside other minerals in geological and mineralogical texts."}, {"found_name": "Jasper", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 379, "target_cluster_name": "jaspe", "source_book": "llm_generated", "evidence_snippet": "Jasper is an opaque, microcrystalline variety of quartz, making it a specific type of quartz.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Jasper is an opaque, microcrystalline variety of quartz, making it a specific type of quartz."}, {"found_name": "Flint", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2907, "target_cluster_name": "Flint", "source_book": "llm_generated", "evidence_snippet": "Flint is a microcrystalline or cryptocrystalline sedimentary rock form of quartz, often found in nodules within chalk or limestone.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Flint is a microcrystalline or cryptocrystalline sedimentary rock form of quartz, often found in nodules within chalk or limestone."}, {"found_name": "sapphira", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2168, "target_cluster_name": "sapphira", "source_book": "llm_generated", "evidence_snippet": "Sapphire is a variety of the mineral corundum, which is a form of aluminum oxide. Quartz is another common mineral, and both are often discussed in mineralogical contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Sapphire is a variety of the mineral corundum, which is a form of aluminum oxide. Quartz is another common mineral, and both are often discussed in mineralogical contexts.", "is_reverse": true}, {"found_name": "Flints", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3245, "target_cluster_name": "Flints", "source_book": "llm_generated", "evidence_snippet": "Flint is a microcrystalline or cryptocrystalline variety of quartz.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Flint is a microcrystalline or cryptocrystalline variety of quartz.", "is_reverse": true}]}, {"canonical_name": "jar", "category": "OBJECT", "subcategory": "VESSEL", "book_count": 4, "total_mentions": 20, "members": [{"entity_id": "vase", "book_id": "relation_historique_humboldt_vol3_1825", "name": "vase", "category": "OBJECT", "subcategory": "VESSEL", "count": 1, "variants": ["vase"], "contexts": ["container for collecting water"]}, {"entity_id": "jar", "book_id": "principles_of_psychology_james_1890", "name": "jar", "category": "OBJECT", "subcategory": "VESSEL", "count": 1, "variants": ["jar"], "contexts": ["container with a wide mouth"]}, {"entity_id": "jar", "book_id": "ricettario_fiorentino_1597", "name": "Jar", "category": "OBJECT", "subcategory": "VESSEL", "count": 1, "variants": ["Jar"], "contexts": ["container"]}, {"entity_id": "jar", "book_id": "polyanthea_medicinal", "name": "jar", "category": "OBJECT", "subcategory": "VESSEL", "count": 17, "variants": ["jar", "Jar"], "contexts": ["a container for substances", "container for substances"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "vase", "target_book": "principles_of_psychology_james_1890", "target_name": "jar", "similarity": 0.888}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "vase", "target_book": "polyanthea_medicinal", "target_name": "jar", "similarity": 0.888}, {"source_book": "principles_of_psychology_james_1890", "source_name": "jar", "target_book": "ricettario_fiorentino_1597", "target_name": "Jar", "similarity": 0.976}, {"source_book": "principles_of_psychology_james_1890", "source_name": "jar", "target_book": "polyanthea_medicinal", "target_name": "jar", "similarity": 1.0}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Jar", "target_book": "polyanthea_medicinal", "target_name": "jar", "similarity": 0.976}], "id": 324, "stable_key": "clu_b81c27d2f29e7f99", "ground_truth": {"modern_name": "Jar", "confidence": "high", "type": "object", "note": "'Urna boccia' and 'urnas' both refer to containers. 'Urna' implies an urn or jar, and 'boccia' can mean bottle or pot. The context 'container for preparations | containers for ashes' reinforces this, suggesting vessels used for storing or preparing substances.", "wikidata_id": "Q999961", "wikidata_description": "town in Náchod District, Hradec Králové Region, Czech Republic", "wikipedia_url": "https://en.wikipedia.org/wiki/Jarom%C4%9B%C5%99", "wikipedia_extract": "Jaroměř (Czech pronunciation: [ˈjaromɲɛr̝̊]; German: Jermer) is a town in Náchod District in the Hradec Králové Region of the Czech Republic. It has about 12,000 inhabitants. It is known for the Josefov Fortress. Josefov is well preserved and is protected as an urban monument reservation, the historic town centre of Jaroměř is procected as an urban monument zone. Jaroměř consists of nine municipal parts (in brackets population according to the 2021 census): Jaroměř is located about 18 kilometres (11 mi) west of Náchod and 16 km (10 mi) northeast of Hradec Králové. It lies mostly in a flat agricultural landscape of the East Elbe Table."}, "cross_references": [{"found_name": "flask", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 125, "target_cluster_name": "flask", "source_book": "llm_generated", "evidence_snippet": "Jars are similar containers to flasks, often used for storage and transport of liquids or solids.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Jars are similar containers to flasks, often used for storage and transport of liquids or solids.", "is_reverse": true}]}, {"canonical_name": "Bouguer", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 19, "members": [{"entity_id": "bouguer", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bouguer", "category": "PERSON", "subcategory": "SCHOLAR", "count": 11, "variants": ["Bouguer", "Bougner"], "contexts": ["geodesist and astronomer", "academician who observed atmospheric tides"]}, {"entity_id": "boulin", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Boulin", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Boulin"], "contexts": ["traveler and author"]}, {"entity_id": "bouguer", "book_id": "kosmos_humboldt_1845", "name": "Bouguer", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Bouguer"], "contexts": ["erected monument at equator", "returned to Europe in June 1744"]}, {"entity_id": "bonguer", "book_id": "kosmos_humboldt_1845", "name": "Bonguer", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Bonguer"], "contexts": ["had slight difference with La Condamine"]}, {"entity_id": "bouguer", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Bouguer", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Bouguer"], "contexts": ["observer of gravitational anomaly", "measured degrees of the meridian"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Boulin", "target_book": "kosmos_humboldt_1845", "target_name": "Bouguer", "similarity": 0.887}, {"source_book": "kosmos_humboldt_1845", "source_name": "Bonguer", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bouguer", "similarity": 0.866}], "id": 325, "stable_key": "clu_a054812e8cb73efd", "ground_truth": {"modern_name": "Pierre Bouguer", "confidence": "high", "type": "person", "birth_year": 1698, "death_year": 1758, "description": "French geodesist, astronomer, and cartographer.", "note": "Variant spellings like 'Budeu' and 'Boulin' likely refer to him given the context of exploration and scientific works.", "wikidata_id": "Q11065", "wikidata_description": "French astronomer and mathematician (1698-1758)", "wikipedia_url": "https://en.wikipedia.org/wiki/Pierre%20Bouguer", "wikipedia_extract": "Pierre Bouguer (French: [buˈge]) (16 February 1698, Le Croisic, Province of Brittany – 15 August 1758, Paris) was a French mathematician, geophysicist, geodesist, and astronomer. He is also known as \"the father of naval architecture\". Bouguer's father, Jean Bouguer, one of the best hydrographers of his time, was Regius Professor of hydrography at Le Croisic in lower Brittany, and author of a treatise on navigation. He taught his sons Pierre and Jan at their home, where he also taught private students. In 1714, at the age of 16, Pierre was appointed to succeed his deceased father as professor of hydrography. In 1727 he gained the prize given by the French Academy of Sciences for his paper On the masting of ships, beating Leonhard Euler; and two other prizes, one for his dissertation On the best method of observing the altitude of stars at sea, the other for his paper On the best method of observing the variation of the compass at sea."}, "cross_references": [{"found_name": "Charles Marie de La Condamine", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1741, "target_cluster_name": "La Condamine", "source_book": "llm_generated", "evidence_snippet": "Both were French scientists involved in the measurement of the Earth and expeditions in South America during the 18th century.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were French scientists involved in the measurement of the Earth and expeditions in South America during the 18th century."}]}, {"canonical_name": "Adam", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 4, "total_mentions": 19, "members": [{"entity_id": "adam", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Adam", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 11, "variants": ["Adam"], "contexts": ["first man, supposed wisest", "first man, received fruit"]}, {"entity_id": "adam", "book_id": "english_physician_1652", "name": "Adam", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 5, "variants": ["Adam"], "contexts": ["biblical figure", "had infinite knowledge in innocence"]}, {"entity_id": "adam", "book_id": "principles_of_psychology_james_1890", "name": "Adam", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Adam"], "contexts": ["first man in religious narrative"]}, {"entity_id": "adam", "book_id": "coloquios_da_orta_1563", "name": "Adam", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Adam"], "contexts": ["figure associated with a mountain peak", "biblical figure"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Adam", "target_book": "english_physician_1652", "target_name": "Adam", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Adam", "target_book": "principles_of_psychology_james_1890", "target_name": "Adam", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Adam", "target_book": "coloquios_da_orta_1563", "target_name": "Adam", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Adam", "target_book": "principles_of_psychology_james_1890", "target_name": "Adam", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Adam", "target_book": "coloquios_da_orta_1563", "target_name": "Adam", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Adam", "target_book": "coloquios_da_orta_1563", "target_name": "Adam", "similarity": 1.0}], "id": 326, "stable_key": "clu_049e971624ed6b55", "ground_truth": {"modern_name": "Adam", "confidence": "high", "type": "person", "description": "Biblical first man, figure in religious narratives.", "note": "This refers to the biblical figure, not a specific historical person with that name.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Adam", "wikipedia_extract": "Adam is the name given in Genesis 1–5 to the first human. Adam is the first human being aware of God, and features as such in various belief systems (including Judaism, Christianity, Gnosticism, Islam, and the Baháʼí Faith). According to Christianity, Adam sinned in the Garden of Eden by eating from the tree of the knowledge of good and evil. This action introduced death and sin into the world. This sinful nature infected all his descendants, and led humanity to be expelled from the Garden. Only through the crucifixion of Jesus, humanity can be redeemed."}, "cross_references": [{"found_name": "Christ", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 13, "target_cluster_name": "Christ", "source_book": "llm_generated", "evidence_snippet": "Adam is a significant figure in the biblical narrative that precedes and informs the story of Jesus Christ.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Adam is a significant figure in the biblical narrative that precedes and informs the story of Jesus Christ.", "is_reverse": true}, {"found_name": "Human being", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 604, "target_cluster_name": "man", "source_book": "llm_generated", "evidence_snippet": "Adam is explicitly described as the first human being.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Adam is explicitly described as the first human being."}, {"found_name": "Humans", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 795, "target_cluster_name": "men", "source_book": "llm_generated", "evidence_snippet": "Adam is explicitly described as the first human being.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Adam is explicitly described as the first human being."}, {"found_name": "Eve", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2086, "target_cluster_name": "Eve", "source_book": "llm_generated", "evidence_snippet": "Eve is Adam's wife and the second human created in Genesis.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Eve is Adam's wife and the second human created in Genesis."}, {"found_name": "Ancestor", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2035, "target_cluster_name": "progenitor", "source_book": "llm_generated", "evidence_snippet": "As the first human, Adam is the ancestor of all subsequent humanity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "As the first human, Adam is the ancestor of all subsequent humanity."}, {"found_name": "homens", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 904, "target_cluster_name": "homens", "source_book": "llm_generated", "evidence_snippet": "Adam is considered the first human in Abrahamic religions, a foundational figure in many premodern cosmologies and genealogies.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Adam is considered the first human in Abrahamic religions, a foundational figure in many premodern cosmologies and genealogies.", "is_reverse": true}, {"found_name": "mankind", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1123, "target_cluster_name": "mankind", "source_book": "llm_generated", "evidence_snippet": "Adam is considered the first man in Abrahamic religions, making him a foundational figure for humanity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Adam is considered the first man in Abrahamic religions, making him a foundational figure for humanity.", "is_reverse": true}, {"found_name": "Musa", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 673, "target_cluster_name": "Musa", "source_book": "llm_generated", "evidence_snippet": "Adam is the first man in Abrahamic religions, and is often discussed in theological contexts alongside other significant prophets like Moses.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Adam is the first man in Abrahamic religions, and is often discussed in theological contexts alongside other significant prophets like Moses.", "is_reverse": true}, {"found_name": "HOMMES", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2762, "target_cluster_name": "HOMMES", "source_book": "llm_generated", "evidence_snippet": "Biblical progenitor of humanity, a foundational figure in the concept of 'Humans'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Biblical progenitor of humanity, a foundational figure in the concept of 'Humans'.", "is_reverse": true}, {"found_name": "homem", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 892, "target_cluster_name": "homem", "source_book": "llm_generated", "evidence_snippet": "Adam is considered the first human in Abrahamic religions, making him a foundational figure in the concept of humanity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Adam is considered the first human in Abrahamic religions, making him a foundational figure in the concept of humanity.", "is_reverse": true}, {"found_name": "Ibrahim", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1067, "target_cluster_name": "Ibrahim", "source_book": "llm_generated", "evidence_snippet": "Adam is considered the first man in Abrahamic religions, and Abraham is a key patriarch in these same traditions.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Adam is considered the first man in Abrahamic religions, and Abraham is a key patriarch in these same traditions.", "is_reverse": true}, {"found_name": "Apostles", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1296, "target_cluster_name": "Apostles", "source_book": "llm_generated", "evidence_snippet": "Both are foundational figures in Abrahamic traditions. Adam is the first man, and the Apostles are the first followers of Jesus, initiating the Christian church.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both are foundational figures in Abrahamic traditions. Adam is the first man, and the Apostles are the first followers of Jesus, initiating the Christian church.", "is_reverse": true}, {"found_name": "progenitor", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2035, "target_cluster_name": "progenitor", "source_book": "llm_generated", "evidence_snippet": "In many religious and cultural traditions, Adam is considered the first human ancestor of all mankind, making him a significant progenitor figure.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: In many religious and cultural traditions, Adam is considered the first human ancestor of all mankind, making him a significant progenitor figure.", "is_reverse": true}]}, {"canonical_name": "Columbus", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 4, "total_mentions": 19, "members": [{"entity_id": "columbus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Columbus", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Columbus"], "contexts": ["discoverer of America", "Italian explorer and navigator"]}, {"entity_id": "columbus", "book_id": "principles_of_psychology_james_1890", "name": "Columbus", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Columbus"], "contexts": ["historical figure mentioned in example", "subject of thought, historical figure"]}, {"entity_id": "columbus", "book_id": "kosmos_humboldt_1845", "name": "Columbus", "category": "PERSON", "subcategory": "SCHOLAR", "count": 11, "variants": ["Columbus"], "contexts": ["explorer compared to the author", "explorer, wrote from Jamaica to Queen Isabella"]}, {"entity_id": "columbus", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Columbus", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Columbus"], "contexts": ["early navigator", "early navigator comparing sea to meadows"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Columbus", "target_book": "principles_of_psychology_james_1890", "target_name": "Columbus", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Columbus", "target_book": "kosmos_humboldt_1845", "target_name": "Columbus", "similarity": 0.701}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Columbus", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Columbus", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Columbus", "target_book": "kosmos_humboldt_1845", "target_name": "Columbus", "similarity": 0.701}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Columbus", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Columbus", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Columbus", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Columbus", "similarity": 0.701}], "id": 327, "stable_key": "clu_5c3bd1598dc68d7e", "ground_truth": {"modern_name": "Christopher Columbus", "confidence": "high", "type": "person", "birth_year": 1451, "death_year": 1506, "description": "Italian explorer and navigator, discoverer of America.", "wikidata_id": "Q7322", "wikidata_description": "Italian navigator, explorer, and colonist (1451–1506)", "wikipedia_url": "https://en.wikipedia.org/wiki/Christopher%20Columbus", "wikipedia_extract": "Christopher Columbus (; between 25 August and 31 October 1451 – 20 May 1506) was an Italian explorer and navigator from the Republic of Genoa who completed four Spanish-based voyages across the Atlantic Ocean sponsored by the Catholic Monarchs, opening the way for the widespread European exploration and colonization of the Americas. His expeditions were the first known European contact with the Caribbean and Central and South America. The name Christopher Columbus is the anglicization of the Latin Christophorus Columbus. Growing up on the coast of Liguria, he went to sea at a young age and traveled widely, as far north as the British Isles and as far south as what is now Ghana. He married Portuguese noblewoman Filipa Moniz Perestrelo, who bore a son, Diego, and was based in Lisbon for several years. He later took a Castilian mistress, Beatriz Enríquez de Arana, who bore a son, Ferdinand."}, "cross_references": [{"found_name": "Amerigo Vespucci", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3017, "target_cluster_name": "Amerigo Vespucci", "source_book": "llm_generated", "evidence_snippet": "Amerigo Vespucci was a contemporary explorer whose voyages to the Americas occurred shortly after Columbus's, and the continent was named after Vespucci, creating a significant historical connection and often a point of comparison.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Amerigo Vespucci was a contemporary explorer whose voyages to the Americas occurred shortly after Columbus's, and the continent was named after Vespucci, creating a significant historical connection and often a point of comparison."}, {"found_name": "Catholic Monarchs", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4392, "target_cluster_name": "Catholic monarchs", "source_book": "llm_generated", "evidence_snippet": "The Catholic Monarchs (Ferdinand II of Aragon and Isabella I of Castile) were the sponsors of Christopher Columbus's voyages, providing the financial and political backing for his expeditions.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Catholic Monarchs (Ferdinand II of Aragon and Isabella I of Castile) were the sponsors of Christopher Columbus's voyages, providing the financial and political backing for his expeditions."}, {"found_name": "African explorer", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4227, "target_cluster_name": "African explorer", "source_book": "llm_generated", "evidence_snippet": "While Columbus was European, his voyages were part of a broader era of European exploration that included significant exploration of Africa by various individuals and groups. The term 'African explorer' could refer to contemporaries or predecessors involved in exploring the African continent, placing Columbus's activities within a larger context of global exploration.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "While Columbus was European, his voyages were part of a broader era of European exploration that included significant exploration of Africa by various individuals and groups. The term 'African explorer' could refer to contemporaries or predecessors involved in exploring the African continent, placing Columbus's activities within a larger context of global exploration."}, {"found_name": "Drake", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 461, "target_cluster_name": "Drake", "source_book": "llm_generated", "evidence_snippet": "Both were prominent English and Spanish explorers, respectively, during the Age of Discovery, undertaking significant voyages that expanded European knowledge of the world.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were prominent English and Spanish explorers, respectively, during the Age of Discovery, undertaking significant voyages that expanded European knowledge of the world.", "is_reverse": true}, {"found_name": "Italians", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 462, "target_cluster_name": "Italians", "source_book": "llm_generated", "evidence_snippet": "Christopher Columbus was an Italian explorer and navigator.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Christopher Columbus was an Italian explorer and navigator.", "is_reverse": true}, {"found_name": "Marco Polo", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 596, "target_cluster_name": "Marco Polo", "source_book": "llm_generated", "evidence_snippet": "Both are famous explorers whose voyages and discoveries were documented and widely disseminated, influencing European understanding of the world.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both are famous explorers whose voyages and discoveries were documented and widely disseminated, influencing European understanding of the world.", "is_reverse": true}, {"found_name": "Niebuhr", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 971, "target_cluster_name": "Niebuhr", "source_book": "llm_generated", "evidence_snippet": "Both were European explorers who undertook voyages to distant lands, significantly expanding European knowledge of geography and cultures.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were European explorers who undertook voyages to distant lands, significantly expanding European knowledge of geography and cultures.", "is_reverse": true}, {"found_name": "Cook", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1072, "target_cluster_name": "Cook", "source_book": "llm_generated", "evidence_snippet": "Both were pivotal European explorers who undertook voyages that significantly expanded European knowledge of the globe and led to profound geopolitical changes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were pivotal European explorers who undertook voyages that significantly expanded European knowledge of the globe and led to profound geopolitical changes.", "is_reverse": true}, {"found_name": "Halley", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1784, "target_cluster_name": "Halley", "source_book": "llm_generated", "evidence_snippet": "Both were significant figures in the Age of Discovery and exploration, though in different domains (astronomy/navigation vs. trans-Atlantic voyages).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were significant figures in the Age of Discovery and exploration, though in different domains (astronomy/navigation vs. trans-Atlantic voyages).", "is_reverse": true}, {"found_name": "Anghiera", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2195, "target_cluster_name": "Anghiera", "source_book": "llm_generated", "evidence_snippet": "Peter Martyr d'Anghiera was a contemporary and chronicler of Columbus's voyages, and his writings provide significant historical accounts of Columbus's expeditions and discoveries.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Peter Martyr d'Anghiera was a contemporary and chronicler of Columbus's voyages, and his writings provide significant historical accounts of Columbus's expeditions and discoveries.", "is_reverse": true}, {"found_name": "sargassa", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "connexion_physical_sciences_somerville_1858", "evidence_snippet": "and germinate where the parent plant grew. The quantity of algæ in that accumulation known as the sargassa or grassy sea is so great, that the early navigators, Columbus and Lerius, compared it to ext", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "accumulation of algæ, also called grassy sea"}]}, {"canonical_name": "fingers", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 5, "total_mentions": 29, "members": [{"entity_id": "fingers", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "fingers", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["fingers"], "contexts": ["part of the hand", "digits of the hand"]}, {"entity_id": "fingers", "book_id": "origin_of_species_darwin_1859", "name": "fingers", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["fingers"], "contexts": ["digits on the hand", "body part, additional can be monstrous"]}, {"entity_id": "fingers", "book_id": "principles_of_psychology_james_1890", "name": "fingers", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 12, "variants": ["fingers"], "contexts": ["digits on the hand", "digits of the hand"]}, {"entity_id": "finger-tips", "book_id": "principles_of_psychology_james_1890", "name": "finger-tips", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["finger-tips"], "contexts": ["part of hand used for drumming"]}, {"entity_id": "fingers", "book_id": "first_principles_spencer_1862", "name": "fingers", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["fingers"], "contexts": ["part of the hand for tactile sensation"]}, {"entity_id": "finger", "book_id": "english_physician_1652", "name": "Finger", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Finger"], "contexts": ["size of winter cherry root"]}, {"entity_id": "finger", "book_id": "principles_of_psychology_james_1890", "name": "finger", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 8, "variants": ["finger"], "contexts": ["digit on the hand", "part of hand used to depress piano key"]}, {"entity_id": "finger", "book_id": "first_principles_spencer_1862", "name": "finger", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["finger"], "contexts": ["digit of the hand"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "fingers", "target_book": "origin_of_species_darwin_1859", "target_name": "fingers", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "fingers", "target_book": "principles_of_psychology_james_1890", "target_name": "fingers", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "fingers", "target_book": "principles_of_psychology_james_1890", "target_name": "finger-tips", "similarity": 0.971}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "fingers", "target_book": "first_principles_spencer_1862", "target_name": "fingers", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "fingers", "target_book": "principles_of_psychology_james_1890", "target_name": "fingers", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "fingers", "target_book": "principles_of_psychology_james_1890", "target_name": "finger-tips", "similarity": 0.971}, {"source_book": "origin_of_species_darwin_1859", "source_name": "fingers", "target_book": "first_principles_spencer_1862", "target_name": "fingers", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fingers", "target_book": "first_principles_spencer_1862", "target_name": "fingers", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "finger-tips", "target_book": "first_principles_spencer_1862", "target_name": "fingers", "similarity": 0.971}], "id": 328, "stable_key": "clu_8f74da3a3cd2135c", "ground_truth": {"modern_name": "fingers", "confidence": "high", "type": "concept", "note": "While fingers are anatomical parts, the context here discusses them as general physical entities, not specific medical diagnoses or treatments, aligning more with a conceptual use within broader scientific and philosophical discourse.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Finger", "wikipedia_extract": "A finger is a prominent digit on the forelimbs of most tetrapod vertebrate animals, especially those with prehensile extremities (i.e. hands) such as humans and other primates. Most tetrapods have five digits (pentadactyly), and short digits (i.e. significantly shorter than the metacarpal/metatarsals) are typically referred to as toes, while those that are notably elongated are called fingers. In humans, the fingers are flexibly articulated and opposable, serving as an important organ of tactile sensation and fine movements, which are crucial to the dexterity of the hands and the ability to grasp and manipulate objects. Usually humans have five digits, the bones of which are termed phalanges, on each hand, although some people have more or fewer than five due to congenital disorders such as polydactyly or oligodactyly, or accidental or intentional amputations."}, "member_count": 8, "cross_references": [{"found_name": "Arm", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 140, "target_cluster_name": "arm", "source_book": "llm_generated", "evidence_snippet": "Fingers are a part of the arm.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Fingers are a part of the arm."}, {"found_name": "Hand", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 76, "target_cluster_name": "hand", "source_book": "llm_generated", "evidence_snippet": "Fingers are a part of the hand.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Fingers are a part of the hand."}, {"found_name": "Forelimbs", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1317, "target_cluster_name": "fore-legs", "source_book": "llm_generated", "evidence_snippet": "Fingers are found on forelimbs.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Fingers are found on forelimbs."}]}, {"canonical_name": "cheiro", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 19, "members": [{"entity_id": "scent", "book_id": "english_physician_1652", "name": "scent", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["scent"], "contexts": ["quality of the flowers"]}, {"entity_id": "olor", "book_id": "historia_medicinal_monardes_1574", "name": "olor", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["olor"], "contexts": ["smell"]}, {"entity_id": "cheiro", "book_id": "coloquios_da_orta_1563", "name": "cheiro", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 12, "variants": ["cheiro", "cheiros"], "contexts": ["Smell or odor", "used to determine quality"]}, {"entity_id": "cheyro", "book_id": "polyanthea_medicinal", "name": "cheyro", "category": "CONCEPT", "subcategory": "QUALITY", "count": 5, "variants": ["cheyro"], "contexts": ["smell", "smell or scent"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "scent", "target_book": "historia_medicinal_monardes_1574", "target_name": "olor", "similarity": 0.973}, {"source_book": "english_physician_1652", "source_name": "scent", "target_book": "coloquios_da_orta_1563", "target_name": "cheiro", "similarity": 0.983}, {"source_book": "english_physician_1652", "source_name": "scent", "target_book": "polyanthea_medicinal", "target_name": "cheyro", "similarity": 0.977}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "olor", "target_book": "coloquios_da_orta_1563", "target_name": "cheiro", "similarity": 0.985}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "olor", "target_book": "polyanthea_medicinal", "target_name": "cheyro", "similarity": 0.971}, {"source_book": "coloquios_da_orta_1563", "source_name": "cheiro", "target_book": "polyanthea_medicinal", "target_name": "cheyro", "similarity": 0.985}], "id": 329, "stable_key": "clu_234cfcb0b720d86f", "ground_truth": {"modern_name": "Scent", "confidence": "high", "type": "concept", "description": "A distinctive smell, especially a pleasant one.", "note": "Refers to smell or odor, and adjectives describing it, used to assess quality or describe something.", "wikipedia_extract": "An odor (American English) or odour (Commonwealth English; see spelling differences) is a smell or a scent caused by one or more volatilized chemical compounds generally found in low concentrations that humans and many animals can perceive via their olfactory system. While smell can refer to pleasant and unpleasant odors, the terms scent, aroma, and fragrance are usually reserved for pleasant-smelling odors and are frequently used in the food and cosmetic industry to describe floral scents or to refer to perfumes. The perception of odors, or sense of smell, is mediated by the olfactory nerve. The olfactory receptor (OR) cells are neurons present in the olfactory epithelium, which is a small patch of tissue at the back of the nasal cavity. There are millions of olfactory receptor neurons that act as sensory signaling cells. Each neuron has cilia in direct contact with the air."}, "cross_references": []}, {"canonical_name": "Sumatra", "category": "PLACE", "subcategory": "REGION", "book_count": 4, "total_mentions": 19, "members": [{"entity_id": "sumatra", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Sumatra", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Sumatra"], "contexts": ["island where Malayes are indigenous"]}, {"entity_id": "sumatra", "book_id": "coloquios_da_orta_1563", "name": "Sumatra", "category": "PLACE", "subcategory": "REGION", "count": 16, "variants": ["Sumatra"], "contexts": ["origin of benzoin", "place Orta did not visit"]}, {"entity_id": "sumatra", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Sumatra", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Sumatra"], "contexts": ["island affected by eruption"]}, {"entity_id": "sumatra", "book_id": "first_principles_spencer_1862", "name": "Sumatra", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Sumatra"], "contexts": ["island in Southeast Asia"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Sumatra", "target_book": "coloquios_da_orta_1563", "target_name": "Sumatra", "similarity": 0.876}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Sumatra", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Sumatra", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Sumatra", "target_book": "first_principles_spencer_1862", "target_name": "Sumatra", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Sumatra", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Sumatra", "similarity": 0.876}, {"source_book": "coloquios_da_orta_1563", "source_name": "Sumatra", "target_book": "first_principles_spencer_1862", "target_name": "Sumatra", "similarity": 0.876}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Sumatra", "target_book": "first_principles_spencer_1862", "target_name": "Sumatra", "similarity": 1.0}], "id": 330, "stable_key": "clu_c3ebdd99faf40296", "ground_truth": {"modern_name": "Sumbawa", "confidence": "high", "type": "place", "country": "Indonesia", "note": "Sumbawa and Sumbava are likely spelling variations of the same Indonesian island. Sumatra is a nearby, larger island, but Sumbawa is strongly suggested by frequency and context of eruptions.", "wikidata_id": "Q186367", "wikidata_description": "island in West Nusa Tenggara Province, Indonesia", "wikipedia_url": "https://en.wikipedia.org/wiki/Sumbawa", "wikipedia_extract": "Sumbawa, is an Indonesian island, located in the middle of the Lesser Sunda Islands chain, with Lombok to the west, Flores to the east, and Sumba further to the southeast. Along with Lombok, it forms the province of West Nusa Tenggara, but there have been plans (currently held in abeyance) by the Indonesian government to split the island off into a separate province. Traditionally, the island is known as the source of sappanwood, as well as honey and sandalwood. Its savanna-like climate and vast grasslands are used to breed horses and cattle, as well as to hunt deer. Sumbawa has an area of 15,448 square kilometres or 5,965 square miles (three times the size of Lombok) with a population (at the 2020 Census) of 1,561,461; the official estimate as at mid-2024 was 1,669,787. It marks the boundary between the islands to the west, which were influenced by religion and culture spreading from India, and the region to the east which was less influenced."}, "cross_references": [{"found_name": "Borneo", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 184, "target_cluster_name": "Borneo", "source_book": "llm_generated", "evidence_snippet": "Sumbawa is an island in the Lesser Sunda Islands, adjacent to Borneo in the Indonesian archipelago.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Sumbawa is an island in the Lesser Sunda Islands, adjacent to Borneo in the Indonesian archipelago."}, {"found_name": "East Indies", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 497, "target_cluster_name": "East Indies", "source_book": "llm_generated", "evidence_snippet": "Sumbawa is an island located in the East Indies.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Sumbawa is an island located in the East Indies."}, {"found_name": "Celebes", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4014, "target_cluster_name": "Celebes", "source_book": "llm_generated", "evidence_snippet": "Sumbawa is an island in the Indonesian archipelago, near Celebes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Sumbawa is an island in the Indonesian archipelago, near Celebes."}]}, {"canonical_name": "fibres", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 4, "total_mentions": 19, "members": [{"entity_id": "matière_fibreuse", "book_id": "relation_historique_humboldt_vol3_1825", "name": "matière fibreuse", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["matière fibreuse"], "contexts": ["fibrous substance"]}, {"entity_id": "fibres", "book_id": "principles_of_psychology_james_1890", "name": "fibres", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 15, "variants": ["fibres"], "contexts": ["nerve fibers transmitting signals", "nerve or muscle components"]}, {"entity_id": "fibres", "book_id": "connexion_physical_sciences_somerville_1858", "name": "fibres", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["fibres"], "contexts": ["elongated cellular structures"]}, {"entity_id": "fibres", "book_id": "first_principles_spencer_1862", "name": "fibres", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["fibres"], "contexts": ["minute components of tissue", "rupture of nerve fibres"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "matière fibreuse", "target_book": "principles_of_psychology_james_1890", "target_name": "fibres", "similarity": 0.919}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "matière fibreuse", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "fibres", "similarity": 0.919}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "matière fibreuse", "target_book": "first_principles_spencer_1862", "target_name": "fibres", "similarity": 0.919}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fibres", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "fibres", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fibres", "target_book": "first_principles_spencer_1862", "target_name": "fibres", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "fibres", "target_book": "first_principles_spencer_1862", "target_name": "fibres", "similarity": 1.0}], "id": 331, "stable_key": "clu_3f08fece8148d209", "ground_truth": {"modern_name": "fibers", "confidence": "high", "type": "concept", "note": "Refers to elongated structures, which can be cellular (like nerve fibers) or general fibrous substances, fitting a conceptual rather than specific biological entity.", "wikidata_id": "Q215210", "wikidata_description": "indigestible portion of food derived from plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Dietary%20fiber", "wikipedia_extract": "Dietary fiber, fibre, or roughage is the portion of plant-derived food that cannot be completely broken down by human digestive enzymes. Dietary fibers are diverse in chemical composition and can be grouped generally by their solubility, viscosity and fermentability which affect how fibers are processed in the body. Dietary fiber has two main subtypes: soluble fiber and insoluble fiber which are components of plant-based foods such as legumes, whole grains, cereals, vegetables, fruits, nuts, and seeds. A diet high in regular fiber consumption is generally associated with supporting health and lowering the risk of several diseases. Dietary fiber consists of non-starch polysaccharides and other plant components such as cellulose, resistant starch, resistant dextrins, inulins, lignins, chitins, pectins, beta-glucans, and oligosaccharides. Food sources of dietary fiber have traditionally been divided according to whether they provide soluble or insoluble fiber."}, "cross_references": [{"found_name": "_muscæ volitantes_", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "principles_of_psychology_james_1890", "evidence_snippet": "\"Let me give a few well-known cases, taken from physiological optics, as examples. Every eye probably contains _muscæ volitantes_, so called; these are fibres, granules, etc., floating in the vitreous", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "objects seen in the field of vision, also called"}]}, {"canonical_name": "radiation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 19, "members": [{"entity_id": "irradiations", "book_id": "principles_of_psychology_james_1890", "name": "irradiations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["irradiations"], "contexts": ["spreading sensations", "proposed neural resistance mechanism"]}, {"entity_id": "radiation", "book_id": "kosmos_humboldt_1845", "name": "radiation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["radiation", "Radiation"], "contexts": ["emission of energy", "process of heat loss"]}, {"entity_id": "radiation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "radiation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["radiation", "Radiation"], "contexts": ["emission of energy as waves or particles", "phenomenon analogous to Moser's images"]}, {"entity_id": "radiation_of_light", "book_id": "connexion_physical_sciences_somerville_1858", "name": "radiation of light", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["radiation of light"], "contexts": ["emission of light waves"]}, {"entity_id": "radiation", "book_id": "first_principles_spencer_1862", "name": "radiation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["radiation"], "contexts": ["communication of Heat through space", "emission of energy as waves or particles"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "irradiations", "target_book": "kosmos_humboldt_1845", "target_name": "radiation", "similarity": 0.916}, {"source_book": "principles_of_psychology_james_1890", "source_name": "irradiations", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "radiation", "similarity": 0.916}, {"source_book": "principles_of_psychology_james_1890", "source_name": "irradiations", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "radiation of light", "similarity": 0.886}, {"source_book": "principles_of_psychology_james_1890", "source_name": "irradiations", "target_book": "first_principles_spencer_1862", "target_name": "radiation", "similarity": 0.916}, {"source_book": "kosmos_humboldt_1845", "source_name": "radiation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "radiation", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "radiation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "radiation of light", "similarity": 0.891}, {"source_book": "kosmos_humboldt_1845", "source_name": "radiation", "target_book": "first_pr