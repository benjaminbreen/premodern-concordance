olyanthea_medicinal", "name": "membrana", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 16, "variants": ["membrana", "membranas", "membranas do Abdo- men", "membranas do cerebro", "membranas docerebro"], "contexts": ["membrane", "tissue layer involved in cauterization"]}, {"entity_id": "membranous_substance", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "membranous substance", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["membranous substance"], "contexts": ["thin, skin-like material"]}, {"entity_id": "membrane", "book_id": "origin_of_species_darwin_1859", "name": "membrane", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["membrane"], "contexts": ["rudiments of wings"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Membranes", "target_book": "polyanthea_medicinal", "target_name": "membrana", "similarity": 0.894}], "id": 1813, "stable_key": "clu_40238fe9d4f91d5a", "ground_truth": {"modern_name": "Membranes", "confidence": "high", "type": "concept", "note": "While 'membrane' can refer to anatomical structures, in this context, especially with 'embryonic development', it refers to the conceptual biological structure rather than a specific anatomical part.", "wikidata_id": "Q226697", "wikidata_description": "animal skin processed for writing or painting on", "wikipedia_url": "https://en.wikipedia.org/wiki/Parchment", "wikipedia_extract": "Parchment is a writing material made from specially prepared untanned skins of animals—primarily sheep, calves and goats. It has been used as a writing medium in West Asia and Europe for more than two millennia. By 400 AD many of the written works intended for preservation in these regions had been transferred from papyrus to parchment. Vellum is a type of fine-quality parchment made from the skins of young animals such as lambs and young calves. The generic term animal membrane is sometimes used by libraries and museums that wish to avoid distinguishing between parchment and vellum. Today the term parchment is often used in non-technical contexts to refer to any animal skin, particularly goat, sheep or cow, that has been scraped or dried under tension."}, "member_count": 4, "cross_references": [{"found_name": "Skins", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3308, "target_cluster_name": "Skins", "source_book": "llm_generated", "evidence_snippet": "Skin is a type of membrane.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Skin is a type of membrane.", "is_reverse": true}, {"found_name": "Cellular structure", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4029, "target_cluster_name": "cellular structure", "source_book": "llm_generated", "evidence_snippet": "Parchment is made from animal skins, which are composed of cellular structures.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Parchment is made from animal skins, which are composed of cellular structures."}, {"found_name": "Cellular tissue", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1440, "target_cluster_name": "cellular tissue", "source_book": "llm_generated", "evidence_snippet": "Parchment is made from animal skins, which are composed of cellular tissue.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Parchment is made from animal skins, which are composed of cellular tissue."}, {"found_name": "Ligaments", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 827, "target_cluster_name": "limbs", "source_book": "llm_generated", "evidence_snippet": "Parchment is made from animal skins, which contain ligaments.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Parchment is made from animal skins, which contain ligaments."}, {"found_name": "Biological structure", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2276, "target_cluster_name": "structure", "source_book": "llm_generated", "evidence_snippet": "Parchment is a material derived from the biological structure of animal skins.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Parchment is a material derived from the biological structure of animal skins."}]}, {"canonical_name": "humores melancolicos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "melancholly_humors", "book_id": "english_physician_1652", "name": "Melancholly humors", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["Melancholly humors", "Melanchollick Humors", "Melanchollick humor", "Melancholly Hu∣mors"], "contexts": ["humoral imbalance", "humor to be diminished"]}, {"entity_id": "humores_melancolicos", "book_id": "polyanthea_medicinal", "name": "humores melancolicos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 12, "variants": ["humores melancolicos"], "contexts": ["part of humoral theory", "body fluids associated with paralysis"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Melancholly humors", "target_book": "polyanthea_medicinal", "target_name": "humores melancolicos", "similarity": 0.963}], "id": 1814, "stable_key": "clu_2c5dad17fbab5525", "ground_truth": {"modern_name": "Melancholic Humors", "confidence": "high", "type": "concept", "description": "Body fluids associated with imbalance and melancholy in humoral theory.", "wikipedia_extract": "Humorism, the humoral theory, or humoralism, was a system of medicine detailing a supposed makeup and workings of the human body, adopted by Ancient Greek and Roman physicians and philosophers. Humorism began to fall out of favor in the 17th century and it was definitively disproved with the discovery of microbes. The concept of \"humors\" may have origins in Ancient Egyptian medicine, or Mesopotamia, though it was not systemized until ancient Greek thinkers. The word humor is a translation of Greek χυμός, chymos (literally 'juice' or 'sap', metaphorically 'flavor'). Early texts on Indian Ayurveda medicine presented a theory of three or four humors (doṣas), which they sometimes linked with the five elements (pañca-bhūta): earth, water, fire, air, and space. The concept of \"humors\" (chemical systems regulating human behaviour) became more prominent from the writing of medical theorist Alcmaeon of Croton (c. 540–500 BC)."}, "cross_references": [{"found_name": "humers", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 3925, "target_cluster_name": "humers", "source_book": "llm_generated", "evidence_snippet": "This is a direct translation and specific type of humor ('melancholic humors') within the humoral theory.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: This is a direct translation and specific type of humor ('melancholic humors') within the humoral theory.", "is_reverse": true}, {"found_name": "fangue", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1566, "target_cluster_name": "fangue", "source_book": "llm_generated", "evidence_snippet": "Blood was associated with the melancholic humors in humoral theory.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Blood was associated with the melancholic humors in humoral theory.", "is_reverse": true}, {"found_name": "Choleric humor", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 601, "target_cluster_name": "Choller", "source_book": "llm_generated", "evidence_snippet": "Melancholic humors are one of the four cardinal humors in humoral theory, alongside choleric, sanguine, and phlegmatic humors. They are distinct but part of the same theoretical framework.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Melancholic humors are one of the four cardinal humors in humoral theory, alongside choleric, sanguine, and phlegmatic humors. They are distinct but part of the same theoretical framework."}, {"found_name": "Phlegm", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2513, "target_cluster_name": "phlegm", "source_book": "llm_generated", "evidence_snippet": "Phlegm is one of the four cardinal humors in humoral theory, alongside melancholic, choleric, and sanguine humors. They are distinct but part of the same theoretical framework.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Phlegm is one of the four cardinal humors in humoral theory, alongside melancholic, choleric, and sanguine humors. They are distinct but part of the same theoretical framework."}, {"found_name": "Blood", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1488, "target_cluster_name": "sangue", "source_book": "llm_generated", "evidence_snippet": "Blood is one of the four cardinal humors in humoral theory, alongside melancholic, choleric, and phlegmatic humors. They are distinct but part of the same theoretical framework.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Blood is one of the four cardinal humors in humoral theory, alongside melancholic, choleric, and phlegmatic humors. They are distinct but part of the same theoretical framework."}, {"found_name": "Cold humors", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1773, "target_cluster_name": "humores frios", "source_book": "llm_generated", "evidence_snippet": "Melancholic humors were often associated with cold and dry qualities, making 'cold humors' a related concept within the broader humoral theory.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Melancholic humors were often associated with cold and dry qualities, making 'cold humors' a related concept within the broader humoral theory."}]}, {"canonical_name": "Fumofterno", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "fumitory", "book_id": "english_physician_1652", "name": "Fumitory", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Fumitory", "Fumitary", "Fu∣mitory"], "contexts": ["herb with medicinal properties", "herb"]}, {"entity_id": "fumofterno", "book_id": "ricettario_fiorentino_1597", "name": "Fumofterno", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 13, "variants": ["Fumofterno", "Fumo", "Fumoft", "Fumòfterno", "fumo", "fumoflcrno", "fumofterno"], "contexts": ["fumitory herb used in syrup", "plant used in syrup"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Fumitory", "target_book": "ricettario_fiorentino_1597", "target_name": "Fumofterno", "similarity": 0.888}], "id": 1815, "stable_key": "clu_12cba93709572ac4", "ground_truth": {"modern_name": "Fumitory", "confidence": "high", "type": "plant", "linnaean": "Fumaria officinalis L.", "family": "Papaveraceae", "note": "The Latin 'Fumofterno' and English 'Fumitory' both refer to the plant Fumaria officinalis."}, "cross_references": [{"found_name": "Celidonia", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 766, "target_cluster_name": "Celidonia", "source_book": "llm_generated", "evidence_snippet": "Fumitory is a common name for plants in the genus Fumaria, which share historical medicinal applications and are often discussed alongside celandine.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Fumitory is a common name for plants in the genus Fumaria, which share historical medicinal applications and are often discussed alongside celandine.", "is_reverse": true}, {"found_name": "Celandine", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 766, "target_cluster_name": "Celidonia", "source_book": "llm_generated", "evidence_snippet": "Fumitory (Fumaria officinalis) and Celandine (Chelidonium majus) were often grouped together in historical pharmacopoeias and herbal texts due to their similar appearances and perceived medicinal properties, particularly for liver ailments and skin conditions. They were sometimes confused or used interchangeably in certain contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Fumitory (Fumaria officinalis) and Celandine (Chelidonium majus) were often grouped together in historical pharmacopoeias and herbal texts due to their similar appearances and perceived medicinal properties, particularly for liver ailments and skin conditions. They were sometimes confused or used interchangeably in certain contexts."}, {"found_name": "Chelidonium", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3912, "target_cluster_name": "Chelidonium", "source_book": "llm_generated", "evidence_snippet": "Fumitory (Fumaria officinalis) and Chelidonium (referring to Celandine, Chelidonium majus) were often grouped together in historical pharmacopoeias and herbal texts due to their similar appearances and perceived medicinal properties, particularly for liver ailments and skin conditions. They were sometimes confused or used interchangeably in certain contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Fumitory (Fumaria officinalis) and Chelidonium (referring to Celandine, Chelidonium majus) were often grouped together in historical pharmacopoeias and herbal texts due to their similar appearances and perceived medicinal properties, particularly for liver ailments and skin conditions. They were sometimes confused or used interchangeably in certain contexts."}]}, {"canonical_name": "hearing", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 17, "members": [{"entity_id": "hear", "book_id": "english_physician_1652", "name": "Hear", "category": "CONCEPT