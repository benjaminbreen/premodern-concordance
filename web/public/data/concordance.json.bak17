source of light for experiment"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "candle", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "candle", "similarity": 1.0}], "id": 3089, "stable_key": "clu_6a0103b8c610fa34", "ground_truth": {"modern_name": "candle", "confidence": "high", "type": "object", "wikidata_id": "", "wikidata_description": "family name"}, "cross_references": [{"found_name": "candil", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1275, "target_cluster_name": "candil", "source_book": "llm_generated", "evidence_snippet": "A lamp is a device that produces light, often by burning a fuel like oil or wax, similar to a candle.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: A lamp is a device that produces light, often by burning a fuel like oil or wax, similar to a candle.", "is_reverse": true}]}, {"canonical_name": "Valentin", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "valentin", "book_id": "principles_of_psychology_james_1890", "name": "Valentin", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Valentin"], "contexts": ["cited physiologist", "author of Physiology text"]}, {"entity_id": "valentin", "book_id": "polyanthea_medicinal", "name": "Valentin", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Valentin", "Valentinus"], "contexts": ["mentioned in relation to antimony", "early modern scholar"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Valentin", "target_book": "polyanthea_medicinal", "target_name": "Valentin", "similarity": 1.0}], "id": 3090, "stable_key": "clu_5288490fcc42b96d", "ground_truth": {"modern_name": "Bafilio Valentino", "confidence": "high", "type": "person", "description": "Early modern scholar and physiologist, author on antimony."}, "cross_references": []}, {"canonical_name": "melody", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "melody", "book_id": "principles_of_psychology_james_1890", "name": "melody", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["melody"], "contexts": ["sequence of musical notes"]}, {"entity_id": "melody", "book_id": "first_principles_spencer_1862", "name": "melody", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["melody"], "contexts": ["musical composition", "sequence of musical notes"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "melody", "target_book": "first_principles_spencer_1862", "target_name": "melody", "similarity": 1.0}], "id": 3091, "stable_key": "clu_50237c451963b635", "ground_truth": {"modern_name": "Melody", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "female given name", "wikipedia_extract": "A melody (from Greek  μελῳδία (melōidía) 'singing, chanting'), also tune, voice, or line, is a linear succession of musical tones that the listener perceives as a single entity. In its most literal sense, a melody is a combination of pitch and rhythm, while more figuratively, the term can include other musical elements such as tonal color. It is the foreground to the background accompaniment. A line or part need not be a foreground melody. Melodies often consist of one or more musical phrases or motifs, and are usually repeated throughout a composition in various forms. Melodies may also be described by their melodic motion or the pitches or the intervals between pitches (predominantly conjunct or disjunct or with further restrictions), pitch range, tension and release, continuity and coherence, cadence, and shape."}, "cross_references": []}, {"canonical_name": "auditory nerve", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "auditory_nerve", "book_id": "principles_of_psychology_james_1890", "name": "auditory nerve", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["auditory nerve"], "contexts": ["nerve transmitting sound signals", "nerve for hearing"]}, {"entity_id": "auditory_nerves", "book_id": "connexion_physical_sciences_somerville_1858", "name": "auditory nerves", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["auditory nerves"], "contexts": ["nerves transmitting sound signals", "nerves that transmit sound signals"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "auditory nerve", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "auditory nerves", "similarity": 0.976}], "id": 3092, "stable_key": "clu_b7b628a09e841e74", "ground_truth": {"modern_name": "Auditory nerve", "confidence": "high", "type": "concept"}, "cross_references": [{"found_name": "eye", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 81, "target_cluster_name": "eye", "source_book": "llm_generated", "evidence_snippet": "The auditory nerve is part of the sensory system, analogous to the optic nerve which is part of the visual system.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The auditory nerve is part of the sensory system, analogous to the optic nerve which is part of the visual system.", "is_reverse": true}, {"found_name": "Ouvidos", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 136, "target_cluster_name": "Ouvidos", "source_book": "llm_generated", "evidence_snippet": "The auditory nerve is a crucial component of the ear responsible for transmitting sound information to the brain.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The auditory nerve is a crucial component of the ear responsible for transmitting sou