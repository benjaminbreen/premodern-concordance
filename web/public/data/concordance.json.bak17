 {"modern_name": "Agriculture", "confidence": "high", "type": "concept", "wikidata_id": "Q11451", "wikidata_description": "cultivation of plants and animals to provide useful products", "wikipedia_url": "https://en.wikipedia.org/wiki/Agriculture", "wikipedia_extract": "Agriculture is the practice of cultivating the soil, planting, raising, and harvesting both food and non-food crops, as well as livestock production. Broader definitions also include forestry and aquaculture. Agriculture was a key factor in the rise of sedentary human civilization, whereby farming of domesticated plants and animals created food surpluses that enabled people to live in the cities. While humans started gathering grains at least 105,000 years ago, nascent farmers only began planting them around 11,500 years ago. Sheep, goats, pigs, and cattle were domesticated around 10,000 years ago. Plants were independently cultivated in at least 11 regions of the world."}, "cross_references": [{"found_name": "May", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1657, "target_cluster_name": "May", "source_book": "llm_generated", "evidence_snippet": "May is a significant month for agricultural activities in many parts of the world, particularly in the Northern Hemisphere.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: May is a significant month for agricultural activities in many parts of the world, particularly in the Northern Hemisphere.", "is_reverse": true}, {"found_name": "Botany", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1098, "target_cluster_name": "botany", "source_book": "llm_generated", "evidence_snippet": "Botany is the scientific study of plants, which are central to agriculture.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Botany is the scientific study of plants, which are central to agriculture."}, {"found_name": "Domestic animals", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 770, "target_cluster_name": "domestic animals", "source_book": "llm_generated", "evidence_snippet": "Domestic animals are a key component of livestock production, which is part of agriculture.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Domestic animals are a key component of livestock production, which is part of agriculture."}, {"found_name": "Economy", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4027, "target_cluster_name": "economy", "source_book": "llm_generated", "evidence_snippet": "Agriculture is a fundamental economic activity, forming the basis of many economies.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Agriculture is a fundamental economic activity, forming the basis of many economies."}, {"found_name": "Climate", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 613, "target_cluster_name": "climate", "source_book": "llm_generated", "evidence_snippet": "Climate significantly influences agricultural practices and crop yields.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Climate significantly influences agricultural practices and crop yields."}, {"found_name": "Geography", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1068, "target_cluster_name": "Geography", "source_book": "llm_generated", "evidence_snippet": "Geography, particularly physical geography, determines the suitability of land for agriculture and influences agricultural practices.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Geography, particularly physical geography, determines the suitability of land for agriculture and influences agricultural practices."}, {"found_name": "civilisation", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 756, "target_cluster_name": "civilisation", "source_book": "llm_generat