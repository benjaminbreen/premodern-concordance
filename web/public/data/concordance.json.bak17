R_ANIMAL", "book_count": 2, "total_mentions": 83, "members": [{"entity_id": "galinha", "book_id": "coloquios_da_orta_1563", "name": "galinha", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 10, "variants": ["galinha", "galinha de mato", "galinhas"], "contexts": ["chicken, used for broth", "chicken, a food item"]}, {"entity_id": "gallinha", "book_id": "polyanthea_medicinal", "name": "Gallinha", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 73, "variants": ["Gallinha", "Gallinarum", "Gallo", "galinha", "gall", "gallina", "gallinha", "gallinha negra", "gallinhanegra", "gallinhapi", "gallinhas", "gallinhas gordas", "gallinka", "gallo", "gallovetho"], "contexts": ["hen", "chicken broth used as a vehicle"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "galinha", "target_book": "polyanthea_medicinal", "target_name": "Gallinha", "similarity": 0.926}], "id": 1515, "stable_key": "clu_e9276f7f10957583", "ground_truth": {"modern_name": "Chicken", "confidence": "high", "type": "animal", "linnaean": "Gallus gallus domesticus", "family": "Phasianidae", "description": "Common domestic fowl, source of meat and broth.", "wikipedia_extract": "The chicken (Gallus gallus domesticus) is a domesticated form of the red junglefowl (Gallus gallus), originally native to Southeast Asia. It was first domesticated around 8,000 years ago and is one of the most common and widespread domesticated animals in the world. Chickens are primarily kept for their meat and eggs, though they are also kept as pets. As of 2023, the global chicken population exceeds 26.5 billion, with more than 50 billion birds produced annually for consumption. Specialized breeds such as broilers and laying hens have been developed for meat and egg production, respectively. A hen bred for laying can produce over 300 eggs per year."}, "cross_references": [{"found_name": "insects", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 4, "target_cluster_name": "insects", "source_book": "llm_generated", "evidence_snippet": "Portuguese for 'chicken', a bird, not an insect. This is an error in the candidate list.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "reverse: Portuguese for 'chicken', a bird, not an insect. This is an error in the candidate list.", "is_reverse": true}, {"found_name": "Cocks", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 2669, "target_cluster_name": "Cocks", "source_book": "llm_generated", "evidence_snippet": "Portuguese for chicken.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "reverse: Portuguese for chicken.", "is_reverse": true}, {"found_name": "Parreyra", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": null, "target_cluster_name": null, "source_book": "polyanthea_medicinal", "evidence_snippet": ",ufaremosda meſma ajuda , dey \" tando-lhe em lugardobalfamo ,meyaonça de aguadaRainhadeUngria. Se \" acaufaforem flatos , deytaremos ajuda de caldo de gallo velho , cozido com \" palhas-alhas ,alfavacad", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "vulgar name for 'poda raizdaButua'"}]}, {"canonical_name": "ESCLAVES", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 81, "members": [{"entity_id": "esclaves", "book_id": "relation_historique_humboldt_vol3_1825", "name": "ESCLAVES", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 80, "variants": ["ESCLAVES", "Esclaves", "MULATRES ET NOIRS ESCLAVES", "NOIRS ESCLAVES", "Noirs esclaves", "Nègres et Mulâtres esclaves", "Négresses et Mulâtresses esclaves", "Pardos esclaves", "esclave", "esclaves", "esclaves africains", "esclaves de sang mêlé", "nègres esclaves"], "contexts": ["enslaved population group", "lake"]}, {"entity_id": "escrava", "book_id": "coloquios_da_orta_1563", "name": "escrava", "category": "PERSON", "subcategory": "OTHER_PER