u_65c29e73e1708fdd", "ground_truth": {"modern_name": "Robert Boyle", "confidence": "high", "type": "person", "birth_year": 1627, "death_year": 1691, "description": "Anglo-Irish chemist, physicist, and philosopher, pioneer of experimental science.", "wikidata_id": "Q43393", "wikidata_description": "Anglo-Irish natural philosopher, chemist, physicist, and inventor"}, "cross_references": []}, {"canonical_name": "α Lyræ", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "a_lyrae", "book_id": "kosmos_humboldt_1845", "name": "a Lyrae", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["a Lyrae"], "contexts": ["fixed star for light travel time measurement"]}, {"entity_id": "α_lyræ", "book_id": "connexion_physical_sciences_somerville_1858", "name": "α Lyræ", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 8, "variants": ["α Lyræ"], "contexts": ["star that will become polar star", "first magnitude star"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "a Lyrae", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "α Lyræ", "similarity": 0.922}], "id": 2221, "stable_key": "clu_ce0bc094e5198ea0", "ground_truth": {"modern_name": "Alpha Lyrae", "confidence": "high", "type": "place", "wikidata_id": "Q3427", "wikidata_description": "star in the constellation Lyra", "wikipedia_extract": "A pole star is a visible star that is approximately aligned with the axis of rotation of an astronomical body; that is, a star whose apparent position is close to one of the celestial poles. On Earth, a pole star would lie directly overhead when viewed from the North or the South Pole. Currently, Earth's pole stars are Polaris (Alpha Ursae Minoris), a bright magnitude 2 star aligned approximately with its northern axis that serves as a pre-eminent star in celestial navigation, and a much dimmer magnitude 5.5 star on its southern axis, Polaris Australis (Sigma Octantis). From around 1700 BC until just after 300 AD, Kochab (Beta Ursae Minoris) and Pherkad (Gamma Ursae Minoris) were twin northern pole stars, though neither was as close to the pole as Polaris is now. In classical antiquity, Beta Ursae Minoris (Kochab) was closer to the celestial north pole than Alpha Ursae Minoris. While there was no naked-eye star close to the pole, the midpoint between Alpha and Beta Ursae Minoris was reasonably close to the pole, and it appears that the entire constellation of Ursa Minor, in antiquity known as Cynosura (Greek Κυνόσουρα \"dog's tail\"), was used as indicating the northern direction for the purposes of navigation by the Phoenicians.", "wikipedia_url": "https://en.wikipedia.org/wiki/Vega"}, "cross_references": [{"found_name": "Alpha Centauri", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3153, "target_cluster_name": "Centaur", "source_book": "llm_generated", "evidence_snippet": "Both are prominent stars, with Alpha Lyrae being a pole star and Alpha Centauri being a well-known star system.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are prominent stars, with Alpha Lyrae being a pole star and Alpha Centauri being a well-known star system."}]}, {"canonical_name": "dispersion of light", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "propagation_of_light", "book_id": "kosmos_humboldt_1845", "name": "propagation of light", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["propagation of light"], "contexts": ["fundamental physical process"]}, {"entity_id": "dispersion_of_light", "book_id": "connexion_physical_sciences_somerville_1858", "name": "dispersion of light", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["Dispersion of Light", "dispersion of light"], "contexts": ["splitting of light into colours", "according to undulatory theory"]}, {"entity_id": "propagation_of_light", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Propagation of Light", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Propagation of Light"], "contexts": ["how light travels", "how light travels through space"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "propagation of light", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "dispersion of light", "similarity": 0.941}, {"source_book": "kosmos_humboldt_1845", "source_name": "propagation of light", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Propagation of Light", "similarity": 0.948}], "id": 2222, "stable_key": "clu_da9fe01ec0d7dad7", "ground_truth": {"modern_name": "dispersion of light", "confidence": "high", "type": "concept", "wikidata_id": "Q33430175", "wikidata_description": "scientific article"}, "cross_references": [{"found_name": "Interference of light", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3159, "target_cluster_name": "interference of light", "source_book": "llm_generated", "evidence_snippet": "Interference is a phenomenon that occurs when light waves interact, often following or preceding discussions of dispersion.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Interference is a phenomenon that occurs when light waves interact, often following or preceding discussions of dispersion."}]}, {"canonical_name": "Atmospheric air", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "atmospheric_air", "book_id": "kosmos_humboldt_1845", "name": "atmospheric air", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["atmospheric air"], "contexts": ["air entering volcanic crater"]}, {"entity_id": "atmospheric_air", "book_id": "connexion_physical_sciences_so