round_truth": {"modern_name": "Headache", "confidence": "high", "type": "disease", "description": "A common symptom characterized by pain in the head.", "wikipedia_extract": "A headache, also known as cephalalgia, is the symptom of pain in the face, head, or neck. It can occur as a migraine, tension-type headache, or cluster headache. There is an increased risk of depression in those with severe headaches. Headaches can occur as a result of many conditions. There are a number of different classification systems for headaches. The most well-recognized is that of the International Headache Society, which classifies it into more than 150 types of primary and secondary headaches."}, "cross_references": []}, {"canonical_name": "sympathia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 28, "members": [{"entity_id": "sympathie", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "sympathie", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sympathie"], "contexts": ["mutual understanding or influence"]}, {"entity_id": "sympathy", "book_id": "english_physician_1652", "name": "Sympathy", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 11, "variants": ["Sympathy", "sympathy"], "contexts": ["used to cure disease", "principle of cure by likeness"]}, {"entity_id": "sympathize", "book_id": "principles_of_psychology_james_1890", "name": "sympathize", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sympathize"], "contexts": ["sharing feelings with another"]}, {"entity_id": "sympathia", "book_id": "polyanthea_medicinal", "name": "sympathia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 13, "variants": ["sympathia", "Sympathia", "sympathiadas", "sympathias", "sympatia", "ſympathias"], "contexts": ["sympathy", "affinity between substances"]}, {"entity_id": "sympathy", "book_id": "first_principles_spencer_1862", "name": "sympathy", "categor