CE", "subcategory": "COUNTRY", "count": 1, "variants": ["Belgium"], "contexts": ["European country"]}, {"entity_id": "belgique", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Belgique", "category": "PLACE", "subcategory": "COUNTRY", "count": 5, "variants": ["Belgique"], "contexts": ["country in Europe", "location where coal covers graunadc"]}, {"entity_id": "belgium", "book_id": "kosmos_humboldt_1845", "name": "Belgium", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Belgium"], "contexts": ["country in Western Europe", "location of geological observations"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Belgium", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Belgique", "similarity": 0.963}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Belgium", "target_book": "kosmos_humboldt_1845", "target_name": "Belgium", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Belgique", "target_book": "kosmos_humboldt_1845", "target_name": "Belgium", "similarity": 0.963}], "id": 963, "stable_key": "clu_ee68ffad6edf9477", "ground_truth": {"modern_name": "Belgium", "confidence": "high", "type": "place", "country": "Belgium", "wikidata_id": "Q31", "wikidata_description": "country in western Europe", "wikipedia_url": "https://en.wikipedia.org/wiki/Belgium", "wikipedia_extract": "Belgium, officially the Kingdom of Belgium, is a country in Northwestern Europe. Situated in a coastal lowland region known as the Low Countries, it is bordered by the Netherlands to the north, Germany to the east, Luxembourg to the southeast, France to the south, and the North Sea to the west. Belgium covers an area of 30,689 km2 (11,849 sq mi) and has a population of more than 11.8 million; its population density of 383/km2 (990/sq mi) ranks 22nd in the world and sixth in Europe. The capital and largest metropolitan region is Brussels; other major cities are Antwerp, Ghent, Charleroi, Liège, Bruges, Namur, and Leuven. Belgium is a parliamentary constitutional monarchy with a complex federal system structured on regional and linguistic grounds. The country is divided into three highly autonomous regions: the Flemish Region (Flanders) in the north, the Walloon Region (Wallonia) in the south, and the Brussels-Capital Region in the middle."}, "cross_references": [{"found_name": "Hollande", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 127, "target_cluster_name": "Hollande", "source_book": "llm_generated", "evidence_snippet": "Belgium shares a long border and historical ties with the Netherlands, having been part of the same political entities for significant periods.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Belgium shares a long border and historical ties with the Netherlands, having been part of the same political entities for significant periods.", "is_reverse": true}, {"found_name": "Europe", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 30, "target_cluster_name": "Europe", "source_book": "llm_generated", "evidence_snippet": "Belgium is a country in Europe.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Belgium is a country in Europe."}, {"found_name": "Netherlands", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 127, "target_cluster_name": "Hollande", "source_book": "llm_generated", "evidence_snippet": "Belgium is bordered by the Netherlands.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Belgium is bordered by the Netherlands."}, {"found_name": "Germany", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 99, "target_cluster_name": "Germany", "source_book": "llm_generated", "evidence_snippet": "Belgium is bordered by Germany.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship":