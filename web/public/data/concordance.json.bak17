ique_humboldt_vol3_1825", "name": "atmosphère", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 11, "variants": ["atmosphère", "air atmosphérique", "atmosphère terrestre"], "contexts": ["constitution influencing barometer variation", "gaseous envelope surrounding Earth"]}, {"entity_id": "atmosphere", "book_id": "connexion_physical_sciences_somerville_1858", "name": "atmosphere", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 56, "variants": ["Atmosphere", "atmosphere"], "contexts": ["loss of light by absorbing power", "gaseous envelope of a planet"]}, {"entity_id": "atmosphere", "book_id": "kosmos_humboldt_1845", "name": "atmosphere", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 43, "variants": ["Atmosphere", "atmosphere"], "contexts": ["gaseous envelope surrounding Earth", "aeriform envelope of the planet"]}, {"entity_id": "terrestrial_atmosphere", "book_id": "connexion_physical_sciences_somerville_1858", "name": "terrestrial atmosphere", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["terrestrial atmosphere"], "contexts": ["refracts rays during eclipses", "effect on lunar heat"]}, {"entity_id": "atmosphere", "book_id": "first_principles_spencer_1862", "name": "atmosphere", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["atmosphere"], "contexts": ["gaseous envelope surrounding a planet", "gaseous envelope surrounding Earth"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "atmosphère", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "atmosphere", "similarity": 0.953}, {"source_book": "kosmos_humboldt_1845", "source_name": "atmosphere", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "terrestrial atmosphere", "similarity": 0.933}, {"source_book": "kosmos_humboldt_1845", "source_name": "atmosphere", "target_book": "first_principles_spencer_1862", "target_name": "atmosphere", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "terrestrial atmosphere", "target_book": "first_principles_spencer_1862", "target_name": "atmosphere", "similarity": 0.933}], "id": 213, "stable_key": "clu_e9da3f8672793df8", "ground_truth": {"modern_name": "Atmosphere", "confidence": "high", "type": "concept", "wikidata_id": "Q8104", "wikidata_description": "layer of gases surrounding a material body", "wikipedia_url": "https://en.wikipedia.org/wiki/Atmosphere", "wikipedia_extract": "An atmosphere is a layer of gases that envelop an astronomical object, held in place by the gravity of the object. The name originates from Ancient Greek  ἀτμός (atmós) 'vapour, steam' and  σφαῖρα (sphaîra) 'sphere'. An object acquires most of its atmosphere during its primordial epoch, either by accretion of matter or by outgassing of volatiles. The chemical interaction of the atmosphere with the solid surface can change its fundamental composition, as can photochemical interaction with the Sun. A planet retains an atmosphere for longer durations when the gravity is high and the temperature is low. The solar wind works to strip away a planet's outer atmosphere, although this process is slowed by a magnetosphere."}, "cross_references": [{"found_name": "Lungs", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 66, "target_cluster_name": "Lungs", "source_book": "llm_generated", "evidence_snippet": "The lungs function by exchanging gases with the atmosphere.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The lungs function by exchanging gases with the atmosphere.", "is_reverse": true}, {"found_name": "air", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 109, "target_cluster_name": "air", "source_book": "llm_generated", "evidence_snippet": "The atmosphere is the layer of air surrounding the Earth.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The atmosphere is the layer of air surrounding the Earth.", "is_reverse": true}, {"found_name": "clouds", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 376, "target_cluster_name": "clouds", "source_book": "llm_generated", "evidence_snippet": "Clouds are a component of the Earth's atmosphere.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Clouds are a component of the Earth's atmosphere.", "is_reverse": true}, {"found_name": "breathing organ", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 521, "target_cluster_name": "breathing organ", "source_book": "llm_generated", "evidence_snippet": "The atmosphere is the source of the air that respiratory organs utilize.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The atmosphere is the source of the air that respiratory organs utilize.", "is_reverse": true}, {"found_name": "fumo", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 619, "target_cluster_name": "fumo", "source_book": "llm_generated", "evidence_snippet": "Smoke, being composed of gases and particles, can be considered a component or pollutant within the atmosphere.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Smoke, being composed of gases and particles, can be considered a component or pollutant within the atmosphere.", "is_reverse": true}, {"found_name": "gases", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 725, "target_cluster_name": "gases", "source_book": "llm_generated", "evidence_snippet": "The Earth's atmosphere is composed of gases, and historical texts discussing gases would frequently reference atmospheric phenomena.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Earth's atmosphere is composed of gases, and historical texts discussing gases would frequently reference atmospheric phenomena.", "is_reverse": true}, {"found_name": "steam", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 741, "target_cluster_name": "steam", "source_book": "llm_generated", "evidence_snippet": "Steam is a component of the atmosphere, specifically water vapor.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Steam is a component of the atmosphere, specifically water vapor.", "is_reverse": true}, {"found_name": "Breath", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 752, "target_cluster_name": "Breath", "source_book": "llm_generated", "evidence_snippet": "Respiration involves the exchange of gases with the atmosphere.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Respiration involves the exchange of gases with the atmosphere.", "is_reverse": true}, {"found_name": "nitrogen", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 761, "target_cluster_name": "nitrogen", "source_book": "llm_generated", "evidence_snippet": "Nitrogen is a primary component of the Earth's atmosphere.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Nitrogen is a primary component of the Earth's atmosphere.", "is_reverse": true}, {"found_name": "sun's rays", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1199, "target_cluster_name": "sun's rays", "source_book": "llm_generated", "evidence_snippet": "Solar rays interact with and pass through the atmosphere.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Solar rays interact with and pass through the atmosphere.", "is_reverse": true}, {"found_name": "fluides élastiques", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 964, "target_cluster_name": "fluides élastiques", "source_book": "llm_generated", "evidence_snippet": "Discussions of 'elastic fluids' were frequently situated within the context of the Earth's atmosphere, its composition, and its behavior.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Discussions of 'elastic fluids' were frequently situated within the context of the Earth's atmosphere, its composition, and its behavior.", "is_reverse": true}, {"found_name": "Rivers", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2611, "target_cluster_name": "Rivers", "source_book": "llm_generated", "evidence_snippet": "The atmosphere influences river flow through precipitation and evaporation.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The atmosphere influences river flow through precipitation and evaporation.", "is_reverse": true}, {"found_name": "Mist", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1110, "target_cluster_name": "Mist", "source_book": "llm_generated", "evidence_snippet": "Mist is a phenomenon that occurs within the Earth's atmosphere, affecting its composition and visibility.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Mist is a phenomenon that occurs within the Earth's atmosphere, affecting its composition and visibility.", "is_reverse": true}, {"found_name": "winds", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1212, "target_cluster_name": "winds", "source_book": "llm_generated", "evidence_snippet": "Wind is a phenomenon within the Earth's atmosphere.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Wind is a phenomenon within the Earth's atmosphere.", "is_reverse": true}, {"found_name": "etherial medium", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3770, "target_cluster_name": "etherial medium", "source_book": "llm_generated", "evidence_snippet": "The luminiferous aether was thought to permeate the Earth's atmosphere and was sometimes conflated with or discussed in relation to atmospheric phenomena.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The luminiferous aether was thought to permeate the Earth's atmosphere and was sometimes conflated with or discussed in relation to atmospheric phenomena.", "is_reverse": true}, {"found_name": "north pole", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2136, "target_cluster_name": "north pole", "source_book": "llm_generated", "evidence_snippet": "The North Pole is a geographical location on Earth, and the atmosphere is the gaseous envelope surrounding the Earth. Historical texts often discuss the conditions and phenomena at the poles in relation to the broader atmosphere.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The North Pole is a geographical location on Earth, and the atmosphere is the gaseous envelope surrounding the Earth. Historical texts often discuss the conditions and phenomena at the poles in relation to the broader atmosphere.", "is_reverse": true}, {"found_name": "Atmospheric air", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2223, "target_cluster_name": "Atmospheric air", "source_book": "llm_generated", "evidence_snippet": "The 'Atmosphere' is the broader concept of which 'atmospheric air' is the primary constituent substance. They are intimately related as the whole and its main part.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The 'Atmosphere' is the broader concept of which 'atmospheric air' is the primary constituent substance. They are intimately related as the whole and its main part.", "is_reverse": true}, {"found_name": "solar atmosphere", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2609, "target_cluster_name": "solar atmosphere", "source_book": "llm_generated", "evidence_snippet": "The solar atmosphere is a component of the Sun's atmosphere, which is itself a part of the larger concept of 'atmosphere' in a celestial context.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The solar atmosphere is a component of the Sun's atmosphere, which is itself a part of the larger concept of 'atmosphere' in a celestial context.", "is_reverse": true}, {"found_name": "nebular matter", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2843, "target_cluster_name": "nebular matter", "source_book": "llm_generated", "evidence_snippet": "Nebular matter is a historical term that could encompass the gaseous and particulate material found in the atmosphere, particularly in early astronomical or cosmological contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Nebular matter is a historical term that could encompass the gaseous and particulate material found in the atmosphere, particularly in early astronomical or cosmological contexts.", "is_reverse": true}]}, {"canonical_name": "nervos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 113, "members": [{"entity_id": "nervs", "book_id": "english_physician_1652", "name": "Nervs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 10, "variants": ["Nervs", "Nerves"], "contexts": ["body part helped by oil", "body part that can be hurt"]}, {"entity_id": "nervios", "book_id": "historia_medicinal_monardes_1574", "name": "Nervios", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["nervios", "Nervios"], "contexts": ["part of the nervous system", "nerves, part of the body"]}, {"entity_id": "nervos", "book_id": "coloquios_da_orta_1563", "name": "nervos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 8, "variants": ["nervos", "nervo"], "contexts": ["nerves, affected by calamus", "body part affected by açaroro and calamo"]}, {"entity_id": "nervos", "book_id": "polyanthea_medicinal", "name": "nervos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 92, "variants": ["nervos", "nerveos", "nerves", "nervinhos", "nervis", "nervo", "nervootico", "nervos opticos", "nervosas", "pardos nervos", "partes nervosas"], "contexts": ["nerves", "body part affected by wine"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Nervs", "target_book": "historia_medicinal_monardes_1574", "target_name": "Nervios", "similarity": 0.959}, {"source_book": "english_physician_1652", "source_name": "Nervs", "target_book": "coloquios_da_orta_1563", "target_name": "nervos", "similarity": 0.969}, {"source_book": "english_physician_1652", "source_name": "Nervs", "target_book": "polyanthea_medicinal", "target_name": "nervos", "similarity": 0.969}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Nervios", "target_book": "coloquios_da_orta_1563", "target_name": "nervos", "similarity": 0.943}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Nervios", "target_book": "polyanthea_medicinal", "target_name": "nervos", "similarity": 0.943}, {"source_book": "coloquios_da_orta_1563", "source_name": "nervos", "target_book": "polyanthea_medicinal", "target_name": "nervos", "similarity": 1.0}], "id": 214, "stable_key": "clu_0a726ccc9c8f1aeb", "ground_truth": {"modern_name": "Nerve", "confidence": "high", "type": "anatomy", "description": "Bundles of fibers transmitting nerve impulses.", "wikipedia_extract": "A nerve is an enclosed, cable-like bundle of nerve fibers (called axons). Nerves have historically been considered the basic units of the peripheral nervous system. A nerve provides a common pathway for the electrochemical nerve impulses called action potentials that are transmitted along each of the axons to peripheral organs or, in the case of sensory nerves, from the periphery back to the central nervous system. Each axon is an extension of an individual neuron, along with other supportive cells such as some Schwann cells that coat the axons in myelin. Each axon is surrounded by a layer of connective tissue called the endoneurium. The axons are bundled together into groups called fascicles, and each fascicle is wrapped in a layer of connective tissue called the perineurium."}, "cross_references": [{"found_name": "cord", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2799, "target_cluster_name": "cord", "source_book": "llm_generated", "evidence_snippet": "The spinal cord is composed of nervous tissue and is a major component of the nervous system.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The spinal cord is composed of nervous tissue and is a major component of the nervous system.", "is_reverse": true}]}, {"canonical_name": "espiritos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 107, "members": [{"entity_id": "spirits", "book_id": "english_physician_1652", "name": "Spirits", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 16, "variants": ["spirits", "Spirits"], "contexts": ["bodily essence comforted by Angelica", "quickened by the herb"]}, {"entity_id": "spirit", "book_id": "kosmos_humboldt_1845", "name": "spirit", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["spirit"], "contexts": ["wearied by external influences"]}, {"entity_id": "espiritus", "book_id": "historia_medicinal_monardes_1574", "name": "espiritus", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["espiritus"], "contexts": ["bodily essence Ambar can improve"]}, {"entity_id": "espiritos", "book_id": "polyanthea_medicinal", "name": "espiritos", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 88, "variants": ["espiritos", "espirito", "espirito animaes", "espiritos animues", "espiritos azedos", "espiritos dos gãos lenfitivos", "espiritos flatuosos", "espiritos naturaes", "espiritos vitaes", "espiritos vitais", "espiritos volateis", "espiritosanimaes", "espíritos", "eſpiritos", "fpiritus", "spirits"], "contexts": ["spirits", "vital forces, affected by disease"]}, {"entity_id": "spirits_vitales", "book_id": "polyanthea_medicinal", "name": "spirits vitales", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["spirits vitales"], "contexts": ["bodily vital spirits"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Spirits", "target_book": "kosmos_humboldt_1845", "target_name": "spirit", "similarity": 0.957}, {"source_book": "english_physician_1652", "source_name": "Spirits", "target_book": "historia_medicinal_monardes_1574", "target_name": "espiritus", "similarity": 0.975}, {"source_book": "english_physician_1652", "source_name": "Spirits", "target_book": "polyanthea_medicinal", "target_name": "espiritos", "similarity": 0.975}, {"source_book": "english_physician_1652", "source_name": "Spirits", "target_book": "polyanthea_medicinal", "target_name": "spirits vitales", "similarity": 0.925}, {"source_book": "kosmos_humboldt_1845", "source_name": "spirit", "target_book": "historia_medicinal_monardes_1574", "target_name": "espiritus", "similarity": 0.951}, {"source_book": "kosmos_humboldt_1845", "source_name": "spirit", "target_book": "polyanthea_medicinal", "target_name": "espiritos", "similarity": 0.952}, {"source_book": "kosmos_humboldt_1845", "source_name": "spirit", "target_book": "polyanthea_medicinal", "target_name": "spirits vitales", "similarity": 0.904}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "espiritus", "target_book": "polyanthea_medicinal", "target_name": "espiritos", "similarity": 0.98}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "espiritus", "target_book": "polyanthea_medicinal", "target_name": "spirits vitales", "similarity": 0.922}], "id": 215, "stable_key": "clu_4e2fd8a5d49d1eb3", "ground_truth": {"modern_name": "Vital spirits", "confidence": "high", "type": "concept", "description": "In humoral theory, the animating essence of the body, responsible for life and function.", "note": "This refers to the ancient and medieval concept of vital spirits, a fundamental part of humoral medicine, distinct from modern understanding of biological processes.", "wikipedia_extract": "Vitalism is an idea that living organisms are differentiated from the non-living by the presence of forces, properties or powers including those which may not be physical  or chemical. Varied forms of vitalist theories were held in former times and they are now considered pseudoscientific concepts. Where vitalism explicitly invokes a vital principle, that element is often referred to as the \"vital spark\", \"energy\", \"élan vital\" (coined by vitalist Henri Bergson), \"vital force\", or \"vis vitalis\", which some equate with the soul. In the 18th and 19th centuries, vitalism was discussed among biologists, between those belonging to the mechanistic school who felt that the known mechanics of physics would eventually explain the difference between life and non-life and vitalists who argued that the processes of life could not be reduced to a mechanistic process. Vitalist biologists such as Johannes Reinke proposed testable hypotheses meant to show inadequacies with mechanistic explanations, but their experiments failed to provide support for vitalism. Biologists now consider vitalism in this sense to have been refuted by empirical evidence, and hence regard it either as a superseded scientific theory, or as a pseudoscience since the mid-20th century."}, "cross_references": [{"found_name": "Oyl of Spike", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "english_physician_1652", "evidence_snippet": "the hot and subtil spirits wherewith it is possessed. The Chimical Oyl drawn from Lavender, u∣sually called Oyl of Spike, is of so fierce and piercing Spirits that it is cautiously to be used: some fe", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for Chimical Oyl drawn from Lavender"}, {"found_name": "Sugar of Roses", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "english_physician_1652", "evidence_snippet": "a very good Preservative in the time of In∣fection. The dry Conserve which is called Sugar of Roses, is a very good Cordial to strenthen the Heart and Spirits; as also to stay Defluxions. The Syrup of", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for dry Conserve"}]}, {"canonical_name": "Malabar", "category": "PLACE", "subcategory": "REGION", "book_count": 4, "total_mentions": 106, "members": [{"entity_id": "malabar", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Malabar", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Malabar"], "contexts": ["coastal region where observations were made"]}, {"entity_id": "malabar", "book_id": "kosmos_humboldt_1845", "name": "Malabar", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Malabar"], "contexts": ["location for monsoon naming"]}, {"entity_id": "malabar", "book_id": "coloquios_da_orta_1563", "name": "Malabar", "category": "PLACE", "subcategory": "REGION", "count": 103, "variants": ["Malabar", "Malavar", "malabar", "malavar"], "contexts": ["language", "region where Diogo Pereira was knowledgeable"]}, {"entity_id": "malabar", "book_id": "ricettario_fiorentino_1597", "name": "Malabar", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Malabar"], "contexts": ["region where cinnamon grows"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Malabar", "target_book": "kosmos_humboldt_1845", "target_name": "Malabar", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Malabar", "target_book": "coloquios_da_orta_1563", "target_name": "Malabar", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Malabar", "target_book": "ricettario_fiorentino_1597", "target_name": "Malabar", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Malabar", "target_book": "coloquios_da_orta_1563", "target_name": "Malabar", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Malabar", "target_book": "ricettario_fiorentino_1597", "target_name": "Malabar", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Malabar", "target_book": "ricettario_fiorentino_1597", "target_name": "Malabar", "similarity": 1.0}], "id": 216, "stable_key": "clu_ffdede99a6161387-2", "ground_truth": {"modern_name": "Malabar Coast", "confidence": "high", "type": "place", "description": "Region in southwestern India.", "wikipedia_extract": "The Malabar Coast (Malayalam: [mɐlɐbaːr]) is the southwestern region of the Indian subcontinent. It generally refers to the western coastline of India stretching from Konkan to Kanyakumari. Geographically, it comprises one of the wettest regions of the subcontinent, which includes the southern tip of Goa, Kanara region of Karnataka, all of Kerala and Kanyakumari region of Tamil Nadu. Kuttanad, which is the point of the lowest elevation in India, lies on the Malabar Coast. Kuttanad, also known as The Rice Bowl of Kerala, is among the few places in the world where cultivation takes place below sea level. The peak of Anamudi, which is also the point of highest elevation in India outside the Himalayas, lies parallel to the Malabar Coast on the Western Ghats."}, "cross_references": [{"found_name": "East Indies", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 497, "target_cluster_name": "East Indies", "source_book": "llm_generated", "evidence_snippet": "The Malabar Coast is a significant part of the historical region 