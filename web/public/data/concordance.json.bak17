e": "Diamond", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Diamond", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Diamante", "target_book": "polyanthea_medicinal", "target_name": "diamante", "similarity": 0.975}, {"source_book": "coloquios_da_orta_1563", "source_name": "Diamante", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Diamond", "similarity": 0.948}, {"source_book": "polyanthea_medicinal", "source_name": "diamante", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Diamond", "similarity": 0.937}], "id": 239, "stable_key": "clu_01171343e727a108", "ground_truth": {"modern_name": "diamond", "confidence": "high", "type": "mineral", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Diamond", "wikipedia_extract": "Diamond is a solid form of the element carbon with its atoms arranged in a crystal structure called diamond cubic. Diamond is tasteless, odorless, strong, brittle solid, colorless in pure form, a poor conductor of electricity, and insoluble in water. Another solid form of carbon known as graphite is the chemically stable form of carbon at room temperature and pressure, but diamond is metastable and converts to it at a negligible rate under those conditions. Diamond has the highest hardness and thermal conductivity of any natural material, properties that are used in major industrial applications such as cutting and polishing tools. Because the arrangement of atoms in diamond is extremely rigid, few types of impurity can contaminate it (two exceptions are boron and nitrogen). Small numbers of defects or impurities (about one per million of lattice atoms) can color a diamond blue (boron), yellow (nitrogen), brown (defects), green (radiation exposure), purple, pink, orange, or red."}, "member_count": 8, "cross_references": [{"found_name": "Carbon", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 11, "target_cluster_name": "carbon", "source_book": "llm_generated", "evidence_snippet": "Diamond is a solid form of the element carbon.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Diamond is a solid form of the element carbon."}, {"found_name": "Crystal", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 696, "target_cluster_name": "Crystal", "source_book": "llm_generated", "evidence_snippet": "Diamond has a crystal structure.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Diamond has a crystal structure."}, {"found_name": "Amethyst", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2673, "target_cluster_name": "Amethyst", "source_book": "llm_generated", "evidence_snippet": "Both are gemstones.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are gemstones."}, {"found_name": "Emerald", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 107, "target_cluster_name": "esmeralda", "source_book": "llm_generated", "evidence_snippet": "Both are gemstones.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are gemstones."}, {"found_name": "Pedras preciosas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1540, "target_cluster_name": "Pedras preciosas", "source_book": "llm_generated", "evidence_snippet": "Diamond is a precious stone.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Diamond is a precious stone.", "is_reverse": true}]}, {"canonical_name": "Space", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 65, "members": [{"entity_id": "space", "book_id": "origin_of_species_darwin_1859", "name": "space", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["space"], "contexts": ["dimension of exist