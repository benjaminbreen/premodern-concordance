s": [{"entity_id": "biela", "book_id": "kosmos_humboldt_1845", "name": "Biela", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 6, "variants": ["Biela"], "contexts": ["comet with short period of revolution", "comet discoverer"]}, {"entity_id": "biela’s", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Biela’s", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 4, "variants": ["Biela’s"], "contexts": ["comet named after an individual", "a specific comet"]}, {"entity_id": "biela's_comet", "book_id": "kosmos_humboldt_1845", "name": "Biela's comet", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 5, "variants": ["Biela's comet"], "contexts": ["comet with shortening period", "comet with a period of 6 3/4th years"]}, {"entity_id": "biela’s_comets", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Biela’s Comets", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Biela’s Comets"], "contexts": ["a specific comet"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Biela", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Biela’s", "similarity": 0.895}], "id": 2130, "stable_key": "clu_968b34e0fa5a6676", "ground_truth": {"modern_name": "Biela's Comet", "confidence": "medium", "type": "concept", "note": "The cluster contains references to 'Biela' and 'Biela’s', which clearly refer to Biela's Comet. However, it also includes 'Beagle', the ship Darwin sailed on. The strong presence of 'Biela' and the context of celestial objects in Humboldt's 'Kosmos' point to the comet as the primary referent, with 'Beagle' being a misattribution or secondary mention within the texts analyzed.", "wikipedia_extract": "Biela's Comet or Comet Biela (official designation: 3D/Biela) was a periodic Jupiter-family comet first recorded in 1772 by Montaigne and Messier and finally identified as periodic in 1826 by Wilhelm von Biela. It was subsequently observed to split in two and has not been seen since 1852. As a result, it is currently considered to have been destroyed, although remnants have survived for some time as a meteor shower, the Andromedids. The comet was first recorded on 8 March 1772 by Jacques Leibax Montaigne; during the same apparition it was independently discovered by Charles Messier. It was also recorded in 1805 by Jean-Louis Pons, but was not recognized as the same object. Around 9 December 1805 comet Biela passed about 0.0366 AU (5.48 million km) from Earth."}, "member_count": 4, "cross_references": [{"found_name": "meteoric stones", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1783, "target_cluster_name": "meteoric stones", "source_book": "kosmos_humboldt_1845", "evidence_snippet": "on of comets. Passage through the system of Jupiter's satellites. Comets of short periods of revolution, more correctly termed inner comets (Encke, Biela, Faye) -- p. 107 and note. Revolving aerolites", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for"}, {"found_name": "Encke’s comet", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 899, "target_cluster_name": "Encke’s comet", "source_book": "llm_generated", "evidence_snippet": "Biela's Comet is another comet that experienced fragmentation, a phenomenon of interest in cometary studies.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Biela's Comet is another comet that experienced fragmentation, a phenomenon of interest in cometary studies.", "is_reverse": true}, {"found_name": "Comet of 1770", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2842, "target_cluster_name": "comet of 1770", "source_book": "llm_generated", "evidence_snippet": "Biela's Comet was first recorded in 1772 by Montaigne and Messier, and the Comet of 1770 is a contemporary celestial object that might have been confused with or related to early observations of Biela's Comet.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Biela's Comet was first recorded in 1772 by Montaigne and Messier, and the Comet of 1770 is a contemporary celestial object that might have been confused with or related to early observations of Biela's Comet."}, {"found_name": "comet", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 291, "target_cluster_name": "comet", "source_book": "llm_generated", "evidence_snippet": "Biela's Comet is a specific instance of a comet.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Biela's Comet is a specific instance of a comet."}, {"found_name": "celestial bodies", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1950, "target_cluster_name": "heavenly bodies", "source_book": "llm_generated", "evidence_snippet": "Biela's Comet is a type of celestial body.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Biela's Comet is a type of celestial body."}, {"found_name": "Encke's Comet", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 899, "target_cluster_name": "Encke’s comet", "source_book": "llm_generated", "evidence_snippet": "Encke's Comet is another periodic comet, and historical texts might compare or contrast different comets.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Encke's Comet is another periodic comet, and historical texts might compare or contrast different comets."}, {"found_name": "Halley's Comet", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1724, "target_cluster_name": "Halley’s comet", "source_book": "llm_generated", "evidence_snippet": "Halley's Comet is another famous periodic comet, and historical discussions of comets would likely include comparisons or mentions of other notable comets.", "confidence": 0.85, "auto_label": "llm_related", "found_relations