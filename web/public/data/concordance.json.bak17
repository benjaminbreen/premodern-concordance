bcategory": "OTHER_SUBSTANCE", "count": 15, "variants": ["manna", "MANNA", "Manna", "Manna Calaurefe", "Manna Calaurese", "Manna d'mcenfo", "Manna dVncenfa", "Manna di corpo", "manna d'inccnfo"], "contexts": ["substance with two species", "substance distilled from trees"]}, {"entity_id": "mannà", "book_id": "polyanthea_medicinal", "name": "mannà", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 9, "variants": ["mannà", "Mannà", "Manná", "manná"], "contexts": ["substance used in preparation", "purgative substance"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "manná", "target_book": "ricettario_fiorentino_1597", "target_name": "manna", "similarity": 0.743}, {"source_book": "coloquios_da_orta_1563", "source_name": "manná", "target_book": "polyanthea_medicinal", "target_name": "mannà", "similarity": 0.684}, {"source_book": "coloquios_da_orta_1563", "source_name": "manna", "target_book": "ricettario_fiorentino_1597", "target_name": "manna", "similarity": 0.8}, {"source_book": "coloquios_da_orta_1563", "source_name": "manna", "target_book": "polyanthea_medicinal", "target_name": "mannà", "similarity": 0.808}, {"source_book": "ricettario_fiorentino_1597", "source_name": "manna", "target_book": "polyanthea_medicinal", "target_name": "mannà", "similarity": 0.61}], "id": 635, "stable_key": "clu_ac04cb086d63b540", "ground_truth": {"modern_name": "manna", "confidence": "high", "type": "substance", "description": "A sweet, exudate substance from certain trees or plants.", "wikipedia_extract": "Manna (Hebrew: מָן, romanized: mān, Greek: μάννα; Arabic: اَلْمَنُّ), sometimes or archaically spelled mana, is described in the Bible and the Quran as an edible substance that God bestowed upon the Israelites while they were wandering the desert during the 40-year period that followed the Exodus and preceded the conquest of Canaan. In the Hebrew Bible, manna is described twice: once in Exodus 16:1–36 with the full narrative surrounding it, and once again in Numbers 11:1–9 as a part of a separate narrative. In the description in the Book of Exodus, manna is described as being \"a fine, flake-like thing\" like the frost on the ground. It is described in the Book of Numbers as arriving with the dew during the night. Exodus adds that it had to be collected before it was melted by the heat of the Sun, and that it was like a coriander seed in size, but white in colour. Numbers describes it as having the appearance of bdellium, adding that the Israelites ground it and pounded it into cakes, which were then baked, resulting in something that tasted like cakes baked with oil."}, "cross_references": [{"found_name": "Nectar", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2368, "target_cluster_name": "Nectar", "source_book": "llm_generated", "evidence_snippet": "Nectar is often described as a divine food or drink, similar to manna, which was a miraculous food provided by God.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Nectar is often described as a divine food or drink, similar to manna, which was a miraculous food provided by God."}, {"found_name": "maçãas", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "destoutras maçãas me dizey o nome e o arvore e em que terras as ha e se sam maçãas de anáfega. ORTA O nome em canarym he ftor, e no Decam ber, e os Ma- laios as chamão pidards, e são milhores que esta", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym"}, {"found_name": "maçãas de anáfega", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "destoutras maçãas me dizey o nome e o arvore e em que terras as ha e se sam maçãas de anáfega. ORTA O nome em canarym he ftor, e no Decam ber, e os Ma-