"target_cluster_name": "Musa", "source_book": "llm_generated", "evidence_snippet": "Both are major religious figures who received divine guidance and led their followers. Moses received the Ten Commandments, and Francis of Assisi founded a major religious order, both representing significant spiritual leadership.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are major religious figures who received divine guidance and led their followers. Moses received the Ten Commandments, and Francis of Assisi founded a major religious order, both representing significant spiritual leadership."}]}, {"canonical_name": "Flandres", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "flandres", "book_id": "coloquios_da_orta_1563", "name": "Flandres", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Flandres"], "contexts": ["location of Portuguese trading posts", "location where rabô pepper was sent"]}, {"entity_id": "flandres", "book_id": "polyanthea_medicinal", "name": "Flandres", "category": "PLACE", "subcategory": "COUNTRY", "count": 3, "variants": ["Flandres", "Flandes"], "contexts": ["region mentioned with hair entanglement", "region governed"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Flandres", "target_book": "polyanthea_medicinal", "target_name": "Flandres", "similarity": 0.929}], "id": 2622, "stable_key": "clu_cac026542a8e1d6b", "ground_truth": {"modern_name": "Flanders", "confidence": "high", "type": "place", "country": "Belgium, France, Netherlands", "wikidata_id": "", "wikidata_description": "family name"}, "cross_references": [{"found_name": "Hollande", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 127, "target_cluster_name": "Hollande", "source_book": "llm_generated", "evidence_snippet": "Flanders was historically a region closely associated with and often politically linked to the Netherlands.", 