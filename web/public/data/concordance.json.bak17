, "variants": ["calculation"], "contexts": ["mathematical process for finding values", "Clairaut's, error pointed out"]}, {"entity_id": "calculations", "book_id": "first_principles_spencer_1862", "name": "calculations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["calculations"], "contexts": ["mathematical computations"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "calculation", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "calculation", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "calculation", "target_book": "first_principles_spencer_1862", "target_name": "calculations", "similarity": 0.947}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "calculation", "target_book": "first_principles_spencer_1862", "target_name": "calculations", "similarity": 0.947}], "id": 1380, "stable_key": "clu_2a48c37c69cd54a2", "ground_truth": {"modern_name": "Calculation", "confidence": "high", "type": "concept", "wikidata_id": "Q622821", "wikidata_description": "deliberate process that transforms inputs to outputs with variable change", "wikipedia_url": "https://en.wikipedia.org/wiki/Calculation", "wikipedia_extract": "A calculation is a deliberate mathematical process that transforms a plurality of inputs into a singular or plurality of outputs, known also as a result or results. The term is used in a variety of senses, from the very definite arithmetical calculation of using an algorithm, to the vague heuristics of calculating a strategy in a competition, or calculating the chance of a successful relationship between two people. For example, multiplying 7 by 6 is a simple algorithmic calculation. Extracting the square root or the cube root of a number using mathematical models is a more complex algorithmic calculation. Statistical estimations of the likely election results from opinion polls also involve algorithmic calculations, but produces ranges of possibilities rather than exact answers. To calculate means to determine mathematically in the case of a number or amount, or in the case of an abstract problem to deduce the answer using logic, reason or common sense."}, "cross_references": [{"found_name": "Arithmetica", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1207, "target_cluster_name": "Arithmetica", "source_book": "llm_generated", "evidence_snippet": "Arithmetic is a fundamental branch of mathematics concerned with calculation.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: Arithmetic is a fundamental branch of mathematics concerned with calculation.", "is_reverse": true}, {"found_name": "mathematics", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 161, "target_cluster_name": "mathematics", "source_book": "llm_generated", "evidence_snippet": "Calculation is the process of computing or determining a numerical result, a core activity within mathematics.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Calculation is the process of computing or determining a numerical result, a core activity within mathematics.", "is_reverse": true}, {"found_name": "empirical", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2995, "target_cluster_name": "empirical", "source_book": "llm_generated", "evidence_snippet": "Calculation is a fundamental tool in science.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Calculation is a fundamental tool in science.", "is_reverse": true}, {"found_name": "cognition", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 656, "target_cluster_name": "cognition", "source_book": "llm_generated", "evidence_snippet": "Calculation is a specific cognitive process involving the manipulation of numbers and symbols, directly falling under the umbrella of cognitive 