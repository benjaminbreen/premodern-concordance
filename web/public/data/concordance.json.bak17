 social standing."}, "cross_references": []}, {"canonical_name": "Eſcamonca", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "eſcamonca", "book_id": "historia_medicinal_monardes_1574", "name": "Eſcamonca", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Eſcamonca"], "contexts": ["plant with a leaf like Mechoacan"]}, {"entity_id": "eſcamonea", "book_id": "polyanthea_medicinal", "name": "Eſcamonea", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Eſcamonea"], "contexts": ["potent purgative herb"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Eſcamonca", "target_book": "polyanthea_medicinal", "target_name": "Eſcamonea", "similarity": 0.927}], "id": 4430, "stable_key": "clu_b4a1311ad4767211", "ground_truth": {"modern_name": "Jalap", "confidence": "high", "type": "plant", "linnaean": "Ipomoea purga Benth.", "family": "Convolvulaceae", "note": "The description 'leaf like Mechoacan' and 'potent purgative herb' strongly points to Jalap, often confused with Mechoacan (another purgative plant from the same genus). Escamonea is an older or variant name for jalap."}, "cross_references": []}, {"canonical_name": "cordial", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "cordial", "book_id": "historia_medicinal_monardes_1574", "name": "cordial", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["cordial"], "contexts": ["substance that strengthens the heart"]}, {"entity_id": "cordial", "book_id": "coloquios_da_orta_1563", "name": "cordial", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["cordial"], "contexts": ["medicinal property of sandalwood"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "cordial", "target_book": "coloquios_da_orta_1563", "target_name": 