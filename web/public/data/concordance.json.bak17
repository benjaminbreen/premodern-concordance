get_cluster_id": 1952, "target_cluster_name": "Circular polarization", "source_book": "llm_generated", "evidence_snippet": "Circular polarization is a specific type of polarization of light, directly related to the broader concept.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Circular polarization is a specific type of polarization of light, directly related to the broader concept."}]}, {"canonical_name": "Sidereal System", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "sidereal_systems", "book_id": "kosmos_humboldt_1845", "name": "Sidereal systems", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Sidereal systems"], "contexts": ["astronomical systems"]}, {"entity_id": "sidereal_system", "book_id": "first_principles_spencer_1862", "name": "Sidereal System", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Sidereal System", "sidereal system"], "contexts": ["system of stars", "system of stars and galaxies"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Sidereal systems", "target_book": "first_principles_spencer_1862", "target_name": "Sidereal System", "similarity": 0.966}], "id": 2855, "stable_key": "clu_65fdcbe736120cf6", "ground_truth": {"modern_name": "Stellar system", "confidence": "high", "type": "place", "note": "Refers to a group of stars, such as galaxies or star clusters.", "wikidata_id": "Q68651525", "wikidata_description": "scholarly article", "wikipedia_extract": "Sidereus Nuncius (usually Sidereal Messenger, also Starry Messenger or Sidereal Message) is a short astronomical treatise (or pamphlet) published in Neo-Latin by Galileo Galilei on March 13, 1610. It was the first published scientific work based on observations made through a telescope, and it contains the results of Galileo's early observations of the imperfect and mountainous Moon, of hundreds of stars not visible to the naked eye in the Milky Way and in certain constellations, and of the Medicean Stars (Galilean moons) that appeared to be circling Jupiter. The Latin word nuncius was typically used during this time period to denote messenger; however, it was also (though less frequently) rendered as message. Though the title Sidereus Nuncius is usually translated into English as Sidereal Messenger, many of Galileo's early drafts of the book and later related writings indicate that the intended purpose of the book was \"simply to report the news about recent developments in astronomy, not to pass himself off solemnly as an ambassador from heaven.\" The first telescopes appeared in the Netherlands in 1608, when Middelburg spectacle-maker Hans Lippershey tried to obtain a patent on one. By 1609 Galileo had learned of this and built his own improved version. He was not the first person to aim the new invention at the night sky but his was the first published study of celestial bodies using one.", "wikipedia_url": "https://en.wikipedia.org/wiki/Sidereus_Nuncius"}, "cross_references": []}, {"canonical_name": "Coca", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "coca", "book_id": "historia_medicinal_monardes_1574", "name": "Coca", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Coca"], "contexts": ["ellos laman.Coca ¡laqual fiema", "plant leaves chewed by Indians"]}, {"entity_id": "coca'", "book_id": "ricettario_fiorentino_1597", "name": "Coca'", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Coca'"], "contexts": ["plant used in a preparation"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Coca", "target_book": "ricettario_fiorentino_1597", "target_name": "Coca'", "similarity": 0.978}], "id": 2856, "stable_key": "clu_8ae22ab420b50b72", "ground_truth": {"modern_name": "Coca", "confidence": "high", "type": "plant", "linnaean": "