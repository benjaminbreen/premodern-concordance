ntions": 2, "members": [{"entity_id": "vinagre_eſquilitico", "book_id": "historia_medicinal_monardes_1574", "name": "vinagre Eſquilitico", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["vinagre Eſquilitico"], "contexts": ["squill vinegar"]}, {"entity_id": "vinagre_efquilitico", "book_id": "polyanthea_medicinal", "name": "vinagre efquilitico", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["vinagre efquilitico"], "contexts": ["vinegar used in remedy"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "vinagre Eſquilitico", "target_book": "polyanthea_medicinal", "target_name": "vinagre efquilitico", "similarity": 0.94}], "id": 4433, "stable_key": "clu_3bcee425371bc553", "ground_truth": {"modern_name": "Squill vinegar", "confidence": "high", "type": "preparation", "note": "Vinegar infused with squill, a medicinal plant."}, "cross_references": [{"found_name": "aceto", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1565, "target_cluster_name": "aceto", "source_book": "llm_generated", "evidence_snippet": "A specific type of vinegar.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: A specific type of vinegar.", "is_reverse": true}]}, {"canonical_name": "pulso desordenado", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "pulso_desordenado", "book_id": "historia_medicinal_monardes_1574", "name": "pulso desordenado", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["pulso desordenado"], "contexts": ["disordered pulse"]}, {"entity_id": "accelerated_pulse", "book_id": "first_principles_spencer_1862", "name": "accelerated pulse", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["accelerated pulse"], "contexts": ["rapid heartbeat"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "pulso desordenado", "target_book": "first_principles_spencer_1862", "target_name": "accelerated pulse", "similarity": 0.907}], "id": 4434, "stable_key": "clu_217c516f74f81300", "ground_truth": {"modern_name": "Pulse", "confidence": "high", "type": "disease", "description": "Rhythmic expansion and contraction of arteries, indicative of health or illness.", "note": "Refers to the physical symptom of pulse, and its variations.", "wikipedia_extract": "In medicine, pulse is the rhythmic expansion and contraction of an artery in response to the cardiac cycle (heartbeat). The pulse may be felt (palpated) in any place that allows an artery to be compressed near the surface of the body, such as at the neck (carotid artery), wrist (radial artery or ulnar artery), at the groin (femoral artery), behind the knee (popliteal artery), near the ankle joint (posterior tibial artery), and on foot (dorsalis pedis artery). The pulse is most commonly measured at the wrist or neck for adults and at the brachial artery (inner upper arm between the shoulder and elbow) for infants and very young children. A sphygmograph is an instrument for measuring the pulse. Claudius Galen was perhaps the first physiologist to describe the pulse. The pulse is an expedient tactile method of determination of systolic blood pressure to a trained observer."}, "cross_references": []}, {"canonical_name": "remedios que den calor", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "remedios_que_den_calor", "book_id": "historia_medicinal_monardes_1574", "name": "remedios que den calor", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["remedios que den calor"], "contexts": ["remedies that give heat"]}, {"entity_id": "remedios_quentes", "book_id": "polyanthea_medicinal", "name": "remedios quentes", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["remedios quentes"], "contexts": ["hot medicinal substances"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "remedios que den calor", "target_book": "polyanthea_medicinal", "target_name": "remedios quentes", "similarity": 0.936}], "id": 4435, "stable_key": "clu_4152ef168178304c", "ground_truth": {"modern_name": "Therapeutic heat", "confidence": "high", "type": "concept", "note": "Refers to the concept of medicines having warming properties within the humoral system.", "wikidata_id": "Q39870405", "wikidata_description": "scientific article published on March 1974", "wikipedia_extract": "A psychoactive drug, psychopharmaceutical, mind-altering drug, consciousness-altering drug, psychoactive substance, or psychotropic substance is a chemical substance that alters psychological functioning by modulating central nervous system (CNS) activity. Psychoactive and psychotropic drugs both affect the brain, with psychotropics sometimes referring to psychiatric drugs or high-abuse substances, while “drug” can have negative connotations. Novel psychoactive substances are designer drugs made to mimic illegal ones and bypass laws. Psychoactive drug use dates back to prehistory for medicinal and consciousness-altering purposes, with evidence of widespread cultural use. Many animals intentionally consume psychoactive substances, and some traditional legends suggest animals first introduced humans to their use. Psychoactive substances are used across cultures for purposes ranging from medicinal and therapeutic treatment of mental disorders and pain, to performance enhancement.", "wikipedia_url": "https://en.wikipedia.org/wiki/Psychoactive_drug"}, "cross_references": []}, {"canonical_name": "Andromacho", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "andromacho", "book_id": "historia_medicinal_monardes_1574", "name": "Andromacho", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Andromacho"], "contexts": ["author of Theriaca"]}, {"entity_id": "andromaco", "book_id": "ricettario_fiorentino_1597", "name": "Andromaco", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Andromaco"], "contexts": ["ancient medical authority"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Andromacho", "target_book": "ricettario_fiorentino_1597", "target_name": "Andromaco", "similarity": 0.882}], "id": 4436, "stable_key": "clu_c3927d8b27af9967", "ground_truth": {"modern_name": "Andromachus the Elder", "confidence": "high", "type": "person", "description": "Ancient physician, author of Theriaca, medical authority", "wikidata_id": "Q891741", "wikidata_description": "Greek physician of the 1st century"}, "cross_references": []}, {"canonical_name": "dominus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "dominus", "book_id": "historia_medicinal_monardes_1574", "name": "dominus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["dominus"], "contexts": ["Hebrew word for lord"]}, {"entity_id": "dominus", "book_id": "coloquios_da_orta_1563", "name": "dominus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["dominus"], "contexts": ["Latin for lord"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "dominus", "target_book": "coloquios_da_orta_1563", "target_name": "dominus", "similarity": 1.0}], "id": 4437, "stable_key": "clu_0f7f2fea13a157bb", "ground_truth": {"modern_name": "Lord", "confidence": "high", "type": "concept", "note": "The contexts indicate it's a translation or a term of respect in different languages, not a specific scientific or medical concept.", "wikidata_id": "", "wikidata_description": "family name"}, "cross_references": []}, {"canonical_name": "Bocara", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "bocara", "book_id": "historia_medicinal_monardes_1574", "name": "Bocara", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Bocara"], "contexts": ["city of Avi's origin"]}, {"entity_id": "bokara", "book_id": "coloquios_da_orta_1563", "name": "Bokara", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Bokara"], "contexts": ["principal city of Uzbeks"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Bocara", "target_book": "coloquios_da_orta_1563", "target_name": "Bokara", "similarity": 0.89}], "id": 4438, "stable_key": "clu_d43970301f0c827c", "ground_truth": {"modern_name": "Bukhara", "confidence": "high", "type": "place", "country": "Uzbekistan", "wikidata_id": "Q5764", "wikidata_description": "city in Bukhara Province of Uzbekistan"}, "cross_references": [{"found_name": "Bokhara", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 968, "target_cluster_name": "Bokhara", "source_book": "llm_generated", "evidence_snippet": "Bokhara is listed as a historical name for Bukhara.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Bokhara is listed as a historical name for Bukhara."}]}, {"canonical_name": "Melue", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "melue", "book_id": "historia_medicinal_monardes_1574", "name": "Melue", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Melue"], "contexts": ["author of antidotes"]}, {"entity_id": "meluè", "book_id": "ricettario_fiorentino_1597", "name": "Meluè", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Meluè"], "contexts": ["Medieval medical authority"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Melue", "target_book": "ricettario_fiorentino_1597", "target_name": "Meluè", "similarity": 0.684}], "id": 4439, "stable_key": "clu_ed1451a5fc5d3b8d", "ground_truth": {"modern_name": "Melue", "confidence": "high", "type": "person", "description": "Medieval medical authority cited by Monardes"}, "cross_references": [{"found_name": "Mesue", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 244, "target_cluster_name": "Mesue", "source_book": "llm_generated", "evidence_snippet": "Melue is a variant spelling or transliteration of Mesue the Younger's name, appearing in some historical sources.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: Melue is a variant spelling or transliteration of Mesue the Younger's name, appearing in some historical sources.", "is_reverse": true}, {"found_name": "Mefue", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1957, "target_cluster_name": "Mefue", "source_book": "llm_generated", "evidence_snippet": "Likely a variant spelling or transcription of the same name.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Likely a variant spelling or transcription of the same name.", "is_reverse": true}]}, {"canonical_name": "paroxismo", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "paroxismo", "book_id": "historia_medicinal_monardes_1574", "name": "paroxismo", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["paroxismo"], "contexts": ["sudden onset of disease symptoms"]}, {"entity_id": "paroxismum", "book_id": "polyanthea_medicinal", "name": "paroxismum", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["paroxismum"], "contexts": ["paroxysm of illness"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "paroxismo", "target_book": "polyanthea_medicinal", "target_name": "paroxismum", "similarity": 0.909}], "id": 4440, "stable_key": "clu_9cecb55c7344f275", "ground_truth": {"modern_name": "Paroxysm", "confidence": "high", "type": "disease", "modern_term": "Paroxysm", "wikidata_id": "Q1479494", "wikidata_description": "disease of the blood characterized by destruction of red blood cells by the complement system, a part of the body's innate immune system", "wikipedia_url": "https://en.wikipedia.org/wiki/Paroxysmal%20nocturnal%20hemoglobinuria", "wikipedia_extract": "Paroxysmal nocturnal hemoglobinuria (PNH) is a rare, acquired, life-threatening disease of the blood characterized by destruction of red blood cells by the complement system, a part of the body's innate immune system. This destructive process occurs due to deficiency of the red blood cell surface protein DAF, which normally inhibits such immune reactions. Since the complement cascade attacks the red blood cells within the blood vessels of the circulatory system, the red blood cell destruction (hemolysis) is considered an intravascular hemolytic anemia. There is ongoing research into other key features of the disease, such as the high incidence of venous blood clot formation. Research suggests that PNH thrombosis (a blood clot) is caused by both the absence of GPI-anchored complement regulatory proteins (CD55 and CD59) on PNH platelets and the excessive consumption of nitric oxide (NO). PNH is the only hemolytic anemia caused by an acquired (rather than inherited) intrinsic defect in the cell membrane (deficiency of glycophosphatidylinositol or GPI) leading to the absence of protective exterior surface proteins that normally attach via a GPI anchor."}, "cross_references": []}, {"canonical_name": "naoVictoria", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "naovictoria", "book_id": "historia_medicinal_monardes_1574", "name": "naoVictoria", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["naoVictoria"], "contexts": ["The ship Victoria, circumnavigated the world"]}, {"entity_id": "nau_victoria", "book_id": "coloquios_da_orta_1563", "name": "nau Victoria", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["nau Victoria"], "contexts": ["Ship that returned from voyage"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "naoVictoria", "target_book": "coloquios_da_orta_1563", "target_name": "nau Victoria", "similarity": 0.89}], "id": 4441, "stable_key": "clu_b388fadab3cee03b", "ground_truth": {"modern_name": "Victoria (ship)", "confidence": "high", "type": "object", "wikidata_id": "Q86573224", "wikidata_description": "researcher"}, "cross_references": []}, {"canonical_name": "Herculano", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "herculano", "book_id": "historia_medicinal_monardes_1574", "name": "Herculano", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Herculano"], "contexts": ["authority on vomiting and iron"]}, {"entity_id": "herculano", "book_id": "coloquios_da_orta_1563", "name": "Herculano", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Herculano"], "contexts": ["published historical documents"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Herculano", "target_book": "coloquios_da_orta_1563", "target_name": "Herculano", "similarity": 0.689}], "id": 4442, "stable_key": "clu_d7781f7e657ae787", "ground_truth": {"modern_name": "Herculano", "confidence": "high", "type": "person", "description": "Medical authority on vomiting and iron", "wikidata_id": "", "wikidata_description": "family name"}, "cross_references": []}, {"canonical_name": "Coliget", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "coliget", "book_id": "historia_medicinal_monardes_1574", "name": "Coliget", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Coliget"], "contexts": ["a work by A