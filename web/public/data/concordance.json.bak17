gth": 0.5, "target_cluster_id": 2378, "target_cluster_name": "quadersandstein", "source_book": "llm_generated", "evidence_snippet": "Quadersandstein is a German term for a type of sandstone, specifically 'Keuper sandstone' or 'New Red Sandstone' in English geological terminology. The term 'New Red Sandstone' is a broad classification that includes Quadersandstein.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Quadersandstein is a German term for a type of sandstone, specifically 'Keuper sandstone' or 'New Red Sandstone' in English geological terminology. The term 'New Red Sandstone' is a broad classification that includes Quadersandstein.", "is_reverse": true}]}, {"canonical_name": "Central America", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "central_america", "book_id": "origin_of_species_darwin_1859", "name": "Central America", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Central America"], "contexts": ["region with distinct marine faunas"]}, {"entity_id": "central_america", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Central America", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Central America"], "contexts": ["region with monsoons"]}, {"entity_id": "central_america", "book_id": "first_principles_spencer_1862", "name": "Central America", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Central America"], "contexts": ["geographical region", "geographic region undergoing subsidence"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Central America", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Central America", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Central America", "target_book": "first_principles_spencer_1862", "target_name": "Central America", "similarit