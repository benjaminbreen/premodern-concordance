nglish monarch"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Henry the third", "target_book": "coloquios_da_orta_1563", "target_name": "Henrique III, de Inglaterra", "similarity": 0.864}], "id": 3874, "stable_key": "clu_2080186ed81a85e4", "ground_truth": {"modern_name": "Henry III of England", "confidence": "high", "type": "person", "birth_year": 1207, "death_year": 1272, "description": "King of England who received an elephant.", "wikidata_id": "Q160311", "wikidata_description": "King of England from 1216 to 1272"}, "cross_references": []}, {"canonical_name": "Emanuel", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "emanuel", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Emanuel", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Emanuel"], "contexts": ["of Portugal, sent an elephant"]}, {"entity_id": "emanuel", "book_id": "coloquios_da_orta_1563", "name": "Emanuel", "category": "PERSON", "subcategory": "PATRON", "count": 1, "variants": ["Emanuel"], "contexts": ["king whose chronicle was published"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Emanuel", "target_book": "coloquios_da_orta_1563", "target_name": "Emanuel", "similarity": 1.0}], "id": 3875, "stable_key": "clu_fab955094869351f", "ground_truth": {"modern_name": "Manuel I of Portugal", "confidence": "high", "type": "person", "birth_year": 1469, "death_year": 1521, "description": "King of Portugal who sent an elephant; his chronicle was published.", "note": "The text refers to 'Emanuel' of Portugal and a king whose chronicle was published. Manuel I fits both descriptions and was a prominent ruler in the period.", "wikidata_id": "Q191231", "wikidata_description": "King of Portugal from 1495 to 1521", "wikipedia_url": "https://en.wikipedia.org/wiki/Manuel%20I%20of%20Portugal", "wikipedia_extract": "Manuel I (European Portuguese: [mɐnuˈɛl]; 31 May 1469 – 13 December 1521), known as the Fortunate (Portuguese: O Venturoso), was King of Portugal from 1495 to 1521. A member of the House of Aviz, Manuel was Duke of Beja and Viseu prior to succeeding his cousin, John II of Portugal, as monarch. Manuel ruled over a period of intensive expansion of the Portuguese Empire owing to the numerous Portuguese discoveries made during his reign. His sponsorship of Vasco da Gama led to the Portuguese discovery of the sea route to India in 1498, resulting in the creation of the Portuguese India Armadas, which guaranteed Portugal's monopoly on the spice trade. Manuel began the Portuguese colonization of the Americas and Portuguese India, and oversaw the establishment of a vast trade empire across Africa and Asia. Manuel established the Casa da Índia, a royal institution that managed Portugal's monopolies and its imperial expansion."}, "cross_references": [{"found_name": "D. Pedro Antonio de Noronha", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1856, "target_cluster_name": "D. Pedro Antonio de Noronha", "source_book": "llm_generated", "evidence_snippet": "D. Pedro Antonio de Noronha was a prominent figure during the reign of Manuel I of Portugal.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: D. Pedro Antonio de Noronha was a prominent figure during the reign of Manuel I of Portugal.", "is_reverse": true}, {"found_name": "Rey de Portugal", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2078, "target_cluster_name": "Rey de Portugal", "source_book": "llm_generated", "evidence_snippet": "Manuel I was a King of Portugal, a specific instance of the entity 'King of Portugal'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Manuel I was a King of Portugal, a specific instance of the entity 'King of Portugal'.", "is_reverse": true}]}, {"canonical_name": "clavicles", "category": "SUBSTANCE", "subc