s_1574", "name": "vino caliente", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["vino caliente"], "contexts": ["with hot wine cures obstructions", "taken with hot wine"]}, {"entity_id": "vinho_muyto_quente", "book_id": "polyanthea_medicinal", "name": "vinho muyto quente", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["vinho muyto quente"], "contexts": ["hot wine for foot bath"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "vino caliente", "target_book": "polyanthea_medicinal", "target_name": "vinho muyto quente", "similarity": 0.952}], "id": 3683, "stable_key": "clu_520da411966c300f", "ground_truth": {"modern_name": "Hot wine", "confidence": "high", "type": "concept", "note": "This refers to wine that has been heated, often with spices, for medicinal or therapeutic purposes, as suggested by its use in cures and foot baths.", "wikidata_id": "Q6584", "wikidata_description": "red wine along with various spices and perhaps fruit or raisins", "wikipedia_url": "https://en.wikipedia.org/wiki/Mulled_wine", "wikipedia_extract": "Mead (, MEED), also called honey wine, and hydromel (particularly when low in alcohol content), is an alcoholic beverage made by fermenting honey mixed with water, and sometimes with added ingredients such as fruits, spices, grains, or hops. The alcoholic content ranges from about 3.5% ABV to more than 20%. Possibly the most ancient alcoholic drink, the defining characteristic of mead is that the majority of the beverage's fermentable sugar is derived from honey. It may be still, carbonated, or naturally sparkling, and despite a common misconception that mead is exclusively sweet, it can also be dry or semi-sweet. Mead that also contains spices is called metheglin (), and mead that contains fruit is called melomel. The term honey wine is sometimes used as a synonym for mead, although wine is typically defined to be the product of fermented grapes or certain other fruits, and some cultures have honey wines that are distinct from mead."}, "cross_references": [{"found_name": "alcohol", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 131, "target_cluster_name": "alcohol", "source_book": "llm_generated", "evidence_snippet": "Hot wine is a beverage that contains alcohol.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Hot wine is a beverage that contains alcohol.", "is_reverse": true}, {"found_name": "licor", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 321, "target_cluster_name": "licor", "source_book": "llm_generated", "evidence_snippet": "Hot wine is a specific preparation of a wine-based beverage.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Hot wine is a specific preparation of a wine-based beverage.", "is_reverse": true}, {"found_name": "vino", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1554, "target_cluster_name": "vino", "source_book": "llm_generated", "evidence_snippet": "Hot wine is a preparation of wine, often spiced, consumed as a beverage.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Hot wine is a preparation of wine, often spiced, consumed as a beverage.", "is_reverse": true}]}, {"canonical_name": "Hermolao Bárbaro", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "hermolao_barbaro", "book_id": "historia_medicinal_monardes_1574", "name": "Hermolao Barbaro", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Hermolao Barbaro"], "contexts": ["learned man who spoke of Anime"]}, {"entity_id": "hermolao_bárbaro", "book_id": "coloquios_da_orta_1563", "name": "Hermolao Bárbaro", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Hermolao Bárbaro"], "contexts": ["author of Castigatíones Pliniarut", "ancient/medieval authority"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Hermolao Barbaro", "target_book": "coloquios_da_orta_1563", "target_name": "Hermolao Bárbaro", "similarity": 0.673}], "id": 3684, "stable_key": "clu_b45f7b16cd6546af", "ground_truth": {"modern_name": "Hermolaus Barbarus", "confidence": "high", "type": "person", "birth_year": 1454, "death_year": 1495, "description": "Italian humanist scholar and physician, known for Pliny translations."}, "cross_references": []}, {"canonical_name": "Diapalma", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "diapalma", "book_id": "historia_medicinal_monardes_1574", "name": "diapalma", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["diapalma"], "contexts": ["emplastrum applied to afflicted parts"]}, {"entity_id": "diapalma", "book_id": "polyanthea_medicinal", "name": "Diapalma", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["Diapalma"], "contexts": ["ointment", "Diapalma plaster"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "diapalma", "target_book": "polyanthea_medicinal", "target_name": "Diapalma", "similarity": 0.986}], "id": 3685, "stable_key": "clu_dbf3ebca156e8a7b", "ground_truth": {"wikipedia_extract": "In pharmacology, diapalma (from Lat dia, \"made of\" + palma, \"palm\") is a desiccating or drying plaster, named for the wood of the palm tree, from which the spatula is made that is used to stir the mixture while boiling. It was formerly composed of common oil, hogs-fat, and litharge of gold; or also of palm oil, litharge, and zinc sulfate. Now, it is made of white wax, emplastrum simplex, and sulfate of zinc."}, "cross_references": []}, {"canonical_name": "Indio medico", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "indio_medico", "book_id": "historia_medicinal_monardes_1574", "name": "Indio medico", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["Indio medico"], "contexts": ["Indigenous physician who provided method"]}, {"entity_id": "médicos_hindus", "book_id": "coloquios_da_orta_1563", "name": "médicos hindus", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["médicos hindus"], "contexts": ["practitioners of medicine in India"]}, {"entity_id": "médicos_indianos", "book_id": "coloquios_da_orta_1563", "name": "médicos indianos", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["médicos indianos"], "contexts": ["Indian physicians"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Indio medico", "target_book": "coloquios_da_orta_1563", "target_name": "médicos hindus", "similarity": 0.924}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Indio medico", "target_book": "coloquios_da_orta_1563", "target_name": "médicos indianos", "similarity": 0.94}], "id": 3686, "stable_key": "clu_bf4e4bb3458029d3", "ground_truth": {"modern_name": "Indian physicians", "confidence": "high", "type": "person", "description": "Physicians originating from or practicing in India.", "note": "The cluster contains references to 'Indio medico' (Indigenous physician), 'médicos hindus' (Hindu physicians), and 'médicos indianos' (Indian physicians), all pointing to practitioners from India."}, "cross_references": []}, {"canonical_name": "Senhor", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "señor", "book_id": "historia_medicinal_monardes_1574", "name": "señor", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["señor"], "contexts": ["lord who was purged with little quantity"]}, {"entity_id": "senhor", "book_id": "polyanthea_medicinal", "name": "Senhor", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Senhor"], "contexts": ["Lord", "Lord, referred to with Deos"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "señor", "target_book": "polyanthea_medicinal", "target_name": "Senhor", "similarity": 0.934}], "id": 3687, "stable_key": "clu_90f0a71eb900a302", "ground_truth": {"modern_name": "Lord", "confidence": "low", "type": "person", "description": "A nobleman or person of high status, often a patient.", "note": "The term 'Señor'/'Senhor' is a general title of respect or address, not a specific historical individual.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Lord", "wikipedia_extract": "Lord is an appellation for a person or deity who has authority, control, or power over others, acting as a master, chief, or ruler. The appellation can also denote certain persons who hold a title of the peerage in the United Kingdom, or are entitled to courtesy titles. The collective \"Lords\" can refer to a group or body of peers. According to the Oxford Dictionary of English, the etymology of the word can be traced back to the Old English word hlāford which originated from hlāfweard meaning \"loaf-ward\" or \"bread-keeper\", reflecting the Germanic tribal custom of a chieftain providing food for his followers. The appellation \"lord\" is primarily applied to men, while for women the appellation \"lady\" is used. This is no longer universal: the Lord of Mann, a title previously held by the Queen of the United Kingdom, and female Lord Mayors are examples of women who are styled as \"Lord\"."}, "cross_references": [{"found_name": "Señores", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2620, "target_cluster_name": "Señores", "source_book": "llm_generated", "evidence_snippet": "Lord is a title of nobility or respect, often used for individuals of higher social standing, similar to 'Gentleman'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Lord is a title of nobility or respect, often used for individuals of higher social standing, similar to 'Gentleman'.", "is_reverse": true}]}, {"canonical_name": "lino", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "lino", "book_id": "historia_medicinal_monardes_1574", "name": "Lino", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Lino"], "contexts": ["plant whose seed is being described"]}, {"entity_id": "lino", "book_id": "ricettario_fiorentino_1597", "name": "lino", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["lino"], "contexts": ["plant used for seeds to extract mucilage", "flax used in preparations"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Lino", "target_book": "ricettario_fiorentino_1597", "target_name": "lino", "similarity": 0.793}], "id": 3688, "stable_key": "clu_3f95147cc7aa723a", "ground_truth": {"modern_name": "Flax", "confidence": "high", "type": "plant", "linnaean": "Linum usitatissimum Linnaeus", "family": "Linaceae"}, "cross_references": [{"found_name": "linho", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 1829, "target_cluster_name": "linho", "source_book": "llm_generated", "evidence_snippet": "Historical Portuguese name for Flax.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "Historical Portuguese name for Flax."}, {"found_name": "flaxseed", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3736, "target_cluster_name": "semente de linhaça", "source_book": "llm_generated", "evidence_snippet": "Flaxseed is the seed of the flax plant.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Flaxseed is the seed of the flax plant."}]}, {"canonical_name": "Antonio", "category": "PERSON", "subca