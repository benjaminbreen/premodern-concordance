data_id": "Q198", "wikidata_description": "organized and prolonged violent conflict between different nations, states, or different groups within a nation or state", "wikipedia_url": "https://en.wikipedia.org/wiki/War", "wikipedia_extract": "War is an armed conflict between the armed forces of states, or between governmental forces and armed groups that are organized under a certain command structure and have the capacity to sustain military operations, or between such organized groups. It is generally characterized by widespread violence, destruction, and mortality, using regular or irregular military forces. Warfare refers to the common activities and characteristics of types of war, or of wars in general. Total war is warfare that is not restricted to purely legitimate military targets, and can result in massive civilian or other non-combatant suffering and casualties. War has changed in numerous ways over the course of history. Since 1945, great power wars, territorial conquests and war declarations have declined in frequency."}, "cross_references": [{"found_name": "gandas", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 1066, "target_cluster_name": "rhinoceros", "source_book": "coloquios_da_orta_1563", "evidence_snippet": "coiro. ORTA Eu não vi odres de camellos desta terra; posto que no Decam e em o Guzarate ha alguns camellos, que tem os reys e os capitães pêra levar o fato na guerra; mas nem sam tantos os que morrem ", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "vernacular name for rhinoceros"}, {"found_name": "Assassin", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4455, "target_cluster_name": "assassino", "source_book": "llm_generated", "evidence_snippet": "Assassins are individuals or groups who engage in acts of violence, often associated with warfare or conflict.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Assassins are individuals or groups who engage in acts of violence, often associated with warfare or conflict."}, {"found_name": "Discord", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1209, "target_cluster_name": "discord", "source_book": "llm_generated", "evidence_snippet": "Discord is a state of disagreement or conflict, often a precursor or component of war.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Discord is a state of disagreement or conflict, often a precursor or component of war."}, {"found_name": "Evil", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3793, "target_cluster_name": "evil", "source_book": "llm_generated", "evidence_snippet": "War is often considered an manifestation of evil or a cause of great suffering and destruction.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "War is often considered an manifestation of evil or a cause of great suffering and destruction."}, {"found_name": "Force", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 59, "target_cluster_name": "Force", "source_book": "llm_generated", "evidence_snippet": "War is fundamentally an application of force, particularly military force.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "War is fundamentally an application of force, particularly military force."}, {"found_name": "History", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 177, "target_cluster_name": "history", "source_book": "llm_generated", "evidence_snippet": "War is a significant and recurring subject within the study of history.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "War is a significant and recurring subject within the study of history."}, {"found_name": "Justice", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3697, "target_cluster_name": "justicia", "source_book": "llm_ge