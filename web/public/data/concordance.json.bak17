species_darwin_1859", "source_name": "Icebergs", "target_book": "first_principles_spencer_1862", "target_name": "icebergs", "similarity": 0.985}, {"source_book": "kosmos_humboldt_1845", "source_name": "igneous mountains", "target_book": "first_principles_spencer_1862", "target_name": "icebergs", "similarity": 0.891}], "id": 382, "stable_key": "clu_75d40a20ccc40f2f", "ground_truth": {"modern_name": "Icebergs", "confidence": "high", "type": "object", "note": "Includes related concepts like glaciers and 'igneous mountains' which in context refer to large, naturally formed structures of ice or earth, often discussed in geological or geographical terms.", "wikidata_id": "Q47568", "wikidata_description": "large piece of fresh-water ice floating in the ocean or other body of water", "wikipedia_url": "https://en.wikipedia.org/wiki/Iceberg", "wikipedia_extract": "An iceberg is a piece of fresh water ice more than 15 meters (16 yards) long that has broken off a glacier or an ice shelf and is floating freely in open water. Smaller chunks of floating glacially derived ice are called \"growlers\" or \"bergy bits\". Much of an iceberg is below the water's surface, which led to the expression \"tip of the iceberg\" to illustrate a small part of a larger unseen issue. Icebergs are considered a serious maritime hazard. Icebergs vary considerably in size and shape. Icebergs that calve from glaciers in Greenland are often irregularly shaped while Antarctic ice shelves often produce large tabular (table top) icebergs."}, "cross_references": []}, {"canonical_name": "rock", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 4, "total_mentions": 12, "members": [{"entity_id": "rocks", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "rocks", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["rocks", "Rocks"], "contexts": ["naturally occurring solid aggregate of minerals", "naturally occurring solid aggregate"]}, {"entity_id": "rock", "book_id"