gory": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Peonia"], "contexts": ["ingredient in a preparation"]}, {"entity_id": "bettony", "book_id": "english_physician_1652", "name": "Bettony", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Bettony"], "contexts": ["herb that grows in the shadow"]}, {"entity_id": "bettoli", "book_id": "ricettario_fiorentino_1597", "name": "Bettoli", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Bettoli"], "contexts": ["plant used in powders"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Peony", "target_book": "historia_medicinal_monardes_1574", "target_name": "Peonia", "similarity": 0.929}, {"source_book": "english_physician_1652", "source_name": "Peony", "target_book": "coloquios_da_orta_1563", "target_name": "peonia", "similarity": 0.94}, {"source_book": "english_physician_1652", "source_name": "Peony", "target_book": "ricettario_fiorentino_1597", "target_name": "Peonia", "similarity": 0.929}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Peonia", "target_book": "coloquios_da_orta_1563", "target_name": "peonia", "similarity": 0.992}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Peonia", "target_book": "ricettario_fiorentino_1597", "target_name": "Peonia", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "peonia", "target_book": "ricettario_fiorentino_1597", "target_name": "Peonia", "similarity": 0.992}], "id": 518, "stable_key": "clu_890c89b0e1a1e1f1", "ground_truth": {"modern_name": "Peony", "confidence": "high", "type": "plant", "linnaean": "Paeonia lactiflora", "family": "Paeoniaceae", "note": "The Linnaean binomial is an educated guess as multiple species of Paeonia exist, and early modern texts often referred to the genus broadly. However, Paeonia lactiflora is a well-known medicinal peony.", "wikidata_id": "Q147105", "wikidata_description": "genus of flowering plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Peony", "wikipedia_extract": "The peony or paeony () is any flowering plant in the genus Paeonia, the only genus in the family Paeoniaceae. Peonies are native to Asia, Europe, and Western North America. Scientists differ on the number of species that can be distinguished, ranging from 25 to 40, although the current consensus describes 33 known species. The relationships between the species need to be further clarified. Most are herbaceous perennial plants 0.25–1 metre (1–3 ft) tall, but some are woody shrubs 0.25–3.5 metres (1–11 ft) tall. They have compound, deeply lobed leaves and large, often fragrant flowers, in colors ranging from purple and pink to red, white or yellow, in late spring and early summer."}, "member_count": 6, "cross_references": [{"found_name": "Lirio", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2857, "target_cluster_name": "Lirio", "source_book": "llm_generated", "evidence_snippet": "Both are flowering plants with historical medicinal associations, often grouped together in herbal texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both are flowering plants with historical medicinal associations, often grouped together in herbal texts.", "is_reverse": true}]}, {"canonical_name": "increase", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 4, "members": [{"entity_id": "increase", "book_id": "origin_of_species_darwin_1859", "name": "increase", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["increase"], "contexts": ["become or make greater"]}, {"entity_id": "increases", "book_id": "principles_of_psychology_james_1890", "name": "increases", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["increases"], "contexts": ["quantifiable additions"]}, {"entity_id": "increase", "book_id": "connexion_physical_sciences_somerville_1858", "name": "increase", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["increase"], "contexts": ["act of becoming greater"]}, {"entity_id": "increase", "book_id": "first_principles_spencer_1862", "name": "increase", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["increase"], "contexts": ["growing in size or number"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "increase", "target_book": "principles_of_psychology_james_1890", "target_name": "increases", "similarity": 0.935}, {"source_book": "origin_of_species_darwin_1859", "source_name": "increase", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "increase", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "increase", "target_book": "first_principles_spencer_1862", "target_name": "increase", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "increases", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "increase", "similarity": 0.935}, {"source_book": "principles_of_psychology_james_1890", "source_name": "increases", "target_book": "first_principles_spencer_1862", "target_name": "increase", "similarity": 0.935}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "increase", "target_book": "first_principles_spencer_1862", "target_name": "increase", "similarity": 1.0}], "id": 519, "stable_key": "clu_650fac6694d994b5", "ground_truth": {"modern_name": "Increase", "confidence": "high", "type": "concept", "wikidata_id": "Q41861", "wikidata_description": "long term medical condition with elevated arterial blood pressure", "wikipedia_url": "https://en.wikipedia.org/wiki/Hypertension", "wikipedia_extract": "Hypertension, also known as high blood pressure, is a long-term medical condition in which the blood pressure in the arteries is persistently elevated. High blood pressure usually does not cause symptoms itself. It is, however, a major risk factor for stroke, coronary artery disease, heart failure, atrial fibrillation, peripheral arterial disease, vision loss, chronic kidney disease, and dementia. Hypertension is a major cause of premature death worldwide. High blood pressure is classified as primary (essential) hypertension or secondary hypertension. About 90–95% of cases are primary, defined as high blood pressure due to non-specific lifestyle and genetic factors."}, "cross_references": [{"found_name": "Growth", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2277, "target_cluster_name": "Growth", "source_book": "llm_generated", "evidence_snippet": "Increase is a synonym for growth in quantity or size.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Increase is a synonym for growth in quantity or size.", "is_reverse": true}, {"found_name": "equilibrium mobile", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": null, "target_cluster_name": null, "source_book": "first_principles_spencer_1862", "evidence_snippet": "French mathematicians have termed _equilibrium mobile_. It is true that when the axial velocity sinks below a certain point, new motions commence, and increase till the top falls; but these are merely", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "a term used by French mathematicians"}]}, {"canonical_name": "epidemics", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 4, "total_mentions": 4, "members": [{"entity_id": "epidemics", "book_id": "origin_of_species_darwin_1859", "name": "epidemics", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["epidemics"], "contexts": ["widespread occurrence of an infectious disease"]}, {"entity_id": "epidemics", "book_id": "kosmos_humboldt_1845", "name": "epidemics", "category": "DISEASE", "subcategory": "ACUTE", "count": 1, "variants": ["epidemics"], "contexts": ["widespread outbreaks of disease"]}, {"entity_id": "epidemia", "book_id": "coloquios_da_orta_1563", "name": "epidemia", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["epidemia"], "contexts": ["widespread occurrence of disease"]}, {"entity_id": "epidemia", "book_id": "polyanthea_medicinal", "name": "epidemia", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["epidemia"], "contexts": ["medical text reference"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "epidemics", "target_book": "kosmos_humboldt_1845", "target_name": "epidemics", "similarity": 0.874}, {"source_book": "origin_of_species_darwin_1859", "source_name": "epidemics", "target_book": "coloquios_da_orta_1563", "target_name": "epidemia", "similarity": 0.959}, {"source_book": "origin_of_species_darwin_1859", "source_name": "epidemics", "target_book": "polyanthea_medicinal", "target_name": "epidemia", "similarity": 0.959}, {"source_book": "coloquios_da_orta_1563", "source_name": "epidemia", "target_book": "polyanthea_medicinal", "target_name": "epidemia", "similarity": 1.0}], "id": 520, "stable_key": "clu_32ac3b9125283b41", "ground_truth": {"wikipedia_extract": "An epidemic (from Greek ἐπί epi \"upon or above\" and δῆμος demos \"people\") is the rapid spread of disease to a large number of hosts in a given population within a short period of time. For example, in meningococcal infections, an attack rate in excess of 15 cases per 100,000 people for two consecutive weeks is considered an epidemic. Epidemics of infectious disease are generally caused by several factors including a change in the ecology of the host population (e.g., increased stress or increase in the density of a vector species), a genetic change in the pathogen reservoir or the introduction of an emerging pathogen to a host population (by movement of pathogen or host). Generally, an epidemic occurs when host immunity to either an established pathogen or newly emerging novel pathogen is suddenly reduced below that found in the endemic equilibrium and the transmission threshold is exceeded. An epidemic may be restricted to one location; however, if it spreads to other countries or continents and affects a substantial number of people, it may be termed as a pandemic. The declaration of an epidemic usually requires a good understanding of a baseline rate of incidence; epidemics for certain diseases, such as influenza, are defined as reaching some defined increase in incidence above this baseline."}, "cross_references": [{"found_name": "pestilentes", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 688, "target_cluster_name": "pestilentes", "source_book": "llm_generated", "evidence_snippet": "Pestilence, as a widespread disease, is a type of epidemic.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Pestilence, as a widespread disease, is a type of epidemic.", "is_reverse": true}, {"found_name": "Plague", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1619, "target_cluster_name": "Plague", "source_book": "llm_generated", "evidence_snippet": "Plague is a type of epidemic disease. The term 'epidemics' broadly categorizes the phenomenon of widespread disease outbreaks, of which plague is a prominent historical example.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Plague is a type of epidemic disease. The term 'epidemics' broadly categorizes the phenomenon of widespread disease outbreaks, of which plague is a prominent historical example.", "is_reverse": true}, {"found_name": "Buuas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2225, "target_cluster_name": "Buuas", "source_book": "llm_generated", "evidence_snippet": "Bubonic plague historically caused devastating epidemics, establishing a strong relationship.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Bubonic plague historically caused devastating epidemics, establishing a strong relationship.", "is_reverse": true}]}, {"canonical_name": "breathing organ", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 4, "members": [{"entity_id": "breathing_organ", "book_id": "origin_of_species_darwin_1859", "name": "breathing organ", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["breathing organ"], "contexts": ["nascent breathing organ"]}, {"entity_id": "respiratory_organs", "book_id": "kosmos_humboldt_1845", "name": "respiratory organs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["respiratory organs"], "contexts": ["organs for gas exchange"]}, {"entity_id": "orgãos_da_respiração", "book_id": "polyanthea_medicinal", "name": "orgãos da respiração", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["orgãos da respiração"], "contexts": ["organs involved in breathing"]}, {"entity_id": "respiratory_apparatus", "book_id": "first_principles_spencer_1862", "name": "respiratory apparatus", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["respiratory apparatus"], "contexts": ["structures for breathing"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "breathing organ", "target_book": "kosmos_humboldt_1845", "target_name": "respiratory organs", "similarity": 0.925}, {"source_book": "origin_of_species_darwin_1859", "source_name": "breathing organ", "target_book": "polyanthea_medicinal", "target_name": "orgãos da respiração", "similarity": 0.915}, {"source_book": "origin_of_species_darwin_1859", "source_name": "breathing organ", "target_book": "first_principles_spencer_1862", "target_name": "respiratory apparatus", "similarity": 0.919}, {"source_book": "kosmos_humboldt_1845", "source_name": "respiratory organs", "target_book": "p