"similarity": 0.929}, {"source_book": "coloquios_da_orta_1563", "source_name": "medecina", "target_book": "polyanthea_medicinal", "target_name": "Medicina", "similarity": 0.929}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Medicina", "target_book": "polyanthea_medicinal", "target_name": "Medicina", "similarity": 1.0}], "id": 209, "stable_key": "clu_a303436de0207d1a", "ground_truth": {"modern_name": "Medicine", "confidence": "high", "type": "concept", "note": "This cluster refers to the broad concept of medical practice and healing, as indicated by the various languages and contexts provided.", "wikidata_id": "Q12140", "wikidata_description": "substance used to diagnose, cure, treat, or prevent disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Medication", "wikipedia_extract": "Medication (also called medicament, medicine, pharmaceutical drug, medicinal product, medicinal drug, or simply drug) is a drug used to diagnose, cure, treat, or prevent disease. Drug therapy (pharmacotherapy) is an important part of the medical field and relies on the science of pharmacology for continual advancement and on pharmacy for appropriate management. Drugs are classified in many ways. One of the key divisions is by level of control, which distinguishes prescription drugs (those that a pharmacist dispenses only on the medical prescription) from over-the-counter drugs (those that consumers can order for themselves). Medicines may be classified by mode of action, route of administration, biological system affected, or therapeutic effects. The World Health Organization keeps a list of essential medicines."}, "member_count": 10, "cross_references": [{"found_name": "Humors", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 562, "target_cluster_name": "Humors", "source_book": "llm_generated", "evidence_snippet": "Humoral theory was a dominant medical paradigm for centuries.", "confidence": 0.85, "auto_label": "llm_related", "found_rela