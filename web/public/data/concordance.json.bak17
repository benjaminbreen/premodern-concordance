k": "llm_generated", "evidence_snippet": "Capillarity is a manifestation of cohesive forces between liquid molecules and adhesive forces between liquid and solid surfaces.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Capillarity is a manifestation of cohesive forces between liquid molecules and adhesive forces between liquid and solid surfaces."}, {"found_name": "Fluidity", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1210, "target_cluster_name": "fluidity", "source_book": "llm_generated", "evidence_snippet": "Capillarity is a phenomenon observed in fluids.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Capillarity is a phenomenon observed in fluids."}]}, {"canonical_name": "Oby", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "oby", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Oby", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Oby", "Obi"], "contexts": ["river", "river banks for comparison"]}, {"entity_id": "oby", "book_id": "kosmos_humboldt_1845", "name": "Oby", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Oby"], "contexts": ["river in Northern Asia", "river where Barnaul is located"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Oby", "target_book": "kosmos_humboldt_1845", "target_name": "Oby", "similarity": 1.0}], "id": 2395, "stable_key": "clu_ec2578e85fea690a", "ground_truth": {"modern_name": "Obidos", "confidence": "medium", "type": "place", "description": "A town in Portugal, also associated with a river or coastal area.", "note": "The context of 'Oby' as a river and 'Obidos' being a Portuguese town with coastal access makes this plausible.", "wikipedia_extract": "Óbidos (Portuguese pronunciation: [ˈɔβiðuʃ] ; Proto-Celtic: *Eburobrittium) is a town  and a municipality in the Oeste region, historical province of Estremadura and the Leiria district. The town proper has approximately 3,100 inhabitants. The municipality population in 2011 was 11,772 covering an area of 141.55 square kilometres (54.65 square miles). The name \"Óbidos\" is a Latinised (oppidum, citadel) derivation of the older Celtic \"Eburobricio\". The municipality grew from a Roman settlement near the foothills of an elevated escarpment. The region of Óbidos, extending from the Atlantic to the interior of Estremadura Province along the rivers and lakes has been inhabited since the late Paleolithic."}, "cross_references": []}, {"canonical_name": "Klaproth", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "klaproth", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Klaproth", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Klaproth", "Klaprolh", "Rlaproth"], "contexts": ["cited chemist for mineral analysis", "savante researcher of languages"]}, {"entity_id": "klaproth", "book_id": "kosmos_humboldt_1845", "name": "Klaproth", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Klaproth"], "contexts": ["scholar who wrote about the invention of the compass", "author of a letter on compass invention"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Klaproth", "target_book": "kosmos_humboldt_1845", "target_name": "Klaproth", "similarity": 1.0}], "id": 2396, "stable_key": "clu_5c53011083fb81fd", "ground_truth": {"modern_name": "Martin Heinrich Klaproth", "confidence": "high", "type": "person", "birth_year": 1743, "death_year": 1817, "description": "German chemist known for mineral analysis and element discovery.", "wikidata_id": "Q983803", "wikidata_description": "genus of plants"}, "cross_references": []}, {"canonical_name": "cyanite", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 7, "memb