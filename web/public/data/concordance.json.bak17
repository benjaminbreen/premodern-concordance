ness", "target_book": "kosmos_humboldt_1845", "target_name": "intellectual conception", "similarity": 0.881}], "id": 4172, "stable_key": "clu_e07fb5305d8e4872", "ground_truth": {"modern_name": "ideational consciousness", "confidence": "high", "type": "concept"}, "cross_references": []}, {"canonical_name": "fixed", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "fixed", "book_id": "principles_of_psychology_james_1890", "name": "fixed", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fixed"], "contexts": ["established or permanent"]}, {"entity_id": "fixed", "book_id": "kosmos_humboldt_1845", "name": "fixed", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fixed"], "contexts": ["describing stars"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "fixed", "target_book": "kosmos_humboldt_1845", "target_name": "fixed", "similarity": 1.0}], "id": 4173, "stable_key": "clu_2d2570b0e41c936a", "ground_truth": {"modern_name": "fixed", "confidence": "medium", "type": "concept", "note": "The term 'fixed' is used in multiple contexts, both generally and specifically for stars. The context of describing stars suggests 'fixed stars' rather than a general concept of 'fixed'."}, "cross_references": []}, {"canonical_name": "sing", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "sing", "book_id": "principles_of_psychology_james_1890", "name": "sing", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sing"], "contexts": ["action learned with interruptions"]}, {"entity_id": "cantos", "book_id": "coloquios_da_orta_1563", "name": "cantos", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["cantos"], "contexts": ["used in taming elephants"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "sing", "target_book": "coloquios_da_orta_1563", "target_name": "cantos", "similarity": 0.901}], "id": 4174, "stable_key": "clu_199c85d247371400", "ground_truth": {"modern_name": "singing", "confidence": "high", "type": "concept", "note": "The terms 'sing' and 'cantos' in these contexts refer to the act of vocalization, likely for communication or learned behavior, rather than a specific scientific concept.", "wikidata_id": "Q6489873", "wikidata_description": "district in Kuantan Singingi Regency, Riau Province, Indonesia"}, "cross_references": []}, {"canonical_name": "FIG. 24", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "fig__24", "book_id": "principles_of_psychology_james_1890", "name": "FIG. 24", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["FIG. 24"], "contexts": ["illustration for clarity"]}, {"entity_id": "fig__24", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Fig. 24", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Fig. 24"], "contexts": ["illustration for opposition and conjunction"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "FIG. 24", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Fig. 24", "similarity": 0.981}], "id": 4175, "stable_key": "clu_29635613be39f1ca", "ground_truth": {"modern_name": "figure 24", "confidence": "high", "type": "object", "note": "Refers to an illustration labeled 'Figure 24' in the respective texts.", "wikidata_id": "Q59275834", "wikidata_description": "article"}, "cross_references": []}, {"canonical_name": "peristaltic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "peristaltic", "book_id": "principles_of_psychology_james_1890", "name": "peristaltic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["peristaltic"], "contexts": ["motion resembling wave passage"]}, {"entity_id": "peristaltico", "book_id": "polyanthea_medicinal", "name": "peristaltico", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["peristaltico"], "contexts": ["intestinal movement"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "peristaltic", "target_book": "polyanthea_medicinal", "target_name": "peristaltico", "similarity": 0.981}], "id": 4176, "stable_key": "clu_ab17e8251318e1c3", "ground_truth": {"wikipedia_extract": "Peristalsis ( PERR-ih-STAL-siss, US also  -⁠STAWL-) is a  type of gut motility, characterized by radially symmetrical contraction and relaxation of muscles that propagate in a wave down a tube, in an anterograde direction. Peristalsis is progression of coordinated contraction of involuntary circular muscles, which is preceded by a simultaneous contraction of the longitudinal muscle and relaxation of the circular muscle in the lining of the gut. In much of a digestive tract, such as the human gastrointestinal tract, smooth muscle tissue contracts in sequence to produce a peristaltic wave, which propels a ball of food (a food bolus) before being transformed into chyme in the stomach along the tract. The peristaltic movement comprises relaxation of circular smooth muscles, then their contraction behind the chewed material to keep it from moving backward, then longitudinal contraction to push it forward. Catastalsis is an obsolete term for the peristaltic wave. Earthworms use a similar mechanism to drive their locomotion, and some modern machinery imitate this design."}, "cross_references": []}, {"canonical_name": "prestidigitation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "prestidigitation", "book_id": "principles_of_psychology_james_1890", "name": "prestidigitation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["prestidigitation"], "contexts": ["skill of sleight of hand"]}, {"entity_id": "prestidigitação", "book_id": "coloquios_da_orta_1563", "name": "prestidigitação", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["prestidigitação"], "contexts": ["skill of jugglers"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "prestidigitation", "target_book": "coloquios_da_orta_1563", "target_name": "prestidigitação", "similarity": 0.947}], "id": 4177, "stable_key": "clu_1e5a7bcb71f0cc73", "ground_truth": {"modern_name": "prestidigitation", "confidence": "high", "type": "concept", "note": "Direct translation and modern equivalent of sleight of hand.", "wikidata_id": "Q148442", "wikidata_description": "performing art involving the use of illusion"}, "cross_references": []}, {"canonical_name": "Schneider", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "schneider", "book_id": "principles_of_psychology_james_1890", "name": "Schneider", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Schneider"], "contexts": ["described sensations in movement"]}, {"entity_id": "schneider", "book_id": "kosmos_humboldt_1845", "name": "Schneider", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Schneider"], "contexts": ["editor/commentator on ancient texts"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Schneider", "target_book": "kosmos_humboldt_1845", "target_name": "Schneider", "similarity": 1.0}], "id": 4178, "stable_key": "clu_1416b24e5b58c450", "ground_truth": {"modern_name": "Schneider", "confidence": "medium", "type": "person", "description": "Scholar who described sensations and edited ancient texts.", "note": "There are multiple individuals named Schneider. Without further context from the texts, precise identification is difficult. The description suggests a scholar or commentator.", "wikidata_id": "Q550170", "wikidata_description": "species of fish"}, "cross_references": []}, {"canonical_name": "bow", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "bow", "book_id": "principles_of_psychology_james_1890", "name": "bow", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["bow"], "contexts": ["instrument used to play the violin"]}, {"entity_id": "bow", "book_id": "first_principles_spencer_1862", "name": "bow", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["bow"], "contexts": ["familiar object for hunting tribes"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "bow", "target_book": "first_principles_spencer_1862", "target_name": "bow", "similarity": 1.0}], "id": 4179, "stable_key": "clu_a01cd93c693ea8d3", "ground_truth": {"modern_name": "bow", "confidence": "high", "type": "object", "note": "The term 'bow' can refer to a hunting weapon or a device used to play stringed instruments. Given the contexts provided (hunting tribes and violin playing), both interpretations are valid and distinct. Without further context to prioritize one, 'bow' as a general object is appropriate. If specific classification were needed, it would require disambiguation based on the text's broader subject matter."}, "cross_references": []}, {"canonical_name": "fisherman", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "fisherman", "book_id": "principles_of_psychology_james_1890", "name": "fisherman", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["fisherman"], "contexts": ["profession kept at sea by habit"]}, {"entity_id": "fisher", "book_id": "coloquios_da_orta_1563", "name": "Fisher", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Fishe