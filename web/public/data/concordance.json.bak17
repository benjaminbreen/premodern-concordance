rthern_italy", "book_id": "connexion_physical_sciences_somerville_1858", "name": "northern Italy", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["northern Italy"], "contexts": ["location of anomaly"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Northern Italy", "target_book": "kosmos_humboldt_1845", "target_name": "Northern Italy", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Northern Italy", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "northern Italy", "similarity": 0.968}, {"source_book": "kosmos_humboldt_1845", "source_name": "Northern Italy", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "northern Italy", "similarity": 0.968}], "id": 1436, "stable_key": "clu_6ccf6106ff3e3a0c", "ground_truth": {"modern_name": "Northern Italy", "confidence": "high", "type": "place", "country": "Italy", "wikidata_id": "Q4345530", "wikidata_description": "geographic region of Italy", "wikipedia_url": "https://en.wikipedia.org/wiki/Northern%20Italy", "wikipedia_extract": "Northern Italy (Italian: Italia Settentrionale, Nord Italia, Alta Italia) is a geographical and cultural region in the northern part of Italy. The Italian National Institute of Statistics defines the region as encompassing the four northwestern regions of Piedmont, Aosta Valley, Liguria and Lombardy in addition to the four northeastern regions of Trentino-Alto Adige/Südtirol, Veneto, Friuli-Venezia Giulia and Emilia-Romagna. With a population of 27.5 million in an area of 120,312.72 km2 (46,453.00 mi2) as of 2025, the region covers roughly 40% of Italy and contains 46% of its population. Two of Italy's largest metropolitan areas, Milan and Turin, are located in the region. Northern Italy's GDP was estimated at €1 trillion in 2021, accounting for 56.5% of the Italian economy. Northern Italy has a rich and distinct culture."}, "cross_references": [{"found_nam