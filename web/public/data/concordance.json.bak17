tegory": "THEORY", "book_count": 2, "total_mentions": 20, "members": [{"entity_id": "tidal_wave", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Tidal wave", "category": "CONCEPT", "subcategory": "THEORY", "count": 17, "variants": ["Tidal Wave", "tidal wave", "Tidal wave"], "contexts": ["origin and course of ocean wave", "direction of ocean wave"]}, {"entity_id": "tidal_waves", "book_id": "connexion_physical_sciences_somerville_1858", "name": "tidal waves", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["tidal waves"], "contexts": ["waves originating from Antarctic Ocean", "course down Pacific Ocean"]}, {"entity_id": "tidal_wave", "book_id": "first_principles_spencer_1862", "name": "tidal wave", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["tidal wave"], "contexts": ["wave caused by gravitational pull of celestial bodies"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Tidal wave", "target_book": "first_principles_spencer_1862", "target_name": "tidal wave", "similarity": 0.945}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "tidal waves", "target_book": "first_principles_spencer_1862", "target_name": "tidal wave", "similarity": 0.962}], "id": 1768, "stable_key": "clu_0ed1641ecde1c438", "ground_truth": {"modern_name": "Tsunami", "confidence": "high", "type": "concept", "note": "While 'tidal wave' was used historically, 'tsunami' is the precise modern term for large ocean waves caused by seismic events.", "wikidata_id": "Q963944", "wikidata_description": "human disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Melioidosis", "wikipedia_extract": "Melioidosis is an infectious disease caused by a gram-negative bacterium called Burkholderia pseudomallei. Most people exposed to B. pseudomallei experience no symptoms, but complications can range from fever and skin changes to pneumonia, abscesses, and septic shock, which can be fatal. Approximately 10% of people with melioidosis develop symptoms that last longer than two months, termed \"chronic melioidosis\". Prior to the Vietnam war less than a handful of patients had diagnosed in the United States in the twentieth century. In 1966, Spotnitz discovered that a number of servicemen with delayed onset of pulmonary infections had previously been deployed in Vietnam."}, "cross_references": []}, {"canonical_name": "chemical action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 31, "members": [{"entity_id": "chemical_action", "book_id": "connexion_physical_sciences_somerville_1858", "name": "chemical action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 12, "variants": ["chemical action", "Chemical action"], "contexts": ["process of chemical change", "reactions between substances"]}, {"entity_id": "chemical_action", "book_id": "first_principles_spencer_1862", "name": "Chemical Action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["Chemical Action", "chemical action"], "contexts": ["occurs on daguerreotype plate", "genesis of other modes of force"]}, {"entity_id": "external_chemical_action", "book_id": "first_principles_spencer_1862", "name": "external chemical action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["external chemical action"], "contexts": ["chemical changes on surfaces"]}, {"entity_id": "reactions", "book_id": "principles_of_psychology_james_1890", "name": "reactions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["reactions"], "contexts": ["responses to stimuli", "response to a stimulus"]}, {"entity_id": "reaction", "book_id": "principles_of_psychology_james_1890", "name": "reaction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["reaction"], "contexts": ["response to stimulus", "response to a stimulus"]}, {"entity_id": "re-action", "book_id": "first_principles_spencer_1862", "name": "re-action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["re-action"], "contexts": ["force exerted in response"]}, {"entity_id": "reactions", "book_id": "first_principles_spencer_1862", "name": "reactions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["reactions"], "contexts": ["responses to stimuli or conditions"]}, {"entity_id": "chemical_actions", "book_id": "kosmos_humboldt_1845", "name": "chemical actions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["chemical actions"], "contexts": ["actions related to light waves"]}, {"entity_id": "chemical_actions", "book_id": "first_principles_spencer_1862", "name": "chemical actions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["chemical actions"], "contexts": ["actions involving chemical processes", "reactions involving elements"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "chemical action", "target_book": "first_principles_spencer_1862", "target_name": "Chemical Action", "similarity": 0.967}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "chemical action", "target_book": "first_principles_spencer_1862", "target_name": "external chemical action", "similarity": 0.917}], "id": 1769, "stable_key": "clu_10da76508d074150", "ground_truth": {"modern_name": "Chemical reactions", "confidence": "high", "type": "concept", "wikidata_id": "Q36534", "wikidata_description": "process that results in the interconversion of chemical species", "wikipedia_url": "https://en.wikipedia.org/wiki/Chemical%20reaction", "wikipedia_extract": "A chemical reaction is a process that leads to the chemical transformation of one set of chemical substances to another. When chemical reactions occur, the atoms are rearranged and the reaction is accompanied by an energy change as new products are generated. Classically, chemical reactions encompass changes that only involve the positions of electrons in the forming and breaking of chemical bonds between atoms, with no change to the nuclei (no change to the elements present), and can often be described by a chemical equation. Nuclear chemistry is a sub-discipline of chemistry that involves the chemical reactions of unstable and radioactive elements where both electronic and nuclear changes can occur. The substance (or substances) initially involved in a chemical reaction are called reactants or reagents. Chemical reactions are usually characterized by a chemical change, and they yield one or more products, which usually have properties different from the reactants."}, "member_count": 9, "cross_references": [{"found_name": "chemical change", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 989, "target_cluster_name": "chemical change", "source_book": "llm_generated", "evidence_snippet": "A chemical reaction is a type of chemical change, often used interchangeably in historical texts.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "A chemical reaction is a type of chemical change, often used interchangeably in historical texts."}, {"found_name": "Chemistry", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 304, "target_cluster_name": "Chemistry", "source_book": "llm_generated", "evidence_snippet": "Chemistry is the scientific discipline that studies chemical reactions.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Chemistry is the scientific discipline that studies chemical reactions.", "is_reverse": true}, {"found_name": "chemical composition", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 449, "target_cluster_name": "chemical composition", "source_book": "llm_generated", "evidence_snippet": "Chemical reactions involve changes i