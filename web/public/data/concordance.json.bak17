rce_book": "origin_of_species_darwin_1859", "source_name": "Pyrenees", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Pyrénées", "similarity": 0.967}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Pyrenees", "target_book": "kosmos_humboldt_1845", "target_name": "Pyrenees", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Pyrenees", "target_book": "kosmos_humboldt_1845", "target_name": "Pyrenes", "similarity": 0.981}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Pyrenees", "target_book": "historia_medicinal_monardes_1574", "target_name": "Pirineos", "similarity": 0.891}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pyrénées", "target_book": "kosmos_humboldt_1845", "target_name": "Pyrenees", "similarity": 0.967}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pyrénées", "target_book": "kosmos_humboldt_1845", "target_name": "Pyrenes", "similarity": 0.942}, {"source_book": "kosmos_humboldt_1845", "source_name": "Pyrenees", "target_book": "historia_medicinal_monardes_1574", "target_name": "Pirineos", "similarity": 0.891}], "id": 268, "stable_key": "clu_dc5259ff7bbab9a7", "ground_truth": {"modern_name": "Pyrenees", "confidence": "high", "type": "place", "country": "France, Spain, Andorra", "wikidata_id": "Q12709", "wikidata_description": "French department in the region of Occitania", "wikipedia_url": "https://en.wikipedia.org/wiki/Pyr%C3%A9n%C3%A9es-Orientales", "wikipedia_extract": "Pyrénées-Orientales (French: [piʁene ɔʁjɑ̃tal] ; Catalan: Pirineus Orientals [piɾiˈnɛwz uɾiənˈtals]; Occitan: Pirenèus Orientals [piɾeˈnɛwz uɾjenˈtals]; lit. 'Eastern Pyrenees'), also known as Northern Catalonia, is a department of the region of Occitania, Southern France, adjacent to the northern Spanish frontier and the Mediterranean Sea. It borders the departments of Ariège to the northwest and Aude to the north, the Mediterranean Sea to the east and the Spanish province of Girona in Catalonia to the south and the country of Andorra to the west. It also surrounds the tiny Spanish exclave of Llívia, and thus has two distinct borders with Spain. In 2019, it had a population of 479,979. Some parts of the Pyrénées-Orientales (like the Cerdagne) are part of the Iberian Peninsula."}, "cross_references": []}, {"canonical_name": "Bessel", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 4, "total_mentions": 37, "members": [{"entity_id": "bessel", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bessel", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Bessel"], "contexts": ["added observations from Kœnigsberg", "early modern scholar"]}, {"entity_id": "bessel", "book_id": "kosmos_humboldt_1845", "name": "Bessel", "category": "PERSON", "subcategory": "SCHOLAR", "count": 28, "variants": ["Bessel"], "contexts": ["perfected theory of pendulum oscillations in air", "prosecuted pendulum experiments with precision"]}, {"entity_id": "bessel", "book_id": "principles_of_psychology_james_1890", "name": "Bessel", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Bessel"], "contexts": ["observer of personal equation"]}, {"entity_id": "bessel", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Bessel", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["Bessel"], "contexts": ["deduced compression from arcs", "determined solar parallax and sun's diameter"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bessel", "target_book": "kosmos_humboldt_1845", "target_name": "Bessel", "similarity": 0.721}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Bessel", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bessel", "similarity": 1.0}], "id": 269, "stable_key": "clu_b2954aa8bdbb6fa4", "ground_truth": {"modern_name": "Fr