r_id": 403, "target_cluster_name": "agriculture", "source_book": "llm_generated", "evidence_snippet": "Agriculture is the cultivation of plants for human use, a direct application and manipulation of plant life.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Agriculture is the cultivation of plants for human use, a direct application and manipulation of plant life."}, {"found_name": "Animal life", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2437, "target_cluster_name": "animal life", "source_book": "llm_generated", "evidence_snippet": "Plant life and animal life are the two primary kingdoms of biological organisms, often studied in conjunction (e.g., ecology, food webs).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Plant life and animal life are the two primary kingdoms of biological organisms, often studied in conjunction (e.g., ecology, food webs)."}, {"found_name": "Botany", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1098, "target_cluster_name": "botany", "source_book": "llm_generated", "evidence_snippet": "Botany is the scientific study of plants, making it directly related to the concept of plant life.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Botany is the scientific study of plants, making it directly related to the concept of plant life."}, {"found_name": "Economy of nature", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1147, "target_cluster_name": "economy of nature", "source_book": "llm_generated", "evidence_snippet": "This concept often encompasses the interactions and relationships within ecosystems, including plant life.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "This concept often encompasses the interactions and relationships within ecosystems, including plant life."}]}, {"canonical_name": "fluid", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "fluid", "book_id": "principles_of_psychology_james_1890", "name": "fluid", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["fluid"], "contexts": ["liquid surrounding brain and spinal cord", "likeness of soul described by Ulrici"]}, {"entity_id": "fluid", "book_id": "connexion_physical_sciences_somerville_1858", "name": "fluid", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 6, "variants": ["fluid"], "contexts": ["highly elastic substance in mineral cavities", "substance that flows, like air or water"]}, {"entity_id": "fluid", "book_id": "first_principles_spencer_1862", "name": "fluid", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["fluid"], "contexts": ["hypothetical medium between atoms", "substance that flows"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "fluid", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "fluid", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "fluid", "target_book": "first_principles_spencer_1862", "target_name": "fluid", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "fluid", "target_book": "first_principles_spencer_1862", "target_name": "fluid", "similarity": 1.0}], "id": 897, "stable_key": "clu_e346559b4a2d1303-3", "ground_truth": {"modern_name": "water", "confidence": "high", "type": "substance", "description": "A transparent liquid essential for life, used medicinally and as a medium.", "note": "Includes Portuguese ('agua'), French ('eau'), and generic terms ('fluid').", "wikipedia_extract": "Water is an inorganic compound with the chemical formula H2O. It is a transparent, tasteless, odorless, and nearly colorless chemical substance. It is the main constituent of Earth's streams, lakes, and oceans and the fluids of all known living organisms, in which it acts as a solvent. Water, being a polar molecule, undergoes strong intermolecular hydrogen bonding which is a large contributor to its physical and chemical properties. It is vital for all known forms of life, despite not providing food energy or being an organic micronutrient. Due to its presence in all organisms, its chemical stability, its worldwide abundance, and its strong polarity relative to its small molecular size, water is often referred to as the \"universal solvent\"."}, "cross_references": []}, {"canonical_name": "Respiração", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "breathe", "book_id": "principles_of_psychology_james_1890", "name": "breathe", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["breathe"], "contexts": ["process of inhaling and exhaling"]}, {"entity_id": "respiração", "book_id": "polyanthea_medicinal", "name": "Respiração", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 9, "variants": ["Respiração", "Respiração apreslada", "respiraça", "respiração"], "contexts": ["breathing", "bodily function"]}, {"entity_id": "breathing", "book_id": "first_principles_spencer_1862", "name": "breathing", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["breathing"], "contexts": ["process of respiration"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "breathe", "target_book": "polyanthea_medicinal", "target_name": "Respiração", "similarity": 0.905}, {"source_book": "principles_of_psychology_james_1890", "source_name": "breathe", "target_book": "first_principles_spencer_1862", "target_name": "breathing", "similarity": 0.977}, {"source_book": "polyanthea_medicinal", "source_name": "Respiração", "target_book": "first_principles_spencer_1862", "target_name": "breathing", "similarity": 0.929}], "id": 898, "stable_key": "clu_e805813a0207e258", "ground_truth": {"modern_name": "Respiration", "confidence": "high", "type": "concept", "description": "The physiological process of breathing.", "wikipedia_extract": "Photosynthesis ( FOH-tə-SINTH-ə-sis) is a system of biological processes by which photopigment-bearing autotrophic organisms, such as most plants, algae and cyanobacteria, convert light energy — typically from sunlight — into the chemical energy necessary to fuel their metabolism. The term photosynthesis usually refers to oxygenic photosynthesis, a process that releases oxygen as a byproduct of water splitting. Photosynthetic organisms store the converted chemical energy within the bonds of intracellular organic compounds (complex compounds containing carbon), typically carbohydrates like sugars (mainly glucose, fructose and sucrose), starches, phytoglycogen and cellulose. When needing to use this stored energy, an organism's cells then metabolize the organic compounds through cellular respiration. Photosynthesis plays a critical role in producing and maintaining the oxygen content of the Earth's atmosphere, and it supplies most of the biological energy necessary for complex life on Earth. Some organisms also perform anoxygenic photosynthesis, which does not produce oxygen.", "wikipedia_url": "https://en.wikipedia.org/wiki/Photosynthesis"}, "cross_references": [{"found_name": "Animal heat", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3893, "target_cluster_name": "animal heat", "source_book": "llm_generated", "evidence_snippet": "Historical texts often discussed animal heat as a product or manifestation of respiration.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Historical texts often discussed animal heat as a product or manifestation of respiration."}, {"found_name": "Digestion", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 338, "target_cluster_name": "digestion", "source_book": "llm_generated", "evidence_snippet": "Digestion and respiration were often discussed together as essential processes for sustaining life and generating heat.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Digestion and respiration were often discussed together as essential processes for sustaining life and generating heat."}, {"found_name": "Evaporation", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2390, "target_cluster_name": "évaporation", "source_book": "llm_generated", "evidence_snippet": "Some historical texts drew analogies between evaporation and respiration, particularly concerning the release of 'vapors' or 'spirits'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Some historical texts drew analogies between evaporation and respiration, particularly concerning the release of 'vapors' or 'spirits'."}, {"found_name": "Generation", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 166, "target_cluster_name": "generation", "source_book": "llm_generated", "evidence_snippet": "Respiration was sometimes linked to the generation of vital spirits or heat necessary for life.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Respiration was sometimes linked to the generation of vital spirits or heat necessary for life."}, {"found_name": "Combustion", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 866, "target_cluster_name": "combustion", "source_book": "llm_generated", "evidence_snippet": "Historical understandings of respiration often drew parallels with combustion, viewing it as a slow burning process within the body.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Historical understandings of respiration often drew parallels with combustion, viewing it as a slow burning process within the body."}]}, {"canonical_name": "Encke’s comet", "category": "OBJECT", "subcateg