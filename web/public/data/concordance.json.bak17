entity_id": "visual_impressions", "book_id": "principles_of_psychology_james_1890", "name": "visual impressions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["visual impressions"], "contexts": ["sensory input from sight"]}, {"entity_id": "photographic_impressions", "book_id": "connexion_physical_sciences_somerville_1858", "name": "photographic impressions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["photographic impressions"], "contexts": ["images created by photographic process"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "optical impression", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "optical impressions", "similarity": 0.968}, {"source_book": "principles_of_psychology_james_1890", "source_name": "optical impressions", "target_book": "first_principles_spencer_1862", "target_name": "impressions of light", "similarity": 0.885}], "id": 1200, "stable_key": "clu_9b5cc64f2feb5a8c", "ground_truth": {"modern_name": "Visual Perception", "confidence": "high", "type": "concept", "wikidata_id": "Q113263364", "wikidata_description": "capacity of an insect to extract information from light"}, "member_count": 6, "cross_references": [{"found_name": "Attention", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 198, "target_cluster_name": "attention", "source_book": "llm_generated", "evidence_snippet": "Attention is crucial for effective visual perception, as it directs and focuses the processing of visual information.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Attention is crucial for effective visual perception, as it directs and focuses the processing of visual information."}, {"found_name": "Association of Ideas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1992, "target_cluster_name": "association of ideas", "source_book": "llm_generated", "evidence_snippet": "The way visual impressions are associated with other ideas and memories is a core aspect of how visual perception functions and is interpreted.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The way visual impressions are associated with other ideas and memories is a core aspect of how visual perception functions and is interpreted."}]}, {"canonical_name": "Etymologies", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "etymologies", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Etymologies", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Etymologies"], "contexts": ["work by Isidore on word origins", "study of word origins and meanings"]}, {"entity_id": "etymology", "book_id": "kosmos_humboldt_1845", "name": "etymology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["etymology"], "contexts": ["study of word origins"]}, {"entity_id": "etymologia", "book_id": "coloquios_da_orta_1563", "name": "etymologia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["etymologia"], "contexts": ["study of word origins"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Etymologies", "target_book": "kosmos_humboldt_1845", "target_name": "etymology", "similarity": 0.925}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Etymologies", "target_book": "coloquios_da_orta_1563", "target_name": "etymologia", "similarity": 0.941}, {"source_book": "kosmos_humboldt_1845", "source_name": "etymology", "target_book": "coloquios_da_orta_1563", "target_name": "etymologia", "similarity": 0.994}], "id": 1201, "stable_key": "clu_02fb5f301e5a46c3", "ground_truth": {"modern_name": "Etymology", "confidence": "high", "type": "concept", "wikidata_id": "Q35245", "wikidata_description": "study of the history of words, their origins, and how their form and meaning have changed over time", "wikipedia_url": "https://en.wikipedia.org/wiki/Etymology", "wikipedia_extract": "Etymology ( ET-ih-MOL-ə-jee) is the study of the origin and evolution of words—including their constituent units of sound and meaning—across time. In the 21st century, as a subfield within linguistics, etymology has become an increasingly rigorous scientific field of study. It is most directly tied to historical linguistics, philology, and semiotics, and additionally draws upon comparative semantics, morphology, pragmatics, and phonetics in order to construct a comprehensive and chronological catalogue of all meanings that a word (and its related parts) has carried throughout its history. The origin of any particular word is also known as its etymology. For languages with a long written history, etymologists make use of texts, particularly texts about the language itself, to gather knowledge about how words were used during earlier periods, how they developed in meaning and form, or when and how they entered the language. Etymologists also apply the methods of comparative linguistics to reconstruct information about forms that are too old for any direct information to be available."}, "cross_references": [{"found_name": "Latines", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1055, "target_cluster_name": "Latines", "source_book": "llm_generated", "evidence_snippet": "The study of the origins of words often traces them back to Latin.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The study of the origins of words often traces them back to Latin.", "is_reverse": true}, {"found_name": "translation", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1136, "target_cluster_name": "translation", "source_book": "llm_generated", "evidence_snippet": "Understanding the origin and history of words is crucial for accurate translation, especially when dealing with nuances and cultural context.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Understanding the origin and history of words is crucial for accurate translation, especially when dealing with nuances and cultural context.", "is_reverse": true}, {"found_name": "History", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 177, "target_cluster_name": "history", "source_book": "llm_generated", "evidence_snippet": "Etymology is a historical study of word origins and changes over time, making it intrinsically related to the broader concept of history.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Etymology is a historical study of word origins and changes over time, making it intrinsically related to the broader concept of history."}, {"found_name": "Intellectual development", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3589, "target_cluster_name": "intellectual development", "source_book": "llm_generated", "evidence_snippet": "The evolution of language, studied through etymology, is a key component of intellectual development.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The evolution of language, studied through etymology, is a key component of intellectual development."}]}, {"canonical_name": "visible rayes", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 5, "members": [{"entity_id": "visible_rayes", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "visible rayes", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["visible rayes"], "contexts": ["beams of light", "rays from eyes carrying poison"]}, {"entity_id": "rays_of_light", "book_id": "kosmos_humboldt_1845", "name": "rays of light", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["rays of light"], "contexts": ["electromagnetic radiation visible to the eye"]}, {"entity_id": "visible_rays", "book_id": "connexion_physical_sciences_somerville_1858", "name": "visible rays", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["visible rays"], "contexts": ["rays detectable by sight", "part of the spectrum visible to the eye"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "visible rayes", "target_book": "kosmos_humboldt_1845", "target_name": "rays of light", "similarity": 0.913}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "visible rayes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "visible rays", "similarity": 0.998}, {"source_book": "kosmos_humboldt_1845", "source_name": "rays of light", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "visible rays", "similarity": 0.917}], "id": 1202, "stable_key": "clu_1409084ec56441ec", "ground_truth": {"modern_name": "Visible light", "confidence": "high", "type": "concept", "wikidata_id": "Q76299", "wikidata_description": "portion of the electromagnetic spectrum that is visible to the human eye", "wikipedia_url": "https://en.wikipedia.org/wiki/Visible%20spectrum", "wikipedia_extract": "The visible spectrum is the band of the electromagnetic spectrum that is visible to the human eye. Electromagnetic radiation in this range of wavelengths is called visible light (or simply light). The optical spectrum is sometimes considered to be the same as the visible spectrum, but some authors define the term more broadly, to include the ultraviolet and infrared parts of the electromagnetic spectrum as well, known collectively as optical radiation. A typical human eye will respond to wavelengths from about 380 to about 750 nanometers. In terms of frequency, this corresponds to a band in the vicinity of 400–790 terahertz. These boundaries are not sharply defined and may vary per individual."}, "cross_references": [{"found_name": "Light", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 34, "target_cluster_name": "light", "source_book": "llm_generated", "evidence_snippet": "The entity 'Visible light' is explicitly stated to be synonymous with 'light' in the description.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The entity 'Visible light' is explicitly stated to be synonymous with 'light' in the description."}]}, {"canonical_name": "Johnson", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "johnson", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Johnson", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Johnson"], "contexts": ["named a stony plant", "names a plant"]}, {"entity_id": "johnson", "book_id": "english_physician_1652", "name": "Johnson", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Johnson"], "contexts": ["English author on herbs", "author"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Johnson", "target_book": "english_physician_1652", "target_name": "Johnson", "similarity": 1.0}], "id": 1203, "stable_key": "clu_a8351ae4bfd681f4", "ground_truth": {"modern_name": "John Parkinson", "confidence": "high", "type": "person", "birth_year": 1567, "death_year": 1650, "description": "English botanist and apothecary, author of 'Theatrum Botanicum'", "note": "The 'Johnson' in 'pseudodoxia_epidemica_browne_1646' likely refers to John Parkinson, given Browne's known interactions with him and Parkinson's botanical works. The 'English physician' context also aligns. The 'coloquios_da_orta_1563' entry is less certain but could refer to a different, lesser-known Johnson or a mistranscription.", "wikidata_id": "Q112659324", "wikidata_description": "British diplomat and plant collector (c. 1772-1847)"}, "cross_references": [{"found_name": "John Gerard", "link_type": "conceptual