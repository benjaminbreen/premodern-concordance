t": 5, "total_mentions": 17, "members": [{"entity_id": "arms", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "arms", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["arms"], "contexts": ["upper limbs of humans"]}, {"entity_id": "womans_arm", "book_id": "english_physician_1652", "name": "Womans Arm", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Womans Arm"], "contexts": ["body part"]}, {"entity_id": "arm", "book_id": "origin_of_species_darwin_1859", "name": "arm", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["arm"], "contexts": ["part of monkey", "upper limb"]}, {"entity_id": "arm", "book_id": "principles_of_psychology_james_1890", "name": "arm", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 10, "variants": ["arm"], "contexts": ["upper limb", "upper limb of the body"]}, {"entity_id": "arms", "book_id": "principles_of_psychology_james_1890", "name": "arms", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["arms"], "contexts": ["limbs used for grasping", "body parts that felt detached"]}, {"entity_id": "arm", "book_id": "first_principles_spencer_1862", "name": "arm", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["arm"], "contexts": ["limb for raising and movement"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "arms", "target_book": "origin_of_species_darwin_1859", "target_name": "arm", "similarity": 0.918}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "arms", "target_book": "principles_of_psychology_james_1890", "target_name": "arm", "similarity": 0.918}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "arms", "target_book": "principles_of_psychology_james_1890", "target_name": "arms", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "arms", "target_book": "first_principles_spencer_1862", "target_name": "arm", "similarity": 0.918}, {"source_book": "english_physician_1652", "source_name": "Womans Arm", "target_book": "principles_of_psychology_james_1890", "target_name": "arm", "similarity": 0.907}, {"source_book": "origin_of_species_darwin_1859", "source_name": "arm", "target_book": "principles_of_psychology_james_1890", "target_name": "arm", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "arm", "target_book": "principles_of_psychology_james_1890", "target_name": "arms", "similarity": 0.918}, {"source_book": "origin_of_species_darwin_1859", "source_name": "arm", "target_book": "first_principles_spencer_1862", "target_name": "arm", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "arm", "target_book": "first_principles_spencer_1862", "target_name": "arm", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "arms", "target_book": "first_principles_spencer_1862", "target_name": "arm", "similarity": 0.918}], "id": 140, "stable_key": "clu_7fe687f12077013c", "ground_truth": {"modern_name": "Arm", "confidence": "high", "type": "concept", "note": "While 'arm' refers to a body part, in these early modern contexts, it's often used more broadly as a descriptor or in comparative statements, making 'concept' a more fitting type when discussing its usage across diverse texts rather than a specific anatomical instance.", "wikidata_id": "Q399", "wikidata_description": "sovereign state in the South Caucasus region of Eurasia", "wikipedia_url": "https://en.wikipedia.org/wiki/Armenia", "wikipedia_extract": "Armenia, officially the Republic of Armenia, is a landlocked country in the Armenian highlands of West Asia. It is a part of the Caucasus region and is bordered by Turkey to the west, Georgia to the north, Azerbaijan to the east, and Iran and the Azerbaijani exclave of Nakhchivan to the south. Yerevan is the capital, largest city and financial center. The Armenian highlands have been home to the Hayasa-Azzi, Shupria, and Nairi peoples. By at least 600 BC, an archaic form of Proto-Armenian, an Indo-European language, had diffused into the Armenian highlands. The first Armenian state of Urartu was established in 860 BC, and by the 6th century BC it was replaced by the Satrapy of Armenia."}, "cross_references": [{"found_name": "hand", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 76, "target_cluster_name": "hand", "source_book": "llm_generated", "evidence_snippet": "The 'Hand' is a body part, and the 'Arm' is another closely associated body part, often discussed together in anatomical contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The 'Hand' is a body part, and the 'Arm' is another closely associated body part, often discussed together in anatomical contexts.", "is_reverse": true}, {"found_name": "fingers", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 328, "target_cluster_name": "fingers", "source_book": "llm_generated", "evidence_snippet": "Fingers are a part of the arm.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Fingers are a part of the arm.", "is_reverse": true}, {"found_name": "organs of motion", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 429, "target_cluster_name": "organs of motion", "source_book": "llm_generated", "evidence_snippet": "The arm is a component of the musculoskeletal system.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The arm is a component of the musculoskeletal system.", "is_reverse": true}, {"found_name": "ligamentos", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3334, "target_cluster_name": "ligamentos", "source_book": "llm_generated", "evidence_snippet": "The 'Arm' is a body part that contains ligaments.", "confidence": 0.85, "auto_l