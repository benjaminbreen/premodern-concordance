: "OTHER_CONCEPT", "count": 6, "variants": ["Seasons", "seasons"], "contexts": ["periods of the year with distinct weather", "periods of the year"]}, {"entity_id": "seasons", "book_id": "first_principles_spencer_1862", "name": "seasons", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["seasons"], "contexts": ["periods of the year", "annual periods"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Season", "target_book": "kosmos_humboldt_1845", "target_name": "seasons", "similarity": 0.895}, {"source_book": "english_physician_1652", "source_name": "Season", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Seasons", "similarity": 0.912}, {"source_book": "english_physician_1652", "source_name": "Season", "target_book": "first_principles_spencer_1862", "target_name": "seasons", "similarity": 0.895}, {"source_book": "kosmos_humboldt_1845", "source_name": "seasons of the year", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Seasons", "similarity": 0.936}, {"source_book": "kosmos_humboldt_1845", "source_name": "seasons of the year", "target_book": "first_principles_spencer_1862", "target_name": "seasons", "similarity": 0.932}, {"source_book": "kosmos_humboldt_1845", "source_name": "seasons", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Seasons", "similarity": 0.973}, {"source_book": "kosmos_humboldt_1845", "source_name": "seasons", "target_book": "first_principles_spencer_1862", "target_name": "seasons", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Seasons", "target_book": "first_principles_spencer_1862", "target_name": "seasons", "similarity": 0.973}], "id": 401, "stable_key": "clu_83d76fcb5332bb6f", "ground_truth": {"modern_name": "Season", "confidence": "high", "type": "concept", "note": "The contexts clearly indicate the divisions of the year and their relation to celestial mechanics and natural phenomena.", "wikidata_id": "Q27020041", "wikidata_description": "season of a sports league or competition, generally a specific one year period", "wikipedia_url": "https://en.wikipedia.org/wiki/Season%20%28sports%29", "wikipedia_extract": "In an organized sports league, a typical season is the portion of one year in which regulated games of the sport are in session: for example, in Major League Baseball the season lasts approximately from the last week of March to the last week of September. In other team sports, like association football or basketball, it is generally from August or September to May although in some countries – such as Northern Europe, North America or East Asia – the season for outdoor summer sports starts in the spring and finishes in autumn, mainly due to weather conditions encountered during the winter. A year can often be broken up into several distinct sections (sometimes themselves called seasons). These are: a preseason, usually a series of exhibition games played for training purposes; a regular season, the main period of the league's competition; the postseason, a playoff tournament played against the league's top teams to determine the league's champion; and the offseason, the time when there is no official competition. In association football, many clubs tour and then play a series of exhibition games for training purposes. Specifically in Brazil, teams play in state championships before the start of the Brazilian League."}, "cross_references": [{"found_name": "Autumn", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 911, "target_cluster_name": "Autumn", "source_book": "llm_generated", "evidence_snippet": "Autumn is one of the four traditional divisions of the year, marking a part of the season.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Autumn is one of the four traditional divisions of the year, marking a part of the season."}, {"found_name": "December", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 988, "target_cluster_name": "Dezembro", "source_book": "llm_generated", "evidence_snippet": "December is a month within a season.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "December is a month within a season."}, {"found_name": "April", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 129, "target_cluster_name": "April", "source_book": "llm_generated", "evidence_snippet": "April is a month within a season.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "April is a month within a season."}, {"found_name": "Chronology", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2825, "target_cluster_name": "Chronology", "source_book": "llm_generated", "evidence_snippet": "Chronology is the science of arranging events in the order of their occurrence in time, which includes the study of seasons.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Chronology is the science of arranging events in the order of their occurrence in time, which includes the study of seasons."}, {"found_name": "Climate", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 613, "target_cluster_name": "climate", "source_book": "llm_generated", "evidence_snippet": "Climate is the long-term weather pattern of a region, which is directly influenced by the seasons.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Climate is the long-term weather pattern of a region, which is directly influenced by the seasons."}, {"found_name": "temperate regions", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4008, "target_cluster_name": "temperate regions", "source_book": "llm_generated", "evidence_snippet": "Temperate climates are characterized by distinct seasonal changes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Temperate climates are characterized by distinct seasonal changes.", "is_reverse": true}]}, {"canonical_name": "Labrador", "category": "PLACE", "subcategory": "REGION", "book_count": 4, "total_mentions": 11, "members": [{"entity_id": "labrador", "book_id": "origin_of_species_darwin_1859", "name": "Labrador", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Labrador"], "contexts": ["region with similar plants to White Mountains", "region with arctic plants"]}, {"entity_id": "labrador", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Labrador", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["Labrador"], "contexts": ["wild country", "territory in Canada"]}, {"entity_id": "labrador", "book_id": "kosmos_humboldt_1845", "name": "Labrador", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Labrador"], "contexts": ["peninsula in northeastern Canada", "coastal area in Eastern America"]}, {"entity_id": "labrador", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Labrador", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Labrador"], "contexts": ["coast with Table Bay on freezing point line", "region in Canada"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Labrador", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Labrador", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Labrador", "target_book": "kosmos_humboldt_1845", "target_name": "Labrador", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Labrador", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Labrador", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Labrador", "target_book": "kosmos_humboldt_1845", "target_name": "Labrador", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Labrador", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Labrador", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Labrador", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Labrador", "similarity": 1.0}], "id": 402, "stable_key": "clu_210aaea351081370", "ground_truth": {"modern_name": "Labrador", "confidence": "high", "type": "place", "description": "A large geographical region in northeastern Canada.", "note": "Refers to the geographical region of Labrador, known for its arctic flora and wild terrain.", "wikipedia_extract": "Labrador () is a geographic and cultural region within the Canadian province of Newfoundland and Labrador. It is the primarily continental portion of the province and constitutes 71% of the province's area but is home to only 6% of its population. It is separated from the island of Newfoundland by the Strait of Belle Isle. It is the largest and northernmost geographical region in the four Atlantic provinces. Labrador occupies most of the eastern part of the Labrador Peninsula. It is bordered to the west and south by the province of Quebec."}, "cross_references": [{"found_name": "Canada", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 736, "target_cluster_name": "Canada", "source_book": "llm_generated", "evidence_snippet": "Labrador is a geographic and cultural region within the Canadian province of Newfoundland and Labrador.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Labrador is a geographic and cultural region within the Canadian province of Newfoundland and Labrador."}]}, {"canonical_name": "agriculture", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 11, "members": [{"entity_id": "agricultural", "book_id": "origin_of_species_darwin_1859", "name": "agricultural", "category": "CONCEPT", "s