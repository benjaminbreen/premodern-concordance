ariants": ["nucleus"], "contexts": ["central part of a comet"]}, {"entity_id": "solid_nucleus", "book_id": "connexion_physical_sciences_somerville_1858", "name": "solid nucleus", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["solid nucleus"], "contexts": ["dense central part of the earth"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "nucleus", "target_book": "kosmos_humboldt_1845", "target_name": "nucleus", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "nucleus", "target_book": "kosmos_humboldt_1845", "target_name": "nuclei", "similarity": 0.972}, {"source_book": "principles_of_psychology_james_1890", "source_name": "nucleus", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "nucleus", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "nucleus", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "solid nucleus", "similarity": 0.885}, {"source_book": "kosmos_humboldt_1845", "source_name": "nucleus", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "nucleus", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "nucleus", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "solid nucleus", "similarity": 0.885}, {"source_book": "kosmos_humboldt_1845", "source_name": "nuclei", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "nucleus", "similarity": 0.972}], "id": 929, "stable_key": "clu_2295e757c09b4f4e", "ground_truth": {"modern_name": "nucleus", "confidence": "high", "type": "concept", "note": "The term 'nucleus' in early modern texts referred to a central core or essential part, applicable across various scientific fields like astronomy (core of a sun or nebula) and psychology (central part of a thought). It is not a specific anatomical structure in the modern biological sense but a general concept of centrality.", "wikidata_id": "Q40260", "wikidata_description": "membrane-bounded organelle of eukaryotic cells in which chromosomes are housed and replicated", "wikipedia_url": "https://en.wikipedia.org/wiki/Cell%20nucleus", "wikipedia_extract": "The cell nucleus (from Latin  nucleus or nuculeus 'kernel, seed'; pl.: nuclei) is a membrane-bound organelle found in eukaryotic cells. Eukaryotic cells usually have a single nucleus, but a few cell types, such as mammalian red blood cells, have no nuclei, and a few others including osteoclasts have many. The main structures making up the nucleus are the nuclear envelope, a double membrane that encloses the entire organelle and isolates its contents from the cellular cytoplasm; and the nuclear matrix, a network within the nucleus that adds mechanical support. The cell nucleus contains nearly all of the cell's genome. Nuclear DNA is often organized into multiple chromosomes – long strands of DNA dotted with various proteins, such as histones, that protect and organize the DNA. The genes within these chromosomes are structured in such a way to promote cell function."}, "cross_references": [{"found_name": "light", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 34, "target_cluster_name": "light", "source_book": "kosmos_humboldt_1845", "evidence_snippet": "of our solar system with respect to the number of individual forms, the concentrated part, usually termed the 'head', or 'nucleus', transmits sidereal light unimpaired. The mass of a comet probably in", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "reverse: alternative name for concentrated part of comet", "is_reverse": true}, {"found_name": "head", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1508, "target_cluster_name": "cabeça", "source_book": "kosmos_humboldt_1845", "evidence_snippet": "the most considerable portion of our solar system with respect to the number of individual forms, the concentrated part, usually termed the 'head', or 'nucleus', transmits sidereal light unimpaired. T", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for 'nucleus' in the context of a comet"}, {"found_name": "Cellular structure", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4029, "target_cluster_name": "cellular structure", "source_book": "llm_generated", "evidence_snippet": "The nucleus is a key component of cellular structure.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The nucleus is a key component of cellular structure."}, {"found_name": "Cellular tissue", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1440, "target_cluster_name": "cellular tissue", "source_book": "llm_generated", "evidence_snippet": "The nucleus is a key component of cellular tissue.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The nucleus is a key component of cellular tissue."}, {"found_name": "Biological organization", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4028, "target_cluster_name": "organisations", "source_book": "llm_generated", "evidence_snippet": "The nucleus is a fundamental unit of biological organization.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The nucleus is a fundamental unit of biological organization."}, {"found_name": "Biological structure", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2276, "target_cluster_name": "structure", "source_book": "llm_generated", "evidence_snippet": "The nucleus is a fundamental biological structure.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The nucleus is a fundamental biological structure."}]}, {"canonical_name": "atmospheric pressure", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 10, "members": [{"entity_id": "atmospheric_pressure", "book_id": "kosmos_humboldt_1845", "name": "atmospheric pressure", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["atmospheric pressure", "Atmospheric Pressure"], "contexts": ["force exerted by the atmosphere", "pressure exerted by the atmosphere"]}, {"entity_id": "atmospheric_pressure", "book_id": "connexion_physical_sciences_somerville_1858", "name": "atmospheric pressure", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["atmospheric pressure"], "contexts": ["pressure exerted by atmosphere", "force exerted by the atmosphere"]}, {"entity_id": "atmospheric_pressure", "book_id": "first_principles_spencer_1862", "name": "atmospheric pressure", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["atmospheric pressure"], "contexts": ["pressure exerted by the atmosphere"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "atmospheric pressure", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "atmospheric pressure", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "atmospheric pressure", "target_book": "first_principles_spencer_1862", "target_name": "atmospheric pressure", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "atmospheric pressure", "target_book": "first_principles_spencer_1862", "target_name": "atmospheric pressure", "similarity": 1.0}], "id": 930, "stable_key": "clu_7bb0d777e86e1698", "ground_truth": {"modern_name": "atmospheric pressure", "confidence": "high", "type": "concept", "wikidata_id": "Q81809", "wikidata_description": "static pressure exerted by the weight of the atmosphere", "wikipedia_url": "https://en.wikipedia.org/wiki/Atmospheric%20pressure", "wikipedia_extract": "Atmospheric pressure, also known as air pressure or barometric pressure (after the barometer), is the pressure within the atmosphere of Earth. The standard atmosphere (symbol: atm) is a unit of pressure defined as 101,325 Pa (1,013.25 hPa), which is equivalent to 1,013.25 millibars, 760 torr (or about 760 mmHg), about 29.9212 inHg, or about 14.696 psi. The atm unit is roughly equivalent to the mean sea-level atmospheric pressure on Earth; that is, the Earth's atmospheric pressure at sea level is approximately 1 atm. In most circumstances, atmospheric pressure is closely approximated by the hydrostatic pressure caused by the weight of air above the measurement point. As elevation increases, there is less overlying atmospheric mass, so atmospheric pressure decreases with increasing elevation. Because the atmosphere is thin relative to the Earth's radius—especially the dense atmospheric layer at low altitudes—the Earth's gravitational acceleration as a function of altitude can be approximated as constant and contributes little to this fall-off."}, "cross_references": [{"found_name": "Atmospheric currents", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1184, "target_cluster_name": "atmospheric currents", "source_book": "llm_generated", "evidence_snippet": "Atmospheric pressure is a fundamental component and driver of atmospheric currents.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Atmospheric pressure is a fundamental component and driver of atmospheric currents."}, {"found_name": "Atmospheric electricity", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3166, "target_cluster_name": "atmospheric electricity", "source_book": "llm_generated", "evidence_snippet": "Atmospheric pressure is a key variable in the study of atmospheric electricity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Atmospheric pressure is a key variable in the study of atmospheric electricity."}, {"found_name": "Density", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 303, "target_cluster_name": "density", "source_book": "llm_generated", "evidence_snippet": "Density is directly related to atmospheric pressure (Pressure = Density * Gravity * Height).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Density is directly related to atmospheric pressure (Pressure = Density * Gravity * Height)."}, {"found_name": "Calm", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 854, "target_cluster_name": "calmas", "source_book": "llm_generated", "evidence_snippet": "Calm weather conditions are often associated with stable atmospheric pressure systems.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Calm weather conditions are often associated with stable atmospheric pressure systems."}]}, {"canonical_name": "Galileo", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 10, "members": [{"entity_id": "galileo", "book_id": "kosmos_humboldt_1845", "name": "Galileo", "category": "PERSON", "subcategory": "SCHOLAR", "count": 7, "variants": ["Galileo"], "contexts": ["Italian astronomer and physicist", "observed pendulum vibrations as a boy"]}, {"entity_id": "galileo", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Galileo", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Galileo"], "contexts": ["first to notice points of rest and motion", "proposed method for finding star distances"]}, {"entity_id": "galileo", "book_id": "first_principles_spencer_1862", "name": "Galileo", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Galileo"], "contexts": ["scientist who challenged notion of inherent stopping"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Galileo", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Galileo", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Galileo", "target_book": "first_