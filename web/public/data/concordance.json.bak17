und_truth": {"modern_name": "Paralysis", "confidence": "high", "type": "disease", "description": "Loss of muscle function and movement.", "note": "Covers general paralysis and related conditions like paralytic dementia.", "wikipedia_extract": "Paralysis (pl.: paralyses; also known as plegia) is a loss of motor function in one or more muscles. Paralysis can also be accompanied by a loss of feeling (sensory loss) in the affected area if there is sensory damage. In the United States, roughly 1 in 50 people have been diagnosed with some form of permanent or transient paralysis. The word \"paralysis\" derives from the Greek παράλυσις, meaning \"disabling of the nerves\" from παρά (para) meaning \"beside, by\" and λύσις (lysis) meaning \"making loose\". A paralysis accompanied by involuntary tremors is usually called \"palsy\". Paralysis is most often caused by damage in the nervous system, especially the spinal cord."}, "cross_references": [{"found_name": "Asclepias", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 3350, "target_cluster_name": "Asclepias", "source_book": "polyanthea_medicinal", "evidence_snippet": "ſegredo efficazpara que o ſangue ſe não congele , direy ( a favordos enfermos ) oque tenho obſervado para promovera circulaçao ,& adelgaçar os humores dos Paralyticos ,&Apopleticos;&he, darlhes, por l", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "alternative name for Vincetoxico"}]}, {"canonical_name": "Mercury", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 53, "members": [{"entity_id": "mercury", "book_id": "kosmos_humboldt_1845", "name": "Mercury", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 17, "variants": ["Mercury", "mercury"], "contexts": ["inner planetary group member", "planet in our solar system"]}, {"entity_id": "mercury", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Mercury", "category": "OBJECT", "subcategory": "O