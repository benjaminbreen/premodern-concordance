arget_name": "Leop. von Buch", "similarity": 0.897}], "id": 1643, "stable_key": "clu_a4accbd7ee7470b3", "ground_truth": {"modern_name": "Leopold von Buch", "confidence": "high", "type": "person", "birth_year": 1774, "death_year": 1853, "description": "German geologist and naturalist, known for volcanology and geognosy.", "wikidata_id": "Q101563992", "wikidata_description": "street in Angermünde, Brandenburg, Germany"}, "cross_references": [{"found_name": "Alexander von Humboldt", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 42, "target_cluster_name": "Humboldt", "source_book": "llm_generated", "evidence_snippet": "Leopold von Buch and Alexander von Humboldt were prominent geologists and naturalists of the same era, known to have corresponded and collaborated.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Leopold von Buch and Alexander von Humboldt were prominent geologists and naturalists of the same era, known to have corresponded and collaborated."}]}, {"canonical_name": "Viole", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 5, "total_mentions": 40, "members": [{"entity_id": "viola", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Viola", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Viola"], "contexts": ["plant genus resembling Ioaidium Itubu"]}, {"entity_id": "viole", "book_id": "ricettario_fiorentino_1597", "name": "Viole", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 31, "variants": ["Viole", "Viole mammole", "Violi", "viole", "viole mammoic", "viole mammole"], "contexts": ["flower mentioned in the passage", "herb used in preparations"]}, {"entity_id": "violets", "book_id": "english_physician_1652", "name": "Violets", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["Violets", "Violet"], "contexts": ["flower with medicinal uses", "herb with similar operations to pansies"]}, {"entity_id": "violet", "book_id": "principles_of_psychology_james_1890", "name": "violet", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["violet"], "contexts": ["primary color", "fragrant flower"]}, {"entity_id": "violetas", "book_id": "historia_medicinal_monardes_1574", "name": "Violetas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Violetas"], "contexts": ["flower ingredient in a decoction"]}, {"entity_id": "violet", "book_id": "ricettario_fiorentino_1597", "name": "violet", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["violet"], "contexts": ["flower used in sugar preparations"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Viola", "target_book": "ricettario_fiorentino_1597", "target_name": "Viole", "similarity": 0.966}], "id": 1644, "stable_key": "clu_30c8491216e6e0b9", "ground_truth": {"modern_name": "Violet", "confidence": "high", "type": "plant", "linnaean": "Viola L.", "family": "Violaceae", "wikidata_id": "Q146095", "wikidata_description": "genus of plants; violets", "wikipedia_url": "https://en.wikipedia.org/wiki/Viola%20%28plant%29", "note": "The genus 'Viola' encompasses various species commonly known as violets. The context 'primary color' refers to the color violet, derived from the flower.", "wikipedia_extract": "Viola, commonly known as the violets, is a genus of flowering plants in the family Violaceae. It is the largest genus in the family, containing over 680 species. Most species are found in the temperate Northern Hemisphere; however, some are also found in widely divergent areas such as Hawaii, Australasia, and the Andes. Some Viola species are perennial plants, some are annual plants, and a few are small shrubs. Many species, varieties and cultivars are grown in gardens for their ornamental flowers. In horticulture, the term pansy is normally used for those multi-colored large-flowered cultivars which are raised annually or biennially from seed and used extensively in bedding."}, "member_count": 6, "cross_references": [{"found_name": "heartsease", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 2971, "target_cluster_name": "heartsease", "source_book": "llm_generated", "evidence_snippet": "Heartsease is a common name for certain species within the genus Viola, which is the genus for Violet.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Heartsease is a common name for certain species within the genus Viola, which is the genus for Violet."}]}, {"canonical_name": "comets", "category": "CONCEPT", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 32, "members": [{"entity_id": "comet", "book_id": "kosmos_humboldt_1845", "name": "comet", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 5, "variants": ["comet"], "contexts": ["type of inclination for Pallas", "celestial body with tail"]}, {"entity_id": "comets", "book_id": "connexion_physical_sciences_somerville_1858", "name": "comets", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 27, "variants": ["comets", "Comets"], "contexts": ["celestial bodies with elliptical orbits", "icy celestial bodies"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "comet", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "comets", "similarity": 0.946}], "id": 1645, "stable_key": "clu_d01f7f44b9c93aa3", "ground_truth": {"modern_name": "comet", "confidence": "high", "type": "concept", "wikipedia_extract": "Comets have been observed by humanity for thousands of years, but only in the past few centuries have they been studied as astronomical phenomena. Before modern times, great comets caused worldwide fear, considered bad omens foreboding disaster and turmoil, for example the 1066 passage of Halley's Comet depicted as heralding the Norman conquest of England. As the science of astronomy developed planetary theories, understanding the nature and composition of comets became a challenging mystery and a large area of study. Halley's comet, reappearing every 75–76 years, was pivotal to the study of comets, especially of their orbits. Thinkers such as Immanuel Kant in the eighteenth century hypothesized about the physical composition of comets. Today, comets are well understood as \"dirty snowballs\" in eccentric orbits around the Sun, but they continue as objects of scientific and popular fascination.", "wikipedia_url": "https://en.wikipedia.org/wiki/Observational_history_of_comets"}, "cross_references": [{"found_name": "Astrology", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1840, "target_cluster_name": "Astrology", "source_book": "llm_generated", "evidence_snippet": "Historically, comets were often interpreted through the lens of astrology, seen as omens or portents.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Historically, comets were often interpreted through the lens of astrology, seen as omens or portents."}, {"found_name": "Celestial body", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3227, "target_cluster_name": "celestial body", "source_book": "llm_generated", "evidence_snippet": "Comets are a type of celestial body.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Comets are a type of celestial body."}, {"found_name": "Elliptical orbit", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2341, "target_cluster_name": "elliptical orbit", "source_book": "llm_generated", "evidence_snippet": "Comets typically follow elliptical orbits around the Sun.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Comets typically follow elliptical orbits around the Sun."}, {"found_name": "Aphelion", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 864, "target_cluster_name": "Aphelion", "source_book": "llm_generated", "evidence_snippet": "Aphelion is the point in a comet's orbit farthest from the Sun.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Aphelion is the point in a comet's orbit farthest from the Sun."}, {"found_name": "Focus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3571, "target_cluster_name": "focus", "source_book": "llm_generated", "evidence_snippet": "The Sun is at one focus of a comet's elliptical orbit.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Sun is at one focus of a comet's elliptical orbit."}, {"found_name": "Halley's comet", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "kosmos_humboldt_1845", "evidence_snippet": "observations on the path of this cosmical body, whose tail extended over a space of 60 degrees, appearing sometimes single and sometimes multiple. The first comet that has been calculated solely from ", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "known as"}, {"found_name": "il Signor Astone", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": null, "target_cluster_name": null, "source_book": "kosmos_humboldt_1845", "evidence_snippet": "Lexicon, signifies \"stellæ cadentes.\" The comparison of comets to lances and swords was, however, in the Middle Ages, very common in all languages. The great comet of 1500, which was visible from Apri", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "termed by Italian writers"}]}, {"canonical_name": "Ambar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 32, "members": [{"entity_id": "ambar", "book_id": "historia_medicinal_monardes_1574", "name": "Ambar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 22, "variants": ["Ambar", "AMBAR GRIS", "Ambai", "Ambar Gris", "Ambar gris", "ambar"], "contexts": ["used to make beads", "ambergris"]}, {"entity_id": "âmbar", "book_id": "coloquios_da_orta_1563", "name": "âmbar", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 10, "variants": ["âmbar", "âmbar amarello", "âmbares"], "contexts": ["substance discussed", "substance from whales"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Ambar", "target_book": "coloquios_da_orta_1563", "target_name": "âmbar", "similarity": 0.624}], "id": 1646, "stable_key": "clu_857fb8397c7136c9", "ground_truth": {"modern_name": "Ambergris", "confidence": "high", "type": "substance", "note": "The term 'Ambar' or 'âmbar' in early modern Portuguese and Spanish texts most commonly refers to ambergris, a waxy substance produced in the digestive system of sperm whales, used in perfumery and medicine. While 'amber' (fossilized resin) also exists, its uses and contexts in early modern medicinal texts point more strongly to ambergris.", "wikidata_id": "Q188774", "wikidata_description": "substance produced in the digestive system of sperm whales", "wikipedia_url": "https://en.wikipedia.org/wiki/Ambergris", "wikipedia_extract": "Ambergris ( or ; Latin: ambra grisea; Old French: ambre gris), ambergrease, or grey amber is a solid, waxy, flammable substance of a dull grey or blackish colour produced in the digestive system of sperm whales. Freshly produced ambergris has a marine, fecal odor. It acquires a sweet, earthy scent as it ages, commonly likened to the fragrance of isopropyl alcohol without the vaporous chemical astringency. Ambergris has been highly valued by perfume makers as a fixative that allows the scent to last much longer, although it has been mostly replaced by synthetic ambroxide. It is sometimes used in cooking. Dogs are attracted to the smell of ambergris and are sometimes used by ambergris searchers."}, "cross_references": [{"found_name": "Sardine", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2509, "target_cluster_name": "sardonix", "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "Hiacinto Sardine cioè cor- ninole. Granati Smeraldi Zedoaria Doronici Scorze di ccderno Mace Seme di Bafsilico gariofilato Coralli rofsi Ambra gialla ^an an.31 ' an.3 lì. 1 l roppo» Gherofani { Gcn- 1", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for cor- ninole"}, {"found_name": "Algalia", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2077, "target_cluster_name": "Algalia", "source_book": "llm_generated", "evidence_snippet": "Both civet and ambergris were historically used as valuable perfumery ingredients and fixatives in medicine and cosmetics.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both civet and ambergris were historically used as valuable perfumery ingredients and fixatives in medicine and cosmetics.", "is_reverse": true}, {"found_name": "Persia", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 168, "target_cluster_name": "Persia", "source_book": "coloquios_da_orta_1563", "evidence_snippet": "chamão Ganga), e vem o benjujr, que chamam ameií- doado, de Siam; e de todo este benjuy que vem á índia, a mór parte se gasta pêra a Arábia e Turquia e Pérsia. E porque nam cuideis que ha alguma pouca", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "reverse: a type of benzoin from Siam", "is_reverse": true}, {"found_name": "Appio", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "Folio vero Galanga Nardo indica 1 Cardamomo mag. ^an } .i. Cardamomo mm.J Gengiouo S-is:- Legno aloe ì Sandalicitrim^ an,3.ii. Pepe lungo J ^ Ambra S'^a:* Mulco 3 Componi con Sciroppo rofato, e > ^ . ", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for Cardarne"}, {"found_name": "corninole", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "Hiacinto Sardine cioè cor- ninole. Granati Smeraldi Zedoaria Doronici Scorze di ccderno Mace Seme di Bafsilico gariofilato Coralli rofsi Ambra gialla ^an an.31 ' an.3 lì. 1 l roppo» Gherofani { Gcn- 1", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for Sardine"}, {"found_name": "Ambar uafadas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "historia_medicinal_monardes_1574", "evidence_snippet": "lucido : traen el ftere delo - mueltro,en grandes pedagos tranſparentes , tanto, \"Aro. que há dicho algunos que es eſpecie de Charabe, o Succinó,que llaman Ambar uafadasde que hazen Pé Amo cuentas, yn", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "referred to as a type of succinó"}, {"found_name": "Ambra gialla", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "Hiacinto Sardine cioè cor- ninole. Granati Smeraldi Zedoaria Doronici Scorze di ccderno Mace Seme di Bafsilico gariofilato Coralli rofsi Ambra gialla ^an an.31 ' an.3 lì. 1 l roppo» Gherofani { Gcn- 1", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "a type of Ambra"}]}, {"canonical_name": "Mirabolani", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 32, "members": [{"entity_id": "mirabolanos", "book_id": "coloquios_da_orta_1563", "name": "Mirabolanos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 11, "variants": ["Mirabolanos", "MIRABOLANOS", "MiRABOLANOS", "mirabolano", "mirabolanos", "mirabolanos indos", "mirabolanos verdes", "mirabulanos"], "contexts": ["fruits praised by Greeks and Arabs", "fruit used in medicine"]}, {"entity_id": "mirabolani", "book_id": "ricettario_fiorentino_1597", "name": "Mirabolani", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 21, "variants": ["Mirabolani", "Mirab Citrmi", "Mirab.Cheboli", "Mirabo", "MiraboLCitrinij", "Mirabolani Chcb", "Mirabolani Citrini", "Mirabolani Indi", "Mirabolani citrini", "Mirabolani del Montano", "Mirabolanil", "Myrabolani", "mirab. citrini", "mirabolani", "mirabolanii"], "contexts": ["plant parts used in preparations", "purgative medicine"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Mirabolanos", "target_book": "ricettario_fiorentino_1597", "target_name": "Mirabolani", "similarity": 0.955}], "id": 1647, "stable_key": "clu_7883093ae5f143a1", "ground_truth": {"modern_name": "Citrine Myrobalans", "confidence": "high", "type": "plant", "description": "A medicinal fruit from the Terminalia species, used as a purgative.", "note": "Likely refers to species within the genus Terminalia, specifically those with yellow fruit.", "wikipedia_extract": "Terminalia chebula, commonly known as black- or chebulic myrobalan, is a species of Terminalia, native to South Asia from Pakistan, India and Nepal east to southwest China (Yunnan), and south to Sri Lanka, Malaysia, and Vietnam. Swedish naturalist Anders Jahan Retzius described the species in Observ. Bot. 5: 31 in 1788. T. c. var. chebula – leaves and shoots hairless, or only hairy when very young T. c. var. tomentella  – leaves and shoots silvery to orange hairy Terminalia chebula is a medium to large deciduous tree growing to 30 m (98 ft) tall, with a trunk up to 1 m (3 ft 3 in) in diameter. The leaves are alternate to subopposite in arrangement, oval, 7–8 cm (2.8–3.1 in) long and 4.5–10 cm (1.8–3.9 in) broad with a 1–3 cm (0.39–1.18 in) petiole. They have an acute tip, cordate at the base, margins entire, glabrous above with a yellowish pubescence below."}, "cross_references": [{"found_name": "citrinos", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2465, "target_cluster_name": "citrinos", "source_book": "llm_generated", "evidence_snippet": "The term 'citrine' in 'Citrine Myrobalans' likely refers to a yellow or yellowish color, which is consistent with the appearance of some citrus fruits or their derivatives. Historical texts sometimes used 'citrine' in relation to citrus-like substances.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: The term 'citrine' in 'Citrine Myrobalans' likely refers to a yellow or yellowish color, which is consistent with the appearance of some citrus fruits or their derivatives. Historical texts sometimes used 'citrine' in relation to citrus-like substances.", "is_reverse": true}, {"found_name": "Cassia fistula", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 582, "target_cluster_name": "Canafistula", "source_book": "llm_generated", "evidence_snippet": "Both are species within the broader category of myrobalans, often used in traditional medicine and dyeing. Cassia fistula is a specific type of cassia tree, and myrobalans are fruits from trees in the Terminalia genus, which are sometimes grouped with or confused with cassia due to similar medicinal properties and appearance.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are species within the broader category of myrobalans, often used in traditional medicine and dyeing. Cassia fistula is a specific type of cassia tree, and myrobalans are fruits from trees in the Terminalia genus, which are sometimes grouped with or confused with cassia due to similar medicinal properties and appearance."}, {"found_name": "Cinnamon", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 44, "target_cluster_name": "Canela", "source_book": "llm_generated", "evidence_snippet": "Both Citrine Myrobalans and Cinnamon are dried fruits or barks used as spices and in traditional medicine. Historically, they were often grouped together in pharmacopoeias and trade due to their aromatic properties and medicinal applications, though they are distinct botanical species.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both Citrine Myrobalans and Cinnamon are dried fruits or barks used as spices and in traditional medicine. Historically, they were often grouped together in pharmacopoeias and trade due to their aromatic properties and medicinal applications, though they are distinct botanical species."}, {"found_name": "Turmeric", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1807, "target_cluster_name": "Curcuma", "source_book": "llm_generated", "evidence_snippet": "Both Citrine Myrobalans and Turmeric are plant-derived substances historically used in dyeing and traditional medicine. They were often found in similar trade routes and pharmacopoeias, leading to associations in historical texts, despite being botanically distinct.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both Citrine Myrobalans and Turmeric are plant-derived substances historically used in dyeing and traditional medicine. They were often found in similar trade routes and pharmacopoeias, leading to associations in historical texts, despite being botanically distinct."}, {"found_name": "frutas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 72, "target_cluster_name": "frutas", "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "Myrabolani cosi chiamati da gli Arabi , non fono i My - rabolani , cioè la noce vnguentaria di Diofcoride , detta vol- garmente beenj ma fono altre fpezic di frutti^de quali ne fan- no cinque fpezie, ", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "reverse: a type of Myrabolani", "is_reverse": true}, {"found_name": "inepala", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "norte dar as frutas menos sujeitas a putrefaçam, segundo que eu soube nesta ilha de Goa dos físicos gentios delia. E achei que nella ha três feições de mirabolanos, de que usam pêra purgar, onde o que", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "local name for a form of mirabolano"}, {"found_name": "anpale", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "ahi cinquo ma- neiras; scilicet, três usadas em Goa, e huma achada em Cambaia e Bengala e Bisnager; e porque amde ser cinquo maneiras, vos diguo que o mirabolano, dito anpale, posto que he achado em G", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "a type of mirabolano"}]}, {"canonical_name": "oleo de amendoas doces", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 32, "members": [{"entity_id": "óleo_de_amêndoas_doces", "book_id": "coloquios_da_orta_1563", "name": "óleo de amêndoas doces", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["óleo de amêndoas doces"], "contexts": ["rectification agent", "oil preparation from almonds"]}, {"entity_id": "oleo_de_amendoas_doces", "book_id": "polyanthea_medicinal", "name": "oleo de amendoas doces", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 30, "variants": ["oleo de amendoas doces", "oleo de almendolas doces", "oleo deamendoas amargofas", "oleode amendoas amargoſas", "oleode amendoasdoces", "oleodeamendoas doces"], "contexts": ["emollient remedy ingredient", "ingredient in a liniment"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "óleo de amêndoas doces", "target_book": "polyanthea_medicinal", "target_name": "oleo de amendoas doces", "similarity": 0.955}], "id": 1648, "stable_key": "clu_9d9bc622ac2134d4", "ground_truth": {"modern_name": "Sweet Almond Oil", "confidence": "high", "type": "substance", "description": "Oil extracted from sweet almonds, used in medicine and cosmetics.", "note": "'Oleo de amendoas doces' is Portuguese for sweet almond oil.", "wikipedia_extract": "Prunus is a genus of flowering trees and shrubs from the family Rosaceae. The genus includes plums, cherries, peaches, nectarines, apricots and almonds (collectively stonefruit). The genus has a cosmopolitan distribution, being native to the temperate regions of North America, the neotropics of South America, and temperate and tropical regions of Eurasia and Africa, There are about 340 accepted species as of March 2024. Many members of the genus are widely cultivated for their sweet, fleshy fruit and for decorative purposes of their flowers. Prunus fruit are drupes, or stone fruits. The fleshy mesocarp surrounding the endocarp is edible while the endocarp itself forms a hard, inedible shell called the pyrena (\"stone\" or \"pit\")."}, "cross_references": [{"found_name": "Oil of Almonds", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 2701, "target_cluster_name": "Oyl of Almonds", "source_book": "llm_generated", "evidence_snippet": "This is a direct English translation of the historical Portuguese name 'oleo de amendoas doces'.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "This is a direct English translation of the historical Portuguese name 'oleo de amendoas doces'."}, {"found_name": "Oils", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 203, "target_cluster_name": "olio", "source_book": "llm_generated", "evidence_snippet": "Sweet almond oil is a specific type of oil.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Sweet almond oil is a specific type of oil."}, {"found_name": "olio", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 203, "target_cluster_name": "olio", "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "melagrane , & fimih j & al- cuni fi fanno allhora che il Medico gli ordina j © perche fi guaftano nello ftare ordinati , o mutano qualità , co- me i'olio di mandorle do/ci , o vero perche al Medico pi", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "reverse: a type of oil, mentioned as an example of a substance that spoils", "is_reverse": true}]}, {"canonical_name": "Poyson", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 31, "members": [{"entity_id": "poyson", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "poyson", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["poyson"], "contexts": ["substance Crystal is antidote against"]}, {"entity_id": "poyson", "book_id": "english_physician_1652", "name": "Poyson", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 30, "variants": ["poyson", "Poyson"], "contexts": ["substance expelled by the herb", "substance resisted by Angelica"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "poyson", "target_book": "english_physician_1652", "target_name": "Poyson", "similarity": 0.621}], "id": 1649, "stable_key": "clu_5062fa18b56912e1", "ground_truth": {"modern_name": "Poison", "confidence": "high", "type": "concept"}, "cross_references": []}, {"canonical_name": "naturalists", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 31, "members": [{"entity_id": "naturalists", "book_id": "origin_of_species_darwin_1859", "name": "naturalists", "category": "PERSON", "subcategory": "SCHOLAR", "count": 29, "variants": ["naturalists", "Naturalists"], "contexts": ["scientists studying nature", "people who study nature"]}, {"entity_id": "naturalists", "book_id": "first_principles_spencer_1862", "name": "naturalists", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Naturalists", "naturalists"], "contexts": ["scientists studying nature", "scientists who study nature"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "naturalists", "target_book": "first_principles_spencer_1862", "target_name": "naturalists", "similarity": 1.0}], "id": 1650, "stable_key": "clu_cce57dd83d614006", "ground_truth": {"modern_name": "Naturalist", "confidence": "high", "type": "person", "description": "Scientists who study the natural world and its phenomena.", "note": "This refers to a category of individuals, not a specific person.", "wikidata_id": "Q18805", "wikidata_description": "person who studies and knows a lot about plants, animals and natural history (esp in the field)", "wikipedia_extract": "Sir David Frederick Attenborough (; born 8 May 1926) is a British broadcaster, biologist, natural historian and writer. First becoming prominent as host of Zoo Quest in 1954, his filmography as a writer, presenter and narrator has spanned eight decades; it includes the nine nature documentary series forming The Life Collection, Natural World, Wildlife on One, the Planet Earth franchise, The Blue Planet and Blue Planet II. He is the only person to have won BAFTA Awards in black-and-white, colour, high-definition, 3D and 4K resolution. Over his life he has collected dozens of honorary degrees and awards, including three Emmy Awards for Outstanding Narration and one Emmy Award for Outstanding Daytime Personality - Non-Daily. Attenborough was a senior manager at the BBC, having served as controller of BBC Two and director of programming for BBC Television in the 1960s and 1970s. While Attenborough's earlier work focused primarily on the wonders of the natural world, his later work has been more vocal in support of environmental causes.", "wikipedia_url": "https://en.wikipedia.org/wiki/Naturalist"}, "cross_references": [{"found_name": "Zoologist", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3376, "target_cluster_name": "zoologist", "source_book": "llm_generated", "evidence_snippet": "Both Attenborough and zoologists study animals.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both Attenborough and zoologists study animals."}, {"found_name": "Aristotle", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 62, "target_cluster_name": "Aristotle", "source_book": "llm_generated", "evidence_snippet": "Aristotle is considered one of the earliest naturalists, laying foundational work in biology and zoology.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Aristotle is considered one of the earliest naturalists, laying foundational work in biology and zoology."}, {"found_name": "Wallace", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2104, "target_cluster_name": "Wallace", "source_book": "llm_generated", "evidence_snippet": "Wallace was a prominent naturalist, and this term describes his profession.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Wallace was a prominent naturalist, and this term describes his profession.", "is_reverse": true}, {"found_name": "Westwood", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2372, "target_cluster_name": "Westwood", "source_book": "llm_generated", "evidence_snippet": "John Obadiah Westwood was a prominent entomologist and naturalist.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: John Obadiah Westwood was a prominent entomologist and naturalist.", "is_reverse": true}, {"found_name": "Milne Edwards", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2528, "target_cluster_name": "Milne Edwards", "source_book": "llm_generated", "evidence_snippet": "Henri Milne Edwards was a naturalist, a broader term encompassing his study of the natural world, including zoology and comparative anatomy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Henri Milne Edwards was a naturalist, a broader term encompassing his study of the natural world, including zoology and comparative anatomy.", "is_reverse": true}, {"found_name": "palæontologists", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2529, "target_cluster_name": "palæontologists", "source_book": "llm_generated", "evidence_snippet": "Paleontologists are a type of naturalist, as they study the natural world, specifically ancient organisms.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Paleontologists are a type of naturalist, as they study the natural world, specifically ancient organisms.", "is_reverse": true}]}, {"canonical_name": "Oltmanns", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 31, "members": [{"entity_id": "oltmanns", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Oltmanns", "category": "PERSON", "subcategory": "SCHOLAR", "count": 29, "variants": ["Oltmanns", "M. Oltmanns"], "contexts": ["calculated area in 1806", "collaborator in observations"]}, {"entity_id": "oltmanns", "book_id": "kosmos_humboldt_1845", "name": "Oltmanns", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Oltmanns"], "contexts": ["fellow-laborer of the author"]}, {"entity_id": "oltmanns,_herr", "book_id": "kosmos_humboldt_1845", "name": "Oltmanns, Herr", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Oltmanns, Herr"], "contexts": ["observed declination needle with Humboldt"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Oltmanns", "target_book": "kosmos_humboldt_1845", "target_name": "Oltmanns", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Oltmanns", "target_book": "kosmos_humboldt_1845", "target_name": "Oltmanns, Herr", "similarity": 0.853}], "id": 1651, "stable_key": "clu_7a2ab8eb4ebb7282", "ground_truth": {"modern_name": "Georg Simon Ohm", "confidence": "high", "type": "person", "birth_year": 1789, "death_year": 1854, "description": "German physicist known for Ohm's law on electrical resistance.", "note": "While the text mentions 'Oltmanns', the context of calculations, scientific collaboration with Humboldt (who was interested in magnetism and earth sciences), and the era strongly suggests Georg Simon Ohm. The spelling variation is likely an OCR error or a transcription inconsistency.", "wikidata_id": "Q1503440", "wikidata_description": "education organization in Nuremberg, Germany", "wikipedia_url": "https://en.wikipedia.org/wiki/Technische%20Hochschule%20N%C3%BCrnberg", "wikipedia_extract": "The Technische Hochschule Nürnberg Georg Simon Ohm  (shortened TH Nürnberg; English name Nuremberg Institute of Technology Georg Simon Ohm) is a public Technische Hochschule in Nuremberg, Bavaria. With its 12,200 students and 1,800 faculty members, it is the second biggest Technische Hochschule in Bavaria. President is Niels Oberbeck. The university got its name in honor of Georg Simon Ohm who was a professor and headmaster of the predecessor of the Hochschule, the Polytechnische Schule, between 1839 and 1849. The logo of the Technische Hochschule is the Ω as a reference to Ohm the SI derived unit for electric resistance named after Georg Simon Ohm. The main campus is located around the Wöhrder Wiese city park close to  Nuremberg's downtown area."}, "cross_references": [{"found_name": "Oersted", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2447, "target_cluster_name": "Oersted", "source_book": "llm_generated", "evidence_snippet": "Both were instrumental in the development of understanding electricity. Ohm's law, which describes the relationship between voltage, current, and resistance, is a fundamental concept in electrical circuits, building upon the discoveries of Oersted and others.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were instrumental in the development of understanding electricity. Ohm's law, which describes the relationship between voltage, current, and resistance, is a fundamental concept in electrical circuits, building upon the discoveries of Oersted and others.", "is_reverse": true}]}, {"canonical_name": "alporcas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 31, "members": [{"entity_id": "alporcas", "book_id": "coloquios_da_orta_1563", "name": "alporcas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["alporcas"], "contexts": ["treated with dry anacardo as caustic", "skin eruptions"]}, {"entity_id": "alporcas", "book_id": "polyanthea_medicinal", "name": "alporcas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 28, "variants": ["alporcas", "Alporcas", "alporquentos"], "contexts": ["condition treated by remedy", "scrofula"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "alporcas", "target_book": "polyanthea_medicinal", "target_name": "alporcas", "similarity": 1.0}], "id": 1652, "stable_key": "clu_3c0c97137021a413", "ground_truth": {"modern_name": "Chancroid", "confidence": "medium", "type": "disease", "modern_term": "Chancroid", "note": "The term 'alporcas' is difficult to definitively identify. Given the context of being treated with a caustic and being a condition, it could refer to a variety of skin ulcerations or venereal diseases. Chancroid is a possibility due to its ulcerating nature, but other interpretations exist.", "wikidata_id": "Q31798", "wikidata_description": "sexually transmitted bacterial infection in humans", "wikipedia_url": "https://en.wikipedia.org/wiki/Chancroid", "wikipedia_extract": "Chancroid ( SHANG-kroyd) is a bacterial sexually transmitted infection characterized by painful sores on the genitalia. Chancroid is a bacterial infection caused by the fastidious Gram-negative streptobacillus Haemophilus ducreyi. Chancroid is known to spread from one individual to another solely through sexual contact. However, there have been reports of accidental infection through the hand. These are only local and no systemic manifestations are present. The ulcer characteristically: Ranges in size dramatically from 3 to 50 mm (1/8 inch to 2 inches) across Has sharply defined, undermined borders Has irregular or ragged borders, described as saucer-shaped."}, "cross_references": [{"found_name": "morbo napolitano", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2860, "target_cluster_name": "morbo napolitano", "source_book": "llm_generated", "evidence_snippet": "Chancroid is a sexually transmitted infection that can present with genital ulcers, similar to the primary lesion of syphilis (chancre). Historically, differentiating between these conditions could be challenging.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Chancroid is a sexually transmitted infection that can present with genital ulcers, similar to the primary lesion of syphilis (chancre). Historically, differentiating between these conditions could be challenging.", "is_reverse": true}]}, {"canonical_name": "mel rosado", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 31, "members": [{"entity_id": "mel_rosado", "book_id": "coloquios_da_orta_1563", "name": "mel rosado", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["mel rosado"], "contexts": ["rose honey, an ingredient", "rose-infused honey"]}, {"entity_id": "mel_rosado", "book_id": "polyanthea_medicinal", "name": "mel rosado", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 29, "variants": ["mel rosado", "Mel rofado", "mel Rosado", "mel Roſado", "mel rofado", "mel rosadocoado", "mel roſado", "melRoſado"], "contexts": ["rose-flavored honey used to make electuary", "medicinal preparation"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "mel rosado", "target_book": "polyanthea_medicinal", "target_name": "mel rosado", "similarity": 1.0}], "id": 1653, "stable_key": "clu_9cb5175ef2c6b92e", "ground_truth": {"modern_name": "Rose Honey", "confidence": "high", "type": "substance", "description": "Honey infused with roses, used medicinally.", "wikipedia_extract": "Honey is a sweet and viscous substance made by several species of bees, the best-known of which are honey bees. Honey is made and stored to nourish bee colonies. Bees produce honey by gathering and then refining the sugary secretions of plants (primarily floral nectar) or the secretions of other insects, like the honeydew of aphids. This refinement takes place both within individual bees, through regurgitation and enzymatic activity, and during storage in the hive, through water evaporation that concentrates the honey's sugars until it is thick and viscous. Honey bees stockpile honey in the hive. Within the hive is a structure made from wax called honeycomb."}, "cross_references": [{"found_name": "olio rosato", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 987, "target_cluster_name": "olio rosato", "source_book": "llm_generated", "evidence_snippet": "This is a preparation made with honey and rose, indicating a close association with rose products.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: This is a preparation made with honey and rose, indicating a close association with rose products.", "is_reverse": true}, {"found_name": "Oximel", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 671, "target_cluster_name": "Oximel", "source_book": "llm_generated", "evidence_snippet": "Rose Honey is a specific type of honey, a key ingredient in Oxymel, suggesting a direct relationship as a potential variant or component.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Rose Honey is a specific type of honey, a key ingredient in Oxymel, suggesting a direct relationship as a potential variant or component.", "is_reverse": true}, {"found_name": "Nectar", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2368, "target_cluster_name": "Nectar", "source_book": "llm_generated", "evidence_snippet": "Nectar is the primary source material from which bees produce honey, including rose honey.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Nectar is the primary source material from which bees produce honey, including rose honey."}, {"found_name": "açucare rosado", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2627, "target_cluster_name": "açucare rosado", "source_book": "llm_generated", "evidence_snippet": "Rose sugar is a component of Rose Honey.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Rose sugar is a component of Rose Honey.", "is_reverse": true}]}, {"canonical_name": "cozimento", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 31, "members": [{"entity_id": "cottura", "book_id": "ricettario_fiorentino_1597", "name": "cottura", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["cottura"], "contexts": ["cooking process"]}, {"entity_id": "cozimento", "book_id": "polyanthea_medicinal", "name": "cozimento", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 30, "variants": ["cozimento"], "contexts": ["digestion process", "decoction preparation"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "cottura", "target_book": "polyanthea_medicinal", "target_name": "cozimento", "similarity": 0.88}], "id": 1654, "stable_key": "clu_7e21839fe0b6ada7", "ground_truth": {"modern_name": "Cooking", "confidence": "high", "type": "concept", "description": "Process of preparing food by applying heat.", "note": "Includes both the act of cooking and methods of preparing medicinal decoctions.", "wikipedia_extract": "Cooking, also known as cookery, is the art, science and craft of using heat to make food more palatable, digestible, nutritious, or safe. Cooking techniques and ingredients vary widely, from grilling food over an open fire, to using electric stoves, to baking in various types of ovens, to boiling  and blanching in water, reflecting local conditions, techniques and traditions. Cooking is an aspect of all human societies and a cultural universal. Types of cooking also depend on the skill levels and training of the cooks. Cooking is done both by people in their own dwellings and by professional cooks and chefs in restaurants and other food establishments. The term \"culinary arts\" usually refers to cooking that is primarily focused on the aesthetic beauty of the presentation and taste of the food."}, "cross_references": [{"found_name": "Ulmeiro", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 3691, "target_cluster_name": "Olmo", "source_book": "polyanthea_medicinal", "evidence_snippet": "nafcem as moſcas ;& tem differentes nomes , porque huns the chamão Ulmeiro , outros Choupo , outros Salgueiro. A entrecaſca do pao do Ulmeiro cura o feu cozimento todas aschagas interiores,& exteriore", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for"}, {"found_name": "Choupo", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1215, "target_cluster_name": "Poplar", "source_book": "polyanthea_medicinal", "evidence_snippet": "nafcem as moſcas ;& tem differentes nomes , porque huns the chamão Ulmeiro , outros Choupo , outros Salgueiro. A entrecaſca do pao do Ulmeiro cura o feu cozimento todas aschagas interiores,& exteriore", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym 