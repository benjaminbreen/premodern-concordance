s_humboldt_1845", "name": "Hallaschka", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Hallaschka"], "contexts": ["source for mountain elevation"]}, {"entity_id": "kendal", "book_id": "kosmos_humboldt_1845", "name": "Kendal", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Kendal"], "contexts": ["observer of sky"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Hankel", "target_book": "kosmos_humboldt_1845", "target_name": "Hallaschka", "similarity": 0.852}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Hankel", "target_book": "kosmos_humboldt_1845", "target_name": "Kendal", "similarity": 0.854}], "id": 3549, "stable_key": "clu_b4cc70e5665fa9f5", "ground_truth": {"modern_name": "Hermann Hankel", "confidence": "medium", "type": "person", "birth_year": 1839, "death_year": 1873, "description": "German mathematician, studied reaction times.", "note": "The references to 'Hankel', 'Hallaschka', and 'Kendal' are problematic. 'Hallaschka' might refer to a person, but 'Kendal' could be a place or a person. Given 'Hankel' is explicitly named and often associated with mathematics and reaction times, this identification is the most plausible, though the other names are less clear and might be errors or less prominent figures.", "wikidata_id": "Q61038", "wikidata_description": "German mathematician (1839–1873)"}, "cross_references": []}, {"canonical_name": "respiratory muscles", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "respiratory_movements", "book_id": "principles_of_psychology_james_1890", "name": "respiratory movements", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["respiratory movements"], "contexts": ["form regularly recurring sensations"]}, {"entity_id": "respiratory_muscles", "book_id": "first_principles_spencer_1862", "name": "respiratory muscles", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["respiratory muscles"], "contexts": ["muscles involved in breathing"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "respiratory movements", "target_book": "first_principles_spencer_1862", "target_name": "respiratory muscles", "similarity": 0.889}], "id": 3550, "stable_key": "clu_c29310d9f42eaf12", "ground_truth": {"modern_name": "respiratory muscles", "confidence": "high", "type": "concept", "wikidata_id": "Q754337", "wikidata_description": "muscles involved in breathing", "wikipedia_url": "https://en.wikipedia.org/wiki/Muscles%20of%20respiration", "wikipedia_extract": "The muscles of respiration are the muscles that contribute to inhalation and exhalation, by aiding in the expansion and contraction of the thoracic cavity. The diaphragm and, to a lesser extent, the intercostal muscles drive respiration during quiet breathing. The elasticity of these muscles is crucial to the health of the respiratory system and to maximize its functional capabilities. The diaphragm is the major muscle responsible for breathing. It is a thin, dome-shaped muscle that separates the abdominal cavity from the thoracic cavity. During inhalation, the diaphragm contracts, so that its center moves caudally (downward) and its edges move cranially (upward)."}, "cross_references": []}, {"canonical_name": "optics", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "optic", "book_id": "principles_of_psychology_james_1890", "name": "optic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["optic"], "contexts": ["relating to the sense of sight"]}, {"entity_id": "optics", "book_id": "connexion_physical_sciences_somerville_1858", "name": "optics", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["optics"], "contexts": ["branch of physics studying light", "branch of physics dealing with light"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "optic", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "optics", "similarity": 0.893}], "id": 3551, "stable_key": "clu_7f246d8fbaca1b90", "ground_truth": {"modern_name": "optics", "confidence": "high", "type": "concept", "wikidata_id": "Q14620", "wikidata_description": "branch of physics concerning light", "wikipedia_url": "https://en.wikipedia.org/wiki/Optics", "wikipedia_extract": "Optics is the branch of physics that studies the behaviour, manipulation, and detection of electromagnetic radiation, including its interactions with matter and instruments that use or detect it. Optics usually describes the behaviour of visible, ultraviolet, and infrared light. The study of optics extends to other forms of electromagnetic radiation, including radio waves, microwaves, and X-rays. The term optics is also applied to technology for manipulating beams of elementary charged particles. Most optical phenomena can be accounted for by using the classical electromagnetic description of light, however, complete electromagnetic descriptions of light are often difficult to apply in practice. Practical optics is usually done using simplified models."}, "cross_references": []}, {"canonical_name": "atomistic philosophy", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "atomistic_philosophy", "book_id": "principles_of_psychology_james_1890", "name": "atomistic philosophy", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["atomistic philosophy"], "contexts": ["Philosophy concerning elementary particles"]}, {"entity_id": "atomic_theory", "book_id": "principles_of_psychology_james_1890", "name": "atomic theory", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["atomic theory"], "contexts": ["physics theory of fundamental particles"]}, {"entity_id": "atomic_theory", "book_id": "connexion_physical_sciences_somerville_1858", "name": "atomic theory", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["atomic theory"], "contexts": ["theory of matter composed of atoms"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "atomistic philosophy", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "atomic theory", "similarity": 0.919}, {"source_book": "principles_of_psychology_james_1890", "source_name": "atomic theory", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "atomic theory", "similarity": 1.0}], "id": 3552, "stable_key": "clu_b3445ae5e919709c", "ground_truth": {"modern_name": "Atomic theory", "confidence": "high", "type": "concept", "wikidata_id": "Q210553", "wikidata_description": "history of scientific theory that views matter as made up of atoms of chemical elements", "wikipedia_extract": "This list includes well-known general theories in science and pre-scientific natural history and natural philosophy that have since been superseded by other scientific theories. Many discarded explanations were once supported by a scientific consensus, but replaced after more empirical information became available that identified flaws and prompted new theories which better explain the available data. Pre-modern explanations originated before the scientific method, with varying degrees of empirical support. Some scientific theories are discarded in their entirety, such as the replacement of the phlogiston theory by energy and thermodynamics. Some theories known to be incomplete or in some ways incorrect are still used. For example, Newtonian classical mechanics is accurate enough for practical calculations at everyday distances and velocities, and it is still taught in schools.", "wikipedia_url": "https://en.wikipedia.org/wiki/History_of_atomic_theory"}, "cross_references": [{"found_name": "physics", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 110, "target_cluster_name": "physics", "source_book": "llm_generated", "evidence_snippet": "Atomic theory is a cornerstone of physics, explaining the behavior of matter at the microscopic level.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Atomic theory is a cornerstone of physics, explaining the behavior of matter at the microscopic level.", "is_reverse": true}, {"found_name": "chemical composition", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 449, "target_cluster_name": "chemical composition", "source_book": "llm_generated", "evidence_snippet": "Atomic theory provides the framework for understanding how atoms combine to form chemical compositions.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Atomic theory provides the framework for understanding how atoms combine to form chemical compositions.", "is_reverse": true}, {"found_name": "chemical combination", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 781, "target_cluster_name": "chemical combination", "source_book": "llm_generated", "evidence_snippet": "Atomic theory provides the theoretical framework for understanding how and why chemical combinations occur.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Atomic theory provides the theoretical framework for understanding how and why chemical combinations occur.", "is_reverse": true}, {"found_name": "chemical action", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1769, "target_cluster_name": "chemical action", "source_book": "llm_generated", "evidence_snippet": "Atomic theory provides the theoretical framework for understanding how atoms interact in chemical reactions.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Atomic theory provides the theoretical framework for understanding how atoms interact in chemical reactions.", "is_reverse": true}]}, {"canonical_name": "functional activity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "functional_activity", "book_id": "principles_of_psychology_james_1890", "name": "functional activity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["functional activity"], "contexts": ["operation of a system or organ"]}, {"entity_id": "functional_activity", "book_id": "first_principles_spencer_1862", "name": "functional activity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["functional activity"], "contexts": ["activity of living organisms", "operation of bodily functions"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "functional activity", "target_book": "first_principles_spencer_1862", "target_name": "functional activity", "similarity": 1.0}], "id": 3553, "stable_key": "clu_0e6625368a467429", "ground_truth": {"modern_name": "functional activity", "confidence": "high", "type": "concept"}, "cross_references": []}, {"canonical_name": "Alma racional", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "rational_soul", "book_id": "principles_of_psychology_james_1890", "name": "rational soul", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["rational soul"], "contexts": ["spiritual part of humans for higher acts"]}, {"entity_id": "alma_racional", "book_id": "polyanthea_medicinal", "name": "Alma racional", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["alma racional", "Alma racional"], "contexts": ["rational soul", "soul infused into the body"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "rational soul", "target_book": "polyanthea_medicinal