: "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2805, "target_cluster_name": "positivistic", "source_book": "llm_generated", "evidence_snippet": "A key aim of positivism is to discover general laws that govern phenomena, based on empirical evidence.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: A key aim of positivism is to discover general laws that govern phenomena, based on empirical evidence.", "is_reverse": true}]}, {"canonical_name": "Scholars", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "scholars", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Scholars", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Scholars"], "contexts": ["individuals engaged in academic study", "learned individuals"]}, {"entity_id": "scholars", "book_id": "principles_of_psychology_james_1890", "name": "scholars", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["scholars"], "contexts": ["learned individuals"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Scholars", "target_book": "principles_of_psychology_james_1890", "target_name": "scholars", "similarity": 0.946}], "id": 3236, "stable_key": "clu_787c608d8c761d64", "ground_truth": {"modern_name": "Scholars", "confidence": "high", "type": "concept", "note": "This cluster refers to the general concept of learned individuals rather than specific historical figures."}, "cross_references": [{"found_name": "Camerarius", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2350, "target_cluster_name": "Camerarius", "source_book": "llm_generated", "evidence_snippet": "Joachim Camerarius was a prominent classical scholar.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Joachim Camerarius was a prominent classical scholar.", "is_reverse": true}]}, {"canonical_name": "Taurus", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "taurus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Taurus", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Taurus"], "contexts": ["servant of Minos", "ship or pilot name"]}, {"entity_id": "taurus", "book_id": "polyanthea_medicinal", "name": "Taurus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Taurus"], "contexts": ["author of fol. 565."]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Taurus", "target_book": "polyanthea_medicinal", "target_name": "Taurus", "similarity": 0.868}], "id": 3237, "stable_key": "clu_dabd3f259d385654", "ground_truth": {"modern_name": "Taurus", "confidence": "medium", "type": "person", "description": "Mythological figure, possibly a historical or literary reference.", "note": "In the context of King Minos, 'Taurus' likely refers to the Minotaur or a related figure, not a specific historical person. The other context might refer to a different Taurus.", "wikidata_id": "Q10570", "wikidata_description": "zodiac constellation straddling the celestial equator", "wikipedia_url": "https://en.wikipedia.org/wiki/Taurus_%28constellation%29", "wikipedia_extract": "The German Taurus controversy refers to an ongoing political controversy starting in Summer 2023 surrounding the delivery of Bundeswehr Taurus cruise missiles to Ukraine. After the Russian invasion of Ukraine began in 2022, the Ukrainian government asked Germany in 2023 to deliver the German-Swedish air-to-ground cruise missiles. In Spring 2024, the majority of the government and parliament, as well as many surveyed sections of the population, spoke out against the delivery of Taurus missiles to Ukraine. Former German Chancellor Olaf Scholz (SPD) was strongly opposed to the delivery of Taurus missiles to Ukraine, as he feared that sending such weapons could result in an escalation in the conflict. This could lead to the country being drawn into the war as a hostile party, particularly because the Taurus has a range that extends deep into Russian territory (including Moscow) and can only be limited with Bundeswehr soldiers on site. Like the Chancellor, many members of the SPD reject its delivery; politicians from the Greens and the FDP as well as other sections of the SPD have called for its delivery."}, "cross_references": []}, {"canonical_name": "Salmasius", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 1, "total_mentions": 2, "members": [{"entity_id": "salmasius", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Salmasius", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Salmasius"], "contexts": ["scholar who commented on Pliny", "commentator on Pliny"]}], "edges": [], "id": 3238, "stable_key": "clu_5518db8305e42a91", "ground_truth": {"modern_name": "Claude Saumaise", "confidence": "high", "type": "person", "birth_year": 1588, "death_year": 1653, "description": "French classical scholar and critic, commentator on Pliny.", "wikidata_id": "Q605328", "wikidata_description": "French classical scholar, writer and professor in Leiden (1588-1653)"}, "cross_references": []}, {"canonical_name": "Ardoynus", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "ardoynus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Ardoynus", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Ardoynus"], "contexts": ["modern author who used traditions of poisons and antidotes", "author on natural history"]}, {"entity_id": "ardonius", "book_id": "historia_medicinal_monardes_1574", "name": "Ardonius", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Ardonius"], "contexts": ["Italian physician, praised Bezoar stone"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Ardoynus", "target_book": "historia_medicinal_monardes_1574", "target_name": "Ardonius", "similarity": 0.85}], "id": 3239, "stable_key": "clu_3860238061283a68", "ground_truth": {"modern_name": "Nicolaus Ardoin", "confidence": "high", "type": "person", "description": "Italian physician and scholar, praised bezoar stones.", "note": "The spelling 'Ardoynus' and 'Ardonius' are variants of the same name."}, "cross_references": []}, {"canonical_name": "Phoenix", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "phoenix", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Phoenix", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Phoenix"], "contexts": ["mythical bird used in arguments", "mythological bird mentioned by poets"]}, {"entity_id": "phoenix", "book_id": "coloquios_da_orta_1563", "name": "Phoenix", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Phoenix"], "contexts": ["mythical bird burning in fire"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Phoenix", "target_book": "coloquios_da_orta_1563", "target_name": "Phoenix", "similarity": 1.0}], "id": 3240, "stable_key": "clu_2502712c4b33cdb6", "ground_truth": {"modern_name": "Phoenix", "confidence": "high", "type": "animal", "note": "Referenced as a mythical creature.", "wikidata_id": "Q27685", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Phoenix%20%28plant%29", "wikipedia_extract": "Phoenix is a genus of 14 species of palms, native to an area starting from the Canary Islands in the west, across northern and central Africa, to the extreme southeast of Europe (Crete), and continuing throughout southern Asia, from Anatolia east to southern China and Malaysia. The diverse habitats they occupy include swamps, deserts, and mangrove sea coasts. Most Phoenix species originate in semi-arid regions, but usually occur near high groundwater levels, rivers, or springs. The genus is unusual among members of subfamily Coryphoideae in having pinnate, rather than palmate leaves; tribe Caryoteae also have pinnate or bipinnate leaves. The palms were more numerous and widespread in the past than they are at present. Some Phoenix palms have become naturalised in other parts of the world; in particular, the date palm's long history of cultivation means that escaped plants in the past have long-since become ingrained into the native ecosystems of countries far from its original range in the Middle East."}, "cross_references": [{"found_name": "Ostrich", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 881, "target_cluster_name": "Ostrich", "source_book": "llm_generated", "evidence_snippet": "The phoenix is a mythical bird often associated with ostriches due to their size and exotic nature in some historical contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The phoenix is a mythical bird often associated with ostriches due to their size and exotic nature in some historical contexts.", "is_reverse": true}]}, {"canonical_name": "Tobias", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "tobias", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Tobias", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Tobias"], "contexts": ["biblical figure"]}, {"entity_id": "tobias", "book_id": "polyanthea_medicinal", "name": "Tobias", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Tobias"], "contexts": ["Biblical figure"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Tobias", "target_book": "polyanthea_medicinal", "target_name": "Tobias", "similarity": 0.827}], "id": 3241, "stable_key": "clu_6d242262d777ea8e", "ground_truth": {"moder