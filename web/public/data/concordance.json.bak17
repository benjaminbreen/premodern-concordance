ory": "OTHER_PLANT", "count": 1, "variants": ["Tree-Moss"], "contexts": ["type of moss"]}, {"entity_id": "moss", "book_id": "kosmos_humboldt_1845", "name": "moss", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["moss"], "contexts": ["small, non-flowering plant"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "mosses", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "mosses", "similarity": 1.0}], "id": 2317, "stable_key": "clu_9dbe167e02e8454f-2", "ground_truth": {"modern_name": "moss", "confidence": "high", "type": "plant", "note": "Early modern texts often referred to mosses collectively without specific taxonomic classification.", "wikidata_id": "Q25347", "wikidata_description": "division of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Moss", "wikipedia_extract": "Mosses are small, non-vascular flowerless plants in the taxonomic division Bryophyta (, ) sensu stricto. Bryophyta (sensu lato, Schimp. 1879) may also refer to the parent group bryophytes, which comprise liverworts, mosses, and hornworts. Mosses typically form dense green clumps or mats, often in damp or shady locations. The individual plants are usually composed of simple leaves that are generally only one cell thick, attached to a stem that may be branched or unbranched and has only a limited role in conducting water and nutrients. Although some species have conducting tissues, these are generally poorly developed and structurally different from similar tissue found in vascular plants. Mosses do not have seeds and after fertilisation develop sporophytes with unbranched stalks topped with single capsules containing spores."}, "member_count": 7, "cross_references": [{"found_name": "liverwort", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2888, "target_cluster_name": "epatica", "source_book": "llm_generated", "evidence_snippet": "Liverworts are closely related to mosses, often grouped together in the division Bryophyta (sensu lato).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Liverworts are closely related to mosses, often grouped together in the division Bryophyta (sensu lato)."}, {"found_name": "Algae", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 957, "target_cluster_name": "algæ", "source_book": "llm_generated", "evidence_snippet": "Algae are simple aquatic plants, and historical classifications sometimes grouped them with or near bryophytes like mosses due to their non-vascular nature and aquatic/moist habitats.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Algae are simple aquatic plants, and historical classifications sometimes grouped them with or near bryophytes like mosses due to their non-vascular nature and aquatic/moist habitats."}, {"found_name": "Fucus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2402, "target_cluster_name": "fucus", "source_book": "llm_generated", "evidence_snippet": "Fucus is a genus of brown algae, which are aquatic plants. Historically, the classification of aquatic and terrestrial lower plants could be fluid, and Fucus might appear in contexts discussing simple plant life alongside mosses.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Fucus is a genus of brown algae, which are aquatic plants. Historically, the classification of aquatic and terrestrial lower plants could be fluid, and Fucus might appear in contexts discussing simple plant life alongside mosses."}, {"found_name": "Polypody", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 666, "target_cluster_name": "Polipodio", "source_book": "pseudodoxia_epidemica_browne_1646", "evidence_snippet": "shape, and maintains a regular figure; like other supercrescences, and such as living upon the stock of others, are termed parasitical Plants, as Polypody, Moss, the smaller Capillaries, and many more", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "a type of parasitical plant"}, {"found_name": "India", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 17, "target_cluster_name": "India", "source_book": "pseudodoxia_epidemica_browne_1646", "evidence_snippet": "shape, and maintains a regular figure; like other supercrescences, and such as living upon the stock of others, are termed parasitical Plants, as Polypody, Moss, the smaller Capillaries, and many more", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "a region producing a specific type of Mistletoe"}, {"found_name": "America", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1, "target_cluster_name": "America", "source_book": "pseudodoxia_epidemica_browne_1646", "evidence_snippet": "shape, and maintains a regular figure; like other supercrescences, and such as living upon the stock of others, are termed parasitical Plants, as Polypody, Moss, the smaller Capillaries, and many more", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "a region producing a specific type of Mistletoe"}, {"found_name": "Capillaries", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "pseudodoxia_epidemica_browne_1646", "evidence_snippet": "shape, and maintains a regular figure; like other supercrescences, and such as living upon the stock of others, are termed parasitical Plants, as Polypody, Moss, the smaller Capillaries, and many more", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "a type of parasitical plant"}]}, {"canonical_name": "Padua", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "padua", "book_id": "kosmos_humboldt_1845", "name": "Padua", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Padua"], "contexts": ["city in Italy", "city with high annual temperature"]}, {"entity_id": "padua", "book_id": "polyanthea_medicinal", "name": "Padua", "category": "PLACE", "subcategory": "CITY", "count": 6, "variants": ["Padua"], "contexts": ["city where Alexandre Maflaria lectured", "city where Augenio was professor"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Padua", "target_book": "polyanthea_medicinal", "target_name": "Padua", "similarity": 1.0}], "id": 2318, "stable_key": "clu_46c4ec3187b24f34", "ground_truth": {"modern_name": "Padua", "confidence": "high", "type": "place", "description": "A historic city in Italy, known for its university and academic figures.", "wikipedia_extract": "Padua ( PAD-ew-ə) is a city and comune (municipality) in Veneto, northern Italy, and the capital of the province of Padua. The city lies on the banks of the river Bacchiglione, 40 kilometres (25 miles) west of Venice and 29 km (18 miles) southeast of Vicenza. With a population of 207,694 as of 2025, Padua is the third-largest city in Veneto. It is also the economic and communications hub of the area. Padua is sometimes included, with Venice and Treviso, in the Padua-Treviso-Venice Metropolitan Area (PATREVE), which has a population of around 2,600,000. Besides the Bacchiglione, the Brenta River, which once ran through the city, still touches the northern districts."}, "cross_references": [{"found_name": "Venice", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 170, "target_cluster_name": "Venezia", "source_book": "llm_generated", "evidence_snippet": "Padua is geographically located near Venice.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Padua is geographically located near Venice."}]}, {"canonical_name": "Seaweeds", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 8, "members": [{"entity_id": "weeds_of_the_sea", "book_id": "kosmos_humboldt_1845"