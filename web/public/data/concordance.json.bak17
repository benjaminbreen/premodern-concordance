stable_key": "clu_a52107fa66920a23", "ground_truth": {"modern_name": "Mattioli", "confidence": "high", "type": "person", "description": "An influential early modern physician and botanist.", "note": "Corrected spelling from 'Mathiolus'/'Matthioli'/'Mathiolo'.", "wikipedia_extract": "Mattioli is an Italian surname. Notable people with the surname include: Alessandro Mattioli (born 1998), Italian footballer Carlo Mattioli (born 1954), Italian race walker Denise Mattioli (born 1952), Brazilian volleyball player Ercole Antonio Mattioli (1640–1694), Italian minister Gaspare Mattioli (1806–1843), Italian painter Gianni Francesco Mattioli (born 1940), Italian politician and university professor Girolamo Mattioli (fl."}, "cross_references": [{"found_name": "Amato Lusitano", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2328, "target_cluster_name": "Amato Lusitano", "source_book": "llm_generated", "evidence_snippet": "Both Amato Lusitano and Mattioli were prominent Italian physicians and botanists of the Renaissance period. They were contemporaries and their contributions to medicine and the study of plants were significant.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both Amato Lusitano and Mattioli were prominent Italian physicians and botanists of the Renaissance period. They were contemporaries and their contributions to medicine and the study of plants were significant."}, {"found_name": "Amatus Lusitanus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1620, "target_cluster_name": "Amatus Lusitanus", "source_book": "llm_generated", "evidence_snippet": "Both Amatus Lusitanus and Mattioli were prominent Italian physicians and botanists of the Renaissance period. They were contemporaries and their contributions to medicine and the study of plants were significant.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both Amatus Lusitanus and Mattioli were prominent Italian physicians and botanists of the Renaissance period. They were contemporaries and their contributions to medicine and the study of plants were significant."}, {"found_name": "Dioscorides", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 33, "target_cluster_name": "Dioscorides", "source_book": "llm_generated", "evidence_snippet": "Mattioli is famous for his commentaries on Dioscorides' De Materia Medica, a foundational text in ancient pharmacology. His work significantly expanded and interpreted Dioscorides' original writings for a Renaissance audience.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Mattioli is famous for his commentaries on Dioscorides' De Materia Medica, a foundational text in ancient pharmacology. His work significantly expanded and interpreted Dioscorides' original writings for a Renaissance audience."}, {"found_name": "Galen", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 29, "target_cluster_name": "Galen", "source_book": "llm_generated", "evidence_snippet": "Mattioli, like many physicians of his era, built upon and commented on the extensive medical works of Galen, the most influential physician of antiquity. Mattioli's own contributions often engaged with or expanded upon Galenic principles.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Mattioli, like many physicians of his era, built upon and commented on the extensive medical works of Galen, the most influential physician of antiquity. Mattioli's own contributions often engaged with or expanded upon Galenic principles."}, {"found_name": "Hippocrates", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 31, "target_cluster_name": "Hippocrates", "source_book": "llm_generated", "evidence_snippet": "Mattioli, as a significant figure in Renaissance medicine, would have been deeply familiar with and influenced by the foundational medical theories and writings attributed to Hippocrates, the 'father of medicine'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Mattioli, as a significant figure in Renaissance medicine, would have been deeply familiar with and influenced by the foundational medical theories and writings attributed to Hippocrates, the 'father of medicine'."}, {"found_name": "Pliny the Elder", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 202, "target_cluster_name": "Plinio", "source_book": "llm_generated", "evidence_snippet": "Mattioli's work, particularly his commentaries on Dioscorides, often referenced and engaged with Pliny the Elder's Naturalis Historia, another crucial source of ancient knowledge about natural history and medicine that was widely consulted during the Renaissance.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Mattioli's work, particularly his commentaries on Dioscorides, often referenced and engaged with Pliny the Elder's Naturalis Historia, another crucial source of ancient knowledge about natural history and medicine that was widely consulted during the Renaissance."}, {"found_name": "Capivatius", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1906, "target_cluster_name": "Capivatius", "source_book": "llm_generated", "evidence_snippet": "Both were prominent physicians and botanists of the 16th century, known for their contributions to medical and natural history texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were prominent physicians and botanists of the 16th century, known for their contributions to medical and natural history texts.", "is_reverse": true}, {"found_name": "Rupture", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "english_physician_1652", "evidence_snippet": "Urine when it is stopped,* 8.509 and to break and drive forth the Stone, which the Pouder of the Bark of the Root taken in Wine performeth effectually. Mathiolus saith, the same helpeth the Diseas cal", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for Hernia Carnosa"}]}, {"canonical_name": "árabes", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 4, "total_mentions": 46, "members": [{"entity_id": "arabes", "book_id": "historia_medicinal_monardes_1574", "name": "Arabes", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 10, "variants": ["Arabes"], "contexts": ["Arab authorities on dragon's blood", "taught about medicinal uses"]}, {"entity_id": "árabes", "book_id": "coloquios_da_orta_1563", "name": "árabes", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 34, "variants": ["árabes", "Arabis", "Arábes", "arabes", "arábes", "Árabes"], "contexts": ["authors whose observations were valued", "conquerors who adopted hemp in Persia"]}, {"entity_id": "arabes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Arabes", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Arabes"], "contexts": ["people who eat worms"]}, {"entity_id": "arab", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Arab", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Arab"], "contexts": ["person from Arab world"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Arabes", "target_book": "coloquios_da_orta_1563", "target_name": "árabes", "similarity": 0.977}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Arabes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Arab", "similarity": 0.971}], "id": 253, "stable_key": "clu_5c68396496440395", "ground_truth": {"modern_name": "Arab", "confidence": "high", "type": "person", "description": "People of Arab origin, often scholars or physicians.", "wikidata_id": "Q35323", "wikidata_description": "Arabic-speaking ethnic and national groups, originally from the Arabian Peninsula", "wikipedia_url": "https://en.wikipedia.org/wiki/Arabs", "wikipedia_extract": "Arabs (Arabic: عَرَب) are an ethnic group mainly inhabiting the Arab world in West Asia and North Africa. A significant Arab diaspora is present in various parts of the world. Before the spread of Arabic language in the wake of the Arab conquests, \"Arab\" largely referred to the Semitic inhabitants—both settled and nomadic—of the Arabian Peninsula and the Syrian Desert. In modern usage, it includes people from across the Greater Middle East that share Arabic as a native language. Arabs have been in the Fertile Crescent for thousands of years. In the 9th century BCE, the Assyrians made written references to Arabs as inhabitants of the Levant, Mesopotamia, and Arabia."}, "cross_references": [{"found_name": "Arab physicians", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 538, "target_cluster_name": "Arábios", "source_book": "llm_generated", "evidence_snippet": "Arab physicians are a specific subset of Arabs who practiced medicine.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Arab physicians are a specific subset of Arabs who practiced medicine."}, {"found_name": "Arab scholars", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2340, "target_cluster_name": "Arabs", "source_book": "llm_generated", "evidence_snippet": "Arab scholars are a specific subset of Arabs who engaged in scholarly pursuits.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Arab scholars are a specific subset of Arabs who engaged in scholarly pursuits."}, {"found_name": "Arábios", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 538, "target_cluster_name": "Arábios", "source_book": "llm_generated", "evidence_snippet": "The entity 'Arab physicians' is a specific group within the broader category of 'Arab'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The entity 'Arab physicians' is a specific group within the broader category of 'Arab'.", "is_reverse": true}, {"found_name": "Mouros", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1557, "target_cluster_name": "Mouros", "source_book": "llm_generated", "evidence_snippet": "The term 'Moors' was often used in medieval and early modern European texts to refer to the Muslim inhabitants of the Iberian Peninsula, who were largely of Arab and Berber descent. Therefore, 'Arab' is a closely related ethno-linguistic group often conflated with or included under the umbrella term 'Moors'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The term 'Moors' was often used in medieval and early modern European texts to refer to the Muslim inhabitants of the Iberian Peninsula, who were largely of Arab and Berber descent. Therefore, 'Arab' is a closely related ethno-linguistic group often conflated with or included under the umbrella term 'Moors'.", "is_reverse": true}, {"found_name": "Arabs", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2340, "target_cluster_name": "Arabs", "source_book": "llm_generated", "evidence_snippet": "The entity 'Arab scholars' is a specific subset of the broader group 'Arab'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The entity 'Arab scholars' is a specific subset of the broader group 'Arab'.", "is_reverse": true}]}, {"canonical_name": "Sugar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 7, "total_mentions": 87, "members": [{"entity_id": "sugar", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Sugar", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["Sugar"], "contexts": ["sweet crystalline substance", "congelation that sinks in thin w