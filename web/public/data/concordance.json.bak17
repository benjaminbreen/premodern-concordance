ap", "link_strength": 0.5, "target_cluster_id": 3227, "target_cluster_name": "celestial body", "source_book": "llm_generated", "evidence_snippet": "Sirius is a star, which is a type of celestial body.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Sirius is a star, which is a type of celestial body."}, {"found_name": "Ecliptic", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1541, "target_cluster_name": "ecliptic", "source_book": "llm_generated", "evidence_snippet": "The ecliptic is the apparent path of the Sun across the sky, and the positions of stars like Sirius are often described in relation to it.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The ecliptic is the apparent path of the Sun across the sky, and the positions of stars like Sirius are often described in relation to it."}]}, {"canonical_name": "Sir William Herschel", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 44, "members": [{"entity_id": "sir_william_herschel", "book_id": "kosmos_humboldt_1845", "name": "Sir William Herschel", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Sir William Herschel"], "contexts": ["subject of analysis of optical considerations", "confirmed speculative conclusions by observation"]}, {"entity_id": "sir_william_herschel", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Sir William Herschel", "category": "PERSON", "subcategory": "SCHOLAR", "count": 22, "variants": ["Sir William Herschel"], "contexts": ["observed satellites in 1789", "discovered two farthest satellites of Uranus"]}, {"entity_id": "william_herschel", "book_id": "kosmos_humboldt_1845", "name": "William Herschel", "category": "PERSON", "subcategory": "SCHOLAR", "count": 9, "variants": ["William Herschel"], "contexts": ["observer of heaven and nebulae", "discovered satellites with telescope"]}, {"entity_id": "john_herschel", "book_id": "kosmos_humboldt_1845", "name": "John Herschel", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["John Herschel"], "contexts": ["saw satellites again at Cape of Good Hope", "author in 'Memoirs of the Astronom. Soc.'"]}, {"entity_id": "william_herschel", "book_id": "connexion_physical_sciences_somerville_1858", "name": "William Herschel", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["William Herschel"], "contexts": ["applied method to binary groups"]}, {"entity_id": "john_herschel", "book_id": "connexion_physical_sciences_somerville_1858", "name": "John Herschel", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["John Herschel"], "contexts": ["telescope used to view nebulæ"]}, {"entity_id": "herschel,_sir_william", "book_id": "kosmos_humboldt_1845", "name": "Herschel, Sir William", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Herschel, Sir William"], "contexts": ["astronomer"]}, {"entity_id": "herschel,_sir_john", "book_id": "kosmos_humboldt_1845", "name": "Herschel, Sir John", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Herschel, Sir John"], "contexts": ["astronomer"]}, {"entity_id": "herschel,_sir_john", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Herschel, Sir John", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Herschel, Sir John"], "contexts": ["proposed theory of volcanic action"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Sir William Herschel", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Sir William Herschel", "similarity": 1.0}], "id": 1701, "stable_key": "clu_f8b84703df6692e3", "ground_truth": {"modern_name": "William Herschel", "confidence": "high", "type": "person", "birth_year": 1738, "death_year": 1822, "description": "Astronomer who discovered Uranus and infrared radiation.", "wikidata_id": "Q3369709", "wikidata_description": "museum in Bath, England, United Kingdom", "wikipedia_url": "https://en.wikipedia.org/wiki/Herschel%20Museum%20of%20Astronomy", "note": "The cluster also mentions 'John Herschel', who was William's son and also an astronomer. Given the context of astronomical discoveries, William is the more prominent figure for general scientific discourse.", "wikipedia_extract": "The Herschel Museum of Astronomy at 19 New King Street, Bath, England, is a museum that was inaugurated in 1981. It is located in a town house that was formerly the home of William Herschel and his sister Caroline. The museum is situated in the former home of the Herschels at 19 New King Street (south side) in Bath, England. The building is a particularly well-preserved small town house of the period. The modest town-house covers five floors, and includes two reception rooms on the ground and first floor. The town house is part of a terrace that was built around 1764-1770."}, "member_count": 9, "cross_references": [{"found_name": "John Herschel", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 554, "target_cluster_name": "Sir John Herschel", "source_book": "llm_generated", "evidence_snippet": "John Herschel was the son of William Herschel and also a prominent astronomer.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "John Herschel was the son of William Herschel and also a prominent astronomer."}]}, {"canonical_name": "Syria", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 25, "members": [{"entity_id": "siria", "book_id": "historia_medicinal_monardes_1574", "name": "Siria", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Siria"], "contexts": ["land where mineral is found"]}, {"entity_id": "syria", "book_id": "coloquios_da_orta_1563", "name": "Syria", "category": "PLACE", "subcategory": "COUNTRY", "count": 24, "variants": ["Syria", "Siria", "Siría", "Syría", "Síria"], "contexts": ["region where cubebs were questioned", "region where 'Musa' was used"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Siria", "target_book": "coloquios_da_orta_1563", "target_name": "Syria", "similarity": 0.965}], "id": 1702, "stable_key": "clu_b7c5d834400f7768", "ground_truth": {"modern_name": "Syria", "confidence": "high", "type": "place", "description": "A region in the Middle East.", "wikipedia_extract": "Syria, officially the Syrian Arab Republic, is a country in West Asia located in the Eastern Mediterranean and the Levant. It borders the Mediterranean Sea to the west, Turkey to the north and northwest, Iraq to the east and southeast, Jordan to the south, and Israel and Lebanon to the southwest. It is a republic under a provisional government and comprises 14 governorates. Damascus is the capital and largest city. With a population of 26 million across an area of 185,180 square kilometres (71,500 sq mi), it is the 56th-most populous and 87th-largest country. The name \"Syria\" historically referred to a wider region."}, "cross_references": [{"found_name": "Palestina", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2231, "target_cluster_name": "Palestina", "source_book": "llm_generated", "evidence_snippet": "Syria is a neighboring region that has historically been closely linked to Palestine, with periods where they were administered together or had significant cultural and political overlap.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Syria is a neighboring region that has historically been closely linked to Palestine, with periods where they were administered together or had significant cultural and political overlap.", "is_reverse": true}, {"found_name": "Damasco", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1001, "target_cluster_name": "Damasco", "source_book": "llm_generated", "evidence_snippet": "Damascus is the capital city of Syria.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Damascus is the capital city of Syria.", "is_reverse": true}, {"found_name": "Alepo", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1804, "target_cluster_name": "Alepo", "source_book": "llm_generated", "evidence_snippet": "Aleppo is described as the largest city in Syria.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Aleppo is described as the largest city in Syria.", "is_reverse": true}, {"found_name": "Judéa", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1971, "target_cluster_name": "Judéa", "source_book": "llm_generated", "evidence_snippet": "Syria is a neighboring historical region that often had intertwined political and cultural histories with Judea.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Syria is a neighboring historical region that often had intertwined political and cultural histories with Judea.", "is_reverse": true}, {"found_name": "Levante", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2619, "target_cluster_name": "Levante", "source_book": "llm_generated", "evidence_snippet": "Syria is a core part of the historical Levant.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Syria is a core part of the historical Levant.", "is_reverse": true}, {"found_name": "Naples", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 349, "target_cluster_name": "Naples", "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "fopra e detto , appreflb à gli Arabi fignifica la Màna foluriua nota ; della quak habbiamo due fpczie . Vna viene di Soria,<8: l'altra del regno di Napoli- quella di Sona è di granella fimilc alla Maf", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "reverse: origin of a type of manna", "is_reverse": true}, {"found_name": "tembul", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "como os outros cheiros ; e postoque Autuario diga que os Mouros lhe chamam tembul, também se enganou como outros. ... RUANO Plinio diz* que o ha em Siria em folhas retortas, donde sae o olio pêra o un", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "alternative name for an herb"}, {"found_name": "alexandrino", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "bem, porém que viesse primeiro da índia á Arábia. E muito bem falão os que o chamão alexandrino, porque dahi vão ter aos Venezianos, e a Beirut e a Tripoli de Suria''. ruâno Pois Menardo diz que o vio", "confidence": 0.65, "auto_label": "contested_identity", "found_relationship": "descriptor for a substance, possibly indicating origin"}]}, {"canonical_name": "elephantes", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 6, "total_mentions": 39, "members": [{"entity_id": "elephantes", "book_id": "coloquios_da_orta_1563", "name": "elephantes", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 23, "variants": ["elephantes", "Elephante", "Elephantes", "Elephat indicux", "elefanta", "elefantes", "elephante"], "contexts": ["elephants found in the forests", "animal carried by Geruda"]}, {"entity_id": "elephante", "book_id": "polyanthea_medicinal", "name": "Elephante", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Elephante", "elefante"], "contexts": ["a large animal", "elephant, fears ants"]}, {"entity_id": "elephant", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Elephant", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 4, "variants": ["Elephant"], "contexts": ["animal with debated joint structure", "animal with unusual leg joints"]}, {"entity_id": "elephant", "book_id": "origin_of_species_darwin_1859", "name": "Elephant", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 7, "variants": ["elephant", "Elephant"], "contexts": ["slowest breeding animal", "large herbivorous mammal"]}, {"entity_id": "elephant", "book_id": "kosmos_humboldt_1845", "name": "elephant", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["elephant"], "contexts": ["extant animal found as fossil"]}, {"entity_id": "elephant", "book_id": "connexion_physical_sciences_somerville_1858", "name": "elephant", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["elephant"], "contexts": ["large mammal from torrid zone", "animal inhabiting the torrid zone"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "elephantes", "target_book": "polyanthea_medicinal", "target_name": "Elephante", "similarity": 0.899}], "id": 1703, "stable_key": "clu_3676de87c334ffdc-2", "ground_truth": {"modern_name": "Elephants", "confidence": "high", "type": "animal", "description": "Large, herbivorous mammals known for their size and strength.", "wikipedia_extract": "Elephants are the largest living land animals. Three living species are currently recognised: the African bush elephant (Loxodonta africana), the African forest elephant (L. cyclotis), and the Asian elephant (Elephas maximus). They are the only surviving members of the family Elephantidae and the order Proboscidea; extinct relatives include mammoths and mastodons. Distinctive features of elephants include a long proboscis called a trunk, tusks, large ear flaps, pillar-like legs, and tough but sensitive grey skin. The trunk is prehensile, bringing food and water to the mouth and grasping objects. Tusks, which are derived from the incisor teeth, serve both as weapons and as tools for moving objects and digging."}, "member_count": 6, "cross_references": [{"found_name": "locsumutri", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "cuidaram que o melhor lacre vinha de Çamatra, e por isso até oje lhe chamam locsumutri, e.este bom lacre nam o ha, senam vem de Pegú ; e asi pôde ser dos elefantes de Çama- tra. RUANO Sam capazes da l", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym"}, {"found_name": "must", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "Orta de que são «muito melancólicos*. Quanto aos «ciúmes», que os fazem cair em «muy grande fíiría», é este um estado perfeitamente conhecido, em que o elephante se torna, o que no Oriente chamam must", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym"}, {"found_name": "musty", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "Orta de que são «muito melancólicos*. Quanto aos «ciúmes», que os fazem cair em «muy grande fíiría», é este um estado perfeitamente conhecido, em que o elephante se torna, o que no Oriente chamam must", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym"}]}, {"canonical_name": "cebola", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 25, "members": [{"entity_id": "cebolas", "book_id": "coloquios_da_orta_1563", "name": "cebolas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["cebolas", "cebola", "cebolla", "cebollas"], "contexts": ["ingredient for flavoring food", "vegetable, onions"]}, {"entity_id": "cebola", "book_id": "polyanthea_medicinal", "name": "cebola", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 17, "variants": ["cebola", "Cebola", "Cebolas", "cebolas", "cebolla", "cebollas"], "contexts": ["plant, onion", "onion, pungent substance causing tears"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "cebolas", "target_book": "polyanthea_medicinal", "target_name": "cebola", "similarity": 0.942}], "id": 1704, "stable_key": "clu_4258944386d586dd", "ground_truth": {"modern_name": "onion", "confidence": "high", "type": "plant", "linnaean": "Allium cepa", "family": "Amaryllidaceae", "description": "A pungent, edible bulb vegetable.", "wikipedia_extract": "The onion (Allium cepa L.Tooltip Carl Linnaeus, from Latin cepa), also known as the bulb onion or common onion, is a vegetable that is the most widely cultivated species of the genus Allium. The shallot is a botanical variety of the onion which was classified as a separate species until 2011. The onion's close relatives include garlic, scallion, leek, and chives. The genus contains several other species variously called onions and cultivated for food, such as the Japanese bunching onion Allium fistulosum, the tree onion Allium × proliferum, and the Canada onion Allium canadense. The name wild onion is applied to a number of Allium species, but A. cepa is exclusively known from cultivation. Its ancestral wild original form is not known, although escapes from cultivation have become established in some regions."}, "cross_references": [{"found_name": "Garlick", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2260, "target_cluster_name": "Garlick", "source_book": "llm_generated", "evidence_snippet": "Onion is a close relative of Garlic, both belonging to the genus Allium.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Onion is a close relative of Garlic, both belonging to the genus Allium.", "is_reverse": true}]}, {"canonical_name": "diaphoreticos", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 2, "total_mentions": 25, "members": [{"entity_id": "diaphoretic", "book_id": "coloquios_da_orta_1563", "name": "diaphoretic", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["diaphoretic"], "contexts": ["medicinal property of 'folio indo'"]}, {"entity_id": "diaphoreticos", "book_id": "polyanthea_medicinal", "name": "diaphoreticos", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 21, "variants": ["diaphoreticos", "Diaphoresis", "Diaphoreticos"], "contexts": ["inducing sweating as treatment", "medicines causing sweating"]}, {"entity_id": "diaphoretico", "book_id": "polyanthea_medicinal", "name": "diaphoretico", "category": "CONCEPT", "subcategory": "QUALITY", "count": 3, "variants": ["diaphoretico"], "contexts": ["promoting sweat"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "diaphoretic", "target_book": "polyanthea_medicinal", "target_name": "diaphoreticos", "similarity": 0.938}, {"source_book": "coloquios_da_orta_1563", "source_name": "diaphoretic", "target_book": "polyanthea_medicinal", "target_name": "diaphoretico", "similarity": 0.966}], "id": 1705, "stable_key": "clu_22144e49f4c679b7", "ground_truth": {"modern_name": "Diaphoretic", "confidence": "high", "type": "concept", "wikidata_id": "Q2998108", "wikidata_description": "clade including Archaeplastida (plants, red algae, green algae, glaucophytes) and Chromalveolata (kelp, water moulds, ciliates, dinoflagellates, etc)", "wikipedia_url": "https://en.wikipedia.org/wiki/Corticata", "wikipedia_extract": "Corticata (\"one with a cortex\"), in the classification of eukaryotes (living organisms with a cell nucleus), is a superkingdom suggested by Thomas Cavalier-Smith to encompass the following two eukaryote supergroups: Plantae, or Archaeplastida (land plants, red algae, green algae, and glaucophytes) Chromalveolata (a polyphyletic group including kelp, water moulds, ciliates, dinoflagellates, and other organisms) Cavalier-Smith later included Rhizaria as well, resulting in a close similarity to Diaphoretickes — not identical as Diaphoretickes does not contain polyphyletic taxa."}, "cross_references": [{"found_name": "nutrition", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1041, "target_cluster_name": "nutrition", "source_book": "llm_generated", "evidence_snippet": "Diaphoretics are substances that promote perspiration, a bodily function related to the elimination of waste products, which is indirectly linked to the body's overall metabolic and nutritional state.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Diaphoretics are substances that promote perspiration, a bodily function related to the elimination of waste products, which is indirectly linked to the body's overall metabolic and nutritional state.", "is_reverse": true}, {"found_name": "Unicornio mineral", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "polyanthea_medicinal", "evidence_snippet": ". Refer.Bonet. fol. 486 col. 1. 14. Ivannini, 24. Eſpirito univerſal. As flores do Ettibio , chamou Poterio, 25. Antimonio meteorizado. Ao Antimonio Diaphoretico chamou Fa. bro , 26 Unicornio mineral.", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym"}, {"found_name": "Diafeltetafon", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "polyanthea_medicinal", "evidence_snippet": ". Refer.Bonet. fol. 486 col. 1. 14. Ivannini, 24. Eſpirito univerſal. As flores do Ettibio , chamou Poterio, 25. Antimonio meteorizado. Ao Antimonio Diaphoretico chamou Fa. bro , 26 Unicornio mineral.", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym"}, {"found_name": "Antimonio meteorizado", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "polyanthea_medicinal", "evidence_snippet": "univerſal. As flores do Ettibio , chamou Poterio, 25. Antimonio meteorizado. Ao Antimonio Diaphoretico chamou Fa. bro , 26 Unicornio mineral. Ao Mercurio Diaphoretico fixo 27. chamão muytos , Diafelte", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for"}, {"found_name": "Colcothar", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "polyanthea_medicinal", "evidence_snippet": "univerſal. As flores do Ettibio , chamou Poterio, 25. Antimonio meteorizado. Ao Antimonio Diaphoretico chamou Fa. bro , 26 Unicornio mineral. Ao Mercurio Diaphoretico fixo 27. chamão muytos , Diafelte", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for"}, {"found_name": "Antimonio Diaphoretico", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "polyanthea_medicinal", "evidence_snippet": ". Refer.Bonet. fol. 486 col. 1. 14. Ivannini, 24. Eſpirito univerſal. As flores do Ettibio , chamou Poterio, 25. Antimonio meteorizado. Ao Antimonio Diaphoretico chamou Fa. bro , 26 Unicornio mineral.", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of substance"}, {"found_name": "Mercurio Diaphoretico fixo", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "polyanthea_medicinal", "evidence_snippet": ". Refer.Bonet. fol. 486 col. 1. 14. Ivannini, 24. Eſpirito univerſal. As flores do Ettibio , chamou Poterio, 25. Antimonio meteorizado. Ao Antimonio Diaphoretico chamou Fa. bro , 26 Unicornio mineral.", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of substance"}]}, {"canonical_name": "Helmonte", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 24, "members": [{"entity_id": "helmont", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Helmont", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Helmont"], "contexts": ["alchemist and physician", "declared stones in kidney or bladder"]}, {"entity_id": "helmonte", "book_id": "polyanthea_medicinal", "name": "Helmonte", "category": "PERSON", "subcategory": "SCHOLAR", "count": 20, "variants": ["Helmonte", "Helmont", "Helmont."], "contexts": ["cited for medical opinions", "cited scholar"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Helmont", "target_book": "polyanthea_medicinal", "target_name": "Helmonte", "similarity": 0.895}], "id": 1706, "stable_key": "clu_03b8a90450cea369", "ground_truth": {"modern_name": "Johannes Baptista van Helmont", "confidence": "high", "type": "person", "birth_year": 1579, "death_year": 1644, "description": "Chemist, physiologist, and physician; pioneered experimental approach.", "note": "The spelling variations 'Helmont' and 'Helmonte' are common for this influential alchemist and physician."}, "cross_references": [{"found_name": "Hartmanus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1581, "target_cluster_name": "Hartmanus", "source_book": "llm_generated", "evidence_snippet": "Johannes Baptista van Helmont was a 17th-century Flemish chemist and physician whose work on gases and his concept of 'vital force' influenced later vitalist thinkers like Stahl. Van Helmont's experimental approach and his ideas about the fundamental nature of matter and life laid some groundwork for Stahl's own theories.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Johannes Baptista van Helmont was a 17th-century Flemish chemist and physician whose work on gases and his concept of 'vital force' influenced later vitalist thinkers like Stahl. Van Helmont's experimental approach and his ideas about the fundamental nature of matter and life laid some groundwork for Stahl's own theories.", "is_reverse": true}, {"found_name": "Paracelsus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 703, "target_cluster_name": "Paracelsus", "source_book": "llm_generated", "evidence_snippet": "Helmont was heavily influenced by Paracelsus's alchemical and iatrochemical ideas, and both were key figures in the transition from Galenic medicine to new chemical and physiological understandings.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Helmont was heavily influenced by Paracelsus's alchemical and iatrochemical ideas, and both were key figures in the transition from Galenic medicine to new chemical and physiological understandings."}, {"found_name": "Galen", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 29, "target_cluster_name": "Galen", "source_book": "llm_generated", "evidence_snippet": "Helmont's work often involved critiquing and attempting to supersede the long-dominant theories of Galen, representing a significant shift in medical thought.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Helmont's work often involved critiquing and attempting to supersede the long-dominant theories of Galen, representing a significant shift in medical thought."}]}, {"canonical_name": "Tralianus", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 27, "members": [{"entity_id": "trallianus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Trallianus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Trallianus"], "contexts": ["ancient medical writer"]}, {"entity_id": "tralianus", "book_id": "polyanthea_medicinal", "name": "Tralianus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 23, "variants": ["Tralianus", "Thaliano", "Tralian", "Traliano"], "contexts": ["author of De Arte Medica", "author who wrote about Gotta Coral"]}, {"entity_id": "alexandro_traliano", "book_id": "historia_medicinal_monardes_1574", "name": "Alexandro Traliano", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Alexandro Traliano"], "contexts": ["ancient medical authority"]}, {"entity_id": "alexandre_traliano", "book_id": "polyanthea_medicinal", "name": "Alexandre Traliano", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Alexandre Traliano"], "contexts": ["ancient medical authority"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Trallianus", "target_book": "polyanthea_medicinal", "target_name": "Tralianus", "similarity": 0.891}], "id": 1707, "stable_key": "clu_8eb40e2f6191c8b1", "ground_truth": {"modern_name": "Alexander of Tralles", "confidence": "high", "type": "person", "birth_year": 525, "death_year": 605, "description": "Byzantine Greek physician, author of 'Six Medical Books'", "wikidata_id": "Q708684", "wikidata_description": "eminent ancient physician", "wikipedia_url": "https://en.wikipedia.org/wiki/Alexander%20of%20Tralles", "wikipedia_extract": "Alexander of Tralles (Medieval Greek: Ἀλέξανδρος ὁ Τραλλιανός; ca. 525 – ca. 605) was one of the most eminent physicians in the Byzantine Empire. His birth date may safely be put in the 6th century AD, for he mentions Aëtius Amidenus, who probably did not write until the end of the 5th or the beginning of the 6th century, and he is himself quoted by Paul of Aegina, who is supposed to have lived in the 7th century; besides which, he is mentioned as a contemporary of Agathias, who set about writing his History in the beginning of the reign of Justin II, about 565. Alexander was born a Greek in Tralles in Asia Minor, and he had the advantage of being brought up under his father Stephanus, who was himself a physician, and also under another person, whose name he does not mention, but to whose son Cosmas he dedicates his chief work, which he wrote out of gratitude at his request. He was a man of an extensive practice, of a very long experience, and of great reputation, not only at Rome, but wherever he traveled in Spain, Gaul, and Italy, whence he was called by way of eminence \"Alexander the Physician\"."}, "member_count": 4, "cross_references": [{"found_name": "Galen", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 29, "target_cluster_name": "Galen", "source_book": "llm_generated", "evidence_snippet": "Alexander of Tralles was a later Byzantine physician who drew heavily from Galen's works and is considered a successor in the Galenic tradition.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Alexander of Tralles was a later Byzantine physician who drew heavily from Galen's works and is considered a successor in the Galenic tradition.", "is_reverse": true}, {"found_name": "Ætius", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1573, "target_cluster_name": "Ætius", "source_book": "llm_generated", "evidence_snippet": "Both were prominent Byzantine physicians known for their extensive medical compilations.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were prominent Byzantine physicians known for their extensive medical compilations.", "is_reverse": true}, {"found_name": "Hippocrates", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 31, "target_cluster_name": "Hippocrates", "source_book": "llm_generated", "evidence_snippet": "Hippocrates, along with Galen, formed the bedrock of medical knowledge and practice that Alexander of Tralles would have inherited and built upon.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Hippocrates, along with Galen, formed the bedrock of medical knowledge and practice that Alexander of Tralles would have inherited and built upon."}, {"found_name": "Pareus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2093, "target_cluster_name": "Pareus", "source_book": "llm_generated", "evidence_snippet": "Both were prominent physicians whose collected works were important medical texts in the premodern period.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were prominent physicians whose collected works were important medical texts in the premodern period.", "is_reverse": true}, {"found_name": "Actuarius", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2247, "target_cluster_name": "Actuarius", "source_book": "llm_generated", "evidence_snippet": "Johannes Actuarius was a physician in the Byzantine Empire, and Alexander of Tralles was also a prominent Byzantine physician whose works were influential.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Johannes Actuarius was a physician in the Byzantine Empire, and Alexander of Tralles was also a prominent Byzantine physician whose works were influential.", "is_reverse": true}]}, {"canonical_name": "Kent", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 24, "members": [{"entity_id": "kent", "book_id": "english_physician_1652", "name": "Kent", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 23, "variants": ["Kent", "Kentish", "Kentish Shoares"], "contexts": ["county where Lidd is located", "county where Crosswort grows"]}, {"entity_id": "kent", "book_id": "origin_of_species_darwin_1859", "name": "Kent", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Kent"], "contexts": ["county in England"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Kent", "target_book": "origin_of_species_darwin_1859", "target_name": "Kent", "similarity": 0.852}], "id": 1708, "stable_key": "clu_8faa3ba4d01b51a1", "ground_truth": {"modern_name": "Kent", "confidence": "high", "type": "place", "description": "A county in England where certain plants grow; also refers to a region in North America.", "note": "Distinguish from 'Kentuchy' (Kentucky).", "wikipedia_extract": "Kent is a ceremonial county in South East England. It is bordered by Essex across the Thames Estuary to the north, the Strait of Dover to the south-east, East Sussex to the south-west, Surrey to the west, and Greater London to the north-west. The county has an area of 3,544 square kilometres (1,368 sq mi) and had population of 1,931,684 in 2024. The north-west of Kent is densely populated, with Dartford and Gravesend belonging to the Greater London conurbation and Chatham, Gillingham and Rochester forming a second conurbation around the River Medway; the town of Maidstone is located to their south. The remainder of the county is more rural, and its principal settlements include the city of Canterbury in the north-east, the seaside resort of Margate on the north-east coast, and the ports of Dover and Folkestone on the east coast. For local government purposes Kent consists of a non-metropolitan county, with twelve districts, and the unitary authority area of Medway."}, "cross_references": [{"found_name": "England", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 65, "target_cluster_name": "England", "source_book": "llm_generated", "evidence_snippet": "Kent is a county within England.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Kent is a county within England."}, {"found_name": "Sussex", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1837, "target_cluster_name": "Sussex", "source_book": "llm_generated", "evidence_snippet": "Kent borders Sussex.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Kent borders Sussex."}, {"found_name": "English Channel", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3399, "target_cluster_name": "British Channel", "source_book": "llm_generated", "evidence_snippet": "Kent is bordered by the English Channel to the south-east.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Kent is bordered by the English Channel to the south-east."}, {"found_name": "River Thames", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2715, "target_cluster_name": "Thames", "source_book": "llm_generated", "evidence_snippet": "Kent is bordered by the River Thames to the north.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Kent is bordered by the River Thames to the north."}, {"found_name": "Europe", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 30, "target_cluster_name": "Europe", "source_book": "llm_generated", "evidence_snippet": "Kent is located in Europe.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Kent is located in Europe."}]}, {"canonical_name": "Cancer", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 24, "members": [{"entity_id": "cancer", "book_id": "english_physician_1652", "name": "Cancer", "category": "CONCEPT", "subcategory": "THEORY", "count": 16, "variants": ["Cancer", "cancer"], "contexts": ["zodiac sign influencing astrological medicine", "zodiac sign influencing health"]}, {"entity_id": "cancer", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cancer", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 8, "variants": ["Cancer"], "contexts": ["tropical zone", "tropic of Cancer"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Cancer", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Cancer", "similarity": 1.0}], "id": 1709, "stable_key": "clu_b2404f53af052a7f", "ground_truth": {"modern_name": "Cancer (astrology)", "confidence": "high", "type": "concept", "note": "The primary context points to astrological medicine. The 'tropical zone' reference might be a secondary or less common association."}, "cross_references": [{"found_name": "Aries", "link_type": "same_referent", "l