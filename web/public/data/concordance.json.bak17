bon", "target_book": "polyanthea_medicinal", "target_name": "Lisboa", "similarity": 0.949}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Lisbona", "target_book": "polyanthea_medicinal", "target_name": "Lisboa", "similarity": 0.949}], "id": 224, "stable_key": "clu_e9993506f7d56d9d", "ground_truth": {"modern_name": "Lisbon", "confidence": "high", "type": "place", "description": "Capital and largest city of Portugal.", "wikipedia_extract": "Lisbon, officially the Very Noble and Ever Loyal City of Lisbon, is the capital and most populous municipality of Portugal, with an estimated population of 575,739, as of 2024, within its administrative limits and 3,028,000 within the metropolis, as of 2025. Lisbon is mainland Europe's westernmost capital city (second overall after Reykjavík), and the only one along the Atlantic coast, the others (Reykjavík and Dublin) being on islands. The city lies in the western portion of the Iberian Peninsula, on the northern shore of the River Tagus. The western portion of its metro area, the Portuguese Riviera, hosts the westernmost point of Continental Europe, culminating at Cabo da Roca. Lisbon is one of the oldest cities in the world and the second-oldest European capital city (after Athens), predating other modern European capitals by centuries. Settled by pre-Celtic tribes and later founded and civilized by the Phoenicians, Julius Caesar made it a municipium called Felicitas Julia, adding the term to the name Olissipo."}, "cross_references": [{"found_name": "Portugal", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 37, "target_cluster_name": "Portugal", "source_book": "llm_generated", "evidence_snippet": "Lisbon is the capital and largest city of Portugal.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Lisbon is the capital and largest city of Portugal.", "is_reverse": true}, {"found_name": "Alfama", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3735, "target_cluster_name": "Alfama", "source_book": "llm_generated", "evidence_snippet": "Alfama is a historic district within Lisbon, known for its narrow streets and Fado music.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Alfama is a historic district within Lisbon, known for its narrow streets and Fado music."}, {"found_name": "ciudad", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2007, "target_cluster_name": "ciudad", "source_book": "llm_generated", "evidence_snippet": "A historically significant city.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: A historically significant city.", "is_reverse": true}, {"found_name": "Alem-Tejo", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2336, "target_cluster_name": "Alem-Tejo", "source_book": "llm_generated", "evidence_snippet": "Lisbon is the capital of Portugal and a major port city, historically connected to Alentejo through trade and administration.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Lisbon is the capital of Portugal and a major port city, historically connected to Alentejo through trade and administration.", "is_reverse": true}]}, {"canonical_name": "nariz", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 73, "members": [{"entity_id": "nose", "book_id": "english_physician_1652", "name": "Nose", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 21, "variants": ["Nose"], "contexts": ["body part from which bleeding is stanched", "body part, plant juice helps breath"]}, {"entity_id": "nose", "book_id": "principles_of_psychology_james_1890", "name": "nose", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 7, "variants": ["nose"], "contexts": ["organ for smelling and breathing", "part of the face"]}, {"entity_id": "narizes", "book_id": "historia_medicinal_monardes_1574", "name": "narizes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["narizes"], "contexts": ["nostrils"]}, {"entity_id": "nariz", "book_id": "polyanthea_medicinal", "name": "nariz", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 44, "variants": ["nariz", "NARIS", "naris", "narize", "narizes"], "contexts": ["where flesh excrescences grow", "body part affected by spots"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Nose", "target_book": "principles_of_psychology_james_1890", "target_name": "nose", "similarity": 0.98}, {"source_book": "english_physician_1652", "source_name": "Nose", "target_book": "historia_medicinal_monardes_1574", "target_name": "narizes", "similarity": 0.901}, {"source_book": "english_physician_1652", "source_name": "Nose", "target_book": "polyanthea_medicinal", "target_name": "nariz", "similarity": 0.918}, {"source_book": "principles_of_psychology_james_1890", "source_name": "nose", "target_book": "historia_medicinal_monardes_1574", "target_name": "narizes", "similarity": 0.92}, {"source_book": "principles_of_psychology_james_1890", "source_name": "nose", "target_book": "polyanthea_medicinal", "target_name": "nariz", "similarity": 0.931}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "narizes", "target_book": "polyanthea_medicinal", "target_name": "nariz", "similarity": 0.963}], "id": 225, "stable_key": "clu_aac140cfec0a47d0", "ground_truth": {"modern_name": "Nose", "confidence": "high", "type": "anatomy", "description": "The part of the face used for smelling and breathing.", "wikipedia_extract": "A nose is a sensory organ and respiratory structure in vertebrates. It consists of a nasal cavity inside the head, and an external nose on the face. The external nose houses the nostrils, or nares, a pair of tubes providing airflow through the nose for respiration. Where the nostrils pass through the nasal cavity they widen, are known as nasal fossae, and contain turbinates and olfactory mucosa. The nasal cavity also connects to the paranasal sinuses (dead-end air cavities for pressure buffering and humidification). From the nasal cavity, the nostrils continue into the pharynx, a switch track valve connecting the respiratory and digestive systems."}, "cross_references": [{"found_name": "Face", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 95, "target_cluster_name": "Face", "source_book": "llm_generated", "evidence_snippet": "The nose is a prominent external feature of the face.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The nose is a prominent external feature of the face."}, {"found_name": "Nostril", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2532, "target_cluster_name": "nostrils", "source_book": "llm_generated", "evidence_snippet": "Nostrils are the external openings of the nose.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Nostrils are the external openings of the nose."}, {"found_name": "Cavity (anatomical)", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1477, "target_cluster_name": "cavities", "source_book": "llm_generated", "evidence_snippet": "The nasal cavity is an internal anatomical space within the nose.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The nasal cavity is an internal anatomical space within the nose."}, {"found_name": "Air", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 109, "target_cluster_name": "air", "source_book": "llm_generated", "evidence_snippet": "Air passes through the nose for respiration.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Air passes through the nose for respiration."}, {"found_name": "Respiration", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 752, "target_cluster_name": "Breath", "source_book":