LANT", "subcategory": "TREE", "count": 1, "variants": ["Palma"], "contexts": ["tree used for shape comparison"]}, {"entity_id": "palma", "book_id": "coloquios_da_orta_1563", "name": "Palma", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Palma"], "contexts": ["family of palm trees"]}, {"entity_id": "palma", "book_id": "ricettario_fiorentino_1597", "name": "Palma", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Palma"], "contexts": ["palm tree, used in preparations"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "palm", "target_book": "kosmos_humboldt_1845", "target_name": "palm", "similarity": 0.863}, {"source_book": "principles_of_psychology_james_1890", "source_name": "palm", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "palm", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "palm", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "palm", "similarity": 0.863}], "id": 1467, "stable_key": "clu_2d7a03cf441c18a4", "ground_truth": {"modern_name": "Palm tree", "confidence": "high", "type": "plant", "family": "Arecaceae", "note": "Palma is the direct Spanish and Italian word for palm. Given the contexts, it refers to the plant family or specific trees within it.", "wikidata_id": "Q14080", "wikidata_description": "family of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Arecaceae", "wikipedia_extract": "The Arecaceae () are a family of perennial, flowering plants in the monocot order Arecales. Their growth form can be climbers, shrubs, tree-like and stemless plants, all commonly known as palms. Those having a tree-like form are colloquially called palm trees. Currently, 181 genera with around 2,600 species are known, most of which are restricted to tropical and subtropical climates. Most palms are distinguished by their large, compound, evergreen leaves, known as fronds, arranged at the top of an unbranched stem, except for the Hyphaene genus, which has branched palms. However, palms exhibit an enormous diversity in physical characteristics and inhabit nearly every type of habitat within their range, from rainforests to deserts."}, "member_count": 6, "cross_references": [{"found_name": "palmeta", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 3040, "target_cluster_name": "palmeta", "source_book": "llm_generated", "evidence_snippet": "The historical name 'palms' is a direct synonym for 'Palm tree'.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: The historical name 'palms' is a direct synonym for 'Palm tree'.", "is_reverse": true}, {"found_name": "palms", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1998, "target_cluster_name": "palms", "source_book": "llm_generated", "evidence_snippet": "The term 'palms' is used colloquially to refer to plants with a tree-like form within the Arecaceae family, which are also called palm trees.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "The term 'palms' is used colloquially to refer to plants with a tree-like form within the Arecaceae family, which are also called palm trees."}, {"found_name": "Chamaerops", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4039, "target_cluster_name": "Chamaerops", "source_book": "llm_generated", "evidence_snippet": "Chamaerops is a genus within the Arecaceae family, making it a specific type of palm.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Chamaerops is a genus within the Arecaceae family, making it a specific type of palm."}]}, {"canonical_name": "Stockholm", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "stockholm", "book_id": "principles_of_psychology_james_1890", "name": "Stockholm", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Stockholm"], "contexts": ["location of Swedish Academy of Sciences"]}, {"entity_id": "stockholm", "book_id": "kosmos_humboldt_1845", "name": "Stockholm", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Stockholm"], "contexts": ["city for latitude comparison"]}, {"entity_id": "stockholm", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Stockholm", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Stockholm"], "contexts": ["city on isothermal line of 41° Fahrenheit"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Stockholm", "target_book": "kosmos_humboldt_1845", "target_name": "Stockholm", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Stockholm", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Stockholm", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Stockholm", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Stockholm", "similarity": 1.0}], "id": 1468, "stable_key": "clu_0a1c6ae72d1258a0", "ground_truth": {"modern_name": "Stockholm", "confidence": "high", "type": "place", "country": "Sweden", "wikidata_id": "Q1754", "wikidata_description": "capital and largest city of Sweden", "wikipedia_url": "https://en.wikipedia.org/wiki/Stockholm", "wikipedia_extract": "Stockholm (; Swedish: [ˈstɔ̂kː(h)ɔlm] ) is the capital and most populous city of Sweden, as well as the largest urban area in the Nordic countries. Approximately 1 million people live in the municipality, with 1.6 million in the urban area, and 2.5 million in the metropolitan area. The city stretches across fourteen islands where Lake Mälaren flows into the Baltic Sea. Outside the city to the east, and along the coast, is the island chain of the Stockholm archipelago. The area has been settled since the Stone Age, in the 6th millennium BC, and was founded as a city in 