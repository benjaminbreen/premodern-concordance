th": 0.5, "target_cluster_id": 4027, "target_cluster_name": "economy", "source_book": "llm_generated", "evidence_snippet": "Political economy is a subfield and a more specific development of the broader concept of 'Economy'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Political economy is a subfield and a more specific development of the broader concept of 'Economy'."}, {"found_name": "Commerce", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 375, "target_cluster_name": "commerce", "source_book": "llm_generated", "evidence_snippet": "Commerce is a key component and subject of study within political economy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Commerce is a key component and subject of study within political economy."}, {"found_name": "Division of labor", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2533, "target_cluster_name": "division of labour", "source_book": "llm_generated", "evidence_snippet": "The division of labor is a fundamental concept discussed extensively in political economy, particularly by Adam Smith.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The division of labor is a fundamental concept discussed extensively in political economy, particularly by Adam Smith."}, {"found_name": "Industry", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 506, "target_cluster_name": "industrie", "source_book": "llm_generated", "evidence_snippet": "Industry is a central focus of analysis in political economy, relating to production and economic activity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Industry is a central focus of analysis in political economy, relating to production and economic activity."}]}, {"canonical_name": "Charcas", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "charcas", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Charcas", "category": "PLACE", "subcategory": "CITY", "count": 5, "variants": ["Charcas"], "contexts": ["region in Bolivia", "Charcas links Peru to Buenos-Ayres"]}, {"entity_id": "charcas", "book_id": "historia_medicinal_monardes_1574", "name": "Charcas", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Charcas"], "contexts": ["origin of indigenous people", "region from which indigenous people came"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Charcas", "target_book": "historia_medicinal_monardes_1574", "target_name": "Charcas", "similarity": 0.651}], "id": 2388, "stable_key": "clu_c504c8d9e464dde4", "ground_truth": {"modern_name": "Sucre", "confidence": "high", "type": "place", "country": "Bolivia"}, "cross_references": []}, {"canonical_name": "Freiberg", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 10, "members": [{"entity_id": "freiberg", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Freiberg", "category": "PLACE", "subcategory": "CITY", "count": 5, "variants": ["Freiberg"], "contexts": ["location of mines", "city known for mining"]}, {"entity_id": "freiberg", "book_id": "kosmos_humboldt_1845", "name": "Freiberg", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Freiberg"], "contexts": ["latitude for centrifugal force calculation", "location of mines with magnetic disturbance"]}, {"entity_id": "freyburg", "book_id": "kosmos_humboldt_1845", "name": "Freyburg", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Freyburg"], "contexts": ["location of mining school"]}, {"entity_id": "freyberg", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Freyberg", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Freyberg"], "contexts": ["location of Professor Reich", "location of mines with green plants"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Freiberg", "target_book": "kosmos_humboldt_1845", "target_name": "Freiberg", "similarity": 1.0}], "id": 2389, "stable_key": "clu_208cb6ad1fb9622e", "ground_truth": {"modern_name": "Freiberg", "confidence": "high", "type": "place", "country": "Germany", "note": "References to mines, mining schools, and latitude calculations in the context of physical sciences point to Freiberg, a city historically known for its mining and mineralogical significance.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_extract": "Freiberg ist ein deutscher Familienname. Freiberg ist ein Herkunftsname für diejenigen, die aus einem Ort namens Freiberg oder Freyberg stammen. Freibergs, Freyberg, Freiberger, Freyberger Björn Freiberg (* 1970), deutscher Schauspieler Daniel Freiberg (* 1957), US-amerikanischer Jazzmusiker Dietrich von Freiberg (um 1240–1310), Philosoph, Mystiker, Dominikaner und Theologe Dov Freiberg (1927–2008), polnisch-israelischer Holocaustüberlebender und Buchautor Gottfried von Freiberg (1908–1962), österreichischer Hornist Hedwig Freiberg (1872–1945), deutsche Malerin und Schauspielerin, Ehefrau von Robert Koch Heinrich von Freiberg (13. Jh.), Dichter und Minnesänger Henning Freiberg (* 1937), deutscher Kunstpädagoge und Hochschullehrer im Ruhestand Kjell-Børge Freiberg (* 1971), norwegischer Politiker Konrad Freiberg (* 1951), deutscher Polizist und Gewerkschaftsvorsitzender Lorenz III. von Freiberg (vor 1459–1487), Bischof von Gurk Ludwig von Freiberg (1442–vor 1480), Bischof von Konstanz Marcos A. Freiberg (1911–1990), argentinischer Zoologe Margit Freiberg (* 1962), deutsche Tischtennisspielerin Michael Freiberg (Politiker) (* 1956), deutscher Politiker (CDU) Michael Freiberg (Radsportler) (* 1990), australischer Radrennfahrer Mona Freiberg (* 1950), deutsche Volksschauspielerin und Sängerin Peter Freiberg (* 1954), deutscher Drehbuchautor, Radiomoderator und Sänger Siegfried Freiberg (1901–1985), österreichischer Schriftsteller und Bibliothekar Steffen Freiberg (* 1981), deutscher Politiker Walter Freiberg (* 1922), deutscher Oberst im Ministerium für Staatssicherheit (MfS) der DDR Freiberg.", "wikipedia_url": "https://de.wikipedia.org/wiki/Freiberg_%28Familienname%29"}, "member_count": 4, "cross_references": []}, {"canonical_name": "évaporation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "évaporation", "book_id": "relation_historique_humboldt_vol3_1825", "name": "évaporation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["évaporation"], "contexts": ["process of water turning into vapor", "process of turning liquid into vapor"]}, {"entity_id": "evaporation", "book_id": "first_principles_spencer_1862", "name": "evaporation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["evaporation"], "contexts": ["process of raising water into vapour", "process of water turning into vapor"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "évaporation", "target_book": "first_principles_spencer_1862", "target_name": "evaporation", "similarity": 0.729}], "id": 2390, "stable_key": "clu_78fe15c293f9edc1", "ground_truth": {"modern_name": "Evaporation", "confidence": "high", "type": "concept"}, "cross_references": [{"found_name": "evaporaçao", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 3723, "target_cluster_name": "evaporaçao", "source_book": "llm_generated", "evidence_snippet": "The entity 'Evaporation' is presented with its historical French spelling 'évaporation', indicating a direct linguistic equivalent.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "reverse: The entity 'Evaporation' is presented with its historical French spelling 'évaporation', indicating a direct linguistic equivalent.", "is_reverse": 