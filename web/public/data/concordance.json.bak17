et_cluster_id": 798, "target_cluster_name": "elasticity", "source_book": "llm_generated", "evidence_snippet": "Elasticity is a fundamental property of many media (solids, fluids) that allows them to support wave propagation. Without elasticity, disturbances would not be able to propagate as waves.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Elasticity is a fundamental property of many media (solids, fluids) that allows them to support wave propagation. Without elasticity, disturbances would not be able to propagate as waves."}, {"found_name": "Conduction", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2567, "target_cluster_name": "conduction", "source_book": "llm_generated", "evidence_snippet": "Both wave propagation and conduction involve the transfer of energy or properties through a medium. While distinct, they share conceptual similarities in how phenomena are transmitted.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both wave propagation and conduction involve the transfer of energy or properties through a medium. While distinct, they share conceptual similarities in how phenomena are transmitted."}, {"found_name": "Expansion", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 933, "target_cluster_name": "Expansion", "source_book": "llm_generated", "evidence_snippet": "In some contexts, like the expansion of a wave front from a source, there is a relationship. Also, wave phenomena can be related to the expansion or compression of a medium.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "In some contexts, like the expansion of a wave front from a source, there is a relationship. Also, wave phenomena can be related to the expansion or compression of a medium."}, {"found_name": "Curvature", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1394, "target_cluster_name": "curvature", "source_book": "llm_generated", "evidence_snippet": "Wave fronts can exhibit curvature, and the study of wave propagation in curved spaces or media is a significant area of physics. The geometry of the wave is often related to curvature.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Wave fronts can exhibit curvature, and the study of wave propagation in curved spaces or media is a significant area of physics. The geometry of the wave is often related to curvature."}]}, {"canonical_name": "curar", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "cura", "book_id": "historia_medicinal_monardes_1574", "name": "cura", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["cura"], "contexts": ["cure, of diseases using cooled beverages"]}, {"entity_id": "cura", "book_id": "coloquios_da_orta_1563", "name": "cura", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 7, "variants": ["cura", "Cura", "curar", "curas"], "contexts": ["type of distilled spirit", "Sanskrit word for palm sap"]}, {"entity_id": "curar", "book_id": "polyanthea_medicinal", "name": "curar", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 9, "variants": ["curar", "curarem", "curas"], "contexts": ["act of healing", "can cure many diseases"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "cura", "target_book": "coloquios_da_orta_1563", "target_name": "cura", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "cura", "target_book": "polyanthea_medicinal", "target_name": "curar", "similarity": 0.896}, {"source_book": "coloquios_da_orta_1563", "source_name": "cura", "target_book": "polyanthea_medicinal", "target_name": "curar", "similarity": 0.896}], "id": 764, "stable_key": "clu_c2bcb4ae6aec6f3f", "ground_truth": {"modern_name": "To cure", "confidence": "high", "type": "concept", "description": "The act of healing or restoring to health.", "note": "'curar' and its variations relate to the act of healing.", "wikipedia_extract": "The Cure are an English rock band formed in Crawley in 1976 by Robert Smith (vocals, guitar) and Lol Tolhurst (drums). As of 2026, the band's line-up comprises Smith, Simon Gallup (bass), Roger O'Donnell (keyboards), Jason Cooper (drums) and Reeves Gabrels (guitar). Smith has remained the only constant member throughout numerous line-up changes since the band's formation. Three Imaginary Boys (the Cure's 1979 debut album) and several early singles placed the band at the forefront of the emerging post-punk and new wave movements that were gaining prominence in the United Kingdom. The band adopted an increasingly dark and tormented style beginning with their second album Seventeen Seconds (1980), which had a strong influence on the emerging genre of gothic rock. After the release of their fourth album Pornography (1982), Smith started to introduce more pop into the band's music."}, "cross_references": [{"found_name": "aloes ruym", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "algumas chagas, e tem pêra bto nas suas boticas huma mezinha chamada mocebar, feita de a\\eínre e mirra, á qual elles chamam bola, e desta usam muito para curar cavalos, e para matar os bichos das chag", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "equivalent to aloes cahalino"}, {"found_name": "Aloés cahalino", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "algumas chagas, e tem pêra bto nas suas boticas huma mezinha chamada mocebar, feita de a\\eínre e mirra, á qual elles chamam bola, e desta usam muito para curar cavalos, e para matar os bichos das chag", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "a type of aloes"}]}, {"canonical_name": "CuBEBAS", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "cubebas", "book_id": "coloquios_da_orta_1563", "name": "CuBEBAS", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 9, "variants": ["CuBEBAS", "Cubebas", "cubebas", "cubebe"], "contexts": ["spice discussed in dialogue", "spice from a tree"]}, {"entity_id": "cubeba", "book_id": "ricettario_fiorentino_1597", "name": "cubeba", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["cubeba"], "contexts": ["plant similar to Amomo"]}, {"entity_id": "cubebas", "book_id": "polyanthea_medicinal", "name": "cubebas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["cubebas", "Cubebas"], "contexts": ["cubeb pepper, used as powder", "cubeb pepper, ingredient for wine remedy"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "CuBEBAS", "target_book": "polyanthea_medicinal", "target_name": "cubebas", "similarity": 0.785}, {"source_book": "ricettario_fiorentino_1597", "source_name": "cubeba", "target_book": "polyanthea_medicinal", "target_name": "cubebas", "similarity": 0.913}], "id": 765, "stable_key": "clu_562cddeef12e48ef", "ground_truth": {"modern_name": "Cubeb pepper", "confidence": "high", "type": "plant", "linnaean": "Piper cubeba", "family": "Piperaceae"}, "cross_references": [{"found_name": "pimenta", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 545, "target_cluster_name": "pimenta", "source_book": "llm_generated", "evidence_snippet": "Cubeb pepper (Piper cubeba) is a related spice, often grouped with black pepper (Piper nigrum) in historical texts due to similar culinary and medicinal uses, though botanically distinct.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Cubeb pepper (Piper cubeba) is a related spice, often grouped with black pepper (Piper nigrum) in historical texts due to similar culinary and medicinal uses, though botanically distinct.", "is_reverse": true}, {"found_name": "Long Pepper", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1750, "target_cluster_name": "pimenta longa", "source_book": "llm_generated", "evidence_snippet": "Both Cubeb pepper and Long Pepper are historical spices used in similar culinary and medicinal contexts, often grouped together as 'peppers' distinct from black pepper.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both Cubeb pepper and Long Pepper are historical spices used in similar culinary and medicinal contexts, often grouped together as 'peppers' distinct from black pepper."}, {"found_name": "Pepper", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 545, "target_cluster_name": "pimenta", "source_book": "llm_generated", "evidence_snippet": "Cubeb pepper is a type of pepper, historically distinct from black pepper (Piper nigrum) but sharing the common name and usage as a spice.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Cubeb pepper is a type of pepper, historically distinct from black pepper (Piper nigrum) but sharing the common name and usage as a spice."}, {"found_name": "Spices", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2144, "target_cluster_name": "especiarias", "source_book": "llm_generated", "evidence_snippet": "Cubeb pepper is a spice.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Cubeb pepper is a spice."}, {"found_name": "pimenta longa", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1750, "target_cluster_name": "pimenta longa", "source_book": "llm_generated", "evidence_snippet": "Both are types of peppers used historically as spices, belonging to the Piperaceae family.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both are types of peppers used historically as spices, belonging to the Piperaceae family.", "is_reverse": true}, {"found_name": "Pepper", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2171, "target_cluster_name": "Pepper", "source_book": "llm_generated", "evidence_snippet": "Cubeb pepper is a type of pepper, specifically Piper cubeba, and is often discussed alongside other peppercorns in historical texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Cubeb pepper is a type of pepper, specifically Piper cubeba, and is often discussed alongside other peppercorns in historical texts.", "is_reverse": true}, {"found_name": "mtrtus sihestris", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "não ser pimenta. E dam estes arvores flores, que cheirão bem. RUANO Traz Mateus Silv atiço por autoridade de Serapião*, que o que chamam os Mauritanos cubebas he acerca de Dios- corides mtrtus sihestr", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for cubebas"}, {"found_name": "mirto agreste", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "não ser pimenta. E dam estes arvores flores, que cheirão bem. RUANO Traz Mateus Silv atiço por autoridade de Serapião*, que o que chamam os Mauritanos cubebas he acerca de Dios- corides mtrtus sihestr", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for cubebas"}]}, {"canonical_name": "Celidonia", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "celidonia", "book_id": "coloquios_da_orta_1563", "name": "celidonia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["celidonia", "celidonia maior", "cilidonia"], "contexts": ["plant possibly confused with memiran", "plant mentioned with numbers"]}, {"entity_id": "celidonia", "book_id": "ricettario_fiorentino_1597", "name": "Celidonia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Celidonia"], "contexts": ["herb used in preparations"]}, {"entity_id": "celidonia", "book_id": "polyanthea_medicinal", "name": "Celidonia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 11, "variants": ["Celidonia", "Celidonium", "celidonia"], "contexts": ["celandine, ingredient for ointment", "herb used in eye collirium"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "celidonia", "target_book": "ricettario_fiorentino_1597", "target_name": "Celidonia", "similarity": 0.987}, {"source_book": "coloquios_da_orta_1563", "source_name": "celidonia", "target_book": "polyanthea_medicinal", "target_name": "Celidonia", "similarity": 0.987}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Celidonia", "target_book": "polyanthea_medicinal", "target_name": "Celidonia", "similarity": 1.0}], "id": 766, "stable_key": "clu_78ce2cd18b6426d7", "ground_truth": {"modern_name": "Celandine", "confidence": "high", "type": "plant", "linnaean": "Chelidonium majus", "family": "Papaveraceae", "description": "Herb with yellow flowers, used in traditional medicine, especially for eyes.", "wikipedia_extract": "Chelidonium majus, the greater celandine, is a perennial herbaceous flowering plant in the poppy family Papaveraceae. One of two species in the genus Chelidonium, it is native to Europe and western Asia and introduced widely in North America. The plant known as lesser celandine (Ficaria verna) is not closely related, as it belongs to the buttercup family Ranunculaceae. Greater celandine is a perennial herbaceous plant with an erect habit, and reaches 30–120 cm (12–47 in) high. The blue-green leaves are pinnate with lobed and wavy margins, up to 30 cm (12 in) long. When injured, the plant exudes a yellow to orange latex."}, "cross_references": [{"found_name": "Chelidonium", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 3912, "target_cluster_name": "Chelidonium", "source_book": "llm_generated", "evidence_snippet": "Chelidonium is the genus name for the greater celandine, and the historical name 'Celidonia' is a direct cognate.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "Chelidonium is the genus name for the greater celandine, and the historical name 'Celidonia' is a direct cognate."}, {"found_name": "fumaria", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2235, "target_cluster_name": "fumaria", "source_book": "llm_generated", "evidence_snippet": "Fumaria officinalis is commonly known as 'common fumitory' or 'earth-smoke', and Celandine (Chelidonium majus) is also known as 'greater celandine'. Both are herbaceous plants historically used in traditional medicine, often grouped together for their perceived similar properties or uses.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Fumaria officinalis is commonly known as 'common fumitory' or 'earth-smoke', and Celandine (Chelidonium majus) is also known as 'greater celandine'. Both are herbaceous plants historically used in traditional medicine, often grouped together for their perceived similar properties or uses.", "is_reverse": true}, {"found_name": "Fumitory", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 1815, "target_cluster_name": "Fumofterno", "source_book": "llm_generated", "evidence_snippet": "Fumitory is a common name for plants in the genus Fumaria, which share historical medicinal applications and are often discussed alongside celandine.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Fumitory is a common name for plants in the genus Fumaria, which share historical medicinal applications and are often discussed alongside celandine."}, {"found_name": "Fumaria officinalis", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2235, "target_cluster_name": "fumaria", "source_book": "llm_generated", "evidence_snippet": "Both are herbaceous plants with historical medicinal uses, often grouped together in herbal traditions.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are herbaceous plants with historical medicinal uses, often grouped together in herbal traditions."}, {"found_name": "Fumofterno", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1815, "target_cluster_name": "Fumofterno", "source_book": "llm_generated", "evidence_snippet": "Fumitory (Fumaria officinalis) and Celandine (Chelidonium majus) were often grouped together in historical pharmacopoeias and herbal texts due to their similar appearances and perceived medicinal properties, particularly for liver ailments and skin conditions. They were sometimes confused or used interchangeably in certain contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Fumitory (Fumaria officinalis) and Celandine (Chelidonium majus) were often grouped together in historical pharmacopoeias and herbal texts due to their similar appearances and perceived medicinal properties, particularly for liver ailments and skin conditions. They were sometimes confused or used interchangeably in certain contexts.", "is_reverse": true}]}, {"canonical_name": "zedoaria", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "zedoaria", "book_id": "coloquios_da_orta_1563", "name": "zedoaria", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["zedoaria", "ZEDOARIA", "Zedoría", "zedoaría"], "contexts": ["subject of colloquy", "plant with debated identity"]}, {"entity_id": "zedoaria", "book_id": "ricettario_fiorentino_1597", "name": "Zedoaria", "category": "PLANT", "subcategory": "ROOT", "count": 5, "variants": ["Zedoaria", "Zedoana"], "contexts": ["zedoary root", "zedoary, a medicinal root"]}, {"entity_id": "zedosria", "book_id": "ricettario_fiorentino_1597", "name": "Zedosria", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Zedosria"], "contexts": ["ingredient in a preparation"]}, {"entity_id": "zedoaria", "book_id": "polyanthea_medicinal", "name": "zedoaria", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["zedoaria"], "contexts": ["root used in a purgative", "zedoary"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "zedoaria", "target_book": "ricettario_fiorentino_1597", "target_name": "Zedoaria", "similarity": 0.818}, {"source_book": "coloquios_da_orta_1563", "source_name": "zedoaria", "target_book": "ricettario_fiorentino_1597", "target_name": "Zedosria", "similarity": 0.91}, {"source_book": "coloquios_da_orta_1563", "source_name": "zedoaria", "target_book": "polyanthea_medicinal", "target_name": "zedoaria", "similarity": 1.0}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Zedoaria", "target_book": "polyanthea_medicinal", "target_name": "zedoaria", "similarity": 0.818}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Zedosria", "target_book": "polyanthea_medicinal", "target_name": "zedoaria", "similarity": 0.91}], "id": 767, "stable_key": "clu_1110f0ea0c920d23", "ground_truth": {"modern_name": "Zedoary", "confidence": "high", "type": "plant", "linnaean": "Curcuma zedoaria", "family": "Zingiberaceae", "description": "A rhizomatous herbaceous perennial plant in the ginger family.", "wikipedia_extract": "Curcuma zedoaria (zedoary /ˈzɛdəʊərɪ/, white turmeric, or temu putih) is a perennial herb and member of the genus Curcuma, family Zingiberaceae. The plant is native to South Asia and Southeast Asia but is now naturalized in other places including the US state of Florida. Zedoary was one of the ancient food plants of the Austronesian peoples. They were spread during prehistoric times to the Pacific Islands and Madagascar during the Austronesian expansion (c. 3000 BCE). Its use as a spice in the West today is extremely rare, having been replaced by ginger, and to a lesser extent, yellow turmeric. The name zedoary derives from Persian via Arabic and Latin."}, "cross_references": [{"found_name": "Curcuma", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1807, "target_cluster_name": "Curcuma", "source_book": "llm_generated", "evidence_snippet": "Zedoary is a species within the genus Curcuma. Historical texts often use the genus name to refer to specific species within it, especially when the species is well-known or the primary representative of the genus in a particular context.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "Zedoary is a species within the genus Curcuma. Historical texts often use the genus name to refer to specific species within it, especially when the species is well-known or the primary representative of the genus in a particular context."}, {"found_name": "croco indiaco", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2464, "target_cluster_name": "croco indiaco", "source_book": "llm_generated", "evidence_snippet": "Both 'zedoary' and 'croco indiaco' (Indian crocus) are historical names for Curcuma zedoaria, indicating they refer to the same plant.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "Both 'zedoary' and 'croco indiaco' (Indian crocus) are historical names for Curcuma zedoaria, indicating they refer to the same plant."}, {"found_name": "Galangal", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 270, "target_cluster_name": "Galbano", "source_book": "llm_generated", "evidence_snippet": "Zedoary (Curcuma zedoaria) and Galangal (Alpinia galanga) are both members of the Zingiberaceae family (ginger family) and share similar rhizomatous growth habits and culinary/medicinal uses, often being confused or used interchangeably in historical texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Zedoary (Curcuma zedoaria) and Galangal (Alpinia galanga) are both members of the Zingiberaceae family (ginger family) and share similar rhizomatous growth habits and culinary/medicinal uses, often being confused or used interchangeably in historical texts."}, {"found_name": "Turmeric", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1807, "target_cluster_name": "Curcuma", "source_book": "llm_generated", "evidence_snippet": "Zedoary (Curcuma zedoaria) is closely related to Turmeric (Curcuma longa), both belonging to the same genus Curcuma. They share similar appearances and are often grouped together in discussions of rhizomatous spices and medicinal plants.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Zedoary (Curcuma zedoaria) is closely related to Turmeric (Curcuma longa), both belonging to the same genus Curcuma. They share similar appearances and are often grouped together in discussions of rhizomatous spices and medicinal plants."}, {"found_name": "Amomum", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2029, "target_cluster_name": "Amomum", "source_book": "llm_generated", "evidence_snippet": "Amomum is a genus closely related to Curcuma within the Zingiberaceae family. Both genera contain aromatic rhizomatous plants used historically for similar purposes (spices, medicines).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Amomum is a genus closely related to Curcuma within the Zingiberaceae family. Both genera contain aromatic rhizomatous plants used historically for similar purposes (spices, medicines)."}, {"found_name": "Zerumbet ginger", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2877, "target_cluster_name": "Zerumbet", "source_book": "llm_generated", "evidence_snippet": "Zerumbet ginger (Zingiber zerumbet) is another rhizomatous plant from the Zingiberaceae family, closely related to Zedoary. They share botanical characteristics and historical uses.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Zerumbet ginger (Zingiber zerumbet) is another rhizomatous plant from the Zingiberaceae family, closely related to Zedoary. They share botanical characteristics and historical uses."}, {"found_name": "Ginger", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2918, "target_cluster_name": "Ginger", "source_book": "llm_generated", "evidence_snippet": "Zedoary is another rhizomatous spice from the Zingiberaceae family, related to ginger and used in traditional medicine and as a spice.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Zedoary is another rhizomatous spice from the Zingiberaceae family, related to ginger and used in traditional medicine and as a spice.", "is_reverse": true}]}, {"canonical_name": "sulphuric acid", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "sulphureous", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "sulphureous", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["sulphureous"], "contexts": ["exhalations in clouds", "subterraneous veins"]}, {"entity_id": "sulphurous_acids", "book_id": "kosmos_humboldt_1845", "name": "sulphurous acids", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["sulphurous acids"], "contexts": ["acids issuing from the ground"]}, {"entity_id": "sulphurous_acid", "book_id": "kosmos_humboldt_1845", "name": "sulphurous acid", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["sulphurous acid"], "contexts": ["gaseous compound of sulphur"]}, {"entity_id": "sulphureous", "book_id": "kosmos_humboldt_1845", "name": "sulphureous", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["sulphureous"], "contexts": ["describing turbid water"]}, {"entity_id": "sulphuric_acid", "book_id": "connexion_physical_sciences_somerville_1858", "name": "sulphuric acid", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 6, "variants": ["sulphuric acid"], "contexts": ["acid used to clean platinum", "acid used to fix chrysotype"]}, {"entity_id": "sulphate", "book_id": "connexion_physical_sciences_somerville_1858", "name": "sulphate", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["sulphate"], "contexts": ["salt formed by acid and zinc", "salt of a metal"]}, {"entity_id": "sulphuric_acid", "book_id": "kosmos_humboldt_1845", "name": "sulphuric acid", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["sulphuric acid"], "contexts": ["acid produced from sulphur", "acid vapor causing mineral transformation"]}, {"entity_id": "chloride_of_sulphur", "book_id": "connexion_physical_sciences_somerville_1858", "name": "chloride of sulphur", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["chloride of sulphur"], "contexts": ["chemical with high refractive power"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "sulphureous", "target_book": "kosmos_humboldt_1845", "target_name": "sulphurous acid", "similarity": 0.909}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "sulphureous", "target_book": "kosmos_humboldt_1845", "target_name": "sulphureous", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "sulphureous", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sulphuric acid", "similarity": 0.908}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "sulphureous", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sulphate", "similarity": 0.919}, {"source_book": "kosmos_humboldt_1845", "source_name": "sulphurous acids", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sulphuric acid", "similarity": 0.925}, {"source_book": "kosmos_humboldt_1845", "source_name": "sulphurous acid", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sulphuric acid", "similarity": 0.985}, {"source_book": "kosmos_humboldt_1845", "source_name": "sulphureous", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sulphate", "similarity": 0.919}, {"source_book": "kosmos_humboldt_1845", "source_name": "sulphuric acid", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "chloride of sulphur", "similarity": 0.881}], "id": 768, "stable_key": "clu_0b950bd0e8ac7725", "ground_truth": {"modern_name": "Sulfurous acid", "confidence": "high", "type": "chemical", "note": "While 'sulfuric acid' is also mentioned, the context of 'gaseous compound' and 'exhalations' points more strongly to sulfurous acid (H2SO3) as it is a weaker acid and can exist in gaseous form, whereas sulfuric acid (H2SO4) is a stronger acid typically encountered in liquid form or as a mist when concentrated.", "wikidata_id": "Q5282", "wikidata_description": "chemical compound", "wikipedia_url": "https://en.wikipedia.org/wiki/Sulfur%20dioxide", "wikipedia_extract": "Sulfur dioxide (IUPAC-recommended spelling) or sulphur dioxide (traditional Commonwealth English) is the chemical compound with the formula SO2. It is a colorless gas with a pungent smell that is responsible for the odor of burnt matches. It is released naturally by volcanic activity and is produced as a by-product of metals refining and the burning of sulfur-bearing hydrocarbon fuels. Sulfur dioxide is somewhat toxic to humans, although only when inhaled in relatively large quantities for a period of several minutes or more. It was known to medieval alchemists as \"volatile spirit of sulfur\". SO2 is a bent molecule with C2v symmetry point group."}, "cross_references": [{"found_name": "Acid", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1608, "target_cluster_name": "acidos", "source_book": "llm_generated", "evidence_snippet": "Sulfurous acid is a specific type of acid, and 'Acid' is a broader category that encompasses it.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Sulfurous acid is a specific type of acid, and 'Acid' is a broader category that encompasses it."}, {"found_name": "Alkali", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 863, "target_cluster_name": "alkalies", "source_book": "llm_generated", "evidence_snippet": "Acids and alkalis are fundamental chemical opposites, often discussed in relation to each other in historical chemical texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Acids and alkalis are fundamental chemical opposites, often discussed in relation to each other in historical chemical texts."}, {"found_name": "Air", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 109, "target_cluster_name": "air", "source_book": "llm_generated", "evidence_snippet": "Sulfur dioxide (the modern name for the substance) is described as a gas with a pungent smell, and gases are closely related to the concept of air, especially in historical contexts where distinctions between different gases and air were less precise.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Sulfur dioxide (the modern name for the substance) is described as a gas with a pungent smell, and gases are closely related to the concept of air, especially in historical contexts where distinctions between different gases and air were less precise."}, {"found_name": "Gaseous emissions", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3295, "target_cluster_name": "gaseous emanations", "source_book": "llm_generated", "evidence_snippet": "The description mentions sulfur dioxide is released naturally by volcanic activity, which are forms of gaseous emissions.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The description mentions sulfur dioxide is released naturally by volcanic activity, which are forms of gaseous emissions."}, {"found_name": "Gaseous substances", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2321, "target_cluster_name": "gaseous", "source_book": "llm_generated", "evidence_snippet": "Sulfur dioxide is a gas, and 'gaseous substances' is a direct category for it.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Sulfur dioxide is a gas, and 'gaseous substances' is a direct category for it."}, {"found_name": "Gas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 171, "target_cluster_name": "gas", "source_book": "llm_generated", "evidence_snippet": "Sulfur dioxide is a gas, and 'Gas' is a direct category for it.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Sulfur dioxide is a gas, and 'Gas' is a direct category for it."}, {"found_name": "Hydrogen sulfide", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 279, "target_cluster_name": "hydrogène sulfuré", "source_book": "llm_generated", "evidence_snippet": "Both are sulfur-containing gases, and historically, the relationships and distinctions between various sulfur compounds were a subject of study.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are sulfur-containing gases, and historically, the relationships and distinctions between various sulfur compounds were a subject of study."}]}, {"canonical_name": "Axis", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "axis", "book_id": "kosmos_humboldt_1845", "name": "axis", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["axis"], "contexts": ["imaginary line through a planet's center"]}, {"entity_id": "axis", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Axis", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 9, "variants": ["axis", "Axis"], "contexts": ["line of rotation", "line around which something rotates"]}, {"entity_id": "vertebrate_axis", "book_id": "first_principles_spencer_1862", "name": "vertebrate axis", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["vertebrate axis"], "contexts": ["fundamental characteristic of mature animals"]}, {"entity_id": "axes", "book_id": "kosmos_humboldt_1845", "name": "axes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["axes"], "contexts": ["lines of symmetry for celestial bodies", "directions of expansion in crystals"]}, {"entity_id": "axes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Axes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Axes"], "contexts": ["imaginary lines for rotation"]}, {"entity_id": "axis", "book_id": "first_principles_spencer_1862", "name": "axis", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["axis"], "contexts": ["imaginary line for rotation", "central line of rotation for a top"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "axis", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Axis", "similarity": 0.995}, {"source_book": "kosmos_humboldt_1845", "source_name": "axis", "target_book": "first_principles_spencer_1862", "target_name": "vertebrate axis", "similarity": 0.929}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Axis", "target_book": "first_principles_spencer_1862", "target_name": "vertebrate axis", "similarity": 0.923}, {"source_book": "kosmos_humboldt_1845", "source_name": "axes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Axes", "similarity": 0.994}, {"source_book": "kosmos_humboldt_1845", "source_name": "axes", "target_book": "first_principles_spencer_1862", "target_name": "axis", "similarity": 0.91}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Axes", "target_book": "first_principles_spencer_1862", "target_name": "axis", "similarity": 0.893}], "id": 769, "stable_key": "clu_b48b18fb4720e215", "ground_truth": {"modern_name": "Axis of rotation", "confidence": "high", "type": "concept", "note": "The context refers to both astronomical/geometric axes and biological axes, but the overarching concept is an imaginary line around which rotation occurs or a fundamental organizational line.", "wikidata_id": "Q2995427", "wikidata_description": "motion in space when there is fixed line of points", "wikipedia_url": "https://en.wikipedia.org/wiki/Rotation%20around%20a%20fixed%20axis", "wikipedia_extract": "Rotation around a fixed axis or axial rotation is a special case of rotational motion around an axis of rotation fixed, stationary, or static in three-dimensional space. This type of motion excludes the possibility of the instantaneous axis of rotation changing its orientation and cannot describe such phenomena as wobbling or precession. According to Euler's rotation theorem, simultaneous rotation along a number of stationary axes at the same time is impossible; if two rotations are forced at the same time, a new axis of rotation will result. This concept assumes that the rotation is also stable, such that no torque is required to keep it going. The kinematics and dynamics of rotation around a fixed axis of a rigid body are mathematically much simpler than those for free rotation of a rigid body; they are entirely analogous to those of linear motion along a single fixed direction, which is not true for free rotation of a rigid body. The expressions for the kinetic energy of the object, and for the forces on the parts of the object, are also simpler for rotation around a fixed axis, than for general rotational motion."}, "cross_references": []}, {"canonical_name": "domestic animals", "category": "CONCEPT", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "domestic_animals", "book_id": "origin_of_species_darwin_1859", "name": "domestic animals", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 12, "variants": ["domestic animals"], "contexts": ["animals bred by humans", "animals kept by humans"]}, {"entity_id": "domestic_animals", "book_id": "principles_of_psychology_james_1890", "name": "domestic animals", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["domestic animals"], "contexts": ["animals kept for human use"]}, {"entity_id": "domestic_animal", "book_id": "origin_of_species_darwin_1859", "name": "domestic animal", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["domestic animal"], "contexts": ["can have drooping ears"]}, {"entity_id": "domestic_animals", "book_id": "first_principles_spencer_1862", "name": "domestic animals", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["domestic animals"], "contexts": ["animals tamed by humans", "animals tamed for human use"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "domestic animals", "target_book": "principles_of_psychology_james_1890", "target_name": "domestic animals", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "domestic animal", "target_book": "first_principles_spencer_1862", "target_name": "domestic animals", "similarity": 0.978}], "id": 770, "stable_key": "clu_26599916d408ead7", "ground_truth": {"modern_name": "Domestic animals", "confidence": 