", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["Green", "green"], "contexts": ["color perceived by the psychologist", "turn to for psychology"]}, {"entity_id": "green", "book_id": "kosmos_humboldt_1845", "name": "green", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["green"], "contexts": ["color"]}, {"entity_id": "green", "book_id": "connexion_physical_sciences_somerville_1858", "name": "green", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 9, "variants": ["green"], "contexts": ["colour in the spectrum", "color of the spectrum"]}, {"entity_id": "yellow_green", "book_id": "connexion_physical_sciences_somerville_1858", "name": "yellow green", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["yellow green"], "contexts": ["color of light"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "green", "target_book": "principles_of_psychology_james_1890", "target_name": "green", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "green", "target_book": "kosmos_humboldt_1845", "target_name": "green", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "green", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "green", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "green", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "yellow green", "similarity": 0.925}, {"source_book": "principles_of_psychology_james_1890", "source_name": "green", "target_book": "kosmos_humboldt_1845", "target_name": "green", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "green", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "green", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "green", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "yellow green", "similarity": 0.925}, {"source_book": "kosmos_humboldt_1845", "source_name": "green", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "green", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "green", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "yellow green", "similarity": 0.925}], "id": 359, "stable_key": "clu_f5885a64dce56b6d", "ground_truth": {"modern_name": "color green", "confidence": "high", "type": "concept", "wikidata_id": "Q3133", "wikidata_description": "additive primary color, visible between blue and yellow", "wikipedia_url": "https://en.wikipedia.org/wiki/Green", "wikipedia_extract": "Green is the color between cyan and yellow on the visible spectrum. It is evoked by light which has a dominant wavelength of roughly 495–570 nm. In subtractive color systems, used in painting and color printing, it is created by a combination of yellow and cyan; in the RGB color model, used on television and computer screens, it is one of the additive primary colors, along with red and blue, which are mixed in different combinations to create all other colors. By far the largest contributor to green in nature is chlorophyll, the chemical by which plants photosynthesize and convert sunlight into chemical energy. Many creatures have adapted to their green environments by taking on a green hue themselves as camouflage. Several minerals have a green color, including the emerald, which is colored green by its chromium content."}, "cross_references": [{"found_name": "Emerald", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 107, "target_cluster_name": "esmeralda", "source_book": "llm_generated", "evidence_snippet": "Emerald is a gemstone that is characteristically green.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Emerald is a gemstone that is characteristically green."}, {"found_name": "Lapis lazuli", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2088, "target_cluster_name": "Lapis lafuli", "source_book": "llm_generated", "evidence_snippet": "Lapis lazuli is a deep-blue metamorphic rock used as a semi-precious stone that can sometimes have green inclusions or be mistaken for green stones.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Lapis lazuli is a deep-blue metamorphic rock used as a semi-precious stone that can sometimes have green inclusions or be mistaken for green stones."}, {"found_name": "Kyanite", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2397, "target_cluster_name": "cyanite", "source_book": "llm_generated", "evidence_snippet": "Kyanite is a mineral that can occur in blue, green, or black varieties, and is sometimes associated with green hues.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Kyanite is a mineral that can occur in blue, green, or black varieties, and is sometimes associated with green hues."}]}, {"canonical_name": "valeriana", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 4, "total_mentions": 16, "members": [{"entity_id": "garden_valerian", "book_id": "english_physician_1652", "name": "Garden Valerian", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Garden Valerian", "Garden Valcrian"], "contexts": ["plant with a thick root", "herb with warming faculty"]}, {"entity_id": "valeriana", "book_id": "coloquios_da_orta_1563", "name": "Valeriana", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Valeriana"], "contexts": ["plant genus", "genus of a plant"]}, {"entity_id": "valeriana", "book_id": "ricettario_fiorentino_1597", "name": "Valeriana", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Valeriana", "valeriana"], "contexts": ["plant with two varieties", "fragrant root for pounding"]}, {"entity_id": "valeriana", "book_id": "polyanthea_medicinal", "name": "valeriana", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["valeriana", "Valeriana", "valeria"], "contexts": ["herb used for treatment", "roots used in a remedy"]}, {"entity_id": "valeriana_agreſte", "book_id": "polyanthea_medicinal", "name": "Valeriana agreſte", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Valeriana agreſte"], "contexts": ["wild valerian, used in remedy"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Garden Valerian", "target_book": "coloquios_da_orta_1563", "target_name": "Valeriana", "similarity": 0.893}, {"source_book": "english_physician_1652", "source_name": "Garden Valerian", "target_book": "ricettario_fiorentino_1597", "target_name": "Valeriana", "similarity": 0.893}, {"source_book": "coloquios_da_orta_1563", "source_name": "Valeriana", "target_book": "ricettario_fiorentino_1597", "target_name": "Valeriana", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "Valeriana", "target_book": "polyanthea_medicinal", "target_name": "valeriana", "similarity": 0.887}, {"source_book": "coloquios_da_orta_1563", "source_name": "Valeriana", "target_book": "polyanthea_medicinal", "target_name": "Valeriana agreſte", "similarity": 0.881}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Valeriana", "target_book": "polyanthea_medicinal", "target_name": "valeriana", "similarity": 0.887}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Valeriana", "target_book": "polyanthea_medicinal", "target_name": "Valeriana agreſte", "similarity": 0.881}], "id": 360, "stable_key": "clu_0f44e4499b7dc7f5", "ground_truth": {"modern_name": "valerian", "confidence": "high", "type": "plant", "linnaean": "Valeriana spp.", "family": "Caprifoliaceae", "description": "A plant genus, with roots valued for medicinal and sedative properties.", "wikipedia_extract": "Valeriana is a genus of flowering plants in the family Caprifoliaceae, members of which may be commonly known as valerians. It contains many species, including the garden valerian, Valeriana officinalis. Valeriana has centers of diversity in Eurasia and South America (especially in the Andes), and is represented by native species on all continents except Antarctica. Some species have been introduced to parts of the world outside their native range, including Valeriana rubra in the western United States and Valeriana macrosiphon in Western Australia. The genus was named by Carl Linnaeus after the Roman emperor Publius Licinius Valerianus who was said to use the plant as medicine. The emperor's personal name comes from Valeria and the Latin verb valeo which means \"to be strong\". 32 previously recognized genera, including Centranthus, Fedia, and Plectritis, are now considered synonyms of Valeriana."}, "cross_references": [{"found_name": "Tuzia", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "ricettario_fiorentino_1597", "evidence_snippet": ": e però nelle ricette degli Arabi, douefi legge Tuzia, fi pigli la pompholige,<S: in quel/e de Greci , la cadmia della iorta , che é detto. DELLA VALERIANA. La valeriana, chiamata da Diofcoride, feco", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for Valeriana"}, {"found_name": "pompholige", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "ricettario_fiorentino_1597", "evidence_snippet": ": e però nelle ricette degli Arabi, douefi legge Tuzia, fi pigli la pompholige,<S: in quel/e de Greci , la cadmia della iorta , che é detto. DELLA VALERIANA. La valeriana, chiamata da Diofcoride, feco", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for Valeriana"}, {"found_name": "cadmia della iorta", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "ricettario_fiorentino_1597", "evidence_snippet": ": e però nelle ricette degli Arabi, douefi legge Tuzia, fi pigli la pompholige,<S: in quel/e de Greci , la cadmia della iorta , che é detto. DELLA VALERIANA. La valeriana, chiamata da Diofcoride, feco", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for Valeriana"}, {"found_name": "pianta", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "ricettario_fiorentino_1597", "evidence_snippet": ": e però nelle ricette degli Arabi, douefi legge Tuzia, fi pigli la pompholige,<S: in quel/e de Greci , la cadmia della iorta , che é detto. DELLA VALERIANA. La valeriana, chiamata da Diofcoride, feco", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "a type of Valeriana"}]}, {"canonical_name": "Fertility", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 16, "members": [{"entity_id": "fertility", "book_id": "origin_of_species_darwin_1859", "name": "Fertility", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 12, "variants": ["Fertility", "fertility"], "contexts": ["ability to reproduce", "ability to produce offspring"]}, {"entity_id": "fecundity", "book_id": "principles_of_psychology_james_1890", "name": "fecundity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fecundity"], "contexts": ["reproductive capacity of animals"]}, {"entity_id": "fertility", "book_id": "kosmos_humboldt_1845", "name": "fertility", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["fertility"], "contexts": ["ability to produce abundant crops"]}, {"entity_id": "fecundidade", "book_id": "polyanthea_medicinal", "name": "fecundidade", "category": "CONCEPT", "sub