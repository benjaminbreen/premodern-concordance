e": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1169, "target_cluster_name": "Chypre", "source_book": "llm_generated", "evidence_snippet": "Cyprus is an island nation located in the Eastern Mediterranean Sea.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Cyprus is an island nation located in the Eastern Mediterranean Sea."}, {"found_name": "Gibraltar", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1088, "target_cluster_name": "Gibraltar", "source_book": "llm_generated", "evidence_snippet": "The Strait of Gibraltar connects the Atlantic Ocean to the Mediterranean Sea.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Strait of Gibraltar connects the Atlantic Ocean to the Mediterranean Sea.", "is_reverse": true}, {"found_name": "Malta", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1293, "target_cluster_name": "Malta", "source_book": "llm_generated", "evidence_snippet": "Malta is an island country located in the Mediterranean Sea.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Malta is an island country located in the Mediterranean Sea.", "is_reverse": true}, {"found_name": "Oriente", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1590, "target_cluster_name": "Oriente", "source_book": "llm_generated", "evidence_snippet": "The Mediterranean region is often included in the definition of the 'Eastern world'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Mediterranean region is often included in the definition of the 'Eastern world'.", "is_reverse": true}]}, {"canonical_name": "organic beings", "category": "CONCEPT", "subcategory": "OTHER_ANIMAL", "book_count": 4, "total_mentions": 44, "members": [{"entity_id": "organic_beings", "book_id": "origin_of_species_darwin_1859", "name": "organic beings", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 36, "variants": ["organic beings", "ORGANIC BEINGS"], "contexts": ["all living organisms", "living organisms"]}, {"entity_id": "organic_beings", "book_id": "principles_of_psychology_james_1890", "name": "organic beings", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["organic beings"], "contexts": ["living creatures"]}, {"entity_id": "organic_bodies", "book_id": "connexion_physical_sciences_somerville_1858", "name": "organic bodies", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["organic bodies"], "contexts": ["bodies composed of living matter"]}, {"entity_id": "organic_bodies", "book_id": "first_principles_spencer_1862", "name": "organic bodies", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 6, "variants": ["organic bodies", "Organic bodies"], "contexts": ["bodies composed of living matter", "bodies of living organisms"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "organic beings", "target_book": "principles_of_psychology_james_1890", "target_name": "organic beings", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "organic beings", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "organic bodies", "similarity": 0.951}, {"source_book": "origin_of_species_darwin_1859", "source_name": "organic beings", "target_book": "first_principles_spencer_1862", "target_name": "organic bodies", "similarity": 0.951}, {"source_book": "principles_of_psychology_james_1890", "source_name": "organic beings", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "organic bodies", "similarity": 0.951}, {"source_book": "principles_of_psychology_james_1890", "source_name": "organic beings", "target_book": "first_principles_spencer_1862", "target_name": "organic bodies", "similarity": 0.951}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "organic bodies", "target_book": "first_principles_spencer_1862", "target_name": "organic bodies", "similarity": 1.0}], "id": 257, "stable_key": "clu_d39ea9737c0f216f", "ground_truth": {"modern_name": "Living organisms", "confidence": "high", "type": "concept", "note": "While 'organic beings' can refer to animals specifically, in these contexts, it broadly encompasses all living entities.", "wikidata_id": "Q7239", "wikidata_description": "any individual living being or physical living system", "wikipedia_url": "https://en.wikipedia.org/wiki/Organism", "wikipedia_extract": "An organism is any living thing that functions as an individual. Such a definition raises more problems than it solves, not least because the concept of an individual is also difficult. Several criteria, few of which are widely accepted, have been proposed to define what constitutes an organism. Among the most common is that an organism has autonomous reproduction, growth, and metabolism. This would exclude viruses, even though they evolve like organisms. Other problematic cases include colonial organisms; a colony of eusocial insects is organised adaptively, and has germ-soma specialisation, with some insects reproducing, others not, like cells in an animal's body."}, "cross_references": [{"found_name": "humana", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1271, "target_cluster_name": "humana", "source_book": "llm_generated", "evidence_snippet": "Humans are a type of living organism.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Humans are a type of living organism.", "is_reverse": true}, {"found_name": "waters", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1336, "target_cluster_name": "waters", "source_book": "llm_generated", "evidence_snippet": "Aquatic animals are a type of living organism.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Aquatic animals are a type of living organism.", "is_reverse": true}, {"found_name": "hybrids", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1669, "target_cluster_name": "hybrids", "source_book": "llm_generated", "evidence_snippet": "The definition of a hybrid is rooted in the sexual reproduction of living organisms. The concept of hybridity is a specific aspect of the broader category of living organisms and their reproduction.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The definition of a hybrid is rooted in the sexual reproduction of living organisms. The concept of hybridity is a specific aspect of the broader category of living organisms and their reproduction.", "is_reverse": true}]}, {"canonical_name": "sound", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 48, "members": [{"entity_id": "sound", "book_id": "origin_of_species_darwin_1859", "name": "sound", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sound"], "contexts": ["vibrations perceived as hearing"]}, {"entity_id": "sound", "book_id": "principles_of_psychology_james_1890", "name": "sound", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 11, "variants": ["Sound", "sound"], "contexts": ["perception of vibrations through air", "auditory stimulus"]}, {"entity_id": "sound", "book_id": "kosmos_humboldt_1845", "name": "sound", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sound"], "contexts": ["phenomenon conveyed by air"]}, {"entity_id": "sound", "book_id": "connexion_physical_sciences_somerville_1858", "name": "sound", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 31, "variants": ["Sound", "sound"], "contexts": ["comparison to light action", "vibrations perceived by ear"]}, {"entity_id": "noise", "book_id": "principles_of_psychology_james_1890", "name": "noise", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["noise"], "contexts": ["unwanted auditory stimulus", "ununderstood auditory sensation"]}, {"entity_id": "noises", "book_id": "kosmos_humboldt_1845", "name": "Noises", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Noises"], "contexts": ["audible vibrations"]}, {"entity_id": "noise", "book_id": "kosmos_humboldt_1845", "name": "noise", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["noise"], "contexts": ["sound accompanying earthquakes"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "sound", "target_book": "principles_of_psychology_james_1890", "target_name": "sound", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "sound", "target_book": "kosmos_humboldt_1845", "target_name": "sound", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "sound", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sound", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "sound", "target_book": "kosmos_humboldt_1845", "target_name": "sound", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "sound", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sound", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "sound", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "sound", "similarity": 1.0}], "id": 258, "stable_key": "clu_d8a85e46c4dd2640", "ground_truth": {"modern_name": "Sound", "confidence": "high", "type": "concept", "wikidata_id": "Q491713", "wikidata_description": "long, relatively wide body of water, connecting two larger parts of the sea", "wikipedia_url": "https://en.wikipedia.org/wiki/Sound%20%28geography%29", "note": "Context of auditory vibrations and phenomena, including those associated with natural events.", "wikipedia_extract": "In geography, a sound is a smaller body of water usually connected to a sea or an ocean. A sound may be an inlet that is deeper than a bight and wider than a fjord; or  a narrow sea channel or an ocean channel between two land masses, such as a strait; or also a lagoon between a barrier island and the mainland. A sound is often formed by the seas flooding a river valley. This produces a long inlet where the sloping valley hillsides descend to sea-level and continue beneath the water to form a sloping sea floor. These sounds are more appropriately called rias. The Marlborough Sounds in New Zealand are examples of this type of formation."}, "member_count": 7, "cross_references": [{"found_name": "Flood", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3783, "target_cluster_name": "Flood", "source_book": "llm_generated", "evidence_snippet": "A flood is a large amount of water, often overflowing its usual boundaries. A sound is a body of water, and floods can occur within or affect sounds.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "A flood is a large amount of water, often overflowing its usual boundaries. A sound is a body of water, and floods can occur within or affect sounds."}, {"found_name": "Depth", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3639, "target_cluster_name": "depth", "source_book": "llm_generated", "evidence_snippet": "Depth is a key characteristic of a sound, describing its vertical dimension.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Depth is a key characteristic of a sound, describing its vertical dimension."}, {"found_name": "Elevation", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 380, "target_cluster_name": "elevation", "source_book": "llm_generated", "evidence_snippet": "Elevation can be considered in relation to a sound, referring to the height of the surrounding landmasses or the seabed.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Elevation can be considered in relation to a sound, referring to the height of the surrounding landmasses or the seabed."}, {"found_name": "Geography", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1068, "target_cluster_name": "Geography", "source_book": "llm_generated", "evidence_snippet": "Sounds are geographical features, and their study falls under the domain of geography.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Sounds are geographical features, and their study falls under the domain of geography."}, {"found_name": "thunder", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2062, "target_cluster_name": "thunder", "source_book": "llm_generated", "evidence_snippet": "Thunder is a type of sound.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Thunder is a type of sound.", "is_reverse": true}]}, {"canonical_name": "Calcaire", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 6, "total_mentions": 70, "members": [{"entity_id": "calcaire", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Calcaire", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 27, "variants": ["Calcaire", "calcaire"], "contexts": ["sedimentary rock", "rock from which waters emerge"]}, {"entity_id": "cal", "book_id": "historia_medicinal_monardes_1574", "name": "cal", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["cal"], "contexts": ["used in a furnace for smelting", "likely referring to lime or calcium oxide"]}, {"entity_id": "cal", "book_id": "coloquios_da_orta_1563", "name": "cal", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["cal"], "contexts": ["mixed with anacardo for marking cloth", "lime"]}, {"entity_id": "cal", "book_id": "polyanthea_medicina