type": "concept", "note": "The context 'atmospheric formations' and mentions in scientific texts strongly indicate meteorological clouds, not anatomical ones.", "wikidata_id": "", "wikidata_description": "family name"}, "cross_references": [{"found_name": "Air", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 109, "target_cluster_name": "air", "source_book": "llm_generated", "evidence_snippet": "Clouds are a visible mass of condensed water vapor floating in the atmosphere, which is composed of air.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Clouds are a visible mass of condensed water vapor floating in the atmosphere, which is composed of air."}, {"found_name": "Atmosphere", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 213, "target_cluster_name": "atmosphere", "source_book": "llm_generated", "evidence_snippet": "Clouds are a component of the Earth's atmosphere.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Clouds are a component of the Earth's atmosphere."}, {"found_name": "Earth's atmosphere", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4529, "target_cluster_name": "earth’s atmosphere", "source_book": "llm_generated", "evidence_snippet": "Clouds are a component of the Earth's atmosphere.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Clouds are a component of the Earth's atmosphere."}, {"found_name": "Gaseous substances", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2321, "target_cluster_name": "gaseous", "source_book": "llm_generated", "evidence_snippet": "Clouds are composed of water vapor, which is a gas.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Clouds are composed of water vapor, which is a gas."}, {"found_name": "Gases", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 725, "target_clust