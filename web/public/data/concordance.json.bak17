nciples of Geology", "source_book": "llm_generated", "evidence_snippet": "Principles of Geology discusses the influence of climate on geological processes and landforms.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Principles of Geology discusses the influence of climate on geological processes and landforms.", "is_reverse": true}, {"found_name": "Météorologie", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1868, "target_cluster_name": "Météorologie", "source_book": "llm_generated", "evidence_snippet": "Climate is a long-term pattern of weather, a core concept within meteorology.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Climate is a long-term pattern of weather, a core concept within meteorology.", "is_reverse": true}, {"found_name": "geography of plants", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2598, "target_cluster_name": "geography of plants", "source_book": "llm_generated", "evidence_snippet": "Climate is a major factor influencing the geographical distribution of species, and therefore a key consideration in biogeography.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Climate is a major factor influencing the geographical distribution of species, and therefore a key consideration in biogeography.", "is_reverse": true}, {"found_name": "physical geography", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1947, "target_cluster_name": "physical geography", "source_book": "llm_generated", "evidence_snippet": "Climate is a fundamental aspect of physical geography, describing the long-term weather patterns of a region.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Climate is a fundamental aspect of physical geography, describing the long-term weather patterns of a region.", "is_reverse": true}, {"found_name": "Trade win