ncke", "book_id": "kosmos_humboldt_1845", "name": "Encke", "category": "PERSON", "subcategory": "SCHOLAR", "count": 12, "variants": ["Encke"], "contexts": ["comet with short period of revolution", "comet discoverer"]}, {"entity_id": "encke", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Encke", "category": "PERSON", "subcategory": "SCHOLAR", "count": 15, "variants": ["Encke"], "contexts": ["associated with a comet", "professor who refined sun's parallax"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Encke", "target_book": "kosmos_humboldt_1845", "target_name": "Encke", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Encke", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Encke", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Encke", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Encke", "similarity": 1.0}], "id": 659, "stable_key": "clu_b0c6fb3728755c4b", "ground_truth": {"modern_name": "Johann Franz Encke", "confidence": "high", "type": "person", "birth_year": 1791, "death_year": 1865, "description": "German astronomer, discoverer of Encke's Comet", "wikidata_id": "Q57294", "wikidata_description": "German astronomer (1791–1865)", "wikipedia_url": "https://en.wikipedia.org/wiki/Johann%20Franz%20Encke", "wikipedia_extract": "Johann Franz Encke (German pronunciation: [ˈjoːhan ˈfʁants ˈɛŋkə]; 23 September 1791 – 26 August 1865) was a German astronomer. Among his activities, he worked on the calculation of the periods of comets and asteroids, measured the distance from the Earth to the Sun, and made observations of the planet Saturn. Encke was born in Hamburg, where his father was the Pastor at St. James' Church, Hamburg. He was the youngest of eight children, and at the time his father died, when he was four years old, the family was in straitened circumstances. Thanks to the financial assistance of a teacher, he was able to be educated at the Gelehrtenschule des Johanneums."}, "cross_references": [{"found_name": "meteoric stones", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1783, "target_cluster_name": "meteoric stones", "source_book": "kosmos_humboldt_1845", "evidence_snippet": "greatest approximation of comets. Passage through the system of Jupiter's satellites. Comets of short periods of revolution, more correctly termed inner comets (Encke, Biela, Faye) -- p. 107 and note.", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "a synonym for aerolites"}, {"found_name": "falling stars", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2314, "target_cluster_name": "falling stars", "source_book": "kosmos_humboldt_1845", "evidence_snippet": "greatest approximation of comets. Passage through the system of Jupiter's satellites. Comets of short periods of revolution, more correctly termed inner comets (Encke, Biela, Faye) -- p. 107 and note.", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "a synonym for aerolites"}, {"found_name": "Alexis Bouvard", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3594, "target_cluster_name": "M. Bouvard", "source_book": "llm_generated", "evidence_snippet": "Alexis Bouvard was a French astronomer who worked on calculating planetary tables, a field related to Encke's work on comets and asteroids and measuring the Earth-Sun distance.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Alexis Bouvard was a French astronomer who worked on calculating planetary tables, a field related to Encke's work on comets and asteroids and measuring the Earth-Sun distance."}, {"found_name": "George Biddell Airy", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2323, "target_cluster_name": "Airy", "source_book": "llm_generated", "evidence_snippet": "George Biddell Airy was the Astronomer Royal in Britain during Encke's career, and they were contemporaries working in the same field of astronomy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "George Biddell Airy was the Astronomer Royal in Britain during Encke's career, and they were contemporaries working in the same field of astronomy."}, {"found_name": "Friedrich Bessel", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 269, "target_cluster_name": "Bessel", "source_book": "llm_generated", "evidence_snippet": "Friedrich Bessel was a prominent German astronomer and mathematician, a contemporary of Encke, and a significant figure in the development of observational astronomy and geodesy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Friedrich Bessel was a prominent German astronomer and mathematician, a contemporary of Encke, and a significant figure in the development of observational astronomy and geodesy."}, {"found_name": "Alexander von Humboldt", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 42, "target_cluster_name": "Humboldt", "source_book": "llm_generated", "evidence_snippet": "Alexander von Humboldt was a renowned naturalist and explorer whose work in physical geography and astronomy overlapped with Encke's astronomical research and interest in celestial mechanics.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Alexander von Humboldt was a renowned naturalist and explorer whose work in physical geography and astronomy overlapped with Encke's astronomical research and interest in celestial mechanics."}, {"found_name": "fire-balls", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "kosmos_humboldt_1845", "evidence_snippet": "greatest approximation of comets. Passage through the system of Jupiter's satellites. Comets of short periods of revolution, more correctly termed inner comets (Encke, Biela, Faye) -- p. 107 and note.", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "a synonym for aerolites"}, {"found_name": "Biela", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "kosmos_humboldt_1845", "evidence_snippet": "greatest approximation of comets. Passage through the system of Jupiter's satellites. Comets of short periods of revolution, more correctly termed inner comets (Encke, Biela, Faye) -- p. 107 and note.", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "a type of inner comet"}, {"found_name": "Faye", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "kosmos_humboldt_1845", "evidence_snippet": "greatest approximation of comets. Passage through the system of Jupiter's satellites. Comets of short periods of revolution, more correctly termed inner comets (Encke, Biela, Faye) -- p. 107 and note.", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "a type of inner comet"}]}, {"canonical_name": "Gonorrheas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 27, "members": [{"entity_id": "gonorrhea", "book_id": "english_physician_1652", "name": "Gonorrhea", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 6, "variants": ["Gonorrhea", "Gonorrea"], "contexts": ["condition treated by plantain externally", "running of the reins"]}, {"entity_id": "gonorrhoea", "book_id": "coloquios_da_orta_1563", "name": "gonorrhoea", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["gonorrhoea", "gonorrhceas"], "contexts": ["disease treated with cubebs", "disease treated with application"]}, {"entity_id": "gonorrheas", "book_id": "polyanthea_medicinal", "name": "Gonorrheas", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 18, "variants": ["Gonorrheas", "Gonerreas", "Gonorrh.", "Gonorshea", "gangrenas", "gangrenoſas", "gonorrhea", "gorrhea"], "contexts": ["sexually transmitted infection", "condition involving purgings through the urinary tract"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Gonorrhea", "target_book": "coloquios_da_orta_1563", "target_name": "gonorrhoea", "similarity": 0.977}, {"source_book": "english_physician_1652", "source_name": "Gonorrhea", "target_book": "polyanthea_medicinal", "target_name": "Gonorrheas", "similarity": 0.984}, {"source_book": "coloquios_da_orta_1563", "source_name": "gonorrhoea", "target_book": "polyanthea_medicinal", "target_name": "Gonorrheas", "similarity": 0.987}], "id": 660, "stable_key": "clu_b88a15a8688e7449", "ground_truth": {"modern_name": "Gonorrhea", "confidence": "high", "type": "disease", "description": "A sexually transmitted infection involving purulent discharge from the urinary tract.", "wikipedia_extract": "Gonorrhea or gonorrhoea, colloquially known as the clap, is a sexually transmitted infection (STI) caused by the bacterium Neisseria gonorrhoeae. Infection may involve the genitals, mouth, or rectum. Gonorrhea is spread through sexual contact with an infected person, or from a mother to a child during birth. Infected males may experience pain or burning with urination, discharge from the penis, or testicular pain. Infected females may experience burning with urination, vaginal discharge, vaginal bleeding between periods, or pelvic pain. Complications in females include pelvic inflammatory disease and in males include inflammation of the epididymis."}, "cross_references": [{"found_name": "morbo napolitano", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2860, "target_cluster_name": "morbo napolitano", "source_book": "llm_generated", "evidence_snippet": "Both syphilis and gonorrhea are sexually transmitted infections that were prevalent and often discussed together in premodern medical texts. They share modes of transmission and could co-occur.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both syphilis and gonorrhea are sexually transmitted infections that were prevalent and often discussed together in premodern medical texts. They share modes of transmission and could co-occur.", "is_reverse": true}]}, {"canonical_name": "Tom. III", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 27, "members": [{"entity_id": "chap__3", "book_id": "english_physician_1652", "name": "Chap. 3", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Chap. 3", "Chap. 4"], "contexts": ["chapter title"]}, {"entity_id": "tom__iii", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Tom. III", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 24, "variants": ["Tom. III", "Tom II", "Tom. 1", "Tom. I", "Tom. II", "Vol. III"], "contexts": ["volume reference", "reference to a volume"]}, {"entity_id": "tomo_3_", "book_id": "polyanthea_medicinal", "name": "tomo 3.", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["tomo 3."], "contexts": ["volume 3"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Chap. 3", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Tom. III", "similarity": 0.896}, {"source_book": "english_physician_1652", "source_name": "Chap. 3", "target_book": "polyanthea_medicinal", "target_name": "tomo 3.", "similarity": 0.901}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Tom. III", "target_book": "polyanthea_medicinal", "target_name": "tomo 3.", "similarity": 0.915}], "id": 661, "stable_key": "clu_a37909fa173c7b4c", "ground_truth": {"modern_name": "Volume 3", "confidence": "high", "type": "object", "wikidata_id": "Q1238720", "wikidata_description": "book in a series, typically identified sequentially (e.g. Volume 3)", "wikipedia_url": "https://en.wikipedia.org/wiki/Volume%20%28bibliography%29", "wikipedia_extract": "A volume is a physical book. It may be printed or handwritten. The term is commonly used to identify a single book that is part of a larger collection. Volumes are typically identified sequentially with Roman or Arabic numerals, e.g. \"volume III\" or \"volume 3\", commonly abbreviated to \"Vol.\". Volumes may be published directly, or they may be created out of multiple bound issues."}, "cross_references": [{"found_name": "Book", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 283, "target_cluster_name": "Livro", "source_book": "llm_generated", "evidence_snippet": "A volume is a specific type of book, often part of a larger set. 'Book' is a direct synonym in this context.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "A volume is a specific type of book, often part of a larger set. 'Book' is a direct synonym in this context."}, {"found_name": "Chapter", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 594, "target_cluster_name": "cap.", "source_book": "llm_generated", "evidence_snippet": "A chapter is a subdivision of a volume, indicating a structural relationship within a book.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "A chapter is a subdivision of a volume, indicating a structural relationship within a book."}, {"found_name": "Glossary", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1732, "target_cluster_name": "Glossary", "source_book": "llm_generated", "evidence_snippet": "A glossary is often found within or appended to a volume, serving a related function of defining terms.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "A glossary is often found within or appended to a volume, serving a related function of defining terms."}, {"found_name": "Memoirs", "link_type": "