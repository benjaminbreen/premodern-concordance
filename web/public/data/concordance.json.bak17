oloquios_da_orta_1563", "name": "Algarve", "category": "PLACE", "subcategory": "REGION", "count": 7, "variants": ["Algarve", "Algarby", "Algarves"], "contexts": ["region in the west", "region whose name derives from garb"]}, {"entity_id": "algarve", "book_id": "polyanthea_medicinal", "name": "Algarve", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Algarve"], "contexts": ["region in southern Portugal", "region in Portugal"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Algarve", "target_book": "polyanthea_medicinal", "target_name": "Algarve", "similarity": 1.0}], "id": 2147, "stable_key": "clu_9c2e13d61dd53fea", "ground_truth": {"modern_name": "Algarve", "confidence": "high", "type": "place", "description": "Southernmost region of Portugal, historically significant.", "wikipedia_extract": "The Algarve (UK: , US: , European Portuguese: [alˈɣaɾvɨ] ) is the southernmost NUTS II region of continental Portugal. It has an area of 4,997 km2 (1,929 sq mi) with 467,495 permanent inhabitants and incorporates 16 municipalities (concelhos or municípios in Portuguese). The region has its administrative centre in the city of Faro, where both the region's international airport and public university, the University of Algarve, are located. The region is the same as the area included in the Faro District and is subdivided into two zones, one to the West (Barlavento) and another to the East (Sotavento). Tourism and related activities are extensive and make up the bulk of the Algarve's summer economy. Production of food which includes fish and other seafood, as well as different types of fruit and vegetables such as oranges, figs, plums, carob pods, almonds, avocados, tomatoes, cauliflowers, strawberries, and raspberries, are also economically important in the region."}, "cross_references": [{"found_name": "Portugal", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 37, "target_cluster_name": "Portugal", "source_book": "llm_generated", "evidence_snippet": "The Algarve is a region in southern Portugal.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Algarve is a region in southern Portugal.", "is_reverse": true}, {"found_name": "Spaniards", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3322, "target_cluster_name": "Spaniards", "source_book": "llm_generated", "evidence_snippet": "The Algarve is a historical region in southern Portugal, which shares a border and significant historical interactions with Spain.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Algarve is a historical region in southern Portugal, which shares a border and significant historical interactions with Spain.", "is_reverse": true}, {"found_name": "Cadix", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1672, "target_cluster_name": "Cadix", "source_book": "llm_generated", "evidence_snippet": "The Algarve is a region in southern Portugal, directly west of Andalusia and historically connected to it through trade and cultural exchange across the border and along the Atlantic coast.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Algarve is a region in southern Portugal, directly west of Andalusia and historically connected to it through trade and cultural exchange across the border and along the Atlantic coast.", "is_reverse": true}, {"found_name": "Alem-Tejo", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2336, "target_cluster_name": "Alem-Tejo", "source_book": "llm_generated", "evidence_snippet": "Algarve is a neighboring region in Portugal, historically and geographically linked to Alentejo.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Algarve is a neighboring region in Portugal, historically and geographically linked to Alentejo.", "is_reverse": true}]}, {"canonical_name": "aves", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "aves", "book_id": "coloquios_da_orta_1563", "name": "aves", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 6, "variants": ["aves"], "contexts": ["Birds", "birds that produce amber"]}, {"entity_id": "aves", "book_id": "polyanthea_medicinal", "name": "aves", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 4, "variants": ["Aves", "aves"], "contexts": ["birds", "poultry to avoid"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "aves", "target_book": "polyanthea_medicinal", "target_name": "aves", "similarity": 1.0}], "id": 2148, "stable_key": "clu_0ef9fe73f17e29e3", "ground_truth": {"modern_name": "Birds", "confidence": "high", "type": "animal", "description": "Feathered vertebrates, including poultry and those producing ambergris.", "wikipedia_extract": "Birds are a group of warm-blooded theropod dinosaurs constituting the class Aves, characterised by feathers, toothless beaked jaws, the laying of hard-shelled eggs, a high metabolic rate, a four-chambered heart, and a strong yet lightweight skeleton. Birds live worldwide and range in size from the 5.5 cm (2.2 in) bee hummingbird to the 2.8 m (9 ft 2 in) common ostrich. There are over 11,000 living species and they are split into 44 orders. More than half are passerine or \"perching\" birds. Birds have wings whose development varies according to species; the only known groups without wings are the extinct moa and elephant birds. Wings, which are modified forelimbs, gave birds the ability to fly, although further evolution has led to the loss of flight in some birds, including ratites, penguins, and diverse endemic island species."}, "cross_references": [{"found_name": "Apteryx", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2731, "target_cluster_name": "Apteryx", "source_book": "llm_generated", "evidence_snippet": "Apteryx is a genus of flightless birds native to New Zealand.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Apteryx is a genus of flightless birds native to New Zealand."}, {"found_name": "Eagle", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1416, "target_cluster_name": "Eagle", "source_book": "llm_generated", "evidence_snippet": "Eagle is a type of bird.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Eagle is a type of bird."}, {"found_name": "Hawks", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 395, "target_cluster_name": "Hawks", "source_book": "llm_generated", "evidence_snippet": "Hawks are a type of bird.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Hawks are a type of bird."}, {"found_name": "caril", "link_type": "derivation", "link_strength": 0.4, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "Balagate. E deste coquo pisado, e tirado o leite, fazem* (que assi parece) e cozem arroz com elle, e he como arroz de leite de cabras. Fazem comeres das aves e carnes (a que chamam caril); e também se", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "a name for dishes made from birds and meats"}]}, {"canonical_name": "carabe", "category": "SUBSTANCE", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "carabe", "book_id": "coloquios_da_orta_1563", "name": "carabe", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 6, "variants": ["carabe"], "contexts": ["substance with similar virtues", "substance with glutinative and styptic properties"]}, {"entity_id": "carabe", "book_id": "ricettario_fiorentino_1597", "name": "Carabe", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 4, "variants": ["Carabe", "carabe"], "contexts": ["Arabic name for amber", "substance used in preparations"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "carabe", "target_book": "ricettario_fiorentino_1597", "target_name": "Carabe", "similarity": 0.881}], "id": 2149, "stable_key": "clu_d1a4fb925e6e7925", "ground_truth": {"modern_name": "Ambergris", "confidence": "high", "type": "animal", "note": "While 'carabe' can refer to various beetles, in the context of historical pharmacopoeias and especially when linked to Arabic terminology, it strongly suggests ambergris, a substance derived from the sperm whale and used in perfumery and medicine."}, "cross_references": [{"found_name": "Arábios", "link_type": "contested_identity", "link_strength": 0.7, "target_cluster_id": 538, "target_cluster_name": "Arábios", "source_book": "coloquios_da_orta_1563", "evidence_snippet": "lacre não o tem, posto que Aviçena diz que o tem. E chamárse luc por o Belunense, pode ser que asi o achou escrito nos oríginaes antigos ; porém aguora os Arábios todos o chamam locsumutri; e em repre", "confidence": 0.65, "auto_label": "contested_identity", "found_relationship": "reverse: a substance mistaken for lac", "is_reverse": true}, {"found_name": "Amber", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 820, "target_cluster_name": "amber", "source_book": "llm_generated", "evidence_snippet": "Amber and ambergris are both fossilized resins, often confused or associated in historical texts due to their similar names and appearance.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Amber and ambergris are both fossilized resins, often confused or associated in historical texts due to their similar names and appearance."}]}, {"canonical_name": "alcaparras", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "alcaparras", "book_id": "coloquios_da_orta_1563", "name": "alcaparras", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["alcaparras"], "contexts": ["flower buds", "appetite stimulant"]}, {"entity_id": "alcaparras", "book_id": "polyanthea_medicinal", "name": "alcaparras", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["alcaparras", "alcaravia"], "contexts": ["root used for unblocking", "food with deobstructing properties"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "alcaparras", "target_book": "polyanthea_medicinal", "target_name": "alcaparras", "similarity": 1.0}], "id": 2150, "stable_key": "clu_4fb1e28ecec1bbb1", "ground_truth": {"modern_name": "Capers", "confidence": "high", "type": "plant", "linnaean": "Capparis spinosa", "family": "Capparaceae", "description": "Flower buds and root of a shrub used in cuisine and medicine.", "wikipedia_extract": "Capparis spinosa, the caper bush, also called Flinders rose, is a perennial plant that bears rounded, fleshy leaves and large white to pinkish-white flowers. The taxonomic status of the species is controversial and unsettled. Species within the genus Capparis are highly variable, and interspecific hybrids have been common throughout the evolutionary history of the genus. As a result, some authors have considered C. spinosa to be composed of multiple distinct species, others that the taxon is a single species with multiple varieties or subspecies, or that the taxon C. spinosa is a hybrid between C. orientalis and C. sicula. Capparis spinosa is native to almost all the circum-Mediterranean countries, and is included in the flora of most of them, but whether it is indigenous to this region is uncertain. The family Capparaceae could have originated in the tropics and later spread to the Mediterranean basin."}, "cross_references": [{"found_name": "cafur", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1614, "target_cluster_name": "alcanfor", "source_book": "coloquios_da_orta_1563", "evidence_snippet": "desta terra, que em Goa, quando outra monção vem, já he gas- tada toda a seda (3). RUANO Dos nomes e compreisam delia me dizey. i6o Colóquio duodécimo ORTA Capur e cafur dizem os Arábios e toda a outr", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for Capur (camphor)"}, {"found_name": "Persia", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 168, "target_cluster_name": "Persia", "source_book": "coloquios_da_orta_1563", "evidence_snippet": "fazem as fruitas salgadas pêra incitar o apetite no tempo que as nam ha; e também as lançam em vinagre e azeite, a que chamam achar; e assi vem cá da Pérsia e Arábia ameixas verdes e maçans e talos de", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "reverse: a type of plant part", "is_reverse": true}]}, {"canonical_name": "Toscana", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "toscana", "book_id": "coloquios_da_orta_1563", "name": "Toscana", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Toscana"], "contexts": ["region", "region where borax was extracted"]}, {"entity_id": "toscana", "book_id": "ricettario_fiorentino_1597", "name": "Toscana", "category": "PLACE", "subcategory": "COUNTRY", "count": 7, "variants": ["TOSCANA", "Toscana"], "contexts": ["region in Italy", "region name"]}, {"entity_id": "to(scana", "book_id": "ricettario_fiorentino_1597", "name": "To(scana", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["To(scana"], "contexts": ["region where ammi is found"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Toscana", "target_book": "ricettario_fiorentino_1597", "target_name": "Toscana", "similarity": 0.931}, {"source_book": "coloquios_da_orta_1563", "source_name": "Toscana", "target_book": "ricettario_fiorentino_1597", "target_name": "To(scana", "similarity": 0.62}], "id": 2151, "stable_key": "clu_6a45e6459310abab", "ground_truth": {"modern_name": "Tuscany", "confidence": "high", "type": "place", "country": "Italy", "wikidata_id": "Q1273", "wikidata_description": "region in central Italy"}, "cross_references": [{"found_name": "Florença", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2082, "target_cluster_name": "Florença", "source_book": "llm_generated", "evidence_snippet": "Florence is the capital of the Italian region of Tuscany.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Florence is the capital of the Italian region of Tuscany.", "is_reverse": true}, {"found_name": "Italy", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 88, "target_cluster_name": "Itália", "source_book": "llm_generated", "evidence_snippet": "Tuscany is a region within Italy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Tuscany is a region within Italy."}, {"found_name": "Liguria", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4500, "target_cluster_name": "Liguria", "source_book": "llm_generated", "evidence_snippet": "Liguria is a neighboring region to Tuscany.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Liguria is a neighboring region to Tuscany."}, {"found_name": "Florence", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 389, "target_cluster_name": "Florence", "source_book": "llm_generated", "evidence_snippet": "Florence is the capital city of Tuscany.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Florence is the capital city of Tuscany."}, {"found_name": "Siena", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2833, "target_cluster_name": "Siena", "source_book": "llm_generated", "evidence_snippet": "Siena is the capital of the province of Siena, located within the historical region of Tuscany.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Siena is the capital of the province of Siena, located within the historical region of Tuscany.", "is_reverse": true}, {"found_name": "Elbe", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3417, "target_cluster_name": "Elbe", "source_book": "llm_generated", "evidence_snippet": "Elba is an island in Tuscany, Italy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Elba is an island in Tuscany, Italy.", "is_reverse": true}]}, {"canonical_name": "rabãos", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "rabãos", "book_id": "coloquios_da_orta_1563", "name": "rabãos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["rabãos"], "contexts": ["vegetable, likely radishes", "vegetable sold"]}, {"entity_id": "rabãos", "book_id": "polyanthea_medicinal", "name": "rabãos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["rabãos", "rabão"], "contexts": ["radishes", "flatulent food"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "rabãos", "target_book": "polyanthea_medicinal", "target_name": "rabãos", "similarity": 1.0}], "id": 2152, "stable_key": "clu_12e8cc9aa3552d5a", "ground_truth": {"modern_name": "Radish", "confidence": "high", "type": "plant", "linnaean": "Raphanus sativus", "family": "Brassicaceae", "description": "Edible root vegetable with a peppery flavor, commonly consumed raw.", "note": "The term 'rabô' in one context appears to refer to a specific type of pepper, but the overwhelming evidence points to 'radish' for the other instances.", "wikipedia_extract": "The radish (Raphanus sativus or Raphanus raphanistrum subsp. sativus) is a flowering plant in the mustard family, Brassicaceae. Its large taproot is commonly used as a root vegetable, although the entire plant is edible and its leaves are sometimes used as a leaf vegetable. Originally domesticated in Asia, radishes are now grown and consumed globally. The radish is sometimes considered to form a species complex with the wild radish and instead treated as the subspecies Raphanus raphanistrum subsp. sativus. Radishes are often used raw as a crunchy salad vegetable with a pungent, slightly spicy flavor, varying in intensity depending on its growing environment. There are numerous varieties varying in size, flavor, color, and length of time they take to mature."}, "cross_references": [{"found_name": "nabo", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2870, "target_cluster_name": "nabo", "source_book": "llm_generated", "evidence_snippet": "Turnips and radishes are both root vegetables belonging to the Brassicaceae family, often cultivated and used similarly in culinary contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Turnips and radishes are both root vegetables belonging to the Brassicaceae family, often cultivated and used similarly in culinary contexts.", "is_reverse": true}]}, {"canonical_name": "abobora", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "abóbora", "book_id": "coloquios_da_orta_1563", "name": "abóbora", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["abóbora"], "contexts": ["one of the four great cold seeds"]}, {"entity_id": "abobora", "book_id": "polyanthea_medicinal", "name": "abobora", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 9, "variants": ["abobora", "abobaras", "aboboras"], "contexts": ["pumpkin", "pumpkin pulp used in a poultice"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "abóbora", "target_book": "polyanthea_medicinal", "target_name": "abobora", "similarity": 0.871}], "id": 2153, "stable_key": "clu_313a4a6b93609095", "ground_truth": {"modern_name": "Pumpkin", "confidence": "high", "type": "plant", "description": "A large, round vegetable, often orange, used in cooking and medicine.", "wikipedia_extract": "A pumpkin is a cultivated winter squash in the genus Cucurbita. The term is most commonly applied to round, orange-colored squash varieties, but does not possess a scientific definition. It may be used in reference to many different squashes of varied appearance and belonging to multiple species in the Cucurbita genus. \"Pumpkin\" is sometimes used interchangeably with \"squash\" or \"winter squash\", and is commonly used for some cultivars of Cucurbita argyrosperma, Cucurbita ficifolia, Cucurbita maxima, Cucurbita moschata, and Cucurbita pepo. C. pepo pumpkins are among the oldest known domesticated plants, with evidence of their cultivation dating to between 7000 BCE and 5500 BCE in Mesoamerica. Wild species of Cucurbita and the earliest domesticated species are native to North America (parts of present-day northeastern Mexico and the southern United States), but cultivars are now grown globally for culinary, decorative, and other culturally-specific purposes. The pumpkin's thick shell encases edible seeds and pulp."}, "cross_references": [{"found_name": "Grains", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2320, "target_cluster_name": "grãos", "source_book": "llm_generated", "evidence_snippet": "Pumpkins are a type of cultivated squash, and while not a grain, they are often grouped with staple food crops like grains in historical agricultural contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Pumpkins are a type of cultivated squash, and while not a grain, they are often grouped with staple food crops like grains in historical agricultural contexts."}, {"found_name": "Melons", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4041, "target_cluster_name": "melons", "source_book": "llm_generated", "evidence_snippet": "Pumpkins belong to the same genus (Cucurbita) as many types of melons and are often discussed in relation to them as cultivated gourds.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Pumpkins belong to the same genus (Cucurbita) as many types of melons and are often discussed in relation to them as cultivated gourds."}, {"found_name": "fruit", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 72, "target_cluster_name": "frutas", "source_book": "llm_generated", "evidence_snippet": "Pumpkins are botanically classified as fruits, specifically a type of berry known as a pepo.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Pumpkins are botanically classified as fruits, specifically a type of berry known as a pepo."}]}, {"canonical_name": "cão", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "cão", "book_id": "coloquios_da_orta_1563", "name": "cão", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["cão"], "contexts": ["animal used in poisoning test"]}, {"entity_id": "cão", "book_id": "polyanthea_medicinal", "name": "cão", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 9, "variants": ["cão"], "contexts": ["recipient of transplanted illness", "dog to whom urine was given"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "cão", "target_book": "polyanthea_medicinal", "target_name": "cão", "similarity": 1.0}], "id": 2154, "stable_key": "clu_865d3f472d4055ea", "ground_truth": {"modern_name": "Dog", "confidence": "high", "type": "animal"}, "cross_references": [{"found_name": "puppies", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4162, "target_cluster_name": "puppies", "source_book": "llm_generated", "evidence_snippet": "Puppies are young dogs, a specific life stage of the entity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Puppies a