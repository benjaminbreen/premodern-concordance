: "revolutionary", "book_id": "first_principles_spencer_1862", "name": "revolutionary", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["revolutionary"], "contexts": ["related to radical social change"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "revolution", "target_book": "first_principles_spencer_1862", "target_name": "revolutionary", "similarity": 0.891}], "id": 3228, "stable_key": "clu_a43b92fe878d99d8", "ground_truth": {"modern_name": "Revolution", "confidence": "high", "type": "concept", "note": "The term 'revolution' in early modern science often referred to celestial orbits, but also carried the broader meaning of radical change, as indicated in the contexts.", "wikidata_id": "Q10931", "wikidata_description": "fundamental change in power or organizational structures that takes place in a relatively short period of time"}, "cross_references": []}, {"canonical_name": "vacuo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "vacuo", "book_id": "connexion_physical_sciences_somerville_1858", "name": "vacuo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["vacuo"], "contexts": ["space devoid of matter", "state of being empty of matter"]}, {"entity_id": "in_vacuo", "book_id": "first_principles_spencer_1862", "name": "in vacuo", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["in vacuo"], "contexts": ["in a vacuum, absence of matter"]}, {"entity_id": "void", "book_id": "connexion_physical_sciences_somerville_1858", "name": "void", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["void"], "contexts": ["empty space devoid of matter"]}, {"entity_id": "void", "book_id": "first_principles_spencer_1862", "name": "void", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["void"], "contexts": ["empty space"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "vacuo", "target_book": "first_principles_spencer_1862", "target_name": "in vacuo", "similarity": 0.898}], "id": 3229, "stable_key": "clu_e917e1d19a6bf9ae", "ground_truth": {"modern_name": "vacuum", "confidence": "high", "type": "concept", "note": "The term 'vásos' appears to be a corruption or variant of 'vasos' (vessels), which in a medical context could refer to blood vessels or lymphatics, or it might be a misreading of 'vacuo' or a related concept. However, the dominant context for 'vacuo' and 'in vacuo' points strongly to the physical concept of a vacuum.", "wikidata_id": "Q101674", "wikidata_description": "device that uses air to suck up dirt and other substances", "wikipedia_url": "https://en.wikipedia.org/wiki/Vacuum%20cleaner", "wikipedia_extract": "A vacuum (pl.: vacuums or vacua) is  space devoid of matter. The word is derived from the Latin adjective vacuus (neuter vacuum) meaning \"vacant\" or \"void\". An approximation to such vacuum is a region with a gaseous pressure much less than atmospheric pressure. Physicists often discuss ideal test results that would occur in a perfect vacuum, which they sometimes simply call \"vacuum\" or free space, and use the term partial vacuum to refer to an actual imperfect vacuum as one might have in a laboratory or in space. In engineering and applied physics on the other hand, vacuum refers to any space in which the pressure is considerably lower than atmospheric pressure. The Latin term in vacuo is used to describe an object that is surrounded by a vacuum."}, "member_count": 4, "cross_references": []}, {"canonical_name": "conducting wire", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "conducting_wire", "book_id": "connexion_physical_sciences_somerville_1858", "name": "conducting wire", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["conducting wire"], "contexts": ["connects tin foil for electrical union", "wire that conducts electricity"]}, {"entity_id": "conducting_wire", "book_id": "first_principles_spencer_1862", "name": "conducting wire", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["conducting wire"], "contexts": ["witnesses transformation of electricity to heat"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "conducting wire", "target_book": "first_principles_spencer_1862", "target_name": "conducting wire", "similarity": 1.0}], "id": 3230, "stable_key": "clu_8a67b2a4d45865cf", "ground_truth": {"modern_name": "Electrical conductor", "confidence": "high", "type": "object", "wikidata_id": "Q124291", "wikidata_description": "material that allows the flow of electrical current"}, "cross_references": [{"found_name": "battery", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 936, "target_cluster_name": "battery", "source_book": "llm_generated", "evidence_snippet": "Electrical conductors are necessary to connect a galvanic battery to other parts of a circuit.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Electrical conductors are necessary to connect a galvanic battery to other parts of a circuit.", "is_reverse": true}, {"found_name": "electric spark", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1045, "target_cluster_name": "electric spark", "source_book": "llm_generated", "evidence_snippet": "Electrical conductors are necessary for the controlled passage of electricity that can lead to an electric spark.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Electrical conductors are necessary for the controlled passage of electricity that can lead to an electric spark.", "is_reverse": true}, {"found_name": "galvanometer", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2211, "target_cluster_name": "galvanometer", "source_book": "llm_generated", "evidence_snippet": "Galvanometers are typically connected to electrical conductors to measure the current flowing through them.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Galvanometers are typically connected to electrical conductors to measure the current flowing through them.", "is_reverse": true}, {"found_name": "voltaic pile", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2440, "target_cluster_name": "voltaic pile", "source_book": "llm_generated", "evidence_snippet": "Electrical conductors are necessary to connect the elements of the Voltaic pile and to draw current from it.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Electrical conductors are necessary to connect the elements of the Voltaic pile and to draw current from it.", "is_reverse": true}]}, {"canonical_name": "Hercules", "category": "CONCEPT", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "hercules", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Hercules", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["Hercules"], "contexts": ["point towards which stars tend", "constellation containing a nebula"]}, {"entity_id": "hercules", "book_id": "first_principles_spencer_1862", "name": "Hercules", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Hercules"], "contexts": ["constellation in the night sky"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Hercules", "target_book": "first_principles_spencer_1862", "target_name": "Hercules", "similarity": 1.0}], "id": 3231, "stable_key": "clu_b281c0d6261a545f", "ground_truth": {"modern_name": "Zeta Herculis", "confidence": "high", "type": "object", "note": "While listed as ANIMAL, the context 'double star' and 'constellation' clearly indicates an astronomical object, specifically a star system.", "wikidata_id": "Q13341", "wikidata_description": "multiple star system in the constellation Hercules", "wikipedia_url": "https://en.wikipedia.org/wiki/Zeta%20Herculis", "wikipedia_extract": "Zeta Herculis, Latinized from ζ Herculis, is a multiple star system in the constellation Hercules. It has a combined apparent visual magnitude of 2.81, which is readily visible to the naked eye. Parallax measurements put it at a distance of about 35.0 light-years (10.7 parsecs) from Earth. The primary member is a subgiant star that is somewhat larger than the Sun and has just begun to evolve away from the main sequence as the supply of hydrogen at its core becomes exhausted. It is orbited by a smaller companion star at a mean angular separation of 1.5 arcseconds, which corresponds to a physical separation of about 15 Astronomical Units. This distance is large enough so that the two stars do not have a significant tidal effect on each other."}, "cross_references": []}, {"canonical_name": "Mr. Babbage", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "mr__babbage", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Mr. Babbage", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Mr. Babbage"], "contexts": ["views on volcanic action and internal heat", "scientist discussing earth crust contraction and heat radiation"]}, {"entity_id": "babbage", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Babbage", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Babbage"], "contexts": ["mentioned in footnotes"]}, {"entity_id": "babbage", "book_id": "first_principles_spencer_1862", "name": "Babbage", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Babbage"], "contexts": ["drew attention to segregation of units"]}, {"