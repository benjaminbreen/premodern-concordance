gassa sea"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bahama", "target_book": "kosmos_humboldt_1845", "target_name": "Bahamas", "similarity": 0.987}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bahama", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bahama Islands", "similarity": 0.967}, {"source_book": "kosmos_humboldt_1845", "source_name": "Bahamas", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bahama Islands", "similarity": 0.968}], "id": 918, "stable_key": "clu_3f5f69b872b24092", "ground_truth": {"modern_name": "Bahamas", "confidence": "high", "type": "place", "country": "Bahamas", "wikidata_id": "Q778", "wikidata_description": "island sovereign state in the West Indies", "wikipedia_url": "https://en.wikipedia.org/wiki/The%20Bahamas", "wikipedia_extract": "The Bahamas, officially the Commonwealth of the Bahamas, is an island country located within the Lucayan Archipelago in the Atlantic Ocean. The country comprises more than 3,000 islands, cays and islets in the Atlantic Ocean, located north of Cuba and north-west of the island of Hispaniola (split between the Dominican Republic and Haiti) and the Turks and Caicos Islands, southeast of the US state of Florida and east of the Florida Keys. The capital and largest city is Nassau on the island of New Providence. The Royal Bahamas Defence Force describes the Bahamas' territory as encompassing 470,000 km2 (180,000 sq mi) of ocean space. The Bahama islands were inhabited by the Arawak and Lucayans, a branch of the Arawakan-speaking Taíno, for many centuries. Christopher Columbus was the first European to see the islands, making his first landfall in the \"New World\" in 1492 when he landed on the island of San Salvador."}, "cross_references": [{"found_name": "Antilles", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1487, "target_cluster_name": "Antilles", "source_book": "llm_generated", "evidence_snippet": "The Bahamas are part of the Lucayan Archipelago, which is often grouped with or considered adjacent to the Antilles in historical geographical contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Bahamas are part of the Lucayan Archipelago, which is often grouped with or considered adjacent to the Antilles in historical geographical contexts."}, {"found_name": "Archipelago", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 175, "target_cluster_name": "archipelago", "source_book": "llm_generated", "evidence_snippet": "The Bahamas are an archipelago, consisting of over 3,000 islands, cays, and islets.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Bahamas are an archipelago, consisting of over 3,000 islands, cays, and islets."}, {"found_name": "Floride", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1545, "target_cluster_name": "Floride", "source_book": "llm_generated", "evidence_snippet": "The Straits of Florida lie between Florida and the Bahamas.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Straits of Florida lie between Florida and the Bahamas.", "is_reverse": true}]}, {"canonical_name": "géologue", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 10, "members": [{"entity_id": "géologue", "book_id": "relation_historique_humboldt_vol3_1825", "name": "géologue", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 7, "variants": ["géologue", "géognostes", "géologues"], "contexts": ["scientist studying rocks", "expert in geology"]}, {"entity_id": "geologist", "book_id": "kosmos_humboldt_1845", "name": "geologist", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["geologist"], "contexts": ["scientist studying Earth's structure", "scientist studying earth's history"]}, {"entity_id": "geologist", "book_id": "connexion_physical_sciences_somerville_1858", "name": "geologist", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["geologist"], "contexts": ["scientist studying Earth's history"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "géologue", "target_book": "kosmos_humboldt_1845", "target_name": "geologist", "similarity": 0.966}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "géologue", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "geologist", "similarity": 0.872}, {"source_book": "kosmos_humboldt_1845", "source_name": "geologist", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "geologist", "similarity": 0.913}], "id": 919, "stable_key": "clu_8cebc71ce56a89cc", "ground_truth": {"modern_name": "geologist", "confidence": "high", "type": "concept", "note": "The term 'géologue' and its English translations appear in contexts describing scientific study of Earth's structure and history, which directly aligns with the modern concept of a geologist.", "wikidata_id": "Q1069", "wikidata_description": "study of the composition, structure, physical properties, and history of Earth's components, and the processes by which they are shaped"}, "cross_references": []}, {"canonical_name": "Philadelphie", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 10, "members": [{"entity_id": "philadelphie", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Philadelphie", "category": "PLACE", "subcategory": "CITY", "count": 6, "variants": ["Philadelphie"], "contexts": ["city where a voyage was published", "city where a voyage appeared"]}, {"entity_id": "philadelphia", "book_id": "principles_of_psychology_james_1890", "name": "Philadelphia", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Philadelphia"], "contexts": ["city where Dr. Shoemaker is from", "city visited by 'Brown'"]}, {"entity_id": "philadelphia", "book_id": "kosmos_humboldt_1845", "name": "Philadelphia", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Philadelphia"], "contexts": ["latitude where Aurora is frequent"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Philadelphie", "target_book": "principles_of_psychology_james_1890", "target_name": "Philadelphia", "similarity": 0.917}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Philadelphie", "target_book": "kosmos_humboldt_1845", "target_name": "Philadelphia", "similarity": 0.917}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Philadelphia", "target_book": "kosmos_humboldt_1845", "target_name": "Philadelphia", "similarity": 1.0}], "id": 920, "stable_key": "clu_97f32d7ee1e02f9e", "ground_truth": {"modern_name": "Philadelphia", "confidence": "high", "type": "place", "description": "A major city in Pennsylvania, USA.", "wikipedia_extract": "Philadelphia (  FIL-ə-DEL-fee-ə), colloquially referred to as Philly, is the most populous city in the U.S. state of Pennsylvania. It is the sixth-most populous city in the United States with a population of 1.6 million at the 2020 census, while the Philadelphia metropolitan area (sometimes called the Delaware Valley) with 6.33 million residents is the nation's ninth-largest metropolitan area. Philadelphia is known for its culture, cuisine, and history, maintaining contemporary influence in business and technology, sports, and music. Philadelphia was founded in 1682 by William Penn, an English Quaker and advocate of religious freedom, and served as the capital of the colonial era Province of Pennsylvania. It then played a vital role during the American Revolution and Revolutionary War. It served as the central meeting place for the nation's Founding Fathers in hosting the First Continental Congress (1774) and the Second Continental Congress, during which the Founders formed the Continental Army, elected George Washington as its commander, and adopted the Declaration of Independence on July 4, 1776."}, "cross_references": []}, {"canonical_name": "mer", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 10, "members": [{"entity_id": "mer", "book_id": "relation_historique_humboldt_vol3_1825", "name": "mer", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["mer"], "contexts": ["large body of saltwater", "body of saltwater"]}, {"entity_id": "mar", "book_id": "historia_medicinal_monardes_1574", "name": "mar", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["mar", "Mar"], "contexts": ["sea", "sea, where the tree grows near"]}, {"entity_id": "mar", "book_id": "coloquios_da_orta_1563", "name": "mar", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["mar"], "contexts": ["location of origin for substances", "sea"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "mer", "target_book": "historia_medicinal_monardes_1574", "target_name": "mar", "similarity": 0.889}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "mer", "target_book": "coloquios_da_orta_1563", "target_name": "mar", "similarity": 0.889}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "mar", "target_book": "coloquios_da_orta_1563", "target_name": "mar", "similarity": 1.0}], "id": 921, "stable_key": "clu_5360c9f334faae25", "ground_truth": {"modern_name": "sea", "confidence": "high", "type": "place", "wikidata_id": "Q165", "wikidata_description": "city in and county seat of King County, State of Washington, United States", "wikipedia_url": "https://en.wikipedia.org/wiki/Sea", "wikipedia_extract": "A sea is a large body of salt water. There are particular seas and the sea. The sea commonly refers to the ocean, the interconnected body of seawaters that spans most of Earth. Particular seas are either marginal seas, second-order sections of the oceanic sea (e.g. the Mediterranean Sea), or certain large, nearly landlocked bodies of water. The salinity of water bodies varies widely, being lower near the surface and the mouths of large rivers and higher in the depths of the ocean; however, the relative proportions of dissolved salts vary little across the oceans."}, "cross_references": [{"found_name": "Arctic Ocean", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 891, "target_cluster_name": "Polar Sea", "source_book": "llm_generated", "evidence_snippet": "The Arctic Ocean is a specific sea, a part of the larger interconnected body of seawaters referred to as 'the sea'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Arctic Ocean is a specific sea, a part of the larger interconnected body of seawaters referred to as 'the sea'."}, {"found_name": "Baltic Sea", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 319, "target_cluster_name": "Baltic", "source_book": "llm_generated", "evidence_snippet": "The Baltic Sea is a specific sea, a part of the larger interconnected body of seawaters referred to as 'the sea'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Baltic Sea is a specific sea, a part of the larger interconnected body of seawaters referred to as 'the sea'."}, {"found_name": "Bay of Bengal", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 4061, "target_cluster_name": "Mer du Bengal", "source_book": "llm_generated", "evidence_snippet": "The Bay of Bengal is a specific sea, a part of the larger interconnected body of seawaters referred to as 'the sea'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Bay of Bengal is a specific sea, a part of the larger interconnected body of seawaters referred to as 'the sea'."}, {"found_name": "Caspian Sea", "link_type": "same_ref