fidence": "high", "type": "text"}, "cross_references": []}, {"canonical_name": "Farquharson", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "farquhar", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Farquhar", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Farquhar"], "contexts": ["scientist in Calcutta"]}, {"entity_id": "farquharson", "book_id": "kosmos_humboldt_1845", "name": "Farquharson", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Farquharson"], "contexts": ["cited in Edinburgh Philosophical Journal", "contributor to Edinburgh Philos. Journal"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Farquhar", "target_book": "kosmos_humboldt_1845", "target_name": "Farquharson", "similarity": 0.897}], "id": 3058, "stable_key": "clu_05750e1686fcfd19", "ground_truth": {"modern_name": "Farquharson", "confidence": "medium", "type": "person", "description": "Scientist in Calcutta, cited in journal.", "note": "Full name and specific field of study are unclear."}, "cross_references": []}, {"canonical_name": "Asiatieal researches", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "asiatic_researches", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Asiatic Researches", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Asiatic Researches"], "contexts": ["publication containing scientific results"]}, {"entity_id": "asiatieal_researches", "book_id": "coloquios_da_orta_1563", "name": "Asiatieal researches", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 3, "variants": ["Asiatieal researches", "Asiati'cal researches", "Asiatic researches"], "contexts": ["publication title", "publication where sir William Jones is cited"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Asiatic Researches", "target_book": "coloquios_da_orta_1563", "target_name": "Asiatieal researches", "similarity": 0.976}], "id": 3059, "stable_key": "clu_5a8c17122c9c9d3c", "ground_truth": {"modern_name": "Asiatic Researches", "confidence": "high", "type": "text", "wikidata_id": "Q5708276", "wikidata_description": "journal, 1788-1839", "wikipedia_extract": "Cholera () is an infection of the small intestine by some strains of the bacterium Vibrio cholerae. Symptoms may range from none, to mild, to severe. The classic symptom is large amounts of watery diarrhea lasting a few days. Vomiting and muscle cramps may also occur. Diarrhea can be so severe that it leads within hours to severe dehydration and electrolyte imbalance. This can in turn result in sunken eyes, cold or cyanotic skin, decreased skin elasticity, wrinkling of the hands and feet, and, in severe cases, death.", "wikipedia_url": "https://es.wikipedia.org/wiki/Asiatic_Researches"}, "cross_references": [{"found_name": "Tom. III", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 661, "target_cluster_name": "Tom. III", "source_book": "llm_generated", "evidence_snippet": "This is a specific title of a publication that would be organized into volumes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: This is a specific title of a publication that would be organized into volumes.", "is_reverse": true}]}, {"canonical_name": "R. Hodgson", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "adam_hodgson", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Adam Hodgson", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Adam Hodgson"], "contexts": ["author of a letter"]}, {"entity_id": "r__hodgson", "book_id": "principles_of_psychology_james_1890", "name": "R. Hodgson", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants"