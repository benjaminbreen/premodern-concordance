t_cluster_id": 505, "target_cluster_name": "discoveries", "source_book": "llm_generated", "evidence_snippet": "Discoveries are the result of the expansion and application of human knowledge.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Discoveries are the result of the expansion and application of human knowledge."}, {"found_name": "Calculation", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1380, "target_cluster_name": "calculation", "source_book": "llm_generated", "evidence_snippet": "Calculation is a fundamental tool and method used in the acquisition and manipulation of human knowledge, particularly in quantitative fields.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Calculation is a fundamental tool and method used in the acquisition and manipulation of human knowledge, particularly in quantitative fields."}]}, {"canonical_name": "Great Indian Archipelago", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "great_indian_archipelago", "book_id": "kosmos_humboldt_1845", "name": "Great Indian Archipelago", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Great Indian Archipelago"], "contexts": ["region with varied natural elements"]}, {"entity_id": "indian_archipelago", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Indian Archipelago", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Indian Archipelago"], "contexts": ["islands between Asia and Australia"]}, {"entity_id": "east_indian_archipelago", "book_id": "first_principles_spencer_1862", "name": "East Indian Archipelago", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["East Indian Archipelago"], "contexts": ["archipelago in Southeast Asia"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Great Indian Archipelago", "target_book": "connexion_physical_scien