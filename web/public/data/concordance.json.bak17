rowne_1646", "source_name": "Rome", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Rome", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Rome", "target_book": "kosmos_humboldt_1845", "target_name": "Rome", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Rome", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Rome", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Rome", "target_book": "kosmos_humboldt_1845", "target_name": "Rome", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Rome", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Rome", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Rome", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Rome", "similarity": 1.0}], "id": 281, "stable_key": "clu_2c5df1cb1810f41f", "ground_truth": {"modern_name": "Rome", "confidence": "high", "type": "place", "description": "Ancient city, center of the Roman Empire and a significant historical location.", "note": "Includes references to the Roman Empire itself.", "wikipedia_extract": "Rome is the capital city and most populated comune (municipality) of Italy. It is also the administrative centre of the Lazio region and of the Metropolitan City of Rome. A special comune named Roma Capitale with 2,746,984 residents in 1,287.36 km2 (497.1 mi2), Rome is the third most populous city in the European Union by population within city limits. The Metropolitan City of Rome Capital, with a population of 4,223,885 residents, is the most populous metropolitan city in Italy. Its metropolitan area is the third-most populous within Italy. Rome is located in the central-western portion of the Italian Peninsula, within Lazio (Latium), along the shores of the Tiber Valley."}, "member_count": 8, "cross_references": [{"found_name": "ciudad", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2007, "target_cluster_name": "ciudad", "source_book": "llm_generated", "evidence_snippet": "A historically significant city that served as a model for many other cities.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: A historically significant city that served as a model for many other cities.", "is_reverse": true}]}, {"canonical_name": "conception", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 47, "members": [{"entity_id": "conception", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "conception", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["conception"], "contexts": ["process of becoming pregnant"]}, {"entity_id": "conception", "book_id": "origin_of_species_darwin_1859", "name": "conception", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["conception"], "contexts": ["process of becoming pregnant"]}, {"entity_id": "conception", "book_id": "principles_of_psychology_james_1890", "name": "conception", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 25, "variants": ["conception", "CONCEPTION", "Conception"], "contexts": ["sense of sameness, abstract ideas", "mental grasp of an idea"]}, {"entity_id": "conception", "book_id": "first_principles_spencer_1862", "name": "conception", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["conception"], "contexts": ["mental representation or understanding of an object", "mental representation of an idea"]}, {"entity_id": "conceptions", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "conceptions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["conceptions"], "contexts": ["perfect ideas or forms"]}, {"entity_id": "conception", "book_id": "english_physician_1652", "name": "Conception", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["Conception", "Conction"], "contexts": ["hindered by herb", "process of becoming pregnant"]}, {"entity_id": "conceptions", "book_id": "principles_of_psychology_james_1890", "name": "conceptions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 8, "variants": ["conceptions", "Conceptions"], "contexts": ["mental grasp of ideas", "mental representations of objects"]}, {"entity_id": "conceptions", "book_id": "first_principles_spencer_1862", "name": "conceptions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["conceptions"], "contexts": ["mental representations of actualities", "mental representations or ideas"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "conception", "target_book": "origin_of_species_darwin_1859", "target_name": "conception", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "conception", "target_book": "principles_of_psychology_james_1890", "target_name": "conception", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "conception", "target_book": "first_principles_spencer_1862", "target_name": "conception", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "conception", "target_book": "principles_of_psychology_james_1890", "target_name": "conception", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "conception", "target_book": "first_principles_spencer_1862", "target_name": "conception", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "conception", "target_book": "first_principles_spencer_1862", "target_name": "conception", "similarity": 1.0}], "id": 282, "stable_key": "clu_a52b71dae6fbe49d", "ground_truth": {"modern_name": "Conception", "confidence": "high", "type": "concept", "note": "This cluster refers to both the biological process of pregnancy and the philosophical/psychological process of forming an idea or understanding.", "wikidata_id": "Q1880", "wikidata_description": "city in Chile", "wikipedia_url": "https://en.wikipedia.org/wiki/Concepci%C3%B3n%2C%20Chile", "wikipedia_extract": "Concepción (Spanish pronunciation: [konseβˈsjon] ; originally: Concepción de la Madre Santísima de la Luz, \"Conception of the Blessed Mother of Light\") is a city and commune in south-central Chile, and the geographical and demographic core of the Greater Concepción metropolitan area, it is the second largest city in Chile by urban area and one of the three major conurbations in the country. It has a significant impact on domestic trade being part of the most heavily industrialized region in the country. It is the seat of the Concepción Province and the capital of the Biobío Region. It sits about 500 km south of the nation's capital, Santiago. The city was first settled in the Bay of Concepción, in the zone that would later become the commune of Penco, now part of the Concepción conurbation. The city's demonym, penquista, comes from the place of its original foundation."}, "member_count": 8, "cross_references": [{"found_name": "ideas", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 226, "target_cluster_name": "ideas", "source_book": "llm_generated", "evidence_snippet": "The act of forming an idea is synonymous with conception.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The act of forming an idea is synonymous with conception.", "is_reverse": true}, {"found_name": "tendency", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1462, "target_cluster_name": "tendency", "source_book": "llm_generated", "evidence_snippet": "Tendencies can be formed through conception or understanding.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Tendencies can be formed through conception or understanding.", "is_reverse": true}, {"found_name": "Being", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2425, "target_cluster_name": "Being", "source_book": "llm_generated", "evidence_snippet": "Conception is the process of forming a concept or idea.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Conception is the process of forming a concept or idea.", "is_reverse": true}, {"found_name": "opinions", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2924, "target_cluster_name": "opinions", "source_book": "llm_generated", "evidence_snippet": "Conception is the initial formation of an idea or opinion.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Conception is the initial formation of an idea or opinion.", "is_reverse": true}, {"found_name": "consciousness", "link_type": "contested_identity", "link_strength": 0.7, "target_cluster_id": 204, "target_cluster_name": "consciousness", "source_book": "first_principles_spencer_1862", "evidence_snippet": "the same way that we think of minor objects. What conception, then, do we form of it? the reader may ask. That its name calls up in us some state of consciousness is unquestionable; and if this state ", "confidence": 0.8, "auto_label": "contested_identity", "found_relationship": "reverse: a state that may be confused with consciousness", "is_reverse": true}, {"found_name": "theory", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 68, "target_cluster_name": "theory", "source_book": "llm_generated", "evidence_snippet": "Theories are formed through conception and understanding.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Theories are formed through conception and understanding.", "is_reverse": true}, {"found_name": "liberté", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_i