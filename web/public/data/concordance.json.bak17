cal", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Pascal"], "contexts": ["cited authority on vertigo", "cited for treating diseases"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Pascal", "target_book": "polyanthea_medicinal", "target_name": "Pascal", "similarity": 0.793}], "id": 3096, "stable_key": "clu_136edb856286d774", "ground_truth": {"modern_name": "Blaise Pascal", "confidence": "high", "type": "person", "birth_year": 1623, "death_year": 1662, "description": "French mathematician, physicist, inventor, writer, philosopher, and theologian", "wikidata_id": "Q1290", "wikidata_description": "French mathematician, physicist, inventor, writer, and Christian philosopher (1623–1662)"}, "cross_references": [{"found_name": "mathematicians", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1337, "target_cluster_name": "mathematicians", "source_book": "llm_generated", "evidence_snippet": "Pascal was a mathematician and physicist who made significant contributions to probability theory and fluid mechanics.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Pascal was a mathematician and physicist who made significant contributions to probability theory and fluid mechanics.", "is_reverse": true}]}, {"canonical_name": "black", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "black", "book_id": "principles_of_psychology_james_1890", "name": "black", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["black"], "contexts": ["particular color", "particular color of man"]}, {"entity_id": "negra", "book_id": "polyanthea_medicinal", "name": "negra", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["negra"], "contexts": ["black color", "color description"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "black", "target_book": "polyanthea_medicinal", "target_name": "negra", "similarity": 0.942}], "id": 3097, "stable_key": "clu_744b2f497061e19d", "ground_truth": {"modern_name": "black", "confidence": "high", "type": "concept", "description": "A color, the darkest color, resulting from the absence of light.", "wikipedia_extract": "Black is a color that results from the absence or complete absorption of visible light. It is an achromatic color, without chroma, like white and grey. It is often used symbolically or figuratively to represent darkness. Black and white have often been used to describe opposites such as good and evil, the Dark Ages versus the Age of Enlightenment, and night versus day. Since the Middle Ages, black has been the symbolic color of solemnity and authority, and for this reason it is still commonly worn by judges and magistrates. Black was one of the first colors used by artists in Neolithic cave paintings."}, "cross_references": []}, {"canonical_name": "skin-spot", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "skin-spot", "book_id": "principles_of_psychology_james_1890", "name": "skin-spot", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["skin-spot"], "contexts": ["specific area on the skin", "area on skin for sensation"]}, {"entity_id": "spots", "book_id": "connexion_physical_sciences_somerville_1858", "name": "spots", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["spots"], "contexts": ["formed by gaseous eruptions", "dark areas on stellar surfaces"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "skin-spot", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "spots", "similarity": 0.89}], "id": 3098, "stable_key": "clu_e9daedd3349b3b29", "ground_truth": {"modern_name": "Skin discoloration", "confidence": "medium", "type": "concept", "note": "The term 'skin-spot' can refer to various phenomena from pigmentation changes to efflorescence. 'Spots' is very general. Given the context of 'gaseous eruptions', it likely refers to an observable mark or eruption on the skin."}, "cross_references": []}, {"canonical_name": "Lehmann", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "lehmann", "book_id": "principles_of_psychology_james_1890", "name": "Lehmann", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Dr. Lehmann", "Lehmann"], "contexts": ["experimentalist in Wundt's laboratory", "experimentalist in psychology"]}, {"entity_id": "lehmann", "book_id": "kosmos_humboldt_1845", "name": "Lehmann", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Lehmann"], "contexts": ["author on comet tails"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Lehmann", "target_book": "kosmos_humboldt_1845", "target_name": "Lehmann", "similarity": 1.0}], "id": 3099, "stable_key": "clu_c81e7485c807621d", "ground_truth": {"modern_name": "Johann Georg Lehmann", "confidence": "high", "type": "person", "birth_year": 1815, "death_year": 1876, "description": "German physician, botanist, and chemist", "note": "There were multiple notable individuals named Lehmann in science during this period. Johann Georg Lehmann fits the description of an experimentalist (in chemistry/physiology) and author on scientific topics. For comet tails, Alexander von Humboldt might be a more direct association, but Lehmann also engaged with broader scientific topics."}, "cross_references": []}, {"canonical_name": "Langelot", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "langley", "book_id": "principles_of_psychology_james_1890", "name": "Langley", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Langley"], "contexts": ["author of Practical Physiology"]}, {"entity_id": "langelot", "book_id": "polyanthea_medicinal", "name": "Langelot", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Langelot"], "contexts": ["author cited for a case of gout", "revealed his Panacea for reward"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Langley", "target_book": "polyanthea_medicinal", "target_name": "Langelot", "similarity": 0.854}], "id": 3100, "stable_key": "clu_4a149079c8fee582", "ground_truth": {"modern_name": "Jean François Louis Langelot", "confidence": "high", "type": "person", "description": "French physician and author of medical texts."}, "cross_references": []}, {"canonical_name": "spontaneous motion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "spontaneous_motion", "book_id": "principles_of_psychology_james_1890", "name": "spontaneous motion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["spontaneous motion"], "contexts": ["motion not caused by external stimulus"]}, {"entity_id": "spontaneous_motion", "book_id": "kosmos_humboldt_1845", "name": "spontaneous motion", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["spontaneous motion"], "contexts": ["motion without external cause", "question of inherent movement"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "spontaneous motion", "target_book": "kosmos_humboldt_1845", "target_name": "spontaneous motion", "similarity": 1.0}], "id": 3101, "stable_key": "clu_8951bf3e664e1864", "ground_truth": {"modern_name": "Spontaneous Motion", "confidence": "high", "type": "concept", "note": "In early modern texts, this often refers to motion not caused by external forces, a concept discussed in physics and later in psychology regarding volition and instinct.", "wikidata_id": "Q30528428", "wikidata_description": "scientific articl