und_relationship": "Bark is the outer layer of wood in trees and shrubs."}, {"found_name": "especiarias", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2144, "target_cluster_name": "especiarias", "source_book": "llm_generated", "evidence_snippet": "Bark is listed as one of the plant parts that can be used as spices.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Bark is listed as one of the plant parts that can be used as spices.", "is_reverse": true}, {"found_name": "vegetable matter", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2832, "target_cluster_name": "vegetable matter", "source_book": "llm_generated", "evidence_snippet": "Bark is a specific part of plant matter.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Bark is a specific part of plant matter.", "is_reverse": true}]}, {"canonical_name": "Sussex", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "sussex", "book_id": "english_physician_1652", "name": "Sussex", "category": "PLACE", "subcategory": "REGION", "count": 15, "variants": ["Sussex"], "contexts": ["county where a student lived", "county where Dog-wood is called"]}, {"entity_id": "sussex", "book_id": "origin_of_species_darwin_1859", "name": "Sussex", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Sussex"], "contexts": ["location of ant nest observations"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Sussex", "target_book": "origin_of_species_darwin_1859", "target_name": "Sussex", "similarity": 1.0}], "id": 1837, "stable_key": "clu_f6a10cc378303179", "ground_truth": {"modern_name": "Sussex", "confidence": "high", "type": "place", "description": "A county in England, mentioned for local flora and fauna observations.", "wikipedia_extract": "Sussex (/ˈsʌsɪks/;  from the Old English Sūþseaxe; lit. 'South Saxons'; 'Sussex') is an area of South East England that was historically a kingdom and, later, a county. The current ceremonial counties of East Sussex and West Sussex cover approximately the same area. The two ceremonial counties border Surrey to the north, Kent to the north-east, the English Channel to the south, and Hampshire to the west. Sussex contains the city of Brighton and Hove and its wider city region, part of the South Downs National Park and the national landscape of the High Weald, and Chichester Harbour. Its coastline is 137 miles (220 km) long. The Kingdom of Sussex emerged in the fifth century in the area that had previously been inhabited by the Regni tribe in the Romano-British period."}, "cross_references": [{"found_name": "Kent", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1708, "target_cluster_name": "Kent", "source_book": "llm_generated", "evidence_snippet": "Kent borders Sussex.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Kent borders Sussex.", "is_reverse": true}]}, {"canonical_name": "Gums", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "gums", "book_id": "english_physician_1652", "name": "Gums", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 15, "variants": ["Gums"], "contexts": ["part of the mouth fastened by plantain", "sores of the mouth or gums"]}, {"entity_id": "gums", "book_id": "connexion_physical_sciences_somerville_1858", "name": "gums", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["gums"], "contexts": ["sticky substances from plants"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Gums", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "gums", "similarity": 0.698}], "id": 1838, "stable_key": "clu_55ad93fe44d357a8", "ground_truth": {"modern_name": "Gums", "confidence": "medium", "type": "co