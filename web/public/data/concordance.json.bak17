le_key": "clu_8507ca77402d628a", "ground_truth": {"modern_name": "Reason", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/Reason", "wikipedia_extract": "Reason is the capacity of consciously applying logic by drawing valid conclusions from new or existing information, with the aim of seeking truth. It is associated with such characteristically human activities as philosophy, religion, science, language, and mathematics, and is normally considered to be a distinguishing ability possessed by humans. Reason is sometimes referred to as rationality, although the latter is more about its application. Reasoning involves using more-or-less rational processes of thinking and cognition to extrapolate from one's existing knowledge to generate new knowledge, and involves the use of one's intellect. The field of logic studies the ways in which humans can use formal reasoning to produce logically valid arguments and true conclusions. Reasoning may be subdivided into forms of logical reasoning, such as deductive reasoning, inductive reasoning, and abductive reasoning."}, "cross_references": [{"found_name": "Association of Ideas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1992, "target_cluster_name": "association of ideas", "source_book": "llm_generated", "evidence_snippet": "The process of forming associations between ideas is closely linked to the operation of reason.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The process of forming associations between ideas is closely linked to the operation of reason."}, {"found_name": "vertue", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2161, "target_cluster_name": "vertue", "source_book": "llm_generated", "evidence_snippet": "Reason is often considered a virtue, enabling individuals to discern right from wrong and to act in accordance with moral principles.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Reason is often considered a virtue, enabling individuals to discern right from wrong and to act in accordance with moral principles.", "is_reverse": true}]}, {"canonical_name": "dogs", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 7, "total_mentions": 74, "members": [{"entity_id": "dogs", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Dogs", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 8, "variants": ["Dogs"], "contexts": ["canine animals", "animals used in experiments"]}, {"entity_id": "dogs", "book_id": "origin_of_species_darwin_1859", "name": "dogs", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 12, "variants": ["dogs", "Dogs"], "contexts": ["domesticated canid species", "domesticated mammals with many breeds"]}, {"entity_id": "dogs", "book_id": "principles_of_psychology_james_1890", "name": "dogs", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 19, "variants": ["dogs", "Dogs"], "contexts": ["mammals for observation", "animal used in experiments"]}, {"entity_id": "dogs", "book_id": "kosmos_humboldt_1845", "name": "dogs", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["dogs"], "contexts": ["domesticated canine animals", "burned bones found in fire-heaps"]}, {"entity_id": "dogs", "book_id": "first_principles_spencer_1862", "name": "dogs", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["dogs"], "contexts": ["living objects in tapestries", "domesticated canine species"]}, {"entity_id": "dogs", "book_id": "english_physician_1652", "name": "Dogs", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 4, "variants": ["Dogs"], "contexts": ["animals whose bites are treated", "domesticated canine"]}, {"entity_id": "cães", "book_id": "polyanthea_medicinal", "name": "cães", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["cães"], "contex