id": "connexion_physical_sciences_somerville_1858", "name": "marshes", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["marshes"], "contexts": ["wetland areas"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Marshes", "target_book": "kosmos_humboldt_1845", "target_name": "marshes", "similarity": 0.986}, {"source_book": "english_physician_1652", "source_name": "Marshes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "marshes", "similarity": 0.986}, {"source_book": "kosmos_humboldt_1845", "source_name": "marshes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "marshes", "similarity": 1.0}], "id": 1321, "stable_key": "clu_b192db04fba9b914", "ground_truth": {"modern_name": "Wetlands", "confidence": "high", "type": "place", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_extract": "A Wetlands is a distinct semi-aquatic ecosystem whose groundcovers are flooded or saturated in water, either permanently, for years or decades, or only seasonally. Flooding results in oxygen-poor (anoxic) processes taking place, especially in the soils. Wetlands form a transitional zone between waterbodies and dry lands, and are different from other terrestrial or aquatic ecosystems due to their vegetation's roots having adapted to oxygen-poor waterlogged soils. They are considered among the most biologically diverse of all ecosystems, serving as habitats to a wide range of aquatic and semi-aquatic plants and animals, with often improved water quality due to plant removal of excess nutrients such as nitrates and phosphorus. Wetlands exist on every continent, except Antarctica. The water in wetlands is either freshwater, brackish or saltwater.", "wikipedia_url": "https://en.wikipedia.org/wiki/Wetland"}, "cross_references": []}, {"canonical_name": "Virgins", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "virgins", "book_id": "english_physician_1652", "name": "Virgins", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Virgins"], "contexts": ["young unmarried women", "group angered by Mars' effects"]}, {"entity_id": "virgines", "book_id": "polyanthea_medicinal", "name": "virgines", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["virgines"], "contexts": ["young women"]}, {"entity_id": "virgins", "book_id": "first_principles_spencer_1862", "name": "virgins", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["virgins"], "contexts": ["religious subject in art"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Virgins", "target_book": "polyanthea_medicinal", "target_name": "virgines", "similarity": 0.932}, {"source_book": "english_physician_1652", "source_name": "Virgins", "target_book": "first_principles_spencer_1862", "target_name": "virgins", "similarity": 0.924}, {"source_book": "polyanthea_medicinal", "source_name": "virgines", "target_book": "first_principles_spencer_1862", "target_name": "virgins", "similarity": 0.992}], "id": 1322, "stable_key": "clu_d661d2bf881c1fc4", "ground_truth": {"modern_name": "Virgins", "confidence": "medium", "type": "person", "description": "Young, unmarried females, often with religious or social connotations.", "note": "The term 'Virgins' in this context likely refers to young, unmarried women, but could also have specific religious or social connotations depending on the text's focus. The Wikidata search term is chosen to cover the broader concept.", "wikidata_id": "Q170538", "wikidata_description": "state of a person who has never engaged in sexual intercourse"}, "cross_references": [{"found_name": "Child", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 238, "target_cluster_name": "criança", "source_book": "llm_generated", "evidence_snippet": "A 'child' can be a 'virgin'.", "confiden