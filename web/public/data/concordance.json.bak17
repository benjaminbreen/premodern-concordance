inciples_spencer_1862", "name": "respiration", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["respiration"], "contexts": ["process of breathing"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "breath", "target_book": "english_physician_1652", "target_name": "Breath", "similarity": 0.989}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "breath", "target_book": "principles_of_psychology_james_1890", "target_name": "breathing", "similarity": 0.975}, {"source_book": "english_physician_1652", "source_name": "Breath", "target_book": "principles_of_psychology_james_1890", "target_name": "breathing", "similarity": 0.969}], "id": 752, "stable_key": "clu_c3e7bcbd38c33e6b", "ground_truth": {"modern_name": "Respiration", "confidence": "high", "type": "concept", "note": "The term 'Breath' can refer to both the substance exhaled and the process.", "wikidata_id": "Q9530", "wikidata_description": "process that moves air in and out of the lungs", "wikipedia_url": "https://en.wikipedia.org/wiki/Breathing", "wikipedia_extract": "Breathing (respiration or ventilation) is the rhythmic process of moving air into (inhalation) and out of (exhalation) the lungs to enable gas exchange with the internal environment, primarily to remove carbon dioxide and take in oxygen. All aerobic organisms require oxygen for cellular respiration, which extracts energy from food and produces carbon dioxide as a waste product. External respiration (breathing) brings air to the alveoli where gases move by diffusion; the circulatory system then transports oxygen and carbon dioxide between the lungs and the tissues. In vertebrates with lungs, breathing consists of repeated cycles of inhalation and exhalation through a branched system of airways that conduct air from the nose or mouth to the alveoli. The number of respiratory cycles per minute — the respiratory or breathing rate — is a primary vital sign. Under normal conditions, depth and rate of breathing are controlled unconsciously by homeostatic mechanisms that maintain arterial partial pressures of carbon dioxide and oxygen."}, "member_count": 6, "cross_references": [{"found_name": "nariz", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 225, "target_cluster_name": "nariz", "source_book": "llm_generated", "evidence_snippet": "The nose is a primary organ for respiration.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The nose is a primary organ for respiration.", "is_reverse": true}, {"found_name": "Air", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 109, "target_cluster_name": "air", "source_book": "llm_generated", "evidence_snippet": "Respiration is the process of moving air into and out of the lungs.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Respiration is the process of moving air into and out of the lungs."}, {"found_name": "Atmosphere", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 213, "target_cluster_name": "atmosphere", "source_book": "llm_generated", "evidence_snippet": "Respiration involves the exchange of gases with the atmosphere.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Respiration involves the exchange of gases with the atmosphere."}, {"found_name": "Gaseous substances", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2321, "target_cluster_name": "gaseous", "source_book": "llm_generated", "evidence_snippet": "Respiration is a process involving the exchange of gaseous substances (oxygen and carbon dioxide).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Respiration is a process involving the exchange of gaseous substances (oxygen and carbon dioxide)."}, {"found_name": "Gas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 171, "target_cluster_n