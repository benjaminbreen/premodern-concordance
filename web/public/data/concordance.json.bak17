dt_1845", "name": "radiating heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["radiating heat"], "contexts": ["transfer of heat through electromagnetic waves", "energy transfer"]}, {"entity_id": "radiation_of_heat", "book_id": "connexion_physical_sciences_somerville_1858", "name": "radiation of heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Radiation of heat", "radiation of heat"], "contexts": ["transfer of motion from particles", "emission of thermal energy"]}, {"entity_id": "radiant_heat", "book_id": "first_principles_spencer_1862", "name": "radiant heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["radiant heat"], "contexts": ["researches into radiant heat and light", "researches into physical phenomena"]}, {"entity_id": "radiation_of_heat", "book_id": "kosmos_humboldt_1845", "name": "radiation of heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["radiation of heat"], "contexts": ["emission of thermal energy"]}, {"entity_id": "thermal_radiations", "book_id": "first_principles_spencer_1862", "name": "thermal radiations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["thermal radiations"], "contexts": ["radiations associated with heat"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "radiating heat", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "radiation of heat", "similarity": 0.938}, {"source_book": "kosmos_humboldt_1845", "source_name": "radiating heat", "target_book": "first_principles_spencer_1862", "target_name": "radiant heat", "similarity": 0.981}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "radiation of heat", "target_book": "first_principles_spencer_1862", "target_name": "radiant heat", "similarity": 0.924}, {"source_book": "kosmos_humboldt_1845", "source_name": "radiation of heat", "