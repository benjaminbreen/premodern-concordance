T", "count": 1, "variants": ["modifications"], "contexts": ["changes or alterations"]}, {"entity_id": "modifications", "book_id": "first_principles_spencer_1862", "name": "modifications", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["modifications"], "contexts": ["changes in form"]}, {"entity_id": "organic_change", "book_id": "origin_of_species_darwin_1859", "name": "organic change", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["organic change"], "contexts": ["alteration in living organisms", "measure of time in fossil record"]}, {"entity_id": "organic_modification", "book_id": "principles_of_psychology_james_1890", "name": "organic modification", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["organic modification"], "contexts": ["physical change in brain tissue"]}, {"entity_id": "organic_changes", "book_id": "first_principles_spencer_1862", "name": "organic changes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["organic changes"], "contexts": ["bodily transformations", "changes in living organisms"]}, {"entity_id": "biologic_changes", "book_id": "first_principles_spencer_1862", "name": "biologic changes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["biologic changes"], "contexts": ["alterations in living organisms"]}, {"entity_id": "organic_change", "book_id": "first_principles_spencer_1862", "name": "organic change", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["organic change"], "contexts": ["changes in tissues related to life"]}, {"entity_id": "zoological_evolution", "book_id": "principles_of_psychology_james_1890", "name": "zoological evolution", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["zoological evolution"], "contexts": ["process of development across animal species", "theory of species development"]}, {"entity_id": "morphological_evolution", "book_id": "kosmos_humboldt_1845", "name": "morphological evolution", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["morphological evolution"], "contexts": ["development of plant forms"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "evolve", "target_book": "first_principles_spencer_1862", "target_name": "Evolution", "similarity": 0.893}, {"source_book": "principles_of_psychology_james_1890", "source_name": "evolution", "target_book": "kosmos_humboldt_1845", "target_name": "evolution", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "evolution", "target_book": "first_principles_spencer_1862", "target_name": "Evolutions", "similarity": 0.935}, {"source_book": "kosmos_humboldt_1845", "source_name": "evolution", "target_book": "first_principles_spencer_1862", "target_name": "Evolutions", "similarity": 0.935}], "id": 540, "stable_key": "clu_884b3c7a947664a6", "ground_truth": {"modern_name": "Evolution", "confidence": "high", "type": "concept", "note": "The overwhelming frequency of 'Evolution' in Spencer's and James's works, along with the contexts 'biological change' and 'development across animal species,' clearly points to the scientific concept of evolution.", "wikidata_id": "Q4038411", "wikidata_description": "monthly scientific journal", "wikipedia_url": "https://en.wikipedia.org/wiki/Evolution", "wikipedia_extract": "Evolution is the change in the heritable characteristics of biological populations over successive generations. It occurs when evolutionary processes such as genetic drift and natural selection act on genetic variation, resulting in certain characteristics becoming more or less common within a population over successive generations. The process of evolution has given rise to biodiversity at every level of biological organisation. The scientific theory of evolution by natural selection was conceived independently by two British naturalists, Charles Darwin and Alfred Russel Wallace, in the mid-19th century as an explanation for why organisms are adapted to their physical and biological environments. The theory was first set out in detail in Darwin's book On the Origin of Species. Evolution by natural selection is established by observable facts about living organisms: (1) more offspring are often produced than can possibly survive; (2) traits vary among individuals with respect to their morphology, physiology, and behaviour; (3) different traits confer different rates of survival and reproduction (differential fitness); and (4) traits can be passed from generation to generation (heritability of fitness)."}, "member_count": 16, "cross_references": [{"found_name": "tendency", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1462, "target_cluster_name": "tendency", "source_book": "llm_generated", "evidence_snippet": "Tendencies can be indicative of evolutionary processes or directions.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Tendencies can be indicative of evolutionary processes or directions.", "is_reverse": true}, {"found_name": "Growth", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2277, "target_cluster_name": "Growth", "source_book": "llm_generated", "evidence_snippet": "Evolution describes the gradual development and change of organisms over time, a form of growth and development.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Evolution describes the gradual development and change of organisms over time, a form of growth and development.", "is_reverse": true}, {"found_name": "species", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 32, "target_cluster_name": "species", "source_book": "llm_generated", "evidence_snippet": "Evolutionary processes act upon populations of species, leading to the formation of new species and the modification of existing ones. The concept of species is central to understanding evolutionary history and mechanisms.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Evolutionary processes act upon populations of species, leading to the formation of new species and the modification of existing ones. The concept of species is central to understanding evolutionary history and mechanisms.", "is_reverse": true}, {"found_name": "discoveries", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 505, "target_cluster_name": "discoveries", "source_book": "llm_generated", "evidence_snippet": "Evolution can lead to new discoveries about the development of species.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Evolution can lead to new discoveries about the development of species.", "is_reverse": true}, {"found_name": "natural selection", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 529, "target_cluster_name": "natural selection", "source_book": "llm_generated", "evidence_snippet": "Natural selection is a fundamental mechanism of evolution, explaining how species change and diversify over generations.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Natural selection is a fundamental mechanism of evolution, explaining how species change and diversify over generations.", "is_reverse": true}, {"found_name": "Adaptation", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1294, "target_cluster_name": "adaptation", "source_book": "llm_generated", "evidence_snippet": "Adaptation is a key mechanism and outcome of evolution, referring to traits that increase an organism's survival and reproduction in its environment.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Adaptation is a key mechanism and outcome of evolution, referring to traits that increase an organism's survival and reproduction in its environment."}, {"found_name": "Breed", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2181, "target_cluster_name": "breed", "source_book": "llm_generated", "evidence_snippet": "Breeds are created through artificial selection, a process analogous to natural selection and a form of evolutionary change within domesticated species.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Breeds are created through artificial selection, a process analogous to natural selection and a form of evolutionary change within domesticated species."}, {"found_name": "Divergence of Character", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1796, "target_cluster_name": "Divergence of Character", "source_book": "llm_generated", "evidence_snippet": "Divergence of character describes the evolutionary process where populations evolve to be more distinct, often leading to speciation.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Divergence of character describes the evolutionary process where populations evolve to be more distinct, often leading to speciation."}, {"found_name": "Economy of nature", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1147, "target_cluster_name": "economy of nature", "source_book": "llm_generated", "evidence_snippet": "The 'economy of nature' concept, prevalent in early evolutionary thought, refers to the balance and interconnectedness of species and resources within an ecosystem, a subject deeply intertwined with evolutionary processes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The 'economy of nature' concept, prevalent in early evolutionary thought, refers to the balance and interconnectedness of species and resources within an ecosystem, a subject deeply intertwined with evolutionary processes."}, {"found_name": "Extinct species", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3360, "target_cluster_name": "extinct species", "source_book": "llm_generated", "evidence_snippet": "Extinct species are a direct result of evolutionary processes, representing lineages that have ceased to exist.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Extinct species are a direct result of evolutionary processes, representing lineages that have ceased to exist."}, {"found_name": "Generation", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 166, "target_cluster_name": "generation", "source_book": "llm_generated", "evidence_snippet": "Generation refers to the process of reproduction and the passing of traits from one generation to the next, which is fundamental to the mechanism of evolution.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Generation refers to the process of reproduction and the passing of traits from one generation to the next, which is fundamental to the mechanism of evolution."}, {"found_name": "reproduction", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 845, "target_cluster_name": "reproduction", "source_book": "llm_generated", "evidence_snippet": "Evolution is the broader process by which populations change over generations, driven in part by the variations introduced through reproduction.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Evolution is the broader process by which populations change over generations, driven in part by the variations introduced through reproduction.", "is_reverse": true}, {"found_name": "development", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 960, "target_cluster_name": "development", "source_book": "llm_generated", "evidence_snippet": "Evolution is a process of gradual development and change over time, often applied to biological organisms but also to concepts and societies