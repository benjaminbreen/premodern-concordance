 size, with an area of 441 square degrees (1.1% of the celestial sphere)."}, "cross_references": [{"found_name": "Cancer", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1709, "target_cluster_name": "Cancer", "source_book": "llm_generated", "evidence_snippet": "Aries is another sign of the zodiac, related to Cancer as part of the same astrological system.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Aries is another sign of the zodiac, related to Cancer as part of the same astrological system.", "is_reverse": true}, {"found_name": "astronomy", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 276, "target_cluster_name": "astronomy", "source_book": "llm_generated", "evidence_snippet": "Aries is a constellation and a zodiac sign, relevant to historical astronomical observations and astrology.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Aries is a constellation and a zodiac sign, relevant to historical astronomical observations and astrology.", "is_reverse": true}, {"found_name": "Stars", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2672, "target_cluster_name": "Stars", "source_book": "llm_generated", "evidence_snippet": "Aries is a constellation, a pattern of stars, and a zodiac sign.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Aries is a constellation, a pattern of stars, and a zodiac sign.", "is_reverse": true}, {"found_name": "Astrology", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1840, "target_cluster_name": "Astrology", "source_book": "llm_generated", "evidence_snippet": "Aries is a zodiac constellation, central to astrological practice.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Aries is a zodiac constellation, central to astrological practice."}, {"found_name": "Celestial body", "link_type": "conc