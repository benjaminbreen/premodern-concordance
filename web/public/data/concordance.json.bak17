": "coloquios_da_orta_1563", "evidence_snippet": "diz á maneira de lentilha. ORTA A Dioscorides e a Plinio foi dada falsa enformaçam, por- que estas folhas naçem em huma arvore grande, longe donde ha alagoas, e nam dentro das alagoas; o arvore que dá", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "alternative name for 'buticairos'"}]}, {"canonical_name": "causa fria", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "causa_fria", "book_id": "coloquios_da_orta_1563", "name": "causa fria", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["causa fria"], "contexts": ["cold cause of headache"]}, {"entity_id": "causa_fria", "book_id": "polyanthea_medicinal", "name": "causa fria", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["causa fria"], "contexts": ["condition for using baths"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "causa fria", "target_book": "polyanthea_medicinal", "target_name": "causa fria", "similarity": 1.0}], "id": 4473, "stable_key": "clu_7ecdf260d33c18a2", "ground_truth": {"modern_name": "Coldness", "confidence": "high", "type": "concept", "note": "Refers to the quality of coldness as a cause or condition in medical contexts.", "wikidata_id": "Q270952", "wikidata_description": "relative or subjective state of low temperature"}, "cross_references": [{"found_name": "friealdade", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 664, "target_cluster_name": "friealdade", "source_book": "llm_generated", "evidence_snippet": "This is a direct Portuguese translation of 'coldness'.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "This is a direct Portuguese translation of 'coldness'."}, {"found_name": "cold", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 201, "target_cluster_name": "frio", "source_book": "llm_generated