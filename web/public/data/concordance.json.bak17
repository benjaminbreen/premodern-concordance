{"entity_id": "opilações", "book_id": "polyanthea_medicinal", "name": "opilações", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 18, "variants": ["opilações", "opilaçaó", "opilaçoens", "opilação", "opilações remas beldes", "oppilados", "oppilaçoens"], "contexts": ["obstructions, a medical condition", "obstructions, medical condition"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "opilaciones", "target_book": "coloquios_da_orta_1563", "target_name": "opilações", "similarity": 0.985}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "opilaciones", "target_book": "polyanthea_medicinal", "target_name": "opilações", "similarity": 0.899}, {"source_book": "coloquios_da_orta_1563", "source_name": "opilações", "target_book": "polyanthea_medicinal", "target_name": "opilações", "similarity": 0.908}], "id": 648, "stable_key": "clu_6e30ef1eac0eaf93", "ground_truth": {"modern_name": "Obstruction", "confidence": "high", "type": "disease", "description": "Blockage or impediment in bodily passages or vessels.", "note": "Refers to the blockage of humors or vessels.", "wikipedia_extract": "Bowel obstruction, also known as intestinal obstruction, is a mechanical or functional obstruction of the intestines that prevents the normal movement of the products of digestion. Either the small bowel or large bowel may be affected. Signs and symptoms include abdominal pain, vomiting, bloating and not passing gas. Mechanical obstruction is the cause of about 5 to 15% of cases of severe abdominal pain of sudden onset requiring admission to hospital. Causes of bowel obstruction include adhesions, hernias, volvulus, endometriosis, inflammatory bowel disease, appendicitis, tumors, diverticulitis, ischemic bowel, tuberculosis and intussusception. Small bowel obstructions are most often due to adhesions and hernias, while large bowel obstructions are most often due to tumors and volvulus."}, "cross_references": []}, {"canonical_name": "boca", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 30, "members": [{"entity_id": "boca", "book_id": "historia_medicinal_monardes_1574", "name": "boca", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["boca"], "contexts": ["mouth"]}, {"entity_id": "boca", "book_id": "coloquios_da_orta_1563", "name": "boca", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["boca"], "contexts": ["part of the body"]}, {"entity_id": "boca", "book_id": "polyanthea_medicinal", "name": "boca", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 28, "variants": ["boca", "boca da crianca", "bocada madre"], "contexts": ["part of the body", "mouth"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "boca", "target_book": "coloquios_da_orta_1563", "target_name": "boca", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "boca", "target_book": "polyanthea_medicinal", "target_name": "boca", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "boca", "target_book": "polyanthea_medicinal", "target_name": "boca", "similarity": 1.0}], "id": 649, "stable_key": "clu_8df5e8be0f31345a", "ground_truth": {"modern_name": "Mouth", "confidence": "high", "type": "concept", "note": "'Boca' is the direct translation of 'mouth' in Portuguese and Spanish, referring to the anatomical region.", "wikidata_id": "Q1233637", "wikidata_description": "end of a river or stream"}, "cross_references": [{"found_name": "Lips", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2707, "target_cluster_name": "Lips", "source_book": "llm_generated", "evidence_snippet": "The lips are a part of the mouth.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The lips are a part of the mouth."}, {"found_name": "Palate", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_i