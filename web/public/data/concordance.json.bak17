e": "Viper", "similarity": 0.898}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Vipers", "target_book": "polyanthea_medicinal", "target_name": "Viper", "similarity": 0.898}, {"source_book": "english_physician_1652", "source_name": "Viper", "target_book": "polyanthea_medicinal", "target_name": "Viper", "similarity": 1.0}], "id": 821, "stable_key": "clu_d8b35909280aa311", "ground_truth": {"modern_name": "Viper", "confidence": "high", "type": "animal", "description": "Venomous snake used in traditional medicine and remedies.", "wikipedia_extract": "Vipers are snakes in the family Viperidae, found in most parts of the world, except for Antarctica, Australia, Hawaii, Madagascar, Ireland, and various other isolated islands. All vipers are venomous, and have long (relative to non-vipers), hinged fangs that permit deep envenomation of their prey. Three subfamilies are currently recognized. They are also known as viperids. The name \"viper\" is derived from the Latin word vipera, -ae, also meaning viper, possibly from vivus (\"living\") and parere (\"to beget\"), referring to the trait viviparity (giving live birth) common in vipers like most of the species of Boidae. The earliest known vipers are believed to have diverged from the rest of the clade Caenophidia in the early Eocene."}, "cross_references": [{"found_name": "Adder", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 876, "target_cluster_name": "Adder", "source_book": "llm_generated", "evidence_snippet": "The term 'adder' is often used as a common name for certain species of viper, particularly in British English.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The term 'adder' is often used as a common name for certain species of viper, particularly in British English."}, {"found_name": "Rattlesnake", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 2999, "target_cluster_name": "rattlesnake", "source_book": "llm_generated", "evidence_snippet": "Rattlesnakes are a specific type of viper, belonging to the subfamily Crotalinae within Viperidae.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Rattlesnakes are a specific type of viper, belonging to the subfamily Crotalinae within Viperidae."}, {"found_name": "reptiles", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 122, "target_cluster_name": "reptiles", "source_book": "llm_generated", "evidence_snippet": "Vipers are a specific type of snake, which is an order within the traditional classification of reptiles.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Vipers are a specific type of snake, which is an order within the traditional classification of reptiles.", "is_reverse": true}, {"found_name": "cobras", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1535, "target_cluster_name": "cobras", "source_book": "llm_generated", "evidence_snippet": "Vipers are a family of venomous snakes, frequently mentioned in historical contexts concerning snakes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Vipers are a family of venomous snakes, frequently mentioned in historical contexts concerning snakes.", "is_reverse": true}, {"found_name": "Venemous Beasts", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1558, "target_cluster_name": "Venemous Beasts", "source_book": "llm_generated", "evidence_snippet": "Vipers are a specific type of snake known for their venom, making them a direct example within the broader category of venomous animals.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Vipers are a specific type of snake known for their venom, making them a direct example within the broader category of venomous animals.", "is_reverse": true}]}, {"canonical_name": "magnets", "category": "SUBSTANCE", "subcategory": "MI