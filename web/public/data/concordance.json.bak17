elationship": "reverse: Buboes are a primary symptom of bubonic plague, a major form of plague. Their presence is intrinsically linked to the diagnosis and understanding of plague in historical medical texts.", "is_reverse": true}, {"found_name": "peſte", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1532, "target_cluster_name": "peſte", "source_book": "llm_generated", "evidence_snippet": "Buboes are swollen lymph nodes, a hallmark symptom of bubonic plague. They are directly related as a key clinical sign of the disease.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Buboes are swollen lymph nodes, a hallmark symptom of bubonic plague. They are directly related as a key clinical sign of the disease.", "is_reverse": true}, {"found_name": "morbo napolitano", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2860, "target_cluster_name": "morbo napolitano", "source_book": "llm_generated", "evidence_snippet": "Buboes are a characteristic symptom of bubonic plague, and historically, syphilis could present with swollen lymph nodes that might be confused with or described similarly to buboes, especially in early stages or in differential diagnoses.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Buboes are a characteristic symptom of bubonic plague, and historically, syphilis could present with swollen lymph nodes that might be confused with or described similarly to buboes, especially in early stages or in differential diagnoses.", "is_reverse": true}, {"found_name": "Plague", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 588, "target_cluster_name": "peste", "source_book": "llm_generated", "evidence_snippet": "Buboes are a primary symptom of the plague, a specific and historically significant disease.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Buboes are a primary symptom of the plague, a specific and historically significant disease."}, {"found_name": "carbunculos", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1918, "target_cluster_name": "carbunculos", "source_book": "llm_generated", "evidence_snippet": "Buboes are swollen lymph nodes, a characteristic symptom of several infectious diseases, including plague and sometimes Lyme disease in its early stages.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Buboes are swollen lymph nodes, a characteristic symptom of several infectious diseases, including plague and sometimes Lyme disease in its early stages.", "is_reverse": true}, {"found_name": "Buuas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2225, "target_cluster_name": "Buuas", "source_book": "llm_generated", "evidence_snippet": "Buboes are a characteristic symptom (swollen lymph nodes) of bubonic plague, making them strongly related.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Buboes are a characteristic symptom (swollen lymph nodes) of bubonic plague, making them strongly related.", "is_reverse": true}]}, {"canonical_name": "comer", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "jejuum", "book_id": "coloquios_da_orta_1563", "name": "jejuum", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["jejuum"], "contexts": ["taking medicine on an empty stomach"]}, {"entity_id": "comer", "book_id": "polyanthea_medicinal", "name": "comer", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 20, "variants": ["comer", "comér"], "contexts": ["lack of appetite", "eating"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "jejuum", "target_book": "polyanthea_medicinal", "target_name": "comer", "similarity": 0.902}], "id": 1752, "stable_key": "clu_0a91d481f8883186", "ground_truth": {"modern_name": "Fasting", "confidence": "high", "type": "concept", "description": "Abstaining from food, sometimes for medical reasons.", "wikipedia_extract": "Fasting is the act of refraining from eating, and sometimes drinking. However, from a purely physiological context, \"fasting\" may refer to the metabolic status of a person who has not eaten overnight (before \"breakfast\"), or to the metabolic state achieved after complete digestion and absorption of a meal. Metabolic changes in the fasting state begin after absorption of a meal (typically 3–5 hours after eating). A diagnostic fast is a prolonged fast, from 1–100 hours long (depending on age), conducted under observation, to facilitate the investigation of a health complication (usually hypoglycemia). Many people may also fast as part of a medical procedure or a check-up, such as preceding a colonoscopy or surgery, or before certain medical tests. Intermittent fasting is a technique sometimes used for weight loss or other health benefits that incorporates regular fasting into a person's dietary schedule."}, "cross_references": [{"found_name": "dieta", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1390, "target_cluster_name": "dieta", "source_book": "llm_generated", "evidence_snippet": "Fasting is a specific type of dietary regimen.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Fasting is a specific type of dietary regimen.", "is_reverse": true}, {"found_name": "evacuação", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1559, "target_cluster_name": "evacuação", "source_book": "llm_generated", "evidence_snippet": "Fasting can be seen as a form of internal evacuation or cleansing.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Fasting can be seen as a form of internal evacuation or cleansing.", "is_reverse": true}, {"found_name": "Appetite", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2030, "target_cluster_name": "Appetite", "source_book": "llm_generated", "evidence_snippet": "Fasting is the absence or suppression of appetite.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Fasting is the absence or suppression of appetite."}, {"found_name": "Digestion", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 338, "target_cluster_name": "digestion", "source_book": "llm_generated", "evidence_snippet": "Fasting is a state related to the completion of digestion.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Fasting is a state related to the completion of digestion."}, {"found_name": "morxi", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "ju- lho (que he o inverno nesta terra); e porque se causa do comer lhe chamam os índios morxi, que quer dizer, segundo elles, enfermidade causada de muyto comer. RUANO Como curam os fisicos da terra e", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for enfermidade causada de muyto comer"}, {"found_name": "canje", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "ju- lho (que he o inverno nesta terra); e porque se causa do comer lhe chamam os índios morxi, que quer dizer, segundo elles, enfermidade causada de muyto comer. RUANO Como curam os fisicos da terra e", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "alternative name for agoa de espresam de arroz"}, {"found_name": "elevi", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "verde, chamão os Malabares elevi, e aqui em Goa lanha; tem este coquo duas cascas grandes até que cheguem ao meolo; e o meolo, quando he maduro, pêra se comer, he bem que se raspe a casca de cima; por", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "local name for a plant"}, {"found_name": "lanha", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "verde, chamão os Malabares elevi, e aqui em Goa lanha; tem este coquo duas cascas grandes até que cheguem ao meolo; e o meolo, quando he maduro, pêra se comer, he bem que se raspe a casca de cima; por", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "local name for a plant"}, {"found_name": "cairo", "link_type": "derivation", "link_strength": 0.4, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "verde, chamão os Malabares elevi, e aqui em Goa lanha; tem este coquo duas cascas grandes até que cheguem ao meolo; e o meolo, quando he maduro, pêra se comer, he bem que se raspe a casca de cima; por", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "made from plant fibers"}]}, {"canonical_name": "doente", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "doente", "book_id": "coloquios_da_orta_1563", "name": "doente", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 1, "variants": ["doente"], "contexts": ["patient administered ground diamond"]}, {"entity_id": "doente", "book_id": "polyanthea_medicinal", "name": "doente", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 20, "variants": ["doente"], "contexts": ["patient being treated", "the sick person"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "doente", "target_book": "polyanthea_medicinal", "target_name": "doente", "similarity": 1.0}], "id": 1753, "stable_key": "clu_d6b1be73542ec052", "ground_truth": {"modern_name": "Patient", "confidence": "high", "type": "concept", "note": "The Portuguese word 'doente' translates to 'sick person' or 'patient'."}, "cross_references": [{"found_name": "enfermo", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 2325, "target_cluster_name": "enfermo", "source_book": "llm_generated", "evidence_snippet": "Spanish for 'patient'", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "reverse: Spanish for 'patient'", "is_reverse": true}]}, {"canonical_name": "Owen", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 25, "members": [{"entity_id": "owen", "book_id": "origin_of_species_darwin_1859", "name": "Owen", "category": "PERSON", "subcategory": "SCHOLAR", "count": 15, "variants": ["Owen"], "contexts": ["naturalist who remarked on bird anomalies", "professor who observed arm length"]}, {"entity_id": "owen", "book_id": "kosmos_humboldt_1845", "name": "Owen", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["Owen"], "contexts": ["scientist describing mylodon", "identified the dinornis"]}, {"entity_id": "professor_owen", "book_id": "origin_of_species_darwin_1859", "name": "Professor Owen", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Professor Owen"], "contexts": ["naturalist who coined 'vegetative repetition'", "identified fossil horse tooth"]}, {"entity_id": "professor_owen", "book_id": "kosmos_humboldt_1845", "name": "Professor Owen", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Professor Owen"], "contexts": ["described preserved Cephalopodes specimens", "author of memoir on fossil remains"]}, {"entity_id": "prof__owen", "book_id": "first_principles_spencer_1862", "name": "Prof. Owen", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Prof. Owen"], "contexts": ["authority on animal structure"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Owen", "target_book": "kosmos_humboldt_1845", "target_name": "Owen", "similarity": 1.0}], "id": 1754, "stable_key": "clu_77df1cb5e863a90a", "ground_truth": {"modern_name": "Richard Owen", "confidence": "high", "type": "person", "birth_year": 1804, "death_year": 1892, "description": "British biologist, comparative anatomist, and paleontologist.", "wikidata_id": "Q151556", "wikidata_description": "English biologist and paleontologist (1804–1892)", "wikipedia_url": "https://en.wikipedia.org/wiki/Richard%20Owen", "wikipedia_extract": "Sir Richard Owen  (20 July 1804 – 18 December 1892) was an English biologist, comparative anatomist and  palaeontologist. Owen is generally considered to have been an outstanding naturalist with a remarkable gift for interpreting fossils. Owen produced a vast array of scientific work, but is probably best remembered today for coining the word Dinosauria (meaning \"Terrible Reptile\" or \"Fearfully Great Reptile\"). An outspoken critic of Charles Darwin's theory of evolution by natural selection, Owen agreed with Darwin that evolution occurred but thought it was more complex than outlined in Darwin's On the Origin of Species.[page range too broad] Owen's approach to evolution can be considered to have anticipated the issues that have gained greater attention with the recent emergence of evolutionary developmental biology. Owen was the first president of the Microscopical Society of London in 1839 and edited many issues of its journal – then known as The Microscopic Journal. Owen also campaigned for the natural specimens in the British Museum to be given a new home."}, "member_count": 5, "cross_references": [{"found_name": "Charles Darwin", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 118, "target_cluster_name": "Darwin", "source_book": "llm_generated", "evidence_snippet": "Both were prominent figures in 19th-century biology, particularly in the study of natural history and comparative anatomy. Owen was a contemporary and sometimes rival of Darwin, known for his work on fossils and his opposition to Darwin's theory of evolution by natural selection.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were prominent figures in 19th-century biology, particularly in the study of natural history and comparative anatomy. Owen was a contemporary and sometimes rival of Darwin, known for his work on fossils and his opposition to Darwin's theory of evolution by natural selection."}, {"found_name": "Georges Cuvier", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 119, "target_cluster_name": "Cuvier", "source_book": "llm_generated", "evidence_snippet": "Both were highly influential figures in comparative anatomy and paleontology. Cuvier's work laid much of the groundwork for the field, and Owen built upon and expanded this tradition, particularly in his detailed studies of fossil vertebrates.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were highly influential figures in comparative anatomy and paleontology. Cuvier's work laid much of the groundwork for the field, and Owen built upon and expanded this tradition, particularly in his detailed studies of fossil vertebrates."}, {"found_name": "Alfred Russel Wallace", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2104, "target_cluster_name": "Wallace", "source_book": "llm_generated", "evidence_snippet": "Both were key figures in the development of evolutionary biology in the 19th century. While Darwin is more famous, Wallace independently conceived of natural selection and was a significant naturalist and collector.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were key figures in the development of evolutionary biology in the 19th century. While Darwin is more famous, Wallace independently conceived of natural selection and was a significant naturalist and collector."}]}, {"canonical_name": "Natural history", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 20, "members": [{"entity_id": "natural_history", "book_id": "origin_of_species_darwin_1859", "name": "Natural history", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 12, "variants": ["Natural history", "natural history"], "contexts": ["study of organisms and their environments", "study of the natural world"]}, {"entity_id": "natural_history", "book_id": "kosmos_humboldt_1845", "name": "Natural History", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["natural history", "Natural History"], "contexts": ["study of living organisms", "study of the natural world"]}, {"entity_id": "history_of_nature", "book_id": "kosmos_humboldt_1845", "name": "History of Nature", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["History of Nature"], "contexts": ["term for natural history"]}, {"entity_id": "historia_naturalis", "book_id": "kosmos_humboldt_1845", "name": "historia naturalis", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["historia naturalis"], "contexts": ["study of natural history"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Natural history", "target_book": "kosmos_humboldt_1845", "target_name": "Natural History", "similarity": 0.989}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Natural history", "target_book": "kosmos_humboldt_1845", "target_name": "History of Nature", "similarity": 0.895}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Natural history", "target_book": "kosmos_humboldt_1845", "target_name": "historia naturalis", "similarity": 0.889}], "id": 1755, "stable_key": "clu_0bb3ca8b9f12ccf1", "ground_truth": {"modern_name": "Natural history", "confidence": "high", "type": "concept", "wikidata_id": "Q484591", "wikidata_description": "study of organisms including plants or animals in their environment", "wikipedia_url": "https://en.wikipedia.org/wiki/Natural%20history", "wikipedia_extract": "Natural history is a domain of inquiry involving organisms, including animals, fungi, and plants, in their natural environment, leaning more towards observational than experimental methods of study. A person who studies natural history is called a naturalist or natural historian. Natural history encompasses scientific research but is not limited to it. It involves the systematic study of any category of natural objects or organisms, so while it dates from studies in the ancient Greco-Roman world and the mediaeval Arabic world, through to European Renaissance naturalists working in near isolation, today's natural history is a cross-discipline umbrella of many specialty sciences; e.g., geobiology has a strong multidisciplinary nature. The meaning of the English term \"natural history\" (a calque of the Latin historia naturalis) has narrowed progressively with time, while, by contrast, the meaning of the related term \"nature\" has widened (see also History below). In antiquity, \"natural history\" covered essentially anything connected with nature, or  used materials drawn from nature, such as Pliny the Elder's encyclopedia of this title, published c."}, "cross_references": [{"found_name": "Animal Kingdom", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2373, "target_cluster_name": "animal kingdom", "source_book": "llm_generated", "evidence_snippet": "Natural history is the study of organisms, and the Animal Kingdom is a major division of organisms.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Natural history is the study of organisms, and the Animal Kingdom is a major division of organisms."}, {"found_name": "Botany", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1098, "target_cluster_name": "botany", "source_book": "llm_generated", "evidence_snippet": "Botany is the scientific study of plants, a key component of natural history.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Botany is the scientific study of plants, a key component of natural history."}, {"found_name": "Evolutionary History", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4403, "target_cluster_name": "history of organisms", "source_book": "llm_generated", "evidence_snippet": "Evolutionary History, defined as the history of organisms, is a core aspect of natural history.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Evolutionary History, defined as the history of organisms, is a core aspect of natural history."}, {"found_name": "Fauna", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 809, "target_cluster_name": "fauna", "source_book": "llm_generated", "evidence_snippet": "Fauna refers to all the animal life in a particular region or time, which is a subject of natural history.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Fauna refers to all the animal life in a particular region or time, which is a subject of natural history."}, {"found_name": "Geography", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1068, "target_cluster_name": "Geography", "source_book": "llm_generated", "evidence_snippet": "Natural history often involves understanding the geographical distribution and environment of organisms.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Natural history often involves understanding the geographical distribution and environment of organisms."}, {"found_name": "Geology", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 278, "target_cluster_name": "Geology", "source_book": "llm_generated", "evidence_snippet": "Geology, the study of the Earth's physical structure and substance, provides the environmental context for natural history.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Geology, the study of the Earth's physical structure and substance, provides the environmental context for natural history."}, {"found_name": "History", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 177, "target_cluster_name": "history", "source_book": "llm_generated", "evidence_snippet": "Natural history is a form of history, specifically the history of the natural world.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Natural history is a form of history, specifically the history of the natural world."}, {"found_name": "Life", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 89, "target_cluster_name": "Life", "source_book": "llm_generated", "evidence_snippet": "Natural history is fundamentally the study of life.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Natural history is fundamentally the study of life."}, {"found_name": "natural history of the heavens", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "kosmos_humboldt_1845", "evidence_snippet": "one which I propose following. In order adequately to estimate the dignity of the Cosmos, it is requisite that the sidereal portion, termed by Kant the 'natural history of the heavens', should not be ", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for sidereal portion"}]}, {"canonical_name": "Silurian", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 27, "members": [{"entity_id": "silurian", "book_id": "origin_of_species_darwin_1859", "name": "Silurian", "category": "PLACE", "subcategory": "REGION", "count": 11, "variants": ["Silurian"], "contexts": ["geological period with fossiliferous rocks", "geological age"]}, {"entity_id": "silurian", "book_id": "kosmos_humboldt_1845", "name": "silurian", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 9, "variants": ["silurian"], "contexts": ["geological formation", "geological period"]}, {"entity_id": "silurian_epoch", "book_id": "origin_of_species_darwin_1859", "name": "Silurian epoch", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Silurian epoch", "silurian epoch"], "contexts": ["antecedent to the silurian epoch", "geological time period"]}, {"entity_id": "silurian_epoch", "book_id": "first_principles_spencer_1862", "name": "Silurian epoch", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Silurian epoch"], "contexts": ["geologic epoch with living forms"]}, {"entity_id": "silurian_period", "book_id": "first_principles_spencer_1862", "name": "Silurian period", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Silurian period"], "contexts": ["period with crust subsidences"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Silurian", "target_book": "kosmos_humboldt_1845", "target_name": "silurian", "similarity": 0.728}], "id": 1756, "stable_key": "clu_9866ba55e3ec72d0", "ground_truth": {"modern_name": "Silurian", "confidence": "high", "type": "concept", "note": "Refers to the Silurian geological period and system.", "wikidata_id": "Q62412", "wikidata_description": "third period of the Paleozoic Era", "wikipedia_url": "https://en.wikipedia.org/wiki/Silurian", "wikipedia_extract": "The Silurian ( sih-LURE-ee-ən, sy-) is a geologic period and system spanning 23.5 million years from the end of the Ordovician Period, at 443.1 Ma (million years ago) to the beginning of the Devonian Period, 419.62 Ma. The Silurian is the third and shortest period of the Paleozoic Era, and the third of twelve periods of the Phanerozoic Eon. As with other geologic periods, the rock beds that define the period's start and end are well identified, but the exact dates are uncertain by a few million years. The base of the Silurian is set at a series of major Ordovician–Silurian extinction events when up to 60% of marine genera were wiped out. One important event in this period was the initial establishment of terrestrial life in what is known as the Silurian-Devonian Terrestrial Revolution: vascular plants emerged from more primitive land plants, dikaryan fungi started expanding and diversifying along with glomeromycotan fungi, and three groups of arthropods (myriapods, arachnids and hexapods) became fully terrestrialized. Another significant evolutionary milestone during the Silurian was the diversification of jawed fish, which include placoderms, acanthodians (which gave rise to cartilaginous fish) and osteichthyan (bony fish, further divided into lobe-finned and ray-finned fishes), although this corresponded to sharp decline of jawless fish such as conodonts and ostracoderms."}, "member_count": 5, "cross_references": [{"found_name": "graywacke", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1935, "target_cluster_name": "grauwacke", "source_book": "kosmos_humboldt_1845", "evidence_snippet": "arrive at the following series in proceeding from below upward: 1. The so-called 'transition rocks', in the two divisions of upper and lower graywacke (silurian and devonian systems), the latter being", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of rock"}, {"found_name": "Schist", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "kosmos_humboldt_1845", "evidence_snippet": "all other exogenous, purely mechanical deposits of sand or detritus, are as follows: 'Schist', of the lower and upper transition rock, compositing the silurian and devonian formations; from the lower ", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of rock in transition formations"}]}, {"canonical_name": "Antioquia", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 20, "members": [{"entity_id": "antioquia", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Antioquia", "category": "PLACE", "subcategory": "REGION", "count": 19, "variants": ["Antioquia", "Antiocjuia"], "contexts": ["mountainous district in Spanish America", "city with population 104,000"]}, {"entity_id": "antioquia", "book_id": "kosmos_humboldt_1845", "name": "Antioquia", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Antioquia"], "contexts": ["location of observations"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Antioquia", "target_book": "kosmos_humboldt_1845", "target_name": "Antioquia", "similarity": 1.0}], "id": 1757, "stable_key": "clu_d1ead20f6bcaaec6", "ground_truth": {"modern_name": "Antioquia", "confidence": "high", "type": "place", "country": "Colombia", "wikidata_id": "Q4688300", "wikidata_description": "former regional airline in Colombia, 1987-2019", "wikipedia_url": "https://en.wikipedia.org/wiki/University_of_Antioquia", "wikipedia_extract": "The University of Antioquia (Spanish: Universidad de Antioquia), also called UdeA, is primarily a public research-based university, located in the city of Medellín, Colombia. With regional campuses in Amalfi, Andes, Caucasia, Carmen de Viboral, Envigado, Puerto Berrío, Santa Fe de Antioquia, Segovia, Sonsón, Turbo and Yarumal, it remain one of the oldest university in the region. As of 2024, we can read on their publication site that, more than 272 groups and over 5,000 faculty students, are working on 1,200 collaborative projects. Founded in 1803 after a Royal Decree was issued by King  Charles IV of Spain, under the name Franciscan College (Spanish: Colegio de Franciscanos), they have maintained their accreditation from the Ministry of Education for more than 2 centuries.. Along with the University of the Andes, each institution hold the second longest term behind the National University of Colombia. UdeA and the Tecnológico de Antioquia have the largest number of seats in the department of Antioquia."}, "cross_references": [{"found_name": "Popayan", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1548, "target_cluster_name": "Popayan", "source_book": "llm_generated", "evidence_snippet": "Popayán was the capital of the Viceroyalty of New Granada, which included the province of Antioquia. Both are significant historical regions in Colombia.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Popayán was the capital of the Viceroyalty of New Granada, which included the province of Antioquia. Both are significant historical regions in Colombia.", "is_reverse": true}, {"found_name": "Bogota", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1562, "target_cluster_name": "Bogota", "source_book": "llm_generated", "evidence_snippet": "Antioquia was a historical province and is now a department of Colombia, of which Bogotá is the capital.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Antioquia was a historical province and is now a department of Colombia, of which Bogotá is the capital.", "is_reverse": true}, {"found_name": "Choco", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1615, "target_cluster_name": "Choco", "source_book": "llm_generated", "evidence_snippet": "Antioquia is a neighboring department in Colombia, historically and geographically linked to Chocó.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Antioquia is a neighboring department in Colombia, historically and geographically linked to Chocó.", "is_reverse": true}, {"found_name": "Rio Magdalena", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id