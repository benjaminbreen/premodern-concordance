_label": "llm_related", "found_relationship": "reverse: Magnetic declination varies with latitude.", "is_reverse": true}, {"found_name": "Solstices", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2455, "target_cluster_name": "Solstices", "source_book": "llm_generated", "evidence_snippet": "The latitude of a location on Earth influences the apparent position of the Sun at the solstices and the length of daylight experienced.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The latitude of a location on Earth influences the apparent position of the Sun at the solstices and the length of daylight experienced.", "is_reverse": true}, {"found_name": "calms of the equator", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "connexion_physical_sciences_somerville_1858", "evidence_snippet": "that from the S. the S.E. trade-wind. Now these winds being in contrary directions cross at the equator, balance each other through about 6 degrees of latitude, and produce a belt of calms of that bre", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for the Variables of seamen"}, {"found_name": "Variables of seamen", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "connexion_physical_sciences_somerville_1858", "evidence_snippet": "that from the S. the S.E. trade-wind. Now these winds being in contrary directions cross at the equator, balance each other through about 6 degrees of latitude, and produce a belt of calms of that bre", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for the calms of the equator"}]}, {"canonical_name": "Psychology", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 92, "members": [{"entity_id": "psychology", "book_id": "origin_of_species_darwin_1