dern_name": "François Bouvard", "confidence": "high", "type": "person", "birth_year": 1583, "death_year": 1650, "description": "French physician, mathematician, and astronomer.", "wikidata_id": "Q3084089", "wikidata_description": "French composer (c. 1684–1760)", "wikipedia_url": "https://en.wikipedia.org/wiki/Fran%C3%A7ois%20Bouvard", "wikipedia_extract": "François Bouvard (c. 1684–1760) was a French composer of the Baroque era. Originally from Lyon, Lyonnais, Bouvard began his career as a singer at the Paris Opéra at the age of sixteen. When the quality of his voice deteriorated, he went to study in Rome and devoted himself to playing the violin and composition. His first opera, the tragédie en musique Médus, appeared in Paris in 1702."}, "cross_references": []}, {"canonical_name": "Isle of France", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "îles_de_france", "book_id": "relation_historique_humboldt_vol3_1825", "name": "îles de France", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["îles de France"], "contexts": ["islands producing sugar"]}, {"entity_id": "isle_of_france", "book_id": "kosmos_humboldt_1845", "name": "Isle of France", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Isle of France"], "contexts": ["southern hemisphere observation location", "location of pendulum experiments"]}, {"entity_id": "ilha_de_frança", "book_id": "coloquios_da_orta_1563", "name": "ilha de França", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["ilha de França"], "contexts": ["Island, likely Mauritius"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "îles de France", "target_book": "kosmos_humboldt_1845", "target_name": "Isle of France", "similarity": 0.923}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "îles de France", "target_book": "coloquios_da_orta_1563", "target_name": "ilha de França", "similarity": 0.915}, {"source_book": "kosmos_humboldt_1845", "source_name": "Isle of France", "target_book": "coloquios_da_orta_1563", "target_name": "ilha de França", "similarity": 0.951}], "id": 1171, "stable_key": "clu_ac2b4512a70492ce", "ground_truth": {"modern_name": "Île-de-France", "confidence": "high", "type": "place", "description": "A region in France or an island associated with French establishments and trade.", "note": "In the context of Humboldt, likely refers to an island, but the name itself denotes a French region.", "wikipedia_extract": "The Île-de-France (; French: [il də fʁɑ̃s] ; lit. 'Island of France') is the most populous of the eighteen regions of France, with an official estimated population of 12,271,794 residents on 1 January 2023. Containing the capital city of France, Paris, it is located in the north-central part of the country and often called the Paris Region (French: Région parisienne, pronounced [ʁeʒjɔ̃ paʁizjɛn]). Île-de-France is densely populated and retains a prime economic position on the national stage, and it covers 12,012 square kilometres (4,638 square miles), about 2% of metropolitan French territory. Its 2017 population was nearly one-fifth of the national total. The region is made up of eight administrative departments: Paris, Essonne, Hauts-de-Seine, Seine-Saint-Denis, Seine-et-Marne, Val-de-Marne, Val-d'Oise and Yvelines. It was created as the \"District of the Paris Region\" in 1961. In 1976, when its status was aligned with the French administrative regions created in 1972, it was renamed after the historic province of Île-de-France."}, "cross_references": [{"found_name": "Paris", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 36, "target_cluster_name": "Paris", "source_book": "llm_generated", "evidence_snippet": "Paris is located in the Île-de-France region.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Paris is located in the Île-de-France region.", "is_reverse": true}, {"found_name": "France", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 46, "target_cluster_name": "France", "source_book": "llm_generated", "evidence_snippet": "Île-de-France is a region within France, containing its capital.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Île-de-France is a region within France, containing its capital."}]}, {"canonical_name": "Bremen", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "bremen", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Bremen", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Bremen"], "contexts": ["city of sugar importation"]}, {"entity_id": "bremen", "book_id": "kosmos_humboldt_1845", "name": "Bremen", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Bremen"], "contexts": ["city where meteor falls were observed", "city where meteoric fall was observed"]}, {"entity_id": "bremen", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Bremen", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Bremen"], "contexts": ["location of Olbers"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bremen", "target_book": "kosmos_humboldt_1845", "target_name": "Bremen", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Bremen", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bremen", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Bremen", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Bremen", "similarity": 1.0}], "id": 1172, "stable_key": "clu_db9df04010eff022", "ground_truth": {"modern_name": "Bremen", "confidence": "high", "type": "place", "country": "Germany", "wikidata_id": "Q24879", "wikidata_description": "city in the Bremen federated state, Germany", "wikipedia_url": "https://en.wikipedia.org/wiki/Bremen", "wikipedia_extract": "Bremen (German pronunciation: [ˈbʁeːmən] ), officially the City Municipality of Bremen, is the capital of the German state of the Free Hanseatic City of Bremen (Freie Hansestadt Bremen) a two-city-state consisting of the cities of Bremen and Bremerhaven. It is an important port city with about 586,000 inhabitants, the Hanseatic city is the 11th-largest city of Germany and the second-largest city in Northern Germany after Hamburg. Bremen is the largest city on the River Weser, the longest river flowing entirely in Germany, lying some 60 km (37 mi) upstream from its mouth into the North Sea at Bremerhaven, and is completely surrounded by the state of Lower Saxony. Bremen is the centre of the Northwest Metropolitan Region, which also includes the cities of Oldenburg and Bremerhaven, and has a population of around 2.8 million people. Bremen is contiguous with the Lower Saxon towns of Delmenhorst, Stuhr, Achim, Weyhe, Schwanewede and Lilienthal. There is an exclave of Bremen in Bremerhaven, the \"Citybremian Overseas Port Area Bremerhaven\" (Stadtbremisches Überseehafengebiet Bremerhaven)."}, "cross_references": []}, {"canonical_name": "Port Bowen Harbour", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "port_bowen", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Port Bowen", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Port Bowen"], "contexts": ["and of the Port Bowen"]}, {"entity_id": "port_bowen", "book_id": "kosmos_humboldt_1845", "name": "Port Bowen", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Port Bowen"], "contexts": ["location of Parry's observations", "location of barometric observation"]}, {"entity_id": "port_bowen_harbour", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Port Bowen Harbour", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Port Bowen Harbour"], "contexts": ["location for sound transmission experiment", "transmission of sound across"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Port Bowen", "target_book": "kosmos_humboldt_1845", "target_name": "Port Bowen", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Port Bowen", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Port Bowen Harbour", "similarity": 0.939}, {"source_book": "kosmos_humboldt_1845", "source_name": "Port Bowen", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Port Bowen Harbour", "similarity": 0.939}], "id": 1173, "stable_key": "clu_6f094ff64213583c", "ground_truth": {"modern_name": "Port Bowen Harbour", "confidence": "high", "type": "place", "country": "Canada", "note": "Located in Nunavut, Canada.", "wikidata_id": "Q116744319", "wikidata_description": "bay in Nunavut, Canada", "wikipedia_extract": "Port Chalmers (Māori: Kōpūtai) is a town serving as the main port of the city of Dunedin, New Zealand. Port Chalmers lies 13 kilometres (8.1 mi) inside Otago Harbour, some 13 kilometres (8.1 mi) northeast of Dunedin's city centre. No archaeological sites relating to Māori have been discovered in Port Chalmers, although records from European settlers in the 1830s and 1840s note the presence of buildings on the now-reclaimed beach. By 1844 this settlement was fully abandoned. The Māori name for the bay at Port Chalmers is Koputai meaning ‘full tide’ and refers to an incident in which a group of warriors decided to spend the night in a cave that once existed at what was later known as Boiler Point and pulled their canoes well above the high tide mark. Overnight, the tide rose and the beached canoes were set adrift.", "wikipedia_url": "https://en.wikipedia.org/wiki/Port_Chalmers"}, "cross_references": []}, {"canonical_name": "Carolinas", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "carolina", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Carolina", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Carolina"], "contexts": ["establishment and fort"]}, {"entity_id": "carolinas", "book_id": "kosmos_humboldt_1845", "name": "Carolinas", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Carolinas"], "contexts": ["island group in the Pacific", "region in southeastern United States"]}, {"entity_id": "south_carolina", "book_id": "kosmos_humboldt_1845", "name": "South Carolina", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["South Carolina"], "contexts": ["state of Charleston"]}, {"entity_id": "carolinas", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Carolinas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Carolinas"], "contexts": ["region affected by storm curve"]}, {"entity_id": "north_carolina", "book_id": "connexion_physical_sciences_somerville_1858", "name": "North Carolina", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["North Carolina"], "contexts": ["location on isothermal line of 59° Fahrenheit"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Carolina", "target_book": "kosmos_humboldt_1845", "target_name": "South Carolina", "similarity": 0.942}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Carolina", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Carolinas", "similarity": 0.968}, {"source_book": "kosmos_humboldt_1845", "source_name": "Carolinas", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Carolinas", "similarity": 0.839}, {"source_book": "kosmos_humboldt_1845", "source_name": "Carolinas", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "North Carolina", "similarity": 0.932}, {"source_book": "kosmos_humboldt_1845", "source_name": "South Carolina", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Carolinas", "similarity": 0.916}], "id": 1174, "stable_key": "clu_8c55055b20fa29ea", "ground_truth": {"modern_name": "North Carolina and South Carolina", "confidence": "high", "type": "place", "country": "United States", "note": "The text mentions both North and South Carolina, and 'Carolinas' can refer to the combined region. The context of 'establishment and fort' and 'state of Charleston' also points to these US states.", "wikidata_id": "Q118350", "wikidata_description": "archipelago of tiny islands in the western Pacific Ocean, divided between the Federated States of Micronesia and Palau", "wikipedia_url": "https://en.wikipedia.org/wiki/Caroline%20Islands", "wikipedia_extract": "The Caroline Islands (or the Carolines) are a widely scattered archipelago of tiny islands in the western Pacific Ocean, to the north of New Guinea. Politically, they are divided between the Federated States of Micronesia (FSM) in the central and eastern parts of the group, and Palau at the extreme western end. Historically, this area was also called Nuevas Filipinas or New Philippines, because they were part of the Spanish East Indies and were governed from Manila in the Philippines. The Carolines are scattered across a distance of approximately 3,540 kilometres (2,200 mi; 1,910 nmi), from the westernmost island, Tobi, in Palau, to the easternmost island, Kosrae, a state of the FSM. The group consists of about 500 small coral islands, east of the Philippines, in the Pacific Ocean. The distance from Yap (one of the larger Caroline islands) to Manila is 1,200 mi (1,900 km)."}, "cross_references": []}, {"canonical_name": "Lloyd", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "lloyd", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Lloyd", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Lloyd"], "contexts": ["executed geodetic leveling"]}, {"entity_id": "lloyd", "book_id": "kosmos_humboldt_1845", "name": "Lloyd", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 3, "variants": ["Lloyd"], "contexts": ["contributor to scientific proceedings", "contributor to science"]}, {"entity_id": "george_lloyd", "book_id": "kosmos_humboldt_1845", "name": "George Lloyd", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["George Lloyd"], "contexts": ["editor of journey journal"]}, {"entity_id": "lloyd", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Lloyd", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Lloyd"], "contexts": ["experiments in polarization of heat"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Lloyd", "target_book": "kosmos_humboldt_1845", "target_name": "Lloyd", "similarity": 0.719}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Lloyd", "target_book": "kosmos_humboldt_1845", "target_name": "George Lloyd", "similarity": 0.909}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Lloyd", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Lloyd", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Lloyd", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Lloyd", "similarity": 0.719}, {"source_book": "kosmos_humboldt_1845", "source_name": "George Lloyd", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Lloyd", "similarity": 0.909}], "id": 1175, "stable_key": "clu_29b7b64f4bb589b0", "ground_truth": {"modern_name": "George Lloyd", "confidence": "high", "type": "person", "description": 