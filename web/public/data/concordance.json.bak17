ory": "PERSON", "subcategory": "SCHOLAR", "book_count": 1, "total_mentions": 3, "members": [{"entity_id": "lassen", "book_id": "kosmos_humboldt_1845", "name": "Lassen", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Lassen"], "contexts": ["author of Indische Alterthumskunde", "scholar who interpreted Eugubine Tables"]}], "edges": [], "id": 3117, "stable_key": "clu_cd569aa2fddfe028", "ground_truth": {"modern_name": "Christian Lassen", "confidence": "high", "type": "person", "birth_year": 1800, "death_year": 1876, "description": "German philologist and historian, specialist in Sanskrit and Indian studies.", "note": "The 'coloquios_da_orta_1563' reference is anomalous given Lassen's lifespan. It might be an anachronistic attribution or a separate person with the same surname.", "wikidata_id": "Q84861", "wikidata_description": "Norwegian-German orientalist (1800-1876)"}, "cross_references": []}, {"canonical_name": "vegetable kingdom", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "vegetable_kingdom", "book_id": "kosmos_humboldt_1845", "name": "vegetable kingdom", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["vegetable kingdom"], "contexts": ["all plant life forms", "all plant life"]}, {"entity_id": "vegetal_kingdoms", "book_id": "first_principles_spencer_1862", "name": "vegetal kingdoms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["vegetal kingdoms"], "contexts": ["classification for plants"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "vegetable kingdom", "target_book": "first_principles_spencer_1862", "target_name": "vegetal kingdoms", "similarity": 0.9}], "id": 3118, "stable_key": "clu_023ecb8934131cba", "ground_truth": {"modern_name": "Plant kingdom", "confidence": "high", "type": "concept"}, "cross_references": []}, {"canonical_name": "oxyd of iron", "category": "SUBSTANCE