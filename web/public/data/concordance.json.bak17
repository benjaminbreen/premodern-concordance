nship": "synonym"}, {"found_name": "daul alfil", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "verdade. ORTA Todos os nomes que temos declarados de Avicena estão treladados** ao pé da letra; por arábio se chama lingoa de vacca e lingoa de pássaro e lingoa de cão e capillus peneris; e assi també", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym"}, {"found_name": "marad ehkelb", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "W. Ainslie dis que os ára- bes chamam a uma forma da elephawtiasis, Jc^l tj^i dul tl^fi; • um dos nomes da rcávaé w*\">^ lÍ^' marad ehkelb, a doença do cão. Se o nome do amomum em Avicenna se prende a ", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym"}]}, {"canonical_name": "Joule", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "joule", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Joule", "category": "PERSON", "subcategory": "SCHOLAR", "count": 9, "variants": ["Joule"], "contexts": ["ascertained heat from coal combustion", "provided mechanical equivalent of heat"]}, {"entity_id": "joule", "book_id": "first_principles_spencer_1862", "name": "Joule", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Joule"], "contexts": ["Scientist who calculated thermal equivalent"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Joule", "target_book": "first_principles_spencer_1862", "target_name": "Joule", "similarity": 1.0}], "id": 2155, "stable_key": "clu_a353f27c0b88aa1b", "ground_truth": {"modern_name": "James Prescott Joule", "confidence": "high", "type": "person", "birth_year": 1818, "death_year": 1889, "description": "Physicist who established the mechanical theory of heat."}, "cross_references": [{"found_name": "Michael Faraday", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 248, "target_cluster_name": "Faraday", "source_book": "llm_generated", "evidence_snippet": "Both were prominent physicists in the 19th century, with Faraday being a key figure in electromagnetism and Joule known for his work on the mechanical equivalent of heat, a foundational concept in thermodynamics.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were prominent physicists in the 19th century, with Faraday being a key figure in electromagnetism and Joule known for his work on the mechanical equivalent of heat, a foundational concept in thermodynamics."}, {"found_name": "William Thomson", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2538, "target_cluster_name": "W. Thomson", "source_book": "llm_generated", "evidence_snippet": "Joule's work on the mechanical equivalent of heat was crucial for the development of thermodynamics, a field in which Thomson (later Lord Kelvin) was a leading figure. They collaborated and corresponded.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Joule's work on the mechanical equivalent of heat was crucial for the development of thermodynamics, a field in which Thomson (later Lord Kelvin) was a leading figure. They collaborated and corresponded."}, {"found_name": "John Dalton", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2442, "target_cluster_name": "Dalton", "source_book": "llm_generated", "evidence_snippet": "Both were significant figures in 19th-century British science. Dalton is known for his atomic theory, and Joule for his work on energy and heat, both contributing to the understanding of matter and energy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were significant figures in 19th-century British science. Dalton is known for his atomic theory, and Joule for his work on energy and heat, both contributing to the understanding of matter and energy."}, {"found_name": "physicist", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 692, "target_cluster_name": "physiciens", "source_book": "llm_generated", "evidence_snippet": "James Prescott Joule was a renowned physicist.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "James Prescott Joule was a renowned physicist."}]}, {"canonical_name": "conservation of force", "category": "CONCEPT", "subcategory": "THEORY", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "conservation_of_force", "book_id": "connexion_physical_sciences_somerville_1858", "name": "conservation of force", "category": "CONCEPT", "subcategory": "THEORY", "count": 8, "variants": ["Conservation of Force", "conservation of force"], "contexts": ["principle of energy conservation", "principle of energy preservation"]}, {"entity_id": "conservation_of_force", "book_id": "first_principles_spencer_1862", "name": "Conservation of Force", "category": "CONCEPT", "subcategory": "THEORY", "count": 2, "variants": ["Conservation of Force"], "contexts": ["a scientific generalization", "current expression for a scientific principle"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "conservation of force", "target_book": "first_principles_spencer_1862", "target_name": "Conservation of Force", "similarity": 0.971}], "id": 2156, "stable_key": "clu_fe8dfda81fe1b92b", "ground_truth": {"modern_name": "Conservation of energy", "confidence": "high", "type": "concept", "note": "The term 'Persistence of Force' is an early formulation of the concept later widely known as the conservation of energy.", "wikipedia_extract": "In physical science, mechanical energy is the sum of macroscopic potential and kinetic energies. The principle of conservation of mechanical energy states that if an isolated system or a closed system is subject only to conservative forces, then the mechanical energy is constant. If an object moves in the opposite direction of a conservative net force, the potential energy will increase; and if the speed (not the velocity) of the object changes, the kinetic energy of the object also changes. In all real systems, however, nonconservative forces, such as frictional forces, will be present, but if they are of negligible magnitude, the mechanical energy changes little and its conservation is a useful approximation. In elastic collisions, the kinetic energy is conserved, but in inelastic collisions some mechanical energy may be converted into thermal energy. The equivalence between lost mechanical energy  and an increase in temperature was discovered by James Prescott Joule.", "wikipedia_url": "https://en.wikipedia.org/wiki/Mechanical_energy"}, "cross_references": [{"found_name": "physics", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 110, "target_cluster_name": "physics", "source_book": "llm_generated", "evidence_snippet": "The conservation of energy is a fundamental law in physics.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The conservation of energy is a fundamental law in physics.", "is_reverse": true}, {"found_name": "work", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1143, "target_cluster_name": "work", "source_book": "llm_generated", "evidence_snippet": "Work is a mechanism for the transfer of energy, and its relationship to energy conservation is a core concept in physics.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Work is a mechanism for the transfer of energy, and its relationship to energy conservation is a core concept in physics.", "is_reverse": true}, {"found_name": "Conservation of Mass", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3778, "target_cluster_name": "indestructibility of Matter", "source_book": "llm_generated", "evidence_snippet": "The conservation of energy and the conservation of mass are fundamental principles in physics, often discussed together as distinct but related conservation laws.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The conservation of energy and the conservation of mass are fundamental principles in physics, often discussed together as distinct but related conservation laws."}, {"found_name": "Force", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 59, "target_cluster_name": "Force", "source_book": "llm_generated", "evidence_snippet": "Conservation of energy is intrinsically linked to the concept of force, as forces do work and transfer energy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Conservation of energy is intrinsically linked to the concept of force, as forces do work and transfer energy."}, {"found_name": "Energy", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4189, "target_cluster_name": "energies", "source_book": "llm_generated", "evidence_snippet": "The entity is a specific principle concerning the conservation of energy, making 'Energy' a directly related concept.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The entity is a specific principle concerning the conservation of energy, making 'Energy' a directly related concept."}]}, {"canonical_name": "Vegetation", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "vegetation", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Vegetation", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["vegetation", "Vegetation"], "contexts": ["plant life covering an area", "plant life in a region"]}, {"entity_id": 