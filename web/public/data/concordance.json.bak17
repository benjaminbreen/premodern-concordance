rget_cluster_id": 1029, "target_cluster_name": "ammoniaque", "source_book": "llm_generated", "evidence_snippet": "Ammonia is a common chemical base discussed in historical texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Ammonia is a common chemical base discussed in historical texts."}, {"found_name": "alkalies", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 863, "target_cluster_name": "alkalies", "source_book": "llm_generated", "evidence_snippet": "The historical definition of 'base' in chemistry is closely related to and often used interchangeably with 'alkali'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The historical definition of 'base' in chemistry is closely related to and often used interchangeably with 'alkali'.", "is_reverse": true}]}, {"canonical_name": "metaphysics", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "metaphysicks", "book_id": "english_physician_1652", "name": "Metaphysicks", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Metaphysicks"], "contexts": ["philosophical work"]}, {"entity_id": "metaphysics", "book_id": "principles_of_psychology_james_1890", "name": "metaphysics", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 11, "variants": ["metaphysics", "Metaphysics"], "contexts": ["discussion of fundamental elements", "branch of philosophy dealing with abstract concepts"]}, {"entity_id": "metaphysic", "book_id": "principles_of_psychology_james_1890", "name": "Metaphysic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Metaphysic"], "contexts": ["metaphysics work title", "Lotze's work on metaphysics"]}, {"entity_id": "metaphysics", "book_id": "first_principles_spencer_1862", "name": "metaphysics", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["metaphysics"], "contexts": ["branch of philosophy", "branch of philosophy concerning existence"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Metaphysicks", "target_book": "principles_of_psychology_james_1890", "target_name": "metaphysics", "similarity": 0.947}, {"source_book": "english_physician_1652", "source_name": "Metaphysicks", "target_book": "principles_of_psychology_james_1890", "target_name": "Metaphysic", "similarity": 0.939}, {"source_book": "english_physician_1652", "source_name": "Metaphysicks", "target_book": "first_principles_spencer_1862", "target_name": "metaphysics", "similarity": 0.947}, {"source_book": "principles_of_psychology_james_1890", "source_name": "metaphysics", "target_book": "first_principles_spencer_1862", "target_name": "metaphysics", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Metaphysic", "target_book": "first_principles_spencer_1862", "target_name": "metaphysics", "similarity": 0.935}], "id": 754, "stable_key": "clu_bbdc8a4c684bab33", "ground_truth": {"modern_name": "Metaphysics", "confidence": "high", "type": "concept", "wikidata_id": "Q35277", "wikidata_description": "branch of philosophy dealing with the nature, structure, components and fundamental principles of reality", "wikipedia_url": "https://en.wikipedia.org/wiki/Metaphysics", "wikipedia_extract": "Metaphysics is the branch of philosophy that examines the basic structure of reality. It is traditionally seen as the study of mind-independent features of the world, but some theorists view it as an inquiry into the conceptual framework of human understanding. Some philosophers, including Aristotle, designate metaphysics as first philosophy to suggest that it is more fundamental than other forms of philosophical inquiry. Metaphysics encompasses a wide range of general and abstract topics. It investigates the nature of existence, the features all entities have in common, and their division into categories of being. An influential division is between particulars and universals."}, "cross_references": []}, {"canonical_name": "Abdomen", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 5, "total_mentions": 23, "members": [{"entity_id": "pelvis", "book_id": "origin_of_species_darwin_1859", "name": "pelvis", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["pelvis"], "contexts": ["bone structure in birds and humans", "form affected by mountainous country"]}, {"entity_id": "pelvis", "book_id": "kosmos_humboldt_1845", "name": "pelvis", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["pelvis"], "contexts": ["skeletal structure investigated", "part of the skeleton investigated"]}, {"entity_id": "abdomen", "book_id": "polyanthea_medicinal", "name": "Abdomen", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 12, "variants": ["Abdomen", "abdomem", "abdomen"], "contexts": ["abdominal region", "body cavity connected to stomach"]}, {"entity_id": "vientre", "book_id": "historia_medicinal_monardes_1574", "name": "Vientre", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["vientre", "Vientre"], "contexts": ["belly or abdomen", "abdominal part of the body"]}, {"entity_id": "ventre", "book_id": "coloquios_da_orta_1563", "name": "ventre", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["ventre"], "contexts": ["body part"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "pelvis", "target_book": "kosmos_humboldt_1845", "target_name": "pelvis", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "pelvis", "target_book": "polyanthea_medicinal", "target_name": "Abdomen", "similarity": 0.9}, {"source_book": "kosmos_humboldt_1845", "source_name": "pelvis", "target_book": "polyanthea_medicinal", "target_name": "Abdomen", "similarity": 0.9}], "id": 755, "stable_key": "clu_93eefb14d529b838", "ground_truth": {"modern_name": "Abdomen", "confidence": "high", "type": "concept", "note": "While 'pelvis' is mentioned, the dominant term and context clearly point to the general abdominal region as the referent.", "wikidata_id": "Q9597", "wikidata_description": "in humans, region of the body between the thorax at the top and the pelvis at the bottom; in insects, segment at the caudal end of the body, following on from the head and thorax", "wikipedia_url": "https://en.wikipedia.org/wiki/Abdomen", "wikipedia_extract": "An abdomen (also belly or stomach in vertebrates, or metasoma in arthropods)  is the front part of the torso between the thorax (chest) and pelvis in humans and in other vertebrates. The area occupied by the abdomen is called the abdominal cavity. In arthropods, it is the posterior tagma of the body; it follows the thorax or cephalothorax. In humans, the abdomen stretches from the thorax at the thoracic diaphragm to the pelvis at the pelvic brim. The pelvic brim stretches from the lumbosacral joint (the intervertebral disc between L5 and S1) to the pubic symphysis and is the edge of the pelvic inlet. The space above this inlet and under the thoracic diaphragm is termed the abdominal cavity."}, "member_count": 5, "cross_references": [{"found_name": "Chest", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 311, "target_cluster_name": "Chest", "source_book": "llm_generated", "evidence_snippet": "The chest and abdomen are the two primary divisions of the trunk in many animals.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The chest and abdomen are the two primary divisions of the trunk in many animals.", "is_reverse": true}, {"found_name": "Anatomy", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2892, "target_cluster_name": "Anatomia", "source_book": "llm_generated", "evidence_snippet": "Abdomen is a specific anatomical region, and Anatomy is the study of bodily structure.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Abdomen is a specific anatomical region, and Anatomy is the study of bodily structure."}, {"found_name": "Body", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 220, "target_cluster_name": "Body", "source_book": "llm_generated", "evidence_snippet": "The abdomen is a major part of the body.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The abdomen is a major part of the body."}, {"found_name": "Body Part", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 467, "target_cluster_name": "parts", "source_book": "llm_generated", "evidence_snippet": "The abdomen is a specific body part.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The abdomen is a specific body part."}, {"found_name": "Cavity (anatomical)", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1477, "target_cluster_name": "cavities", "source_book": "llm_generated", "evidence_snippet": "The abdomen contains the abdominal cavity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The abdomen contains the abdominal cavity."}, {"found_name": "Torso", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1218, "target_cluster_name": "trunk", "source_book": "llm_generated", "evidence_snippet": "The abdomen is a part of the torso.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The abdomen is a part of the torso."}]}, {"canonical_name": "civilisation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "civilisation", "book_id": "relation_historique_humboldt_vol3_1825", "name": "civilisation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["civilisation", "civilisation humaine"], "contexts": ["progress hindered by institutions", "development of society"]}, {"entity_id": "civilization", "book_id": "kosmos_humboldt_1845", "name": "civilization", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["civilization"], "contexts": ["progress carried to tropical regions", "advanced human society and culture"]}, {"entity_id": "civilization", "book_id": "first_principles_spencer_1862", "name": "civilization", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["civilization"], "contexts": ["societal development influencing phenomena frequency", "latest results of transformation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "civilisation", "target_book": "kosmos_humboldt_1845", "target_name": "civilization", "similarity": 0.975}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "civilisation", "target_book": "first_principles_spencer_1862", "target_name": "civilization", "similarity": 0.975}, {"source_book": "kosmos_humboldt_1845", "source_name": "civilization", "target_book": "first_principles_spencer_1862", "target_name": "civilization", "similarity": 1.0}], "id": 756, "stable_key": "clu_5e5d36f20ce6ddd9", "ground_truth": {"modern_name": "Civilization", "confidence": "high", "type": "concept", "wikidata_id": "Q8432", "wikidata_description": "organized cultural society that encounters many communities, on a scale of a nation or human, as well as a system of development", "wikipedia_url": "https://en.wikipedia.org/wiki/Civilization", "wikipedia_extract": "A civilization (; also spelled civilisation in British English) is any complex society characterized by the development of the state, social stratification, urbanization, and symbolic systems of communication beyond signed or spoken languages (namely, writing systems).Civilizations are organized around densely populated settlements, divided into more or less rigid hierarchical social classes of division of labour, often with a ruling elite and subordinate urban and rural populations, which engage in intensive agriculture, mining, small-scale manufacture and trade. Civilization concentrates power, extending human control over the rest of nature, including over other human beings. Civilizations are characterized by elaborate agriculture, architecture, infrastructure, technological advancement, currency, taxation, regulation, and specialization of labour. Historically, a civilization has often been understood as a larger and \"more advanced\" culture, in implied contrast to smaller, supposedly less advanced cultures, even societies  within civilizations themselves and within their histories. Generally civilization contrasts with non-centralized tribal societies, including the cultures of nomadic pastoralists, Neolithic societies, or hunter-gatherers. The word civilization relates to the Latin civitas or 'city'."}, "cross_references": [{"found_name": "liberté", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 186, "target_cluster_name": "liberté", "source_book": "llm_generated", "evidence_snippet": "The development and understanding of 'liberty' are frequently linked to broader societal 'civilization'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The development and understanding of 'liberty' are frequently linked to broader societal 'civilization'.", "is_reverse": true}, {"found_name": "unity", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 409, "target_cluster_name": "unity", "source_book": "llm_generated", "evidence_snippet": "Civilization can represent a unified societal structure or progress.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Civilization can represent a unified societal structure or progress.", "is_reverse": true}, {"found_name": "Absolute power", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4263, "target_cluster_name": 