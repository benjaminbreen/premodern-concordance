, {"found_name": "Conglomérat", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2554, "target_cluster_name": "Conglomérat", "source_book": "llm_generated", "evidence_snippet": "Graywacke is a type of sandstone that contains a significant amount of matrix and rock fragments, similar to conglomerate which contains larger, rounded clasts. Both are clastic sedimentary rocks.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Graywacke is a type of sandstone that contains a significant amount of matrix and rock fragments, similar to conglomerate which contains larger, rounded clasts. Both are clastic sedimentary rocks.", "is_reverse": true}, {"found_name": "Silurian", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1756, "target_cluster_name": "Silurian", "source_book": "kosmos_humboldt_1845", "evidence_snippet": "arrive at the following series in proceeding from below upward: 1. The so-called 'transition rocks', in the two divisions of upper and lower graywacke (silurian and devonian systems), the latter being", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "reverse: type of rock", "is_reverse": true}, {"found_name": "gneiss", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1625, "target_cluster_name": "gneiss", "source_book": "kosmos_humboldt_1845", "evidence_snippet": "'Annales des Sciences Naturelles', t. xix., p. 60. The most ancient structures of the transition formation p 285 with which we are acquainted are slate and graywacke, which contain some remains of sea", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "a type of formation on which ancient formations might rest"}]}, {"canonical_name": "muschelkalk", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 13, "members": [{"entity_id": "muschelkalk", "book_id": "relation_historique_humboldt_vol3_1825", "name": "muschelkalk", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 7, "variants": ["muschelkalk", "mnachelkalk", "muscheikalk"], "contexts": ["geological formation name", "limestone type"]}, {"entity_id": "muschelkalk", "book_id": "kosmos_humboldt_1845", "name": "muschelkalk", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 6, "variants": ["muschelkalk"], "contexts": ["geological formation", "geological rock formation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "muschelkalk", "target_book": "kosmos_humboldt_1845", "target_name": "muschelkalk", "similarity": 1.0}], "id": 1936, "stable_key": "clu_7d032b3f39204c34", "ground_truth": {"modern_name": "Muschelkalk", "confidence": "high", "type": "mineral", "note": "This refers to a specific geological formation.", "wikidata_id": "Q60882191", "wikidata_description": "special protection area in the EU defined by the birds directive in Thüringen, Germany", "wikipedia_extract": "Nemertea is a phylum of animals also known as ribbon worms or proboscis worms, consisting of about 1300 known species. Most ribbon worms are very slim, usually only a few millimeters wide, although a few have relatively short but wide bodies. Many have patterns of yellow, orange, red and green coloration. The foregut, stomach and intestine run a little below the midline of the body, the anus is at the tip of the tail, and the mouth is under the front. A little above the gut is the rhynchocoel, a cavity which mostly runs above the midline and ends a little short of the rear of the body. All species have a proboscis which lies in the rhynchocoel when inactive but everts to emerge just above the mouth to capture the animal's prey with venom.", "wikipedia_url": "https://en.wikipedia.org/wiki/Nemertea"}, "cross_references": [{"found_name": "Jura limestone", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1987, "target_cluster_name": "Jura limestone", "sou