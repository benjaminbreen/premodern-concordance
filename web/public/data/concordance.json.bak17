ns"]}, {"entity_id": "chemical_combination", "book_id": "first_principles_spencer_1862", "name": "chemical combination", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["chemical combination"], "contexts": ["formation of chemical compounds", "process of forming chemical compounds"]}, {"entity_id": "chemical_combinations", "book_id": "first_principles_spencer_1862", "name": "chemical combinations", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["chemical combinations"], "contexts": ["formation of chemical compounds", "formation of new chemical substances"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "chemical combinations", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "chemical combination", "similarity": 0.92}, {"source_book": "kosmos_humboldt_1845", "source_name": "chemical combinations", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Chemical combinations", "similarity": 0.989}, {"source_book": "kosmos_humboldt_1845", "source_name": "chemical combinations", "target_book": "first_principles_spencer_1862", "target_name": "chemical combination", "similarity": 0.92}, {"source_book": "kosmos_humboldt_1845", "source_name": "chemical combinations", "target_book": "first_principles_spencer_1862", "target_name": "chemical combinations", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "chemical combination", "target_book": "first_principles_spencer_1862", "target_name": "chemical combination", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "chemical combination", "target_book": "first_principles_spencer_1862", "target_name": "chemical combinations", "similarity": 0.92}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Chemical combinations", "target_book": "first_principles_spencer_1862", "target_name": "chemical combination", "similarity": 0.918}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Chemical combinations", "target_book": "first_principles_spencer_1862", "target_name": "chemical combinations", "similarity": 0.989}], "id": 781, "stable_key": "clu_295d6828a8e74f24", "ground_truth": {"modern_name": "chemical combination", "confidence": "high", "type": "concept", "wikidata_id": "Q273499", "wikidata_description": "technique in chemistry", "wikipedia_url": "https://en.wikipedia.org/wiki/Chemical%20synthesis", "wikipedia_extract": "Chemical synthesis (chemical combination) is the artificial execution of chemical reactions to obtain one or more products. This occurs by physical and chemical manipulations, usually involving one or more reactions. In modern laboratory uses, the process is reproducible and reliable. A chemical synthesis involves one or more compounds (known as reagents or reactants) that will experience a transformation under certain conditions. Various reaction types can be applied to formulate a desired product. Many reactions require some form of processing (\"work-up\") or purification procedure to isolate the final product."}, "cross_references": [{"found_name": "Chemical analysis", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2604, "target_cluster_name": "chemical analysis", "source_book": "llm_generated", "evidence_snippet": "Chemical combination is the process by which substances are formed, while chemical analysis is the process by which they are broken down or identified.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Chemical combination is the process by which substances are formed, while chemical analysis is the process by which they are broken down or identified."}, {"found_name": "Chemical change", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 989, "target_cluster_name": "chemical change", "source_book": "llm_generated", "evidence_snippet": "Chemical combination is a specific type of chemical change where new substances are formed.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Chemical combination is a specific type of chemical change where new substances are formed."}, {"found_name": "Chemical reactions", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1769, "target_cluster_name": "chemical action", "source_book": "llm_generated", "evidence_snippet": "Chemical combination is the outcome or purpose of chemical reactions.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Chemical combination is the outcome or purpose of chemical reactions."}, {"found_name": "Chemistry", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 304, "target_cluster_name": "Chemistry", "source_book": "llm_generated", "evidence_snippet": "Chemical combination is a fundamental concept within the field of chemistry.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Chemical combination is a fundamental concept within the field of chemistry."}, {"found_name": "Combustion", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 866, "target_cluster_name": "combustion", "source_book": "llm_generated", "evidence_snippet": "Combustion is a specific type of chemical reaction that involves rapid reaction between a substance with an oxidant, usually oxygen, to produce heat and light, often resulting in chemical combination.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Combustion is a specific type of chemical reaction that involves rapid reaction between a substance with an oxidant, usually oxygen, to produce heat and light, often resulting in chemical combination."}, {"found_name": "Decomposition", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2085, "target_cluster_name": "decomposition", "source_book": "llm_generated", "evidence_snippet": "Decomposition is the opposite process of chemical combination, where a substance breaks down into simpler components.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Decomposition is the opposite process of chemical combination, where a substance breaks down into simpler components."}, {"found_name": "Atom", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1411, "target_cluster_name": "Atoms", "source_book": "llm_generated", "evidence_snippet": "Chemical combination describes how atoms interact and bond to form molecules.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Chemical combination describes how atoms interact and bond to form molecules."}, {"found_name": "Atomic theory", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3552, "target_cluster_name": "atomistic philosophy", "source_book": "llm_generated", "evidence_snippet": "Atomic theory provides the theoretical framework for understanding how and why chemical combinations occur.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Atomic theory provides the theoretical framework for understanding how and why chemical combinations occur."}]}, {"canonical_name": "palmeira", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 16, "members": [{"entity_id": "palm-tree", "book_id": "kosmos_humboldt_1845", "name": "palm-tree", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["palm-tree"], "contexts": ["plant found in valleys"]}, {"entity_id": "palmeira", "book_id": "coloquios_da_orta_1563", "name": "palmeira", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 14, "variants": ["palmeira", "Palmeiras", "Palmyra", "palmeiras", "palmito", "palmitos"], "contexts": ["tree whose fruit husk makes ropes", "tree with similar leaves to the coconut tree"]}, {"entity_id": "pa