th": 0.5, "target_cluster_id": 321, "target_cluster_name": "licor", "source_book": "llm_generated", "evidence_snippet": "Mint water is a flavored liquid, often consumed for medicinal or refreshing purposes, fitting the broad definition of a beverage.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Mint water is a flavored liquid, often consumed for medicinal or refreshing purposes, fitting the broad definition of a beverage.", "is_reverse": true}, {"found_name": "oleo violado", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 715, "target_cluster_name": "oleo violado", "source_book": "llm_generated", "evidence_snippet": "Both are plant-derived liquids used in historical medicine and perfumery, often prepared through similar processes like distillation.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both are plant-derived liquids used in historical medicine and perfumery, often prepared through similar processes like distillation.", "is_reverse": true}]}, {"canonical_name": "carrascos", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "carrascos", "book_id": "coloquios_da_orta_1563", "name": "carrascos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["carrascos"], "contexts": ["trees where grãa is found"]}, {"entity_id": "carrasco", "book_id": "polyanthea_medicinal", "name": "carrasco", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["carrasco"], "contexts": ["plant used in decoction"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "carrascos", "target_book": "polyanthea_medicinal", "target_name": "carrasco", "similarity": 0.918}], "id": 4478, "stable_key": "clu_c9a2dacfa616b760", "ground_truth": {"modern_name": "Kermes Oak", "confidence": "high", "type": "plant", "linnaean": "Quercus coccifera L.", "family": "Fagaceae", "note": "The term 'carrasco' or 'carrascos' in Portuguese and Spanish refers to Quercus coccifera, known for its association with the kermes insect, used for dye. The context of 'grãa' (a dye or pigment) strongly supports this identification."}, "cross_references": [{"found_name": "arvore", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1632, "target_cluster_name": "arvore", "source_book": "llm_generated", "evidence_snippet": "Kermes Oak is a tree.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Kermes Oak is a tree.", "is_reverse": true}]}, {"canonical_name": "shell lac", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "shell_lac", "book_id": "coloquios_da_orta_1563", "name": "shell lac", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["shell lac"], "contexts": ["processed lacca by fusion"]}, {"entity_id": "shell-lac", "book_id": "first_principles_spencer_1862", "name": "shell-lac", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["shell-lac"], "contexts": ["resin used in varnish"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "shell lac", "target_book": "first_principles_spencer_1862", "target_name": "shell-lac", "similarity": 0.757}], "id": 4479, "stable_key": "clu_f12a50417bcdb1cf", "ground_truth": {"modern_name": "Shellac", "confidence": "high", "type": "chemical", "note": "Shellac is a processed resin produced by the lac insect. The description 'processed lacca by fusion' and 'resin used in varnish' directly aligns with shellac.", "wikidata_id": "Q72507464", "wikidata_description": "chemical compound"}, "cross_references": [{"found_name": "Conserve", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 683, "target_cluster_name": "Conserve", "source_book": "llm_generated", "evidence_snippet": "This is a direct alternative name for shellac.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: This is a direct alternative name for shellac.", "is_reverse": true}]}, {"canonical_name": "Commentary", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "commentary", "book_id": "coloquios_da_orta_1563", "name": "Commentary", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Commentary"], "contexts": ["work by Burton"]}, {"entity_id": "commentar__de_peſte", "book_id": "polyanthea_medicinal", "name": "Commentar. de Peſte", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Commentar. de Peſte"], "contexts": ["commentary on the plague"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Commentary", "target_book": "polyanthea_medicinal", "target_name": "Commentar. de Peſte", "similarity": 0.885}], "id": 4480, "stable_key": "clu_a18613bfb796b739", "ground_truth": {"modern_name": "commentary", "confidence": "high", "type": "text", "wikidata_id": "Q1749541", "wikidata_description": "close explication of a text, focusing on language", "wikipedia_url": "https://en.wikipedia.org/wiki/Commentary_%28philology%29", "wikipedia_extract": "In philology, a commentary is a line-by-line or even word-by-word explication usually attached to an edition of a text in the same or an accompanying volume. It may draw on methodologies of close reading and literary criticism, but its primary purpose is to elucidate the language of the text and the specific culture that produced it, both of which may be foreign to the reader. Such a commentary usually takes the form of footnotes, endnotes, or separate text cross-referenced by line, paragraph or page. Means of providing commentary on the language of the text include notes on textual criticism, syntax and semantics, and the analysis of rhetoric, literary tropes, and style. The aim is to remove, lessen or point out linguistic obstacles to reading and understanding the text. If a text is historical, or is produced within a culture assumed to be of limited familiarity to a reader, a broader range of issues may require elucidation."}, "cross_references": [{"found_name": "Livro", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 283, "target_cluster_name": "Livro", "source_book": "llm_generated", "evidence_snippet": "A commentary is a series of notes or explanations on a text, often presented in book form.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: A commentary is a series of notes or explanations on a text, often presented in book form.", "is_reverse": true}, {"found_name": "Glossary", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1732, "target_cluster_name": "Glossary", "source_book": "llm_generated", "evidence_snippet": "Commentaries often include glossaries to explain specialized terms within the text.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Commentaries often include glossaries to explain specialized terms within the text.", "is_reverse": true}]}, {"canonical_name": "Alcobaça", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "alcobaça", "book_id": "coloquios_da_orta_1563", "name": "Alcobaça", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Alcobaça"], "contexts": ["library provenance"]}, {"entity_id": "coutos_de_alcobaça", "book_id": "polyanthea_medicinal", "name": "Coutos de Alcobaça", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Coutos de Alcobaça"], "contexts": ["jurisdiction of Alcobaça"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Alcobaça", "target_book": "polyanthea_medicinal", "target_name": "Coutos de Alcobaça", "similarity": 0.882}], "id": 4481, "stable_key": "clu_aa1850a9beb5ea63", "ground_truth": {"modern_name": "Alcobaça", "confidence": "high", "type": "place", "country": "Portugal", "note": "Alcobaça is a well-known town and municipality in Portugal, famous for its monastery. The reference to 'Coutos de Alcobaça' further solidifies this as a specific historical jurisdiction.", "wikidata_id": "Q4713216", "wikidata_description": "river in Portugal", "wikipedia_url": "https://en.wikipedia.org/wiki/Alcoba%C3%A7a_River_%28Portugal%29"}, "cross_references": []}, {"canonical_name": "Wedel", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 1, "total_mentions": 1, "members": [{"entity_id": "wedel", "book_id": "polyanthea_medicinal", "name": "Wedel", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Wedel"], "contexts": ["author on hemorrhoids and scurvy"]}], "edges": [], "id": 4482, "stable_key": "clu_09c8ca58cd9a04dd", "ground_truth": {"modern_name": "Georg Wolfgang Wedel", "confidence": "high", "type": "person", "birth_year": 1645, "death_year": 1721, "description": "German physician and medical professor, known for his writings.", "note": "Multiple individuals named Wedel existed. This identification is based on the context of medical writings and the likely timeframe."}, "cross_references": []}, {"canonical_name": "fleumões", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "fleumões", "book_id": "coloquios_da_orta_1563", "name": "fleumões", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["fleumões"], "contexts": ["illness caused by fermenting fruits"]}, {"entity_id": "fleymão", "book_id": "polyanthea_medicinal", "name": "fleymão", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["fleymão"], "contexts": ["tumor from blood"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "fleumões", "target_book": "polyanthea_medicinal", "target_name": "fleymão", "similarity": 0.886}], "id": 4483, "stable_key": "clu_6ba44695545ab101", "ground_truth": {"modern_name": "Phlegm-related conditions", "confidence": "medium", "type": "disease", "note": "The term 'fleumões' or 'fleymão' in early modern Portuguese medical texts refers to conditions associated with an excess of phlegm, a humor in the humoral theory. This is not a specific modern disease but a category of ailments."}, "cross_references": []}, {"canonical_name": "Fallopo", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "fallopo", "book_id": "coloquios_da_orta_1563", "name": "Fallopo", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Fallopo"], "contexts": ["mentioned scholar"]}, {"entity_id": "fallopio", "book_id": "polyanthea_medicinal", "name": "Fallopio", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Fallopio"], "contexts": ["early modern scholar"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Fallopo", "target_book": "polyanthea_medicinal", "target_name": "Fallopio", "similarity": 0.919}], "id": 4484, "stable_key": "clu_9717c949c8b6acd7", "ground_truth": {"modern_name": "Gabriele Falloppio", "confidence": "high", "type": "person", "birth_year": 1523, "death_year": 1562, "description": "Italian anatomist and physician, described the Fallopian tubes."}, "cross_references": [{"found_name": "Capivatius", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1906, "target_cluster_name": "Capivatius", "source_book": "llm_generated", "evidence_snippet": "Both were significant anatomists and physicians of the 16th century, contributing to the understanding of human anatomy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were significant anatomists and physicians of the 16th century, contributing to the understanding of human anatomy.", "is_reverse": true}]}, {