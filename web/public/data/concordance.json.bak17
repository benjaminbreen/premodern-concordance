, {"entity_id": "cássia_lignea", "book_id": "coloquios_da_orta_1563", "name": "Cássia lignea", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 14, "variants": ["cássia lignea", "CÁSSIA LIGNEA", "Cássia lignea"], "contexts": ["type of cassia", "spice discussed in colloquy"]}, {"entity_id": "canela_grossa", "book_id": "coloquios_da_orta_1563", "name": "canela grossa", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["canela grossa"], "contexts": ["thick cinnamon spice"]}, {"entity_id": "canela_fina", "book_id": "coloquios_da_orta_1563", "name": "canela fina", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["canela fina"], "contexts": ["fine cinnamon spice"]}, {"entity_id": "canela_fina", "book_id": "polyanthea_medicinal", "name": "canela fina", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 9, "variants": ["canela fina"], "contexts": ["spice used in remedy", "spice used in a syrup"]}, {"entity_id": "canelafina", "book_id": "polyanthea_medicinal", "name": "canelafina", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["canelafina"], "contexts": ["spice used in childbirth remedies"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Canela", "target_book": "ricettario_fiorentino_1597", "target_name": "cannella", "similarity": 0.885}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Canela", "target_book": "polyanthea_medicinal", "target_name": "Canela", "similarity": 1.0}, {"source_book": "ricettario_fiorentino_1597", "source_name": "cannella", "target_book": "polyanthea_medicinal", "target_name": "Canela", "similarity": 0.885}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "canelle", "target_book": "coloquios_da_orta_1563", "target_name": "canela", "similarity": 0.882}], "id": 44, "stable_key": "clu_2036b9eac1a8a3ea", "ground_truth": {"modern_name": "Cinnamon", "confidence": "high", "type": "plant", "linnaean": "Cinnamomum verum J.Presl", "family": "Lauraceae", "note": "While 'canela' can refer to both cinnamon and cassia, the context of Moluccas Islands strongly suggests cinnamon.", "wikidata_id": "Q28165", "wikidata_description": "spice obtained from the inner bark of several tree species from the genus Cinnamomum", "wikipedia_url": "https://en.wikipedia.org/wiki/Cinnamon", "wikipedia_extract": "Cinnamon is a spice obtained from the inner bark of several tree species from the genus Cinnamomum. Cinnamon is used mainly as an aromatic condiment and flavouring additive in a wide variety of cuisines, in particular sweet and savoury dishes such as biscuits, breakfast cereals, snack foods, bagels, teas, hot chocolate, and traditional foods. The aroma and flavour of cinnamon derive from its essential oil and principal component, cinnamaldehyde, as well as numerous other constituents, including eugenol. Cinnamon is the name for several species of trees and the commercial spice products that some of them produce. All are members of the genus Cinnamomum in the family Lauraceae. Only a few Cinnamomum species are grown commercially for spice."}, "member_count": 15, "cross_references": [{"found_name": "Arábios", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 538, "target_cluster_name": "Arábios", "source_book": "coloquios_da_orta_1563", "evidence_snippet": "de dar mais fé que a esses padres da me- decina, que per falsa enformaçam escreverão. De modo que a que chamão os Gregos e Latinos cinamomo, chamam os Arábios quirfé ou quirfd, e os Pérsios darchini, ", "confidence": 0.8, "auto_label": "cross_linguistic", "found_relationship": "reverse: Greek and Latin name for the same plant", "is_reverse": true}, {"found_name": "Cassia", "link_type": "contested_identity", "link_strength": 0.7, "target_cluster_id": 317, "target_cluster_name": "cássia", "source_book": "llm_generated", "evidence_snippet": "Historically, cassia and cinnamon were often confused or used interchangeably, and there were debates about their precise botanical origins and medicinal properties.", "confidence": 0.85, "auto_label": "llm_contested", "found_relationship": "Historically, cassia and cinnamon were often confused or used interchangeably, and there were debates about their precise botanical origins and medicinal properties."}, {"found_name": "cássia", "link_type": "contested_identity", "link_strength": 0.7, "target_cluster_id": 317, "target_cluster_name": "cássia", "source_book": "llm_generated", "evidence_snippet": "Historical texts sometimes conflated or confused Cassia with Cinnamon, as both are aromatic barks from related genera.", "confidence": 0.85, "auto_label": "llm_contested", "found_relationship": "reverse: Historical texts sometimes conflated or confused Cassia with Cinnamon, as both are aromatic barks from related genera.", "is_reverse": true}, {"found_name": "Amomum", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2029, "target_cluster_name": "Amomum", "source_book": "llm_generated", "evidence_snippet": "Amomum is a genus closely related to Cinnamomum, and some species within Amomum have been historically used for similar aromatic purposes or confused with cinnamon.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Amomum is a genus closely related to Cinnamomum, and some species within Amomum have been historically used for similar aromatic purposes or confused with cinnamon."}, {"found_name": "Laurel", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 470, "target_cluster_name": "Laurel", "source_book": "llm_generated", "evidence_snippet": "Both Bay Laurel and Cinnamon are members of the Lauraceae family and are known for their aromatic properties, often used in culinary and medicinal contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both Bay Laurel and Cinnamon are members of the Lauraceae family and are known for their aromatic properties, often used in culinary and medicinal contexts.", "is_reverse": true}, {"found_name": "Mirabolani", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1647, "target_cluster_name": "Mirabolani", "source_book": "llm_generated", "evidence_snippet": "Both Citrine Myrobalans and Cinnamon are dried fruits or barks used as spices and in traditional medicine. Historically, they were often grouped together in pharmacopoeias and trade due to their aromatic properties and medicinal applications, though they are distinct botanical species.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both Citrine Myrobalans and Cinnamon are dried fruits or barks used as spices and in traditional medicine. Historically, they were often grouped together in pharmacopoeias and trade due to their aromatic properties and medicinal applications, though they are distinct botanical species.", "is_reverse": true}, {"found_name": "Ginger", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2918, "target_cluster_name": "Ginger", "source_book": "llm_generated", "evidence_snippet": "Ginger and cinnamon are both widely used aromatic spices, frequently appearing together in historical recipes and medicinal preparations.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Ginger and cinnamon are both widely used aromatic spices, frequently appearing together in historical recipes and medicinal preparations.", "is_reverse": true}, {"found_name": "especiarias", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2144, "target_cluster_name": "especiarias", "source_book": "llm_generated", "evidence_snippet": "Cinnamon is a specific example of a spice.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Cinnamon is a specific example of a spice.", "is_reverse": true}, {"found_name": "cás