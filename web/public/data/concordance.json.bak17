gory": "CITY", "count": 10, "variants": ["Valparaiso", "Valparayso"], "contexts": ["city in Chile", "city"]}, {"entity_id": "valparaiso", "book_id": "kosmos_humboldt_1845", "name": "Valparaiso", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Valparaiso"], "contexts": ["city near Aconcagua"]}, {"entity_id": "valparaiso", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Valparaiso", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Valparaiso"], "contexts": ["location of intense earthquake effects"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Valparaiso", "target_book": "kosmos_humboldt_1845", "target_name": "Valparaiso", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Valparaiso", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Valparaiso", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Valparaiso", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Valparaiso", "similarity": 1.0}], "id": 850, "stable_key": "clu_0fd0e88f21b11d0c", "ground_truth": {"modern_name": "Valparaíso", "confidence": "high", "type": "place", "country": "Chile", "wikidata_id": "Q868888", "wikidata_description": "city in Porter County, Indiana, United States", "wikipedia_url": "https://en.wikipedia.org/wiki/Valparaiso%2C%20Indiana", "wikipedia_extract": "Valparaíso is a major city, commune, seaport, and naval base facility in the Valparaíso Region of Chile. Valparaíso was originally named after Valparaíso de Arriba, in Castile-La Mancha, Spain. Greater Valparaíso is the second-most populous metro area in the country. Valparaiso is the second-largest city in the metro area (behind Viña del Mar). It is located about 120 km (75 mi) northwest of Santiago, by road, and is one of the Pacific Ocean's most important seaports. Valparaíso is the capital of Chile's second most-populated administrative region and has been the Chilean Navy headquarters since 1817, as well as being the seat of the National Congress of Chile since 1990."}, "cross_references": []}, {"canonical_name": "Auguste de Saint-Hilaire", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "auguste_de_saint-hilaire", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Auguste de Saint-Hilaire", "category": "PERSON", "subcategory": "SCHOLAR", "count": 10, "variants": ["Auguste de Saint-Hilaire", "Augusle de Saini-Hilaire", "Auguste de Sa'ml-Hilain", "Auguste de Saint-Hilaiie", "Saint-Hilaire"], "contexts": ["collected notes on leagues", "discoverer of Cinchona ferruginea"]}, {"entity_id": "auguste_de_la_rive", "book_id": "kosmos_humboldt_1845", "name": "Auguste de la Rive", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Auguste de la Rive"], "contexts": ["researcher at Pregny"]}, {"entity_id": "auguste_de_la_rive", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Auguste de la Rive", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Auguste de la Rive"], "contexts": ["made experiments on temperature increase with depth"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Auguste de Saint-Hilaire", "target_book": "kosmos_humboldt_1845", "target_name": "Auguste de la Rive", "similarity": 0.833}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Auguste de Saint-Hilaire", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Auguste de la Rive", "similarity": 0.833}, {"source_book": "kosmos_humboldt_1845", "source_name": "Auguste de la Rive", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Auguste de la Rive", "similarity": 1.0}], "id": 851, "stable_key": "clu_960e55c2e3597116", "ground_truth": {"modern_name": "Auguste de Saint-Hilaire", "confidence": "high", "type": "person", "birth_year": 1779, "death_year": 1853, "description": "French botanist and explorer in South America", "note": "The provided context mentioning 'Auguste de la Rive' appears to be a misattribution or confusion with Saint-Hilaire.", "wikidata_id": "Q707961", "wikidata_description": "French botanist and traveler (1779–1853)", "wikipedia_url": "https://en.wikipedia.org/wiki/Augustin%20Saint-Hilaire", "wikipedia_extract": "Augustin François César Prouvençal de Saint-Hilaire (4 October 1779 – 3 September 1853) was a French botanist and traveller who was born and died in Orléans, France. A keen observer, he is credited with important discoveries in botany, notably the direction of the radicle in the embryo sac and the double point of attachment of certain ovules. He also described two families, the Paronychiae and the Tamariscinae, as well as many genera and species. He began to publish memoirs on botanical subjects at an early age. Between 1816 and 1822 and again in 1830, he traveled in South America, especially in south and central Brazil, and the results of his study of the rich flora of the regions through which he passed appeared in several books and numerous articles in scientific journals. In his first voyage, from 1816 to 1822, he explored the Brazilian backlands, traveling ca."}, "cross_references": [{"found_name": "Baron Humboldt", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3120, "target_cluster_name": "Baron Humboldt", "source_book": "llm_generated", "evidence_snippet": "Auguste de Saint-Hilaire was a French botanist and explorer whose work in South America paralleled and was influenced by Humboldt's explorations.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Auguste de Saint-Hilaire was a French botanist and explorer whose work in South America paralleled and was influenced by Humboldt's explorations.", "is_reverse": true}, {"found_name": "De Candolle", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 721, "target_cluster_name": "De Candolle", "source_book": "llm_generated", "evidence_snippet": "Both were prominent botanists of the same era.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were prominent botanists of the same era.", "is_reverse": true}, {"found_name": "Isidore Geoffroy Saint-Hilaire", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3984, "target_cluster_name": "M. Is. Geoffroy St. Hilaire", "source_book": "llm_generated", "evidence_snippet": "Isidore Geoffroy Saint-Hilaire was the son of Auguste de Saint-Hilaire and also a prominent naturalist and zoologist. They shared a surname and were part of the same intellectual and familial lineage in French science.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Isidore Geoffroy Saint-Hilaire was the son of Auguste de Saint-Hilaire and also a prominent naturalist and zoologist. They shared a surname and were part of the same intellectual and familial lineage in French science."}, {"found_name": "A.", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 856, "target_cluster_name": "A.", "source_book": "llm_generated", "evidence_snippet": "Both were French naturalists who conducted significant botanical expeditions, with Saint-Hilaire's work in South America paralleling Adanson's in Senegal.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were French naturalists who conducted significant botanical expeditions, with Saint-Hilaire's work in South America paralleling Adanson's in Senegal.", "is_reverse": true}, {"found_name": "Duperrey", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1798, "target_cluster_name": "Duperrey", "source_book": "llm_generated", "evidence_snippet": "Both were French explorers and naturalists who undertook significant scientific expeditions around the same time, often in overlapping regions (e.g., South America).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were French explorers and naturalists who undertook significant scientific expeditions around the same time, often in overlapping regions (e.g., South America).", "is_reverse": true}, {"found_name": "Littré", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2450, "target_cluster_name": "Littré", "source_book": "llm_generated", "evidence_snippet": "Both were prominent French naturalists and explorers who contributed significantly to botany and geography during the 19th century. Littré, while primarily a lexicographer and philosopher, engaged with scientific discourse and would have been aware of contemporary scientific figures like Saint-Hilaire.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were prominent French naturalists and explorers who contributed significantly to botany and geography during the 19th century. Littré, while primarily a lexicographer and philosopher, engaged with scientific discourse and would have been aware of contemporary scientific figures like Saint-Hilaire.", "is_reverse": true}]}, {"canonical_name": "Pampas", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "pampas", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Pampas", "category": "PLACE", "subcategory": "REGION", "count": 10, "variants": ["Pampas", "pampas"], "contexts": ["plains north and south of equator", "plains where cultivation is debated"]}, {"entity_id": "pampas", "book_id": "kosmos_humboldt_1845", "name": "pampas", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["pampas"], "contexts": ["grassy plains in the New Continent"]}, {"entity_id": "pampas", "book_id": "first_principles_spencer_1862", "name": "Pampas", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Pampas"], "contexts": ["location of alligators during drought"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pampas", "target_book": "kosmos_humboldt_1845", "target_name": "pampas", "similarity": 0.728}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Pampas", "target_book": "first_principles_spencer_1862", "target_name": "Pampas", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "pampas", "target_book": "first_principles_spencer_1862", "target_name": "Pampas", "similarity": 0.728}], "id": 852, "stable_key": "clu_83081156e2633476", "ground_truth": {"modern_name": "Pampas", "confidence": "high", "type": "place", "country": "Argentina, Uruguay", "wikidata_id": "Q11994681", "wikidata_description": "genus of insects", "wikipedia_url": "https://en.wikipedia.org/wiki/Pampasatyrus", "wikipedia_extract": "Pampasatyrus is a Neotropical genus of butterflies in the family Nymphalidae. Pampasatyrus glaucope (C. & R."}, "cross_references": []}, {"canonical_name": "chronomètres", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "chronomètres", "book_id": "relation_historique_humboldt_vol3_1825", "name": "chronomètres", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 8, "variants": ["chronomètres", "chronomètre", "chronomêtre"], "contexts": ["used for linking points", "measuring time"]}, {"entity_id": "chronograph", "book_id": "principles_of_psychology_james_1890", "name": "Chronograph", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["Chronograph"], "contexts": ["time-registering instrument"]}, {"entity_id": "chronoscope", "book_id": "principles_of_psychology_james_1890", "name": "Chronoscope", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["Chronoscope"], "contexts": ["precise time-measuring instrument"]}, {"entity_id": "chronometric_apparatus", "book_id": "principles_of_psychology_james_1890", "name": "chronometric apparatus", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["chronometric apparatus"], "contexts": ["device for measuring time"]}, {"entity_id": "chronometers", "book_id": "connexion_physical_sciences_somerville_1858", "name": "chronometers", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["chronometers"], "contexts": ["highly accurate timekeeping devices"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "chronomètres", "target_book": "principles_of_psychology_james_1890", "target_name": "Chronograph", "similarity": 0.939}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "chronomètres", "target_book": "principles_of_psychology_james_1890", "target_name": "Chronoscope", "similarity": 0.91}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "chronomètres", "target_book": "principles_of_psychology_james_1890", "target_name": "chronometric apparatus", "similarity": 0.913}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "chronomètres", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "chronometers", "similarity": 0.973}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Chronograph", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "chronometers", "similarity": 0.925}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Chronoscope", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "chronometers", "similarity": 0.9}, {"source_book": "principles_of_psychology_james_1890", "source_name": "chronometric apparatus", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "chronometers", "similarity": 0.911}], "id": 853, "stable_key": "clu_4763863b0ecab4aa", "ground_truth": {"modern_name": "Chronometers", "confidence": "high", "type": "object", "description": "Instruments for measuring and indicating time with high accuracy.", "wikipedia_extract": "A clock or chronometer is a device that measures and displays time. The clock is one of the oldest human inventions, meeting the need to measure intervals of time shorter than the natural units such as the day, the lunar month, and the year. Devices operating on several physical processes have been used over the millennia. Some predecessors to the modern clock may be considered \"clocks\" that are based on movement in nature: A sundial shows the time by displaying the position of a shadow on a flat surface. There is a range of duration timers, a well-known example being the hourglass. Water clocks, along with sundials, are possibly the oldest time-measuring instruments."}, "cross_references": [{"found_name": "clock", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2303, "target_cluster_name": "clocks", "source_book": "llm_generated", "evidence_snippet": "The description explicitly states that a 'clock or chronometer' is a device that measures and displays time, indicating they are used interchangeably or refer to the same core function.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "The description explicitly states that a 'clock or chronometer' is a device that measures and displays time, indicating they are used interchangeably or refer to the same core function."}, {"found_name": "watch", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 3517, "target_cluster_name": "watch", "source_book": "llm_generated", "evidence_snippet": "A watch is a portable form of a clock/chronometer, and in historical contexts, the terms could be used with overlapping meaning for personal timekeeping devices.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "A watch is a portable form of a clock/chronometer, and in historical contexts, the terms could be used with overlapping meaning for personal timekeeping devices."}, {"found_name": "baromètre", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 568, "target_cluster_name": "baromètre", "source_book": "llm_generated", "evidence_snippet": "Both are timekeeping and measurement devices, with 'chronomètres' being the French spelling of 'chronometers'.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "reverse: Both are timekeeping and measurement devices, with 'chronomètres' being the French spelling of 'chronometers'.", "is_reverse": true}, {"found_name": "Thermometer", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 320, "target_cluster_name": "Thermometer", "source_book": "llm_generated", "evidence_snippet": "Both are precision instruments, though one measures time and the other temperature.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both are precision instruments, though one measures time and the other temperature.", "is_reverse": true}, {"found_name": "compass", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 428, "target_cluster_name": "compass", "source_book": "llm_generated", "evidence_snippet": "Both are navigational instruments, often used in conjunction.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both are navigational instruments, often used in conjunction.", "is_reverse": true}, {"found_name": "Horologium", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2822, "target_cluster_name": "Horologium", "source_book": "llm_generated", "evidence_snippet": "Horologium is a Latin term for a clock or timekeeping device, closely related to the concept of a chronometer.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Horologium is a Latin term for a clock or timekeeping device, closely related to the concept of a chronometer."}, {"found_name": "Pendulum", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2775, "target_cluster_name": "pendulum", "source_book": "llm_generated", "evidence_snippet": "Pendulums were a fundamental mechanism in many historical clocks and chronometers for regulating timekeeping.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Pendulums were a fundamental mechanism in many historical clocks and chronometers for regulating timekeeping."}, {"found_name": "Mariner's compass", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3157, "target_cluster_name": "Mariner’s compass", "source_book": "llm_generated", "evidence_snippet": "Both chronometers and mariner's compasses were crucial navigational instruments, often used together at sea.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both chronometers and mariner's compasses were crucial navigational instruments, often used together at sea."}, {"found_name": "Telescope", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 838, "target_cluster_name": "telescope", "source_book": "llm_generated", "evidence_snippet": "Both chronometers and telescopes are scientific instruments that were vital for astronomical observation and navigation, often developed and used in conjunction.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both chronometers and telescopes are scientific instruments that were vital for astronomical observation and navigation, often developed and used in conjunction."}, {"found_name": "clocks", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2303, "target_cluster_name": "clocks", "source_book": "llm_generated", "evidence_snippet": "Chronometers are a type of highly accurate timekeeping device, often used for navigation, and thus closely related to clocks in function and historical development.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Chronometers are a type of highly accurate timekeeping device, often used for navigation, and thus closely related to clocks in function and historical development.", "is_reverse": true}, {"found_name": "pendulum-strokes", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4241, "target_cluster_name": "pendulum-strokes", "source_book": "llm_generated", "evidence_snippet": "Both are timekeeping devices, with pendulums being a key component in many historical chronometers.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both are timekeeping devices, with pendulums being a key component in many historical chronometers.", "is_reverse": true}]}, {"canonical_name": "calmas", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "calme", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Calme", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["Calme", "Calme plat", "calme"], "contexts": ["state of no wind", "description of sea state"]}, {"entity_id": "calms", "book_id": "kosmos_humboldt_1845", "name": "calms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["calms"], "contexts": ["lack of wind"]}, {"entity_id": "calmas", "book_id": "polyanthea_medicinal", "name": "calmas", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 8, "variants": ["calmas", "calmas exceffivas"], "contexts": ["heat or intensity", "heat"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Calme", "target_book": "kosmos_humboldt_1845", "target_name": "calms", "similarity": 0.899}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Calme", "target_book": "polyanthea_medicinal", "target_name": "calmas", "similarity": 0.92}, {"source_book": "kosmos_humboldt_1845", "source_name": "calms", "target_book": "polyanthea_medicinal", "target_name": "calmas", "similarity": 0.969}], "id": 854, "stable_key": "clu_37efd6b2c7448b39", "ground_truth": {"modern_name": "Calm", "confidence": "high", "type": "concept", "description": "A state of stillness, especially of the air or sea, without wind.", "note": "Refers to a state of stillness, not a chemical element.", "wikipedia_extract": "Calm technology or calm design is a type of information technology where the interaction between the technology and its user is designed to occur in the user's periphery rather than constantly at the center of attention. Information from the technology smoothly shifts to the user's attention when needed but otherwise stays calmly in the user's periphery. Mark Weiser and John Seely Brown describe calm technology as \"that which informs but doesn't demand our focus or attention.\" The use of calm technology is paired with ubiquitous computing as a way to minimize the perceptible invasiveness of computers in everyday life. For a technology to be considered calm technology, there are three core principles it should adhere to: The user's attention to the technology must reside mainly in the periphery. This means that either the technology can easily shift between the center of attention and the periphery or that much of the information conveyed by the technology is present in the periphery rather than the center. The technology increases a user's use of his or her periphery."}, "cross_references": [{"found_name": "Attention", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 198, "target_cluster_name": "attention", "source_book": "llm_generated", "evidence_snippet": "Calm technology is defined by its relationship to user attention, specifically by operating in the periphery rather than the center of attention.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Calm technology is defined by its relationship to user attention, specifically by operating in the periphery rather than the center of attention."}, {"found_name": "atmospheric pressure", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 930, "target_cluster_name": "atmospheric pressure", "source_book": "llm_generated", "evidence_snippet": "Calm weather conditions are often associated with stable atmospheric pressure systems.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Calm weather conditions are often associated with stable atmospheric pressure systems.", "is_reverse": true}, {"found_name": "mental states", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2058, "target_cluster_name": "mental states", "source_book": "llm_generated", "evidence_snippet": "Calm is a mental state characterized by a lack of agitation or disturbance.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Calm is a mental state characterized by a lack of agitation or disturbance.", "is_reverse": true}]}, {"canonical_name": "chá", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "thé", "book_id": "relation_historique_humboldt_vol3_1825", "name": "thé", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["thé"], "contexts": ["commodity from China", "commodity with a single source"]}, {"entity_id": "chá", "book_id": "polyanthea_medicinal", "name": "chá", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 9, "variants": ["Chá", "chá"], "contexts": ["tea leaves", "a beverage with astringent qualities"]}, {"entity_id": "tea", "book_id": "first_principles_spencer_1862", "name": "tea", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["tea"], "contexts": ["beverage plant"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "thé", "target_book": "polyanthea_medicinal", "target_name": "chá", "similarity": 0.925}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "thé", "target_book": "first_principles_spencer_1862", "target_name": "tea", "similarity": 0.939}, {"source_book": "polyanthea_medicinal", "source_name": "chá", "target_book": "first_principles_spencer_1862", "target_name": "tea", "similarity": 0.932}], "id": 855, "stable_key": "clu_a077fbf8458fcc92", "ground_truth": {"modern_name": "Tea", "confidence": "high", "type": "plant", "linnaean": "Camellia sinensis", "family": "Theaceae", "wikidata_id": "Q101815", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Camellia%20sinensis", "wikipedia_extract": "Camellia sinensis is a species of evergreen shrub or small tree in the flowering plant family Theaceae. Its leaves, leaf buds, and stems are used to produce tea. Common names include tea plant, tea shrub, and tea tree (unrelated to Melaleuca alternifolia, the source of tea tree oil, or the genus Leptospermum commonly called tea tree). White tea, yellow tea, green tea, oolong, dark tea (which includes pu-erh tea) and black tea are all made from two of the five varieties which form the main crops now grown, C. sinensis var. sinensis and C."}, "cross_references": [{"found_name": "Vegetation", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 2157, "target_cluster_name": "Vegetation", "source_book": "llm_generated", "evidence_snippet": "Portuguese for 'Tea', a specific type of plant life.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "reverse: Portuguese for 'Tea', a specific type of plant life.", "is_reverse": true}, {"found_name": "café", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 642, "target_cluster_name": "café", "source_book": "llm_generated", "evidence_snippet": "Both are popular beverages derived from the leaves/seeds of specific plants, often discussed in similar contexts of trade and consumption.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both are popular beverages derived from the leaves/seeds of specific plants, often discussed in similar contexts of trade and consumption.", "is_reverse": true}, {"found_name": "Coffee", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 642, "target_cluster_name": "café", "source_book": "llm_generated", "evidence_snippet": "Coffee and tea are frequently discussed together as popular beverages derived from plants, often in comparison or contrast.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Coffee and tea are frequently discussed together as popular beverages derived from plants, often in comparison or contrast."}, {"found_name": "Spices", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2144, "target_cluster_name": "especiarias", "source_book": "llm_generated", "evidence_snippet": "Tea, while not a spice itself, was often traded and discussed alongside spices in historical contexts due to its value and exotic origins.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Tea, while not a spice itself, was often traded and discussed alongside spices in historical contexts due to its value and exotic origins."}, {"found_name": "Herbs", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1538, "target_cluster_name": "ervas", "source_book": "llm_generated", "evidence_snippet": "Tea is a type of herbal infusion, and the term 'herbs' encompasses a broad category to which tea belongs, often appearing in discussions of medicinal or culinary plants.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Tea is a type of herbal infusion, and the term 'herbs' encompasses a broad category to which tea belongs, often appearing in discussions of medicinal or culinary plants."}]}, {"canonical_name": "A.", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "aubl_", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Aubl.", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Aubl."], "contexts": ["author of botanical name"]}, {"entity_id": "a__main", "book_id": "principles_of_psychology_james_1890", "name": "A. Main", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["A. Main"], "contexts": ["cited author in Mind and Revue Philos."]}, {"entity_id": "a_", "book_id": "polyanthea_medicinal", "name": "A.", "category": "PERSON", "subcategory": "SCHOLAR", "count": 10, "variants": ["A."], "contexts": ["initial of an inventor", "author's initial"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Aubl.", "target_book": "polyanthea_medicinal", "target_name": "A.", "similarity": 0.855}, {"source_book": "principles_of_psychology_james_1890", "source_name": "A. Main", "target_book": "polyanthea_medicinal", "target_name": "A.", "similarity": 0.914}], "id": 856, "stable_key": "clu_ebad8250bfcd854a", "ground_truth": {"modern_name": "Adanson", "confidence": "medium", "type": "person", "birth_year": 1727, "death_year": 1806, "description": "French botanist and naturalist, author of 'Familles des plantes'", "note": "The 'A.' and 'Aubl.' likely refer to Michel Adanson and Jean Baptiste Christophore Fusée Aublet, both influential botanists frequently cited in early modern texts. 'A. Main' is less clear and might be a distinct or misspelled reference. Given the botanical context of 'author of botanical name', Adanson is a strong candidate, but Aublet also fits. The primary reference seems to point towards botanical authors.", "wikidata_id": "Q315861", "wikidata_description": "French naturalist (1727-1806)", "wikipedia_url": "https://en.wikipedia.org/wiki/Michel%20Adanson", "wikipedia_extract": "Michel Adanson (7 April 1727 – 3 August 1806) was an 18th-century French botanist and naturalist who traveled to Senegal to study flora and fauna. He proposed a \"natural system\" of taxonomy distinct from the binomial system forwarded by Linnaeus. The standard author abbreviation Adans. is used to indicate this person as the author when citing a botanical name. Adanson was born at Aix-en-Provence. His family moved to Paris in 1730."}, "cross_references": [{"found_name": "Alexander von Humboldt", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 42, "target_cluster_name": "Humboldt", "source_book": "llm_generated", "evidence_snippet": "Both were prominent naturalists who undertook extensive fieldwork and contributed significantly to the understanding of biodiversity and natural systems.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were prominent naturalists who undertook extensive fieldwork and contributed significantly to the understanding of biodiversity and natural systems."}, {"found_name": "Georges-Louis Leclerc, Comte de Buffon", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 473, "target_cluster_name": "Buffon", "source_book": "llm_generated", "evidence_snippet": "Both were influential naturalists who proposed systematic approaches to classifying nature, with Buffon preceding Adanson and influencing taxonomic thought.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were influential naturalists who proposed systematic approaches to classifying nature, with Buffon preceding Adanson and influencing taxonomic thought."}, {"found_name": "Linnaeus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2721, "target_cluster_name": "Linnæus", "source_book": "llm_generated", "evidence_snippet": "Adanson's 'natural system' of taxonomy was proposed as an alternative to the binomial system developed by Linnaeus, creating a direct intellectual contrast and relationship.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Adanson's 'natural system' of taxonomy was proposed as an alternative to the binomial system developed by Linnaeus, creating a direct intellectual contrast and relationship."}, {"found_name": "Auguste de Saint-Hilaire", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 851, "target_cluster_name": "Auguste de Saint-Hilaire", "source_book": "llm_generated", "evidence_snippet": "Both were French naturalists who conducted significant botanical expeditions, with Saint-Hilaire's work in South America paralleling Adanson's in Senegal.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were French naturalists who conducted significant botanical expeditions, with Saint-Hilaire's work in South America paralleling Adanson's in Senegal."}]}, {"canonical_name": "Charcoal", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 6, "total_mentions": 22, "members": [{"entity_id": "charpente", "book_id": "relation_historique_humboldt_vol3_1825", "name": "charpente", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["charpente"], "contexts": ["carpentry wood"]}, {"entity_id": "coal", "book_id": "kosmos_humboldt_1845", "name": "coal", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["coal"], "contexts": ["substance capable of combustion", "carbonaceous rock"]}, {"entity_id": "charcoal", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Charcoal", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["Charcoal", "charcoal"], "contexts": ["material for producing artificial light", "conductor used in experiments"]}, {"entity_id": "coal", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Coal", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["coal", "Coal"], "contexts": ["fuel that produces heat when burnt", "combustible sedimentary rock"]}, {"entity_id": "coal", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Coal", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Coal"], "contexts": ["component of gunpowder for color and ignition", "component of gunpowder"]}, {"entity_id": "coals", "book_id": "english_physician_1652", "name": "coals", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["coals"], "contexts": ["fuel for heating"]}, {"entity_id": "black_coal", "book_id": "kosmos_humboldt_1845", "name": "black coal", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["black coal"], "contexts": ["fossil fuel"]}, {"entity_id": "coal", "book_id": "first_principles_spencer_1862", "name": "coal", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 6, "variants": ["coal"], "contexts": ["mineral used in high temperature processes", "source of heat through oxidation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "charpente", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Charcoal", "similarity": 0.888}, {"source_book": "kosmos_humboldt_1845", "source_name": "coal", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Charcoal", "similarity": 0.907}, {"source_book": "kosmos_humboldt_1845", "source_name": "coal", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Coal", "similarity": 0.993}], "id": 857, "stable_key": "clu_5a55013633ebd167", "ground_truth": {"modern_name": "Coal", "confidence": "high", "type": "mineral", "note": "Includes related terms referring to coal and coal-bearing formations.", "wikidata_id": "Q268335", "wikidata_description": "left tributary of the Liard River in Canada", "wikipedia_url": "https://en.wikipedia.org/wiki/Coal", "wikipedia_extract": "Coal is a combustible black or brownish-black sedimentary rock, formed as layers called coal seams. Coal is mostly carbon with variable amounts of other elements, chiefly hydrogen, sulfur, oxygen, and nitrogen. It is a fossil fuel, formed when plants decay into peat which is converted into coal by the heat and pressure of deep burial over millions of years. Vast deposits formed from wetlands called coal forests that covered much of the tropics during the late Carboniferous and early Permian. Coal is used primarily as a fuel. While coal has been known and used for thousands of years, its usage was limited until the Industrial Revolution."}, "member_count": 8, "cross_references": [{"found_name": "lignites", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1760, "target_cluster_name": "lignites", "source_book": "llm_generated", "evidence_snippet": "Lignite is a type of coal, specifically a precursor to bituminous coal, often referred to as 'brown coal'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Lignite is a type of coal, specifically a precursor to bituminous coal, often referred to as 'brown coal'.", "is_reverse": true}, {"found_name": "Carbon", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 11, "target_cluster_name": "carbon", "source_book": "llm_generated", "evidence_snippet": "Coal is primarily composed of carbon.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Coal is primarily composed of carbon."}, {"found_name": "Bitumen", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 160, "target_cluster_name": "bitume", "source_book": "llm_generated", "evidence_snippet": "Bitumen is a related fossil fuel, often found alongside coal.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Bitumen is a related fossil fuel, often found alongside coal."}, {"found_name": "Asphalt", "link_type": "conceptual_overla