nd_name": "Euclide", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2493, "target_cluster_name": "Euclide", "source_book": "llm_generated", "evidence_snippet": "Both are key figures in ancient Greek mathematics, with Pythagoras's theorem being a fundamental concept in Euclidean geometry.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both are key figures in ancient Greek mathematics, with Pythagoras's theorem being a fundamental concept in Euclidean geometry.", "is_reverse": true}]}, {"canonical_name": "Authority", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 16, "members": [{"entity_id": "authority", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Authority", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 8, "variants": ["authority", "Authority"], "contexts": ["power or influence of established ideas", "reliance on established sources of knowledge"]}, {"entity_id": "authority", "book_id": "english_physician_1652", "name": "Authority", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Authority"], "contexts": ["power or permission granted by an official"]}, {"entity_id": "autoridade", "book_id": "polyanthea_medicinal", "name": "autoridade", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["autoridade", "authoridade", "authoridades"], "contexts": ["reliance on learned opinions", "authority"]}, {"entity_id": "authority", "book_id": "first_principles_spencer_1862", "name": "authority", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["authority"], "contexts": ["basis for receiving beliefs without verification", "power or right to give orders"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Authority", "target_book": "english_physician_1652", "target_name": "Authority", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Authority", "target_book": "polyanthea_medicinal", "target_name": "autoridade", "similarity": 0.903}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Authority", "target_book": "first_principles_spencer_1862", "target_name": "authority", "similarity": 0.953}, {"source_book": "english_physician_1652", "source_name": "Authority", "target_book": "polyanthea_medicinal", "target_name": "autoridade", "similarity": 0.903}, {"source_book": "english_physician_1652", "source_name": "Authority", "target_book": "first_principles_spencer_1862", "target_name": "authority", "similarity": 0.953}, {"source_book": "polyanthea_medicinal", "source_name": "autoridade", "target_book": "first_principles_spencer_1862", "target_name": "authority", "similarity": 0.946}], "id": 355, "stable_key": "clu_f59e0e924ffdb23d", "ground_truth": {"modern_name": "Authority", "confidence": "high", "type": "concept", "wikidata_id": "Q174834", "wikidata_description": "legitimate power to decide or authorize", "wikipedia_url": "https://en.wikipedia.org/wiki/Authority", "wikipedia_extract": "Authority is commonly understood as the legitimate power of a person or group over other people. In a civil state, authority may be practiced by legislative, executive, and judicial branches of government, each of which has authority and is an authority. The term \"authority\" has multiple nuances and distinctions within various academic fields ranging from sociology to political science. The term authority identifies the political legitimacy, which grants and justifies rulers' right to exercise the power of government; and the term power identifies the ability to accomplish an authorized goal, either by compliance or by obedience; hence, authority is the power to make decisions and the legitimacy to make such legal decisions and order their execution. Ancient understandings of authority trace back to Rome and draw later from Catholic (Thomistic) thought and other traditional understandings. In more modern terms, forms of authority include transitional authority (exhibited in, for example, Cambodia), public authority in the form of popular power, and, in more administrative terms, bureaucratic or managerial techniques."}, "cross_references": [{"found_name": "Loadstone", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 593, "target_cluster_name": "Loadstone", "source_book": "pseudodoxia_epidemica_browne_1646", "evidence_snippet": "perhaps we speak not properly, when we say vulgarly and appropriately the Loadstone draweth Iron; and yet herein we should not want experiment and great authority. The words of _Renatus des Cartes_ in", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym of the known entity's conceptual category (magnetic attraction)"}, {"found_name": "resistance", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 123, "target_cluster_name": "resistance", "source_book": "llm_generated", "evidence_snippet": "In political and social contexts, authority often implies the power to enforce obedience and overcome resistance.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: In political and social contexts, authority often implies the power to enforce obedience and overcome resistance.", "is_reverse": true}, {"found_name": "Speech", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 145, "target_cluster_name": "Speech", "source_book": "llm_generated", "evidence_snippet": "Public speaking often involves asserting or conveying authority.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Public speaking often involves asserting or conveying authority.", "is_reverse": true}, {"found_name": "liberté", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 186, "target_cluster_name": "liberté", "source_book": "llm_generated", "evidence_snippet": "The concept of 'liberty' is often discussed in relation to the limits or nature of 'authority'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The concept of 'liberty' is often discussed in relation to the limits or nature of 'authority'.", "is_reverse": true}, {"found_name": "organisation", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 340, "target_cluster_name": "organisation", "source_book": "llm_generated", "evidence_snippet": "Organizations often possess or are established to exercise authority within a specific domain.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Organizations often possess or are established to exercise authority within a specific domain.", "is_reverse": true}, {"found_name": "Centre of gravity", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 346, "target_cluster_name": "Centre of gravity", "source_book": "llm_generated", "evidence_snippet": "Similar to 'Absolute power', 'Authority' can be a source of strength and stability, thus potentially acting as a center of gravity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Similar to 'Absolute power', 'Authority' can be a source of strength and stability, thus potentially acting as a center of gravity.", "is_reverse": true}, {"found_name": "Absolute power", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4263, "target_cluster_name": "absolute power", "source_book": "llm_generated", "evidence_snippet": "Absolute power is a specific form of authority, often discussed in contrast to limited or shared authority.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Absolute power is a specific form of authority, often discussed in contrast to limited or shared authority."}, {"found_name": "Government", "link_type": "conceptual_overlap", "link_strength": 0.5