ationship": "reverse: The Indian Ocean is a specific sea, and 'seas' is a general term for large bodies of saltwater.", "is_reverse": true}]}, {"canonical_name": "Boston", "category": "PLACE", "subcategory": "CITY", "book_count": 4, "total_mentions": 16, "members": [{"entity_id": "boston", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Boston", "category": "PLACE", "subcategory": "CITY", "count": 9, "variants": ["Boston"], "contexts": ["city in Massachusetts, USA", "city for sea voyages"]}, {"entity_id": "boston", "book_id": "principles_of_psychology_james_1890", "name": "Boston", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Boston"], "contexts": ["city where a volume was published", "city visited by the subject"]}, {"entity_id": "boston", "book_id": "kosmos_humboldt_1845", "name": "Boston", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Boston"], "contexts": ["location where meteors were observed", "city where book was published"]}, {"entity_id": "boston", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Boston", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Boston"], "contexts": ["city on isothermal line of 50° Fahrenheit"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Boston", "target_book": "principles_of_psychology_james_1890", "target_name": "Boston", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Boston", "target_book": "kosmos_humboldt_1845", "target_name": "Boston", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Boston", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Boston", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Boston", "target_book": "kosmos_humboldt_1845", "target_name": "Boston", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Boston", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Boston", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Boston", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Boston", "similarity": 1.0}], "id": 363, "stable_key": "clu_ba8dacdbe096573b", "ground_truth": {"modern_name": "Boston", "confidence": "high", "type": "place", "description": "A major city in Massachusetts, USA, a significant port and publication center.", "wikipedia_extract": "Boston is the capital and most populous city of the U.S. state of Massachusetts. It serves as the cultural and financial center of New England, a region of the Northeastern United States. Boston has an area of 48.4 sq mi (125 km2) and a population of 675,647 as of the 2020 census, making it the third-most populous city in the Northeastern United States after New York City and Philadelphia. The larger Greater Boston metropolitan statistical area had a population of 4.9 million in 2023, making it the largest metropolitan area in New England and the eleventh-largest in the United States. Boston was founded on Shawmut Peninsula in 1630 by English Puritan settlers, who named the city after the market town of Boston, Lincolnshire in England. During the American Revolution and Revolutionary War, Boston was home to several seminal events, including the Boston Massacre (1770), the Boston Tea Party (1773), Paul Revere's midnight ride (1775), the Battle of Bunker Hill (1775), and the Siege of Boston (1775–1776)."}, "cross_references": [{"found_name": "Massachusetts", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2408, "target_cluster_name": "Massachusetts", "source_book": "llm_generated", "evidence_snippet": "Boston is the capital of Massachusetts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Boston is the capital of Massachusetts."}]}, {"canonical_name": "molecules", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 4, "total_mentions": 20, "members": [{"entity_id": "molecules", "book_id": "principles_of_psychology_james_1890", "name": "molecules", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["molecules"], "contexts": ["tiny particles of matter", "basic unit of chemical matter"]}, {"entity_id": "molecules", "book_id": "kosmos_humboldt_1845", "name": "molecules", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["molecules"], "contexts": ["particles acted upon by chemical affinity", "hypothetical construction of matter"]}, {"entity_id": "molecules", "book_id": "connexion_physical_sciences_somerville_1858", "name": "molecules", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 5, "variants": ["molecules"], "contexts": ["smallest unit of a substance", "constituent particles of bodies"]}, {"entity_id": "molecules", "book_id": "first_principles_spencer_1862", "name": "molecules", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["molecules"], "contexts": ["smallest unit of a substance", "infinitesimal vibrations of infinitesimal molecules"]}, {"entity_id": "molecule", "book_id": "principles_of_psychology_james_1890", "name": "molecule", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["molecule"], "contexts": ["basic unit of matter"]}, {"entity_id": "molecule", "book_id": "kosmos_humboldt_1845", "name": "molecule", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["molecule"], "contexts": ["ultimate portion of matter"]}, {"entity_id": "molecule", "book_id": "connexion_physical_sciences_somerville_1858", "name": "molecule", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["molecule"], "contexts": ["basic unit of matter", "basic unit of matter with power"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "molecules", "target_book": "kosmos_humboldt_1845", "target_name": "molecules", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "molecules", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "molecules", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "molecules", "target_book": "first_principles_spencer_1862", "target_name": "molecules", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "molecules", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "molecules", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "molecules", "target_book": "first_principles_spencer_1862", "target_name": "molecules", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "molecules", "target_book": "first_principles_spencer_1862", "target_name": "molecules", "similarity": 1.0}], "id": 364, "stable_key": "clu_bad45b0626b1f0f3", "ground_truth": {"modern_name": "molecules", "confidence": "high", "type": "concept", "wikidata_id": "Q11369", "wikidata_description": "smallest possibile amount of a chemical substance", "wikipedia_url": "https://en.wikipedia.org/wiki/Molecule", "note": "The descriptions 'basic unit of matter' and 'ultimate portion of matter' are consistent with the modern understanding of a molecule.", "wikipedia_extract": "A molecule is a group of two or more atoms that are held together by attractive forces known as chemical bonds; depending on context, the term may or may not include ions that satisfy this criterion. In quantum physics, organic chemistry, and biochemistry, the distinction from ions is dropped and molecule is often used when referring to polyatomic ions. A molecule may be homonuclear, that is, it consists of atoms of one chemical element, e.g. two atoms in the oxygen molecule (O2); or it may be heteronuclear, a chemical compound composed of more than one element, e.g. water (two hydrogen atoms and one oxygen atom; H2O). In the kinetic theory of gases, the term molecule is often used for any gaseous particle regardless of its composition."}, "member_count": 7, "cross_references": [{"found_name": "atoms", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 84, "target_cluster_name": "atoms", "source_book": "principles_of_psychology_james_1890", "evidence_snippet": "this is all the resultant effect of variations in the _combination_ of certain simple elements of consciousness that always remain the same. These mental atoms or molecules are what Locke called 'simp", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "reverse: synonym for mental atoms", "is_reverse": true}, {"found_name": "molecules", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "principles_of_psychology_james_1890", "evidence_snippet": "the resultant effect of variations in the _combination_ of certain simple elements of consciousness that always remain the same. These mental atoms or molecules are what Locke called 'simple ideas.' S", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym of 'mental atoms'"}]}, {"canonical_name": "Diaphragma", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 16, "members": [{"entity_id": "diaphragm", "book_id": "principles_of_psychology_james_1890", "name": "diaphragm", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["diaphragm"], "contexts": ["innervated bilaterally for breathing", "muscle for breathing"]}, {"entity_id": "diaphragm", "book_id": "kosmos_humboldt_1845", "name": "diaphragm", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["diaphragm"], "contexts": ["anatomical structure"]}, {"entit