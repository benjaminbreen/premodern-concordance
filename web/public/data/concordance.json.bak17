target_name": "muscles", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "muscles", "target_book": "first_principles_spencer_1862", "target_name": "muscles", "similarity": 1.0}], "id": 265, "stable_key": "clu_4747481ffd835dee", "ground_truth": {"modern_name": "Muscles", "confidence": "high", "type": "concept", "wikidata_id": "Q7365", "wikidata_description": "contractile soft tissue of animals", "wikipedia_url": "https://en.wikipedia.org/wiki/Muscle", "note": "The early modern term 'mufculos' (or 'mufculofus') is a Latinate form referring to muscles, especially in anatomical contexts. The OCR variant 'mucous' is likely a misreading or a contextually distinct usage if it refers to a bodily fluid, but the overwhelming number of occurrences point to anatomical muscles.", "wikipedia_extract": "Muscle is a specialised soft tissue, one of the four basic types of animal tissues. There are three types of muscle tissues in vertebrates:- skeletal muscle tissue, cardiac muscle tissue, and smooth muscle tissue. Muscle tissue gives skeletal muscles the ability to contract and relax. Muscle tissue contains special contractile proteins called actin and myosin which interact to cause movement. Among many other muscle proteins present are two regulatory proteins, troponin and tropomyosin. Muscle is formed during embryonic development, in a process known as myogenesis."}, "member_count": 13, "cross_references": [{"found_name": "contractions", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 4201, "target_cluster_name": "contractions", "source_book": "llm_generated", "evidence_snippet": "Muscles are the biological structures that perform muscular contraction.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Muscles are the biological structures that perform muscular contraction.", "is_reverse": true}, {"found_name": "nerve", "link_type": "conceptual_overlap", "link_strength": 0.5, "targe