["zodiac sign"]}, {"entity_id": "scorpion", "book_id": "english_physician_1652", "name": "Scorpion", "category": "CONCEPT", "subcategory": "THEORY", "count": 8, "variants": ["Scorpion"], "contexts": ["zodiac sign associated with herb", "creature whose poison is resisted"]}, {"entity_id": "escorpião", "book_id": "polyanthea_medicinal", "name": "Escorpião", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Escorpião"], "contexts": ["zodiac sign"]}, {"entity_id": "tropick_of_capricorn", "book_id": "english_physician_1652", "name": "Tropick of Capricorn", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Tropick of Capricorn"], "contexts": ["celestial line influencing plant growth"]}, {"entity_id": "tropique_du_capricorne", "book_id": "relation_historique_humboldt_vol3_1825", "name": "tropique du Capricorne", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["tropique du Capricorne"], "contexts": ["astronomical line of latitude"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Capricorn", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Capricorne", "similarity": 0.99}, {"source_book": "english_physician_1652", "source_name": "Capricorn", "target_book": "polyanthea_medicinal", "target_name": "Capricornio", "similarity": 0.973}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Capricorne", "target_book": "polyanthea_medicinal", "target_name": "Capricornio", "similarity": 0.979}], "id": 844, "stable_key": "clu_ef88512476394474", "ground_truth": {"modern_name": "Tropic of Capricorn", "confidence": "high", "type": "concept", "description": "The southern-most latitude where the sun can be directly overhead.", "note": "Includes references to the zodiac sign Capricorn and the tropic line.", "wikipedia_extract": "The Tropic of Capricorn (or the Southern Tropic) is the circle of latitude that contains the subsolar point at the December (or southern) solstice. It is thus the southernmost latitude where the Sun can be seen directly overhead. It also reaches 90 degrees below the horizon at solar midnight on the June Solstice. Its northern equivalent is the Tropic of Cancer. The Tropic of Capricorn is one of the five major circles of latitude marked on maps of Earth. Its latitude is currently 23°26′09.2″ (or 23.4359°) south of the Equator, but it is very gradually moving northward, currently at the rate of 0.47 arcseconds, or 15 metres, per year."}, "member_count": 7, "cross_references": [{"found_name": "Latitude", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 551, "target_cluster_name": "latitude", "source_book": "llm_generated", "evidence_snippet": "The Tropic of Capricorn is a specific line of latitude.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Tropic of Capricorn is a specific line of latitude."}]}, {"canonical_name": "reproduction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "procreation", "book_id": "english_physician_1652", "name": "Procreation", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Procreation"], "contexts": ["natural process of reproduction"]}, {"entity_id": "reproduction", "book_id": "origin_of_species_darwin_1859", "name": "Reproduction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["reproduction", "Reproduction"], "contexts": ["biological process of creating offspring"]}, {"entity_id": "reproduction", "book_id": "principles_of_psychology_james_1890", "name": "reproduction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["reproduction"], "contexts": ["ability to recall information", "process of creating new tissue"]}, {"entity_id": "reproductions", "book_id": "principles_of_psychology_james_1890", "name": "reproductions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["reproductions"], "contexts": ["copies of past sensations"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Procreation", "target_book": "origin_of_species_darwin_1859", "target_name": "Reproduction", "similarity": 0.925}, {"source_book": "english_physician_1652", "source_name": "Procreation", "target_book": "principles_of_psychology_james_1890", "target_name": "reproduction", "similarity": 0.91}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Reproduction", "target_book": "principles_of_psychology_james_1890", "target_name": "reproduction", "similarity": 0.955}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Reproduction", "target_book": "principles_of_psychology_james_1890", "target_name": "reproductions", "similarity": 0.821}], "id": 845, "stable_key": "clu_a7a05dc9ac32a2f7", "ground_truth": {"modern_name": "reproduction", "confidence": "high", "type": "concept", "wikidata_id": "Q11990", "wikidata_description": "production of new individuals that contain some portion of genetic material inherited from one or more parent organisms", "wikipedia_url": "https://en.wikipedia.org/wiki/Reproduction", "wikipedia_extract": "Reproduction (or procreation or breeding) is the biological process by which new individual organisms – \"offspring\" – are produced from their \"parent\" or parents. There are two forms of reproduction: asexual and sexual. In asexual reproduction, an organism can reproduce without the involvement of another organism. Asexual reproduction is not limited to single-celled organisms. The cloning of an organism is a form of asexual reproduction. By asexual reproduction, an organism creates a genetically similar or identical copy of itself."}, "cross_references": [{"found_name": "Breed", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2181, "target_cluster_name": "breed", "source_book": "llm_generated", "evidence_snippet": "The term 'breed' is often used synonymously with 'reproduction' in the context of domestic animals and agriculture, referring to the process of producing offspring of a particular type.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "The term 'breed' is often used synonymously with 'reproduction' in the context of domestic animals and agriculture, referring to the process of producing offspring of a particular type."}, {"found_name": "Generation", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 166, "target_cluster_name": "generation", "source_book": "llm_generated", "evidence_snippet": "'Generation' is a direct synonym for reproduction, referring to the act or process of producing offspring.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "'Generation' is a direct synonym for reproduction, referring to the act or process of producing offspring."}, {"found_name": "Conception", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 282, "target_cluster_name": "conception", "source_book": "llm_generated", "evidence_snippet": "Conception is a key initial stage in sexual reproduction, leading to the development of offspring.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Conception is a key initial stage in sexual reproduction, leading to the development of offspring."}, {"found_name": "Development", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 960, "target_cluster_name": "development", "source_book": "llm_generated", "evidence_snippet": "Development follows reproduction, describing the process of growth and change in the offspring from conception to maturity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Development follows reproduction, describing the process of growth and change in the offspring from conception to maturity."}, {"found_name": "Evolution", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 540, "target_cluster_name": "Evolution", "source_book": "llm_generated", "evidence_snippet": "Evolution is the broader process by which populations change over generations, driven in part by the variations introduced through reproduction.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Evolution is the broader process by which populations change over generations, driven in part by the variations introduced through reproduction."}, {"found_name": "organic nature", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1155, "target_cluster_name": "organic nature", "source_book": "llm_generated", "evidence_snippet": "'Reproduction' is a fundamental process for the perpetuation of 'organic nature'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: 'Reproduction' is a fundamental process for the perpetuation of 'organic nature'.", "is_reverse": true}]}, {"canonical_name": "geological period", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 12, "members": [{"entity_id": "geological_period", "book_id": "origin_of_species_darwin_1859", "name": "geological period", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 7, "variants": ["geological period"], "contexts": ["division of Earth's history", "time in earth's history"]}, {"entity_id": "geological_times", "book_id": "origin_of_species_darwin_1859", "name": "geological times", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["geological times"], "contexts": ["periods of earth's history"]}, {"entity_id": "geological_epochs", "book_id": "connexion_physical_sciences_somerville_1858", "name": "geological epochs", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["geological epochs"], "contexts": ["periods in Earth's history"]}, {"entity_id": "geologic_epochs", "book_id": "first_principles_spencer_1862", "name": "geologic epochs", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["geologic epochs"], "contexts": ["major divisions of geological time"]}, {"entity_id": "geologic_time", "book_id": "first_principles_spencer_1862", "name": "geologic time", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["geologic time"], "contexts": ["vast periods of Earth's history"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "geological period", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "geological epochs", "similarity": 0.918}, {"source_book": "origin_of_species_darwin_1859", "source_name": "geological period", "target_book": "first_principles_spencer_1862", "target_name": "geologic epochs", "similarity": 0.92}, {"source_book": "origin_of_species_darwin_1859", "source_name": "geological period", "target_book": "first_principles_spencer_1862", "target_name": "geologic time", "similarity": 0.882}, {"source_book": "origin_of_species_darwin_1859", "source_name": "geological times", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "geological epochs", "similarity": 0.895}, {"source_book": "origin_of_species_darwin_1859", "source_name": "geological times", "target_book": "first_principles_spencer_1862", "target_name": "geologic epochs", "similarity": 0.894}, {"source_book": "origin_of_species_darwin_1859", "source_name": "geological times", "target_book": "first_principles_spencer_1862", "target_name": "geologic time", "similarity": 0.912}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "geological epochs", "target_book": "first_principles_spencer_1862", "target_name": "geologic epochs", "similarity": 0.996}], "id": 846, "stable_key": "clu_abd8e77d9e500456", "ground_truth": {"modern_name": "geological time", "confidence": "high", "type": "concept", "wik