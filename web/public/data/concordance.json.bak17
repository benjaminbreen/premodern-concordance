y": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Suez"], "contexts": ["location of bitter lakes"]}, {"entity_id": "isthmus_of_suez", "book_id": "kosmos_humboldt_1845", "name": "Isthmus of Suez", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Isthmus of Suez"], "contexts": ["location with different water levels"]}, {"entity_id": "suez", "book_id": "coloquios_da_orta_1563", "name": "Suez", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Suez"], "contexts": ["port city", "destination from Red Sea"]}, {"entity_id": "suez", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Suez", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Suez"], "contexts": ["location with different marine plants"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Suez", "target_book": "kosmos_humboldt_1845", "target_name": "Suez", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Suez", "target_book": "kosmos_humboldt_1845", "target_name": "Isthmus of Suez", "similarity": 0.887}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Suez", "target_book": "coloquios_da_orta_1563", "target_name": "Suez", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Suez", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Suez", "similarity": 0.892}, {"source_book": "kosmos_humboldt_1845", "source_name": "Suez", "target_book": "coloquios_da_orta_1563", "target_name": "Suez", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Suez", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Suez", "similarity": 0.892}, {"source_book": "kosmos_humboldt_1845", "source_name": "Isthmus of Suez", "target_book": "coloquios_da_orta_1563", "target_name": "Suez", "similarity": 0.887}, {"source_book": "coloquios_da_orta_1563", "source_name": "Suez", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Suez", "similarity": 0.892}], "id": 421, "stable_key": "clu_8a33d0dab68a2b4a", "ground_truth": {"modern_name": "Suez", "confidence": "high", "type": "place", "description": "Port city and location of an isthmus and canal project.", "wikipedia_extract": "Suez is a seaport city in north-eastern Egypt, located on the north coast of the Gulf of Suez on the Red Sea, near the southern terminus of the Suez Canal. The city is the capital and largest city of the Suez Governorate. The modern city of Suez is a successor of the ancient Egyptian city of Clysma, a major Red Sea port and a center of monasticism. Railway lines and highways connect the city with Cairo, Port Said, and Ismailia. Suez has a petrochemical plant, and its oil refineries have pipelines carrying the finished product to Cairo. These are represented in the flag of the governorate: the blue background refers to the sea, the gear refers to Suez's status as an industrial governorate, and the flame refers to the petroleum firms of Suez."}, "cross_references": []}, {"canonical_name": "humanity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 14, "members": [{"entity_id": "humanité", "book_id": "relation_historique_humboldt_vol3_1825", "name": "humanité", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["humanité"], "contexts": ["interest for friends of humanity", "principle for slave treatment"]}, {"entity_id": "humanity", "book_id": "principles_of_psychology_james_1890", "name": "humanity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["humanity"], "contexts": ["the human race collectively", "abstract idea of man"]}, {"entity_id": "humanity", "book_id": "kosmos_humboldt_1845", "name": "humanity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["humanity"], "contexts": ["state of being human"]}, {"entity_id": "humanity", "book_id": "first_principles_spencer_1862", "name": "humanity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["humanity", "Humanity"], "contexts": ["human race and its debt to religion", "collective human race"]}, {"entity_id": "human_race", "book_id": "principles_of_psychology_james_1890", "name": "human race", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["human race"], "contexts": ["collective agreement on perception"]}, {"entity_id": "human_race", "book_id": "connexion_physical_sciences_somerville_1858", "name": "human race", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["human race"], "contexts": ["all of humanity", "classification of people"]}, {"entity_id": "human_race", "book_id": "first_principles_spencer_1862", "name": "human race", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["human race"], "contexts": ["distinct groups within humanity"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "humanité", "target_book": "principles_of_psychology_james_1890", "target_name": "humanity", "similarity": 0.982}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "humanité", "target_book": "kosmos_humboldt_1845", "target_name": "humanity", "similarity": 0.982}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "humanité", "target_book": "first_principles_spencer_1862", "target_name": "humanity", "similarity": 0.982}, {"source_book": "principles_of_psychology_james_1890", "source_name": "humanity", "target_book": "kosmos_humboldt_1845", "target_name": "humanity", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "humanity", "target_book": "first_principles_spencer_1862", "target_name": "humanity", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "humanity", "target_book": "first_principles_spencer_1862", "target_name": "humanity", "similarity": 1.0}], "id": 422, "stable_key": "clu_617e581073af62a1", "ground_truth": {"modern_name": "humanity", "confidence": "high", "type": "concept", "note": "The term 'manking' and 'manhans' likely refer to humanity, with 'manhans' also potentially referring to a specific period for medication.", "wikidata_id": "Q1575029", "wikidata_description": "International aid organization with headquarter in France", "wikipedia_url": "https://en.wikipedia.org/wiki/Human", "wikipedia_extract": "Humans (Homo sapiens, meaning \"thinking man\" or \"wise man\") are the most common and widespread species of primate, and the only extant species of the genus Homo. They are great apes characterized by hairlessness, obligate bipedality, manual dexterity with opposable thumbs, precision grip, and high intelligence. Humans have large brains compared to body size (a high encephalization quotient), enabling more advanced cognitive skills that facilitate successful adaptation to varied environments, development of sophisticated tools, and formation of complex social structures and civilizations. Humans possess a disproportionately larger volume of both cerebral white matter and gray matter present in the prefrontal cortex (PFC) than any other primate species, which facilitated the expansion of higher-order executive functions. Humans are highly social, with individual humans tending to belong to a multi-layered network of distinct social groups – from families and peer groups to corporations and political states. As such, social interactions between humans have established a wide variety of values, social norms, languages, and traditions (collectively termed institutions), each of which bolsters human society."}, "member_count": 7, "cross_references": [{"found_name": "world", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2801, "target_cluster_name": "world", "source_book": "llm_generated", "evidence_snippet": "The 'world' is the domain of human existence and experience, making 'Humanity' a closely related concept.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The 'world' is the domain of human existence and experience, making 'Humanity' a closely related concept.", "is_reverse": true}]}, {"canonical_name": "Flame", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 4, "total_mentions": 10, "members": [{"entity_id": "flammes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "flammes", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["flammes"], "contexts": ["flames from volcanoes"]}, {"entity_id": "flame", "book_id": "principles_of_psychology_james_1890", "name": "flame", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["flame"], "contexts": ["burning gas producing light", "mixed us of clay and flame"]}, {"entity_id": "flames", "book_id": "kosmos_humboldt_1845", "name": "flames", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["flames"], "contexts": ["emitted from mud volcanoes", "visible product of combustion"]}, {"entity_id": "flame", "book_id": "kosmos_humboldt_1845", "name": "flame", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["flame"], "contexts": ["visible gaseous part of fire"]}, {"entity_id": "flame", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Flame", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["flame", "Flame"], "contexts": ["visible gaseous part of fire", "source of radiant heat"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "flammes", "target_book": "kosmos_humboldt_1845", "target_name": "flames", "similarity": 0.988}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "flammes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Flame", "similarity": 0.957}, {"source_book": "principles_of_psychology_james_1890", "source_name": "flame", "target_book": "kosmos_humboldt_1845", "target_name": "flames", "similarity": 0.969}, {"source_book": "principles_of_psychology_james_1890", "source_name": "flame", "target_book": "kosmos_humboldt_1845", "target_name": "flame", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "flame", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Flame", "similarity": 0.993}, {"source_book": "kosmos_humboldt_1845", "source_name": "flames", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Flame", "similarity": 0.963}, {"source_book": "kosmos_humboldt_1845", "source_name": "flame", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Flame", "similarity": 0.993}], "id": 423, "stable_key": "clu_aac53ca34af93f81", "ground_truth": {"modern_name": "Flame", "confidence": "high", "type": "concept", "note": "Contexts like 'burning gas producing light' and 'emitted from mud volcanoes' clearly point to the physical phenomenon of flame.", "wikidata_id": "Q5428803", "wikidata_description": "American nonprofit organization", "wikipedia_url": "https://en.wikipedia.org/wiki/Facts%20and%20Logic%20About%20the%20Middle%20East", "wikipedia_extract": "Facts and Logic About the Middle East (FLAME) is a non-profit pro-Israel organization based in San Francisco, California. The Los Angeles Times described FLAME as \"an organization that must literally buy its way into print.\" Their ads, they state, are meant as an explanation for \"the proverbial man from Mars\" regarding various aspects of Arab/Israeli issues. It was founded by Gerardo Joffe and began as a local chapter of the pro-Israel media watchdog group CAMERA. By 1987 the ads, which had appeared using the CAMERA name were now sponsored by FLAME, an independent organization. Its stated purpose is \"the research and publication of the facts regarding developments in the Middle East and exposing false propaganda that might harm the interests of the United States and its allies in that area of the world.\" Since 1987, it has regularly placed ads that it describes as \"monthly hasbarah (educating and clarifying) messages in major publications of general circulation, such as U.S. News and World Report, The New York Times, The Nation, The National Review, The American Spectator, The Washington Times National Weekly, and others\"."}, "cross_references": [{"found_name": "light", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3819, "target_cluster_name": "light", "source_book": "llm_generated", "evidence_snippet": "A visible manifestation of combustion, often associated with light.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: A visible manifestation of combustion, often associated with light.", "is_reverse": true}, {"found_name": "Fire", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 124, "target_cluster_name": "fuego", "source_book": "llm_generated", "evidence_snippet": "Flame is a direct product and manifestation of fire.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Flame is a direct product and manifestation of fire."}, {"found_name": "heat", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 530, "target_cluster_name": "heat", "source_book": "llm_generated", "evidence_snippet": "Flame is a visible, gaseous part of a fire, and is intrinsically linked to the generation and perception of heat.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Flame is a visible, gaseous part of a fire, and is intrinsically linked to the generation and perception of heat.", "is_reverse": true}, {"found_name": "fumo"