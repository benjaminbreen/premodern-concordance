"Parallax", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 22, "members": [{"entity_id": "parallaxes", "book_id": "kosmos_humboldt_1845", "name": "parallaxes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["parallaxes", "Parallaxes"], "contexts": ["measurement for stellar distances", "apparent shift in celestial object position"]}, {"entity_id": "parallax", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Parallax", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 18, "variants": ["parallax", "Parallax"], "contexts": ["apparent shift in celestial object position", "angle for distance measurement"]}, {"entity_id": "parallaxes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "parallaxes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["parallaxes"], "contexts": ["astronomical measurement"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "parallaxes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Parallax", "similarity": 0.934}, {"source_book": "kosmos_humboldt_1845", "source_name": "parallaxes", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "parallaxes", "similarity": 1.0}], "id": 1731, "stable_key": "clu_5fd81c623f758bf1", "ground_truth": {"modern_name": "Parallax", "confidence": "high", "type": "concept", "wikidata_id": "Q12129", "wikidata_description": "unit of length used in astronomy", "wikipedia_url": "https://en.wikipedia.org/wiki/Parsec", "wikipedia_extract": "The parsec (symbol: pc) is a unit of length used to measure the large distances to astronomical objects outside the Solar System, approximately equal to 3.26 light-years or 206265 astronomical units (au), i.e. 30.9 trillion kilometres (19.2 trillion miles). The parsec unit is obtained by the use of parallax and trigonometry, and is defined as the distance at which 1 au subtends an angle of one arcsecond (⁠1/3600⁠ of a degree). The nearest star, Proxima Centauri, is about 1.3 parsecs (4.2 light-years) from the Sun: from that distance, the gap between the Earth and the Sun spans slightly less than one arcsecond. Most stars visible to the naked eye are within a few hundred parsecs of the Sun, with the most distant at a few thousand parsecs, and the Andromeda Galaxy at over 700,000 parsecs. The word parsec is a shortened form of a distance corresponding to a parallax of one arcsecond, coined by the British astronomer Herbert Hall Turner in 1913."}, "cross_references": [{"found_name": "61 Cygni", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1745, "target_cluster_name": "61 Cygni", "source_book": "llm_generated", "evidence_snippet": "61 Cygni was one of the first stars whose distance was measured using parallax, and its distance is often expressed in parsecs.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "61 Cygni was one of the first stars whose distance was measured using parallax, and its distance is often expressed in parsecs."}]}, {"canonical_name": "Glossary", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 22, "members": [{"entity_id": "glossary", "book_id": "coloquios_da_orta_1563", "name": "Glossary", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 19, "variants": ["Glossary", "Glossaire", "Glossário"], "contexts": ["reference work", "book title"]}, {"entity_id": "dictionario", "book_id": "coloquios_da_orta_1563", "name": "Dictionario", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 2, "variants": ["Dictionario"], "contexts": ["book by António de Lebrixa", "a vocabulary book"]}, {"entity_id": "dictionario", "book_id": "polyanthea_medicinal", "name": "Dictionario", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["Dictionario"], "contexts": ["title of a work"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Glossary", "target_book": "polyanthea_medicinal", "target_name": "Dictionario", "similarity": 0.954}, {"source_book": "coloquios_da_orta_1563", "source_name": "Dictionario", "target_book": "polyanthea_medicinal", "target_name": "Dictionario", "similarity": 1.0}], "id": 1732, "stable_key": "clu_508d3605f4482447", "ground_truth": {"modern_name": "Glossary", "confidence": "high", "type": "object", "description": "Reference work containing definitions of terms.", "wikipedia_extract": "A glossary (from Ancient Greek: γλῶσσα, glossa; language, speech, wording), also known as a vocabulary or clavis, is an alphabetical list of terms in a particular domain of knowledge with the definitions for those terms. Traditionally, a glossary appears at the end of a book and includes terms within that book that are either newly introduced, uncommon, or specialized. While glossaries are most commonly associated with non-fiction books, in some cases, fiction novels sometimes include a glossary for unfamiliar terms. A bilingual glossary is a list of terms in one language defined in a second language or glossed by synonyms (or at least near-synonyms) in another language. In a general sense, a glossary contains explanations of concepts relevant to a certain field of study or action. In this sense, the term is related to the notion of ontology."}, "cross_references": [{"found_name": "Livro", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 283, "target_cluster_name": "Livro", "source_book": "llm_generated", "evidence_snippet": "A glossary is a list of terms with definitions, often found at the end of a book.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: A glossary is a list of terms with definitions, often found at the end of a book.", "is_reverse": true}, {"found_name": "Tom. III", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 661, "target_cluster_name": "Tom. III", "source_book": "llm_generated", "evidence_snippet": "A glossary is often found within or appended to a volume, serving a related function of defining terms.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: A glossary is often found within or appended to a volume, serving a related function of defining terms.", "is_reverse": true}, {"found_name": "Almanack", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1413, "target_cluster_name": "Almanack", "source_book": "llm_generated", "evidence_snippet": "An almanac might contain a glossary of terms relevant to its content.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: An almanac might contain a glossary of terms relevant to its content.", "is_reverse": true}, {"found_name": "commentary", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4480, "target_cluster_name": "Commentary", "source_book": "llm_generated", "evidence_snippet": "Commentaries often include glossaries to explain specialized terms within the text.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Commentaries often include glossaries to explain specialized terms within the text."}, {"found_name": "arvore triste", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "«ali (em Malaca) cresce a arvore fingadjr, que os portuguezes chamam a arvore triste» (Cf. Nieuhof, Zee en Lant-Reijen, n, 57, citado por Yule e Bumell, Glossary, no Sup- .plement, palavra Arbol trist", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "Portuguese name"}]}, {"canonical_name": "laranja", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 22, "members": [{"entity_id": "laranja", "book_id": "coloquios_da_orta_1563", "name": "laranja", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 14, "variants": ["laranja", "Laranjas", "larangeira", "laranjas", "laranjeira", "laranjeiras", "naranja"], "contexts": ["fruit, orange", "fruit, juice used in medicine"]}, {"entity_id": "flor_de_laranja", "book_id": "polyanthea_medicinal", "name": "flor de laranja", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["flor de laranja", "flor de laran"], "contexts": ["flower used to make scented water", "orange blossom water"]}, {"entity_id": "laranjas", "book_id": "polyanthea_medicinal", "name": "Laranjas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Laranjas", "laranjas"], "contexts": ["fruit used to treat coughs", "fruit used as remedy"]}, {"entity_id": "laranja", "book_id": "polyanthea_medicinal", "name": "laranja", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["laranja"], "contexts": ["orange used for flowers", "size comparison for bladder stone"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "laranja", "target_book": "polyanthea_medicinal", "target_name": "flor de laranja", "similarity": 0.916}, {"source_book": "coloquios_da_orta_1563", "source_name": "laranja", "target_book": "polyanthea_medicinal", "target_name": "Laranjas", "similarity": 0.956}, {"source_book": "coloquios_da_orta_1563", "source_name": "laranja", "target_book": "polyanthea_medicinal", "target_name": "laranja", "similarity": 1.0}], "id": 1733, "stable_key": "clu_d01b46c36c14a2ca", "ground_truth": {"modern_name": "orange", "confidence": "high", "type": "plant", "linnaean": "Citrus × sinensis", "family": "Rutaceae", "description": "A citrus fruit and its parts, used in food and medicine.", "note": "Includes mentions of both sweet and sour oranges, as well as blossoms.", "wikipedia_extract": "Citrus × sinensis (sometimes written Citrus sinensis), is a broadleaf evergreen hybrid between pomelo (Citrus maxima) and mandarin (Citrus reticulata). Hybrid sweet oranges are commonly cultivated fruits that include Valencia oranges, blood oranges and navel oranges. The orange fruit is an important agricultural product, used for both the juicy fruit pulp and the aromatic peel (rind). Orange blossoms (the flowers) are used in several different ways, as are the leaves and wood of the tree. The orange blossom, which is the state flower of Florida, is highly fragrant and traditionally associated with good fortune. It has long been popular in bridal bouquets and head wreaths."}, "cross_references": [{"found_name": "Citrus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2465, "target_cluster_name": "citrinos", "source_book": "llm_generated", "evidence_snippet": "Citrus is the genus to which the orange belongs.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Citrus is the genus to which the orange belongs."}, {"found_name": "Citrus limon", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1051, "target_cluster_name": "limoens", "source_book": "llm_generated", "evidence_snippet": "Lemon is a closely related citrus fruit.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Lemon is a closely related citrus fruit."}, {"found_name": "fruit", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 72, "target_cluster_name": "frutas", "source_book": "llm_generated", "evidence_snippet": "The orange is a type of fruit.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The orange is a type of fruit."}, {"found_name": "lemon", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1051, "target_cluster_name": "limoens", "source_book": "llm_generated", "evidence_snippet": "Lemon is a closely related citrus fruit.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Lemon is a closely related citrus fruit."}, {"found_name": "lime", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1314, "target_cluster_name": "limon", "source_book": "llm_generated", "evidence_snippet": "Lime is a closely related citrus fruit.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Lime is a closely related citrus fruit."}, {"found_name": "citrinos", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2465, "target_cluster_name": "citrinos", "source_book": "llm_generated", "evidence_snippet": "Oranges are a well-known and significant hybrid fruit derived from the Citrus genus.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Oranges are a well-known and significant hybrid fruit derived from the Citrus genus.", "is_reverse": true}]}, {"canonical_name": "Alhos", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 22, "members": [{"entity_id": "alhos", "book_id": "coloquios_da_orta_1563", "name": "alhos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["alhos", "alho"], "contexts": ["ingredient for flavoring food", "garlic, mixed with calamus for horses"]}, {"entity_id": "alhos", "book_id": "polyanthea_medicinal", "name": "Alhos", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 15, "variants": ["Alhos", "alhas", "alho", "alhoa", "alhos"], "contexts": ["garlic", "flatulent food"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "alhos", "target_book": "polyanthea_medicinal", "target_name": "Alhos", "similarity": 0.989}], "id": 1734, "stable_key": "clu_fead76225e6d1d3e", "ground_truth": {"modern_name": "Garlic", "confidence": "high", "type": "plant", "linnaean": "Allium sativum", "family": "Amaryllidaceae", "description": "A pungent bulbous plant used as food and medicine.", "wikipedia_extract": "Garlic (Allium sativum) is a species of bulbous flowering plants in the genus Allium. Its close relatives include the onion, shallot, leek, chives, Welsh onion, and Chinese onion. Garlic is native to central and western Asia, stretching from the Black Sea through the southern Caucasus, northeastern Iran, and the Hindu Kush. It has naturalized in many other parts of the world, including Mediterranean Europe and China. There are two subspecies and hundreds of varieties of garlic. Garlic has been used for thousands of years as a seasoning, culinary ingredient, and traditional medical remedy."}, "cross_references": [{"found_name": "Garlick", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2260, "target_cluster_name": "Garlick", "source_book": "llm_generated", "evidence_snippet": "Alhos is explicitly listed as a historical name for Garlic.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: Alhos is explicitly listed as a historical name for Garlic.", "is_reverse": true}, {"found_name": "Moly", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2675, "target_cluster_name": "Moly", "source_book": "llm_generated", "evidence_snippet": "Moly is described as 'yellow garlic' and belongs to the genus Allium, which includes garlic.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: Moly is described as 'yellow garlic' and belongs to the genus Allium, which includes garlic.", "is_reverse": true}, {"found_name": "Onions", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2706, "target_cluster_name": "Onions", "source_book": "llm_generated", "evidence_snippet": "Garlic (Allium sativum) is a closely related species within the same genus (Allium) as the onion (Allium cepa), often cultivated and used similarly in cuisine and traditional medicine.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Garlic (Allium sativum) is a closely related species within the same genus (Allium) as the onion (Allium cepa), often cultivated and used similarly in cuisine and traditional medicine.", "is_reverse": true}, {"found_name": "Millepedes", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "polyanthea_medicinal", "evidence_snippet": "que os: Medicos chamão Afelli, ou Millepedes, dados novinho branco ; mas quando : \" não ourine, meteremos ao doente no ſeguinte banho. Tomem de palhas alhas , dealfavacade cobra, de rabãos, &de bagas ", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "medical term, synonym for Afelli"}, {"found_name": "cominhos rústicos", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "enfermidades dos nervos (i); tudo o que mais se guasta he, no tempo frio, pêra os cavallos; porque por as manhãas lho dão a comer pisado e misturado com alhos e ameos, que he cominhos rústicos, e algu", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym of ameos"}, {"found_name": "Parreyra brava", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": null, "target_cluster_name": null, "source_book": "polyanthea_medicinal", "evidence_snippet": "tando-lhe em lugardobalfamo ,meyaonça de aguadaRainhadeUngria. Se \" acaufaforem flatos , deytaremos ajuda de caldo de gallo velho , cozido com \" palhas-alhas ,alfavacadecobra, hervadoce, hortela,ajunt", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "vulgar name for poda raizdaButua"}]}, {"canonical_name": "castanhas", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 22, "members": [{"entity_id": "castanhas", "book_id": "coloquios_da_orta_1563", "name": "castanhas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["castanhas", "castanha", "castanhas da jaca", "castanho"], "contexts": ["description of a fruit's taste when dry", "chestnuts, used for comparison of taste"]}, {"entity_id": "castanhas", "book_id": "polyanthea_medicinal", "name": "castanhas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 15, "variants": ["castanhas", "Castanhas", "cafcasdecaftanhas", "caftanhas", "castanha", "caſtanhas"], "contexts": ["nutritious food", "source of powder for treatment"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "castanhas", "target_book": "polyanthea_medicinal", "target_name": "castanhas", "similarity": 1.0}], "id": 1735, "stable_key": "clu_4d6ffa0e20b112d8", "ground_truth": {"modern_name": "Chestnuts", "confidence": "high", "type": "plant", "description": "Edible nuts from trees, used as food and in medicinal preparations.", "wikipedia_extract": "Chestnuts are the deciduous trees and shrubs in the genus Castanea, in the beech family Fagaceae. The name also refers to the edible nuts they produce. They are native to temperate regions of the Northern Hemisphere. Chestnut trees are of moderate growth rate (for the Chinese chestnut tree) to fast growth rate (for American and European species). Their mature heights vary from the smallest species of chinkapins, often shrubby, to the giant of past American forests, C. dentata that could reach 30 metres (98 feet). Between these extremes are found the Japanese chestnut tree (C. crenata) at 10 m average; followed by the Chinese chestnut tree (C. mollissima) at about 15 m, then the European chestnut tree (C. sativa) around 30 m."}, "cross_references": [{"found_name": "arvore", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1632, "target_cluster_name": "arvore", "source_book": "llm_generated", "evidence_snippet": "Chestnuts are the fruit of chestnut trees.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Chestnuts are the fruit of chestnut trees.", "is_reverse": true}]}, {"canonical_name": "Perdiz", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 22, "members": [{"entity_id": "perdiz", "book_id": "coloquios_da_orta_1563", "name": "perdiz", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["perdiz", "perdi^", "perdizes"], "contexts": ["partridge, a food item", "food for the sick"]}, {"entity_id": "perdiz", "book_id": "polyanthea_medicinal", "name": "Perdiz", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 19, "variants": ["Perdiz", "o dePerdiz", "perdiz"], "contexts": ["partridge", "partridge used in a broth"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "perdiz", "target_book": "polyanthea_medicinal", "target_name": "Perdiz", "similarity": 0.738}], "id": 1736, "stable_key": "clu_ce49f2555b6c835c", "ground_truth": {"modern_name": "Partridge", "confidence": "high", "type": "animal", "description": "A game bird, often prepared as food.", "wikipedia_extract": "A partridge is a medium-sized galliform bird in any of several genera, with a wide native distribution throughout parts of Europe, Asia and Africa. Several species have been introduced to the Americas. They are sometimes grouped in the Perdicinae subfamily of the Phasianidae (pheasants, quail, etc.). However, molecular research suggests that partridges are not a distinct taxon within the superfamily Phasianoidea, but that some species are closer to the pheasants, while others are closer to the junglefowl. Partridges are medium-sized game birds, generally intermediate in size between the larger pheasants and smaller quail; they're ground-dwelling birds that feature variable plumage colouration across species, with most tending to grey and brown. Partridges are native to Europe, Asia, Africa, and the Middle East."}, "cross_references": [{"found_name": "Partridge", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 1135, "target_cluster_name": "Partridge", "source_book": "llm_generated", "evidence_snippet": "Perdiz is the Spanish word for partridge.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "reverse: Perdiz is the Spanish word for partridge.", "is_reverse": true}, {"found_name": "Birds", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 5, "target_cluster_name": "birds", "source_book": "llm_generated", "evidence_snippet": "Partridge is a type of bird.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Partridge is a type of bird."}]}, {"canonical_name": "Trementina", "category": "PLANT", "subcategory": "RESIN", "book_count": 2, "total_mentions": 22, "members": [{"entity_id": "trementina", "book_id": "coloquios_da_orta_1563", "name": "trementina", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["trementina"], "contexts": ["turpentine", "resin with similar virtue"]}, {"entity_id": "trementina", "book_id": "ricettario_fiorentino_1597", "name": "Trementina", "category": "PLANT", "subcategory": "RESIN", "count": 20, "variants": ["Trementina", "Trementina Venetiana", "Trementina lanata", "trementina"], "contexts": ["plant resin, turpentine", "resin, likely turpentine"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "trementina", "target_book": "ricettario_fiorentino_1597", "target_name": "Trementina", "similarity": 0.775}], "id": 1737, "stable_key": "clu_3a103e46ada111f4", "ground_truth": {"modern_name": "Turpentine", "confidence": "high", "type": "plant", "family": "Pinaceae", "note": "The term 'trementina' historically referred to turpentine, often derived from various coniferous trees.", "wikidata_id": "Q63045", "wikidata_description": "species of plant native to the Mediterranean region", "wikipedia_url": "https://en.wikipedia.org/wiki/Pistacia%20terebinthus", "wikipedia_extract": "Pistacia terebinthus, also called the terebinth,  is a deciduous shrub species of the genus Pistacia, native to the Mediterranean region from the western regions of Morocco and Portugal to Greece and western and southeastern Turkey. At one time terebinths growing on the eastern shores of the Mediterranean Sea  were regarded as a separate species, Pistacia palaestina, but these are now considered to be a synonym of P. terebinthus. The terebinth is a deciduous flowering plant belonging to the cashew family, Anacardiaceae; a small tree or large shrub, it grows to 10 m (33 ft) tall. The leaves are compound, 10–20 cm (3.9–7.9 in) long, odd pinnate with five to eleven opposite glossy oval leaflets, the leaflets 2–6 cm (0.79–2.36 in) long and 1–3 cm (0.39–1.18 in) broad. The flowers are reddish-purple, appearing with the new leaves in early spring."}, "cross_references": [{"found_name": "Gomma", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2355, "target_cluster_name": "Gomma", "source_book": "llm_generated", "evidence_snippet": "Turpentine is a resin obtained from pine trees, and thus is a specific type of plant gum/resin.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Turpentine is a resin obtained from pine trees, and thus is a specific type of plant gum/resin.", "is_reverse": true}, {"found_name": "abeto", "link_type": "derivation", "link_strength": 0.4, "target_cluster_id": 3182, "target_cluster_name": "abeto", "source_book": "ricettario_fiorentino_1597", "evidence_snippet": ". Pi- glianli da gli animali come se detto di fopra . DELLA RAGIA. LaragiaciI liquore,che naturalmente difti Ila dal Pi* no, dalla picea , dall'abete, e fimili ; e ritrouafene di due ma- niere ; vna l", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "reverse: derived from various trees", "is_reverse": true}]}, {"canonical_name": "Linschoten", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "linschotten", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Linschotten", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Linschotten"], "contexts": ["diligent enquirer in Oriental Navigations"]}, {"entity_id": "linschoten", "book_id": "coloquios_da_orta_1563", "name": "Linschoten", "category": "PERSON", "subcategory": "SCHOLAR", "count": 20, "variants": ["Linschoten"], "contexts": ["mentioned Anacardium occidentale", "author of Navigatio ac Itinerarium"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Linschotten", "target_book": "coloquios_da_orta_1563", "target_name": "Linschoten", "similarity": 0.983}], "id": 1738, "stable_key": "clu_cda829f8f8741976", "ground_truth": {"modern_name": "Jan Huygen van Linschoten", "confidence": "high", "type": "person", "birth_year": 1563, "death_year": 1611, "description": "Dutch explorer and merchant who wrote extensively on Asia.", "wikidata_id": "Q941383", "wikidata_description": "Dutch Protestant merchant, traveller and historian (1563–1611)"}, "cross_references": []}, {"canonical_name": "Polypo", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "polipus", "book_id": "english_physician_1652", "name": "Polipus", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 6, "variants": ["Polipus"], "contexts": ["stinking sores in the nose", "fleshy growth in the nose"]}, {"entity_id": "polypo", "book_id": "polyanthea_medicinal", "name": "Polypo", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 15, "variants": ["Polypo", "Polipos", "Polypos", "polyp.", "polypo", "polypos"], "contexts": ["medical condition in the nose", "growth in the nose"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Polipus", "target_book": "polyanthea_medicinal", "target_name": "Polypo", "similarity": 0.887}], "id": 1739, "stable_key": "clu_609001a83d19885b", "ground_truth": {"modern_name": "Polyps", "confidence": "high", "type": "disease", "description": "An abnormal growth of tissue, often in the nose or other mucous membranes.", "wikipedia_extract": "A polyp in zoology is one of two forms  found in the phylum Cnidaria, the other being the medusa. Polyps are roughly cylindrical in shape and elongated at the axis of the vase-shaped body. In solitary polyps, the aboral (opposite to oral) end is attached to the substrate by means of a disc-like holdfast called a pedal disc, while in colonies of polyps it is connected to other polyps, either directly or indirectly. The oral end contains the mouth, and is surrounded by a circlet of tentacles. In the class Anthozoa, comprising the sea anemones and corals, the individual is always a polyp; in the class Hydrozoa, however, the individual may be either a polyp or a medusa, with most species undergoing a life cycle with both a polyp stage and a medusa stage. In the class Scyphozoa, the medusa stage is dominant, and the polyp stage may or may not be present, depending on the family."}, "cross_references": [{"found_name": "Tumor", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 556, "target_cluster_name": "tumor", "source_book": "llm_generated", "evidence_snippet": "Historically, 'polyps' could refer to abnormal growths or tumors, particularly in internal organs, which are distinct from the zoological definition but were often conflated in medical contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Historically, 'polyps' could refer to abnormal growths or tumors, particularly in internal organs, which are distinct from the zoological definition but were often conflated in medical contexts."}]}, {"canonical_name": "Veragua", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "veragua", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Veragua", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 20, "variants": ["Veragua", "Varagua", "Veragna"], "contexts": ["city with population 30,000", "province name"]}, {"entity_id": "veragua", "book_id": "historia_medicinal_monardes_1574", "name": "Veragua", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Veragua"], "contexts": ["region near Nata"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Veragua", "target_book": "historia_medicinal_monardes_1574", "target_name": "Veragua", "similarity": 0.802}], "id": 1740, "stable_key": "clu_8a4727988d0cac62", "ground_truth": {"modern_name": "Veragua", "confidence": "high", "type": "place", "country": "Panama", "wikidata_id": "Q27135788", "wikidata_description": "chemical compound"}, "cross_references": [{"found_name": "Darién", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1642, "target_cluster_name": "Darien", "source_book": "llm_generated", "evidence_snippet": "Veragua was a Spanish colonial province in Central America, and Darién was a neighboring province, often with overlapping claims and conflicts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Veragua was a Spanish colonial province in Central America, and Darién was a neighboring province, often with overlapping claims and conflicts."}]}, {"canonical_name": "La Condamine", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "la_condamine", "book_id": "relation_historique_humboldt_vol3_1825", "name": "La Condamine", "category": "PERSON", "subcategory": "SCHOLAR", "count": 17, "variants": ["La Condamine", "Condamine", "Fia Condamine", "M. de La Condamine", "M. de La Cundamine", "de la Condamine"], "contexts": ["proposed expedition in 1734", "affirmed absence of stones"]}, {"entity_id": "la_condamine", "book_id": "kosmos_humboldt_1845", "name": "La Condamine", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["La Condamine"], "contexts": ["erected monument at equator", "made observation in Journal du Voyage"]}, {"entity_id": "condamine,_la", "book_id": "kosmos_humboldt_1845", "name": "Condamine, La", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Condamine, La"], "contexts": ["mentioned pendulum use for seconds"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "La Condamine", "target_book": "kosmos_humboldt_1845", "target_name": "La Condamine", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "La Condamine", "target_book": "kosmos_humboldt_1845", "target_name": "Condamine, La", "similarity": 0.949}], "id": 1741, "stable_key": "clu_e059ba02564d8860", "ground_truth": {"modern_name": "Charles Marie de La Condamine", "confidence": "high", "type": "person", "birth_year": 1701, "death_year": 1774, "description": "French explorer, scientist, and writer; known for his measurements of the Earth.", "wikidata_id": "Q26681", "wikidata_description": "French explorer, geographer, and mathematician (1701-1774)", "wikipedia_extract": "François-Marie Arouet (French: [fʁɑ̃swa maʁi aʁwɛ]; 21 November 1694 – 30 May 1778), known by his pen name Voltaire (, US also ; French: [vɔltɛːʁ]), was a French Enlightenment writer, philosopher (philosophe), satirist, and historian. Famous for his wit and his criticism of Christianity (especially of the Catholic Church) and of slavery, Voltaire was an advocate of freedom of speech, freedom of religion, and separation of church and state. Voltaire was a versatile and prolific writer, producing works in almost every literary form, including plays, poems, novels, essays, histories, and even scientific expositions. He wrote more than 20,000 letters and 2,000 books and pamphlets. Voltaire was one of the first authors to become renowned and commercially successful internationally. He was an outspoken advocate of civil liberties and was at constant risk from the strict censorship laws of the Catholic French monarchy.", "wikipedia_url": "https://en.wikipedia.org/wiki/Charles_Marie_de_La_Condamine"}, "cross_references": [{"found_name": "Bouguer", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 325, "target_cluster_name": "Bouguer", "source_book": "llm_generated", "evidence_snippet": "Both were French scientists involved in the measurement of the Earth and expeditions in South America during the 18th century.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were French scientists involved in the measurement of the Earth and expeditions in South America during the 18th century.", "is_reverse": true}, {"found_name": "Godin", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2290, "target_cluster_name": "Godin", "source_book": "llm_generated", "evidence_snippet": "Both were members of the French Academy of Sciences and participated in the same scientific expedition to South America (the French Geodesic Mission).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were members of the French Academy of Sciences and participated in the same scientific expedition to South America (the French Geodesic Mission).", "is_reverse": true}, {"found_name": "La Pérouse", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2393, "target_cluster_name": "La Pérouse", "source_book": "llm_generated", "evidence_snippet": "Both were prominent French explorers and scientists who undertook significant expeditions in the 18th century. La Condamine is known for his expedition to the Amazon basin, while La Pérouse led a major scientific voyage around the Pacific.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were prominent French explorers and scientists who undertook significant expeditions in the 18th century. La Condamine is known for his expedition to the Amazon basin, while La Pérouse led a major scientific voyage around the Pacific.", "is_reverse": true}]}, {"canonical_name": "pôles magnétiques", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 21, "members": [{"entity_id": "pôles_magnétiques", "book_id": "relation_historique_humboldt_vol3_1825", "name": "pôles magnétiques", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 16, "variants": ["pôles magnétiques", "hémisphères magnétiques", "l'équateur magnétique", "méridien magnétique", "pôle magnétique boréal", "équateur magnétique"], "contexts": ["magnetic properties of serpentine", "magnetic poles"]}, {"entity_id": "magnetic_poles", "book_id": "kosmos_humboldt_1845", "name": "Magnetic poles", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["magnetic poles", "Magnetic poles"], "contexts": ["points of zero horizontal magnetic power", "poles of cold"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "pôles magnétiques", "target_book": "kosmos_humboldt_1845", "target_name": "Magnetic poles", "similarity": 0.88}], "id": 1742, "stable_key": "clu_65aa1e1defc8c614", "ground_truth": {"modern_name": "Magnetic poles", "confidence": "high", "type": "concept", "wikidata_id": "Q63245279", "wikidata_description": "wandering point on the Earth where the geomagnetic field lines are directed vertically, either upwards or downwards"}, "cross_references": [{"found_name": "Magnetic force", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1721, "target_cluster_name": "magnetic force", "source_book": "llm_generated", "evidence_snippet": "Magnetic poles are the source of magnetic forces.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Magnetic poles are the source of magnetic forces."}, {"found_name": "Magnetic meridian", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1281, "target_cluster_name": "magnetic meridian", "source_bo