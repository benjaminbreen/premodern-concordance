g to Mexico"]}, {"entity_id": "mexican", "book_id": "kosmos_humboldt_1845", "name": "Mexican", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Mexican"], "contexts": ["geographic region in Mexico"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mexico", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Mexique", "similarity": 0.961}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mexico", "target_book": "kosmos_humboldt_1845", "target_name": "Mexico", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mexico", "target_book": "historia_medicinal_monardes_1574", "target_name": "Mexico", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Mexico", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mexico", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Mexique", "target_book": "kosmos_humboldt_1845", "target_name": "Mexico", "similarity": 0.961}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Mexique", "target_book": "historia_medicinal_monardes_1574", "target_name": "Mexico", "similarity": 0.961}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Mexique", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mexico", "similarity": 0.961}, {"source_book": "kosmos_humboldt_1845", "source_name": "Mexico", "target_book": "historia_medicinal_monardes_1574", "target_name": "Mexico", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Mexico", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mexico", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Mexico", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Mexico", "similarity": 1.0}