link_strength": 0.5, "target_cluster_id": 2167, "target_cluster_name": "balneis", "source_book": "llm_generated", "evidence_snippet": "While baths could be hot, cold baths or the cooling aspect of bathing were also relevant.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: While baths could be hot, cold baths or the cooling aspect of bathing were also relevant.", "is_reverse": true}]}, {"canonical_name": "animal matter", "category": "SUBSTANCE", "subcategory": "PRODUCT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "animal_matter", "book_id": "kosmos_humboldt_1845", "name": "animal matter", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 1, "variants": ["animal matter"], "contexts": ["substance derived from animals"]}, {"entity_id": "animal_substances", "book_id": "kosmos_humboldt_1845", "name": "animal substances", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 1, "variants": ["animal substances"], "contexts": ["materials derived from animals"]}, {"entity_id": "animal_substances", "book_id": "connexion_physical_sciences_somerville_1858", "name": "animal substances", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 1, "variants": ["animal substances"], "contexts": ["substances derived from animals"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "animal matter", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "animal substances", "similarity": 0.945}, {"source_book": "kosmos_humboldt_1845", "source_name": "animal substances", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "animal substances", "similarity": 1.0}], "id": 3659, "stable_key": "clu_4432ea341aa8a930", "ground_truth": {"modern_name": "animal products", "confidence": "high", "type": "concept", "wikipedia_extract": "Animal husbandry is the branch of agriculture concerned with animals that are raised for meat, fibre, milk, or other products. It includes day-to-day care, management, production, nutrition, selective breeding, and the raising of livestock. Husbandry has a long history, starting with the Neolithic Revolution when animals were first domesticated, from around 13,000 BC onwards, predating farming of the first crops. During the period of ancient societies like ancient Egypt, cattle, sheep, goats, and pigs were being raised on farms. Major changes took place in the Columbian exchange, when Old World livestock were brought to the New World, and then in the British Agricultural Revolution of the 18th century, when livestock breeds like the Dishley Longhorn cattle and Lincoln Longwool sheep were rapidly improved by agriculturalists, such as Robert Bakewell, to yield more meat, milk, and wool. A wide range of other species, such as horse, water buffalo, llama, rabbit, and guinea pig, are used as livestock in some parts of the world.", "wikipedia_url": "https://en.wikipedia.org/wiki/Animal_husbandry"}, "cross_references": []}, {"canonical_name": "mercurial column", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "mercurial_column", "book_id": "kosmos_humboldt_1845", "name": "mercurial column", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["mercurial column"], "contexts": ["column of mercury in a barometer"]}, {"entity_id": "mercurial_column", "book_id": "first_principles_spencer_1862", "name": "mercurial column", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["mercurial column"], "contexts": ["column of mercury in a thermometer"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "mercurial column", "target_book": "first_principles_spencer_1862", "target_name": "mercurial column", "similarity": 1.0}], "id": 3660, "stable_key": "clu_a21cf0d410b3efd7", "ground_truth": {"modern_name": "mercury column", "confidence": "high", "type": "concept", "note": "Refers to the column of mercury in scientific instruments like thermometers and barometers."}, "cross_references": []}, {"canonical_name": "mausim", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "mausim", "book_id": "kosmos_humboldt_1845", "name": "mausim", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mausim"], "contexts": ["Arabic word for set time or season"]}, {"entity_id": "mausim", "book_id": "coloquios_da_orta_1563", "name": "mausim", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["mausim"], "contexts": ["Arabic word for seasonal wind", "Arabic word for monsoon"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "mausim", "target_book": "coloquios_da_orta_1563", "target_name": "mausim", "similarity": 1.0}], "id": 3661, "stable_key": "clu_20db31bed275ef96", "ground_truth": {"modern_name": "Mausim", "confidence": "high", "type": "concept", "note": "Identified as an Arabic term for season or seasonal wind as per the context provided.", "wikidata_id": "Q1884005", "wikidata_description": "Islamic and Sufi concept"}, "cross_references": [{"found_name": "monção", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "dada aqui á palavra é em extremo interessante; man^ çam ou monção designava geralmente o vento dominante em períodos determinados, mas a palavra árabe mausim, da qual se derivou, signifi- J Das mangas", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for mausim"}]}, {"canonical_name": "transmission of heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "distribution_of_heat", "book_id": "kosmos_humboldt_1845", "name": "distribution of heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["distribution of heat"], "contexts": ["understanding heat in the atmosphere"]}, {"entity_id": "transmission_of_heat", "book_id": "connexion_physical_sciences_somerville_1858", "name": "transmission of heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["transmission of heat"], "contexts": ["subject of M. Melloni's experiments", "movement of thermal energy"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "distribution of heat", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "transmission of heat", "similarity": 0.909}], "id": 3662, "stable_key": "clu_7823d1dc4711d30f", "ground_truth": {"modern_name": "heat transfer", "confidence": "high", "type": "concept", "wikidata_id": "Q179635", "wikidata_description": "transport of thermal energy in physical systems", "wikipedia_url": "https://en.wikipedia.org/wiki/Heat%20transfer", "wikipedia_extract": "Heat transfer is a discipline of thermal engineering that concerns the generation, use, conversion, and exchange of thermal energy (heat) between physical systems. Heat transfer is classified into various mechanisms, such as thermal conduction, thermal convection, thermal radiation, and transfer of energy by phase changes. Engineers also consider the transfer of mass of differing chemical species (mass transfer in the form of advection), either cold or hot, to achieve heat transfer. While these mechanisms have distinct characteristics, they often occur simultaneously in the same system. Heat conduction, also called diffusion, is the direct microscopic exchanges of kinetic energy of particles (such as molecules) or quasiparticles (such as lattice waves) through the boundary between two systems. When an object is at a different temperature from another body or its surroundings, heat flows so that the body and the surroundings reach the same temperature, at which point they are in thermal equilibrium."}, "cross_references": []}, {"canonical_name": "barometric pressure", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "barometrical_pressure", "book_id": "kosmos_humboldt_1845", "name": "barometrical pressure", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["barometrical pressure"], "contexts": ["atmospheric condition affecting organs"]}, {"entity_id": "barometric_pressure", "book_id": "connexion_physical_sciences_somerville_1858", "name": "barometric pressure", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["barometric pressure"], "contexts": ["pressure exerted by the atmosphere", "pressure of the atmosphere"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "barometrical pressure", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "barometric pressure", "similarity": 0.926}], "id": 3663, "stable_key": "clu_dec797a117eedc59", "ground_truth": {"modern_name": "barometric pressure", "confidence": "high", "type": "concept"}, "cross_references": []}, {"canonical_name": "boiling point", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "boiling-point", "book_id": "kosmos_humboldt_1845", "name": "boiling-point", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["boiling-point"], "contexts": ["temperature at which liquid boils"]}, {"entity_id": "boiling_point", "book_id": "connexion_physical_sciences_somerville_1858", "name": "boiling point", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["boiling point"], "contexts": ["temperature at which liquid boils"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "boiling-point", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "boiling point", "similarity": 0.98}], "id": 3664, "stable_key": "clu_eeaec