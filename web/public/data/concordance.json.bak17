 "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "forces_of_attraction", "book_id": "kosmos_humboldt_1845", "name": "forces of attraction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["forces of attraction"], "contexts": ["gravitational forces"]}, {"entity_id": "chemical_force_of_attraction", "book_id": "connexion_physical_sciences_somerville_1858", "name": "chemical force of attraction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["chemical force of attraction"], "contexts": ["force between particles in chemical reactions"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "forces of attraction", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "chemical force of attraction", "similarity": 0.905}], "id": 4344, "stable_key": "clu_ed1433902402b67f", "ground_truth": {"modern_name": "Forces of attraction", "confidence": "high", "type": "concept", "note": "This broadly encompasses forces like gravity and chemical affinity, as understood in early modern physics and chemistry.", "wikidata_id": "Q125851866", "wikidata_description": "episode of The Bureau of Magical Things (S1 E13)"}, "cross_references": [{"found_name": "Force", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 59, "target_cluster_name": "Force", "source_book": "llm_generated", "evidence_snippet": "Forces of attraction is a broader category that includes various types of attractive forces, such as gravitational and electrostatic forces.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Forces of attraction is a broader category that includes various types of attractive forces, such as gravitational and electrostatic forces.", "is_reverse": true}, {"found_name": "attractive force", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1111, "target_cluster_name": "attract