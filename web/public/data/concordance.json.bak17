rmation", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "de_transition", "book_id": "relation_historique_humboldt_vol3_1825", "name": "de transition", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["de transition", "transition"], "contexts": ["transition terrain", "transition rocks"]}, {"entity_id": "transition_formation", "book_id": "kosmos_humboldt_1845", "name": "transition formation", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["transition formation"], "contexts": ["geological period", "geological period/layer"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "de transition", "target_book": "kosmos_humboldt_1845", "target_name": "transition formation", "similarity": 0.917}], "id": 2774, "stable_key": "clu_c75e5bce532d37ee", "ground_truth": {"modern_name": "Transition formation", "confidence": "high", "type": "concept", "note": "This refers to geological strata or periods of transition in rock formation.", "wikipedia_extract": "In chemistry, substance is a unique form of matter with constant chemical composition and characteristic properties. Chemical substances may take the form of a single element or chemical compounds. If two or more chemical substances can be combined without reacting, they may form a chemical mixture. If a mixture is separated to isolate one chemical substance to a desired degree, the resulting substance is said to be chemically pure. Chemical substances can exist in several different physical states or phases (e.g. solids, liquids, gases, or plasma) without changing their chemical composition.", "wikipedia_url": "https://en.wikipedia.org/wiki/Substance_(chemistry)"}, "cross_references": [{"found_name": "Transition limestone", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1846, "target_cluster_name": "Calcaire de transition", "source_book": "llm_generated", "evidence_snippet": "Transition limestone is a specific type of rock formation that is geologically related to transition formations.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Transition limestone is a specific type of rock formation that is geologically related to transition formations."}]}, {"canonical_name": "pendulum", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "pendule", "book_id": "relation_historique_humboldt_vol3_1825", "name": "pendule", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["pendule"], "contexts": ["used for observations", "instrument for measuring oscillations"]}, {"entity_id": "pendulum", "book_id": "principles_of_psychology_james_1890", "name": "pendulum", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 3, "variants": ["pendulum"], "contexts": ["device for time measurement", "object that swings back and forth"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "pendule", "target_book": "principles_of_psychology_james_1890", "target_name": "pendulum", "similarity": 0.943}], "id": 2775, "stable_key": "clu_e30be5c468851a6d", "ground_truth": {"modern_name": "Pendulum", "confidence": "high", "type": "OBJECT", "description": "A weight suspended from a fixed point, swinging freely.", "wikipedia_extract": "A pendulum is a device made of a weight suspended from a pivot so that it can swing freely. When a pendulum is displaced sideways from its resting, equilibrium position, it is subject to a restoring force due to gravity that will accelerate it back toward the equilibrium position. When released, the restoring force acting on the pendulum's mass causes it to oscillate about the equilibrium position, swinging back and forth. The time for one complete cycle, a left swing and a right swing, is called the period. The period depends on the length of the pendulum and also to a slight degree on the amplitude, the width of the pendulum's swing. The SI unit of the period of a pendulum is the second (s)."}, "cross_references": [{"found_name": "chronomètres", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 853, "target_cluster_name": "chronomètres", "source_book": "llm_generated", "evidence_snippet": "Pendulums were a fundamental mechanism in many historical clocks and chronometers for regulating timekeeping.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Pendulums were a fundamental mechanism in many historical clocks and chronometers for regulating timekeeping.", "is_reverse": true}, {"found_name": "clocks", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2303, "target_cluster_name": "clocks", "source_book": "llm_generated", "evidence_snippet": "Pendulums were a crucial component in the development of accurate mechanical clocks, and are intrinsically linked to their function.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Pendulums were a crucial component in the development of accurate mechanical clocks, and are intrinsically linked to their function.", "is_reverse": true}, {"found_name": "Horologium", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2822, "target_cluster_name": "Horologium", "source_book": "llm_generated", "evidence_snippet": "Pendulums are often key components in horological devices like clocks and watches.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Pendulums are often key components in horological devices like clocks and watches.", "is_reverse": true}]}, {"canonical_name": "Caribbean Islands", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "îles_caribes", "book_id": "relation_historique_humboldt_vol3_1825", "name": "îles C