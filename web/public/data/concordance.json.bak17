ty_id": "nerve", "book_id": "first_principles_spencer_1862", "name": "nerve", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["nerve"], "contexts": ["tissue transmitting signals", "part of the nervous system"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "nerve", "target_book": "principles_of_psychology_james_1890", "target_name": "nerve", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "nerve", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "nerve", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "nerve", "target_book": "first_principles_spencer_1862", "target_name": "nerve", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "nerve", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "nerve", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "nerve", "target_book": "first_principles_spencer_1862", "target_name": "nerve", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "nerve", "target_book": "first_principles_spencer_1862", "target_name": "nerve", "similarity": 1.0}], "id": 468, "stable_key": "clu_51e26cf57f8b1db3", "ground_truth": {"modern_name": "nerve", "confidence": "high", "type": "concept", "wikidata_id": "Q9620", "wikidata_description": "enclosed, cable-like bundle of axons in the peripheral nervous system", "wikipedia_url": "https://en.wikipedia.org/wiki/Nerve", "wikipedia_extract": "A nerve is an enclosed, cable-like bundle of nerve fibers (called axons). Nerves have historically been considered the basic units of the peripheral nervous system. A nerve provides a common pathway for the electrochemical nerve impulses called action potentials that are transmitted along each of the axons to peripheral organs or, in the case of sensory nerves, from the periphery back to the central nervous system. Each axon is an extension of an individual neuron, along with other supportive cells such as some Schwann cells that coat the axons in myelin. Each axon is surrounded by a layer of connective tissue called the endoneurium. The axons are bundled together into groups called fascicles, and each fascicle is wrapped in a layer of connective tissue called the perineurium."}, "cross_references": [{"found_name": "Muscles", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 265, "target_cluster_name": "muscles", "source_book": "llm_generated", "evidence_snippet": "Nerves are intrinsically linked to muscles as they control muscle movement and receive sensory feedback from them. This is a fundamental physiological relationship.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Nerves are intrinsically linked to muscles as they control muscle movement and receive sensory feedback from them. This is a fundamental physiological relationship."}, {"found_name": "Brain", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 49, "target_cluster_name": "brain", "source_book": "llm_generated", "evidence_snippet": "The brain is the central processing unit of the nervous system, and nerves are the pathways that connect the brain to the rest of the body. They are inseparable in function and structure.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The brain is the central processing unit of the nervous system, and nerves are the pathways that connect the brain to the rest of the body. They are inseparable in function and structure."}, {"found_name": "Auditory nerve", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3092, "target_cluster_name": "auditory nerve", "source_book": "llm_generated", "evidence_snippet": "The auditory nerve is a specific type of nerve, directly related to the general category of nerves.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The auditory nerve is a specific type of nerve, directly related to the general category of nerves."}, {"found_name": "Motor neuron", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2581, "target_cluster_name": "motor nerve", "source_book": "llm_generated", "evidence_snippet": "The motor neuron is a specific type of nerve cell, and thus closely related to the concept of a nerve.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The motor neuron is a specific type of nerve cell, and thus closely related to the concept of a nerve."}, {"found_name": "Nervous tissue", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2577, "target_cluster_name": "nerve-tissue", "source_book": "llm_generated", "evidence_snippet": "Nervous tissue is the fundamental biological material that makes up nerves.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Nervous tissue is the fundamental biological material that makes up nerves."}]}, {"canonical_name": "Polar Circle", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 7, "members": [{"entity_id": "polar_circle", "book_id": "origin_of_species_darwin_1859", "name": "Polar Circle", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Polar Circle"], "contexts": ["latitude circle around the North Pole", "arctic region"]}, {"entity_id": "cercle_polaire", "book_id": "relation_historique_humboldt_vol3_1825", "name": "cercle polaire", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["cercle polaire"], "contexts": ["geographic latitude"]}, {"entity_id": "polar_circle", "book_id": "kosmos_humboldt_1845", "name": "polar circle", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["polar circle"], "contexts": ["arctic region"]}, {"entity_id": "arctic_circle", "book_id": "connexion_physical_sciences_somerville_1858", "name": "arctic circle", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["arctic circle"], "contexts": ["circle of latitude in northern hemisphere", "geographic region with specific temperature characteristics"]}, {"entity_id": "polar_circles", "book_id": "connexion_physical_sciences_somerville_1858", "name": "polar circles", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["polar circles"], "contexts": ["frozen shores with distinct flora"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Polar Circle", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "cercle polaire", "similarity": 0.937}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Polar Circle", "target_book": "kosmos_humboldt_1845", "target_name": "polar circle", "similarity": 0.842}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Polar Circle", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "arctic circle", "similarity": 0.913}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Polar Circle", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "polar circles", "similarity": 0.911}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "cercle polaire", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "arctic circle", "similarity": 0.892}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "cercle polaire", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "polar circles", "similarity": 0.924}, {"source_book": "kosmos_humboldt_1845", "source_name": "polar circle", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "polar circles", "similarity": 0.885}], "id": 469, "stable_key": "clu_878197585ee4a4d7", "ground_truth": {"modern_name": "Arctic Circle", "confidence": "high", "type": "place", "country": "International", "note": "While 'Polar Circle' can refer to both Arctic and Antarctic, the context of migration and latitude suggests the Arctic Circle is the primary referent, especially with 'arctic circle' also present.", "wikidata_id": "Q17013058", "wikidata_description": "international non-profit organization related to Arctic issues based in Reykjavík, Iceland", "wikipedia_url": "https://en.wikipedia.org/wiki/Arctic%20Circle%20%28organization%29", "wikipedia_extract": "Arctic Circle is an organization founded by former President of Iceland Ólafur Ragnar Grímsson, former Alaska Dispatch Publisher Alice Rogoff, former Premier of Greenland Kuupik Kleist and other partners. The organization's mission is to facilitate dialogue among political and business leaders, environmental experts, scientists, indigenous representatives, and other international stakeholders to address issues facing the Arctic as a result of climate change and melting sea ice. The Arctic Circle styles itself as an international organization with a Secretariat based in Reykjavík, Iceland. At his introduction of Arctic Circle organization on April 15, 2013, at the National Press Club in Washington, D.C., Iceland President Ólafur Ragnar Grímsson said that \"the Arctic has suffered from a lack of global awareness and, as a result, a lack of effective governance. In the past, the region did not matter to the world's decision-makers and was largely forgotten. Now, with sea-ice levels at their lowest point in recorded history, the world is waking up to the challenges and opportunities the Arctic presents for its citizens as well as those who live in lower latitudes.\" Participants in Arctic Circle's events since its inaugural Assembly in October 2013 have included institutional and governmental representatives, political and policy leaders, scientists and experts, activists, and indigenous people from the Arctic countries, as well as Asia, Europe, and elsewhere."}, "cross_references": [{"found_name": "Arctic", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 414, "target_cluster_name": "arctic", "source_book": "llm_generated", "evidence_snippet": "The Arctic Circle is a geographical line of latitude located within the broader Arctic region.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Arctic Circle is a geographical line of latitude located within the broader Arctic region."}, {"found_name": "terra", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 709, "target_cluster_name": "terra", "source_book": "llm_generated", "evidence_snippet": "The Arctic Circle is a line of latitude on Earth.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Arctic Circle is a line of latitude on Earth.", "is_reverse": true}, {"found_name": "Polar Sea", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 891, "target_cluster_name": "Polar Sea", "source_book": "llm_generated", "evidence_snippet": "The Arctic Ocean lies north of the Arctic Circle.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Arctic Ocean lies north of the Arctic Circle.", "is_reverse": true}, {"found_name": "tropic of Cancer", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1356, "target_cluster_name": "tropic of Cancer", "source_book": "llm_generated", "evidence_snippet": "The Tropic of Cancer is one of the two major tropical circles of latitude, alongside the Arctic Circle (and Antarctic Circle), which define climate zones.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Tropic of Cancer is one of the two major tropical circles of latitude, alongside the Arctic Circle (and Antarctic Circle), which define climate zones.", "is_reverse": true}, {"found_name": "temperate zone", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2535, "target_cluster_name": "temperate zone", "source_book": "llm_generated", "evidence_snippet": "The Arctic Circle defines the boundary of the Arctic region, and the temperate zone is adjacent to it.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Arctic Circle defines the boundary of the Arctic region, and the temperate zone is adjacent to it.", "is_reverse": true}]}, {"canonical_name": "Laurel", "category": "PLANT", "subcategory": "TREE", "book_count": 8, "total_mentions": 19, "members": [{"entity_id": "laurel", "book_id": "origin_of_species_darwin_1859", "name": "laurel", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["laurel"], "contexts": ["plant with juice excreted at leaf back"]}, {"entity_id": "laurel", "book_id": "kosmos_humboldt_1845", "name": "laurel", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["laurel"], "contexts": ["plant impression, debated interpretation"]}, {"entity_id": "laurel", "book_id": "historia_medicinal_monardes_1574", "name": "Laurel", "category": "PLANT", "subcategory": "TREE", "count": 3, "variants": ["Laurel"], "contexts": ["leaf shape of the Cinnamon tree", "tree whose leaves are similar to Canela"]}, {"entity_id": "laurel", "book_id": "connexion_physical_sciences_somerville_1858", "name": "laurel", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["laurel"], "contexts": ["essential oil with circular polarization"]}, {"entity_id": "laurels", "book_id": "connexion_physical_sciences_somerville_1858", "name": "laurels", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["laurels"], "contexts": ["second vegetation zone on volcano"]}, {"entity_id": "bay-tree", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Bay-tree", "category": "PLANT", "subcategory": "TREE", "count": 1, "variants": ["Bay-tree"], "contexts": ["tree blasted by lightning"]}, {"entity_id": "bay-tree", "book_id": "english_physician_1652", "name": "Bay-Tree", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["Bay-tree", "Bay-Tree"], "contexts": ["herb dedicated to Apollo", "well-known tree with many virtues"]}, {"entity_id": "louro", "book_id": "coloquios_da_orta_1563", "name": "louro", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["louro"], "contexts": ["tree whose leaf color is compared", "tree resembling cinnamon color"]}, {"entity_id": "louro", "book_id": "polyanthea_medicinal", "name": "louro", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["louro"], "contexts": ["laurel, a plant", "laurel"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "laurel", "target_book": "kosmos_humboldt_1845", "target_name": "laurel", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "laurel", "target_book": "historia_medicinal_monardes_1574", "target_name": "Laurel", "similarity": 0.68}, {"source_book": "origin_of_species_darwin_1859", "source_name": "laurel", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "laurel", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "laurel", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "laurels", "similarity": 0.929}, {"source_book": "kosmos_humboldt_1845", "source_name": "laurel", "target_book": "historia_medicinal_monardes_1574", "target_name": "Laurel", "similarity": 0.68}, {"source_book": "kosmos_humboldt_1845", "source_name": "laurel", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "laurel", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "laurel", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "laurels", "similarity": 0.929}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Laurel", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "laurel", "similarity": 0.68}], "id": 470, "stable_key": "clu_7693c400671f9698", "ground_truth": {"modern_name": "Bay Laurel", "confidence": "high", "type": "plant", "linnaean": "Laurus nobilis Linnaeus", "family": "Lauraceae", "wikidata_id": "Q26006", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Laurus_nobilis", "wikipedia_extract": "Laurus nobilis  is an aromatic evergreen tree or large shrub with green, glabrous (smooth) leaves. It is in the flowering plant family Lauraceae. According to  Muer, Jahn, & Sauerbier, the stem can be 1 metre in diameter and the tree can be as high as 20 metres. It is native to the Mediterranean region and is used as bay leaf for seasoning in cooking. Its common names include bay tree (esp. United Kingdom), bay laurel, sweet bay, true laurel, Grecian laurel, or simply laurel.", "note": "The reference to 'Laurel' in Monardes' medicinal history, and its general use in natural philosophy, points strongly to the common laurel (Laurus nobilis). The mention of 'cinnamon tree' leaf shape suggests a comparison or confusion, but the primary referent for 'laurel' remains."}, "member_count": 9, "cross_references": [{"found_name": "Cinnamon", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 44, "target_cluster_name": "Canela", "source_book": "llm_generated", "evidence_snippet": "Both Bay Laurel and Cinnamon are members of the Lauraceae family and are known for their aromatic properties, often used in culinary and medicinal contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both Bay Laurel and Cinnamon are members of the Lauraceae family and are known for their aromatic properties, often used in culinary and medicinal contexts."}, {"found_name": "Myrtle", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_