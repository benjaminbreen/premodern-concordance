ngth": 0.5, "target_cluster_id": 62, "target_cluster_name": "Aristotle", "source_book": "llm_generated", "evidence_snippet": "Theophrastus was Aristotle's student and successor, inheriting and developing his philosophical and scientific work, particularly in botany.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Theophrastus was Aristotle's student and successor, inheriting and developing his philosophical and scientific work, particularly in botany.", "is_reverse": true}, {"found_name": "Albertus Magnus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2461, "target_cluster_name": "Alberto Magno", "source_book": "llm_generated", "evidence_snippet": "Both were influential figures in natural philosophy and science, with Albertus Magnus being a significant medieval scholar whose work influenced later thinkers like Paracelsus.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were influential figures in natural philosophy and science, with Albertus Magnus being a significant medieval scholar whose work influenced later thinkers like Paracelsus."}, {"found_name": "Dioscorides", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 33, "target_cluster_name": "Dioscorides", "source_book": "llm_generated", "evidence_snippet": "Both were highly influential ancient writers on materia medica and botany, whose works were foundational for later medical and herbal traditions.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were highly influential ancient writers on materia medica and botany, whose works were foundational for later medical and herbal traditions."}, {"found_name": "Galen", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 29, "target_cluster_name": "Galen", "source_book": "llm_generated", "evidence_snippet": "Both were central figures in the history of medicine, with Galen's humoral theory dominating Western medicine for centuries, and Paracelsus being a key figure in challenging and attempting to reform that tradition.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were central figures in the history of medicine, with Galen's humoral theory dominating Western medicine for centuries, and Paracelsus being a key figure in challenging and attempting to reform that tradition."}]}, {"canonical_name": "Germany", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 8, "total_mentions": 59, "members": [{"entity_id": "germany", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Germany", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Germany"], "contexts": ["country in Central Europe"]}, {"entity_id": "germany", "book_id": "english_physician_1652", "name": "Germany", "category": "PLACE", "subcategory": "COUNTRY", "count": 2, "variants": ["Germany"], "contexts": ["region of various princes", "country where Tragus observed Orpine's use"]}, {"entity_id": "germany", "book_id": "origin_of_species_darwin_1859", "name": "Germany", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Germany"], "contexts": ["European country"]}, {"entity_id": "germany", "book_id": "principles_of_psychology_james_1890", "name": "Germany", "category": "PLACE", "subcategory": "COUNTRY", "count": 10, "variants": ["Germany"], "contexts": ["country of Herbart's associationism", "country where phosphorus debate occurred"]}, {"entity_id": "germany", "book_id": "kosmos_humboldt_1845", "name": "Germany", "category": "PLACE", "subcategory": "COUNTRY", "count": 15, "variants": ["Germany"], "contexts": ["region Varenius was likely from", "northern region with bright nights in 1831"]}, {"entity_id": "german", "book_id": "origin_of_species_darwin_1859", "name": "German", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["German"], "contexts": ["nationality of author"]}, {"entity_id": "g