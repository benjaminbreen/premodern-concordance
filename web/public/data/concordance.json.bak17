me": "scenery", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "scenery", "book_id": "kosmos_humboldt_1845", "name": "scenery", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["scenery"], "contexts": ["visual appearance of landscape"]}, {"entity_id": "landscapes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Landscapes", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Landscapes"], "contexts": ["scenic views produced by photography"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "scenery", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Landscapes", "similarity": 0.901}], "id": 4411, "stable_key": "clu_e3d44815f3097b35", "ground_truth": {"modern_name": "Scene", "confidence": "high", "type": "concept", "wikidata_id": "Q28431605", "wikidata_description": "species of green algae", "wikipedia_url": "https://en.wikipedia.org/wiki/Scene_(subculture)", "wikipedia_extract": "The scene subculture is a youth subculture that emerged during the early 2000s in the United States from the pre-existing emo subculture. The subculture became popular with adolescents from the mid 2000s to the early 2010s. Members of the scene subculture are referred to as scene kids, trendies, or scenesters. Scene fashion consists of skinny jeans, bright-colored clothing, a signature hairstyle consisting of straight, flat hair with long bangs covering the forehead, and bright-colored hair dye. Music genres associated with the scene subculture include metalcore, crunkcore, deathcore, electronic music, and pop punk. From the mid-2000s to early 2010s, scene fashion gained popularity among teens and the music associated with the subculture achieved commercial success in both the underground and the mainstream."}, "cross_references": []}, {"canonical_name": "radiations of heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "radiations_of_heat", "book_id": "kosmos_humboldt_1845", "name": "radiations of heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["radiations of heat"], "contexts": ["emission of thermal energy"]}, {"entity_id": "rays_of_heat", "book_id": "connexion_physical_sciences_somerville_1858", "name": "rays of heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["rays of heat"], "contexts": ["emitted from substances"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "radiations of heat", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "rays of heat", "similarity": 0.947}], "id": 4412, "stable_key": "clu_ad371d10f8eb2cae", "ground_truth": {"modern_name": "Thermal radiation", "confidence": "high", "type": "concept", "wikidata_id": "Q58469017", "wikidata_description": "scholarly article in Physical Review B, vol. 75 no. 20, May 2007"}, "cross_references": [{"found_name": "Animal heat", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3893, "target_cluster_name": "animal heat", "source_book": "llm_generated", "evidence_snippet": "Historical texts often discussed 'animal heat' in the context of the body's internal processes, which were sometimes linked to or contrasted with external sources of heat and radiation.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Historical texts often discussed 'animal heat' in the context of the body's internal processes, which were sometimes linked to or contrasted with external sources of heat and radiation."}, {"found_name": "Geothermal heat", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1253, "target_cluster_name": "subterraneous fires", "source_book": "llm_generated", "evidence_snippet": "Geothermal heat refers to heat originating from within