Riolanus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Riolanus"], "contexts": ["authority refuting the proverb"]}, {"entity_id": "riolanus", "book_id": "polyanthea_medicinal", "name": "Riolanus", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Riolanus", "Riolano"], "contexts": ["author of medical text", "Riolanus,Partic. Method.Medic."]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Riolanus", "target_book": "polyanthea_medicinal", "target_name": "Riolanus", "similarity": 0.659}], "id": 2947, "stable_key": "clu_aa5d5ed3428bec7b", "ground_truth": {"modern_name": "Jean Riolan the Younger", "confidence": "high", "type": "person", "birth_year": 1580, "death_year": 1657, "description": "French anatomist and physician, critic of Harvey", "wikidata_id": "Q3174345", "wikidata_description": "French physician (1539-1605)"}, "cross_references": [{"found_name": "Langius", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2091, "target_cluster_name": "Langius", "source_book": "llm_generated", "evidence_snippet": "Jean Riolan the Younger was the son of Jean Riolan and also a prominent anatomist and physician, continuing his father's work and legacy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Jean Riolan the Younger was the son of Jean Riolan and also a prominent anatomist and physician, continuing his father's work and legacy.", "is_reverse": true}]}, {"canonical_name": "camel", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "camel", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Camel", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Camel"], "contexts": ["mammal used for comparison of lifespan"]}, {"entity_id": "camel", "book_id": "origin_of_species_darwin_1859", "name": "camel", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 3, "variants": ["camel"], "contexts": ["domesticated camelid species", "large desert mammal"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Camel", "target_book": "origin_of_species_darwin_1859", "target_name": "camel", "similarity": 0.814}], "id": 2948, "stable_key": "clu_cd5336fbdb117b1a", "ground_truth": {"modern_name": "Camel", "confidence": "high", "type": "animal", "wikidata_id": "Q7375", "wikidata_description": "genus of mammals", "wikipedia_url": "https://en.wikipedia.org/wiki/Camel", "wikipedia_extract": "A camel (from Latin: camelus and Ancient Greek: κάμηλος (kamēlos) from Ancient Semitic: gāmāl) is an even-toed ungulate in the genus Camelus that bears distinctive fatty deposits known as \"humps\" on its back. Camels have long been domesticated and, as livestock, they provide food (camel milk and meat) and textiles (fiber and felt from camel hair). Camels are working animals especially suited to their desert habitat and are a vital means of transport for passengers and cargo. There are three surviving species of camel. The one-humped dromedary makes up 94% of the world's camel population, and the two-humped Bactrian camel makes up 6%. The wild Bactrian camel is a distinct species that is not ancestral to the domestic Bactrian camel, and is now critically endangered, with fewer than 1,000 individuals."}, "cross_references": [{"found_name": "mammal", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2279, "target_cluster_name": "mammal", "source_book": "llm_generated", "evidence_snippet": "Camels are a type of mammal.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Camels are a type of mammal.", "is_reverse": true}]}, {"canonical_name": "Saxifrage", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "saxifrage", "book_id": "english_physician_1652", "name": "Saxifrage", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Saxifrage", "Saxifrages"], "contexts": ["root used in Tragus's medicine", "herb with roots, leaves, flowers, and seed"]}, {"entity_id": "saxifrages", "book_id": "kosmos_humboldt_1845", "name": "saxifrages", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["saxifrages"], "contexts": ["plant in a specific botanical region"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Saxifrage", "target_book": "kosmos_humboldt_1845", "target_name": "saxifrages", "similarity": 0.882}], "id": 2949, "stable_key": "clu_dbd6420b90928888", "ground_truth": {"modern_name": "Saxifrage", "confidence": "high", "type": "plant", "linnaean": "Saxifraga", "family": "Saxifragaceae", "wikidata_id": "Q156146", "wikidata_description": "genus of plants in the saxifrage family (Saxifragaceae)", "wikipedia_url": "https://en.wikipedia.org/wiki/Saxifraga", "wikipedia_extract": "Saxifraga is the largest genus in the family Saxifragaceae, containing about 473 species of holarctic perennial plants, known as saxifrages or rockfoils. The Latin word saxifraga means literally \"stone-breaker\", from Latin saxum (\"rock\" or \"stone\") + frangere (\"to break\"). It is usually thought to indicate a medicinal use for treatment of urinary calculi (known as kidney or bladder stones), rather than breaking rocks apart. Most saxifrages are small perennial, biennial (e.g., S. adscendens) or annual (e.g., S. tridactylites) herbaceous plants whose basal or cauline leaves grow close to the ground, often in a rosette."}, "cross_references": []}, {"canonical_name": "Diarhodon Abhatis", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "diarhodon_abhatis", "book_id": "english_physician_1652", "name": "Diarhodon Abhatis", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 3, "variants": ["Diarhodon Abhatis", "Diarhodon Abbatis", "Diar