TOMY", "count": 10, "variants": ["mãos"], "contexts": ["hands", "body part"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "hand", "target_book": "principles_of_psychology_james_1890", "target_name": "hand", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "hand", "target_book": "kosmos_humboldt_1845", "target_name": "hand", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "hand", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "hand", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "hand", "target_book": "first_principles_spencer_1862", "target_name": "hand", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "hand", "target_book": "kosmos_humboldt_1845", "target_name": "hand", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "hand", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "hand", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "hand", "target_book": "first_principles_spencer_1862", "target_name": "hand", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "hand", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "hand", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "hand", "target_book": "first_principles_spencer_1862", "target_name": "hand", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "hand", "target_book": "first_principles_spencer_1862", "target_name": "hand", "similarity": 1.0}], "id": 76, "stable_key": "clu_9d808ce3e5b48430", "ground_truth": {"modern_name": "Hand", "confidence": "high", "type": "object", "wikidata_id": "Q8418", "wikidata_description": "team sport played with a thrown ball and goals", "wikipedia_url": "https://en.wikipedia.org/wiki/Handball", "note": "Referred to as a 'SUBSTANCE' but anatomically it functions as a body part/concept.", "wikipedia_extract": "Handball (also known as team handball, European handball, Olympic handball, or indoor handball) is a team sport in which two teams of seven players each (six outcourt players and a goalkeeper) pass a ball using their hands with the aim of throwing it into the goal of the opposing team. A standard match consists of two periods of 30 minutes, and the team that scores more goals wins. Modern handball is played on a court of 40 by 20 metres (131 by 66 ft), with a goal in the middle of each end. The goals are surrounded by a 6-metre (20 ft) zone where only the defending goalkeeper is allowed; goals must be scored by throwing the ball from outside the zone or while \"diving\" into it. The sport is usually played indoors, but outdoor variants exist in the forms of field handball, Czech handball (which were more common in the past) and beach handball. The game is fast and high-scoring: professional teams now typically score between 20 and 35 goals each, though lower scores were not uncommon until a few decades ago."}, "member_count": 9, "cross_references": [{"found_name": "Arm", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 140, "target_cluster_name": "arm", "source_book": "llm_generated", "evidence_snippet": "The 'Hand' is a body part, and the 'Arm' is another closely associated body part, often discussed together in anatomical contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The 'Hand' is a body part, and the 'Arm' is another closely associated body part, often discussed together in anatomical contexts."}, {"found_name": "Forelimbs", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1317, "target_cluster_name": "fore-legs", "source_book": "llm_generated", "evidence_snippet": "The 'Hand' is the terminal part of the '