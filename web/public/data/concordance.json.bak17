ifíco", "book_id": "coloquios_da_orta_1563", "name": "scepticismo scientifíco", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["scepticismo scientifíco"], "contexts": ["scientific skepticism"]}, {"entity_id": "sceptic", "book_id": "first_principles_spencer_1862", "name": "sceptic", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["sceptic"], "contexts": ["philosophical position doubting knowledge"]}, {"entity_id": "scepticism", "book_id": "first_principles_spencer_1862", "name": "scepticism", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["scepticism"], "contexts": ["philosophical stance of doubt"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Scepticism", "target_book": "principles_of_psychology_james_1890", "target_name": "sceptic", "similarity": 0.908}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Scepticism", "target_book": "coloquios_da_orta_1563", "target_name": "scepticismo scientifíco", "similarity": 0.914}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Scepticism", "target_book": "first_principles_spencer_1862", "target_name": "sceptic", "similarity": 0.908}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Scepticism", "target_book": "first_principles_spencer_1862", "target_name": "scepticism", "similarity": 0.965}, {"source_book": "principles_of_psychology_james_1890", "source_name": "sceptic", "target_book": "first_principles_spencer_1862", "target_name": "sceptic", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "sceptic", "target_book": "first_principles_spencer_1862", "target_name": "scepticism", "similarity": 0.929}, {"source_book": "coloquios_da_orta_1563", "source_name": "scepticismo scientifíco", "target_book": "first_principles_spencer_1862", "target_name": "scepticism", "similarity": 0.928}], "id": 479, "stable_key": "clu_292ef8b16c2e68f1", "ground_truth": {"modern_name": "Skepticism", "confidence": "high", "type": "concept", "wikidata_id": "Q1395219", "wikidata_description": "questioning attitude or doubt toward knowledge claims that are seen as mere belief or dogma", "wikipedia_url": "https://en.wikipedia.org/wiki/Skepticism", "wikipedia_extract": "Skepticism (US) or scepticism (UK) is a questioning attitude or doubt toward knowledge claims that are seen as mere belief or dogma. For example, if a person is skeptical about claims made by their government about an ongoing war then the person doubts that these claims are accurate. In such cases, skeptics normally recommend not disbelief but suspension of belief, i.e. maintaining a neutral attitude that neither affirms nor denies the claim. This attitude is often motivated by the impression that the available evidence is insufficient to support the claim. Formally, skepticism is a topic of interest in philosophy, particularly epistemology."}, "cross_references": [{"found_name": "Belief", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2125, "target_cluster_name": "belief", "source_book": "llm_generated", "evidence_snippet": "Skepticism is defined as a questioning attitude or doubt toward knowledge claims that are seen as mere belief or dogma.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Skepticism is defined as a questioning attitude or doubt toward knowledge claims that are seen as mere belief or dogma."}]}, {"canonical_name": "Archimedes", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 4, "total_mentions": 6, "members": [{"entity_id": "archimedes", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Archimedes", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Archimedes"], "contexts": ["ancient mathematician, discovered pi ratio", "ancient mathematician, undertook large tasks"]}, {"entity_id": "archimède", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Archimède", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Archimède"], "contexts": ["ancient mathematician/inventor"]}, {"entity_id": "archimedes", "book_id": "principles_of_psychology_james_1890", "name": "Archimedes", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Archimedes"], "contexts": ["mathematician absorbed in geometrical meditation"]}, {"entity_id": "archimedes", "book_id": "first_principles_spencer_1862", "name": "Archimedes", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Archimedes"], "contexts": ["ancient Greek mathematician and physicist"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Archimedes", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Archimède", "similarity": 0.841}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Archimedes", "target_book": "principles_of_psychology_james_1890", "target_name": "Archimedes", "similarity": 0.799}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Archimedes", "target_book": "first_principles_spencer_1862", "target_name": "Archimedes", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Archimède", "target_book": "first_principles_spencer_1862", "target_name": "Archimedes", "similarity": 0.841}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Archimedes", "target_book": "first_principles_spencer_1862", "target_name": "Archimedes", "similarity": 0.799}], "id": 480, "stable_key": "clu_cf5d3c488604cc99", "ground_truth": {"modern_name": "Archimedes", "confidence": "high", "type": "person", "birth_year": -287, "death_year": -212, "description": "Ancient Greek mathematician, physicist, engineer, inventor, and astronomer.", "wikidata_id": "Q776475", "wikidata_description": "genus of bryozoans (fossil)", "wikipedia_url": "https://en.wikipedia.org/wiki/Archimedes%20%28bryozoan%29", "wikipedia_extract": "Archimedes is a genus of bryozoans belonging to the family Fenestellidae. The first use of the term \"Archimedes\" in relation to this genus was in 1838. This genus of bryozoans is named Archimedes because of its corkscrew shape, in analogy to the Archimedes' screw, a type of water pump which inspired modern ship propellers in turn named after the ancient greek polymath. These forms are common as fossils but they have been extinct since the Permian. Archimedes orientalis Schulga-Nesterenko 1936 Archimedes stuckenbergi Nikiforova 1938 These bryozoans lived from the Carboniferous period (Tournaisian age) to the Permian period (Leonard age) (345.3 to 268.0 Ma), when this genus became extinct. Archimedes is a genus of fenestrate bryozoans with a calcified skeleton of a delicate spiral-shaped mesh that was thickened near the axis into a massive corkscrew-shaped central structure."}, "cross_references": [{"found_name": "Gauss", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1176, "target_cluster_name": "Gauss", "source_book": "llm_generated", "evidence_snippet": "Both Archimedes and Gauss are considered among the greatest mathematicians of all time. Gauss's rigorous approach and breadth of mathematical contributions are often compared to the foundational work of Archimedes in geometry and mechanics.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both Archimedes and Gauss are considered among the greatest mathematicians of all time. Gauss's rigorous approach and breadth of mathematical contributions are often compared to the foundational work of Archimedes in geometry and mechanics.", "is_reverse": true}, {"found_name": "Newton", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 71, "target_cluster_name": "Newton", "source_book": "llm_generated", "evidence_snippet": "Newton's work on calculus and mechanics owes a significant intellectual debt to the foundational mathematical and physical principles established by Archimedes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Newton's work on calculus and mechanics owes a significant intellectual debt to the foundational mathematical and physical principles established by Archimedes.", "is_reverse": true}, {"found_name": "Pythagoras", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 354, "target_cluster_name": "Pythagoras", "source_book": "llm_generated", "evidence_snippet": "Both are prominent figures in ancient Greek mathematics and science.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both are prominent figures in ancient Greek mathematics and science.", "is_reverse": true}, {"found_name": "philosopher", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 431, "target_cluster_name": "philosopher", "source_book": "llm_generated", "evidence_snippet": "Archimedes was a Greek mathematician, physicist, engineer, inventor, and astronomer, often considered a philosopher due to his foundational work in logic and scientific reasoning.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Archimedes was a Greek mathematician, physicist, engineer, inventor, and astronomer, often considered a philosopher due to his foundational work in logic and scientific reasoning.", "is_reverse": true}, {"found_name": "Cardano", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 679, "target_cluster_name": "Cardano", "source_book": "llm_generated", "evidence_snippet": "Both were renowned mathematicians and inventors, with Archimedes being a foundational figure in ancient Greek mathematics and Cardano a significant figure in Renaissance mathematics.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were renowned mathematicians and inventors, with Archimedes being a foundational figure in ancient Greek mathematics and Cardano a significant figure in Renaissance mathematics.", "is_reverse": true}, {"found_name": "physiciens", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 692, "target_cluster_name": "physiciens", "source_book": "llm_generated", "evidence_snippet": "Archimedes was an ancient Greek mathematician, physicist, engineer, inventor, and astronomer, considered one of the leading scientists of classical antiquity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Archimedes was an ancient Greek mathematician, physicist, engineer, inventor, and astronomer, considered one of the leading scientists of classical antiquity.", "is_reverse": true}, {"found_name": "Galileo", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 931, "target_cluster_name": "Galileo", "source_book": "llm_generated", "evidence_snippet": "Archimedes was a pioneering ancient Greek mathematician and inventor whose work on mechanics, hydrostatics, and geometry influenced later thinkers, including Galileo, who admired and studied his methods.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Archimedes was a pioneering ancient Greek mathematician and inventor whose work on mechanics, hydrostatics, and geometry influenced later thinkers, including Galileo, who admired and studied his methods.", "is_reverse": true}, {"found_name": "Eratosthenes", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1129, "target_cluster_name": "Eratosthenes", "source_book": "llm_generated", "evidence_snippet": "Both were prominent ancient Greek mathematicians and scientists, known for their contributions to geometry and physics.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were prominent ancient Greek mathematicians and scientists, known