nk_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2821, "target_cluster_name": "Dublin", "source_book": "llm_generated", "evidence_snippet": "Dublin is the capital city of Ireland.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Dublin is the capital city of Ireland.", "is_reverse": true}]}, {"canonical_name": "horse", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 5, "total_mentions": 24, "members": [{"entity_id": "horse", "book_id": "origin_of_species_darwin_1859", "name": "horse", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 13, "variants": ["Horse", "horse"], "contexts": ["animal with spinal stripe and leg bars", "animal used in mule hybrid"]}, {"entity_id": "horse", "book_id": "principles_of_psychology_james_1890", "name": "horse", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 7, "variants": ["horse"], "contexts": ["animal used for comparison", "animal symbol"]}, {"entity_id": "horse", "book_id": "kosmos_humboldt_1845", "name": "horse", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["horse"], "contexts": ["extant animal found as fossil"]}, {"entity_id": "horse", "book_id": "connexion_physical_sciences_somerville_1858", "name": "horse", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["horse"], "contexts": ["animal used as a source of power", "example of a labouring force"]}, {"entity_id": "horse", "book_id": "first_principles_spencer_1862", "name": "horse", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["horse"], "contexts": ["animal providing force for plough"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "horse", "target_book": "principles_of_psychology_james_1890", "target_name": "horse", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "horse", "target_book": "kosmos_humboldt_1845", "target_name": "horse", "similarity": 1.0}, 