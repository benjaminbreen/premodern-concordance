ester"], "contexts": ["city with establishments"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Worcester", "target_book": "first_principles_spencer_1862", "target_name": "Worcester", "similarity": 1.0}], "id": 4058, "stable_key": "clu_2ea25941f921ca45", "ground_truth": {"modern_name": "Worcester", "confidence": "high", "type": "place", "country": "United Kingdom", "note": "Contexts mention both UK and US locations, but \"Worcestershire\" points to UK. Primary context is likely UK.", "wikidata_id": "Q1646181", "wikidata_description": "city and the county town of Worcestershire, England", "wikipedia_url": "https://en.wikipedia.org/wiki/Worcester,_Massachusetts", "wikipedia_extract": "Worcester (  WUUST-ər, locally [ˈwɪstə] ) is a city in the U.S. state of Massachusetts. The principal city of Central Massachusetts, Worcester is both the second-most populous city in the state, and the 113th most populous city in the United States. Named after Worcester, England, the city had 206,518 people at the 2020 census, also making it the second-most populous city in New England, after Boston. Because it is near the geographic center of Massachusetts, Worcester is known as the \"Heart of the Commonwealth\"; a heart is the official symbol of the city. Worcester is the historical seat of Worcester County."}, "cross_references": []}, {"canonical_name": "îles de la Mer du Sud", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 2, "members": [{"entity_id": "îles_de_la_mer_du_sud", "book_id": "relation_historique_humboldt_vol3_1825", "name": "îles de la Mer du Sud", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["îles de la Mer du Sud"], "contexts": ["islands in the South Pacific"]}, {"entity_id": "south_sea_islands", "book_id": "connexion_physical_sciences_somerville_1858", "name": "South Sea islands", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["So