e": "Lirio", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "lirio", "book_id": "historia_medicinal_monardes_1574", "name": "Lirio", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Lirio"], "contexts": ["herb mentioned in remedies", "plant whose leaf Gengibre resembles"]}, {"entity_id": "lirio", "book_id": "polyanthea_medicinal", "name": "Lirio", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Lirio", "lirio"], "contexts": ["lily", "plant name"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Lirio", "target_book": "polyanthea_medicinal", "target_name": "Lirio", "similarity": 1.0}], "id": 2857, "stable_key": "clu_c9059188fd372bb2", "ground_truth": {"modern_name": "Lily", "confidence": "high", "type": "plant", "linnaean": "Lilium", "family": "Liliaceae", "note": "The specific species of 'Lirio' is not identified.", "wikidata_id": "Q5194627", "wikidata_description": "genus of plants"}, "cross_references": [{"found_name": "hyacinth", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3961, "target_cluster_name": "hyacinth", "source_book": "llm_generated", "evidence_snippet": "Both are bulbous flowering plants often mentioned in similar contexts regarding gardens and medicinal uses.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are bulbous flowering plants often mentioned in similar contexts regarding gardens and medicinal uses."}, {"found_name": "sword lily root", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2076, "target_cluster_name": "espadana", "source_book": "llm_generated", "evidence_snippet": "Sword lily root (espadana) is a specific part of a plant that shares the common name 'lily' and is likely related botanically or in historical usage.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Sword lily root (espadana) is a specific part of a plant that shares the common name 'lily' and is likely related botanically or in historical usage."}, {"found_name": "Peony", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 518, "target_cluster_name": "Peony", "source_book": "llm_generated", "evidence_snippet": "Both are flowering plants with historical medicinal associations, often grouped together in herbal texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are flowering plants with historical medicinal associations, often grouped together in herbal texts."}]}, {"canonical_name": "cholericas", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "cholericas", "book_id": "historia_medicinal_monardes_1574", "name": "cholericas", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["cholericas"], "contexts": ["choleric humors", "related to choler or yellow bile"]}, {"entity_id": "cholerico", "book_id": "historia_medicinal_monardes_1574", "name": "cholerico", "category": "CONCEPT", "subcategory": "THEORY", "count": 1, "variants": ["cholerico"], "contexts": ["patient with choleric temperament"]}, {"entity_id": "choleric", "book_id": "polyanthea_medicinal", "name": "choleric", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["choleric", "choler"], "contexts": ["quality related to bile", "humor to be purged"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "cholericas", "target_book": "polyanthea_medicinal", "target_name": "choleric", "similarity": 0.969}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "cholerico", "target_book": "polyanthea_medicinal", "target_name": "choleric", "similarity": 0.989}], "id": 2858, "stable_key": "clu_91ffaf66c0d25224", "ground_truth": {"modern_name": "Choleric", "confidence": "high", "type": "concept", "description": "Relating to the humor of yellow bile; hot-tempered.", "note": "Refers to a humor in the humoral theory of medicine.", "wikipedia_extract": "The four temperament theory is a proto-psychological theory which suggests that there are four fundamental personality types: sanguine, choleric, melancholic, and phlegmatic. Most formulations include the possibility of mixtures among the types where an individual's personality types overlap and they share two or more temperaments. Greek physician Hippocrates (c. 460 – c. 370 BC) described the four temperaments as part of the ancient medical concept of humourism, that four bodily fluids affect human personality traits and behaviours. Modern medical science does not define a fixed relationship between internal secretions and personality, although some psychological personality type systems use categories similar to the Greek temperaments. The four temperament theory was abandoned after the 1850s. Temperament theory has its roots in the ancient theory of humourism."}, "cross_references": [{"found_name": "Melancolicos", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1826, "target_cluster_name": "Melancolicos", "source_book": "llm_generated", "evidence_snippet": "While distinct, choleric and melancholic temperaments were both part of the humoral system and represented different imbalances of humors (yellow bile vs. black bile).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: While distinct, choleric and melancholic temperaments were both part of the humoral system and represented different imbalances of humors (yellow bile vs. black bile).", "is_reverse": true}, {"found_name": "melancholic", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1765, "target_cluster_name": "melancholicos", "source_book": "llm_generated", "evidence_snippet": "Choleric is one of the four humors/temperaments, alongside melancholic, sanguine, and phlegmatic.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Choleric is one of the four humors/temperaments, alongside melancholic, sanguine, and phlegmatic."}, {"found_name": "humoral theory", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 64, "target_cluster_name": "humoral theory", "source_book": "llm_generated", "evidence_snippet": "The choleric temperament is a key component of humoral theory.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The choleric temperament is a key component of humoral theory."}, {"found_name": "hot temperament", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 351, "target_cluster_name": "temperamento quente", "source_book": "llm_generated", "evidence_snippet": "The choleric temperament is associated with the quality of heat.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The choleric temperament is associated with the quality of heat."}]}, {"canonical_name": "Babilónia", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "babilonía", "book_id": "historia_medicinal_monardes_1574", "name": "Babilonía", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Babilonía"], "contexts": ["ancient city"]}, {"entity_id": "babilónia", "book_id": "coloquios_da_orta_1563", "name": "Babilónia", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Babilónia", "babilónico"], "contexts": ["anciently named city", "possible origin of substance"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Babilonía", "target_book": "coloquios_da_orta_1563", "target_name": "Babilónia", "similarity": 0.647}], "id": 2859, "stable_key": "clu_5f7750a5886103b9", "ground_truth": {"modern_name": "Babylon", "confidence": "high", "type": "place", "description": "An ancient Mesopotamian city, historically significant.", "note": "'Babilónia' is the Portuguese spelling for Babylon.", "wikipedia_extract": "Babylon ( BAB-il-on) was an ancient city located on the lower Euphrates river in southern Mesopotamia, within modern-day Hillah, Iraq, about 85 kilometres (53 miles) south of modern-day Baghdad. Babylon functioned as the main cultural and political centre of the Akkadian-speaking region of Babylonia. Its rulers established two important empires in antiquity, the 19th–16th century BC Old Babylonian Empire, and the 7th–6th century BC Neo-Babylonian Empire. Babylon was also used as a regional capital of other empires, such as the Achaemenid Empire. Babylon was one of the most important urban centres of the ancient Near East, until its decline during the Hellenistic period. Nearby ancient sites are Kish, Borsippa, Dilbat, and Kutha."}, "cross_references": []}, {"canonical_name": "morbo napolitano", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "mal_napolitano", "book_id": "historia_medicinal_monardes_1574", "name": "mal Napolitano", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["mal Napolitano"], "contexts": ["name for the disease"]}, {"entity_id": "morbo_napolitano", "book_id": "coloquios_da_orta_1563", "name": "morbo napolitano", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 4, "variants": ["morbo napolitano"], "contexts": ["syphilis, also called sarna de Castella", "disease named after Naples"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "mal Napolitano", "target_book": "coloquios_da_orta_1563", "target_name": "morbo napolitano", "similarity": 0.887}], "id": 2860, "stable_key": "clu_2a17ee6d259c2d61", "ground_truth": {"modern_name": "syphilis", "confidence": "high", "type": "disease", "description": "A sexually transmitted infection caused by the bacterium Treponema pallidum.", "note": "Also known as the 'Neapolitan disease' or 'morbo napolitano'.", "wikipedia_extract": "Syphilis () is a sexually transmitted infection caused by the bacterium Treponema pallidum subspecies pallidum. The signs and symptoms depend on the stage it presents: primary, secondary, latent or tertiary. The primary stage classically presents with a single chancre (a firm, painless, non-itchy skin ulceration usually between 1 cm and 2 cm in diameter), though there may be multiple sores. In secondary syphilis, a diffuse rash occurs, which frequently involves the palms of the hands and soles of the feet. There may also be sores in the mouth or vagina. Latent syphilis has no symptoms and can last years."}, "cross_references": [{"found_name": "mala Franc^os", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2174, "target_cluster_name": "mala Franc^os", "source_book": "llm_generated", "evidence_snippet": "This is listed as a historical name for syphilis in the provided candidate list.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "This is listed as a historical name for syphilis in the provided candidate list."}, {"found_name": "gallico", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1689, "target_cluster_name": "gallico", "source_book": "llm_generated", "evidence_snippet": "This is listed as a historical name for syphilis in the provided candidate list.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "This is listed as a historical name for syphilis in the provided candidate list."}, {"found_name": "Buboes", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1751, "target_cluster_name": "Bubões", "source_book": "llm_generated", "evidence_snippet": "Buboes are a characteristic symptom of bubonic plague, and historically, syphilis could present with swollen lymph nodes that might be confused with or described similarly to buboes, especially in early stages or in differential diagnoses.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Buboes are a characteristic symptom of bubonic plague, and historically, syphilis could present with swollen lymph nodes that might be confused with or described similarly to buboes, especially in early stages or in differential diagnoses."}, {"found_name": "Chancroid", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1652, "target_cluster_name": "alporcas", "source_book": "llm_generated", "evidence_snippet": "Chancroid is a sexually transmitted infection that can present with genital ulcers, similar to the primary lesion of syphilis (chancre). Historically, differentiating between these conditions could be challenging.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Chancroid is a sexually transmitted infection that can present with genital ulcers, similar to the primary lesion of syphilis (chancre). Historically, differentiating between these conditions could be challenging."}, {"found_name": "Gonorrhea", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 660, "target_cluster_name": "Gonorrheas", "source_book": "llm_generated", "evidence_snippet": "Both syphilis and gonorrhea are sexually transmitted infections that were prevalent and often discussed together in premodern medical texts. They share modes of transmission and could co-occur.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both syphilis and gonorrhea are sexually transmitted infections that were prevalent and often discussed together in premodern medical texts. They share modes of transmission and could co-occur."}, {"found_name": "Ulcers", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3702, "target_cluster_name": "ulceras", "source_book": "llm_generated", "evidence_snippet": "Syphilis, particularly in its primary and secondary stages, is characterized by the formation of ulcers (chancre, condylomata lata). Therefore, 'ulcers' is a directly related pathological manifestation.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Syphilis, particularly in its primary and secondary stages, is characterized by the formation of ulcers (chancre, condylomata lata). Therefore, 'ulcers' is a directly related pathological manifestation."}]}, {"canonical_name": "dores de rins", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "dolores_de_riñones", "book_id": "historia_medicinal_monardes_1574", "name": "dolores de riñones", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["dolores de riñones"], "contexts": ["kidney pains"]}, {"entity_id": "dores_de_rins", "book_id": "polyanthea_medicinal", "name": "dores de rins", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 4, "variants": ["dores de rins", "dor de rins", "dores dos rins"], "contexts": ["pain in kidneys", "kidney pains requiring aid"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "dolores de riñones", "target_book": "polyanthea_medicinal", "target_name": "dores de rins", "similarity": 0.881}], "id": 2861, "stable_key": "clu_4f259bcf1bfc1bce", "ground_truth": {"modern_name": "kidney pain", "confidence": "high", "type": "disease", "description": "Pain or discomfort located in the region of the kidneys.", "wikipedia_extract": "Kidney failure, also known as renal failure or end-stage renal disease (ESRD), is a medical condition in which the kidneys can no longer adequately filter waste products from the blood, functioning at less than 15% of normal levels. Kidney failure is classified as either acute kidney failure, which develops rapidly and may resolve; and chronic kidney failure, which develops slowly and can often be irreversible. Symptoms may include leg swelling, feeling tired, vomiting, loss of appetite, and confusion. Complications of acute and chronic failure include uremia, hyperkalemia, and volume overload. Complications of chronic failure also include heart disease, high blood pressure, and anaemia. Causes of acute kidney failure include low blood pressure, blockage of the urinary tract, certain medications, muscle breakdown, and hemolytic uremic syndrome."}, "cross_references": [{"found_name": "Pain", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 70, "target_cluster_name": "pain", "source_book": "llm_generated", "evidence_snippet": "Kidney pain is a specific type of pain.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Kidney pain is a specific type of pain."}]}, {"canonical_name": "papa", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 8, "members": [{"entity_id": "papa", "book_id": "coloquios_da_orta_1563", "name": "papa", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 4, "variants": ["papa", "Papa"], "contexts": ["head of the Catholic Church", "Pope who sent his guard"]}, {"entity_id": "padre", "book_id": "polyanthea_medicinal", "name": "Padre", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Padre"], "contexts": ["took snake broths"]}, {"entity_id": "pontificem", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Pontificem", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Pontificem"], "contexts": ["Pope"]}, {"entity_id": "pontifice", "book_id": "polyanthea_medicinal", "name": "Pontifice", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["Pontifice", "Pontifices"], "contexts": ["title of a father of a patient", "pontiffs"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "papa", "target_book": "polyanthea_medicinal", "target_name": "Padre", "similarity": 0.85}], "id": 2862, "stable_key": "clu_f2a4cda7ebb6fc97", "ground_truth": {"modern_name": "Pope", "confidence": "high", "type": "person", "description": "Head of the Catholic Church, associated with folk remedies", "wikidata_id": "Q25382", "wikidata_description": "species of bird", "wikipedia_url": "https://en.wikipedia.org/wiki/Eurasian%20bullfinch", "note": "The term 'Pontifice' (and its variations) could refer to the Pope or be used metaphorically for a paternal figure. Context is key.", "wikipedia_extract": "The Eurasian bullfinch, common bullfinch or bullfinch (Pyrrhula pyrrhula) is a small passerine bird in the finch family, Fringillidae. In Anglophone Europe it is known simply as the bullfinch (English regional, Shropshire: plum bird), as it is the original bird to bear the name bullfinch. The Eurasian bullfinch was formally described in 1758 by Linnaeus in the 10th edition of his Systema Naturae under the binomial name Loxia pyrrhula. It is now placed in the genus Pyrrhula that was introduced in 1760 by the French zoologist Mathurin Jacques Brisson. The Latin word pyrrhula comes from the Greek πυρρός (a flame-coloured bird, from πυρρός 'flame-coloured', from πυρ 'fire': Pyrrha), a 'worm eating bird' that is mentioned by Aristotle. The Latin name pyrrhula for the Eurasian bullfinch had been used in 1555 by the Swiss naturalist Conrad Gessner in his Historiae animalium."}, "member_count": 4, "cross_references": [{"found_name": "Sepúlveda", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1959, "target_cluster_name": "Sepúlveda", "source_book": "llm_generated", "evidence_snippet": "Sepúlveda's theological writings and his involvement in debates concerning the Spanish conquest of the Americas had significant implications for papal authority and policy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Sepúlveda's theological writings and his involvement in debates concerning the Spanish conquest of the Americas had significant implications for papal authority and policy.", "is_reverse": true}, {"found_name": "Major", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2522, "target_cluster_name": "Major", "source_book": "llm_generated", "evidence_snippet": "Both the Lord Mayor and the Pope are historically significant figures of authority, with the Lord Mayor holding civic power and the Pope holding religious and often temporal power.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both the Lord Mayor and the Pope are historically significant figures of authority, with the Lord Mayor holding civic power and the Pope holding religious and often temporal power.", "is_reverse": true}]}, {"canonical_name": "cauſa fria", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "cauſa_fría", "book_id": "historia_medicinal_monardes_1574", "name": "cauſa fría", "category": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["cauſa fría"], "contexts": ["cold cause of ailments"]}, {"entity_id": "cauſa_fria", "book_id": "polyanthea_medicinal", "name": "cauſa fria", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["cauſa fria"], "contexts": ["cold cause", "cold cause, a concept in humoral theory"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "cauſa fría", "target_book": "polyanthea_medicinal", "target_name": "cauſa fria", "similarity": 0.967}], "id": 2863, "stable_key": "clu_531dd9edf4f94e53", "ground_truth": {"modern_name": "Cold causation", "confidence": "high", "type": "concept"}, "cross_references": [{"found_name": "Humoral theory", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 64, "target_cluster_name": "humoral theory", "source_book": "llm_generated", "evidence_snippet": "Cold causation is a core concept within the humoral theory, which explained bodily functions and diseases based on the balance of humors.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Cold causation is a core concept within the humoral theory, which explained bodily functions and diseases based on the balance of humors."}]}, {"canonical_name": "Hiera", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "hiera", "book_id": "historia_medicinal_monardes_1574", "name": "Hiera", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["Hiera"], "contexts": ["herb used in medicine"]}, {"entity_id": "hiera", "book_id": "ricettario_fiorentino_1597", "name": "Hiera", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 4, "variants": ["Hiera", "Hiera picra", "Hierapicra"], "contexts": ["compound medicine name", "preparation for pills"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Hiera", "target_book": "ricettario_fiorentino_1597", "target_name": "Hiera", "similarity": 0.727}], "id": 2864, "stable_key": "clu_98cc8a3a22684b1e", "ground_truth": {"modern_name": "Hierapicra", "confidence": "high", "type": "substance", "description": "A historical medicinal compound, often a purgative.", "note": "Also known as Hiera Picra or Hiera.", "wikipedia_extract": "Centaurea () is a genus of over 700 species of herbaceous thistle-like flowering plants in the family Asteraceae. Members of the genus are found only north of the equator, mostly in the Eastern Hemisphere; the Middle East and surrounding regions are particularly species-rich. Common names for this genus are centaury, centory, starthistles, knapweeds, centaureas and the more ambiguous bluets; a vernacular name used for these plants in parts of England is loggerheads (common knapweed). The Plectocephalus group – possibly a distinct genus – is known as basketflowers. Cornflower is used for a few species, but that term more often specifically means either C. cyanus (the annual cornflower) or Centaurea montana (the perennial cornflower). The common name centaury is sometimes used, although this also refers to the unrelated plant genus Centaurium."}, "cross_references": [{"found_name": "Ila, •apicra", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "Ila, •apicra j^xv. rol , , |^an.3tiu^. an.j.v Fa|>illolc, PAPvTE PILLOLE DE LAPI- 1 g2.Tr Apis Armeno' y y lauato Spezie di hiera picra Polipodio , Epthymo \\ ^Scamonea preparata 3 .lii, Gherofani 3,11", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym of"}]}, {"canonical_name": "gordas", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "engorda", "book_id": "historia_medicinal_monardes_1574", "name": "engorda", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["engorda"], "contexts": ["fattening"]}, {"entity_id": "gordas", "book_id": "polyanthea_medicinal", "name": "gordas", "category": "CONCEPT", "subcategory": "QUALITY", "count": 4, "variants": ["gordas", "gordo", "gordos"], "contexts": ["fatty, quality of food", "as coufas gordas"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "engorda", "target_book": "polyanthea_medicinal", "target_name": "gordas", "similarity": 0.887}], "id": 2865, "stable_key": "clu_91a9203eaa913d3a", "ground_truth": {"modern_name": "Fatty", "confidence": "high", "type": "concept"}, "cross_references": [{"found_name": "Appetite", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2030, "target_cluster_name": "Appetite", "source_book": "llm_generated", "evidence_snippet": "Fatty (gordas) is a historical term for a type of appetite, specifically one characterized by a desire for rich or fatty foods.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Fatty (gordas) is a historical term for a type of appetite, specifically one characterized by a desire for rich or fatty foods."}, {"found_name": "Humoral theory", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 64, "target_cluster_name": "humoral theory", "source_book": "llm_generated", "evidence_snippet": "The concept of 'fatty' (gordas) is deeply embedded within historical humoral theory, describing a bodily state or quality related to the balance of humors.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The concept of 'fatty' (gordas) is deeply embedded within historical humoral theory, describing a bodily state or quality related to the balance of humors."}]}, {"canonical_name": "modernos", "category": "PERSON", "subcategory": "PRACTITIONER", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "modernos", "book_id": "historia_medicinal_monardes_1574", "name": "Modernos", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Modernos"], "contexts": ["early modern scholars discussing dragon's blood"]}, {"entity_id": "modernos", "book_id": "polyanthea_medicinal", "name": "modernos", "category": "PERSON", "subcategory": "PRACTITIONER", "count": 4, "variants": ["modernos"], "contexts": ["modern authors", "contemporary scholars or physicians"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Modernos", "target_book": "polyanthea_medicinal", "target_name": "modernos", "similarity": 0.659}], "id": 2866, "stable_key": "clu_eae8f7e15059f16d", "ground_truth": {"modern_name": "Modern authors", "confidence": "high", "type": "concept", "note": "Refers to contemporary scholars and authors within the context of the text.", "wikidata_id": "Q120129985", "wikidata_description": ""}, "cross_references": [{"found_name": "Authors", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 557, "target_cluster_name": "Authores", "source_book": "llm_generated", "evidence_snippet": "Modern authors are a subset of authors.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Modern authors are a subset of authors."}]}, {"canonical_name": "Philologos", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "philofofos", "book_id": "historia_medicinal_monardes_1574", "name": "Philofofos", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Philofofos"], "contexts": ["ancient philosophers"]}, {"entity_id": "philologos", "book_id": "polyanthea_medicinal", "name": "Philologos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 4, "variants": ["Philologos", "Philoftotos", "Philoſtotos"], "contexts": ["scholars of language and literature", "those who study language and rhetoric"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Philofofos", "target_book": "polyanthea_medicinal", "target_name": "Philologos", "similarity": 0.887}], "id": 2867, "stable_key": "clu_dc6ec678707a2ae0", "ground_truth": {"modern_name": "philologists", "confidence": "high", "type": "person", "description": "Scholars of language, literature, and ancient texts."}, "cross_references": [{"found_name": "Ancient Authorities", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1790, "target_cluster_name": "Antigos", "source_book": "llm_generated", "evidence_snippet": "Philologists are scholars who study ancient texts and languages, making them a specific type of 'Ancient Authority'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Philologists are scholars who study ancient texts and languages, making them a specific type of 'Ancient Authority'."}, {"found_name": "Authors", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 557, "target_cluster_name": "Authores", "source_book": "llm_generated", "evidence_snippet": "Philologists study and interpret the works of authors, and are often authors themselves.", "conf