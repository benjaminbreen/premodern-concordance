", "evidence_snippet": "Great Britain is a geographical and political entity located in Europe.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Great Britain is a geographical and political entity located in Europe."}, {"found_name": "Yorkshire", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 951, "target_cluster_name": "Yorkshire", "source_book": "llm_generated", "evidence_snippet": "Yorkshire is a historic county within Great Britain.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Yorkshire is a historic county within Great Britain.", "is_reverse": true}, {"found_name": "Victoria", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2118, "target_cluster_name": "Victoria", "source_book": "llm_generated", "evidence_snippet": "Victoria was Queen of the United Kingdom of Great Britain and Ireland.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Victoria was Queen of the United Kingdom of Great Britain and Ireland.", "is_reverse": true}, {"found_name": "British Islands", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2316, "target_cluster_name": "British Islands", "source_book": "llm_generated", "evidence_snippet": "The United Kingdom historically encompasses Great Britain.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The United Kingdom historically encompasses Great Britain.", "is_reverse": true}, {"found_name": "Union", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4045, "target_cluster_name": "Union", "source_book": "llm_generated", "evidence_snippet": "Great Britain was the colonial power from which the United States gained independence, establishing a foundational historical relationship.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Great Britain was the colonial power from which the United States gained independence, establishing a foundational historical relationship.", "is_reverse": true}]}, {"canonical_name": "Ohio", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 3, "total_mentions": 16, "members": [{"entity_id": "ohio", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Ohio", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 13, "variants": ["Ohio"], "contexts": ["region with fortifications", "geographic location"]}, {"entity_id": "ohio", "book_id": "kosmos_humboldt_1845", "name": "Ohio", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Ohio"], "contexts": ["river where Lepidosteus is found", "river valley"]}, {"entity_id": "ohio", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Ohio", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Ohio"], "contexts": ["country in America"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Ohio", "target_book": "kosmos_humboldt_1845", "target_name": "Ohio", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Ohio", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Ohio", "similarity": 0.81}, {"source_book": "kosmos_humboldt_1845", "source_name": "Ohio", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Ohio", "similarity": 0.81}], "id": 777, "stable_key": "clu_4793f3afbda3cbd4", "ground_truth": {"modern_name": "Ohio River", "confidence": "high", "type": "place", "country": "United States", "note": "While 'Ohio' can refer to the state, the context of a river and a region with fortifications points to the river and its valley.", "wikidata_id": "Q72054518", "wikidata_description": "valley and region along the Ohio River", "wikipedia_extract": "The Cuyahoga River (see § Pronunciation) is a river located in Northeast Ohio that feeds into Lake Erie. The Cuyahoga River bisects the city of Cleveland. As Cleveland emerged as a major manufacturing center, the river became heavily affected by industrial pollution, so much so that it caught fire at least 14 times. When it did so on June 22, 1969, news coverage of the event helped to spur the American environmental movement. For many Americans, the Cuyahoga's burning helped connect urban decay with the environmental crisis at the time in many American cities. Since then, the river has been extensively cleaned up through the efforts of Cleveland's city government and the Ohio Environmental Protection Agency (OEPA).", "wikipedia_url": "https://en.wikipedia.org/wiki/Cuyahoga_River"}, "cross_references": []}, {"canonical_name": "Constantinopla", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 16, "members": [{"entity_id": "constantinople", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Constantinople", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Constantinople"], "contexts": ["city where slave trade occurs"]}, {"entity_id": "constantinopla", "book_id": "coloquios_da_orta_1563", "name": "Constantinopla", "category": "PLACE", "subcategory": "CITY", "count": 13, "variants": ["Constantinopla", "Constantinopola"], "contexts": ["city mentioned in the text", "city, also called Rome"]}, {"entity_id": "constantinopla", "book_id": "polyanthea_medicinal", "name": "Constantinopla", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Constantinopla", "Constantinoplahouve"], "contexts": ["city where plagues occurred", "city where plague caused delusions"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Constantinople", "target_book": "coloquios_da_orta_1563", "target_name": "Constantinopla", "similarity": 0.984}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Constantinople", "target_book": "polyanthea_medicinal", "target_name": "Constantinopla", "similarity": 0.984}, {"source_book": "coloquios_da_orta_1563", "source_name": "Constantinopla", "target_book": "polyanthea_medicinal", "target_name": "Constantinopla", "similarity": 1.0}], "id": 778, "stable_key": "clu_2509c4f87f383dd7", "ground_truth": {"modern_name": "Constantinople", "confidence": "high", "type": "place", "description": "Historic city, formerly the capital of the Byzantine and Ottoman Empires.", "wikipedia_extract": "Constantinople (see other names) was a historical city located on the Bosporus, which served as the capital of the Roman, Byzantine, Latin, and Ottoman empires between its consecration in 330 and the formal abolition of the Ottoman sultanate in 1922. Constantinople was founded in 324, initially as New Rome, during the reign of Constantine the Great on the site of the existing settlement of Byzantium and in 330 became the capital of the Roman Empire. Following the collapse of the Western Roman Empire in the late 5th century, Constantinople remained the capital of the  Eastern Roman Empire (also known as the Byzantine Empire; 330–1204 and 1261–1453), the Latin Empire (1204–1261), and the Ottoman Empire (1453–1922). In the aftermath of the Turkish War of Independence, the Turkish capital moved to Ankara. The city was officially renamed Istanbul on 28 March 1930. As of December 2025, it is the most populous city in Europe, with a population of more than 16 million residents, straddling the Bosporus Strait and lying in both Europe and Asia, and is the financial beneficiary of Turkey."}, "cross_references": [{"found_name": "Veneza", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1662, "target_cluster_name": "Veneza", "source_book": "llm_generated", "evidence_snippet": "Venice and Constantinople were major trading centers and rivals in the Eastern Mediterranean.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Venice and Constantinople were major trading centers and rivals in the Eastern Mediterranean.", "is_reverse": true}, {"found_name": "Europe", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 30, "target_cluster_name": "Europe", "source_book": "llm_generated", "evidence_snippet": "Constantinople was a capital of the Roman and Byzantine Empires, which were centered in Europe.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Constantinople was a capital of the Roman and Byzantine Empires, which were centered in Europe."}, {"found_name": "Ásia menor", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2070, "target_cluster_name": "Ásia menor", "source_book": "llm_generated", "evidence_snippet": "Constantinople (modern Istanbul) is a major city located in Anatolia, historically significant for its position bridging Europe and Asia.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Constantinople (modern Istanbul) is a major city located in Anatolia, historically significant for its position bridging Europe and Asia.", "is_reverse": true}]}, {"canonical_name": "rhythm", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 16, "members": [{"entity_id": "rhythm", "book_id": "principles_of_psychology_james_1890", "name": "rhythm", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["rhythm"], "contexts": ["pattern of stressed and unstressed beats", "a pattern of sound or movement"]}, {"entity_id": "rhythm", "book_id": "connexion_physical_sciences_somerville_1858", "name": "rhythm", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["rhythm"], "contexts": ["pattern of sound or movement"]}, {"entity_id": "rhythm", "book_id": "first_principles_spencer_1862", "name": "rhythm", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 8, "variants": ["rhythm"], "contexts": ["pattern of recurring events or actions", "pattern of regu