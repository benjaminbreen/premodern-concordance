imilarity": 1.0}], "id": 37, "stable_key": "clu_add91c8305aaf40d", "ground_truth": {"modern_name": "Portugal", "confidence": "high", "type": "place", "description": "A country in Southwestern Europe.", "wikipedia_extract": "Portugal, officially the Portuguese Republic, is a country on the Iberian Peninsula in Southwestern Europe. It is a unitary republic made up by mainland Portugal and two autonomous regions, with Lisbon as both its capital and largest city. The mainland is bordered by Spain to the north and east, with Madeira and the Azores in the Atlantic Ocean. It features the westernmost point in continental Europe. The western Iberian Peninsula has been inhabited since prehistory, with the earliest signs of settlement dating to 5500 BC. Muslims invaded the Iberian Peninsula in the 8th century, but were gradually expelled during the Reconquista."}, "cross_references": [{"found_name": "Azores", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 874, "target_cluster_name": "Azores", "source_book": "llm_generated", "evidence_snippet": "The Azores are an archipelago and autonomous region of Portugal.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Azores are an archipelago and autonomous region of Portugal."}, {"found_name": "Algarve", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2147, "target_cluster_name": "Algarve", "source_book": "llm_generated", "evidence_snippet": "The Algarve is a region in southern Portugal.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Algarve is a region in southern Portugal."}, {"found_name": "Alentejo", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2336, "target_cluster_name": "Alem-Tejo", "source_book": "llm_generated", "evidence_snippet": "Alentejo is a region in south-central Portugal.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Alentejo is a region in 