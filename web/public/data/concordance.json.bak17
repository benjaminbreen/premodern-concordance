, "name": "tripas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["Tripas", "tripas"], "contexts": ["intestines"]}, {"entity_id": "tripas", "book_id": "coloquios_da_orta_1563", "name": "tripas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["tripas"], "contexts": ["intestines"]}, {"entity_id": "tripas", "book_id": "polyanthea_medicinal", "name": "Tripas", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 8, "variants": ["Tripas", "tripa", "tripas"], "contexts": ["intestines", "intestines, part of the body"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "tripas", "target_book": "coloquios_da_orta_1563", "target_name": "tripas", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "tripas", "target_book": "polyanthea_medicinal", "target_name": "Tripas", "similarity": 0.841}, {"source_book": "coloquios_da_orta_1563", "source_name": "tripas", "target_book": "polyanthea_medicinal", "target_name": "Tripas", "similarity": 0.841}], "id": 903, "stable_key": "clu_f10a1a5b759aaf5e", "ground_truth": {"modern_name": "Intestines", "confidence": "high", "type": "anatomy", "description": "The part of the digestive system in animals.", "note": "Refers to the anatomical organs.", "wikipedia_extract": "The gastrointestinal tract (also called the GI tract, digestive tract, and the alimentary canal) is the tract or passageway of the digestive system that leads from the mouth to the anus. The tract is one of the largest of the body's systems. The GI tract contains all the major organs of the digestive system, in humans and other animals, including the esophagus, stomach, and intestines. Food taken in through the mouth is digested to extract nutrients and absorb energy, and the waste expelled at the anus as feces. Gastrointestinal is an adjective meaning of or pertaining to the stomach and intestines. Most animals have a \"through-gut\" or complete digestive tract."}, "cross_references": [{"found_name": "entranhas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 284, "target_cluster_name": "entranhas", "source_book": "llm_generated", "evidence_snippet": "The entrails are primarily composed of the intestines.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The entrails are primarily composed of the intestines.", "is_reverse": true}, {"found_name": "Duodeno", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2512, "target_cluster_name": "Duodeno", "source_book": "llm_generated", "evidence_snippet": "The Duodenum is the first section of the small intestine.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Duodenum is the first section of the small intestine.", "is_reverse": true}]}, {"canonical_name": "homens", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 8, "total_mentions": 20, "members": [{"entity_id": "hombres", "book_id": "historia_medicinal_monardes_1574", "name": "hombres", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 2, "variants": ["hombres"], "contexts": ["men treated with the herb", "men, found preserved in snow"]}, {"entity_id": "homens", "book_id": "coloquios_da_orta_1563", "name": "homens", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["homens"], "contexts": ["people"]}, {"entity_id": "homens", "book_id": "polyanthea_medicinal", "name": "homens", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 8, "variants": ["homens", "homens Letrados", "homens gottofos"], "contexts": ["male bodies", "men who also suffered suffocations"]}, {"entity_id": "individuals", "book_id": "principles_of_psychology_james_1890", "name": "individuals", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["individuals"], "contexts": ["distinct human beings"]}, {"entity_id": "individuals", "book_