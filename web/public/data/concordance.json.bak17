source_book": "origin_of_species_darwin_1859", "source_name": "Sea-water", "target_book": "kosmos_humboldt_1845", "target_name": "sea water", "similarity": 0.98}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Sea-water", "target_book": "first_principles_spencer_1862", "target_name": "sea-water", "similarity": 0.991}, {"source_book": "origin_of_species_darwin_1859", "source_name": "seawater", "target_book": "kosmos_humboldt_1845", "target_name": "sea water", "similarity": 0.995}, {"source_book": "origin_of_species_darwin_1859", "source_name": "seawater", "target_book": "first_principles_spencer_1862", "target_name": "sea-water", "similarity": 0.989}, {"source_book": "kosmos_humboldt_1845", "source_name": "sea water", "target_book": "first_principles_spencer_1862", "target_name": "sea-water", "similarity": 0.985}], "id": 413, "stable_key": "clu_519b7baa11893e3f", "ground_truth": {"modern_name": "seawater", "confidence": "medium", "type": "mineral", "note": "'Agua marinha' directly translates to seawater. 'Agua mineral' suggests mineral water. 'Agua branca' could refer to mercury sublimate or white water. The connection is weak across all terms.", "wikidata_id": "Q184395", "wikidata_description": "water from a sea or ocean", "wikipedia_extract": "Per- and polyfluoroalkyl substances (also PFAS, PFASs, and informally called \"forever chemicals\") are a group of synthetic organofluorine chemical compounds that have multiple fluorine atoms attached to an alkyl chain; 7 million such chemicals are listed in PubChem. Widespread use of PFAS began in 1938 with the invention of Teflon, a fluoropolymer coating that resists heat, oil, stains, grease, and water. They are used in a wide variety of products including waterproof fabric, yoga pants, carpets, shampoo, mobile phone screens, wall paint, furniture, adhesives, food packaging, firefighting foam, electrical insulation, and cosmetics. Many PFAS such as PFOS and PFOA pose health and environmental concerns because they are persistent organic pollutants; they were branded as \"forever chemicals\" in an article in The Washington Post in 2018. They move through soils and bioaccumulate in fish and wildlife, which are then eaten by humans. Residues are now commonly found in rain, drinking water, and wastewater.", "wikipedia_url": "https://en.wikipedia.org/wiki/Seawater"}, "cross_references": [{"found_name": "freshwater", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2794, "target_cluster_name": "fresh water", "source_book": "llm_generated", "evidence_snippet": "Seawater and freshwater are contrasting types of water, often discussed in relation to each other in natural philosophy and early chemistry.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Seawater and freshwater are contrasting types of water, often discussed in relation to each other in natural philosophy and early chemistry."}]}, {"canonical_name": "arctic", "category": "PLACE", "subcategory": "REGION", "book_count": 4, "total_mentions": 16, "members": [{"entity_id": "arctic", "book_id": "origin_of_species_darwin_1859", "name": "arctic", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["arctic"], "contexts": ["cold polar region", "polar region around North Pole"]}, {"entity_id": "arctic", "book_id": "principles_of_psychology_james_1890", "name": "Arctic", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Arctic"], "contexts": ["polar region"]}, {"entity_id": "arctic", "book_id": "kosmos_humboldt_1845", "name": "Arctic", "category": "PLACE", "subcategory": "REGION", "count": 3, "variants": ["Arctic"], "contexts": ["geographic region"]}, {"entity_id": "arctic", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Arctic", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Arctic"], "contexts": ["northern polar region", "region with mosses and lichens"]}, {"entity_id": "arctic_regions