s", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "chemical compounds", "similarity": 0.943}, {"source_book": "kosmos_humboldt_1845", "source_name": "chemical elements", "target_book": "first_principles_spencer_1862", "target_name": "chemical elements", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "chemical elements", "target_book": "first_principles_spencer_1862", "target_name": "chemical compounds", "similarity": 0.943}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "chemical compounds", "target_book": "first_principles_spencer_1862", "target_name": "chemical elements", "similarity": 0.943}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "chemical compounds", "target_book": "first_principles_spencer_1862", "target_name": "chemical compounds", "similarity": 1.0}], "id": 1115, "stable_key": "clu_54fec02d1406ea10", "ground_truth": {"modern_name": "Chemical elements and compounds", "confidence": "high", "type": "chemical", "note": "The cluster includes references to both 'chemical elements' and 'chemical compounds', suggesting a general category of chemical substances."}, "cross_references": [{"found_name": "minerals", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 138, "target_cluster_name": "minerals", "source_book": "llm_generated", "evidence_snippet": "Minerals are defined by their specific chemical composition.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Minerals are defined by their specific chemical composition.", "is_reverse": true}, {"found_name": "hydrogène sulfuré", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 279, "target_cluster_name": "hydrogène sulfuré", "source_book": "llm_generated", "evidence_snippet": "Hydrogen sulfide is a chemical compound.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Hydrogen sulfide is a chemical compound.", "is_reverse": true}]}, {"canonical_name": "French", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "franceza", "book_id": "polyanthea_medicinal", "name": "Franceza", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["Franceza", "franca"], "contexts": ["language of France", "free or open"]}, {"entity_id": "french", "book_id": "connexion_physical_sciences_somerville_1858", "name": "French", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["French"], "contexts": ["nationality associated with time and measures", "related to France"]}, {"entity_id": "french", "book_id": "first_principles_spencer_1862", "name": "French", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["French"], "contexts": ["language and people", "language with dwindling inflexions"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "Franceza", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "French", "similarity": 0.932}, {"source_book": "polyanthea_medicinal", "source_name": "Franceza", "target_book": "first_principles_spencer_1862", "target_name": "French", "similarity": 0.932}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "French", "target_book": "first_principles_spencer_1862", "target_name": "French", "similarity": 1.0}], "id": 1116, "stable_key": "clu_c9257ab95c6c2917", "ground_truth": {"modern_name": "French", "confidence": "high", "type": "concept", "note": "Refers to the language and nationality of France.", "wikidata_id": "Q150", "wikidata_description": "Romance language", "wikipedia_url": "https://en.wikipedia.org/wiki/French%20language", "wikipedia_extract": "French (français [fʁɑ̃sɛ]  or langue française [lɑ̃ɡ fʁɑ̃sɛːz] ) is a Romance language of the Indo-European family. Like all other Romance languages, it descended from the Vulgar Latin of the Roman Empire. French evolved from Northern Old Gallo-Romance, a descendant of the Latin spoken in Northern Gaul. Its closest relatives are the other langues d'oïl—languages historically spoken in northern France and in southern Belgium, which French (Francien) largely supplanted. It was also influenced by native Celtic languages of Northern Roman Gaul and by the Germanic Frankish language of the post-Roman Frankish invaders. As a result of French and Belgian colonialism from the 16th century onward, it was introduced to new territories in the Americas, Africa, and Asia, and numerous French-based creole languages, most notably Haitian Creole, were developed."}, "cross_references": [{"found_name": "Latina", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1122, "target_cluster_name": "Latina", "source_book": "llm_generated", "evidence_snippet": "French is a Romance language directly descended from Vulgar Latin, making it a linguistic descendant and closely related language to Latin.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: French is a Romance language directly descended from Vulgar Latin, making it a linguistic descendant and closely related language to Latin.", "is_reverse": true}]}, {"canonical_name": "prey", "category": "CONCEPT", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "prey", "book_id": "origin_of_species_darwin_1859", "name": "prey", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["prey"], "contexts": ["animal hunted by another", "animal hunted and killed by another for food"]}, {"entity_id": "prey", "book_id": "first_principles_spencer_1862", "name": "prey", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["prey"], "contexts": ["sought by predatory creature", "animal hunted for food"]}, {"entity_id": "prey", "book_id": "principles_of_psychology_james_1890", "name": "prey", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Prey", "prey"], "contexts": ["animal hunted for food", "species interested in its own prey or food"]}, {"entity_id": "beasts_of_prey", "book_id": "first_principles_spencer_1862", "name": "beasts of prey", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["beasts of prey"], "contexts": ["carnivorous animals that hunt"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "prey", "target_book": "first_principles_spencer_1862", "target_name": "prey", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "prey", "target_book": "first_principles_spencer_1862", "target_name": "beasts of prey", "similarity": 0.942}], "id": 1117, "stable_key": "clu_6b47780dbaabcc7c", "ground_truth": {"modern_name": "Prey", "confidence": "high", "type": "animal", "note": "Refers to animals hunted by other animals.", "wikidata_id": "Q851408", "wikidata_description": "animal serving as food for another one"}, "cross_references": [{"found_name": "Animal Kingdom", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2373, "target_cluster_name": "animal kingdom", "source_book": "llm_generated", "evidence_snippet": "Prey is a fundamental concept within the Animal Kingdom, representing organisms that are hunted and killed by other organisms for food.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Prey is a fundamental concept within the Animal Kingdom, representing organisms that are hunted and killed by other organisms for food."}, {"found_name": "Hunting", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4225, "target_cluster_name": "hunting", "source_book": "llm_generated", "evidence_snippet": "Hunting is the activity directly associated with the concept of prey, as it describes the act of pursuing and capturing prey.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Hunting is the activity directly associated with the concept of prey, as it describes the act of pursuing and capturing prey."}, {"found_name": "Fauna", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 809, "target_cluster_name": "fauna", "source_book": "llm_generated", "evidence_snippet": "Prey is a component of the fauna of any given region, referring to the animals that are hunted within that ecosystem.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Prey is a component of the fauna of any given region, referring to the animals that are hunted within that ecosystem."}]}, {"canonical_name": "Bezoar", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "bezoar", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Bezoar", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["Bezoar"], "contexts": ["antidote stone from animal stomachs", "stone with no attractive power"]}, {"entity_id": "bezoar", "book_id": "historia_medicinal_monardes_1574", "name": "Bezoar", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["Bezoar"], "contexts": ["stone used for medicine", "stone used as antidote"]}, {"entity_id": "bezoar_stone", "book_id": "ricettario_fiorentino_1597", "name": "Bezoar stone", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Bezoar stone"], "contexts": ["antidote stone from animal stomachs"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Bezoar", "target_book": "historia_medicinal_monardes_1574", "target_name": "Bezoar", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Bezoar", "target_book": "ricettario_fiorentino_1597", "target_name": "Bezoar stone", "similarity": 0.91}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Bezoar", "target_book": "ricettario_fiorentino_1597", "target_name": "Bezoar stone", "similarity": 0.91}], "id": 1118, "stable_key": "clu_555c7a57f967f46d", "ground_truth": {"modern_name": "bezoar", "confidence": "high", "type": "substance", "description": "Calculus found in the stomach of animals, used as an antidote.", "wikipedia_extract": "A bezoar stone (, BEE-zor) is a mass often found trapped in the gastrointestinal system, though it can occur in other locations. A pseudobezoar is an indigestible object introduced intentionally into the digestive system. There are several varieties of bezoar, some of which have inorganic constituents and others organic. The term has both modern (medical, scientific) and traditional usage. Food boluses (or boli; singular bolus) have the archaic and positive meaning of bezoar, and are composed of loose aggregates of food items such as seeds, fruit pith, or pits, as well as other types of items such as shellac, bubble gum, soil, and concretions of some medications. Lactobezoars are a specific type of food bezoar consisting of inspissated milk."}, "cross_references": [{"found_name": "pedras", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1494, "target_cluster_name": "pedras", "source_book": "historia_medicinal_monardes_1574", "evidence_snippet": "coſas másaprourchanesBezaar,fi fe pudia - .* rc hallar,que demueſtra con quáta difficultad (e auía. Y en el capitulo de losque tomaró Napelo: dize. La piedra llamada Bezaar cetrina coloras da,pura,y q", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "reverse: alternative name for calculus", "is_reverse": true}, {"found_name": "cobras", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1535, "target_cluster_name": "cobras", "source_book": "historia_medicinal_monardes_1574", "evidence_snippet": "ves -neno,o colas venenolas llamanBezaarticas,por | .excelencía, Eſta piedra le engendra en lo interior de vn Do fe en animal que llaman comunmente Cabra monte. gendra, La. Engendrarfe piedras en los ", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "reverse: type of stone found in animals, associated with the known entity", "is_reverse": true}]}, {"canonical_name": "gemms", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "gemms", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "gemms", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["gemms", "Gemms"], "contexts": ["precious stones", "precious stones, like other gemms"]}, {"entity_id": "gem", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Gem", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Gem"], "contexts": ["precious stone"]}, {"entity_id": "gemmis", "book_id": "polyanthea_medicinal", "name": "gemmis", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["gemmis"], "contexts": ["gems, believed to have virtues"]}, {"entity_id": "gems", "book_id": "connexion_physical_sciences_somerville_1858", "name": "gems", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["gems"], "contexts": ["paramagnetic substances"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "gemms", "target_book": "polyanthea_medicinal", "target_name": "gemmis", "similarity": 0.98}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "gemms", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "gems", "similarity": 0.97}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Gem", "target_book": "polyanthea_medicinal", "target_name": "gemmis", "similarity": 0.895}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Gem", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "gems", "similarity": 0.935}, {"source_book": "polyanthea_medicinal", "source_name": "gemmis", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "gems", "similarity": 0.939}], "id": 1119, "stable_key": "clu_7627f3710ef49a36", "ground_truth": {"modern_name": "Gems", "confidence": "high", "type": "mineral", "note": "Refers to precious stones.", "wikidata_id": "Q83437", "wikidata_description": "piece of mineral used to make jewelry", "wikipedia_url": "https://en.wikipedia.org/wiki/Gemstone", "wikipedia_extract": "A gemstone (also called a fine gem, jewel, precious stone, semiprecious stone, or simply gem) is a piece of mineral crystal which, when cut or polished, is used to make jewelry or other adornments. Certain rocks (such as lapis lazuli, opal, and obsidian) and occasionally organic materials that are not minerals (such as amber, jet, and pearl) may also be used for jewelry and are therefore often considered to be gemstones as well. Most gemstones are hard, but some softer minerals such as brazilianite may be used in jewelry because of their color or luster or other physical properties that have aesthetic value. However, generally speaking, soft minerals are not typically used as gemstones by virtue of their brittleness and lack of durability. Found all over the world, the industry of coloured gemstones (i.e. anything other than diamonds) is currently estimated at US$1.55 billion as of 2023 and is projected to steadily increase to a value of $4.46 billion by 2033."}, "cross_references": [{"found_name": "minerals", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 138, "target_cluster_name": "minerals", "source_book": "llm_generated", "evidence_snippet": "Many minerals are classified as gems due to their beauty and rarity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Many minerals are classified as gems due to their beauty and rarity.", "is_reverse": true}, {"found_name": "quartz", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 323, "target_cluster_name": "quartz", "source_book": "llm_generated", "evidence_snippet": "Quartz, in its various forms like amethyst and citrine, is often used as a gemstone.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Quartz, in its various forms like amethyst and citrine, is often used as a gemstone.", "is_reverse": true}, {"found_name": "marmo", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1062, "target_cluster_name": "marmo", "source_book": "llm_generated", "evidence_snippet": "Marble is often used as a decorative stone, similar to gems.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Marble is often used as a decorative stone, similar to gems.", "is_reverse": true}, {"found_name": "Amethyst", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2673, "target_cluster_name": "Amethyst", "source_book": "llm_generated", "evidence_snippet": "Amethyst is a specific type of gem.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Amethyst is a specific type of gem."}, {"found_name": "Emerald", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 107, "target_cluster_name": "esmeralda", "source_book": "llm_generated", "evidence_snippet": "Emerald is a specific type of gem.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Emerald is a specific type of gem."}, {"found_name": "Garnet", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 948, "target_cluster_name": "granada", "source_book": "llm_generated", "evidence_snippet": "Garnet is a specific type of gem.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Garnet is a specific type of gem."}, {"found_name": "Hyacinth", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 728, "target_cluster