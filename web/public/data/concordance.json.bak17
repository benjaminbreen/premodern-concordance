wrence", "book_id": "connexion_physical_sciences_somerville_1858", "name": "river St. Lawrence", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["river St. Lawrence"], "contexts": ["frozen river used for travel"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "St. Lawrence", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "river St. Lawrence", "similarity": 0.884}], "id": 2597, "stable_key": "clu_8259b600c3ed4f7e", "ground_truth": {"modern_name": "St. Lawrence River", "confidence": "high", "type": "place", "country": "Canada", "note": "While the cluster mentions 'stream of meteors' and 'luminous sea observation', the primary referent in the context of place names is the St. Lawrence River and its Gulf.", "wikidata_id": "Q134750", "wikidata_description": "major river in eastern Canada and the United States, flowing into the Gulf of St. Lawrence", "wikipedia_extract": "The St. Lawrence River (French: Fleuve Saint-Laurent, pronounced [flœv sɛ̃ lɔʁɑ̃]) is a large international river in the middle latitudes of North America connecting the Great Lakes with the North Atlantic Ocean. Its waters flow in a northeasterly direction from Lake Ontario to the Gulf of St. Lawrence, traversing Ontario and Quebec in Canada and New York in the United States. A portion of the river demarcates the Canada–United States border. As the primary drainage outflow of the Great Lakes Basin, the St.", "wikipedia_url": "https://en.wikipedia.org/wiki/St._Lawrence_River"}, "cross_references": [{"found_name": "Great Lakes", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1350, "target_cluster_name": "lakes", "source_book": "llm_generated", "evidence_snippet": "The St. Lawrence River connects the Great Lakes to the Atlantic Ocean.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The St. Lawrence River connects the Great Lakes to the Atlantic Ocean."}]}, {"canonical_name": "geography of plants", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "geography_of_plants", "book_id": "kosmos_humboldt_1845", "name": "geography of plants", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["Geography of Plants", "geography of plants"], "contexts": ["study of plant distribution", "study of plant distribution on Earth"]}, {"entity_id": "botanical_geography", "book_id": "connexion_physical_sciences_somerville_1858", "name": "botanical geography", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["botanical geography"], "contexts": ["science of plant distribution"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "geography of plants", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "botanical geography", "similarity": 0.908}], "id": 2598, "stable_key": "clu_f750de08e03be4ce", "ground_truth": {"modern_name": "Biogeography", "confidence": "high", "type": "concept", "note": "Specifically refers to the study of the geographical distribution of plants, which falls under the broader field of biogeography."}, "cross_references": [{"found_name": "Botany", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1098, "target_cluster_name": "botany", "source_book": "llm_generated", "evidence_snippet": "Botany is the study of plants, and biogeography is concerned with the geographical distribution of plants (and other organisms). There is a strong, direct relationship between the study of plant life and the study of where that life is found.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Botany is the study of plants, and biogeography is concerned with the geographical distribution of plants (and other organisms). There is a strong, direct relationship between the study of plant life and the study of where that life is found."}, {"found_name": "Geography", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1068, "target_cluster_name": "Geography", "source_book": "llm_generated", "evidence_snippet": "Biogeography is a sub-discipline of geography, specifically focusing on the spatial distribution of living organisms. The relationship is one of a specific field within a broader discipline.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Biogeography is a sub-discipline of geography, specifically focusing on the spatial distribution of living organisms. The relationship is one of a specific field within a broader discipline."}, {"found_name": "Distribution", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1145, "target_cluster_name": "distribution", "source_book": "llm_generated", "evidence_snippet": "Biogeography is fundamentally about the 'distribution' of living organisms across geographical space. 'Distribution' is a core concept within biogeography.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Biogeography is fundamentally about the 'distribution' of living organisms across geographical space. 'Distribution' is a core concept within biogeography."}, {"found_name": "Climate", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 613, "target_cluster_name": "climate", "source_book": "llm_generated", "evidence_snippet": "Climate is a major factor influencing the geographical distribution of species, and therefore a key consideration in biogeography.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Climate is a major factor influencing the geographical distribution of species, and therefore a key consideration in biogeography."}, {"found_name": "Economy of nature", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1147, "target_cluster_name": "economy of nature", "source_book": "llm_generated", "evidence_snippet": "The 'economy of nature' refers to the interconnectedness and balance of living organisms and their environments, a concept central to understanding biogeographical patterns and processes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The 'economy of nature' refers to the interconnectedness and balance of living organisms and their environments, a concept central to understanding biogeographical patterns and processes."}, {"found_name": "Evolution", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 540, "target_cluster_name": "Evolution", "source_book": "llm_generated", "evidence_snippet": "Evolutionary processes are a primary driver of the patterns of species distribution studied in biogeography. Understanding how species evolve is crucial for understanding where they are found.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Evolutionary processes are a primary driver of the patterns of species distribution studied in biogeography. Understanding how species evolve is crucial for understanding where they are found."}]}, {"canonical_name": "Benzenberg", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "benzenberg", "book_id": "kosmos_humboldt_1845", "name": "Benzenberg", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["Benzenberg"], "contexts": ["author of 'Treatise on Shooting Stars'", "ascertained heights and velocity of shooting stars"]}, {"entity_id": "benzenberg", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Benzenberg", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Benzenberg"], "contexts": ["observed heights and velocities of falling stars"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Benzenberg", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Benzenberg", "similarity": 1.0}], "id": 2