oss_references": [{"found_name": "External world", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 978, "target_cluster_name": "external world", "source_book": "llm_generated", "evidence_snippet": "The external world is often used synonymously with nature, referring to everything outside of the individual's mind.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The external world is often used synonymously with nature, referring to everything outside of the individual's mind."}, {"found_name": "Animal life", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2437, "target_cluster_name": "animal life", "source_book": "llm_generated", "evidence_snippet": "Animal life is a significant component and manifestation of nature.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Animal life is a significant component and manifestation of nature."}, {"found_name": "Botany", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1098, "target_cluster_name": "botany", "source_book": "llm_generated", "evidence_snippet": "Botany is the scientific study of plants, a major part of nature.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Botany is the scientific study of plants, a major part of nature."}, {"found_name": "Fauna", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 809, "target_cluster_name": "fauna", "source_book": "llm_generated", "evidence_snippet": "Fauna refers to all the animal life in a particular region or time, a key aspect of nature.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Fauna refers to all the animal life in a particular region or time, a key aspect of nature."}, {"found_name": "Economy of nature", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1147, "target_cluster_name": "economy of nature", "source_book": "llm_generated", "evidence_