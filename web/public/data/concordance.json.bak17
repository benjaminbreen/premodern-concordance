["narcotic drug from poppy"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Opio", "target_book": "coloquios_da_orta_1563", "target_name": "opio", "similarity": 0.996}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Opio", "target_book": "polyanthea_medicinal", "target_name": "opio", "similarity": 0.996}, {"source_book": "coloquios_da_orta_1563", "source_name": "opio", "target_book": "polyanthea_medicinal", "target_name": "opio", "similarity": 1.0}], "id": 665, "stable_key": "clu_b43b3850238a25ac-2", "ground_truth": {"modern_name": "opium", "confidence": "high", "type": "plant", "linnaean": "Papaver somniferum", "family": "Papaveraceae", "description": "Narcotic drug derived from the opium poppy, used medically and recreationally.", "wikipedia_extract": "Papaver somniferum, commonly known as the opium poppy or breadseed poppy, is a species of flowering plant in the family Papaveraceae. It is the species of plant from which both opium and poppy seeds are derived and is also a valuable ornamental plant grown in gardens. Its native range is the western Mediterranean region, but has since been obscured by widespread introduction and cultivation since ancient times to the present day. It is now naturalised across much of the world with temperate climates. Papaver somniferum is an annual herb growing to about 100 centimetres (40 inches) tall. The plant is strongly glaucous, giving a greyish-green appearance, and the stem and leaves bear a sparse distribution of coarse hairs."}, "member_count": 8, "cross_references": [{"found_name": "Vegetation", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 2157, "target_cluster_name": "Vegetation", "source_book": "llm_generated", "evidence_snippet": "Spanish for 'Opium', derived from a specific plant.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "reverse: Spanish for 'Opium', derived from a specific plant.", "is_reverse": true}, {"found_name": "Poppy Seed", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2957, "target_cluster_name": "Poppy Seed", "source_book": "llm_generated", "evidence_snippet": "Poppy seeds are derived from the same plant species (Papaver somniferum) as opium.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Poppy seeds are derived from the same plant species (Papaver somniferum) as opium."}, {"found_name": "Black Poppy", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "english_physician_1652", "evidence_snippet": "Milk when they are broken, of an unpleasant bitter tast, almost ready to provoke casting, and of a strong, heady smel, which being condensate is called Opium. The Root is white, and woody, perishing a", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of poppy, similar to the former"}]}, {"canonical_name": "Polipodio", "category": "PLANT", "subcategory": "ROOT", "book_count": 3, "total_mentions": 27, "members": [{"entity_id": "polipodio", "book_id": "coloquios_da_orta_1563", "name": "polipodio", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["polipodio"], "contexts": ["herb mentioned as food", "plant with leaves similar to a sensitive herb"]}, {"entity_id": "polipodio", "book_id": "ricettario_fiorentino_1597", "name": "Polipodio", "category": "PLANT", "subcategory": "ROOT", "count": 14, "variants": ["Polipodio", "Polipodio quercino", "Polpodio", "Polypodio", "polipodio"], "contexts": ["fern used in purgatives", "herb used in a syrup"]}, {"entity_id": "polipo", "book_id": "ricettario_fiorentino_1597", "name": "polipo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["polipo"], "contexts": ["plant ingredient in a preparation"]}, {"entity_id": "polipodio", "book_id": "polyanthea_medicinal", "name": "polipodio", "category": "PLANT"