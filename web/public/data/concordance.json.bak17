th": 0.5, "target_cluster_id": 113, "target_cluster_name": "Plato", "source_book": "llm_generated", "evidence_snippet": "Seneca, as a Stoic philosopher, was part of a long tradition of Western philosophy that was heavily influenced by Plato and his successors.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Seneca, as a Stoic philosopher, was part of a long tradition of Western philosophy that was heavily influenced by Plato and his successors."}, {"found_name": "Aristotle", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 62, "target_cluster_name": "Aristotle", "source_book": "llm_generated", "evidence_snippet": "Seneca, as a Stoic philosopher, was part of a long tradition of Western philosophy that was heavily influenced by Aristotle and his successors.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Seneca, as a Stoic philosopher, was part of a long tradition of Western philosophy that was heavily influenced by Aristotle and his successors."}, {"found_name": "post-hypnotic suggestion", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "principles_of_psychology_james_1890", "evidence_snippet": "should _not see_ any card whose number was a multiple of three. This is the ordinary so-called 'post-hypnotic suggestion,' now well known, and for which Lucie was a well-adapted subject. Accordingly, ", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of suggestion"}]}, {"canonical_name": "Bees", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 22, "members": [{"entity_id": "bees", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Bees", "category": "ANIMAL", "subcategory": "INSECT", "count": 2, "variants": ["Bees"], "contexts": ["social flying insects", "emerge from corrupt Oxe"]}, {"entity_id": "bees", "book_id": "english_physician_1652", "name": "Bees", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 9, "variants": ["Bees"], "contexts": ["insect with sting", "insects that gather nectar"]}, {"entity_id": "bee", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Bee", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["Bee"], "contexts": ["insect found in amber"]}, {"entity_id": "bee", "book_id": "origin_of_species_darwin_1859", "name": "Bee", "category": "ANIMAL", "subcategory": "INSECT", "count": 6, "variants": ["bee", "Bee"], "contexts": ["social insect that makes honey", "insect with a stinging tail"]}, {"entity_id": "beetles", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Beetles", "category": "ANIMAL", "subcategory": "INSECT", "count": 1, "variants": ["Beetles"], "contexts": ["worshipped insects"]}, {"entity_id": "beetle", "book_id": "origin_of_species_darwin_1859", "name": "beetle", "category": "ANIMAL", "subcategory": "INSECT", "count": 3, "variants": ["beetle"], "contexts": ["aquatic insect example", "insect that damages smooth-skinned fruits"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Bees", "target_book": "english_physician_1652", "target_name": "Bees", "similarity": 0.904}], "id": 2025, "stable_key": "clu_8958e56043dd1909", "ground_truth": {"modern_name": "Bees", "confidence": "high", "type": "animal", "description": "Social insects known for honey production and pollination.", "wikipedia_extract": "Bees are winged insects that form a monophyletic clade Anthophila within the superfamily Apoidea of the order Hymenoptera, with over 20,000 known species in seven recognized families. Some species – including honey bees, bumblebees, and stingless bees – are social insects living in highly hierarchical colonies, while over 90% of bee species – including mason bees, carpenter bees, leafcutter bees, and sweat bees – are solitary. Members of the most well-known bee genus, Apis (i.e. honey bees), are known to construct hexagonally celled waxy nests called hives. Unlike the closely related wasps and ants, who are carnivorous/omnivorous, bees are herbivores that specifically feed on nectar (nectarivory) and pollen (palynivory), the former primarily as a carbohydrate source for metabolic energy, and the latter primarily for protein and other nutrients for their larvae. They are found on every continent except Antarctica, and in every habitat on the planet that contains insect-pollinated flowering plants. The most common bees in the Northern Hemisphere are the Halictidae, or sweat bees, but they are small and often mistaken for wasps or flies."}, "member_count": 6, "cross_references": [{"found_name": "mel", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1544, "target_cluster_name": "mel", "source_book": "llm_generated", "evidence_snippet": "Honey is produced by bees, making 'bees' a direct and essential related entity.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: Honey is produced by bees, making 'bees' a direct and essential related entity.", "is_reverse": true}, {"found_name": "abelha", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 3212, "target_cluster_name": "abelha", "source_book": "llm_generated", "evidence_snippet": "Portuguese for 'bee'.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "Portuguese for 'bee'."}, {"found_name": "Queen bee", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3391, "target_cluster_name": "queen-bee", "source_book": "llm_generated", "evidence_snippet": "The reproductive female bee in a colony, a specific type of bee.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The reproductive female bee in a colony, a specific type of bee."}, {"found_name": "Ants", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2034, "target_cluster_name": 