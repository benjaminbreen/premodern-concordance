 "Candia", "category": "PLACE", "subcategory": "COUNTRY", "count": 11, "variants": ["Candia"], "contexts": ["place known for praised herbs", "source of best ammi"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Candia", "target_book": "ricettario_fiorentino_1597", "target_name": "Candia", "similarity": 0.819}], "id": 2010, "stable_key": "clu_15b8c7bf4a4cb7fc", "ground_truth": {"modern_name": "Heraklion", "confidence": "high", "type": "place", "country": "Greece", "note": "Candia is the historical name for Heraklion, the capital of Crete."}, "cross_references": [{"found_name": "Creta", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 510, "target_cluster_name": "Creta", "source_book": "llm_generated", "evidence_snippet": "Creta is the Latin name for the island of Crete, where Heraklion (historically Candia) is located. In many premodern texts, the island and its major city were often conflated or used interchangeably.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "Creta is the Latin name for the island of Crete, where Heraklion (historically Candia) is located. In many premodern texts, the island and its major city were often conflated or used interchangeably."}, {"found_name": "Turkey", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 272, "target_cluster_name": "Turquia", "source_book": "llm_generated", "evidence_snippet": "The Ottoman Empire, often referred to as Turkey in premodern texts, conquered Candia from Venice in 1669. This marked a significant shift in the region's history and political control, making Turkey a key related entity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Ottoman Empire, often referred to as Turkey in premodern texts, conquered Candia from Venice in 1669. This marked a significant shift in the region's history and political control, making Turkey a key related entity."}, {"found_name": "Greece", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 773, "target_cluster_name": "grego", "source_book": "llm_generated", "evidence_snippet": "Heraklion (Candia) is located on the island of Crete, which has a long and complex historical relationship with Greece, both culturally and politically, particularly during periods of Byzantine and later Greek influence.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Heraklion (Candia) is located on the island of Crete, which has a long and complex historical relationship with Greece, both culturally and politically, particularly during periods of Byzantine and later Greek influence."}, {"found_name": "Venice", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 170, "target_cluster_name": "Venezia", "source_book": "llm_generated", "evidence_snippet": "Venice controlled Crete, including Candia (Heraklion), for several centuries (13th-17th centuries). This period of Venetian rule significantly shaped the city's architecture, administration, and economy, making Venice a crucial related entity in historical contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Venice controlled Crete, including Candia (Heraklion), for several centuries (13th-17th centuries). This period of Venetian rule significantly shaped the city's architecture, administration, and economy, making Venice a crucial related entity in historical contexts."}]}, {"canonical_name": "Niccolao", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 12, "members": [{"entity_id": "nicolo", "book_id": "historia_medicinal_monardes_1574", "name": "Nicolo", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["Nicolo"], "contexts": ["mentioned in relation to Nicoto Florentino"]}, {"entity_id": "niccolao", "book_id": "ricettario_fiorentino_1597", "name": "Niccolao", "category": "PERSON", "subcategory": "OTHER