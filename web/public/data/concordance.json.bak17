, "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4159, "target_cluster_name": "disorders", "source_book": "llm_generated", "evidence_snippet": "Congenital malformations are a specific type of disorder.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Congenital malformations are a specific type of disorder."}, {"found_name": "Errors", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2490, "target_cluster_name": "Errors", "source_book": "llm_generated", "evidence_snippet": "Congenital malformations can be viewed as errors in development.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Congenital malformations can be viewed as errors in development."}, {"found_name": "Pathology", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4148, "target_cluster_name": "Pathological cases", "source_book": "llm_generated", "evidence_snippet": "Congenital malformations are a subject of pathological study.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Congenital malformations are a subject of pathological study."}]}, {"canonical_name": "Wheesing", "category": "DISEASE", "subcategory": "SYMPTOM", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "wheesing", "book_id": "english_physician_1652", "name": "Wheesing", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 9, "variants": ["Wheesing", "Wheesings", "wheesing", "wheesings"], "contexts": ["difficulty breathing", "helped by fennel seed"]}, {"entity_id": "sneezing", "book_id": "principles_of_psychology_james_1890", "name": "sneezing", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 1, "variants": ["sneezing"], "contexts": ["involuntary expulsion of air"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Wheesing", "target_book": "principles_of_psychology_james_1890", "target_name": "sneezing", "similarity": 0.9}], "id": 2097, "stable_key": "clu_e92544365acf71a8", "ground_truth": {"wikipedia_extract": "A sneeze (also known as sternutation) is a semi-autonomous, convulsive expulsion of air from the lungs through the nose and mouth, usually caused by foreign particles irritating the nasal mucosa. A sneeze expels air forcibly from the mouth and nose in an explosive, spasmodic involuntary action. This action allows for mucus to escape through the nasal cavity and saliva to escape from the oral cavity. Sneezing is possibly linked to sudden exposure to bright light (known as photic sneeze reflex), sudden change (drop) in temperature, breeze of cold air, a particularly full stomach, exposure to allergens, or viral infection. Because sneezes can spread disease through infectious aerosol droplets, it is recommended to cover one's mouth and nose with the forearm, the inside of the elbow, a facial tissue or a handkerchief while sneezing. In addition to covering the mouth, looking down is also recommended to change the direction of the droplets spread and avoid high concentration in the human breathing heights."}, "cross_references": [{"found_name": "Cough", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1561, "target_cluster_name": "Cough", "source_book": "llm_generated", "evidence_snippet": "Wheezing is a high-pitched whistling sound made while breathing, often associated with a cough, particularly in respiratory conditions.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: Wheezing is a high-pitched whistling sound made while breathing, often associated with a cough, particularly in respiratory conditions.", "is_reverse": true}, {"found_name": "Asthma", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 550, "target_cluster_name": "Asthma", "source_book": "llm_generated", "evidence_snippet": "Wheezing is a primary symptom of asthma.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Wheezing is a primary symptom of asthma.", "is_reverse": true}]}, {"canonical_name": "Astrologers", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "astrologers", "book_id": "english_physician_1652", "name": "Astrologers", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 9, "variants": ["Astrologers", "Astrologer"], "contexts": ["attributed Henbane to Jupiter", "practitioners of astrology"]}, {"entity_id": "astrólogos", "book_id": "coloquios_da_orta_1563", "name": "astrólogos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 1, "variants": ["astrólogos"], "contexts": ["Astrologers appointed by sovereigns"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Astrologers", "target_book": "coloquios_da_orta_1563", "target_name": "astrólogos", "similarity": 0.967}], "id": 2098, "stable_key": "clu_d4cce850e4a97f0a", "ground_truth": {"modern_name": "Astrologers", "confidence": "high", "type": "concept", "note": "While 'astrologer' refers to a person, the cluster groups the general concept of 'astrologers' as a collective, often invoked for their influence on medicine and governance in early modern texts.  The modern referent is the field of astrology itself, or the practitioners of it collectively.", "wikidata_id": "Q34362", "wikidata_description": "ensemble of traditions, beliefs and divinations that interpret the positions of the planets and other celestial bodies; along with their correlation with terrestrial events"}, "cross_references": [{"found_name": "Authors ancient or modern", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3855, "target_cluster_name": "Authors ancient or modern", "source_book": "llm_generated", "evidence_snippet": "Astrologers were frequently authors of astrological treatises and ephemerides.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Astrologers were frequently authors of astrological treatises and ephemerides.", "is_reverse": true}]}, {"canonical_name": "Pills", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 10, "members": [{"entity_id": "pills", "book_id": "english_physician_1652", "name": "Pills", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 7, "variants": ["Pills", "Pill"], "contexts": ["medicinal form", "dosage form of medicine"]}, {"entity_id": "pillole", "book_id": "ricettario_fiorentino_1597", "name": "pillole", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 3, "variants": ["pillole"], "contexts": ["medicinal preparations softened with humors", "pills, a type of compound medicine"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Pills", "target_book": "ricettario_fiorentino_1597", "target_name": "pillole", "similarity": 0.883}], "id": 2099, "stable_key": "clu_51989c7660a26c4d", "ground_truth": {"modern_name": "Pills", "confidence": "high", "type": "substance", "description": "Dosage forms of medicine, often compounded.", "wikipedia_extract": "The combined oral contraceptive pill (COCP), often referred to as the birth control pill or colloquially as \"the pill\", is a type of birth control that is designed to be taken orally by women. It is the oral form of combined hormonal contraception. The pill contains two important hormones: a progestin (a synthetic form of the hormone progestogen/progesterone) and estrogen (usually ethinylestradiol or 17β estradiol). When taken correctly, it alters the menstrual cycle to eliminate ovulation and prevent pregnancy. Combined oral contraceptive pills were first approved for contraceptive use in the United States in 1960, and remain a very popular form of birth control. They are used by more than 100 million women worldwide  including about 9 million women in the United States."}, "cross_references": [{"found_name": "Catapotia", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 3951, "target_cluster_name": "Catapotia", "source_book": "english_physician_1652", "evidence_snippet": "Past, and that Past into little Cakes called Troches. 5. Having made them, dry them well in the shadow and keep them in a Pot for your use. Chap. 14. Of Pills. 1. THey are called Pilule because they r", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "Greek name for pills"}, {"found_name": "Galen", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 29, "target_cluster_name": "Galen", "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "^Scamonea preparata 3 .lii, Gherofani 3,11. òaie indo ^ cioè zucchero can- dì jSugodi Soìatrocj b# t^a pijiolc * PÌLLOLE CVM SEX rehiif di Galeno . an.ont4: AVoè Scamonea Colocmthida Agarico jidcilio ", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "reverse: type of preparation", "is_reverse": true}, {"found_name": "trochifci", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": null, "target_cluster_name": null, "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "onde da'Grcci fono chiamati trochifci , Se da' Latini pafttlli, forfè dalla qualità della figura loro. Seccanfi all'ombra , & confcruanfi come delle pillole e detto. Dura- no vn'anno,ò piùj&gli oppiat", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "Greek name for lozenges/pills"}, {"found_name": "pafttlli", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": null, "target_cluster_name": null, "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "onde da'Grcci fono chiamati trochifci , Se da' Latini pafttlli, forfè dalla qualità della figura loro. Seccanfi all'ombra , & confcruanfi come delle pillole e detto. Dura- no vn'anno,ò piùj&gli oppiat", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "Latin name for lo