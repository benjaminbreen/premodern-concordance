ty_id": "oviedo", "book_id": "kosmos_humboldt_1845", "name": "Oviedo", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Oviedo"], "contexts": ["calls Sargasso Sea 'sea-weed meadows'", "describes weed of the Gulf Stream"]}, {"entity_id": "oviedo", "book_id": "coloquios_da_orta_1563", "name": "Oviedo", "category": "PERSON", "subcategory": "SCHOLAR", "count": 14, "variants": ["Oviedo", "Gonçalo de Oviedo", "Oviedo (Gonçalo de)"], "contexts": ["source of information for Orta", "celebrated cinnamon from America"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Oviedo", "target_book": "kosmos_humboldt_1845", "target_name": "Oviedo", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Oviedo", "target_book": "coloquios_da_orta_1563", "target_name": "Oviedo", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Oviedo", "target_book": "coloquios_da_orta_1563", "target_name": "Oviedo", "similarity": 1.0}], "id": 758, "stable_key": "clu_e32e7c9293b1586c", "ground_truth": {"modern_name": "Oviedo", "confidence": "high", "type": "person", "description": "A source of information and author of natural history works.", "note": "Refers to Gonzalo Fernández de Oviedo y Valdés.", "wikipedia_extract": "Oviedo (Spanish: [oˈβjeðo] ) or Uviéu (Asturian: [uˈβjew]) is the capital city of the Principality of Asturias in northern Spain and the administrative and commercial centre of the region. With a population of 220,027, it is also the 2nd-largest city in Asturias. Oviedo is located approximately 24 km (15 mi) southwest of Gijón and 23 km (14 mi) southeast of Avilés, both of which lie on the shoreline of the Bay of Biscay. Oviedo's proximity to the ocean of less than 30 kilometres (19 mi) in combination with its elevated position with areas of the city more than 300 metres above sea level causes the city to have a maritime climate, even though it does not sit directly on the shore. The Kingdom of Asturias began in 720, with the Visigothic aristocrat Pelagius's (685–737) revolt against the Muslims who at the time were occupying most of the Iberian Peninsula. The Moorish invasion that began in 711 had taken control of most of the peninsula, until the revolt in the northern mountains by Pelagius."}, "cross_references": [{"found_name": "gatto maimone", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 872, "target_cluster_name": "monkey", "source_book": "coloquios_da_orta_1563", "evidence_snippet": "lingua, para o Vo- cabulário do padre D. Raphael Bluteau, e para alguns diccionarios mo- dernos, como o de Moraes. Paliando dos coqueiros da America, Oviedo diz também (cito pela versão de Ramusio): «", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "Italian translation for bugio"}]}, {"canonical_name": "touch", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 17, "members": [{"entity_id": "touch", "book_id": "principles_of_psychology_james_1890", "name": "touch", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 12, "variants": ["touch"], "contexts": ["sense of tactile perception", "sense of feeling through skin"]}, {"entity_id": "touched", "book_id": "principles_of_psychology_james_1890", "name": "touched", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["touched"], "contexts": ["perceived by contact"]}, {"entity_id": "touch", "book_id": "connexion_physical_sciences_somerville_1858", "name": "touch", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["touch"], "contexts": ["sense of feeling"]}, {"entity_id": "touch", "book_id": "first_principles_spencer_1862", "name": "touch", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["touch"], "contexts": ["sense of tactile sensation", "sense of feeling"]}], "edges": [{"source_book": "princi