k_count": 2, "total_mentions": 4, "members": [{"entity_id": "pains_of_the_head", "book_id": "english_physician_1652", "name": "pains of the Head", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 2, "variants": ["pains of the Head"], "contexts": ["headache", "headache from hot chollerick humors"]}, {"entity_id": "dor_de_cabeça", "book_id": "coloquios_da_orta_1563", "name": "dor de cabeça", "category": "DISEASE", "subcategory": "SYMPTOM", "count": 2, "variants": ["dor de cabeça", "dor da cabeça"], "contexts": ["symptom caused by fragrance", "headache"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "pains of the Head", "target_book": "coloquios_da_orta_1563", "target_name": "dor de cabeça", "similarity": 0.919}], "id": 2964, "stable_key": "clu_014d5320551f027c", "ground_truth": {"modern_name": "Headache", "confidence": "high", "type": "disease", "modern_term": "Headache", "note": "The terms refer to the symptom of pain in the head, commonly known as headache.", "wikidata_id": "Q67841409", "wikidata_description": "various conditions with the symptom of headache"}, "cross_references": [{"found_name": "Pain", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 70, "target_cluster_name": "pain", "source_book": "llm_generated", "evidence_snippet": "Headache is a specific type of pain.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Headache is a specific type of pain."}, {"found_name": "Confusion", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2814, "target_cluster_name": "confusion", "source_book": "llm_generated", "evidence_snippet": "Severe headaches can sometimes lead to confusion.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Severe headaches can sometimes lead to confusion."}]}, {"canonical_name": "Bristol", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "bristol", "book_id": "english_physician_1652", "name": "Bristol", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Bristol"], "contexts": ["port city where plant is found", "place where the plant grows"]}, {"entity_id": "bristol", "book_id": "kosmos_humboldt_1845", "name": "Bristol", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Bristol"], "contexts": ["location of fossil discoveries"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Bristol", "target_book": "kosmos_humboldt_1845", "target_name": "Bristol", "similarity": 1.0}], "id": 2965, "stable_key": "clu_c79cd679709b1400", "ground_truth": {"modern_name": "Bristol", "confidence": "high", "type": "place", "country": "United Kingdom", "wikidata_id": "Q23154", "wikidata_description": "city in South West England, United Kingdom", "wikipedia_url": "https://en.wikipedia.org/wiki/Bristol", "wikipedia_extract": "Bristol ( ) is a city and ceremonial county in South West England. It is located on the River Avon, and bordered by Gloucestershire to the north and Somerset to the south with a short coastline on the Bristol Channel to the west. The county includes the majority of the Bristol conurbation, however, the urban area of the city extends into the neighbouring districts of South Gloucestershire, Bath and North East Somerset, and North Somerset. The county is almost entirely urbanised and had an estimated population of 494,399 in 2024, making Bristol the most populous city in the region. For local government purposes the county is a unitary authority area governed by Bristol City Council. The council is a member of the West of England Combined Authority, which allows it to collaborate with South Gloucestershire Council and Bath and North East Somerset Council."}, "cross_references": [{"found_name": "London", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 6, "target_cluster_name": "London", "source_book": "llm_generated", "evidence_snippet": "Bristol is another major city in England, often discussed in relation to London in historical contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Bristol is another major city in England, often discussed in relation to London in historical contexts.", "is_reverse": true}]}, {"canonical_name": "coltello", "category": "OBJECT", "subcategory": "TOOL", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "scalpel", "book_id": "relation_historique_humboldt_vol3_1825", "name": "scalpel", "category": "OBJECT", "subcategory": "TOOL", "count": 1, "variants": ["scalpel"], "contexts": ["surgical knife"]}, {"entity_id": "coltello", "book_id": "ricettario_fiorentino_1597", "name": "coltello", "category": "OBJECT", "subcategory": "TOOL", "count": 3, "variants": ["coltello"], "contexts": ["knife used for scraping roots", "knife for removing membranes"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "scalpel", "target_book": "ricettario_fiorentino_1597", "target_name": "coltello", "similarity": 0.935}], "id": 2966, "stable_key": "clu_57dffb3506dd4150", "ground_truth": {"modern_name": "Scalpel", "confidence": "high", "type": "object", "note": "Both 'coltello' (Italian for knife) and 'scalpel' refer to a surgical knife or a knife used for cutting and scraping."}, "cross_references": []}, {"canonical_name": "Buthler", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "butler", "book_id": "english_physician_1652", "name": "Butler", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Butler"], "contexts": ["author of a manuscript"]}, {"entity_id": "buthler", "book_id": "polyanthea_medicinal", "name": "Buthler", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Buthler"], "contexts": ["artificial stone remedy", "cited in relation to a remedy"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Butler", "target_book": "polyanthea_medicinal", "target_name": "Buthler", "similarity": 0.844}], "id": 2967, "stable_key": "clu_61ebe183d62a04b9", "ground_truth": {"modern_name": "Butler", "confidence": "medium", "type": "person", "description": "Author of medicinal texts, likely a physician or apothecary.", "note": "The exact identity of 'Buthler' or 'Butler' is unclear without further context. Assuming it refers to a specific author named Butler known for medical writings."}, "cross_references": []}, {"canonical_name": "corrupçao", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "corruption", "book_id": "english_physician_1652", "name": "Corruption", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Corruption"], "contexts": ["much Rhewm and Corruption"]}, {"entity_id": "corrupçao", "book_id": "polyanthea_medicinal", "name": "corrupçao", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 3, "variants": ["corrupçao"], "contexts": ["free from corruption", "corruption"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Corruption", "target_book": "polyanthea_medicinal", "target_name": "corrupçao", "similarity": 0.971}], "id": 2968, "stable_key": "clu_533fa5688473a316", "ground_truth": {"modern_name": "Corruption", "confidence": "medium", "type": "disease", "modern_term": "Infection or putrefaction", "note": "The term 'corrupçao'/'Corruption' in early modern texts often referred to a general sense of decay, putrefaction, or infection within the body, rather than a specific disease."}, "cross_references": []}, {"canonical_name": "materias", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "matter", "book_id": "english_physician_1652", "name": "matter", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["matter"], "contexts": ["discharge from the ears"]}, {"entity_id": "materias", "book_id": "polyanthea_medicinal", "name": "materias", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["materias", "materia ſeroſa"], "contexts": ["bodily discharge", "matters, to be drained"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "matter", "target_book": "polyanthea_medicinal", "target_name": "materias", "similarity": 0.952}], "id": 2969, "stable_key": "clu_346188b84b5c6fd4", "ground_truth": {"modern_name": "Bodily Discharge", "confidence": "high", "type": "concept", "note": "The term 'materias'/'matter' in this context refers to bodily fluids or substances expelled from the body.", "wikipedia_extract": "Heroic medicine can either refer to heroic therapy or to heroic drugs. Heroic therapy, also referred to as heroic depletion theory, was a therapeutic method advocating for rigorous treatment of bloodletting, purging, and sweating to shock the body back to health after an illness caused by a humoral imbalance. Rising to the front of orthodox medical practice in North America in the \"Age of Heroic Medicine\" (1780–1850), it fell out of favor in the mid-19th century as gentler treatments were shown to be more effective and the idea of palliative treatment began to develop. Heroic drugs, also called in English potent medicaments, was also a term used in Europe from the 18th to the 20th century to refer to certain potent pharmaceutical drugs. Pockets of medical methodology that can be classified as \"heroic\" appear in the early 17th century with Parisian physician Guy Patin and French anatomist Jean Riolan the Younger. Patin, nicknamed \"Le Grand Saigneur\" (the Grand Bloodletter), was infamous for his rigorous procedure plans, which included intensive courses of bloodletting and application of senna.", "wikipedia_url": "https://en.wikipedia.org/wiki/Heroic_medicine"}, "cross_references": [{"found_name": "parts", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 467, "target_cluster_name": "parts", "source_book": "llm_generated", "evidence_snippet": "Bodily discharges are produced by body parts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Bodily discharges are produced by body parts.", "is_reverse": true}, {"found_name": "Foemale Speedwel", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "english_physician_1652", "evidence_snippet": "may cure the Dis∣eas. It was at first called Foemale Speedwel, but a Shentle man of wales whose Nose was almost eaten off with the Pox, and so neer the matter, that the Docters commanded it to be cut ", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "alternative name"}, {"found_name": "Scriphion", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "english_physician_1652", "evidence_snippet": "first. Sea Wormwood hath gotten as many Names as Vertues (and perhaps one more) Scriphion, Santonicon, Belgicum, Narbonense, Xantomi∣cum, Misnense, and a matter of twenry more, which I will not blot P", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym"}, {"found_name": "Santonicon", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "english_physician_1652", "evidence_snippet": "first. Sea Wormwood hath gotten as many Names as Vertues (and perhaps one more) Scriphion, Santonicon, Belgicum, Narbonense, Xantomi∣cum, Misnense, and a matter of twenry more, which I will not blot P", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym"}, {"found_name": "Belgicum", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "english_physician_1652", "evidence_snippe