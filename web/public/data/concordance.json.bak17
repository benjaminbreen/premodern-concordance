 "feathers", "book_id": "first_principles_spencer_1862", "name": "feathers", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 3, "variants": ["feathers"], "contexts": ["animal covering, associated with birds", "light objects affected by air resistance"]}, {"entity_id": "plumage", "book_id": "origin_of_species_darwin_1859", "name": "Plumage", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 3, "variants": ["plumage", "Plumage"], "contexts": ["bird's feathers collectively", "feathers of birds"]}, {"entity_id": "plumage", "book_id": "first_principles_spencer_1862", "name": "plumage", "category": "ANIMAL", "subcategory": "PRODUCT", "count": 1, "variants": ["plumage"], "contexts": ["feathers of a bird"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "feathers", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "feathers", "similarity": 0.886}, {"source_book": "origin_of_species_darwin_1859", "source_name": "feathers", "target_book": "first_principles_spencer_1862", "target_name": "feathers", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "feathers", "target_book": "first_principles_spencer_1862", "target_name": "feathers", "similarity": 0.886}], "id": 1149, "stable_key": "clu_ee7c1c9b37fe5da0", "ground_truth": {"modern_name": "Feathers", "confidence": "high", "type": "concept", "note": "While feathers are derived from animals, the context here refers to the material itself rather than a specific animal.", "wikidata_id": "Q81025", "wikidata_description": "body-covering structure of some dinosaurs including birds", "wikipedia_url": "https://en.wikipedia.org/wiki/Feather", "wikipedia_extract": "Feathers are epidermal growths that form a distinctive outer covering, or plumage, on both avian (bird) and some non-avian dinosaurs and other archosaurs. They are the most complex integumentary structures found in vertebrates and an example of a complex evolutionary novelty. They are among the characteristics that distinguish the extant birds from other living groups. Although feathers cover most of the bird's body, they arise only from certain well-defined tracts on the skin. They aid in flight, thermal insulation, and waterproofing. In addition, coloration helps in communication and protection."}, "member_count": 5, "cross_references": [{"found_name": "wings", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 772, "target_cluster_name": "wings", "source_book": "llm_generated", "evidence_snippet": "Wings are a primary component of feathers in birds, and historical texts often discuss them in conjunction.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Wings are a primary component of feathers in birds, and historical texts often discuss them in conjunction.", "is_reverse": true}, {"found_name": "Hair", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 805, "target_cluster_name": "Hair", "source_book": "llm_generated", "evidence_snippet": "Both hair and feathers are proteinaceous epidermal outgrowths found in mammals and birds, respectively, serving protective and insulating functions.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both hair and feathers are proteinaceous epidermal outgrowths found in mammals and birds, respectively, serving protective and insulating functions.", "is_reverse": true}]}, {"canonical_name": "mud", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "mud", "book_id": "origin_of_species_darwin_1859", "name": "mud", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["mud"], "contexts": ["fine-grained soil from water", "adheres to bird feet, contains seeds"]}, {"entity_id": "argillaceous_mud", "book_id": "kosmos_humboldt_1845", "name": "argillaceous mud", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["argillaceous mud"], "contexts": ["flows from mud volcano basins"]}, {"entity_id": "mud", "book_id": "kosmos_humboldt_1845", "name": "mud", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["mud"], "contexts": ["wet earth"]}, {"entity_id": "mud", "book_id": "first_principles_spencer_1862", "name": "mud", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["mud"], "contexts": ["fine particles of earth and water", "sediment in still water"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "mud", "target_book": "kosmos_humboldt_1845", "target_name": "argillaceous mud", "similarity": 0.896}, {"source_book": "origin_of_species_darwin_1859", "source_name": "mud", "target_book": "kosmos_humboldt_1845", "target_name": "mud", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "mud", "target_book": "first_principles_spencer_1862", "target_name": "mud", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "argillaceous mud", "target_book": "first_principles_spencer_1862", "target_name": "mud", "similarity": 0.896}, {"source_book": "kosmos_humboldt_1845", "source_name": "mud", "target_book": "first_principles_spencer_1862", "target_name": "mud", "similarity": 1.0}], "id": 1150, "stable_key": "clu_95f635ba115c29e4", "ground_truth": {"modern_name": "Mud", "confidence": "high", "type": "concept", "wikidata_id": "Q967446", "wikidata_description": "town and district of Bolu Province, Turkey", "wikipedia_url": "https://en.wikipedia.org/wiki/Mudurnu", "wikipedia_extract": "Mudurnu is a small town in Bolu Province in the Black Sea region of Turkey, 52 km south-west of the city of Bolu. It is the seat of Mudurnu District. Its population is 5,379 (2021). The mayor is Necdet Türker (MHP), elected in 2019. The town has a long history and the name Mudurnu comes from the Byzantine princess Modrene (Μωδρηνή in Byzantine Greek), and the ruins of the Byzantine castle can still be seen above the town. In the 8th century AD, the forces of the Byzantine usurper Artabasdos, commanded by his son Niketas, were defeated at or near this location by the army of the legitimate emperor Constantine V, before being defeated again at Chrysopolis, the same location where Constantine the Great defeated his Eastern rival Licinius."}, "cross_references": [{"found_name": "sediment", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2732, "target_cluster_name": "sediment", "source_book": "llm_generated", "evidence_snippet": "Mud is a type of sediment.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Mud is a type of sediment.", "is_reverse": true}]}, {"canonical_name": "Armadillo", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "armadillo", "book_id": "origin_of_species_darwin_1859", "name": "armadillo", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["armadillo"], "contexts": ["animal with pieces of armour", "living mammal in South America"]}, {"entity_id": "armadillo", "book_id": "historia_medicinal_monardes_1574", "name": "Armadillo", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 3, "variants": ["Armadillo", "armadillo"], "contexts": ["animal from another nature", "animal covered in armor, like a horse"]}, {"entity_id": "armadillo", "book_id": "first_principles_spencer_1862", "name": "Armadillo", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Armadillo"], "contexts": ["mammal allied to Glyptodon"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "armadillo", "target_book": "historia_medicinal_monardes_1574", "target_name": "Armadillo", "similarity": 0.962}, {"source_book": "origin_of_species_darwin_1859", "source_name": "armadillo", "target_book": "first_principles_spencer_1862", "target_name": "Armadillo", "similarity": 0.962}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Armadillo", "target_book": "first_principles_spencer_1862", "target_name": "Armadillo", "similarity": 1.0}], "id": 1151, "stable_key": "clu_2e278f54c15bf49c", "ground_truth": {"modern_name": "armadillo", "confidence": "high", "type": "animal", "family": "Dasypodidae", "description": "South American mammal with a bony or leathery shell.", "wikipedia_extract": "Armadillos (Spanish for 'little armored ones') are New World placental mammals in the order Cingulata. They form part of the superorder Xenarthra, along with the anteaters and sloths. 21 extant species of armadillo have been described, some of which are distinguished by the number of bands on their armor. All species are native to the Americas, where they inhabit a variety of environments. Living armadillos are characterized by a leathery armor shell and long, sharp claws for digging. They have short legs, but can move quite quickly. The average length of an armadillo is about 75 cm (30 in), including its tail."}, "cross_references": [{"found_name": "Mammals", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 266, "target_cluster_name": "mammals", "source_book": "llm_generated", "evidence_snippet": "Armadillos are a type of mammal.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Armadillos are a type of mammal."}]}, {"canonical_name": "fossils", "category": "CONCEPT", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "fossil_species", "book_id": "origin_of_species_darwin_1859", "name": "fossil species", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["fossil species"], "contexts": ["remains of extinct organisms"]}, {"entity_id": "fossils", "book_id": "kosmos_humboldt_1845", "name": "fossils", "category": "ANIMAL", "subcategory": "OTHE