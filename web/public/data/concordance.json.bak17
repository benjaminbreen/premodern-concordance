target_cluster_name": "basalt", "source_book": "llm_generated", "evidence_snippet": "Olivine is a major constituent of basalt, a common extrusive igneous rock.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Olivine is a major constituent of basalt, a common extrusive igneous rock."}, {"found_name": "Diorite", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1717, "target_cluster_name": "diorite", "source_book": "llm_generated", "evidence_snippet": "Olivine can be found in some diorites, which are intermediate igneous rocks.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Olivine can be found in some diorites, which are intermediate igneous rocks."}, {"found_name": "Gneiss", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1625, "target_cluster_name": "gneiss", "source_book": "llm_generated", "evidence_snippet": "Olivine can occur in some metamorphic rocks like granulite, which can be related to gneiss.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Olivine can occur in some metamorphic rocks like granulite, which can be related to gneiss."}, {"found_name": "Granite", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1634, "target_cluster_name": "granite", "source_book": "llm_generated", "evidence_snippet": "While less common than in mafic rocks, olivine can be a minor constituent in some granitic rocks.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "While less common than in mafic rocks, olivine can be a minor constituent in some granitic rocks."}, {"found_name": "pyroxene", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2201, "target_cluster_name": "pyroxene", "source_book": "llm_generated", "evidence_snippet": "Olivine and pyroxene are common rock-forming silicate minerals often found together in mafic and ultramafic igneous rocks.", "confidenc