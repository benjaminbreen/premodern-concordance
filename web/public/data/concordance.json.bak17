species_darwin_1859", "source_name": "marine faunas", "target_book": "kosmos_humboldt_1845", "target_name": "marine animals", "similarity": 0.967}, {"source_book": "origin_of_species_darwin_1859", "source_name": "marine faunas", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Marine animals", "similarity": 0.955}, {"source_book": "kosmos_humboldt_1845", "source_name": "marine animals", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Marine animals", "similarity": 0.985}], "id": 1340, "stable_key": "clu_f33874b85769339a", "ground_truth": {"modern_name": "Marine animals", "confidence": "high", "type": "animal", "wikidata_id": "Q1230015", "wikidata_description": "Wjat", "wikipedia_url": "https://en.wikipedia.org/wiki/Marine%20life", "wikipedia_extract": "Marine life, which is also known as sea life or ocean life, refers to all the marine organisms that live in salt water habitats, or ecological communities that encompass all aquatic animals, plants, algae, fungi, protists, single-celled microorganisms and associated viruses living in the saline water of marine habitats, either the sea water of marginal seas and oceans, or the brackish water of coastal wetlands, lagoons, estuaries and inland seas. As of 2023, more than 242,000 marine species have been documented, and perhaps two million marine species are yet to be documented. On average, researches describe about 2,300 new marine species each year. The study of marine life spans into multiple fields, which is primarily marine biology, as well as biological oceanography. By volume, oceans provide about 90% of the living space on Earth, and served as the cradle of life and vital biotic sanctuaries throughout Earth's geological history. The earliest known life forms evolved as anaerobic prokaryotes (archaea and bacteria) in the Archean oceans around the deep sea hydrothermal vents, before photoautotrophs appeared and allowed the microbial mats to expand into shallow water marine environments."}, "cross_references": [{"found_name": "Animal Kingdom", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2373, "target_cluster_name": "animal kingdom", "source_book": "llm_generated", "evidence_snippet": "Marine animals are a subset of the Animal Kingdom.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Marine animals are a subset of the Animal Kingdom."}, {"found_name": "Animal life", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2437, "target_cluster_name": "animal life", "source_book": "llm_generated", "evidence_snippet": "Marine animals are a component of general animal life.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Marine animals are a component of general animal life."}, {"found_name": "Fauna", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 809, "target_cluster_name": "fauna", "source_book": "llm_generated", "evidence_snippet": "Marine animals constitute a significant part of the fauna of marine ecosystems.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Marine animals constitute a significant part of the fauna of marine ecosystems."}, {"found_name": "Man", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1774, "target_cluster_name": "Man", "source_book": "llm_generated", "evidence_snippet": "The West Indian manatee is a marine animal.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The West Indian manatee is a marine animal.", "is_reverse": true}]}, {"canonical_name": "ferns", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 3, "total_mentions": 4, "members": [{"entity_id": "ferns", "book_id": "origin_of_species_darwin_1859", "name": "ferns", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["ferns"], "contexts": ["plants included in numbers"]}, {"ent