 "is_reverse": true}, {"found_name": "agua de canela", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2635, "target_cluster_name": "agua de canela", "source_book": "llm_generated", "evidence_snippet": "Both are aromatic waters commonly used in historical medicine and perfumery, often prepared through distillation.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both are aromatic waters commonly used in historical medicine and perfumery, often prepared through distillation.", "is_reverse": true}, {"found_name": "Aromaticum Rosarum", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2702, "target_cluster_name": "Aromaticum Rosarum", "source_book": "llm_generated", "evidence_snippet": "Rosewater is a common ingredient or byproduct of processing roses for medicinal or aromatic purposes, making it directly related to 'Aromaticum Rosarum'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Rosewater is a common ingredient or byproduct of processing roses for medicinal or aromatic purposes, making it directly related to 'Aromaticum Rosarum'.", "is_reverse": true}, {"found_name": "balfamo", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3751, "target_cluster_name": "balfamo", "source_book": "llm_generated", "evidence_snippet": "Rosewater is often prepared using balsam and rose petals, and historically, balsam was a common ingredient in perfumery and medicinal preparations involving rose derivatives.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Rosewater is often prepared using balsam and rose petals, and historically, balsam was a common ingredient in perfumery and medicinal preparations involving rose derivatives.", "is_reverse": true}]}, {"canonical_name": "Suisse", "category": "PLACE", "subcategory": "COUNTRY", "book_count": 4, "total_mentions": 28, "members": [{"entity_id": "switzerland", "book_id": "origin_of_species_darwin_1859", "name": "Switzerland", "category": "PLACE", "subcategory": "COUNTRY", "count": 4, "variants": ["Switzerland"], "contexts": ["location of ant observations", "location where slaves and masters work together"]}, {"entity_id": "suisse", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Suisse", "category": "PLACE", "subcategory": "COUNTRY", "count": 15, "variants": ["Suisse"], "contexts": ["country in Europe", "country with Alps"]}, {"entity_id": "switzerland", "book_id": "kosmos_humboldt_1845", "name": "Switzerland", "category": "PLACE", "subcategory": "COUNTRY", "count": 1, "variants": ["Switzerland"], "contexts": ["country visited"]}, {"entity_id": "switzerland", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Switzerland", "category": "PLACE", "subcategory": "COUNTRY", "count": 8, "variants": ["Switzerland"], "contexts": ["country with lofty mountain peaks", "country where bise wind is found"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Switzerland", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Suisse", "similarity": 0.959}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Switzerland", "target_book": "kosmos_humboldt_1845", "target_name": "Switzerland", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Switzerland", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Switzerland", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Suisse", "target_book": "kosmos_humboldt_1845", "target_name": "Switzerland", "similarity": 0.959}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Suisse", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Switzerland", "similarity": 0.959}, {"source_book": "kosmos_humboldt_1845", "source_name": "Switzerland", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Switzerland", "similarity": 1.0}], "id": 293, "stable_key": "clu_988c30ace4f586da", "ground_truth": {"modern_name": "Switzerland", "confidence": "high", "type": "place", "description": "European country known for the Alps.", "wikipedia_extract": "Switzerland, officially the Swiss Confederation, is a landlocked country located at the intersection of Central, Western, and Southern Europe. It is bordered by Germany to the north, France to the west, Austria and Liechtenstein to the east, and Italy to the south. Switzerland is geographically divided among the Swiss Alps, the Swiss Plateau, and the Jura mountains; the Alps cover most of the country's territory, whereas the majority of its 9 million people are concentrated on the plateau, which hosts many of the largest cities and economic centres, including Zurich, Geneva, Basel, Bern, Lausanne, Winterthur, and Lucerne. Switzerland is a federal republic composed of 26 cantons, with Bern serving as the federal city and the seat of the national government. The country encompasses four principal linguistic and cultural regions—German, French, Italian, and Romansh—reflecting a long-standing tradition of multilingualism and cultural pluralism. Swiss national identity nonetheless remains fairly cohesive, rooted in a shared historical background, common values such as federalism and direct democracy, and Alpine symbolism."}, "cross_references": [{"found_name": "Central Europe", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2214, "target_cluster_name": "Central Europe", "source_book": "llm_generated", "evidence_snippet": "Switzerland is located at the intersection of Central, Western, and Southern Europe.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Switzerland is located at the intersection of Central, Western, and Southern Europe."}, {"found_name": "Europe", "link_type": "conceptual_overlap", "link_str