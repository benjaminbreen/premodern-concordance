ruth": {"modern_name": "Clay", "confidence": "high", "type": "mineral", "wikidata_id": "Q164192", "wikidata_description": "genus of plants", "wikipedia_url": "https://en.wikipedia.org/wiki/Claytonia", "note": "Argile and argilla are historical terms for clay.", "wikipedia_extract": "Claytonia (spring beauty) is a genus of flowering plants native to Asia, North America, and Central America. The vitamin-rich leaves can be eaten raw or cooked, and the tubers can be prepared like potatoes. The plants are somewhat fleshy and only a few centimeters in height. The flower heads are about 2.5 cm (1 inch) in diameter. The genus was formerly included in the purslane family (Portulacaceae), but with the adoption of the APG IV system, in 2009 it was moved to the family Montiaceae. A number of the species were formerly treated in the related genus Montia."}, "member_count": 13, "cross_references": [{"found_name": "earths", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1183, "target_cluster_name": "earths", "source_book": "llm_generated", "evidence_snippet": "Clay is a naturally occurring material composed primarily of fine-grained minerals, which is a specific type of 'earth' in a geological context.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Clay is a naturally occurring material composed primarily of fine-grained minerals, which is a specific type of 'earth' in a geological context.", "is_reverse": true}, {"found_name": "sand", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 14, "target_cluster_name": "sand", "source_book": "llm_generated", "evidence_snippet": "Sand is a textural class of soil, alongside clay and silt.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Sand is a textural class of soil, alongside clay and silt.", "is_reverse": true}, {"found_name": "stone", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1