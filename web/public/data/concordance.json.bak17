ntity_id": "knife", "book_id": "polyanthea_medicinal", "name": "knife", "category": "OBJECT", "subcategory": "TOOL", "count": 16, "variants": ["Knife", "knife"], "contexts": ["a cutting instrument", "cutting tool"]}, {"entity_id": "knife", "book_id": "connexion_physical_sciences_somerville_1858", "name": "knife", "category": "OBJECT", "subcategory": "TOOL", "count": 1, "variants": ["knife"], "contexts": ["cutting instrument"]}, {"entity_id": "knife", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Knife", "category": "OBJECT", "subcategory": "TOOL", "count": 1, "variants": ["Knife"], "contexts": ["steel object attracted by needle"]}, {"entity_id": "knife", "book_id": "english_physician_1652", "name": "Knife", "category": "OBJECT", "subcategory": "TOOL", "count": 1, "variants": ["Knife"], "contexts": ["cutting instrument"]}, {"entity_id": "knife", "book_id": "ricettario_fiorentino_1597", "name": "Knife", "category": "OBJECT", "subcategory": "TOOL", "count": 1, "variants": ["Knife"], "contexts": ["cutting tool"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "knife", "target_book": "polyanthea_medicinal", "target_name": "knife", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "knife", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "knife", "similarity": 1.0}, {"source_book": "polyanthea_medicinal", "source_name": "knife", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "knife", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Knife", "target_book": "english_physician_1652", "target_name": "Knife", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Knife", "target_book": "ricettario_fiorentino_1597", "target_name": "Knife", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Knife", "target_book": "ricettario_fiorentino_1597", "target_name": "Knife", "similarity": 1.0}], "id": 26, "stable_key": "clu_f7ea7e3fcbdbcb73", "ground_truth": {"modern_name": "Knife", "confidence": "high", "type": "object", "wikidata_id": "Q32489", "wikidata_description": "tool with a cutting edge or blade", "wikipedia_url": "https://en.wikipedia.org/wiki/Knife", "wikipedia_extract": "A knife (pl.: knives; from Old Norse knifr 'knife, dirk') is a tool or weapon with a cutting edge or blade, usually attached to a handle or hilt. One of the earliest tools used by humanity, knives appeared at least 2.5 million years ago, as evidenced by the Oldowan tools. Originally made of wood, bone, and stone (such as flint and obsidian), over the centuries, in step with improvements in both metallurgy and manufacturing, knife blades have been made from copper, bronze, iron, steel, ceramic, and titanium. Most modern knives have fixed or folding blades, with styles varying by maker and country. Knives can serve various purposes. Hunters use a hunting knife, soldiers use the combat knife, scouts, campers, and hikers carry a pocketknife; there are kitchen knives for preparing foods (the chef's knife, the paring knife, bread knife, cleaver), table knife (butter knives and steak knives), weapons (daggers or switchblades), knives for throwing or juggling, and knives for religious ceremony or display (the kirpan)."}, "cross_references": []}, {"canonical_name": "Humidity", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 6, "total_mentions": 18, "members": [{"entity_id": "humidity", "book_id": "kosmos_humboldt_1845", "name": "Humidity", "category": "CONCEPT", "subcategory": "QUALITY", "count": 5, "variants": ["humidity", "Humidity"], "contexts": ["moisture content of atmosphere", "measure of water vapor in air"]}, {"entity_id": "humidad", "book_id": "historia_medicinal_monardes_1574", "name": "humidad", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["humidad"], "contexts": ["moisture", "consumes its superfluous humidity"]}, {"entity_id": "humidade", "book_id": "coloquios_da_orta_1563", "name": "humidade", "category": "CONCEPT", "subcategory": "QUALITY", "count": 4, "variants": ["humidade"], "contexts": ["primary quality: moisture", "property of gengivre"]}, {"entity_id": "humidité", "book_id": "relation_historique_humboldt_vol3_1825", "name": "humidité", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["humidité"], "contexts": ["measure of moisture in the air", "stimulant for vegetation"]}, {"entity_id": "humidity", "book_id": "connexion_physical_sciences_somerville_1858", "name": "humidity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["humidity"], "contexts": ["measure of water vapor in the air", "water vapor in the air"]}, {"entity_id": "humidity", "book_id": "first_principles_spencer_1862", "name": "humidity", "category": "CONCEPT", "subcategory": "QUALITY", "count": 2, "variants": ["humidity"], "contexts": ["moisture in the air"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Humidity", "target_book": "historia_medicinal_monardes_1574", "target_name": "humidad", "similarity": 0.977}, {"source_book": "kosmos_humboldt_1845", "source_name": "Humidity", "target_book": "coloquios_da_orta_1563", "target_name": "humidade", "similarity": 0.981}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "humidad", "target_book": "coloquios_da_orta_1563", "target_name": "humidade", "similarity": 0.997}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "humidité", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "humidity", "similarity": 0.996}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "humidité", "target_book": "first_principles_spencer_1862", "target_name": "humidity", "similarity": 0.996}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "humidity", "target_book": "first_principles_spencer_1862", "target_name": "humidity", "similarity": 1.0}], "id": 27, "stable_key": "clu_7c50c9966182ad91", "ground_truth": {"modern_name": "Humidity", "confidence": "high", "type": "concept", "wikidata_id": "Q180600", "wikidata_description": "amount of water vapor in the air", "wikipedia_url": "https://en.wikipedia.org/wiki/Humidity", "wikipedia_extract": "Humidity is the concentration of water vapor present in the air. Water vapor, the gaseous state of water, is generally invisible to the naked eye. Humidity indicates the likelihood for precipitation, dew, or fog to be present. Humidity depends on the temperature and pressure of the system of interest. The same amount of water vapor results in higher relative humidity in cool air than warm air. A related parameter is the dew point."}, "cross_references": [{"found_name": "moist", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 200, "target_cluster_name": "moist", "source_book": "llm_generated", "evidence_snippet": "The entity 'moist' is directly related to the concept of 'humidity' as its defining characteristic.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The entity 'moist' is directly related to the concept of 'humidity' as its defining characteristic.", "is_reverse": true}, {"found_name": "humido", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 537, "target_cluster_name": "humido", "source_book": "llm_generated", "evidence_snippet": "Both 'Moisture' and 'Humidity' refer to the presence of water or vapor in the air or other substance.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: Both 'Moisture' and 'Humidity' refer to the presence of water or vapor in the air or other substance.", "is_reverse": true}, {"found_name": "Atmospheric", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4409, "target_cluster_name": "atmospheric", "source_book": 