ncer_1862", "name": "dancing", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 4, "variants": ["Dancing", "dancing"], "contexts": ["art form originating from rhythm in motion", "art form"]}], "edges": [{"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "dancing", "target_book": "first_principles_spencer_1862", "target_name": "dancing", "similarity": 1.0}], "id": 2899, "stable_key": "clu_6168adc466d86210", "ground_truth": {"modern_name": "dancing", "confidence": "high", "type": "concept", "wikipedia_extract": "Dance is an art form, consisting of sequences of body movements with aesthetic and often symbolic value, either improvised or purposefully selected. Dance can be categorized and described by its choreography, by its repertoire of movements or by its historical period or place of origin. Dance is typically performed with musical accompaniment, and sometimes with the dancer simultaneously using a musical instrument themselves. Two common types of group dance are theatrical and participatory dance. Both types of dance may have special functions, whether social, ceremonial, competitive, erotic, martial, sacred or liturgical. Dance is not solely restricted to performance, as dance is used as a form of exercise and occasionally training for other sports and activities."}, "cross_references": [{"found_name": "Art", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1556, "target_cluster_name": "Arte", "source_book": "llm_generated", "evidence_snippet": "Dance is a form of art.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Dance is a form of art."}, {"found_name": "Arts", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 478, "target_cluster_name": "Arts", "source_book": "llm_generated", "evidence_snippet": "Dance is a form of art.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Dance is a form of art."}, {"found_name": "Bodily action", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3565, "target_cluster_name": "bodily action", "source_book": "llm_generated", "evidence_snippet": "Dance is a form of bodily action.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Dance is a form of bodily action."}, {"found_name": "Fine arts", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4312, "target_cluster_name": "fine arts", "source_book": "llm_generated", "evidence_snippet": "Dance is considered a fine art.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Dance is considered a fine art."}]}, {"canonical_name": "nervous action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "nerve-action", "book_id": "principles_of_psychology_james_1890", "name": "nerve-action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["nerve-action"], "contexts": ["activity of nerves"]}, {"entity_id": "nervous_action", "book_id": "first_principles_spencer_1862", "name": "nervous action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["nervous action"], "contexts": ["fundamental law of physiological processes", "physiological process in the nervous system"]}, {"entity_id": "nervous_action", "book_id": "principles_of_psychology_james_1890", "name": "nervous action", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["nervous action"], "contexts": ["change in nervous centre"]}, {"entity_id": "nervous_activity", "book_id": "first_principles_spencer_1862", "name": "nervous activity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["nervous activity"], "contexts": ["stimulation of nerves"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "nerve-action", "target_book": "first_principles_