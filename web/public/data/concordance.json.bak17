: "reverse: Rodents are a specific order of mammals.", "is_reverse": true}, {"found_name": "Quadruped", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 369, "target_cluster_name": "quadrupeds", "source_book": "llm_generated", "evidence_snippet": "Rodents are typically quadrupeds.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Rodents are typically quadrupeds."}, {"found_name": "Mouse", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1005, "target_cluster_name": "Mice", "source_book": "llm_generated", "evidence_snippet": "Mice are a common and well-known type of rodent.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Mice are a common and well-known type of rodent."}, {"found_name": "Squirrel", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3292, "target_cluster_name": "squirrels", "source_book": "llm_generated", "evidence_snippet": "Squirrels are a common and well-known type of rodent.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Squirrels are a common and well-known type of rodent."}, {"found_name": "Hare", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1009, "target_cluster_name": "hares", "source_book": "llm_generated", "evidence_snippet": "Hares are often grouped with rodents due to superficial similarities, though they belong to a different order (Lagomorpha).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Hares are often grouped with rodents due to superficial similarities, though they belong to a different order (Lagomorpha)."}, {"found_name": "Rabbit", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2036, "target_cluster_name": "Rabbit", "source_book": "llm_generated", "evidence_snippet": "Rabbits are often grouped with rodents due to superficial similarities, though they belong to a different order (L