ay travel through the air or water."}, "cross_references": [{"found_name": "Agaric fungus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 567, "target_cluster_name": "Agarico", "source_book": "llm_generated", "evidence_snippet": "Agaric fungus is a specific type of fungus, often referring to mushrooms.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Agaric fungus is a specific type of fungus, often referring to mushrooms."}]}, {"canonical_name": "Error", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 5, "total_mentions": 13, "members": [{"entity_id": "error", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Error", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["error", "Error"], "contexts": ["opposite of truth and infallibility", "false judgment of things, assent unto falsity"]}, {"entity_id": "error", "book_id": "principles_of_psychology_james_1890", "name": "error", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["error", "ERROR"], "contexts": ["mistake or deviation from correctness", "a mistake or inaccuracy"]}, {"entity_id": "erros", "book_id": "coloquios_da_orta_1563", "name": "erros", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["erros"], "contexts": ["consequences of equivocation"]}, {"entity_id": "errori", "book_id": "ricettario_fiorentino_1597", "name": "Errori", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["Errori"], "contexts": ["concept of mistakes"]}, {"entity_id": "error", "book_id": "first_principles_spencer_1862", "name": "error", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["error"], "contexts": ["absence of accurate correspondence leading to failure"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Error", "target_book": "principles_of_psychology_james_1890", "