": "polarity", "confidence": "high", "type": "concept", "note": "Refers to forces or properties exhibiting opposing characteristics, often related to magnetism or philosophical dualities.", "wikidata_id": "Q2101088", "wikidata_description": "board game that requires strategic thinking and dexterity to control hovering magnetic discs", "wikipedia_url": "https://en.wikipedia.org/wiki/Polarity%20%28game%29", "wikipedia_extract": "Polarity is a board game that requires strategic thinking and dexterity to control hovering magnetic discs. Polarity was invented in 1985 by Canadian artist and designer Douglas Seaton. It was first published in 1986. The game has had a tumultuous past, with production changing hands several times over the past four decades. The game has been published by Telemotion Technologies, Irwin Toy, briefly with Mattel and most recently by Temple Games. The game ships in a canvas sleeve and include the magnets, the board, and a paper rulebook."}, "cross_references": [{"found_name": "Diamagnetic Polarity", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2841, "target_cluster_name": "diamagnetic polarity", "source_book": "llm_generated", "evidence_snippet": "Diamagnetic Polarity is a specific type of polarity, making it a closely related concept within the broader field of physics and magnetism.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Diamagnetic Polarity is a specific type of polarity, making it a closely related concept within the broader field of physics and magnetism."}]}, {"canonical_name": "atmospheric resistance", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "atmospheric_resistance", "book_id": "kosmos_humboldt_1845", "name": "atmospheric resistance", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["atmospheric resistance"], "contexts": ["force opposing motion through atmosphere"]}, {"entity_id": "resistance_of_the_air", "book_id": "connexion_physical_sciences_somerville_1858", "name": "resistance of the air", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["resistance of the air"], "contexts": ["force opposing motion through air"]}, {"entity_id": "atmospheric_resistance", "book_id": "first_principles_spencer_1862", "name": "atmospheric resistance", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["atmospheric resistance"], "contexts": ["force opposing motion"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "atmospheric resistance", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "resistance of the air", "similarity": 0.905}, {"source_book": "kosmos_humboldt_1845", "source_name": "atmospheric resistance", "target_book": "first_principles_spencer_1862", "target_name": "atmospheric resistance", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "resistance of the air", "target_book": "first_principles_spencer_1862", "target_name": "atmospheric resistance", "similarity": 0.905}], "id": 1475, "stable_key": "clu_5a6f4c5bb7e4e3e0", "ground_truth": {"modern_name": "air resistance", "confidence": "high", "type": "concept", "wikidata_id": "Q206621", "wikidata_description": "retarding force on a body moving in a fluid", "wikipedia_url": "https://en.wikipedia.org/wiki/Drag%20%28physics%29", "wikipedia_extract": "In fluid dynamics, drag, sometimes referred to as fluid resistance, also known as viscous force, is a force acting opposite to the direction of motion of any object moving with respect to a surrounding fluid. This can exist between two fluid layers, or between a fluid and a solid surface. Drag forces tend to decrease fluid velocity relative to the solid object in the fluid's path. Unlike other resistive forces, drag force depends on velocity. Drag force is proportional to the relative velocity for low-speed flow and is proportional to the velocity squared for high-speed flow. This distinction between low and high-speed flow is measured by the Reynolds number."}, "cross_references": [{"found_name": "Atmospheric", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4409, "target_cluster_name": "atmospheric", "source_book": "llm_generated", "evidence_snippet": "The term 'atmospheric resistance' is a specific type of resistance that occurs within the atmosphere, making 'Atmospheric' a directly related concept.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The term 'atmospheric resistance' is a specific type of resistance that occurs within the atmosphere, making 'Atmospheric' a directly related concept."}]}, {"canonical_name": "periodicity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 3, "members": [{"entity_id": "periodicity", "book_id": "kosmos_humboldt_1845", "name": "periodicity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["periodicity"], "contexts": ["recurring nature of phenomena"]}, {"entity_id": "periodicity", "book_id": "connexion_physical_sciences_somerville_1858", "name": "periodicity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["periodicity"], "contexts": ["laws governing cycles"]}, {"entity_id": "periodicities", "book_id": "first_principles_spencer_1862", "name": "periodicities", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["periodicities"], "contexts": ["occurrence at regular intervals"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "periodicity", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "periodicity", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "periodicity", "target_book": "first_principles_spencer_1862", "target_name": "periodicities", "simila