me": "Powder", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "powder", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Powder", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["Powder"], "contexts": ["component of gunpowder", "explosive mixture"]}, {"entity_id": "powder", "book_id": "english_physician_1652", "name": "Powder", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["Powder"], "contexts": ["dried herb for wounds and ulcers"]}, {"entity_id": "poudre", "book_id": "relation_historique_humboldt_vol3_1825", "name": "poudre", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["poudre"], "contexts": ["signals for surveying"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Powder", "target_book": "english_physician_1652", "target_name": "Powder", "similarity": 0.755}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Powder", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "poudre", "similarity": 0.889}], "id": 1120, "stable_key": "clu_4869f9fa582beaf5", "ground_truth": {"modern_name": "Powder", "confidence": "high", "type": "chemical", "note": "This could refer to various powdered substances, but 'gunpowder' is a strong contextual clue. 'Poudre' also strongly suggests a powdered form of a substance.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_extract": "A powder is a dry solid composed of many very fine particles that may flow freely when shaken or tilted. Powders are a special sub-class of granular materials, although the terms powder and granular are sometimes used to distinguish separate classes of material. In particular, powders refer to those granular materials that have the finer grain sizes, and that therefore have a greater tendency to form clumps when flowing. Granulars refer to the coarser granular materials that do not tend to form clumps except when wet. Many manufactured goods come in powder form, such as flour, sugar, ground coffee, powdered milk, copy machine toner, gunpowder, cosmetic powders, and some pharmaceuticals. In nature, dust, fine sand and snow, volcanic ash, and the top layer of the lunar regolith are also examples.", "wikipedia_url": "https://en.wikipedia.org/wiki/Powder"}, "cross_references": [{"found_name": "Gunpowder", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1058, "target_cluster_name": "Gunpowder", "source_book": "llm_generated", "evidence_snippet": "Gunpowder is a specific type of powder, often discussed in historical texts.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "Gunpowder is a specific type of powder, often discussed in historical texts."}, {"found_name": "Sand", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 14, "target_cluster_name": "sand", "source_book": "llm_generated", "evidence_snippet": "Sand is a granular material composed of finely divided rock and mineral particles, fitting the description of a powder.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Sand is a granular material composed of finely divided rock and mineral particles, fitting the description of a powder."}, {"found_name": "Ash", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1766, "target_cluster_name": "Cinza", "source_book": "llm_generated", "evidence_snippet": "Ash is the powdery residue left after the burning of a substance, and is a common example of a powder in historical contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Ash is the powdery residue left after the burning of a substance, and is a common example of a powder in historical contexts."}, {"found_name": "Earthy substances", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3845, "target_cluster_name": "Terreous Bodies", "source_book": "llm_generated", "evidence_snippet": "Earthy substances are often found in a powdery form and are a broad category that would include many specific powders.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Earthy substances are often found in a powdery form and are a broad category that would include many specific powders."}, {"found_name": "Minerals", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 138, "target_cluster_name": "minerals", "source_book": "llm_generated", "evidence_snippet": "Many minerals can be processed into powders, and 'powder' is a common physical state for minerals in various applications.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Many minerals can be processed into powders, and 'powder' is a common physical state for minerals in various applications."}]}, {"canonical_name": "contradiction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 6, "members": [{"entity_id": "contradiction", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "contradiction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["contradiction", "Contradiction"], "contexts": ["opposition to ideas", "opposition to an idea"]}, {"entity_id": "contradiction", "book_id": "principles_of_psychology_james_1890", "name": "contradiction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["contradiction"], "contexts": ["logical inconsistency", "relationship of opposition between statements"]}, {"entity_id": "contradictions", "book_id": "principles_of_psychology_james_1890", "name": "contradictions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["contradictions"], "contexts": ["statements or ideas that are opposed"]}, {"entity_id": "contradictories", "book_id": "first_principles_s