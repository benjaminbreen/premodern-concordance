PT", "count": 3, "variants": ["center of gravity"], "contexts": ["point of balance for orbiting bodies", "point where weight is balanced"]}, {"entity_id": "centre_of_gravity", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Centre of gravity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 8, "variants": ["Centre of gravity", "centre of gravity"], "contexts": ["point where gravity acts", "point of gravitational balance"]}, {"entity_id": "centre_of_gravity", "book_id": "first_principles_spencer_1862", "name": "centre of gravity", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["centre of gravity"], "contexts": ["destination of Earth's substance motion", "point towards which matter is drawn"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "centre of gravity", "target_book": "kosmos_humboldt_1845", "target_name": "center of gravity", "similarity": 0.997}, {"source_book": "principles_of_psychology_james_1890", "source_name": "centre of gravity", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Centre of gravity", "similarity": 0.993}, {"source_book": "principles_of_psychology_james_1890", "source_name": "centre of gravity", "target_book": "first_principles_spencer_1862", "target_name": "centre of gravity", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "center of gravity", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Centre of gravity", "similarity": 0.987}, {"source_book": "kosmos_humboldt_1845", "source_name": "center of gravity", "target_book": "first_principles_spencer_1862", "target_name": "centre of gravity", "similarity": 0.997}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Centre of gravity", "target_book": "first_principles_spencer_1862", "target_name": "centre of gravity", "similarity": 0.993}], "id": 346, "stable_key": "clu_2e1b6cbc76d76f33", "ground_truth": {"modern_name": "Center of gravity", "confidence": "high", "type": "concept", "wikidata_id": "Q1110236", "wikidata_description": "military concept", "wikipedia_url": "https://en.wikipedia.org/wiki/Center%20of%20gravity%20%28military%29", "wikipedia_extract": "Center of gravity (COG) is a military concept referring to the primary source of strength, balance, or stability necessary for a force to maintain combat operations. Centers of gravity can be physical, moral, or both, and exist for all belligerents at all tactical, strategic, and operational levels of war simultaneously. COGs play a central role in military planning, though exact definition has been elusive, with interpretations varying substantially over time, across forces, and between theorists. Generally, a COG can be thought of as an essential part of a combatant's warfighting system, interference with which would result in disproportionate impact on their combat effectiveness. The concept was first developed by Carl von Clausewitz, a Prussian military theorist, in his work On War. After the end of the Vietnam War, interest in the idea was revitalized, resulting in several competing conceptualizations."}, "cross_references": [{"found_name": "Absolute power", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4263, "target_cluster_name": "absolute power", "source_book": "llm_generated", "evidence_snippet": "The concept of 'center of gravity' in a military context refers to the primary source of strength and stability. 'Absolute power' can be seen as a related concept, as a concentration of absolute power could potentially become a center of gravity for a state or ruler.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The concept of 'center of gravity' in a military context refers to the primary source of strength and stability. 'Absolute power' can be seen as a related concept, as a concentration of absolute power could potentially become a center of gravity for a state or ruler."}, {"found_name": "Authority", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 355, "target_cluster_name": "Authority", "source_book": "llm_generated", "evidence_snippet": "Similar to 'Absolute power', 'Authority' can be a source of strength and stability, thus potentially acting as a center of gravity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Similar to 'Absolute power', 'Authority' can be a source of strength and stability, thus potentially acting as a center of gravity."}, {"found_name": "Constitution", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1128, "target_cluster_name": "Constitution", "source_book": "llm_generated", "evidence_snippet": "In a military or political context, the 'constitution' of a nation or organization can represent its fundamental structure and source of stability, making it a potential center of gravity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "In a military or political context, the 'constitution' of a nation or organization can represent its fundamental structure and source of stability, making it a potential center of gravity."}, {"found_name": "Equilibrium", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 247, "target_cluster_name": "equilibrium", "source_book": "llm_generated", "evidence_snippet": "The 'center of gravity' is intrinsically linked to the concept of balance and stability, which are core components of 'equilibrium'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The 'center of gravity' is intrinsically linked to the concept of balance and stability, which are core components of 'equilibrium'."}, {"found_name": "Force", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 59, "target_cluster_name": "Force", "source_book": "llm_generated", "evidence_snippet": "The 'center of gravity' is defined as the primary source of strength and stability, which are manifestations of 'force'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The 'center of gravity' is defined as the primary source of strength and stability, which are manifestations of 'force'."}]}, {"canonical_name": "Bones", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 18, "members": [{"entity_id": "bones", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Bones", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["Bones", "bones"], "contexts": ["skeletal structures", "structures formed in embryonic development"]}, {"entity_id": "bones", "book_id": "english_physician_1652", "name": "Bones", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 14, "variants": ["Bones", "Bone"], "contexts": ["rigid connective tissue forming skeleton", "part covered with flesh by Angelica"]}, {"entity_id": "bones", "book_id": "principles_of_psychology_james_1890", "name": "bones", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["bones"], "contexts": ["rigid skeletal structures"]}, {"entity_id": "bones", "book_id": "first_principles_spencer_1862", "name": "bones", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["bones"], "contexts": ["skeletal structures with articular surfaces"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Bones", "target_book": "english_physician_1652", "target_name": "Bones", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "bones", "target_book": "first_principles_spencer_1862", "target_name": "bones", "similarity": 1.0}], "id": 347, "stable_key": "clu_51df70e8628f94ae", "ground_truth": {"modern_name": "Bones", "confidence": "high", "type": "object", "wikidata_id": "Q265868", "wikidata_description": "rigid organ that constitutes part of the endoskeleton of vertebrates", "wikipedia_url": "https://en.wikipedia.org/wiki/Bone", "wikipedia_extract": "A bone is a rigid organ that constitutes part of the skeleton in most vertebrate animals. Bones protect the organs of the body, produce red and white blood cells, store minerals, help regulate acid-base homeostasis, provide structure and support for the body, and enable mobility and hearing. Bones come in a variety of shapes and sizes and have complex internal and external structures. Bone tissue (also known as osseous tissue or bone in the uncountable) is a form of hard tissue, specialised connective tissue that is mineralized and has an intercellular honeycomb-like matrix, which helps to give the bone rigidity. Bone tissue is made up of different types of bone cells: osteoblasts and osteocytes (bone formation and mineralisation); osteoclasts (bone resorption); modified or flattened osteoblasts (lining cells that form a protective layer on the bone surface). The mineralised matrix of bone tissue has an organic component of mainly ossein, a form of collagen, and an inorganic component of bone mineral, made up of various salts."}, "cross_references": [{"found_name": "organs of motion", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 429, "target_cluster_name": "organs of motion", "source_book": "llm_generated", "evidence_snippet": "Bones are a fundamental component of the musculoskeletal system.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Bones are a fundamental component of the musculoskeletal system.", "is_reverse": true}, {"found_name": "spine", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 457, "target_cluster_name": "spine", "source_book": "llm_generated", "evidence_snippet": "The spine is a major component of the skeletal system, composed of numerous bones (vertebrae).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The spine is a major component of the skeletal system, composed of numerous bones (vertebrae).", "is_reverse": true}, {"found_name": "parts", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 467, "target_cluster_name": "parts", "source_book": "llm_generated", "evidence_snippet": "Bones are a type of body part forming the skeletal structure.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Bones are a type of body part forming the skeletal structure.", "is_reverse": true}, {"found_name": "ligamentos", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3334, "target_cluster_name": "ligamentos", "source_book": "llm_generated", "evidence_snippet": "Ligaments connect bones to other bones.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Ligaments connect bones to other bones.", "is_reverse": true}, {"found_name": "ribs", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1426, "target_cluster_name": "ribs", "source_book": "llm_generated", "evidence_snippet": "Ribs are a type of bone and form part of the skeletal system.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Ribs are a type of bone and form part of the skeletal system.", "is_reverse": true}, {"found_name": "joints", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2261, "target_cluster_name": "joints", "source_book": "llm_generated", "evidence_snippet": "Joints are the articulations between bones.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Joints are the articulations between bones.", "is_reverse": true}, {"found_name": "pétrifications", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2932, "target_cluster_name": "pétrifications", "source_book": "llm_generated", "evidence_snippet": "Bones are a common component of fossils.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Bones are a common component of fossils.", "is_reverse": true}]}, {"canonical_name": "crustaceans", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 4, "total_mentions": 23, "members": [{"entity_id": "crustaceans", "book_id": "origin_of_species_darwin_1859", "name": "crustaceans", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 8, "variants": ["Crustaceans", "crustaceans"], "contexts": ["animals with graduated eye structures", "extinct Silurian crustaceans that changed greatly"]}, {"entity_id": "cetáceos", "book_id": "coloquios_da_orta_1563", "name": "cetáceos", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["cetáceos", "cetáceo"], "contexts": ["source of amber", "marine mammals caught in nets"]}, {"entity_id": "crustacean", "book_id": "origin_of_species_darwin_1859", "name": "crustacean", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["crustacean"], "contexts": ["type of arthropod, ancestor of trilobites", "type of arthropod, including barnacles"]}, {"entity_id": "crustaceans", "book_id": "kosmos_humboldt_1845", "name": "crustaceans", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Crustaceans", "crustaceans"], "contexts": ["arthropods with exoskeletons", "small aquatic arthropods in amber"]}, {"entity_id": "crustaceans", "book_id": "first_principles_spencer_1862", "name": "crustaceans", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["crustaceans"], "contexts": ["higher division of Annulosa with reduced segments", "arthropods with exoskeletons, like crabs"]}, {"entity_id": "crustacea", "book_id": "origin_of_species_darwin_1859", "name": "Crustacea", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 2, "variants": ["Crustacea"], "contexts": ["water-breathing classes adapted to land", "arthropod subphylum including crabs and lobsters"]}, {"entity_id": "crustacea", "book_id": "kosmos_humboldt_1845", "name": "Crustacea", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 3, "variants": ["Crustacea"], "contexts": ["fossil animal group", "swarming in oceanic waters"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "crustaceans", "target_book": "coloquios_da_orta_1563", "target_name": "cetáceos", "similarity": 0.907}, {"source_book": "origin_of_species_darwin_1859", "source_name": "crustacean", "target_book": "kosmos_humboldt_1845", "target_name": "crustaceans", "similarity": 0.98}, {"source_book": "origin_of_species_darwin_1859", "source_name": "crustacean", "target_book": "first_principles_spencer_1862", "target_name": "crustaceans", "similarity": 0.98}, {"source_book": "kosmos_humboldt_1845", "source_name": "crustaceans", "target_book": "first_principles_spencer_1862", "target_name": "crustaceans", "similarity": 1.0}], "id": 348, "stable_key": "clu_bef535649fd1ac06", "ground_truth": {"modern_name": "Crustaceans", "confidence": "high", "type": "animal", "note": "The mention of 'cetáceos' (cetaceans) in the context of Garcia de Orta's Colloquios is likely a misidentification or OCR error, as 'cetáceos' refers to whales and dolphins, not crustaceans. The dominant theme points to crustaceans.", "wikidata_id": "Q25364", "wikidata_description": "subphylum of arthropods", "wikipedia_url": "https://en.wikipedia.org/wiki/Crustacean", "wikipedia_extract": "Crustaceans (from Latin word \"crustacea\" meaning: \"those with shells\" or \"crusted ones\") are invertebrate animals that constitute one group of arthropods that are traditionally a part of the subphylum Crustacea (), a large, diverse group of mainly aquatic arthropods including the more familiar decapods (shrimps, prawns, crabs, lobsters and crayfish), seed shrimps, branchiopods, fish lice, krill, remipedes, isopods, barnacles, copepods, opossum shrimps, amphipods and mantis shrimp. The crustacean group can be treated as a subphylum under the clade Mandibulata. It is now well accepted that the hexapods (insects and entognathans) emerged deep in the crustacean group, with the completed pan-group referred to as Pancrustacea. The three classes Cephalocarida, Branchiopoda and Remipedia are more closely related to the hexapods than they are to any of the other crustaceans (oligostracans and multicrustaceans). The 67,000 described species range in size from Stygotantulus stocki at 0.1 mm (0.004 in), to the Japanese spider crab with a leg span of up to 3.8 m (12.5 ft) and a mass of 20 kg (44 lb). Like other arthropods, crustaceans have an exoskeleton, which they moult to grow."}, "member_count": 7, "cross_references": [{"found_name": "Cephalopodes", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1187, "target_cluster_name": "Cephalopodes", "source_book": "llm_generated", "evidence_snippet": "Cephalopodes and Crustaceans are both distinct groups of invertebrates, often discussed together in zoological contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Cephalopodes and Crustaceans are both distinct groups of invertebrates, often discussed together in zoological contexts."}, {"found_name": "Crabs", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 444, "target_cluster_name": "Crabs", "source_book": "llm_generated", "evidence_snippet": "Crabs are a type of crustacean.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Crabs are a type of crustacean.", "is_reverse": true}, {"found_name": "Trilobites", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 959, "target_cluster_name": "Trilobites", "source_book": "llm_generated", "evidence_snippet": "Trilobites are arthropods, and crustaceans are a subphylum of arthropods. While not directly crustaceans, they share a common ancestral lineage and body plan characteristics.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Trilobites are arthropods, and crustaceans are a subphylum of arthropods. While not directly crustaceans, they share a common ancestral lineage and body plan characteristics.", "is_reverse": true}, {"found_name": "shell-fish", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1016, "target_cluster_name": "shell-fish", "source_book": "llm_generated", "evidence_snippet": "Shellfish is a broad category that historically included crustaceans, though modern classification separates them. Texts from the period often grouped them together.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Shellfish is a broad category that historically included crustaceans, though modern classification separates them. Texts from the period often grouped them together.", "is_reverse": true}, {"found_name": "Invertebrata", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1434, "target_cluster_name": "Invertebrata", "source_book": "llm_generated", "evidence_snippet": "Crustaceans are a major subphylum within the Arthropods, which are Invertebrates.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Crustaceans are a major subphylum within the Arthropods, which are Invertebrates.", "is_reverse": true}, {"found_name": "animaes", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1810, "target_cluster_name": "animaes", "source_book": "llm_generated", "evidence_snippet": "Crustaceans are a large group of arthropods, belonging to the kingdom Animalia.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Crustaceans are a large group of arthropods, belonging to the kingdom Animalia.", "is_reverse": true}]}, {"canonical_name": "Naples", "category": "PLACE", "subcategory": "CITY", "book_count": 6, "total_mentions": 21, "members": [{"entity_id": "naples", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Naples", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Naples"], "contexts": ["city of Baptista Porta"]}, {"entity_id": "naples", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Naples", "category": "PLACE", "subcategory": "CITY", "count": 8, "variants": ["Naples"], "contexts": ["city where Don Carlos reigned", "city in Italy"]}, {"entity_id": "naples", "book_id": "kosmos_humboldt_1845", "name": "Naples", "category": "PLACE", "subcategory": "CITY", "count": 6, "variants": ["Naples"], "contexts": ["excursion to Naples", "location with similar latitude to New York"]}, {"entity_id": "naples", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Naples", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Naples"], "contexts": ["city where Mr. Peters discovered a comet", "comet discovered from"]}, {"entity_id": "napoles", "book_id": "historia_medicinal_monardes_1574", "name": "Napoles", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Napoles"], "contexts": ["city name", "city where Charles was"]}, {"entity_id": "nápoles", "book_id": "coloquios_da_orta_1563", "name": "Nápoles", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Nápoles"], "contexts": ["city where war was helped", "city besieged by Charles VIII"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Naples", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Naples", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Naples", "target_book": "kosmos_humboldt_1845", "target_name": "Naples", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Naples", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Naples", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Naples", "target_book": "kosmos_humboldt_1845", "target_name": "Naples", "similarity": 1.0}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Naples", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Naples", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "Naples", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Naples", "similarity": 1.0}], "id": 349, "stable_key": "clu_889133043640c0d4", "ground_truth": {"modern_name": "Naples", "confidence": "high", "type": "place", "description": "A major city in southern Italy, historically significant for its kingdom.", "wikipedia_extract": "Naples is the regional capital of Campania, Italy. With a population of 908,082 within the city's administrative limits (as of 2025), it is the largest city in southern Italy and the third-largest city of Italy after Rome and Milan, while its province-level municipality is the third most populous metropolitan city in Italy with a population of 2,958,410 residents. Its metropolitan area, the seventh most populous in the European Union, stretches beyond the boundaries of the city wall for approximately 30 kilometres (20 miles). Naples also plays a key role in international diplomacy, being home to NATO's Allied Joint Force Command Naples and the Parliamentary Assembly of the Mediterranean. Founded by Greeks in the first millennium BCE, Naples is one of the oldest continuously inhabited urban areas in the world. In the eighth century BCE, a colony known as Parthenope (Ancient Greek: Παρθενόπη) was established on the Pizzofalcone hill."}, "member_count": 6, "cross_references": [{"found_name": "Calabria", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2315, "target_cluster_name": "Calabria", "source_book": "llm_generated", "evidence_snippet": "Naples is the capital of the Campania region, which is located in southern Italy, adjacent to Calabria.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Naples is the capital of the Campania region, which is located in southern Italy, adjacent to Calabria."}, {"found_name": "Vesuvius", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 639, "target_cluster_name": "Vesuvius", "source_book": "llm_generated", "evidence_snippet": "Naples is a major city located very close to Mount Vesuvius, and historical accounts of Vesuvius often involve Naples.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Naples is a major city located very close to Mount Vesuvius, and historical accounts of Vesuvius often involve Naples.", "is_reverse": true}, {"found_name": "ciudad", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2007, "target_cluster_name": "ciudad", "source_book": "llm_generated", "evidence_snippet": "A historically significant city.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: A historically significant city.", "is_reverse": true}, {"found_name": "Soria", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1702, "target_cluster_name": "Syria", "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "fopra e detto , appreflb à gli Arabi fignifica la Màna foluriua nota ; della quak habbiamo due fpczie . Vna viene di Soria,<8: l'altra del regno di Napoli- quella di Sona è di granella fimilc alla Maf", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "origin of a type of manna"}]}, {"canonical_name": "Nitro", "category": "SUBSTANCE", "subcategory": "MINERAL", "book_count": 4, "total_mentions": 17, "members": [{"entity_id": "nitre", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Nitre", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 1, "variants": ["Nitre"], "contexts": ["key ingredient in gunpowder"]}, {"entity_id": "nitre", "book_id": "english_physician_1652", "name": "Nitre", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 6, "variants": ["Nitre"], "contexts": ["taken with Balm leaves", "saltpeter used in remedies"]}, {"entity_id": "nitro", "book_id": "ricettario_fiorentino_1597", "name": "Nitro", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 7, "variants": ["Nitro", "NITRO", "Nitro bianco", "nitro"], "contexts": ["fossilized saltpeter", "substance found in lagoons"]}, {"entity_id": "nitre", "book_id": "connexion_physical_sciences_somerville_1858", "name": "nitre", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 3, "variants": ["nitre"], "contexts": ["combustion produces red lines in spectrum", "crystal exhibiting colored rings"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Nitre", "target_book": "english_physician_1652", "target_name": "Nitre", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Nitre", "target_book": "ricettario_fiorentino_1597", "target_name": "Nitro", "similarity": 0.923}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Nitre", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "nitre", "similarity": 0.99}, {"source_book": "english_physician_1652", "source_name": "Nitre", "target_book": "ricettario_fiorentino_1597", "target_name": "Nitro", "similarity": 0.923}, {"source_book": "english_physician_1652", "source_name": "Nitre", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "nitre", "similarity": 0.99}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Nitro", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "nitre", "similarity": 0.91}], "id": 350, "stable_key": "clu_a398fdd17844dd2b", "ground_truth": {"modern_name": "Saltpeter", "confidence": "high", "type": "mineral", "wikidata_id": "Q11183742", "wikidata_description": "mineral form of potassium nitrate", "wikipedia_url": "https://en.wikipedia.org/wiki/Niter", "wikipedia_extract": "Niter or nitre is the mineral form of potassium nitrate, KNO3. It is a soft, white, highly soluble mineral found primarily in arid climates or cave deposits. Potassium and other nitrates are of great importance for use in fertilizers and, historically, gunpowder. Much of the world's demand is now met by synthetically produced nitrates, though the natural mineral is still mined and is still of significant commercial value. Historically, the term niter was not well differentiated from natron, both of which have been very vaguely defined but generally refer to compounds of sodium or potassium combined with carbonate or nitrate ions. Niter is a colorless to white mineral crystallizing in the orthorhombic crystal system."}, "cross_references": [{"found_name": "Gunpowder", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1058, "target_cluster_name": "Gunpowder", "source_book": "llm_generated", "evidence_snippet": "Saltpeter (nitro) is a primary component of gunpowder.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Saltpeter (nitro) is a primary component of gunpowder."}, {"found_name": "bórax", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1311, "target_cluster_name": "bórax", "source_book": "llm_generated", "evidence_snippet": "Both are mineral salts with historical uses in alchemy and industry.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both are mineral salts with historical uses in alchemy and industry.", "is_reverse": true}, {"found_name": "Potash", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2311, "target_cluster_name": "Potash", "source_book": "llm_generated", "evidence_snippet": "Potassium nitrate (saltpeter) is chemically related to potassium carbonate and historically used in similar applications like gunpowder.", "confidence": 0.85, "a