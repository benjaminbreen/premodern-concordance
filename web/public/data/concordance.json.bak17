und_relationship": "Religious sentiment is a form of belief, often deeply held and emotionally charged."}, {"found_name": "Conscience", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2716, "target_cluster_name": "Conscientiousness", "source_book": "llm_generated", "evidence_snippet": "Religious sentiment can be closely tied to one's conscience, guiding moral and ethical behavior.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Religious sentiment can be closely tied to one's conscience, guiding moral and ethical behavior."}]}, {"canonical_name": "Coma", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "coma", "book_id": "principles_of_psychology_james_1890", "name": "coma", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["coma"], "contexts": ["prolonged state of unconsciousness"]}, {"entity_id": "coma", "book_id": "polyanthea_medicinal", "name": "Coma", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 5, "variants": ["Coma", "Coma fomnolento", "Coma vigil"], "contexts": ["a type of harmful sleep", "a state of prolonged sleep or lethargy"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "coma", "target_book": "polyanthea_medicinal", "target_name": "Coma", "similarity": 0.714}], "id": 2590, "stable_key": "clu_138a89644eb67b6c", "ground_truth": {"modern_name": "Coma", "confidence": "high", "type": "disease", "description": "A state of prolonged, unnatural sleep or unconsciousness.", "note": "A medical condition characterized by deep unconsciousness.", "wikipedia_extract": "A coma is a prolonged state of deep unconsciousness in which a person cannot be awakened, fails to respond normally to painful stimuli, light, or sound, lacks a normal sleep-wake cycle and does not initiate voluntary actions. The person may experience respiratory and circulatory problems due to the body's inability to maintain normal bodily functions. People in a coma often require extensive medical care to maintain their health and prevent complications such as pneumonia or blood clots. Coma patients exhibit a complete absence of wakefulness and are unable to consciously feel, speak or move. Comas can be the result of natural causes, or can be medically induced, for example, during general anesthesia. Clinically, a coma can be defined as the consistent inability to follow a one-step command."}, "cross_references": [{"found_name": "unconsciousness", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1942, "target_cluster_name": "unconsciousness", "source_book": "llm_generated", "evidence_snippet": "Coma is a state of prolonged unconsciousness.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: Coma is a state of prolonged unconsciousness.", "is_reverse": true}, {"found_name": "sleep", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1316, "target_cluster_name": "sleep", "source_book": "llm_generated", "evidence_snippet": "Coma is a state of prolonged unconsciousness that is a severe disruption of the normal state of sleep and wakefulness.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Coma is a state of prolonged unconsciousness that is a severe disruption of the normal state of sleep and wakefulness.", "is_reverse": true}, {"found_name": "delirios", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 235, "target_cluster_name": "delirios", "source_book": "llm_generated", "evidence_snippet": "Coma represents a profound state of unconsciousness, which can be an endpoint or a severe manifestation of conditions that might also present with delirium, indicating a close relationship in the spectrum of altered consciousness.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Coma represents a profound state of unconsciousness, which can be an endpoint or a severe manifestation of conditions that might also present with delirium, indicating a close relationship in the spectrum of altered consciousness.", "is_reverse": true}, {"found_name": "modorras", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1613, "target_cluster_name": "modorras", "source_book": "llm_generated", "evidence_snippet": "Coma is a state of prolonged unconsciousness that is a more severe manifestation of lethargy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Coma is a state of prolonged unconsciousness that is a more severe manifestation of lethargy.", "is_reverse": true}, {"found_name": "mal", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 934, "target_cluster_name": "mal", "source_book": "llm_generated", "evidence_snippet": "Coma is a severe complication of malaria.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Coma is a severe complication of malaria.", "is_reverse": true}, {"found_name": "Apoplexie", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2516, "target_cluster_name": "Apoplexie", "source_book": "llm_generated", "evidence_snippet": "Coma is a common and severe symptom associated with apoplexy (stroke), representing a state of prolonged unconsciousness.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Coma is a common and severe symptom associated with apoplexy (stroke), representing a state of prolonged unconsciousness.", "is_reverse": true}, {"found_name": "suffocação", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1686, "target_cluster_name": "suffocação", "source_book": "llm_generated", "evidence_snippet": "Coma can be a consequence of severe suffocation due to lack of oxygen to the brain.", "confidence": 0.85, "auto_label": "llm_related"