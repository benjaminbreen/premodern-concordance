arget_name": "strawberry", "similarity": 0.926}, {"source_book": "origin_of_species_darwin_1859", "source_name": "strawberry", "target_book": "kosmos_humboldt_1845", "target_name": "strawberry", "similarity": 1.0}], "id": 1070, "stable_key": "clu_b7767aa8594ec966", "ground_truth": {"modern_name": "Strawberry", "confidence": "high", "type": "plant", "linnaean": "Fragaria x ananassa", "family": "Rosaceae", "description": "A creeping plant producing fruits with medicinal properties, subject to variation.", "note": "Common English name for the fruit and plant.", "wikipedia_extract": "The garden strawberry (or simply strawberry; Fragaria × ananassa) is a widely grown hybrid plant cultivated worldwide for its fruit. The genus Fragaria, the strawberries, is in the rose family, Rosaceae. The fruit is appreciated for its aroma, bright red colour, juicy texture, and sweetness. It is eaten either fresh or in prepared foods such as jam, ice cream, and chocolates. Artificial strawberry flavourings and aromas are widely used in commercial products. Botanically, the strawberry is not a berry, but an aggregate accessory fruit."}, "cross_references": [{"found_name": "Berries", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 718, "target_cluster_name": "Berries", "source_book": "llm_generated", "evidence_snippet": "Strawberries are a type of berry.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Strawberries are a type of berry.", "is_reverse": true}, {"found_name": "rose", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 849, "target_cluster_name": "rosa", "source_book": "llm_generated", "evidence_snippet": "The garden strawberry is a hybrid plant in the rose family, Rosaceae.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The garden strawberry is a hybrid plant in the rose family, Rosaceae."}, {"found_name": "fruit", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 72, "target_cluster_name": "frutas", "source_book": "llm_generated", "evidence_snippet": "The strawberry is cultivated for its fruit.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The strawberry is cultivated for its fruit."}, {"found_name": "wild rose", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3315, "target_cluster_name": "wild Roses", "source_book": "llm_generated", "evidence_snippet": "The genus Fragaria, which includes the strawberry, is related to roses.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The genus Fragaria, which includes the strawberry, is related to roses."}]}, {"canonical_name": "Rhine", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "rhine", "book_id": "english_physician_1652", "name": "Rhine", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Rhine"], "contexts": ["region of Count Frederick"]}, {"entity_id": "rhine", "book_id": "origin_of_species_darwin_1859", "name": "Rhine", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Rhine"], "contexts": ["river with evidence of land level changes", "river with geological changes"]}, {"entity_id": "rhine", "book_id": "kosmos_humboldt_1845", "name": "Rhine", "category": "PLACE", "subcategory": "REGION", "count": 4, "variants": ["Rhine"], "contexts": ["river valley in Germany", "river forming fissures"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Rhine", "target_book": "origin_of_species_darwin_1859", "target_name": "Rhine", "similarity": 0.839}, {"source_book": "english_physician_1652", "source_name": "Rhine", "target_book": "kosmos_humboldt_1845", "target_name": "Rhine", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Rhine", "target_book": "kosmos_humboldt_1845", "target_name": "Rhine", "similarity": 0.839}], "id": 1071, "stable_key": "clu_43d112a61a116f0f", "ground_truth": {"modern_name": "Rhine River", "confidence": "high", "type": "place", "description": "Major European river, important for trade, geography, and geology.", "wikipedia_extract": "The Rhine ( RYNE) is one of the major rivers of Europe. The river begins in the Swiss canton of Graubünden in the southeastern Swiss Alps. It forms part of the Swiss-Liechtenstein border, then part of the Swiss-Austrian border. From Lake Constance downstream, it forms part of the Swiss-German border. After that the Rhine defines much of the Franco-German border. It then flows in a mostly northerly direction through the German Rhineland."}, "cross_references": [{"found_name": "Europe", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 30, "target_cluster_name": "Europe", "source_book": "llm_generated", "evidence_snippet": "The Rhine River is a major river in Europe.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Rhine River is a major river in Europe."}]}, {"canonical_name": "Cook", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "cook", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cook", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Cook"], "contexts": ["explorer", "captain and navigator"]}, {"entity_id": "cook", "book_id": "kosmos_humboldt_1845", "name": "Cook", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Cook"], "contexts": ["explorer of second voyage", "early voyager"]}, {"entity_id": "cook", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Cook", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Cook"], "contexts": ["led first voyage for observation"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cook", "target_book": "kosmos_humboldt_1845", "target_name": "Cook", "similarity": 0.791}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cook", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cook", "similarity": 0.791}, {"source_book": "kosmos_humboldt_1845", "source_name": "Cook", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cook", "similarity": 1.0}], "id": 1072, "stable_key": "clu_f8c379c352033b06", "ground_truth": {"modern_name": "James Cook", "confidence": "high", "type": "person", "birth_year": 1728, "death_year": 1779, "description": "British explorer, navigator, cartographer, and captain in the Royal Navy.", "wikidata_id": "Q7324", "wikidata_description": "British explorer, cartographer and naval officer (1728–1779)"}, "cross_references": [{"found_name": "James Clark Ross", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2614, "target_cluster_name": "Sir James Ross", "source_book": "llm_generated", "evidence_snippet": "Both were prominent British naval officers and explorers who undertook significant voyages of discovery in the 19th century. Ross was part of Cook's later voyages and later commanded his own Antarctic expedition.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were prominent British naval officers and explorers who undertook significant voyages of discovery in the 19th century. Ross was part of Cook's later voyages and later commanded his own Antarctic expedition."}, {"found_name": "Christopher Columbus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 327, "target_cluster_name": "Columbus", "source_book": "llm_generated", "evidence_snippet": "Both were pivotal European explorers who undertook voyages that significantly expanded European knowledge of the globe and led to profound geopolitical changes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were pivotal European explorers who undertook voyages that significantly expanded European knowledge of the globe and led to profound geopolitical changes."}, {"found_name": "Amerigo Vespucci", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3017, "target_cluster_name": "Amerigo Vespucci", "source_book": "llm_generated", "evidence_snippet": "Both were key figures in the Age of Discovery, whose voyages and writings contributed to the European understanding of the Americas and the subsequent naming of the continent.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were key figures in the Age of Discovery, whose voyages and writings contributed to the European understanding of the Americas and the subsequent naming of the continent."}, {"found_name": "La Pérouse", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2393, "target_cluster_name": "La Pérouse", "source_book": "llm_generated", "evidence_snippet": "La Pérouse's expedition was heavily influenced by and intended to complete the work of James Cook's voyages. Both were naval officers leading scientific expeditions of exploration.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: La Pérouse's expedition was heavily influenced by and intended to complete the work of James Cook's voyages. Both were naval officers leading scientific expeditions of exploration.", "is_reverse": true}]}, {"canonical_name": "agua do mar", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "mare", "book_id": "english_physician_1652", "name": "Mare", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["Mare"], "contexts": ["animal listed with numbers"]}, {"entity_id": "mare", "book_id": "origin_of_species_darwin_1859", "name": "mare", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 2, "variants": ["mare"], "contexts": ["female horse used in a cross", "female horse"]}, {"entity_id": "agua_do_mar", "book_id": "polyanthea_medicinal", "name": "agua do mar", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 4, "variants": ["agua do mar"], "contexts": ["water used for healing soldiers", "used for baths"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Mare", "target_book": "origin_of_species_darwin_1859", "target_name": "mare", "similarity": 0.637}, {"source_book": "english_physician_1652", "source_name": "Mare", "target_book": "polyanthea_medicinal", "target_name": "agua do mar", "similarity": 0.893}], "id": 1073, "stable_key": "clu_e13bef05fb75a1fa", "ground_truth": {"modern_name": "Horse", "confidence": "high", "type": "animal", "note": "The phrase 'agua do mar' (sea water) in the context of 'animal listed with numbers' and 'water used for healing soldiers' is a misinterpretation or OCR error. The surrounding English texts and the specific mention of 'Mare' (a mare, or female horse) strongly indicate the referent is 'horse'. The 'animal listed with numbers' context might refer to breeds or classifications, and 'female horse used in a cross' is a direct biological reference.", "wikidata_id": "", "wikidata_description": "domesticated four-footed mammal from the equine family", "wikipedia_url": "https://en.wikipedia.org/wiki/Horse", "wikipedia_extract": "The horse (Equus ferus caballus) is a domesticated, one-toed, hoofed mammal. It belongs to the taxonomic family Equidae and is one of two extant subspecies of Equus ferus. The horse has evolved over the past 45 to 55 million years from a small multi-toed creature, Eohippus, into the large single-toed animal of today, originally in North America. Humans began domesticating horses around 4000 BCE in Central Asia, and their domestication is believed to have been widespread by 3000 BCE. Horses in the subspecies caballus are domesticated, although some domesticated populations live in the wild as feral horses. These feral populations are not true wild horses, which are horses that have never been domesticated."}, "cross_references": []}, {"canonical_name": "alpine", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "alpine", "book_id": "origin_of_species_darwin_1859", "name": "alpine", "category": "PLACE", "subcategory": "REGION", "count": 5, "variants": ["Alpine", "alpine"], "contexts": ["high mountain regions", "referring to species from high mountains"]}, {"entity_id": "alpine", "book_id": "relation_historique_humboldt_vol3_1825", "name": "alpine", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["alpine"], "contexts": ["Alpine limestone"]}, {"entity_id": "alpine", "book_id": "kosmos_humboldt_1845", "name": "Alpine", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Alpine"], "contexts": ["mountainous region"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "alpine", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "alpine", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "alpine", "target_book": "kosmos_humboldt_1845", "target_name": "Alpine", "similarity": 0.912}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "alpine", "target_book": "kosmos_humboldt_1845", "target_name": "Alpine", "similarity": 0.912}], "id": 1074, "stable_key": "clu_5189105edc204b81-2", "ground_truth": {"modern_name": "Alps", "confidence": "high", "type": "place", "description": "Major European mountain range, notable for its arctic fauna and flora.", "wikipedia_extract": "The Alps () are some of the highest and most extensive mountain ranges in Europe, stretching approximately 1,200 km (750 mi) across eight Alpine countries (from west to east): Monaco, France, Switzerland, Italy, Liechtenstein, Germany, Austria, Slovenia, and Hungary. The Alpine arch extends from Nice on the western Mediterranean to Trieste on the Adriatic and Vienna at the beginning of the Pannonian Basin. The mountains were formed over tens of millions of years as the African and Eurasian tectonic plates collided. Extreme shortening  caused by the event resulted in marine sedimentary rocks rising by thrusting and folding into high mountain peaks such as Mont Blanc and the Matterhorn. Mont Blanc spans the French-Italian border, and at 4,809 m (15,778 ft) is the highest mountain in the Alps. The Alpine region area contains 82 peaks higher than 4,000 m (13,000 ft)."}, "cross_references": []}, {"canonical_name": "Fries", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "fries", "book_id": "origin_of_species_darwin_1859", "name": "Fries", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Fries"], "contexts": ["naturalist remarking on plant differences", "naturalist remarking on species clustering"]}, {"entity_id": "fries", "book_id": "kosmos_humboldt_1845", "name": "Fries", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Fries"], "contexts": ["author of 'Vorlesungen uber die Sternkunde'"]}, {"entity_id": "fryas", "book_id": "polyanthea_medicinal", "name": "Fryas", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Fryas"], "contexts": ["author of a text", "author of Compend.admir.virtut."]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Fries", "target_book": "kosmos_humboldt_1845", "target_name": "Fries", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Fries", "target_book": "polyanthea_medicinal", "target_name": "Fryas", "similarity": 0.862}, {"source_book": "kosmos_humboldt_1845", "source_name": "Fries", "target_book": "polyanthea_medicinal", "target_name": "Fryas", "similarity": 0.862}], "id": 1075, "stable_key": "clu_34dbe3755c123fbb", "ground_truth": {"modern_name": "Emil von Fries", "confidence": "medium", "type": "person", "description": "Naturalist and astronomer, author of astronomical lectures.", "note": "The exact historical figure 'Fries' is ambiguous, but given the context of naturalism and astronomy in Humboldt and Darwin's works, Emil von Fries (1846-1901), a botanist and astronomer, is a plausible candidate, although the specific astronomical text mentioned is not immediately identifiable. 'Fryas' is likely a variant spelling or OCR error."}, "cross_references": []}, {"canonical_name": "Azara", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "azara", "book_id": "origin_of_species_darwin_1859", "name": "Azara", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Azara"], "contexts": ["scholar who studied animals in Paraguay", "on flies destroying cattle"]}, {"entity_id": "azara", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Azara", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Azara"], "contexts": ["created map of Paraguay", "geographer"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Azara", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Azara", "similarity": 1.0}], "id": 1076, "stable_key": "clu_8a075a20fc00bd1d", "ground_truth": {"modern_name": "Félix de Azara", "confidence": "high", "type": "person", "birth_year": 1742, "death_year": 1821, "description": "Naturalist, geographer, and military engineer in South America.", "note": "While Monardes' 'Historia Medicinal' mentions ancient authorities, the strong linkage of 'Azara' with studies in Paraguay and natural history in Humboldt and Darwin's works points to Félix de Azara.", "wikidata_id": "Q471014", "wikidata_description": "Spanish scientist (1742-1821)", "wikipedia_url": "https://en.wikipedia.org/wiki/F%C3%A9lix%20de%20Azara", "wikipedia_extract": "Félix de Azara y Perera (18 May 1742 – 20 October 1821) was a Spanish military officer, naturalist, and engineer. Félix de Azara y Perera was born on 18 May 1746 in Barbuñales, Aragon. He joined the army and attended a Spanish military academy. He was commissioned as an engineer, distinguishing himself on various expeditions. He spent the next thirteen years of his life in the military and rose to the rank of brigadier general in the Spanish Army. In 1777, Spain and Portugal signed the Treaty of San Ildefonso."}, "cross_references": [{"found_name": "Biot", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 723, "target_cluster_name": "Biot", "source_book": "llm_generated", "evidence_snippet": "Félix de Azara was a naturalist and explorer whose work on South American fauna was studied by Biot.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Félix de Azara was a naturalist and explorer whose work on South American fauna was studied by Biot.", "is_reverse": true}, {"found_name": "Caldas", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1895, "target_cluster_name": "Caldas", "source_book": "llm_generated", "evidence_snippet": "Azara was a naturalist and explorer who worked in South America, and his work on the fauna of the region was known to and influenced Caldas.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Azara was a naturalist and explorer who worked in South America, and his work on the fauna of the region was known to and influenced Caldas.", "is_reverse": true}]}, {"canonical_name": "organic forms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "organic_forms", "book_id": "origin_of_species_darwin_1859", "name": "organic forms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["organic forms"], "contexts": ["new types of living organisms", "living organisms with defined structures"]}, {"entity_id": "organic_forms", "book_id": "kosmos_humboldt_1845", "name": "organic forms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["organic forms"], "contexts": ["structures of plants"]}, {"entity_id": "organic_form", "book_id": "first_principles_spencer_1862", "name": "organic form", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["organic form"], "contexts": ["structure of living things", "shape of living organisms"]}, {"entity_id": "organic_forms", "book_id": "first_principles_spencer_1862", "name": "organic forms", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["organic forms"], "contexts": ["shapes of living things", "shapes and structures of living things"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "organic forms", "target_book": "kosmos_humboldt_1845", "target_name": "organic forms", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "organic forms", "target_book": "first_principles_spencer_1862", "target_name": "organic form", "similarity": 0.935}, {"source_book": "origin_of_species_darwin_1859", "source_name": "organic forms", "target_book": "first_principles_spencer_1862", "target_name": "organic forms", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "organic forms", "target_book": "first_principles_spencer_1862", "target_name": "organic form", "similarity": 0.935}, {"source_book": "kosmos_humboldt_1845", "source_name": "organic forms", "target_book": "first_principles_spencer_1862", "target_name": "organic forms", "similarity": 1.0}], "id": 1077, "stable_key": "clu_8e67197c740e571e", "ground_truth": {"modern_name": "Organic form", "confidence": "high", "type": "concept", "wikidata_id": "Q7101850", "wikidata_description": "", "wikipedia_url": "https://en.wikipedia.org/wiki/Organic%20form", "wikipedia_extract": "In romantic literature, a work has organic form if the structure has originated from the materials and subjects used by the author. Using the organic metaphor, the structure is seen to grow as a plant. It stands in contrast to a mechanical form, a work which has been produced in accordance with artificial rules. The lack of rules in Shakespeare's works led some critics to claim that they lacked form; Samuel Taylor Coleridge leapt to his defence with the concept of organic form. Coleridge, an English poet, philosopher, literary critic, and founder of the Romantic movement, suggested that the concept of organic form meant that a poem or literary piece was shaped, rather than structured, from within. The use of the form allowed a piece to uniquely develop itself as it unfolded, and ultimately revealed an emphasis on the whole outcome of the piece, including the connections of each development to each other."}, "cross_references": [{"found_name": "Development", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 960, "target_cluster_name": "development", "source_book": "llm_generated", "evidence_snippet": "'Organic form' implies a process of growth and development, mirroring natural processes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "'Organic form' implies a process of growth and development, mirroring natural processes."}, {"found_name": "Growth", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2277, "target_cluster_name": "Growth", "source_book": "llm_generated", "evidence_snippet": "The core metaphor of 'organic form' is that of a plant growing, making 'growth' a directly related concept.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The core metaphor of 'organic form' is that of a plant growing, making 'growth' a directly related concept."}]}, {"canonical_name": "Matteucci", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "matteuchi", "book_id": "origin_of_species_darwin_1859", "name": "Matteuchi", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["Matteuchi"], "contexts": ["asserted Rays do not discharge electricity", "on electric organs of rays"]}, {"entity_id": "matteuci", "book_id": "kosmos_humboldt_1845", "name": "Matteuci", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Matteuci"], "contexts": ["provided depth measurement"]}, {"entity_id": "matteucci", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Matteucci", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Matteucci"], "contexts": ["proved intervening substance is polarized", "experiment with needle of bismuth"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Matteuchi", "target_book": "kosmos_humboldt_1845", "target_name": "Matteuci", "similarity": 0.877}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Matteuchi", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Matteucci", "similarity": 0.854}, {"source_book": "kosmos_humboldt_1845", "source_name": "Matteuci", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Matteucci", "similarity": 0.847}], "id": 1078, "stable_key": "clu_7100f4b030a955a5", "ground_truth": {"modern_name": "Carlo Matteucci", "confidence": "high", "type": "person", "birth_year": 1811, "death_year": 1868, "description": "Italian physicist, studied electricity and nervous system.", "wikidata_id": "Q280250", "wikidata_description": "Italian politician and physicist (1811–1868)", "wikipedia_url": "https://en.wikipedia.org/wiki/Carlo%20Matteucci", "wikipedia_extract": "Carlo Matteucci (20 June 1811 – 24 June 1868) was an Italian physicist and neurophysiologist who was a pioneer in the study of bioelectricity. Carlo Matteucci was born at Forlì, in the province of Romagna, to Vincenzo Matteucci, a physician, and Chiara Folfi. He studied mathematics at the University of Bologna from 1825 to 1828, receiving his doctorate in 1829. From 1829 to 1831, he studied at the École Polytechnique in Paris, France. Upon returning to Italy, Matteucci studied at Bologna (1832), Florence, Ravenna (1837) and Pisa. He established himself as the head of the laboratory of the Hospital of Ravenna and became a professor of physics at the local college."}, "cross_references": [{"found_name": "Alessandro Volta", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 966, "target_cluster_name": "Volta", "source_book": "llm_generated", "evidence_snippet": "Both were prominent Italian physicists who made significant contributions to the understanding of electricity and its applications. Volta's work on the voltaic pile directly preceded and influenced later studies in bioelectricity, an area Matteucci pioneered.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were prominent Italian physicists who made significant contributions to the understanding of electricity and its applications. Volta's work on the voltaic pile directly preceded and influenced later studies in bioelectricity, an area Matteucci pioneered."}, {"found_name": "André-Marie Ampère", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2134, "target_cluster_name": "Ampère", "source_book": "llm_generated", "evidence_snippet": "Both were key figures in the early development of electromagnetism and the study of electric currents. Ampère's foundational work on the relationship between electricity and magnetism provided a crucial theoretical framework for subsequent research in electrophysiology.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were key figures in the early development of electromagnetism and the study of electric currents. Ampère's foundational work on the relationship between electricity and magnetism provided a crucial theoretical framework for subsequent research in electrophysiology."}, {"found_name": "Michael Faraday", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 248, "target_cluster_name": "Faraday", "source_book": "llm_generated", "evidence_snippet": "Both were leading experimental physicists of the 19th century who made fundamental discoveries in electricity and magnetism. Faraday's work on electromagnetic induction and the nature of electric fields was highly influential for physicists like Matteucci studying bioelectrical phenomena.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both were leading experimental physicists of the 19th century who made fundamental discoveries in electricity and magnetism. Faraday's work on electromagnetic induction and the nature of electric fields was highly influential for physicists like Matteucci studying bioelectrical phenomena."}]}, {"canonical_name": "strains", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 3, "total_mentions": 7, "members": [{"entity_id": "strain", "book_id": "origin_of_species_darwin_1859", "name": "strain", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["strain"], "contexts": ["sub-group within a breed"]}, {"entity_id": "strain", "book_id": "principles_of_psychology_james_1890", "name": "strain", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["strain"], "contexts": ["feeling of the strain of our inward attentiveness", "feeling of tension"]}, {"entity_id": "strains", "book_id": "first_principles_spencer_1862", "name": "strains", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 3, "variants": ["strains"], "contexts": ["forces exerted by muscles", "feeling of tension or effort"]}, {"entity_id": "strain", "book_id": "first_principles_spencer_1862", "name": "strain", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["strain"], "contexts": ["deformation caused by force"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "strain", "target_book": "principles_of_psychology_james_1890", "target_name": "strain", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "strain", "target_book": "first_principles_spencer_1862", "target_name": "strains", "similarity": 0.877}, {"source_book": "origin_of_species_darwin_1859", "source_name": "strain", "target_book": "first_principles_spencer_1862", "target_name": "strain", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "strain", "target_book": "first_principles_spencer_1862", "target_name": "strains", "similarity": 0.877}, {"source_book": "principles_of_psychology_james_1890", "source_name": "strain", "target_book": "first_principles_spencer_1862", "target_name": "strain", "similarity": 1.0}], "id": 1079, "stable_key": "clu_dab722e8c3851039", "ground_truth": {"modern_name": "Strain", "confidence": "medium", "type": "concept", "note": "Contexts suggest both biological (breed) and physical/psychological (effort) meanings."}, "cross_references": [{"found_name": "Breed", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2181, "target_cluster_name": "breed", "source_book": "llm_generated", "evidence_snippet": "In biological contexts, a 'strain' can refer to a specific breed or variety of an organism, particularly in microbiology and animal husbandry. The terms are often used interchangeably or in close association when discussing distinct lineages or types within a species.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "In biological contexts, a 'strain' can refer to a specific breed or variety of an organism, particularly in microbiology and animal husbandry. The terms are often used interchangeably or in close association when discussing distinct lineages or types within a species."}]}, {"canonical_name": "ganglia", "category"