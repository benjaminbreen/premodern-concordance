subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["magnes"], "contexts": ["Latin for loadstone", "expression in the word magnes"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Loadstone", "target_book": "kosmos_humboldt_1845", "target_name": "loadstone", "similarity": 0.962}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Loadstone", "target_book": "kosmos_humboldt_1845", "target_name": "loadstones", "similarity": 0.933}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Loadstone", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "loadstone", "similarity": 0.962}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Loadstones", "target_book": "kosmos_humboldt_1845", "target_name": "loadstone", "similarity": 0.921}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Loadstones", "target_book": "kosmos_humboldt_1845", "target_name": "loadstones", "similarity": 0.968}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Loadstones", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "loadstone", "similarity": 0.921}, {"source_book": "kosmos_humboldt_1845", "source_name": "loadstone", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "loadstone", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "loadstones", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "loadstone", "similarity": 0.955}], "id": 593, "stable_key": "clu_addd4bb36496acf9", "ground_truth": {"modern_name": "Lodestone", "confidence": "high", "type": "mineral", "wikidata_id": "Q3480938", "wikidata_description": "naturally magnetized mineral, magnetite variety", "wikipedia_url": "https://en.wikipedia.org/wiki/Lodestone", "wikipedia_extract": "Lodestones are naturally magnetized pieces of the mineral magnetite. They are naturally occurring magnets, which can attract iron. The property of magnetism was first discovered in antiquity through lodestones. Pieces of lodestone, suspended so they could turn, were the first magnetic compasses, and their importance to early navigation is indicated by the name lodestone, which in Middle English means \"course stone\" or \"leading stone\", from the now-obsolete meaning of lode as \"journey, way\". Lodestone is one of only a very few minerals that is found naturally magnetized. Magnetite is black or brownish-black with a black streak, with a metallic luster and a Mohs hardness of 5.5–6.5."}, "member_count": 6, "cross_references": [{"found_name": "Authority", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 355, "target_cluster_name": "Authority", "source_book": "pseudodoxia_epidemica_browne_1646", "evidence_snippet": "perhaps we speak not properly, when we say vulgarly and appropriately the Loadstone draweth Iron; and yet herein we should not want experiment and great authority. The words of _Renatus des Cartes_ in", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "reverse: synonym of the known entity's conceptual category (magnetic attraction)", "is_reverse": true}, {"found_name": "experiment", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 873, "target_cluster_name": "experiment", "source_book": "pseudodoxia_epidemica_browne_1646", "evidence_snippet": "Loadstone, and that perhaps we speak not properly, when we say vulgarly and appropriately the Loadstone draweth Iron; and yet herein we should not want experiment and great authority. The words of _Re", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "reverse: synonym", "is_reverse": true}, {"found_name": "Magnets", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 822, "target_cluster_name": "magnets", "source_book": "llm_generated", "evidence_snippet": "Lodestone is a naturally occurring magnet, and 'Magnets' is a broader category that includes lodestone.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Lodestone is a naturally occurring magnet, and 'Magnets' is a broader category that includes lodestone."}, {"found_name": "Earth's magnetic field", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3832, "target_cluster_name": "magnetical parts", "source_book": "llm_generated", "evidence_snippet": "Lodestones are the natural source of magnetism, which is the basis of the Earth's magnetic field.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Lodestones are the natural source of magnetism, which is the basis of the Earth's magnetic field."}, {"found_name": "Iron oxide", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3119, "target_cluster_name": "oxyd of iron", "source_book": "llm_generated", "evidence_snippet": "Lodestone is a form of magnetite, which is an iron oxide (Fe3O4).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Lodestone is a form of magnetite, which is an iron oxide (Fe3O4)."}, {"found_name": "soft iron", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2653, "target_cluster_name": "soft iron", "source_book": "llm_generated", "evidence_snippet": "Lodestone is a naturally magnetized piece of the mineral magnetite, a form of iron ore. Both lodestone and soft iron are discussed in the context of magnetism and magnetic properties in premodern texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Lodestone is a naturally magnetized piece of the mineral magnetite, a form of iron ore. Both lodestone and soft iron are discussed in the context of magnetism and magnetic properties in premodern texts.", "is_reverse": true}]}, {"canonical_name": "cap.", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 3, "total_mentions": 50, "members"