_snippet": "The cranium encloses and protects the brain.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The cranium encloses and protects the brain."}, {"found_name": "Head", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1508, "target_cluster_name": "cabeça", "source_book": "llm_generated", "evidence_snippet": "The cranium is the primary component of the head.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The cranium is the primary component of the head."}]}, {"canonical_name": "Sir Humphry Davy", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 18, "members": [{"entity_id": "sir_humphrey_davy", "book_id": "kosmos_humboldt_1845", "name": "Sir Humphrey Davy", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["Sir Humphrey Davy"], "contexts": ["invited to subterranean expedition", "discovered metals acting on Earth's crust"]}, {"entity_id": "davy,_sir_humphrey", "book_id": "kosmos_humboldt_1845", "name": "Davy, Sir Humphrey", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Davy, Sir Humphrey"], "contexts": ["proposed hypothesis on volcanic phenomena"]}, {"entity_id": "sir_humphry_davy", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Sir Humphry Davy", "category": "PERSON", "subcategory": "SCHOLAR", "count": 10, "variants": ["Sir Humphry Davy"], "contexts": ["pioneer of photographic pictures", "produced profiles on prepared surfaces"]}, {"entity_id": "davy", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Davy", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Davy"], "contexts": ["scholar who experimented on soil fertility"]}, {"entity_id": "davy", "book_id": "kosmos_humboldt_1845", "name": "Davy", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Davy"], "contexts": ["author of 'Consolation in Travel'"]}, {"entity_id": "davy", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Davy", "category": "PERSON", "subcategory": "SCHOLAR", "count": 1, "variants": ["Davy"], "contexts": ["pioneered photographic pictures"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Sir Humphrey Davy", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Sir Humphry Davy", "similarity": 0.992}, {"source_book": "kosmos_humboldt_1845", "source_name": "Davy, Sir Humphrey", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Sir Humphry Davy", "similarity": 0.936}], "id": 1877, "stable_key": "clu_fe7eb7defc47861d", "ground_truth": {"modern_name": "Humphry Davy", "confidence": "high", "type": "person", "birth_year": 1778, "death_year": 1829, "description": "Chemist and inventor, pioneer in electrochemistry and photography.", "wikidata_id": "Q5941768", "wikidata_description": "British baronet and physician (1862–1944)", "wikipedia_url": "https://en.wikipedia.org/wiki/Humphry%20Rolleston", "wikipedia_extract": "Sir Humphry Davy Rolleston, 1st Baronet,  (21 June 1862 – 23 September 1944) was a prominent English physician. Rolleston was the son of George Rolleston (Linacre Professor of Physiology at Oxford) and Grace Davy, daughter of John Davy and niece of Sir Humphry Davy, Bt (chemist). He was educated at Marlborough College, proceeded to St John's College, Cambridge and graduated in Natural Sciences in 1886. After clinical training at St Bartholomew's Hospital, London he qualified MB (Cambridge) in 1888 and MD in 1892. In 1891 he became Physician at St George's Hospital, Hyde Park Corner, London and continued there until 1919. This period, however, was interrupted by his service during the Second Boer War, where he served with the Imperial Yeomanry Hospital, Pretoria."}, "member_count": 6, "cross_references": [{"found_name": "Faraday", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 248, "target_cluster_name": "Faraday", "source_book": "llm_generated", "evidence_snippet": "Davy was Faraday's mentor and a significant chemist and physicist in his own right. Faraday worked as his assistant at the Royal Institution.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Davy was Faraday's mentor and a significant chemist and physicist in his own right. Faraday worked as his assistant at the Royal Institution.", "is_reverse": true}, {"found_name": "Wollaston", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 341, "target_cluster_name": "Wollaston", "source_book": "llm_generated", "evidence_snippet": "Both were prominent chemists and physicists in the early 19th century, known for their work with elements and chemical processes. Davy was a senior figure and Wollaston was a contemporary who also made significant contributions to chemistry and physics, including the discovery of elements.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were prominent chemists and physicists in the early 19th century, known for their work with elements and chemical processes. Davy was a senior figure and Wollaston was a contemporary who also made significant contributions to chemistry and physics, including the discovery of elements.", "is_reverse": true}, {"found_name": "Lavoisier", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 475, "target_cluster_name": "Lavoisier", "source_book": "llm_generated", "evidence_snippet": "Davy was a prominent chemist who built upon Lavoisier's foundational work, particularly in the understanding of elements and combustion, and engaged in debates that furthered chemical theory.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Davy was a prominent chemist who built upon Lavoisier's foundational work, particularly in the understanding of elements and combustion, and engaged in debates that furthered chemical theory.", "is_reverse": true}]}, {"canonical_name": "lightning", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "flash_of_lightning", "book_id": "kosmos_humboldt_1845", "name": "flash of lightning", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["flash of lightning"], "contexts": ["sudden electrical discharge"]}, {"entity_id": "lightning", "book_id": "connexion_physical_sciences_somerville_1858", "name": "lightning", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 14, "variants": ["Lightning", "lightning"], "contexts": ["powerful electrical discharge in atmosphere", "electrical discharge in atmosphere"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "flash of lightning", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "lightning", "similarity": 0.943}], "id": 1878, "stable_key": "clu_89a297b4a3b6992e", "ground_truth": {"modern_name": "lightning", "confidence": "high", "type": "concept", "wikidata_id": "", "wikidata_description": "family name"}, "cross_references": [{"found_name": "Electric discharge", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1262, "target_cluster_name": "electric discharge", "source_book": "llm_generated", "evidence_snippet": "Lightning is a natural form of electric discharge.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Lightning is a natural form of electric discharge."}]}, {"canonical_name": "páo da China", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "páo_da_china", "book_id": "coloquios_da_orta_1563", "name": "páo da China", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 14, "variants": ["páo da China", "pao da China", "pau da China"], "contexts": ["wood of China, likely referring to cinnamon", "wood from China, likely guaiacum"]}, {"entity_id": "paodachina", "book_id": "polyanthea_medicinal", "name": "paodaChina", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["paodaChina"], "contexts": ["plant used in medicinal preparations"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "páo da China", "target_book": "polyanthea_medicinal", "target_name": "paodaChina", "similarity": 0.853}], "id": 1879, "stable_key": "clu_70c667b12729e4f4", "ground_truth": {"modern_name": "páo da China", "confidence": "high", "type": "plant", "description": "Wood from China, likely referring to cinnamon or guaiacum.", "note": "Portuguese term for a medicinal wood.", "wikipedia_extract": "The cash or qian was a type of coin of China and the Sinosphere, used from the 4th century BC until the 20th century, characterised by their round outer shape and a square center hole (Chinese: 方穿; pinyin: fāng chuān; Jyutping: fong1 cyun1; Pe̍h-ōe-jī: hong-chhoan). Originally cast during the Warring States period, these coins continued to be used for the entirety of Imperial China. The last Chinese cash coins were cast in 1912, the first year of the Republic of China. Generally most cash coins were made from copper or bronze alloys, with iron, lead, and zinc coins occasionally used less often throughout Chinese history. Rare silver and gold cash coins were also produced. During most of their production, cash coins were cast, but during the late Qing dynasty, machine-struck cash coins began to be made."}, "cross_references": [{"found_name": "Raiz da China", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 1855, "target_cluster_name": "Raiz da China", "source_book": "llm_generated", "evidence_snippet": "Historical Portuguese name for Smilax glabra.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Historical Portuguese name for Smilax glabra.", "is_reverse": true}]}, {"canonical_name": "Assa fétida", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "assa_fétida", "book_id": "coloquios_da_orta_1563", "name": "Assa fétida", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 13, "variants": ["ASSA FÉTIDA", "assa fétida", "Assa fétida"], "contexts": ["plant to be discussed", "name of a plant"]}, {"entity_id": "assa_fetida", "book_id": "ricettario_fiorentino_1597", "name": "ASSA FETIDA", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Assa fetida", "ASSA FETIDA"], "contexts": ["fragrant resin", "plant producing fetid resin"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Assa fétida", "target_book": "ricettario_fiorentino_1597", "target_name": "ASSA FETIDA", "similarity": 0.752}], "id": 1880, "stable_key": "clu_b4afad0e4a192623", "ground_truth": {"modern_name": "asafoetida", "confidence": "high", "type": "plant", "linnaean": "Ferula assa-foetida", "family": "Apiaceae", "note": "The term 'Assa fétida' clearly refers to the pungent resin obtained from the roots of Ferula species, commonly known as asafoetida."}, "cross_references": [{"found_name": "Ammoniac", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 3243, "target_cluster_name": "Ammoniac", "source_book": "llm_generated", "evidence_snippet": "Ammoniac (or Ammoniacum) is a gum resin, like asafoetida. Both were used in historical medicine and perfumery, and their resinous nature and medicinal applications create a relatedness in historical texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Ammoniac (or Ammoniacum) is a gum resin, like asafoetida. Both were used in historical medicine and perfumery, and their resinous nature and medicinal applications create a relatedness in historical texts."}]}, {"canonical_name": "oliveira", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "oliveira", "book_id": "coloquios_da_orta_1563", "name": "oliveira", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 10, "variants": ["oliveira", "olivastro", "oliveiras"], "contexts": ["tree size comparison", "tree comparison"]}, {"entity_id": "oliveyra", "book_id": "polyanthea_medicinal", "name": "oliveyra", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["oliveyra", "Oliveyra", "olivera"], "contexts": ["signer of document", "author of the text"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "oliveira", "target_book": "polyanthea_medicinal", "target_name": "oliveyra", "similarity": 0.947}], "id": 1881, "stable_key": "clu_ba9a422b09fc36f4-2", "ground_truth": {"modern_name": "olive tree", "confidence": "high", "type": "plant", "linnaean": "Olea europaea", "family": "Oleaceae", "description": "Tree producing olives and olive oil, valued for its fruit and oil.", "wikipedia_extract": "The olive (botanical name Olea europaea, \"European olive\") is a species of subtropical evergreen tree in the family Oleaceae. Originating in Asia Minor, it is abundant throughout the Mediterranean Basin, with wild subspecies in Africa and western Asia; modern cultivars are traced primarily to the Near East, Aegean Sea, and Strait of Gibraltar. The olive is the type species for its genus, Olea, and lends its name to the Oleaceae plant family, which includes lilac, jasmine, forsythia, and ash. The olive fruit is classed botanically as a drupe, similar in structure and function to the cherry or peach. The term oil—now used to describe any viscous water-insoluble liquid—was originally synonymous with olive oil, the liquid fat derived from olives. The olive has deep historical, economic, and cultural significance in the Mediterranean."}, "cross_references": [{"found_name": "olives", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1227, "target_cluster_name": "olives", "source_book": "llm_generated", "evidence_snippet": "The fruit of the olive tree.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The fruit of the olive tree."}]}, {"canonical_name": "azeite", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 3, "total_mentions": 18, "members": [{"entity_id": "azeite", "book_id": "coloquios_da_orta_1563", "name": "azeite", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 10, "variants": ["azeite"], "contexts": ["oil", "oil made from cinnamon"]}, {"entity_id": "azeite", "book_id": "polyanthea_medicinal", "name": "azeite", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 5, "variants": ["azeite"], "contexts": ["oil, some cannot eat", "oil, likely olive oil"]}, {"entity_id": "azeytes", "book_id": "historia_medicinal_monardes_1574", "name": "azeytes", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["azeytes"], "contexts": ["oils"]}, {"entity_id": "azeytes", "book_id": "polyanthea_medicinal", "name": "azeytes", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["azeytes", "azeyto"], "contexts": ["oils, properties discussed", "oil"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "azeite", "target_book": "polyanthea_medicinal", "target_name": "azeite", "similarity": 1.0}], "id": 1882, "stable_key": "clu_b510a194ae44181c", "ground_truth": {"modern_name": "Olive oil", "confidence": "high", "type": "chemical", "note": "'Azeyte ordinario' and 'azeytes' in these texts refer to common oils, most frequently olive oil, used in preparations and ointments.", "wikidata_id": "Q2641560", "wikidata_description": "Process of extracting oil from olives", "wikipedia_url": "https://en.wikipedia.org/wiki/Olive%20oil%20extraction", "wikipedia_extract": "Olive oil is a vegetable oil obtained by pressing whole olives (the fruit of Olea europaea, a traditional tree crop of the Mediterranean Basin) and extracting the oil. It is commonly used in cooking for frying foods, as a condiment, or as a salad dressing. It can also be found in some cosmetics, pharmaceuticals, soaps, and fuels for traditional oil lamps. It also has additional uses in some religions. The olive is one of three core food plants in Mediterranean cuisine, with wheat and grapes. Olive trees have been cultivated around the Mediterranean since the 8th millennium BC."}, "member_count": 4, "cross_references": [{"found_name": "olio", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 203, "target_cluster_name": "olio", "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "(ole lungo te po. Altri , che !o voghon g ta- re più refolunuo, pigliano vna parte d^intafione, & vna di fu- go di role,& operano cornei detto, OLIO VIOLATO I*01ìo violato fi fa co«ie _ l'olio roiato ", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "reverse: a type of oil, used in comparison", "is_reverse": true}, {"found_name": "Love", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 430, "target_cluster_name": "Love", "source_book": "english_physician_1652", "evidence_snippet": "Dis∣case. Chap. 5. Of Oyles. 1. OYL Olive, which is commonly known by the name of Sallet Oyl, I suppose because it is usually eaten with Sallets by them that love it; If it be pressed out of ripe Oliv", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "reverse: type of Oyl", "is_reverse": true}]}, {"canonical_name": "amargos", "category": "CONCEPT", "subcategory": "QUALITY", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "amarguo", "book_id": "coloquios_da_orta_1563", "name": "amarguo", "category": "CONCEPT", "subcategory": "QUALITY", "count": 7, "variants": ["amarguo", "amargo", "amargoso", "amargura", "amaridão"], "contexts": ["bitter flavor", "taste quality"]}, {"entity_id": "amargos", "book_id": "polyanthea_medicinal", "name": "amargos", "category": "CONCEPT", "subcategory": "QUALITY", "count": 8, "variants": ["amargos", "amargo", "amargor"], "contexts": ["quality that causes effervescence", "bitter qualities"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "amarguo", "target_book": "polyanthea_medicinal", "target_name": "amargos", "similarity": 0.949}], "id": 1883, "stable_key": "clu_61ee8e160fb395ca", "ground_truth": {"modern_name": "bitter taste", "confidence": "high", "type": "concept", "wikidata_id": "Q1517187", "wikidata_description": "basic taste", "wikipedia_url": "https://en.wikipedia.org/wiki/Bitterness", "wikipedia_extract": "Bitterness, also known as bitter, is one of the most sensitive of tastes, and many experience it as unpleasant, sharp, or off-putting, but it is sometimes desirable and intentionally added via various bittering agents. Common bitter foods and drinks include coffee, unsweetened cocoa, South American mate, coca tea, Momordica charantia, unripe olives, citrus peel, some varieties of cheese, many plants in the Brassicaceae family, Taraxacum greens, Marrubium vulgare, wild chicory, and escarole. The ethanol in alcoholic beverages tastes bitter, as do the additional bittering ingredients found in some alcoholic beverages, including hops in beer and gentian in bitters. Quinine is also known for its bitter taste and is found in tonic water. Bitterness is of interest to those studying evolution, as well as to various health researchers as a large number of naturally occurring bitter compounds are known to be toxic. The ability to detect bitter-tasting, toxic compounds at low thresholds is thought to serve an important protective function."}, "cross_references": [{"found_name": "Taste", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 858, "target_cluster_name": "taste", "source_book": "llm_generated", "evidence_snippet": "Bitter taste is one of the fundamental categories of taste.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Bitter taste is one of the fundamental categories of taste."}, {"found_name": "amargozo", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "* II 276 RuBiNS tem mineira e roca conhecida II 217 Rumes diferem dos Turcos I 32 Saborks nesta terra não ha mais que três sabores, doce e azedo e amargo, e todo o sabor que lhe não sabe chamam amar- ", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "term for a flavor that is not pleasing"}, {"found_name": "Sândalo branco", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "* II 276 RuBiNS tem mineira e roca conhecida II 217 Rumes diferem dos Turcos I 32 Saborks nesta terra não ha mais que três sabores, doce e azedo e amargo, e todo o sabor que lhe não sabe chamam amar- ", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of sandalwood"}, {"found_name": "sândalo vermelho", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "* II 276 RuBiNS tem mineira e roca conhecida II 217 Rumes diferem dos Turcos I 32 Saborks nesta terra não ha mais que três sabores, doce e azedo e amargo, e todo o sabor que lhe não sabe chamam amar- ", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of sandalwood"}]}, {"canonical_name": "Acoro", "category": "PLANT", "subcategory": "ROOT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "açoro", "book_id": "coloquios_da_orta_1563", "name": "açoro", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 7, "variants": ["açoro"], "contexts": ["plant used in place of amomum", "plant name"]}, {"entity_id": "acoro", "book_id": "ricettario_fiorentino_1597", "name": "Acoro", "category": "PLANT", "subcategory": "ROOT", "count": 8, "variants": ["acoro", "Acoro"], "contexts": ["plant with leaves and roots like iris", "plant related to calamo aromatico"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "açoro", "target_book": "ricettario_fiorentino_1597", "target_name": "Acoro", "similarity": 0.675}], "id": 1884, "stable_key": "clu_a72999d0991bcbf4", "ground_truth": {"modern_name": "sweet flag", "confidence": "high", "type": "plant", "linnaean": "Acorus calamus Linnaeus", "family": "Acoraceae", "note": "The spellings 'açoro' and 'Acoro' are consistent with the plant Acorus calamus."}, "cross_references": []}, {"canonical_name": "pao de Aguila", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 18, "members": [{"entity_id": "páo_de_aguila", "book_id": "coloquios_da_orta_1563", "name": "páo de aguila", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["páo de aguila", "pau de aguila"], "contexts": ["Portuguese name for aloes wood", "wood product"]}, {"entity_id": "pao_de_aguila", "book_id": "polyanthea_medicinal", "name": "pao de Aguila", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 12, "variants": ["pao de Aguila", "PaodeAguila", "paode Aguila", "paode aguila", "paodeAguila", "pào de Aguila", "pão de Aguila", "pãodeAguila", "pò de páode Aguila"], "contexts": ["ingredient in tobacco", "ingredient in a remedy"]}, {"entity_id": "eagle_wood", "book_id": "coloquios_da_orta_1563", "name": "eagle wood", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["eagle wood"], "contexts": ["English name for aloes wood"]}, {"entity_id": "eaglewood", "book_id": "polyanthea_medicinal", "name": "Eaglewood", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Eaglewood"], "contexts": ["used for perfuming"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "páo de aguila", "target_book": "polyanthea_medicinal", "target_name": "pao de Aguila", "similarity": 0.954}], "id": 1885, "stable_key": "clu_df483fa3129fe502", "ground_truth": {"modern_name": "aloes wood", "confidence": "high", "type": "plant", "description": "Fragrant wood used as incense and in traditional medicine.", "note": "Also known as agarwood or oud.", "wikipedia_extract": "Agarwood, aloeswood, eaglewood, gaharuwood, commonly referred to as oud or oudh (from Arabic: عود, romanized: ʿūd, pronounced [ʕuːd]), is a fragrant, dark and resinous wood used in incense, perfume, and small hand carvings. It forms in the heartwood of Aquilaria trees after they become infected with a type of Phaeoacremonium mold, P. parasitica. The tree defensively secretes a resin to combat the fungal infestation. Prior to becoming infected, the heartwood mostly lacks scent, and is relatively light and pale in colouration. However, as the infection advances and the tree produces its fragrant resin as a final option of defense, the heartwood becomes very dense, dark, and saturated with resin. This product is harvested, and most famously referred to in cosmetics under the scent names of oud, oodh or aguru; however, it is also called aloes (not to be confused with the succulent plant genus Aloe), agar (this name, as well, is not to be confused with the edible, algae-derived thickening agent agar agar), as well as gaharu or jinko."}, "member_count": 4, "cross_references": []}, {"canonical_name": "marmelada", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "marmelada", "book_id": "coloquios_da_orta_1563", "name": "marmelada", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["marmelada"], "contexts": ["sweet preserve made from fruit"]}, {"entity_id": "marmelada", "book_id": "polyanthea_medicinal", "name": "marmelada", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 14, "variants": ["marmelada", "marmelada crua", "marmelada deçumos"], "contexts": ["marmalade used as a binder", "conserve made from quince"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "marmelada", "target_book": "polyanthea_medicinal", "target_name": "marmelada", "similarity": 1.0}], "id": 1886, "stable_key": "clu_c0352f6d1253f493", "ground_truth": {"modern_name": "marmalade", "confidence": "high", "type": "object", "description": "Sweet preserve, typically made from fruit juice and rind.", "wikipedia_extract": "Marmalade is a sweet, tangy fruit preserve made from the juice and peel of citrus fruits boiled with sugar and water. The well-known version is made from bitter orange, but other citrus fruits such as lemons and limes can also be used. The bitter orange is mostly used in marmalade because of its high pectin content, which gives a thick consistency to its marmalade. In addition, the balance of acid and pectin is needed for consistency. Fruits with low pectin have it added to make the marmalade. Historically, the term marmalade was often used for non-citrus preserves."}, "cross_references": [{"found_name": "Conserve", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 683, "target_cluster_name": "Conserve", "source_book": "llm_generated", "evidence_snippet": "Conserves are fruit preserves, often made with sugar, and share a similar preparation method and category of foodstuff with marmalade.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Conserves are fruit preserves, often made with sugar, and share a similar preparation method and category of foodstuff with marmalade."}, {"found_name": "Sugar", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 254, "target_cluster_name": "Sugar", "source_book": "llm_generated", "evidence_snippet": "Sugar is a key ingredient in marmalade, essential for its preservation and sweetness.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Sugar is a key ingredient in marmalade, essential for its preservation and sweetness."}]}, {"canonical_name": "Afaro", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "afaro", "book_id": "ricettario_fiorentino_1597", "name": "Afaro", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 10, "variants": ["Afaro", "Af^ro", "Afarb", "Afàro", "afaro"], "contexts": ["root collected whole", "spice, likely saffron"]}, {"entity_id": "a_faro", "book_id": "ricettario_fiorentino_1597", "name": "A faro", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["A faro"], "contexts": ["ingredient in a preparation", "saffron"]}, {"entity_id": "afarò", "book_id": "ricettario_fiorentino_1597", "name": "Afarò", "category": "PLANT", "subcategory": "ROOT", "count": 1, "variants": ["Afarò"], "contexts": ["root from the spice trade"]}, {"entity_id": "afaro", "book_id": "polyanthea_medicinal", "name": "Afaro", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["Afaro"], "contexts": ["root used in emetic preparation", "herb"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Afaro", "target_book": "polyanthea_medicinal", "target_name": "Afaro", "similarity": 1.0}, {"source_book": "ricettario_fiorentino_1597", "source_name": "A faro", "target_book": "polyanthea_medicinal", "target_name": "Afaro", "similarity": 0.667}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Afarò", "target_book": "polyanthea_medicinal", "target_name": "Afaro", "similarity": 0.613}], "id": 1887, "stable_key": "clu_ba34944aa60603aa", "ground_truth": {"modern_name": "saffron", "confidence": "high", "type": "plant", "linnaean": "Crocus sativus", "family": "Iridaceae", "description": "Spice derived from the stigmas of Crocus flowers, used for color and flavor.", "wikipedia_extract": "Crocus sativus, commonly known as saffron crocus or autumn crocus, is a species of flowering plant in the iris family Iridaceae. A cormous autumn-flowering cultivated perennial, unknown in the wild, it is best known for the culinary use of its floral stigmas as the spice saffron. Human cultivation of saffron crocus and the trade and use of saffron have endured for more than 3,500 years and span different cultures, continents, and civilizations. The plant is most commonly known as the saffron crocus. The alternative name autumn crocus is also used for species in the Colchicum genus, which are not closely related but strongly resemble the true crocuses; in particular, the superficially similar species Colchicum autumnale is sometimes even referred to as meadow saffron. However, the true crocuses have three stamens and one style supporting three long stigmas, while colchicums have six stamens and three styles; and belong to a different family, Colchicaceae."}, "cross_references": [{"found_name": "Root", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 536, "target_cluster_name": "Root", "source_book": "coloquios_da_orta_1563", "evidence_snippet": "cur^ cuma. Ibn Baithar explica claramente esta deslocação de nome. Paliando do rhizoma da curcuma, diz assim : ... «os habitantes de Basra chamam a esta raiz al-kurkum, e al-kurkum é o açafrão; e cham", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "reverse: synonym for al-kurkum", "is_reverse": true}, {"found_name": "Crocus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2712, "target_cluster_name": "Crocus", "source_book": "llm_generated", "evidence_snippet": "Saffron is derived from the stigmas of the saffron crocus (Crocus sativus). 'Crocus' is a broader genus that includes the saffron species.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Saffron is derived from the stigmas of the saffron crocus (Crocus sativus). 'Crocus' is a broader genus that includes the saffron species."}]}, {"canonical_name": "agrimonia", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "agrimonia", "book_id": "ricettario_fiorentino_1597", "name": "Agrimonia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Agrimonia"], "contexts": ["plant commonly called Agrimonia"]}, {"entity_id": "agrimonia", "book_id": "polyanthea_medicinal", "name": "agrimonia", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 14, "variants": ["agrimonia"], "contexts": ["herb used in a medicinal preparation", "ingredient in a medicinal preparation"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Agrimonia", "target_book": "polyanthea_medicinal", "target_name": "agrimonia", "similarity": 0.731}], "id": 1888, "stable_key": "clu_fb0065676d3d83ac", "ground_truth": {"modern_name": "Agrimony", "confidence": "high", "type": "plant", "linnaean": "Agrimonia eupatoria", "family": "Rosaceae", "description": "An herb with yellow flowers, historically used in medicine.", "wikipedia_extract": "Agrimonia eupatoria is a species of agrimony that is often referred to as common agrimony, church steeples or sticklewort. The whole plant is dark green with numerous soft hairs. The soft hairs aid in the plant's seed pods sticking to any animal or person coming in contact with the plant. The flower spikes have a spicy odor like apricots. In the language of flowers, agrimony means thankfulness or gratitude. Agrimonia eupatoria is a foodplant for the caterpillars of the snout moth Endotricha flammealis."}, "cross_references": [{"found_name": "epithimo", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 616, "target_cluster_name": "epithimo", "source_book": "llm_generated", "evidence_snippet": "Both Cuscuta epithymum and Agrimony were historically used in traditional medicine, often for similar ailments, suggesting a potential overlap in their perceived medicinal properties or applications.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both Cuscuta epithymum and Agrimony were historically used in traditional medicine, often for similar ailments, suggesting a potential overlap in their perceived medicinal properties or applications.", "is_reverse": true}, {"found_name": "Eupatorium", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2241, "target_cluster_name": "Eupatorio", "source_book": "llm_generated", "evidence_snippet": "Agrimonia eupatoria is a species of agrimony, and Eupatorium is a genus that includes species historically related to or confused with agrimony in medicinal contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Agrimonia eupatoria is a species of agrimony, and Eupatorium is a genus that includes species historically related to or confused with agrimony in medicinal contexts."}, {"found_name": "chama rabode", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "polyanthea_medicinal", "evidence_snippet": "paoGua- plius adultimum uſqueſenium,imò ad jaco meyo arratel ,de falſa parrilha feyta em pò tres onças , de folhas de ſene efcolhidoduas onças ,& meya, de agrimonia,&de equiſeto ,( aqueo vulgo mortem ", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym"}]}, {"canonical_name": "Sir William Hamilton", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 15, "members": [{"entity_id": "sir_wm__hamilton", "book_id": "principles_of_psychology_james_1890", "name": "Sir Wm. Hamilton", "category": "PERSON", "subcategory": "SCHOLAR", "count": 5, "variants": ["Sir Wm. Hamilton", "Wm. Hamilton"], "contexts": ["philosopher defending soul's presence in body", "author of Discussions"]}, {"entity_id": "sir_william_hamilton", "book_id": "first_principles_spencer_