 "OTHER_CONCEPT", "count": 1, "variants": ["prudence"], "contexts": ["quality of good judgment and self-control"]}, {"entity_id": "cautery", "book_id": "polyanthea_medicinal", "name": "cautery", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 4, "variants": ["cautery", "cauteria"], "contexts": ["medical procedure", "medical treatment using heat"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "prudence", "target_book": "polyanthea_medicinal", "target_name": "cautery", "similarity": 0.914}], "id": 2817, "stable_key": "clu_53cdd187c16c53db", "ground_truth": {"modern_name": "cautery", "confidence": "medium", "type": "concept", "note": "The term 'prudence' appears to be an OCR error or misinterpretation in the context of a medical text where 'cautery' is the clear focus."}, "cross_references": [{"found_name": "cauterio", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1576, "target_cluster_name": "cauterio", "source_book": "llm_generated", "evidence_snippet": "The historical name 'cauterio' is a direct synonym for cauterization.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: The historical name 'cauterio' is a direct synonym for cauterization.", "is_reverse": true}]}, {"canonical_name": "Vienna", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "vienna", "book_id": "principles_of_psychology_james_1890", "name": "Vienna", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Vienna"], "contexts": ["city where pamphlet was published"]}, {"entity_id": "vienna", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Vienna", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Vienna"], "contexts": ["location of Kempelen", "city of Dr. Berre"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Vienna", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Vienna", "similarity": 1.0}], "id": 2818, "stable_key": "clu_b7658edbc6ca4609", "ground_truth": {"modern_name": "Vienna", "confidence": "high", "type": "place", "country": "Austria", "note": "The mention of 'Kempelen' (likely Wolfgang von Kempelen, inventor of the Mechanical Turk) points to Vienna. 'Vienne' in French can refer to the river or a department, but in the context of scientific inquiry and publications, Vienna is the most probable city.", "wikidata_id": "Q577544", "wikidata_description": "city in Johnson County, Illinois, United States", "wikipedia_url": "https://en.wikipedia.org/wiki/Vienna%2C%20Illinois", "wikipedia_extract": "Vienna (  vee-EN-ə; German: Wien [viːn] ; Austro-Bavarian: Wean [veɐ̯n]) is the capital, most populous city, and one of the nine states of Austria. It is Austria's primate city, with just over two million inhabitants. Its larger metropolitan area has a population of nearly 2.9 million, representing nearly one-third of the country's population. Vienna is the cultural, economic, and political centre of the country, the fifth-largest city by population in the European Union, and the most populous of the cities on the river Danube. The city lies on the eastern edge of the Vienna Woods (Wienerwald), the northeasternmost foothills of the Alps, that separate Vienna from the more western parts of Austria, at the transition to the Pannonian Basin. It sits on the Danube, and is traversed by the highly regulated Wienfluss (Vienna River)."}, "cross_references": [{"found_name": "Europe", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 30, "target_cluster_name": "Europe", "source_book": "llm_generated", "evidence_snippet": "Vienna is a major city in Europe.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Vienna is a major city in Europe."}]}, {"canonical_name": "nervous energy", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "nervous_matter", "book_id": "principles_of_psychology_james_1890", "name": "nervous matter", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["nervous matter"], "contexts": ["tissue of the nervous system"]}, {"entity_id": "nerve-force", "book_id": "principles_of_psychology_james_1890", "name": "nerve-force", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["nerve-force"], "contexts": ["physiological energy in nerves"]}, {"entity_id": "nervous_energy", "book_id": "first_principles_spencer_1862", "name": "nervous energy", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["nervous energy"], "contexts": ["energy associated with nervous system", "vital force in the nervous system"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "nervous matter", "target_book": "first_principles_spencer_1862", "target_name": "nervous energy", "similarity": 0.929}, {"source_book": "principles_of_psychology_james_1890", "source_name": "nerve-force", "target_book": "first_principles_spencer_1862", "target_name": "nervous energy", "similarity": 0.922}], "id": 2819, "stable_key": "clu_5e80acd61966c2e2", "ground_truth": {"modern_name": "nervous energy", "confidence": "high", "type": "concept", "wikidata_id": "Q91484614", "wikidata_description": "scientific article published on 01 October 1885"}, "cross_references": [{"found_name": "Nervous system", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1588, "target_cluster_name": "nervous system", "source_book": "llm_generated", "evidence_snippet": "Nervous energy is a fundamental aspect of the functioning of the nervous system.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Nervous energy is a fundamental aspect of the functioning of the nervous system."}, {"found_name": "Nervous tension", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4165, "target_cluster_name": "nervous tension", "source_book": "llm_generated", "evidence_snippet": "Nervous energy can manifest as or be associated with a state of nervous tension.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Nervous energy can manifest as or be associated with a state of nervous tension."}]}, {"canonical_name": "Doudos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "idiots", "book_id": "principles_of_psychology_james_1890", "name": "idiots", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["idiots"], "contexts": ["individuals with intellectual disability"]}, {"entity_id": "doudos", "book_id": "polyanthea_medicinal", "name": "Doudos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 4, "variants": ["Doudos", "Doudo", "doudos"], "contexts": ["madness", "mentally ill people"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "idiots", "target_book": "polyanthea_medicinal", "target_name": "Doudos", "similarity": 0.929}], "id": 2820, "stable_key": "clu_566a44864a0331bc", "ground_truth": {"modern_name": "madness", "confidence": "high", "type": "disease", "description": "A severe mental disorder characterized by loss of contact with reality.", "wikipedia_extract": "The history of medicine is both a study of medicine throughout history as well as a multidisciplinary field of study that seeks to explore and understand medical practices, both past and present, throughout human societies. The history of medicine is the study and documentation of the evolution of medical treatments, practices, and knowledge over time. Medical historians often draw from other humanities fields of study including economics, health sciences, sociology, and politics to better understand the institutions, practices, people, professions, and social systems that have shaped medicine. When a period which predates or lacks written sources regarding medicine, information is instead drawn from archaeological sources. This field tracks the evolution of human societies' approach to health, illness, and injury ranging from prehistory to the modern day, the events that shape these approaches, and their impact on populations. Early medical traditions include those of Babylon, Egypt, China and India."}, "cross_references": [{"found_name": "Mania", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1323, "target_cluster_name": "Madness", "source_book": "llm_generated", "evidence_snippet": "The historical term 'Doudos' is a direct synonym for 'Mania' in the context of historical medical terminology, both referring to a state of intense mental agitation or derangement.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "The historical term 'Doudos' is a direct synonym for 'Mania' in the context of historical medical terminology, both referring to a state of intense mental agitation or derangement."}, {"found_name": "Insanity", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1178, "target_cluster_name": "insane", "source_book": "llm_generated", "evidence_snippet": "'Madness' (Doudos) is a historical term that is closely related to 'Insanity', often used interchangeably or as a broader category encompassing various forms of severe mental disorder.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "'Madness' (Doudos) is a historical term that is closely related to 'Insanity', often used interchangeably or as a broader category encompassing various forms of severe mental disorder."}, {"found_name": "Lunacy", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3934, "target_cluster_name": "Lunatick", "source_book": "llm_generated", "evidence_snippet": "'Madness' (Doudos) is historically linked to 'Lunacy', which specifically referred to mental disorders believed to be influenced by the moon, but often used more broadly for mental derangement.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "'Madness' (Doudos) is historically linked to 'Lunacy', which specifically referred to mental disorders believed to be influenced by the moon, but often used more broadly for mental derangement."}, {"found_name": "Delirium", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 235, "target_cluster_name": "delirios", "source_book": "llm_generated", "evidence_snippet": "'Madness' (Doudos) can be related to 'Delirium' as a symptom or a component of a more severe mental state characterized by confusion and disorientation.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "'Madness' (Doudos) can be related to 'Delirium' as a symptom or a component of a more severe mental state characterized by confusion and disorientation."}, {"found_name": "Melancholy", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 868, "target_cluster_name": "melancolia", "source_book": "llm_generated", "evidence_snippet": "'Madness' (Doudos) is related to 'Melancholy' as historical classifications of mental distress often distinguished between states of agitation (mania/madness) and profound sadness or depression (melancholy), though the boundaries were fluid.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "'Madness' (Doudos) is related to 'Melancholy' as historical classifications of mental distress often distinguished between states of agitation (mania/madness) and profound sadness or depression (melancholy), though the boundaries were fluid."}, {"found_name": "Frenzy", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 571, "target_cluster_name": "freneticos", "source_book": "llm_generated", "evidence_snippet": "'Madness' (Doudos) is related to 'Frenzy' as both terms describe states of extreme agitation, excitement, or uncontrolled behavior, with 'Frenzy' often implying a more acute and violent manifestation.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "'Madness' (Doudos) is related to 'Frenzy' as both terms describe states of extreme agitation, excitement, or uncontrolled behavior, with 'Frenzy' often implying a more acute and violent manifestation."}]}, {"canonical_name": "Dublin", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "dublin", "book_id": "principles_of_psychology_james_1890", "name": "Dublin", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Dublin"], "contexts": ["city where Maguire was professor"]}, {"entity_id": "dublin", "book_id": "kosmos_humboldt_1845", "name": "Dublin", "category": "PLACE", "subcategory": "CITY", "count": 4, "variants": ["Dublin"], "contexts": ["city with moderate temperatures", "capital city of Ireland"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Dublin", "target_book": "kosmos_humboldt_1845", "target_name": "Dublin", "similarity": 1.0}], "id": 2821, "stable_key": "clu_4f5dbd39893bd4b6", "ground_truth": {"modern_name": "Dublin", "confidence": "high", "type": "place", "country": "Ireland", "wikidata_id": "Q1761", "wikidata_description": "capital and largest city of Ireland", "wikipedia_extract": "Dublin is the capital and largest city of Ireland. Situated on Dublin Bay at the mouth of the River Liffey, it is in the province of Leinster, and is bordered on the south by the Dublin Mountains, part of the Wicklow Mountains range. Dublin is the largest city by population on the island of Ireland; at the 2022 census, the city council area had a population of 592,713, while the city, including suburbs, had a population of 1,263,219, and County Dublin had a population of 1,501,500. Various definitions of a metropolitan Greater Dublin Area exist. A settlement was established in the area by the Gaels during or before the 7th century, followed by the Vikings. As the Kingdom of Dublin grew, it became Ireland's principal settlement by the 12th century, following the Anglo-Norman invasion of Ireland.", "wikipedia_url": "https://en.wikipedia.org/wiki/Dublin"}, "cross_references": [{"found_name": "London", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 6, "target_cluster_name": "London", "source_book": "llm_generated", "evidence_snippet": "Dublin is the capital of Ireland, and historically, England and Ireland had close political and geographical ties, making their capitals often discussed together.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Dublin is the capital of Ireland, and historically, England and Ireland had close political and geographical ties, making their capitals often discussed together.", "is_reverse": true}, {"found_name": "Ireland", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 114, "target_cluster_name": "Irlande", "source_book": "llm_generated", "evidence_snippet": "Dublin is the capital city of Ireland.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Dublin is the capital city of Ireland."}]}, {"canonical_name": "Horologium", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "clockwork", "book_id": "principles_of_psychology_james_1890", "name": "clockwork", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 1, "variants": ["clockwork"], "contexts": ["mechanism for timing"]}, {"entity_id": "horologium", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Horologium", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 4, "variants": ["Horologium"], "contexts": ["constellation with nebulous patches", "astronomical constellation"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "clockwork", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Horologium", "similarity": 0.943}], "id": 2822, "stable_key": "clu_7479b319b93e9275", "ground_truth": {"modern_name": "Horologium", "confidence": "high", "type": "object", "note": "Context suggests both the astronomical constellation and potentially a clockwork mechanism, but 'Horologium' is the specific historical term.", "wikidata_id": "Q10574", "wikidata_description": "constellation in the southern celestial hemisphere"}, "cross_references": [{"found_name": "chronomètres", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 853, "target_cluster_name": "chronomètres", "source_book": "llm_generated", "evidence_snippet": "Horologium is a Latin term for a clock or timekeeping device, closely related to the concept of a chronometer.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Horologium is a Latin term for a clock or timekeeping device, closely related to the concept of a chronometer.", "is_reverse": true}, {"found_name": "clocks", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2303, "target_cluster_name": "clocks", "source_book": "llm_generated", "evidence_snippet": "Horologium is a Latin term that can refer to a clock or timekeeping instrument, making it a direct historical synonym or closely related term.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Horologium is a Latin term that can refer to a clock or timekeeping instrument, making it a direct historical synonym or closely related term.", "is_reverse": true}, {"found_name": "pendulum-strokes", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4241, "target_cluster_name": "pendulum-strokes", "source_book": "llm_generated", "evidence_snippet": "Horologium refers to a clock or timekeeping device, and pendulums were crucial for the accuracy of many historical clocks.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Horologium refers to a clock or timekeeping device, and pendulums were crucial for the accuracy of many historical clocks.", "is_reverse": true}, {"found_name": "Chronometers", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 853, "target_cluster_name": "chronomètres", "source_book": "llm_generated", "evidence_snippet": "Both Horologium and Chronometers are types of timekeeping devices.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both Horologium and Chronometers are types of timekeeping devices."}, {"found_name": "clock", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2303, "target_cluster_name": "clocks", "source_book": "llm_generated", "evidence_snippet": "Both Horologium and clock are devices for measuring and indicating time.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both Horologium and clock are devices for measuring and indicating time."}, {"found_name": "watch", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3517, "target_cluster_name": "watch", "source_book": "llm_generated", "evidence_snippet": "Both Horologium and watch are portable timekeeping devices.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both Horologium and watch are portable timekeeping devices."}, {"found_name": "Pendulum", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2775, "target_cluster_name": "pendulum", "source_book": "llm_generated", "evidence_snippet": "Pendulums are often key components in horological devices like clocks and watches.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Pendulums are often key components in horological devices like clocks and watches."}]}, {"canonical_name": "Quintiliopa", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 5, "members": [{"entity_id": "quintilian", "book_id": "principles_of_psychology_james_1890", "name": "Quintilian", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Quintilian"], "contexts": ["ancient rhetorician quoted on attention and memory"]}, {"entity_id": "quintiliopa", "book_id": "polyanthea_medicinal", "name": "Quintiliopa", "category": "PERSON", "subcategory": "AUTHORITY", "count": 4, "variants": ["Quintiliopa", "Quintilio.", "Quintiliode", "Quintitio"], "contexts": ["cited for emetics in delirium", "ancient authority for purging humor"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "Quintilian", "target_book": "polyanthea_medicinal", "target_name": "Quintiliopa", "similarity": 0.851}], "id": 2823, "stable_key": "clu_1ff02d569daec5ed", "ground_truth": {"modern_name": "Quintilian", "confidence": "high", "type": "person", "description": "Roman rhetorician and teacher, influential in classical education.", "note": "The texts mention Quintiliopa and Quintilian. Quintilian is the correct identification of the classical authority.", "wikipedia_extract": "Marcus Fabius Quintilianus (Latin: [kʷiːntɪliˈaːnʊs]; c. 35 – c. 100 AD) was a Roman educator and rhetorician born in Hispania, widely referred to in medieval schools of rhetoric and in Renaissance writing. In English translation, he is usually referred to as Quintilian ( kwin-TIL-ee-ən), although the alternate spellings of Quintillian and Quinctilian are occasionally seen, the latter in older texts. Quintilian was born c. 35 AD in Calagurris (Calahorra, La Rioja) in Hispania. His father, a well-educated man, sent him to Rome to study rhetoric early in the reign of Nero. While there, he cultivated a relationship with Domitius Afer, who died in 59. \"It had always been the custom … for young men with ambitions in public life to fix upon some older model of their ambition … and regard him as a mentor\". Quintilian evidently adopted Afer as his model and listened to him speak and plead cases in the law courts."}, "cross_references": [{"found_name": "Cicero", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 308, "target_cluster_name": "Cicero", "source_book": "llm_generated", "evidence_snippet": "Quintilian was a student of Cicero's rhetorical tradition and frequently referenced his works.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Quintilian was a student of Cicero's rhetorical tradition and frequently referenced his works."}, {"found_name": "Aulus Cornelius Celsus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 676, "target_cluster_name": "Cornelius Celfus", "source_book": "llm_generated", "evidence_snippet": "Both Quintilian and Celsus were prominent Roman intellectuals whose works were influential in later periods, particularly during the Renaissance.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both Quintilian and Celsus were prominent Roman intellectuals whose works were influential in later periods, particularly during the Renaissance."}, {"found_name": "Galen", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 29, "target_cluster_name": "Galen", "source_book": "llm_generated", "evidence_snippet": "Both Quintilian and Galen were highly influential figures in their respective fields (rhetoric and medicine) during antiquity, and their works were widely studied and commented upon in later centuries.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both Quintilian and Galen were highly influential figures in their respective fields (rhetoric and medicine) during antiquity, and their works were widely studied and commented upon in later centuries."}]}, {"canonical_name": "Dumas", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 2, "total_mentions": 5, "m