ook_id": "principles_of_psychology_james_1890", "name": "free-will", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["free-will"], "contexts": ["ability to choose actions"]}, {"entity_id": "free_will", "book_id": "principles_of_psychology_james_1890", "name": "free will", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["free will"], "contexts": ["ability to make choices"]}, {"entity_id": "freewill", "book_id": "first_principles_spencer_1862", "name": "freewill", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["freewill"], "contexts": ["ability to choose actions independently"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "free-will", "target_book": "first_principles_spencer_1862", "target_name": "freewill", "similarity": 0.983}, {"source_book": "principles_of_psychology_james_1890", "source_name": "free will", "target_book": "first_principles_spencer_1862", "target_name": "freewill", "similarity": 0.954}], "id": 3567, "stable_key": "clu_7b90a683276327b0", "ground_truth": {"modern_name": "Free will", "confidence": "high", "type": "concept", "wikidata_id": "Q9476", "wikidata_description": "ability of agents to be the ultimate source or originator of their choices, free from external determination", "wikipedia_url": "https://en.wikipedia.org/wiki/Free%20will", "wikipedia_extract": "Free will is generally understood as the capacity or ability of people to (a) choose between different possible courses of action, (b) exercise control over their actions in a way that is necessary for moral responsibility, or (c) be the ultimate source or originator of their actions. There are different theories as to its nature, and these aspects are often emphasized differently depending on philosophical tradition, with debates focusing on whether and how such freedom can coexist with physical determinism, divine foreknowledge, and other constraints. Free will is closely linked to the concepts of moral responsibility and moral desert, praise, culpability, and other judgements that can logically apply only to actions that are freely chosen. It is also connected with the concepts of advice, persuasion, deliberation, and prohibition. Traditionally, only actions that are freely willed are seen as deserving credit or blame. Whether free will exists and the implications of whether it exists or not constitute some of the longest-running debates of philosophy."}, "cross_references": [{"found_name": "volition", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 250, "target_cluster_name": "volition", "source_book": "llm_generated", "evidence_snippet": "Free will is a philosophical concept that is directly synonymous with or a core component of volition, emphasizing the capacity to make uncoerced choices.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Free will is a philosophical concept that is directly synonymous with or a core component of volition, emphasizing the capacity to make uncoerced choices.", "is_reverse": true}, {"found_name": "faith", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 498, "target_cluster_name": "faith", "source_book": "llm_generated", "evidence_snippet": "The relationship between faith and free will, particularly in theological contexts, is a recurring theme.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The relationship between faith and free will, particularly in theological contexts, is a recurring theme.", "is_reverse": true}, {"found_name": "soul", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 578, "target_cluster_name": "soul", "source_book": "llm_generated", "evidence_snippet": "The capacity for free will was frequently attributed to the soul, making it a core concept in discussions about human agency and moral responsibility, and thus related to the soul.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The capacity for free will was frequently attributed to the soul, making it a core concept in discussions about human agency and moral responsibility, and thus related to the soul.", "is_reverse": true}, {"found_name": "will", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 617, "target_cluster_name": "will", "source_book": "llm_generated", "evidence_snippet": "This is a direct synonym or a very closely related concept, often used interchangeably with willpower in philosophical and psychological discussions.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: This is a direct synonym or a very closely related concept, often used interchangeably with willpower in philosophical and psychological discussions.", "is_reverse": true}, {"found_name": "passion", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1042, "target_cluster_name": "passion", "source_book": "llm_generated", "evidence_snippet": "Historical discussions often explore the tension between 'passion' (as an impulse) and 'free will' (as rational choice).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Historical discussions often explore the tension between 'passion' (as an impulse) and 'free will' (as rational choice).", "is_reverse": true}, {"found_name": "fortune", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1404, "target_cluster_name": "fortune", "source_book": "llm_generated", "evidence_snippet": "The relationship between free will and fortune (or fate) was a perennial philosophical debate. Texts often explored the extent to which human agency could overcome or was subject to predetermined fortune.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The relationship between free will and fortune (or fate) was a perennial philosophical debate. Texts often explored the extent to which human agency could overcome or was subject to predetermined fortune.", "is_reverse": true}]}, {"canonical_name": "mental act", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "mental_act", "book_id": "principles_of_psychology_james_1890", "name": "mental act", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["mental act"], "contexts": ["operation of the mind"]}, {"entity_id": "mental_act", "book_id": "first_principles_spencer_1862", "name": "mental act", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["mental act"], "contexts": ["a process of the mind", "unit of mental operation"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "mental act", "target_book": "first_principles_spencer_1862", "target_name": "mental act", "similarity": 1.0}], "id": 3568, "stable_key": "clu_b0cfa054052d96b3", "ground_truth": {"modern_name": "Mental act", "confidence": "high", "type": "concept"}, "cross_references": [{"found_name": "hearing", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1816, "target_cluster_name": "hearing", "source_book": "llm_generated", "evidence_snippet": "Hearing is a mental act involving the processing of auditory stimuli.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Hearing is a mental act involving the processing of auditory stimuli.", "is_reverse": true}, {"found_name": "practice", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1940, "target_cluster_name": "practice", "source_book": "llm_generated", "evidence_snippet": "Practices can be mental acts or involve them.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Practices can be mental acts or involve them.", "is_reverse": true}]}, {"canonical_name": "pathological disturbance", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "pathological_disturbance", "book_id": "principles_of_psychology_james_1890", "name": "pathological disturbance", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["pathological disturbance"], "contexts": ["abnormal condition affecting mental state"]}, {"entity_id": "bodily_disorder", "book_id": "first_principles_spencer_1862", "name": "bodily disorder", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["bodily disorder"], "contexts": ["physical ailment or malfunction"]}, {"entity_id": "functional_derangement", "book_id": "first_principles_spencer_1862", "name": "functional derangement", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["functional derangement"], "contexts": ["disruption of normal bodily functions"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "pathological disturbance", "target_book": "first_principles_spencer_1862", "target_name": "bodily disorder", "similarity": 0.911}, {"source_book": "principles_of_psychology_james_1890", "source_name": "pathological disturbance", "target_book": "first_principles_spencer_1862", "target_name": "functional derangement", "similarity": 0.885}], "id": 3569, "stable_key": "clu_068e0f72f04c63ab", "ground_truth": {"modern_name": "Abnormal condition or malfunction", "confidence": "high", "type": "disease", "modern_term": "Abnormal condition or malfunction", "note": "These terms broadly refer to any deviation from normal functioning, whether mental or physical, and don't map to a single specific disease.", "wikidata_id": "Q7208", "wikidata_description": "study and diagnosis of disease", "wikipedia_url": "https://en.wikipedia.org/wiki/Pathology", "wikipedia_extract": "Pathology is the study of disease. The word pathology also refers to the study of disease in general, incorporating a wide range of biology research fields and medical practices. However, when used in the context of modern medical treatment, the term is often used in a narrower fashion to refer to processes and tests that fall within the contemporary medical field of \"general pathology\", an area that includes a number of distinct but inter-related medical specialties that diagnose disease, mostly through analysis of tissue and human cell samples. Pathology is a significant field in modern medical diagnosis and medical research. A physician practicing pathology is called a pathologist. As a field of general inquiry and research, pathology addresses components of disease: cause, mechanisms of development (pathogenesis), structural alterations of cells (morphologic changes), and the consequences of changes (clinical manifestations)."}, "cross_references": []}, {"canonical_name": "adjectives", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "adjectives", "book_id": "principles_of_psychology_james_1890", "name": "adjectives", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["adjectives"], "contexts": ["words describing nouns"]}, {"entity_id": "adjectives", "book_id": "first_principles_spencer_1862", "name": "adjectives", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["adjectives"], "contexts": ["words describing nouns"]}, {"entity_id": "adjective", "book_id": "first_principles_spencer_1862", "name": "adjective", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["adjective"], "contexts": ["modifies nouns"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "adjectives", "target_book": "first_principles_spencer_1862", "target_name": "adjectives", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "adjectives", "target_book": "first_principles_spencer_1862", "target_name": "adjective", "similarity": 0.935}], "id": 3570, "stable_key": "clu_601992c68d6de3c3", "ground_truth": {"modern_name": "Adjective", "confidence": "high", "type": "concept", "wikidata_id": "Q34698", "wikidata_description": "part of speech that describes a noun or pronoun", "wikipedia_url": "https://en.wikipedia.org/wiki/Adjective", "wikipedia_extract": "An adjective (abbreviated ADJ) is a word that describes or defines a noun or noun phrase. Its semantic role is to change information given by the noun. The adjective is considered one of the main parts of speech of the English language, although historically they were classed together with nouns. Nowadays, certain words that usually had been classified as adjectives, including the, this, my, etc., typically are classed separately, as determiners. That used to be an immensely funny idea. (Prepositive attributive) Tell me something funny."}, "cross_references": [{"found_name": "words", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 815, "target_cluster_name": "words", "source_book": "llm_generated", "evidence_snippet": "Adjectives are a class of words that modify nouns, providing descriptive information and enriching the meaning of words.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Adjectives are a class of words that modify nouns, providing descriptive information and enriching the meaning of words.", "is_reverse": true}]}, {"canonical_name": "focus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 3, "members": [{"entity_id": "focus", "book_id": "principles_of_psychology_james_1890", "name": "focus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["focus"], "contexts": ["bringing an image into sharp view"]}, {"entity_id": "focus", "book_id": "connexion_physical_sciences_somerville_1858", "name": "focus", "category": "CONC