 "tropical_zone", "book_id": "kosmos_humboldt_1845", "name": "tropical zone", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["tropical zone"], "contexts": ["equatorial climate zone", "geographic region with frequent thunderstorms"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "tropiques", "target_book": "kosmos_humboldt_1845", "target_name": "tropics", "similarity": 0.988}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "tropiques", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "tropics", "similarity": 0.988}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "tropiques", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "tropic", "similarity": 0.963}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "tropiques", "target_book": "first_principles_spencer_1862", "target_name": "tropics", "similarity": 0.988}, {"source_book": "kosmos_humboldt_1845", "source_name": "tropics", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "tropics", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "tropics", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "tropic", "similarity": 0.978}, {"source_book": "kosmos_humboldt_1845", "source_name": "tropics", "target_book": "first_principles_spencer_1862", "target_name": "tropics", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "tropics", "target_book": "first_principles_spencer_1862", "target_name": "tropics", "similarity": 1.0}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "tropic", "target_book": "first_principles_spencer_1862", "target_name": "tropics", "similarity": 0.978}], "id": 261, "stable_key": "clu_7f80c519c67520ef", "ground_truth": {"modern_name": "Tropics", "confidence": "high", "type": "place", "country": "Global", "wikidata_id": "Q42530", "wikidata_description": "region of the Earth surrounding the equator", "wikipedia_url": "https://en.wikipedia.org/wiki/Tropics", "wikipedia_extract": "The tropics are the region of Earth surrounding the equator, where the Sun may shine directly overhead. This contrasts with the temperate or polar regions of Earth, where the Sun can never be directly overhead. Because of Earth's axial tilt, the width of the tropics (in latitude) is twice the tilt. The tropics are also referred to as the tropical zone and the torrid zone (see geographical zone). Due to the sun's high angle throughout the year, the tropics receive the most solar energy over the course of the year, and consequently have the highest temperatures on the planet. Even when not directly overhead, the sun is still close to overhead throughout the year, therefore the tropics also have the lowest seasonal variation on the planet; \"winter\" and \"summer\" lose their temperature contrast."}, "member_count": 9, "cross_references": [{"found_name": "Equator", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 61, "target_cluster_name": "equator", "source_book": "llm_generated", "evidence_snippet": "The tropics are defined by their proximity to the Equator.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The tropics are defined by their proximity to the Equator."}, {"found_name": "equatorial or rotation currnt", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "kosmos_humboldt_1845", "evidence_snippet": "line of trees, which are often found to be overthrown in the midst of a dense wood. The general movement of the sea from east to west between p 307 the tropics (termed the equatorial or rotation currn", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for tropics"}]}, {"canonical_name": "corpo", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 4, "total_mentions": 42, "members": [{"entity_id": "cuerpo", "book_id": "historia_medicinal_monardes_1574", "name": "cuerpo", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 4, "variants": ["cuerpo"], "contexts": ["body", "the body"]}, {"entity_id": "corpo", "book_id": "coloquios_da_orta_1563", "name": "corpo", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["corpo"], "contexts": ["examined for illness"]}, {"entity_id": "corpo", "book_id": "ricettario_fiorentino_1597", "name": "Corpo", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["Corpo"], "contexts": ["body"]}, {"entity_id": "corpo", "book_id": "polyanthea_medicinal", "name": "corpo", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 36, "variants": ["corpo", "Corpo"], "contexts": ["The physical body", "body"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "cuerpo", "target_book": "coloquios_da_orta_1563", "target_name": "corpo", "similarity": 0.998}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "cuerpo", "target_book": "ricettario_fiorentino_1597", "target_name": "Corpo", "similarity": 0.992}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "cuerpo", "target_book": "polyanthea_medicinal", "target_name": "corpo", "similarity": 0.998}, {"source_book": "coloquios_da_orta_1563", "source_name": "corpo", "target_book": "ricettario_fiorentino_1597", "target_name": "Corpo", "similarity": 0.994}, {"source_book": "coloquios_da_orta_1563", "source_name": "corpo", "target_book": "polyanthea_medicinal", "target_name": "corpo", "similarity": 1.0}, {"source_book": "ricettario_fiorentino_1597", "source_name": "Corpo", "target_book": "polyanthea_medicinal", "target_name": "corpo", "similarity": 0.994}], "id": 262, "stable_key": "clu_d6fc48c8f15b7709-2", "ground_truth": {"modern_name": "Body", "confidence": "high", "type": "anatomy", "description": "The physical structure of a person or animal.", "wikipedia_extract": "The human body is the entire structure of a human being. It is composed of many different types of cells that together create tissues and subsequently organs and then organ systems. The external human body consists of a head, hair, neck, torso (which includes the thorax and abdomen), genitals, arms, hands, legs, and feet. The internal human body includes organs, teeth, bones, muscle, tendons, ligaments, blood vessels and blood, lymphatic vessels and lymph. The study of the human body includes anatomy, physiology, histology and embryology. The body varies anatomically in known ways."}, "cross_references": []}, {"canonical_name": "genus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 4, "total_mentions": 41, "members": [{"entity_id": "genus", "book_id": "origin_of_species_darwin_1859", "name": "genus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 36, "variants": ["genus"], "contexts": ["taxonomic rank above species", "taxonomic rank below family"]}, {"entity_id": "genus", "book_id": "principles_of_psychology_james_1890", "name": "genus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["genus"], "contexts": ["classification based on resemblance"]}, {"entity_id": "genus", "book_id": "kosmos_humboldt_1845", "name": "genus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["genus"], "contexts": ["biological classification"]}, {"entity_id": "genus", "book_id": "first_principles_spencer_1862", "name": "genus", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["genus"], "contexts": ["classification of similar opinions", "taxonomic rank in classification"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "genus", "target_book": "principles_of_psychology_james_1890", "target_name": "genus", "similarity": 1.0},