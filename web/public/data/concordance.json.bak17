ts": ["sealed earth, medicinal clay"]}, {"entity_id": "terra_figillada", "book_id": "polyanthea_medicinal", "name": "terra figillada", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 5, "variants": ["terra figillada", "terra Sigillada", "terra sigillata"], "contexts": ["ingredient in wound powder", "sealed earth, used externally"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "Tierra figilata", "target_book": "polyanthea_medicinal", "target_name": "terra figillada", "similarity": 0.947}], "id": 2625, "stable_key": "clu_02700fd2af7a257d", "ground_truth": {"modern_name": "terra sigillata", "confidence": "high", "type": "mineral", "note": "Also known as 'sealed earth' or medicinal clay, it was a specific type of clay tablet with a seal, used for medicinal purposes.", "wikidata_id": "Q367622", "wikidata_description": "fine red Ancient Roman pottery with glossy surface slips made in specific areas of the Roman Empire"}, "cross_references": [{"found_name": "Lemnian earth", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 482, "target_cluster_name": "Terra Lemnia", "source_book": "llm_generated", "evidence_snippet": "Both are specific types of earth/clay used medicinally, with 'Lemnian earth' being a well-known variety of medicinal earth, similar to how 'terra sigillata' was a specific medicinal earth.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are specific types of earth/clay used medicinally, with 'Lemnian earth' being a well-known variety of medicinal earth, similar to how 'terra sigillata' was a specific medicinal earth."}, {"found_name": "Armenian bole", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 335, "target_cluster_name": "bolo armenio", "source_book": "llm_generated", "evidence_snippet": "Both are specific types of medicinal earths/clays, historically valued for their therapeutic properties.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are specific types of medicinal earths/clays, historically valued for their therapeutic properties."}, {"found_name": "Earths", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1183, "target_cluster_name": "earths", "source_book": "llm_generated", "evidence_snippet": "'Terra sigillata' is a specific type of earth, making 'Earths' a broader category that encompasses it.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "'Terra sigillata' is a specific type of earth, making 'Earths' a broader category that encompasses it."}]}, {"canonical_name": "azeitonas", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "azeitonas", "book_id": "coloquios_da_orta_1563", "name": "azeitonas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["azeitonas", "azeitona"], "contexts": ["fruit, comparison", "appetite stimulant"]}, {"entity_id": "azeitonas", "book_id": "polyanthea_medicinal", "name": "azeitonas", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["azeitonas"], "contexts": ["fruit, olives"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "azeitonas", "target_book": "polyanthea_medicinal", "target_name": "azeitonas", "similarity": 1.0}], "id": 2626, "stable_key": "clu_4067f309771d872b", "ground_truth": {"modern_name": "olives", "confidence": "high", "type": "plant", "linnaean": "Olea europaea", "family": "Oleaceae", "description": "The fruit of the olive tree, used for food and oil.", "wikipedia_extract": "The olive (botanical name Olea europaea, \"European olive\") is a species of subtropical evergreen tree in the family Oleaceae. Originating in Asia Minor, it is abundant throughout the Mediterranean Basin, with wild subspecies in Africa and western Asia; modern cultivars are traced primarily to the Near East, Aegean Sea, and Strait of Gibraltar. The olive is the type species for its genus, Olea, and lends its name to the Oleaceae plant family, which includes lilac, jasmine, forsythia, and ash. The olive fruit is classed botanically as a drupe, similar in structure and function to the cherry or peach. The term oil—now used to describe any viscous water-insoluble liquid—was originally synonymous with olive oil, the liquid fat derived from olives. The olive has deep historical, economic, and cultural significance in the Mediterranean."}, "cross_references": [{"found_name": "olive tree", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1227, "target_cluster_name": "olives", "source_book": "llm_generated", "evidence_snippet": "The entity 'olives' is the fruit of the 'olive tree'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The entity 'olives' is the fruit of the 'olive tree'."}]}, {"canonical_name": "açucare rosado", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "açucare_rosado", "book_id": "coloquios_da_orta_1563", "name": "açucare rosado", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 5, "variants": ["açucare rosado", "açucar rosado", "açucare rosado de Alexandria"], "contexts": ["rose sugar preparation", "rose-infused sugar water"]}, {"entity_id": "açucar_rosado_de_alexan", "book_id": "polyanthea_medicinal", "name": "açucar Rosado de Alexan", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["açucar Rosado de Alexan"], "contexts": ["added to decoction for fever"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "açucare rosado", "target_book": "polyanthea_medicinal", "target_name": "açucar Rosado de Alexan", "similarity": 0.886}], "id": 2627, "stable_key": "clu_d5c569524c73aee1", "ground_truth": {"modern_name": "Rose sugar", "confidence": "high", "type": "substance", "description": "Sugar infused with rose petals or rose water.", "wikipedia_extract": "Redox ( RED-oks,  REE-doks, reduction–oxidation or oxidation–reduction) is a type of chemical reaction in which the oxidation states of the reactants change. Oxidation is the loss of electrons or an increase in the oxidation state, while reduction is the gain of electrons or a decrease in the oxidation state. The oxidation and reduction processes occur simultaneously in the chemical reaction. There are two classes of redox reactions: Electron-transfer – Only one (usually) electron flows from the atom, ion, or molecule being oxidized to the atom, ion, or molecule that is reduced. This type of redox reaction is often discussed in terms of redox couples and electrode potentials. Atom transfer – An atom transfers from one substrate to another."}, "cross_references": [{"found_name": "olio rosato", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 987, "target_cluster_name": "olio rosato", "source_book": "llm_generated", "evidence_snippet": "This is a preparation made with sugar and rose, indicating a close association with rose products.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: This is a preparation made with sugar and rose, indicating a close association with rose products.", "is_reverse": true}, {"found_name": "confeyção Alchermes", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2274, "target_cluster_name": "confeyção Alchermes", "source_book": "llm_generated", "evidence_snippet": "Alchermes is a confection that often includes rose sugar as an ingredient.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Alchermes is a confection that often includes rose sugar as an ingredient.", "is_reverse": true}, {"found_name": "Rose Honey", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1653, "target_cluster_name": "mel rosado", "source_book": "llm_generated", "evidence_snippet": "Rose sugar is a component of Rose Honey.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Rose sugar is a component of Rose Honey."}, {"found_name": "Rose oil", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 987, "target_cluster_name": "olio rosato", "source_book": "llm_generated", "evidence_snippet": "Rose sugar is a component of Rose oil.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Rose sugar is a component of Rose oil."}, {"found_name": "Rosewater", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 292, "target_cluster_name": "Rosewater", "source_book": "llm_generated", "evidence_snippet": "Rose sugar is a component of Rosewater.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Rose sugar is a component of Rosewater."}]}, {"canonical_name": "Babylonia", "category": "PLACE", "subcategory": "REGION", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "babylonia", "book_id": "coloquios_da_orta_1563", "name": "Babylonia", "category": "PLACE", "subcategory": "REGION", "count": 5, "variants": ["Babylonia"], "contexts": ["location of mines", "common name for Egypt"]}, {"entity_id": "babylonia", "book_id": "polyanthea_medicinal", "name": "Babylonia", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Babylonia"], "contexts": ["location of a plague"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Babylonia", "target_book": "polyanthea_medicinal", "target_name": "Babylonia", "similarity": 1.0}], "id": 2628, "stable_key": "clu_088df849a8e0335e", "ground_truth": {"modern_name": "Babylonia", "confidence": "medium", "type": "place", "description": "Ancient region in Mesopotamia; also a common name for Egypt.", "note": "The context suggests both the historical region of Babylonia and its association with Egypt.", "wikipedia_extract": "Babylonia (; Akkadian: 𒆳𒆍𒀭𒊏𒆠, māt Akkadī) was an ancient Akkadian-speaking state and cultural area based on the city of Babylon in central-southern Mesopotamia (present-day Iraq and parts of Syria). It emerged as an Akkadian-populated but Amorite-ruled state c. 1894 BC. During the reign of Hammurabi and afterwards, Babylonia was retrospectively called \"the country of Akkad\" (māt Akkadī in Akkadian), a deliberate archaism in reference to the previous glory of the Akkadian Empire. It was often involved in rivalry with the linguistically related state of Assyria in Upper Mesopotamia, and with Elam to the east. Babylonia briefly became the major power in the region after Hammurabi (fl. c. 1792–1752 BC middle chronology, or c. 1696–1654 BC, short chronology) created a short-lived empire, succeeding the earlier Akkadian Empire, Third Dynasty of Ur, and Old Assyrian Empire. The Babylonian Empire rapidly fell apart after the death of Hammurabi and reverted to a small kingdom centered around the city of Babylon."}, "cross_references": [{"found_name": "Euphrates", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1008, "target_cluster_name": "Euphrates", "source_book": "llm_generated", "evidence_snippet": "The Euphrates River flowed through the historical region of Babylonia.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The Euphrates River flowed through the historical region of Babylonia.", "is_reverse": true}, {"found_name": "Babel", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3110, "target_cluster_name": "Babel", "source_book": "llm_generated", "evidence_snippet": "Babylonia was the Akkadian-speaking region of which Babylon was the main political and cultural center.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Babylonia was the Akkadian-speaking region of which Babylon was the main political and cultural center.", "is_reverse": true}]}, {"canonical_name": "rama", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "rama", "book_id": "coloquios_da_orta_1563", "name": "rama", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["rama", "Rama", "ramo"], "contexts": ["part of a plant", "Hindu deity"]}, {"entity_id": "rami", "book_id": "ricettario_fiorentino_1597", "name": "rami", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["rami", "ramo"], "contexts": ["part of a plant, branches", "part of a plant"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "rama", "target_book": "ricettario_fiorentino_1597", "target_name": "rami", "similarity": 0.887}], "id": 2629, "stable_key": "clu_73ae7b568eafe189", "ground_truth": {"modern_name": "branch", "confidence": "high", "type": "plant", "note": "The terms 'rama' and 'rami' refer to branches or twigs of a plant, a common part of botanical descriptions and medicinal preparations."}, "cross_references": [{"found_name": "tree", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 24, "target_cluster_name": "Tree", "source_book": "llm_generated", "evidence_snippet": "A branch is a part of a tree.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "A branch is a part of a tree."}, {"found_name": "timber trees", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3930, "target_cluster_name": "Timber Trees", "source_book": "llm_generated", "evidence_snippet": "A branch is a part of a timber tree.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "A branch is a part of a timber tree."}, {"found_name": "wood", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1749, "target_cluster_name": "páo", "source_book": "llm_generated", "evidence_snippet": "A branch is a component of wood.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "A branch is a component of wood."}]}, {"canonical_name": "droga", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "droga", "book_id": "coloquios_da_orta_1563", "name": "droga", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["droga", "Drogas de las índias"], "contexts": ["benzoin from Siam", "substance that corrupts quickly"]}, {"entity_id": "droghe", "book_id": "ricettario_fiorentino_1597", "name": "Droghe", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Droghe"], "contexts": ["drugs or medicinal substances", "herbs and spices for medicine"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "droga", "target_book": "ricettario_fiorentino_1597", "target_name": "Droghe", "similarity": 0.974}], "id": 2630, "stable_key": "clu_b2b2b0852deb8574", "ground_truth": {"modern_name": "drugs", "confidence": "high", "type": "substance", "description": "Substances, especially medicinal ones, that may be natural or synthetic.", "note": "This term encompasses both medicinal preparations and raw materials like benzoin.", "wikipedia_extract": "A drug is any chemical substance  other than a nutrient or an essential dietary ingredient, which, when administered to a living organism, produces a biological effect. Consumption of drugs can be via inhalation, injection, smoking, ingestion, absorption via a patch on the skin, suppository, or dissolution under the tongue. A pharmaceutical drug, also called a medication or medicine, is a chemical substance used to treat, cure, prevent, or diagnose a disease or to promote well-being. Traditionally drugs were obtained through extraction from medicinal plants, but more recently also by organic synthesis. Pharmaceutical drugs may be used for a limited duration, or on a regular basis for chronic disorders. Pharmaceutical drugs are often classified into drug classes—groups of related drugs that have similar chemical structures, the same mechanism of action (binding to the same biological target), a related mode of action, and that are used to treat the same disease."}, "cross_references": [{"found_name": "Alcohol", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 131, "target_cluster_name": "alcohol", "source_book": "llm_generated", "evidence_snippet": "'Alcohol' is an English term, and while not a direct translation of 'droga', it represents a substance that was often considered a 'droga' in historical contexts. The term itself is widely adopted across languages.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "'Alcohol' is an English term, and while not a direct translation of 'droga', it represents a substance that was often considered a 'droga' in historical contexts. The term itself is widely adopted across languages."}, {"found_name": "lanquas", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "malayos chamam também lanquas á galanga menor da China, distinguindo-a pela designação de lanquas -kitsjil (Ainslie, 1. c; Rumphius, 1. c). Avicenna fallou d'esta droga, o que era natural, pois foi be", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for lesser galangal"}]}, {"canonical_name": "xilaloes", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "xilaloes", "book_id": "coloquios_da_orta_1563", "name": "xilaloes", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["xilaloes", "Xílaloes"], "contexts": ["a substance mentioned in a chapter", "Greek name for woody aloes"]}, {"entity_id": "xiloaloes", "book_id": "polyanthea_medicinal", "name": "xiloaloes", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["xiloaloes", "xilo-aloes"], "contexts": ["aloes wood, ingredient in remedy", "ingredient in a medicinal preparation"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "xilaloes", "target_book": "polyanthea_medicinal", "target_name": "xiloaloes", "similarity": 0.909}], "id": 2631, "stable_key": "clu_02ceebb6bfd466fb", "ground_truth": {"modern_name": "aloes wood", "confidence": "high", "type": "plant", "linnaean": "Aquilaria spp.", "family": "Thymelaeaceae", "description": "Aromatic resinous wood used in incense, perfumery, and medicine.", "note": " 'Xilaloes' and 'xiloaloes' are variations of the Greek term for aloes wood.", "wikipedia_extract": "Agarwood, aloeswood, eaglewood, gaharuwood, commonly referred to as oud or oudh (from Arabic: عود, romanized: ʿūd, pronounced [ʕuːd]), is a fragrant, dark and resinous wood used in incense, perfume, and small hand carvings. It forms in the heartwood of Aquilaria trees after they become infected with a type of Phaeoacremonium mold, P. parasitica. The tree defensively secretes a resin to combat the fungal infestation. Prior to becoming infected, the heartwood mostly lacks scent, and is relatively light and pale in colouration. However, as the infection advances and the tree produces its fragrant resin as a final option of defense, the heartwood becomes very dense, dark, and saturated with resin. This product is harvested, and most famously referred to in cosmetics under the scent names of oud, oodh or aguru; however, it is also called aloes (not to be confused with the succulent plant genus Aloe), agar (this name, as well, is not to be confused with the edible, algae-derived thickening agent agar agar), as well as gaharu or jinko."}, "cross_references": []}, {"canonical_name": "freixo", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "freixo", "book_id": "coloquios_da_orta_1563", "name": "freixo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["freixo", "freixos"], "contexts": ["tree size comparison", "tree for comparison"]}, {"entity_id": "freixo", "book_id": "polyanthea_medicinal", "name": "freixo", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["freixo"], "contexts": ["plant with virtue against viper venom", "ash, its leaves used as remedy"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "freixo", "target_book": "polyanthea_medicinal", "target_name": "freixo", "similarity": 1.0}], "id": 2632, "stable_key": "clu_8feab11fa5ec1929", "ground_truth": {"modern_name": "ash tree", "confidence": "high", "type": "plant", "linnaean": "Fraxinus spp.", "family": "Oleaceae", "description": "A tree with strong wood, whose leaves have medicinal properties.", "note": " 'Freixo' is the Portuguese and Galician word for ash tree.", "wikipedia_extract": "Fraxinus (), commonly called ash, is a genus of plants in the olive and lilac family, Oleaceae, and comprises 45–65 species of usually medium-to-large trees, most of which are deciduous (dropping their leaves in autumn), although some subtropical species are evergreen. The genus is widespread throughout much of Europe, Asia, and North America. The leaves are usually opposite, and mostly pinnately compound (divided into leaflets in a feather-like arrangement). The seeds, known as \"keys\", are botanically fruits of the type called samara. Some species are dioecious, having male and female flowers on separate plants. Ash wood is strong and elastic, and used for the handles of tools."}, "cross_references": [{"found_name": "Tree", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 24, "target_cluster_name": "Tree", "source_book": "llm_generated", "evidence_snippet": "Ash trees are a type of tree.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Ash trees are a type of tree."}, {"found_name": "Wood", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1749, "target_cluster_name": "páo", "source_book": "llm_generated", "evidence_snippet": "Ash trees are a source of wood.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Ash trees are a source of wood."}, {"found_name": "Leaves", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 154, "target_cluster_name": "leaves", "source_book": "llm_generated", "evidence_snippet": "Ash trees have leaves.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Ash trees have leaves."}, {"found_name": "pucko", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": null, "target_cluster_name": null, "source_book": "coloquios_da_orta_1563", "evidence_snippet": "tq>lot, lhe chamam todos pucko; porque he grande mercadoria pêra Malaca, onde se chama asi*. E o arvore donde se faz este caie he tam grande como hum freixo, e a folha he myuda como a das urzes, ou jo", "confidence": 0.65, "auto_label": "cross_linguistic", "found_relationship": "local name for a commodity"}]}, {"canonical_name": "Carlos VIII", "category": "PERSON", "subcategory": "PATRON", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "carlos_viii", "book_id": "coloquios_da_orta_1563", "name": "Carlos VIII", "category": "PERSON", "subcategory": "PATRON", "count": 3, "variants": ["Carlos VIII"], "contexts": ["King of France who invaded Italy", "invader of Italy"]}, {"entity_id": "carlos_ix_", "book_id": "polyanthea_medicinal", "name": "Carlos IX.", "category": "PERSON", "subcategory": "PATRON", "count": 3, "variants": ["Carlos IX."], "contexts": ["King of France during plague", "King of France"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Carlos VIII", "target_book": "polyanthea_medicinal", "target_name": "Carlos IX.", "similarity": 0.848}], "id": 2633, "stable_key": "clu_7a25d170bfb6899a", "ground_truth": {"modern_name": "Charles VIII of France", "confidence": "high", "type": "person", "birth_year": 1470, "death_year": 1498, "description": "King of France, led Italian invasion", "wikidata_id": "Q134452", "wikidata_description": "King of France from 1483 to 1498"}, "cross_references": [{"found_name": "Carlos V.", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 771, "target_cluster_name": "Carlos V.", "source_book": "llm_generated", "evidence_snippet": "Both were significant European monarchs of the late 15th and early 16th centuries, involved in dynastic politics and conflicts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were significant European monarchs of the late 15th and early 16th centuries, involved in dynastic politics and conflicts.", "is_reverse": true}, {"found_name": "French", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 877, "target_cluster_name": "French", "source_book": "llm_generated", "evidence_snippet": "Charles VIII was a King of France, and thus a prominent figure associated with the French nation and its history.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Charles VIII was a King of France, and thus a prominent figure associated with the French nation and its history.", "is_reverse": true}, {"found_name": "Louis XIV", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1091, "target_cluster_name": "Louis XIV", "source_book": "llm_generated", "evidence_snippet": "Charles VIII was a King of France, and Louis XIV was also a King of France. The succession of French monarchs is a direct and significant relationship.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Charles VIII was a King of France, and Louis XIV was also a King of France. The succession of French monarchs is a direct and significant relationship.", "is_reverse": true}]}, {"canonical_name": "lentisco", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "lentisco", "book_id": "coloquios_da_orta_1563", "name": "lentisco", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["lentisco"], "contexts": ["plant for comparison of leaf shape", "plant used for leaf comparison"]}, {"entity_id": "lentisco", "book_id": "ricettario_fiorentino_1597", "name": "lentisco", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 4, "variants": ["lentisco", "Lentisco", "lenti"], "contexts": ["plant from which Mastice is extracted", "source of oil"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "lentisco", "target_book": "ricettario_fiorentino_1597", "target_name": "lentisco", "similarity": 1.0}], "id": 2634, "stable_key": "clu_c8487a7c8e065f2e-2", "ground_truth": {"modern_name": "Lentil", "confidence": "medium", "type": "plant", "linnaean": "Lens culinaris", "family": "Fabaceae", "description": "A herbaceous annual legume plant grown for its edible seed.", "note": "Includes related terms for aquatic plants and similar-leafed plants, suggesting broader botanical interest.", "wikipedia_extract": "The lentil (Vicia lens or Lens culinaris) is an annual legume grown for its lens-shaped edible seeds or pulses, also called lentils. It is about 40 cm (16 in) tall, and the seeds grow in pods, usually with two seeds in each. Lentil seeds are used around the world for culinary purposes, most commonly in stews or soups. In cuisines of the Indian subcontinent, where lentils are a staple, split lentils (often with their hulls removed) known as dal are often cooked into a thick curry that is usually eaten with rice or roti. The English word \"lentil\" ultimately derives from the Latin lens ('lentil'). The Latin word is of classical Roman or Latin origin and may be the source of the prominent Roman family name Lentulus, just as the family name \"Cicero\" was derived from the chickpea, Cicer arietinum, and \"Fabia\" (as in Quintus Fabius Maximus) from the fava bean (Vicia faba)."}, "cross_references": [{"found_name": "Mastick", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 3244, "target_cluster_name": "Mastick", "source_book": "llm_generated", "evidence_snippet": "Both 'lentisco' and 'mastic' refer to the plant Pistacia lentiscus.", "confidence": 0.85, "auto_label": "llm_synonyms", "found_relationship": "reverse: Both 'lentisco' and 'mastic' refer to the plant Pistacia lentiscus.", "is_reverse": true}]}, {"canonical_name": "agua de canela", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "agua_de_canela", "book_id": "coloquios_da_orta_1563", "name": "agua de canela", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["agua de canela"], "contexts": ["Used to season many dishes"]}, {"entity_id": "agua_de_canela", "book_id": "polyanthea_medicinal", "name": "agua de canela", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 4, "variants": ["agua de canela", "aguadecanela"], "contexts": ["cinnamon water for moistening vapors", "water infused with cinnamon"]}, {"entity_id": "aguade_canela", "book_id": "polyanthea_medicinal", "name": "aguade canela", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["aguade canela"], "contexts": ["added to remedy"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "agua de canela", "target_book": "polyanthea_medicinal", "target_name": "agua de canela", "similarity": 1.0}, {"source_book": "coloquios_da_orta_1563", "source_name": "agua de canela", "target_book": "polyanthea_medicinal", "target_name": "aguade canela", "similarity": 0.848}], "id": 2635, "stable_key": "clu_975d637e7164bd51", "ground_truth": {"modern_name": "cinnamon water", "confidence": "high", "type": "substance", "description": "Water infused with the spice of cinnamon, used medicinally and for flavor.", "wikipedia_extract": "Cinnamon is a spice obtained from the inner bark of several tree species from the genus Cinnamomum. Cinnamon is used mainly as an aromatic condiment and flavouring additive in a wide variety of cuisines, in particular sweet and savoury dishes such as biscuits, breakfast cereals, snack foods, bagels, teas, hot chocolate, and traditional foods. The aroma and flavour of cinnamon derive from its essential oil and principal component, cinnamaldehyde, as well as numerous other constituents, including eugenol. Cinnamon is the name for several species of trees and the commercial spice products that some of them produce. All are members of the genus Cinnamomum in the family Lauraceae. Only a few Cinnamomum species are grown commercially for spice."}, "cross_references": [{"found_name": "Rosewater", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 292, "target_cluster_name": "Rosewater", "source_book": "llm_generated", "evidence_snippet": "Both are aromatic waters commonly used in historical medicine and perfumery, often prepared through distillation.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are aromatic waters commonly used in historical medicine and perfumery, often prepared through distillation."}]}, {"canonical_name": "Greeks", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "gregos_antiguos", "book_id": "coloquios_da_orta_1563", "name": "Gregos antiguos", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Gregos antiguos"], "contexts": ["ancient Greek writers"]}, {"entity_id": "greeks", "book_id": "first_principles_spencer_1862", "name": "Greeks", "category": "PERSON", "subcategory": "AUTHORITY", "count": 5, "variants": ["Greeks"], "contexts": ["ancient people who consulted oracles", "people with festivals accompanied by songs and dances"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "Gregos antiguos", "target_book": "first_principles_spencer_1862", "target_name": "Greeks", "similarity": 0.883}], "id": 2636, "stable_key": "clu_b1fab9976d11e8e1", "ground_truth": {"modern_name": "Ancient Greeks", "confidence": "high", "type": "concept", "note": "Refers to the people of ancient Greece and their writings.", "wikidata_id": "Q7798", "wikidata_description": "name give in ancient Greece to their region"}, "cross_references": [{"found_name": "Romans", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 120, "target_cluster_name": "Romans", "source_book": "llm_generated", "evidence_snippet": "The Romans conquered and absorbed Greek civilization, leading to a complex relationship of influence and subjugation.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Romans conquered and absorbed Greek civilization, leading to a complex relationship of influence and subjugation."}, {"found_name": "Egyptians", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 148, "target_cluster_name": "Egyptians", "source_book": "llm_generated", "evidence_snippet": "Ancient Egyptians were a foundational civilization that influenced Greek culture and science, and there was significant interaction between the two.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Ancient Egyptians were a foundational civilization that influenced Greek culture and science, and there was significant interaction between the two."}, {"found_name": "Assyrians", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2657, "target_cluster_name": "Assyrians", "source_book": "llm_generated", "evidence_snippet": "The Assyrians were a major ancient Near Eastern power that interacted with early Greek city-states and influenced the region.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Assyrians were a major ancient Near Eastern power that interacted with early Greek city-states and influenced the region."}, {"found_name": "Philosophers", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 431, "target_cluster_name": "philosopher", "source_book": "llm_generated", "evidence_snippet": "Ancient Greeks are renowned for their foundational contributions to Western philosophy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Ancient Greeks are renowned for their foundational contributions to Western philosophy."}]}, {"canonical_name": "Melao", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "melão", "book_id": "coloquios_da_orta_1563", "name": "melão", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["melão"], "contexts": ["fruit, comparison for size"]}, {"entity_id": "melao", "book_id": "polyanthea_medicinal", "name": "Melao", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["Melao", "melao", "melaő"], "contexts": ["type of fruit to avoid", "melon"]}, {"entity_id": "melão", "book_id": "polyanthea_medicinal", "name": "melão", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 2, "variants": ["melão"], "contexts": ["melon seeds used in a syrup", "seeds used for refreshing and cleansing kidneys"]}], "edges": [{"source_book": "coloquios_da_orta_1563", "source_name": "melão", "target_book": "polyanthea_medicinal", "target_name": "Melao", "similarity": 0.55}, {"source_book": "coloquios_da_orta_1563", "source_name": "melão", "target_book": "polyanthea_medicinal", "target_name": "melão", "similarity": 1.0}], "id": 2637, "stable_key": "clu_fcd7b6c2f3812c8c", "ground_truth": {"modern_name": "Melon", "confidence": "high", "type": "plant", "linnaean": "Cucumis melo L.", "family": "Cucurbitaceae"}, "cross_references": [{"found_name": "melancia", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1963, "target_cluster_name": "melancia", "source_book": "llm_generated", "evidence_snippet": "Watermelon and melao are both cucurbit fruits, often cultivated and discussed together in historical texts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Watermelon and melao are both cucurbit fruits, often cultivated and discussed together in historical texts.", "is_reverse": true}, {"found_name": "watermelon", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1963, "target_cluster_name": "melancia", "source_book": "llm_generated", "evidence_snippet": "Watermelon is a specific type of melon.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Watermelon is a specific type of melon."}]}, {"canonical_name": "lombrichi", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "lombrichi", "book_id": "ricettario_fiorentino_1597", "name": "lombrichi", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 5, "variants": ["lombrichi", "Lombrichi", "Lombrichéto"], "contexts": ["earthworms, taken whole", "earthworms, washed with white wine"]}, {"entity_id": "lombri", "book_id": "polyanthea_medicinal", "name": "lombri", "category": "ANIMAL", "subcategory": "OTHER_ANIMAL", "count": 1, "variants": ["lombri"], "contexts": ["worms"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "lombrichi", "target_book": "polyanthea_medicinal", "target_name": "lombri", "similarity": 0.895}], "id": 2638, "stable_key": "clu_24dd39fcfaeb1ef0", "ground_truth": {"modern_name": "Earthworms", "confidence": "high", "type": "animal", "description": "Annelid worms found in the earth, used in preparations.", "note": "Contexts refer to earthworms being used whole or washed for medicinal purposes.", "wikipedia_extract": "An earthworm is a soil-dwelling terrestrial invertebrate that belongs to the phylum Annelida. The term is the common name for the largest members of the class (or subclass, depending on the author) Oligochaeta. In classical systems, they were in the order of Opisthopora since the male pores opened posterior to the female pores, although the internal male segments are anterior to the female. Theoretical cladistic studies have placed them in the suborder Lumbricina of the order Haplotaxida, but this may change. Other slang names for earthworms include \"dew-worm\", \"rainworm\", \"nightcrawler\", and \"angleworm\" (from its use as angling hookbait). Larger terrestrial earthworms are also called megadriles (which translates to \"big worms\") as opposed to the microdriles (\"small worms\") in the semiaquatic families Tubificidae, Lumbricidae and Enchytraeidae."}, "cross_references": [{"found_name": "insects", "link_type": "cross_linguistic", "link_strength": 0.9, "target_cluster_id": 4, "target_cluster_name": "insects", "source_book": "llm_generated", "evidence_snippet": "Italian for 'earthworms', which are annelids, not insects. This is an error in the candidate list.", "confidence": 0.85, "auto_label": "llm_cross_linguistic", "found_relationship": "reverse: Italian for 'earthworms', which are annelids, not insects. This is an error in the candidate list.", "is_reverse": true}, {"found_name": "Worms", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3261, "target_cluster_name": "worms", "source_book": "llm_generated", "evidence_snippet": "Earthworms are a specific type of worm.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Earthworms are a specific type of worm."}]}, {"canonical_name": "Phu", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "phu", "book_id": "ricettario_fiorentino_1597", "name": "Phu", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["Phu", "Phù"], "contexts": ["root used in preparations", "plant name, possibly Valerian"]}, {"entity_id": "phu", "book_id": "polyanthea_medicinal", "name": "Phu", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["Phu"], "contexts": ["herb"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Phu", "target_book": "polyanthea_medicinal", "target_name": "Phu", "similarity": 1.0}], "id": 2639, "stable_key": "clu_49c7630b7ebeb97c", "ground_truth": {"modern_name": "Valerian", "confidence": "high", "type": "plant", "linnaean": "Valeriana officinalis", "family": "Valerianaceae", "description": "A fragrant herb with a root used in medicinal preparations.", "note": "Phu is an older name for Valerian, known for its medicinal properties.", "wikipedia_extract": "Valerian (Valeriana officinalis) is an herbaceous perennial flowering plant in the family Caprifoliaceae, native to Europe and southwestern Asia. It is the type species of the genus Valeriana. It grows up to 1.5 m (5 ft) tall, rarely to 2 m (7 ft). The stems are erect, usually unbranched, with pinnately divided leaves up to 20 cm long, the leaflets with irregularly toothed to toothless margins. The flowers are produced from June to August, and are 2.5–5 mm diameter with a five-lobed corolla, sweetly scented, pale pink, occasionally white, grouped in both compound and secondary clusters. Three subspecies are accepted by the Plants of the World Online (POWO) database: Valeriana officinalis subsp. officinalis — throughout most of the range Valeriana officinalis subsp. nemorensis (B.Turk) F.Martini & Soldano — Italy, northwest Balkans Valeriana officinalis subsp. tenuifolia (Vahl) Schübl. & G.Martens — central and northern Europe Two other subspecies, not distinguished by POWO, are accepted by some other authors: Valeriana officinalis subsp. collina — on dry chalk soils Valeriana officinalis subsp. sambucifolia — on wetter marshy sites It is native from Iceland south to Portugal, north to central Scandinavia, east to European Russia, and southeast to Iran."}, "cross_references": [{"found_name": "pompholige", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "pompholige,<S: in quel/e de Greci , la cadmia della iorta , che é detto. DELLA VALERIANA. La valeriana, chiamata da Diofcoride, fecondo al- cuni phù,èvna pianta hoggi notaj trouafencdi dueforte, vna d", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for cadmia della iorta"}, {"found_name": "cadmia della iorta", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": null, "target_cluster_name": null, "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "pompholige,<S: in quel/e de Greci , la cadmia della iorta , che é detto. DELLA VALERIANA. La valeriana, chiamata da Diofcoride, fecondo al- cuni phù,èvna pianta hoggi notaj trouafencdi dueforte, vna d", "confidence": 0.65, "auto_label": "true_synonym", "found_relationship": "synonym for pompholige"}, {"found_name": "maggiore", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "pompholige,<S: in quel/e de Greci , la cadmia della iorta , che é detto. DELLA VALERIANA. La valeriana, chiamata da Diofcoride, fecondo al- cuni phù,èvna pianta hoggi notaj trouafencdi dueforte, vna d", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of valeriana"}, {"found_name": "saluaoca", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "pompholige,<S: in quel/e de Greci , la cadmia della iorta , che é detto. DELLA VALERIANA. La valeriana, chiamata da Diofcoride, fecondo al- cuni phù,èvna pianta hoggi notaj trouafencdi dueforte, vna d", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of valeriana"}, {"found_name": "minore", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": null, "target_cluster_name": null, "source_book": "ricettario_fiorentino_1597", "evidence_snippet": "pompholige,<S: in quel/e de Greci , la cadmia della iorta , che é detto. DELLA VALERIANA. La valeriana, chiamata da Diofcoride, fecondo al- cuni phù,èvna pianta hoggi notaj trouafencdi dueforte, vna d", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "type of valeriana"}]}, {"canonical_name": "Ladano", "category": "PLANT", "subcategory": "RESIN", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "ladano", "book_id": "ricettario_fiorentino_1597", "name": "Ladano", "category": "PLANT", "subcategory": "RESIN", "count": 3, "variants": ["Ladano", "LADANO"], "contexts": ["substance discussed", "a resinous liquor from a plant"]}, {"entity_id": "ladano", "book_id": "polyanthea_medicinal", "name": "ladano", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 3, "variants": ["ladano"], "contexts": ["ingredient in an emplaster", "resin used in liniment"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Ladano", "target_book": "polyanthea_medicinal", "target_name": "ladano", "similarity": 0.545}], "id": 2640, "stable_key": "clu_d4213c8b4ec20d03", "ground_truth": {"modern_name": "Labdanum", "confidence": "high", "type": "plant", "linnaean": "Cistus ladanifer L.", "family": "Cistaceae", "wikidata_id": "Q789800", "wikidata_description": "species of plant"}, "cross_references": [{"found_name": "Cistus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 4305, "target_cluster_name": "cistus", "source_book": "llm_generated", "evidence_snippet": "Labdanum is a resin obtained from species of Cistus (rockrose).", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Labdanum is a resin obtained from species of Cistus (rockrose)."}, {"found_name": "Storax", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2505, "target_cluster_name": "Storace", "source_book": "llm_generated", "evidence_snippet": "Both Labdanum and Storax are aromatic resins used in perfumery and medicine.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both Labdanum and Storax are aromatic resins used in perfumery and medicine."}, {"found_name": "Myrrh", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 583, "target_cluster_name": "Myrrha", "source_book": "llm_generated", "evidence_snippet": "Both Labdanum and Myrrh are aromatic resins with historical medicinal and perfumery uses.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both Labdanum and Myrrh are aromatic resins with historical medicinal and perfumery uses."}]}, {"canonical_name": "Collo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "collo", "book_id": "ricettario_fiorentino_1597", "name": "Collo", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["Collo"], "contexts": ["ingredient in a preparation", "neck"]}, {"entity_id": "collo", "book_id": "polyanthea_medicinal", "name": "collo", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 3, "variants": ["collo", "collo da bexiga"], "contexts": ["neck area", "neck"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Collo", "target_book": "polyanthea_medicinal", "target_name": "collo", "similarity": 0.455}], "id": 2641, "stable_key": "clu_3a4e0d2f72226956", "ground_truth": {"modern_name": "Collo", "confidence": "medium", "type": "concept", "note": "This term appears in contexts of 'neck area' and as an ingredient in a preparation. The latter could refer to glue or a similar substance, but the primary context suggests the anatomical neck."}, "cross_references": [{"found_name": "Coral", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 630, "target_cluster_name": "Coral", "source_book": "llm_generated", "evidence_snippet": "Collo is a historical term for a type of coral, specifically red coral, used in medicine and jewelry.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Collo is a historical term for a type of coral, specifically red coral, used in medicine and jewelry.", "is_reverse": true}]}, {"canonical_name": "aflafetida", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "afla_fetida", "book_id": "ricettario_fiorentino_1597", "name": "Afla fetida", "category": "PLANT", "subcategory": "RESIN", "count": 1, "variants": ["Afla fetida"], "contexts": ["fetid resin from the spice trade"]}, {"entity_id": "aflafetida", "book_id": "polyanthea_medicinal", "name": "aflafetida", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 5, "variants": ["aflafetida", "Affafetida", "Aflafetida", "aſſafetida"], "contexts": ["plant resin used in preparation", "resin used in medicine"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "Afla fetida", "target_book": "polyanthea_medicinal", "target_name": "aflafetida", "similarity": 0.504}], "id": 2642, "stable_key": "clu_7b46763b30997406", "ground_truth": {"modern_name": "Asafetida", "confidence": "high", "type": "plant", "linnaean": "Ferula assa-foetida L.", "family": "Apiaceae"}, "cross_references": []}, {"canonical_name": "Anacardina", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "anacardina", "book_id": "ricettario_fiorentino_1597", "name": "anacardina", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["anacardina"], "contexts": ["anacardine substance"]}, {"entity_id": "anacardina", "book_id": "polyanthea_medicinal", "name": "Anacardina", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 5, "variants": ["Anacardina", "Anacaruina"], "contexts": ["medicinal preparation", "a compound medicine"]}], "edges": [{"source_book": "ricettario_fiorentino_1597", "source_name": "anacardina", "target_book": "polyanthea_medicinal", "target_name": "Anacardina", "similarity": 0.729}], "id": 2643, "stable_key": "clu_12456d0ab6c1dac1", "ground_truth": {"modern_name": "Anacardine", "confidence": "high", "type": "chemical", "note": "Anacardine refers to a substance derived from the cashew tree (Anacardium occidentale), specifically its irritant sap or a preparation made from it. It was known for its medicinal uses, often as an external application. The 'medicinal preparation' subcategory in the original prompt reinforces this.", "wikidata_id": "Q527648", "wikidata_description": "chemical compound"}, "cross_references": []}, {"canonical_name": "fauces", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "fauces", "book_id": "polyanthea_medicinal", "name": "fauces", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 5, "variants": ["fauces"], "contexts": ["throat, part of the body", "back of the throat"]}, {"entity_id": "fauces", "book_id": "first_principles_spencer_1862", "name": "fauces", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["fauces"], "contexts": ["part of the throat"]}], "edges": [{"source_book": "polyanthea_medicinal", "source_name": "fauces", "target_book": "first_principles_spencer_1862", "target_name": "fauces", "similarity": 1.0}], "id": 2644, "stable_key": "clu_51e5a9dead6611b6", "ground_truth": {"modern_name": "Pharynx", "confidence": "high", "type": "concept", "note": "The term 'fauces' in classical and early modern anatomy refers to the back of the throat, the opening from the mouth into the pharynx. While 'throat' is a general term, 'pharynx' is the more precise anatomical region.", "wikidata_id": "Q21108585", "wikidata_description": "The biological process whose specific outcome is the progression of a pharynx from an initial condition to its mature state. The pharynx is the part of the digestive system immediately posterior to the mouth."}, "cross_references": [{"found_name": "bucho", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3698, "target_cluster_name": "bucho", "source_book": "llm_generated", "evidence_snippet": "The pharynx is the part of the throat behind the mouth and nasal cavity, and above the esophagus and larynx – it is the passage for food from the mouth to the esophagus and thus to the stomach.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The pharynx is the part of the throat behind the mouth and nasal cavity, and above the esophagus and larynx – it is the passage for food from the mouth to the esophagus and thus to the stomach.", "is_reverse": true}, {"found_name": "boca", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 649, "target_cluster_name": "boca", "source_book": "llm_generated", "evidence_snippet": "The pharynx is the part of the throat behind the mouth and nasal cavity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The pharynx is the part of the throat behind the mouth and nasal cavity.", "is_reverse": true}, {"found_name": "vocal organs", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2812, "target_cluster_name": "vocal organs", "source_book": "llm_generated", "evidence_snippet": "The pharynx is a specific part of the vocal organs.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The pharynx is a specific part of the vocal organs.", "is_reverse": true}]}, {"canonical_name": "corpo humano", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 2, "total_mentions": 6, "members": [{"entity_id": "corpo_humano", "book_id": "polyanthea_medicinal"