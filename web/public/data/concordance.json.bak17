rom decoction", "liquid from boiling used for syrup"]}, {"entity_id": "liquori", "book_id": "ricettario_fiorentino_1597", "name": "liquori", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 6, "variants": ["liquori", "liquore"], "contexts": ["substance derived from plants, liquors", "liquids used for medicine"]}, {"entity_id": "liquide", "book_id": "relation_historique_humboldt_vol3_1825", "name": "liquide", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["liquide"], "contexts": ["substance observed"]}, {"entity_id": "liquido", "book_id": "historia_medicinal_monardes_1574", "name": "Liquido", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 2, "variants": ["Liquido"], "contexts": ["liquid obtained from tree branches", "liquid from a tree"]}, {"entity_id": "liquid", "book_id": "first_principles_spencer_1862", "name": "liquid", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 3, "variants": ["liquid"], "contexts": ["state of matter"]}, {"entity_id": "liquids", "book_id": "principles_of_psychology_james_1890", "name": "liquids", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 1, "variants": ["liquids"], "contexts": ["state of matter"]}, {"entity_id": "liquids", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Liquids", "category": "SUBSTANCE", "subcategory": "OTHER_SUBSTANCE", "count": 4, "variants": ["liquids", "Liquids"], "contexts": ["state of matter", "state of matter with fixed volume but not shape"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "liquor", "target_book": "english_physician_1652", "target_name": "Liquor", "similarity": 0.995}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "liquor", "target_book": "ricettario_fiorentino_1597", "target_name": "liquori", "similarity": 0.945}, {"source_book": "english_physician_1652", "source_name": "Liquor", "target_book": "ricettario_fiorentino_1597", "target_name": "liquori", "similarity": 0.925}], "id": 946, "stable_key": "clu_174026b9edea7256", "ground_truth": {"modern_name": "Liquid", "confidence": "high", "type": "concept", "note": "Refers to any fluid, including bodily fluids, solutions, or extracts. The Italian 'liquori' also specifically points to medicinal preparations.", "wikidata_id": "Q469652", "wikidata_description": "tree species", "wikipedia_url": "https://en.wikipedia.org/wiki/Liquidambar%20styraciflua", "wikipedia_extract": "Liquidambar styraciflua, commonly known as the American sweetgum among other names, is a deciduous tree in the genus Liquidambar native to warm temperate areas of eastern North America and tropical montane regions of Mexico and Central America. Sweetgum is one of the main valuable forest trees in the southeastern United States, and is a popular ornamental tree in temperate climates. It is recognizable by the combination of its five-pointed star-shaped leaves (similar to maple leaves) and its hard, spiked fruits. It is currently classified in the plant family Altingiaceae, but was formerly considered a member of the Hamamelidaceae. This plant's genus name Liquidambar was first given by Linnaeus in 1753 from the Latin liquidus ('fluid') and the Arabic ambar ('amber'), in allusion to the fragrant terebinthine juice or gum which exudes from the tree. Its specific epithet styraciflua is an old generic name meaning 'flowing with storax' (a plant resin)."}, "member_count": 8, "cross_references": [{"found_name": "ice", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 275, "target_cluster_name": "ice", "source_book": "llm_generated", "evidence_snippet": "Ice is the solid state of water, which is a liquid under normal conditions. The relationship between solid and liquid states of the same substance is a fundamental concept.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Ice is the solid state of water, which is a liquid under normal conditions. The relationship between solid and liquid states of the same substance is a fundamental concept.", "is_reverse": true}, {"found_name": "Urine", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2908, "target_cluster_name": "Urine", "source_book": "llm_generated", "evidence_snippet": "Urine is a liquid.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Urine is a liquid.", "is_reverse": true}, {"found_name": "Solids", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 816, "target_cluster_name": "Solids", "source_book": "llm_generated", "evidence_snippet": "Solid and liquid are states of matter, often interconvertible.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Solid and liquid are states of matter, often interconvertible.", "is_reverse": true}, {"found_name": "Rivers", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2611, "target_cluster_name": "Rivers", "source_book": "llm_generated", "evidence_snippet": "Rivers are a type of liquid.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Rivers are a type of liquid.", "is_reverse": true}, {"found_name": "agua caliente", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1484, "target_cluster_name": "agua caliente", "source_book": "llm_generated", "evidence_snippet": "Hot water is a liquid state of water.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Hot water is a liquid state of water.", "is_reverse": true}, {"found_name": "particles", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2253, "target_cluster_name": "particles", "source_book": "llm_generated", "evidence_snippet": "Liquids are composed of particles that are close together but can move past one another.", "confidence": 0.85, "auto_label": "l