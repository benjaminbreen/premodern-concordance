bcategory": "THEORY", "book_count": 4, "total_mentions": 32, "members": [{"entity_id": "induction", "book_id": "principles_of_psychology_james_1890", "name": "induction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["induction"], "contexts": ["reasoning from specific to general"]}, {"entity_id": "induction", "book_id": "kosmos_humboldt_1845", "name": "induction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 6, "variants": ["induction", "Induction"], "contexts": ["process of inferring general from specific", "substitutes induction for conjecture"]}, {"entity_id": "inductions", "book_id": "kosmos_humboldt_1845", "name": "inductions", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["inductions"], "contexts": ["drawing general conclusions from specific facts"]}, {"entity_id": "induction", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Induction", "category": "CONCEPT", "subcategory": "THEORY", "count": 22, "variants": ["Induction", "induction"], "contexts": ["influence of electric charge", "causing opposite electrical state in vicinity"]}, {"entity_id": "induction", "book_id": "first_principles_spencer_1862", "name": "induction", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["induction"], "contexts": ["reasoning from specific to general"]}], "edges": [{"source_book": "principles_of_psychology_james_1890", "source_name": "induction", "target_book": "kosmos_humboldt_1845", "target_name": "induction", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "induction", "target_book": "kosmos_humboldt_1845", "target_name": "inductions", "similarity": 0.927}, {"source_book": "principles_of_psychology_james_1890", "source_name": "induction", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Induction", "similarity": 0.994}, {"source_book": "principles_of_psychology_james_1890", "source_name": "induction", "target_book": "first_principles_spencer_1862", "target_name": "induction", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "induction", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Induction", "similarity": 0.994}, {"source_book": "kosmos_humboldt_1845", "source_name": "induction", "target_book": "first_principles_spencer_1862", "target_name": "induction", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "inductions", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Induction", "similarity": 0.929}, {"source_book": "kosmos_humboldt_1845", "source_name": "inductions", "target_book": "first_principles_spencer_1862", "target_name": "induction", "similarity": 0.927}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "Induction", "target_book": "first_principles_spencer_1862", "target_name": "induction", "similarity": 0.994}], "id": 280, "stable_key": "clu_56f3ffe1429317ad", "ground_truth": {"modern_name": "Induction", "confidence": "high", "type": "concept", "wikidata_id": "Q484511", "wikidata_description": "method of reasoning in which a body of observations is synthesized to hypothesize a general principle", "wikipedia_url": "https://en.wikipedia.org/wiki/Inductive%20reasoning", "wikipedia_extract": "Inductive reasoning refers to a variety of methods of reasoning in which the conclusion of an argument is supported not with deductive certainty, but at best with some degree of probability. Unlike deductive reasoning (such as mathematical induction), where the conclusion is certain, given the premises are correct, inductive reasoning produces conclusions that are at best probable, given the evidence provided. The types of inductive reasoning include generalization, prediction, statistical syllogism, argument from analogy, and causal inference. There are also differences in how their results are regarded. A generalization (more accurately, an inductive generalization) proceeds from premises about a sample to a conclusion about the population. The observation obtained from this sample is projected onto the broader population."}, "cross_references": [{"found_name": "reasoning", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1684, "target_cluster_name": "reasoning", "source_book": "llm_generated", "evidence_snippet": "Induction is a form of reasoning that involves forming generalizations based on specific observations, contrasting with deductive reasoning.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Induction is a form of reasoning that involves forming generalizations based on specific observations, contrasting with deductive reasoning.", "is_reverse": true}, {"found_name": "magnetic force", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1721, "target_cluster_name": "magnetic force", "source_book": "llm_generated", "evidence_snippet": "Electromagnetic induction, the production of an electromotive force across an electrical conductor in a changing magnetic field, is a key phenomenon linking electricity and magnetism.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Electromagnetic induction, the production of an electromotive force across an electrical conductor in a changing magnetic field, is a key phenomenon linking electricity and magnetism.", "is_reverse": true}, {"found_name": "electro-magnetism", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1802, "target_cluster_name": "electro-magnetism", "source_book": "llm_generated", "evidence_snippet": "Electromagnetic induction is a key principle within electromagnetism.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Electromagnetic induction is a key principle within electromagnetism.", "is_reverse": true}, {"found_nam