, "source_book": "llm_generated", "evidence_snippet": "The study of the development and diversification of animal life over time.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The study of the development and diversification of animal life over time."}]}, {"canonical_name": "Cassiopeia", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "cassiopeia", "book_id": "kosmos_humboldt_1845", "name": "Cassiopeia", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 5, "variants": ["Cassiopeia"], "contexts": ["constellation with a star", "constellation region in the Milky Way"]}, {"entity_id": "cassiopeia", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Cassiopeia", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["Cassiopeia"], "contexts": ["constellation where a star appeared", "astronomical constellation"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "Cassiopeia", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Cassiopeia", "similarity": 1.0}], "id": 2438, "stable_key": "clu_318aa765ecbffa51-2", "ground_truth": {"modern_name": "Cassiquiare River", "confidence": "medium", "type": "place", "country": "Venezuela", "note": "Most mentions refer to the Cassiquiare River, but 'Cassiopeia' is a constellation, suggesting a mix of entities or OCR errors.", "wikipedia_extract": "The Casiquiare river or canal (Spanish pronunciation: [kasiˈkjaɾe]) is a natural distributary of the upper Orinoco flowing southward into the Rio Negro in Venezuela. As such, it forms a unique natural canal between the Orinoco and Amazon river systems. It is the world's largest river of the kind that links two major river systems, a so-called bifurcation. The area forms a water divide, more dramatically at regional flood stage. The name Casiquiare, first used in that form by Manuel Román, likely derives from the Ye'kuana language name of the river, Kashishiwadi. The first European to describe it was Spanish Jesuit missionary and explorer Cristóbal Diatristán de Acuña in 1639.", "wikipedia_url": "https://en.wikipedia.org/wiki/Casiquiare_canal"}, "cross_references": [{"found_name": "Amazon River", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1520, "target_cluster_name": "Amazone", "source_book": "llm_generated", "evidence_snippet": "The Cassiquiare River is a distributary of the Orinoco that flows into the Rio Negro, which is part of the Amazon River system, thus forming a natural canal between the Orinoco and Amazon river systems.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Cassiquiare River is a distributary of the Orinoco that flows into the Rio Negro, which is part of the Amazon River system, thus forming a natural canal between the Orinoco and Amazon river systems."}, {"found_name": "Orinoco", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 322, "target_cluster_name": "Orinoco", "source_book": "llm_generated", "evidence_snippet": "The Cassiquiare River is a natural distributary of the upper Orinoco.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Cassiquiare River is a natural distributary of the upper Orinoco."}]}, {"canonical_name": "internal heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "internal_heat", "book_id": "kosmos_humboldt_1845", "name": "internal heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 5, "variants": ["internal heat"], "contexts": ["heat within the Earth", "heat generated within the Earth"]}, {"entity_id": "internal_heat", "book_id": "connexion_physical_sciences_somerville_1858", "name": "internal heat", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 2, "variants": ["internal heat"], "contexts": ["heat originating from within the Earth", "heat originating from within the earth"]}], "edges": [{"source_book": "kosmos_humboldt_1845", "source_name": "internal heat", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "internal heat", "similarity": 1.0}], "id": 2439, "stable_key": "clu_10c9b3101fd518f6", "ground_truth": {"modern_name": "Internal heat", "confidence": "high", "type": "concept", "wikidata_id": "Q129655466", "wikidata_description": "scholarly article published in November 2018"}, "cross_references": [{"found_name": "subterraneous fires", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1253, "target_cluster_name": "subterraneous fires", "source_book": "llm_generated", "evidence_snippet": "This is a more general term that encompasses geothermal heat.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: This is a more general term that encompasses geothermal heat.", "is_reverse": true}, {"found_name": "volcanic action", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2000, "target_cluster_name": "volcanic action", "source_book": "llm_generated", "evidence_snippet": "Internal heat is the fundamental cause of volcanic activity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Internal heat is the fundamental cause of volcanic activity.", "is_reverse": true}]}, {"canonical_name": "voltaic pile", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "voltaic_pile", "book_id": "kosmos_humboldt_1845", "name": "voltaic pile", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "count": 4, "variants": ["voltaic pile"], "contexts": ["early electric battery", "device demonstrating electric phenomena"]}, {"entity_id": "voltaic_pile", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Voltaic pile", "category": "OBJECT", "subcategory": "OTHER_OBJECT", "co