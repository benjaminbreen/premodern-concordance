y": "CONCEPT", "subcategory": "QUALITY", "count": 1, "variants": ["ventosas"], "contexts": ["windy or gaseous quality causing illness"]}, {"entity_id": "ventoſas_ſarjadas", "book_id": "polyanthea_medicinal", "name": "ventoſas ſarjadas", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 10, "variants": ["ventoſas ſarjadas", "ventolas feccas", "ventoſa ſarjada", "ventoſas farjadas", "ventoſas ſeccas"], "contexts": ["medical device", "cupping glasses, medical instrument"]}, {"entity_id": "ventosa", "book_id": "polyanthea_medicinal", "name": "ventosa", "category": "CONCEPT", "subcategory": "QUALITY", "count": 3, "variants": ["ventosa"], "contexts": ["used on the stomach for flatulence", "windy part"]}], "edges": [{"source_book": "historia_medicinal_monardes_1574", "source_name": "ventolos", "target_book": "polyanthea_medicinal", "target_name": "ventoſas ſarjadas", "similarity": 0.884}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "ventolos", "target_book": "polyanthea_medicinal", "target_name": "ventosa", "similarity": 0.898}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "ventosas", "target_book": "polyanthea_medicinal", "target_name": "ventoſas ſarjadas", "similarity": 0.899}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "ventosas", "target_book": "polyanthea_medicinal", "target_name": "ventosa", "similarity": 0.932}], "id": 1853, "stable_key": "clu_12d6a16eeb5c29b9", "ground_truth": {"modern_name": "Flatulence", "confidence": "high", "type": "concept", "note": "The term 'ventosa' in early modern Portuguese and Spanish medical texts referred to a windy or gaseous condition, particularly affecting the stomach, and is directly translatable to flatulence.", "wikidata_id": "Q160184", "wikidata_description": "bodily function of expelling intestinal gas out of the anus", "wikipedia_url": "https://en.wikipedia.org/wiki/Flatulence", "wikipedia_extract": "Flatulence is the expulsion of gas from the intestines via the anus, commonly referred to as farting. \"Flatus\" is the medical word for gas generated in the stomach or bowels. A proportion of intestinal gas may be swallowed environmental air; hence, flatus is not entirely generated in the stomach or bowels. The scientific study of this area of medicine is termed flatology. Passing gas is a normal bodily process. Flatus is brought to the rectum and pressurized by muscles in the intestines."}, "cross_references": [{"found_name": "Fumes", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2713, "target_cluster_name": "fumes", "source_book": "llm_generated", "evidence_snippet": "Fumes can be associated with internal bodily processes that produce gas.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Fumes can be associated with internal bodily processes that produce gas."}, {"found_name": "Humoral theory", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 64, "target_cluster_name": "humoral theory", "source_book": "llm_generated", "evidence_snippet": "Humoral theory often explained bodily functions, including the production of gas, in terms of the balance of humors.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Humoral theory often explained bodily functions, including the production of gas, in terms of the balance of humors."}, {"found_name": "Wind", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 80, "target_cluster_name": "Wind", "source_book": "llm_generated", "evidence_snippet": "Flatulence is a type of wind or gas expelled from the body.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Flatulence is a type of wind or gas expelled from the body."}]}, {"canonical_name": "Medicos Antigos", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 16, "members": [{"entity_id": "medicos_antiguos", "book_id": "historia_medicinal_mo