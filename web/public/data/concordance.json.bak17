": 2, "total_mentions": 14, "members": [{"entity_id": "phonolithe", "book_id": "relation_historique_humboldt_vol3_1825", "name": "phonolithe", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 12, "variants": ["phonolithe", "PHONOLITHE", "Phonolite", "phonolite", "phonolithes"], "contexts": ["rock formation between Otuz and Cerro de Flores", "rock formation in Venezuela"]}, {"entity_id": "phonolithe", "book_id": "kosmos_humboldt_1845", "name": "phonolithe", "category": "SUBSTANCE", "subcategory": "MINERAL", "count": 2, "variants": ["phonolithe"], "contexts": ["endogenous rock type", "porphyritic slate rock"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "phonolithe", "target_book": "kosmos_humboldt_1845", "target_name": "phonolithe", "similarity": 1.0}], "id": 1897, "stable_key": "clu_f406cd10c37c7219", "ground_truth": {"modern_name": "Phonolite", "confidence": "high", "type": "mineral", "wikidata_id": "Q1257550", "wikidata_description": "intermediate igneous rock; chenotype (younger) outpouring equivalent of alkaline syenite", "wikipedia_extract": "Phonolite is an uncommon shallow intrusive or extrusive rock, of intermediate chemical composition between felsic and mafic, with texture ranging from aphanitic (fine-grained) to porphyritic (mixed fine- and coarse-grained). Phonolite is a variation of the igneous rock trachyte that contains nepheline or leucite rather than quartz. It has an unusually high (12% or more) Na2O + K2O content, defining its position in the TAS classification of igneous rocks. Its coarse grained (phaneritic) intrusive equivalent is nepheline syenite. Phonolite is typically fine grained and compact. The name phonolite comes from the Ancient Greek meaning \"sounding stone\" due to the metallic sound it produces if an unfractured plate is hit; hence, the English name clinkstone is given as a synonym.", "wikipedia_url": "https://en.wikipedia.org/wiki/Phonolite"}, "cross_references": [{"found_name": "Trachyte", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1626, "target_cluster_name": "trachyte", "source_book": "llm_generated", "evidence_snippet": "Phonolite is described as a variation of trachyte.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Phonolite is described as a variation of trachyte."}, {"found_name": "Nepheline", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2047, "target_cluster_name": "euphotide", "source_book": "llm_generated", "evidence_snippet": "Phonolite contains nepheline.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Phonolite contains nepheline."}]}, {"canonical_name": "Freycinet", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 14, "members": [{"entity_id": "freycinet", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Freycinet", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 11, "variants": ["Freycinet", "Freycioet"], "contexts": ["early modern scholar", "author of scientific observations"]}, {"entity_id": "freycinet", "book_id": "kosmos_humboldt_1845", "name": "Freycinet", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Freycinet"], "contexts": ["provided pendulum experiment results", "researcher on pendulum oscillations"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Freycinet", "target_book": "kosmos_humboldt_1845", "target_name": "Freycinet", "similarity": 0.722}], "id": 1898, "stable_key": "clu_cf4ad0059e066ce9", "ground_truth": {"modern_name": "Louis de Freycinet", "confidence": "high", "type": "person", "birth_year": 1779, "death_year": 1842, "description": "French explorer and scientist, known for voyages and scientific contributions."}, "cross_references": [{"found_name": "Amerigo Vespucci", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3017, "tar