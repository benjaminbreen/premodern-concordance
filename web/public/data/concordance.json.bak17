": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2852, "target_cluster_name": "Scitaminea", "source_book": "llm_generated", "evidence_snippet": "Galangal is a rhizome from plants in the genera Alpinia, Achasma, and Hypanthodium, all within the Zingiberaceae family, part of the Zingiberales order. This represents a specific genus within the broader order.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Galangal is a rhizome from plants in the genera Alpinia, Achasma, and Hypanthodium, all within the Zingiberaceae family, part of the Zingiberales order. This represents a specific genus within the broader order.", "is_reverse": true}, {"found_name": "Zerumbet", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2877, "target_cluster_name": "Zerumbet", "source_book": "llm_generated", "evidence_snippet": "Zerumbet ginger and galangal are both rhizomatous plants in the Zingiberaceae family, often used for culinary and medicinal purposes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Zerumbet ginger and galangal are both rhizomatous plants in the Zingiberaceae family, often used for culinary and medicinal purposes.", "is_reverse": true}, {"found_name": "Portugal", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 37, "target_cluster_name": "Portugal", "source_book": "coloquios_da_orta_1563", "evidence_snippet": "lhe chamão asi. E esta que chamamos galanga he de duas maneiras, scilicet, huma pequena, muyto cheirosa, trazida da China a estas terras, e daqui pêra Portugal e pêra outros cabos do ponente: a esta c", "confidence": 0.65, "auto_label": "subtype_relation", "found_relationship": "reverse: a plant, one variety of which is called lavandou in China", "is_reverse": true}]}, {"canonical_name": "cancros", "category": "DISEASE", "subcategory": "CHRONIC", "book_count": 4, "total_mentions": 36, "members": [{"entity_id": "cancers", 