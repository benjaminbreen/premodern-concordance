variants": ["torrid zone"], "contexts": ["hottest region on Earth", "burning regions with distinct flora"]}, {"entity_id": "torrid_zones", "book_id": "kosmos_humboldt_1845", "name": "torrid zones", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["torrid zones"], "contexts": ["regions near the equator with high temperatures"]}, {"entity_id": "torrid", "book_id": "connexion_physical_sciences_somerville_1858", "name": "torrid", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["torrid"], "contexts": ["tropical regions with less pressure change", "tropical regions"]}, {"entity_id": "torrid_zone", "book_id": "first_principles_spencer_1862", "name": "torrid zone", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["torrid zone"], "contexts": ["Earth's hottest climatic zone"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "torrid zones", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "zone torride", "similarity": 0.945}], "id": 2186, "stable_key": "clu_0122deb84aaee144", "ground_truth": {"modern_name": "Torrid Zone", "confidence": "high", "type": "concept", "wikidata_id": "Q117455236", "wikidata_description": "lies between TROPIC OF CANCER AND TROPIC OF CAPRICORN", "wikipedia_url": "https://en.wikipedia.org/wiki/Torrid%20zone", "country": "Global", "wikipedia_extract": "The torrid zone was the name given by ancient Greek and Roman geographers to the equatorial area of the Earth, so hot that it was thought to be impenetrable to sailors or explorers. That notion became a deterrent for European explorers until the 15th century. Aristotle, like all classical thinkers, knew that the world was a sphere. He posited that the western half of the temperate zone on the other side of the globe from Greece might be habitable and that, because of symmetry, there must be in the Southern Hemisphere a temperate zone corresponding to that in the northern. He thought, however, that the excessive heat in the torrid zone would prevent the exploration. the meridian through Syene is drawn approximately along the course of the Nile from Meroë to Alexandria, and this distance is about ten thousand stadia [~1,800 km]; and Syene must lie in the centre of that distance; so that the distance from Syene to Meroë is five thousand stadia [~900 km]."}, "member_count": 8, "cross_references": [{"found_name": "Equatorial regions", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1437, "target_cluster_name": "equatorial America", "source_book": "llm_generated", "evidence_snippet": "The Torrid Zone is synonymous with the equatorial regions.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Torrid Zone is synonymous with the equatorial regions."}, {"found_name": "Climate zones", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 1344, "target_cluster_name": "cold climates", "source_book": "llm_generated", "evidence_snippet": "The Torrid Zone is a specific type of climate zone.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Torrid Zone is a specific type of climate zone."}, {"found_name": "Equator", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 61, "target_cluster_name": "equator", "source_book": "llm_generated", "evidence_snippet": "The Torrid Zone is defined by its proximity to the Equator.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The Torrid Zone is defined by its proximity to the Equator."}]}, {"canonical_name": "canarim", "category": "PLANT", "subcategory": "OTHER_PLANT", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "canary", "book_id": "origin_of_species_darwin_1859", "name": "canary", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 1, "variants": ["canary"], "contexts": ["seed that germinated after bird digestion"]}, {"entity_id": "canarim", "book_id": "coloquios_da_orta_1563", "name": "canarim", "category": "PLANT", "subcategory": "OTHER_PLANT", "count": 8, "variants": ["canarim", "CANARDI"], "contexts": ["language spoken in a region", "language and people"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "canary", "target_book": "coloquios_da_orta_1563", "target_name": "canarim", "similarity": 0.889}], "id": 2187, "stable_key": "clu_f20897f35bf7aae2", "ground_truth": {"modern_name": "Canary grass", "confidence": "high", "type": "plant", "linnaean": "Phalaris canariensis Linnaeus", "family": "Poaceae", "wikidata_id": "Q2086586", "wikidata_description": "species of plant", "wikipedia_url": "https://en.wikipedia.org/wiki/Canary%20grass", "wikipedia_extract": "Canary grass is a plant, Phalaris canariensis, belonging to the family Poaceae. Originally a native of the Mediterranean region, it is now grown commercially in several parts of the world for birdseed. Phalaris canariensis resembles Phalaris arundinacea (reed canary grass), a perennial forage crop and a wild grass. Although heads of both crops are panicles, Phalaris canariensis heads resemble club wheat. This large, coarse grass has erect, hairless stems, usually from 2 to 6 feet (0.61 to 1.83 m) tall. The ligule is prominent and membranous, 1⁄4 inch (0.64 cm) long and rounded at the apex."}, "cross_references": [{"found_name": "Grass", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 465, "target_cluster_name": "Grass", "source_book": "llm_generated", "evidence_snippet": "Canary grass is a type of grass.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Canary grass is a type of grass."}, {"found_name": "grasses", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 915, "target_cluster_name": "grasses", "source_book": "llm_generated", "evidence_snippet": "Canary grass is a specific species within the Poaceae family.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Canary grass is a specific species within the Poaceae family.", "is_reverse": true}]}, {"canonical_name": "chevaux", "category": "ANIMAL", "subcategory": "MAMMAL", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "race-horses", "book_id": "origin_of_species_darwin_1859", "name": "Race-horses", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 1, "variants": ["Race-horses"], "contexts": ["horses bred for racing"]}, {"entity_id": "chevaux", "book_id": "relation_historique_humboldt_vol3_1825", "name": "chevaux", "category": "ANIMAL", "subcategory": "MAMMAL", "count": 8, "variants": ["chevaux", "cheval"], "contexts": ["animals competing for pasture", "animals for transport and sustenance"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "Race-horses", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "chevaux", "similarity": 0.937}], "id": 2188, "stable_key": "clu_8f504d1d22bde89b-3", "ground_truth": {"modern_name": "horse", "confidence": "high", "type": "animal", "linnaean": "Equus caballus", "family": "Equidae", "description": "A domesticated mammal with hooves, widely used by humans.", "wikipedia_extract": "The horse (Equus ferus caballus) is a domesticated, one-toed, hoofed mammal. It belongs to the taxonomic family Equidae and is one of two extant subspecies of Equus ferus. The horse has evolved over the past 45 to 55 million years from a small multi-toed creature, Eohippus, into the large single-toed animal of today, originally in North America. Humans began domesticating horses around 4000 BCE in Central Asia, and their domestication is believed to have been widespread by 3000 BCE. Horses in the subspecies caballus are domesticated, although some domesticated populations live in the wild as feral horses. These feral populations are not true wild horses, which are horses that have never been domesticated."}, "cross_references": []}, {"canonical_name": "Cali", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 9, "members": [{"entity_id": "cali", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Cali", "category": "PLACE", "subcategory": "CITY", "count": 8, "variants": ["Cali", "Calicut"], "contexts": ["location", "city"]}, {"entity_id": "cali", "book_id": "polyanthea_medicinal", "name": "Cali", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Cali"], "contexts": ["heaven"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Cali", "target_book": "polyanthea_medicinal", "target_name": "Cali", "similarity": 0.878}], "id": 2189, "stable_key": "clu_fd6a86d360693250", "ground_truth": {"modern_name": "Cali", "confidence": "high", "type": "place", "country": "Colombia", "wikidata_id": "", "wikidata_description": "family name"}, "cross_references": [{"found_name": "Guayaquil", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 631, "target_cluster_name": "Guayaquil", "source_book": "llm_generated", "evidence_snippet": "Both are cities in South America, often mentioned in similar contexts of trade or exploration.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both are cities in South America, often mentioned in similar contexts of trade or exploration.", "is_reverse": true}, {"found_name": "Popayan", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1548, "target_cluster_name": "Popayan", "source_book": "llm_generated", "evidence_snippet": "Cali is a major city in the historical region of Popayán, located within the same modern-day department of Valle del Cauca in Colombia.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Cali is a major city in the historical region of Popayán, located within the same modern-day department of Valle del Cauca in Colombia.", "is_reverse": true}, {"found_name": "alad"