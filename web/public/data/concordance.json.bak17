arity": 0.943}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "Pulmon", "target_book": "polyanthea_medicinal", "target_name": "pulmonum", "similarity": 0.974}, {"source_book": "coloquios_da_orta_1563", "source_name": "pulmão", "target_book": "ricettario_fiorentino_1597", "target_name": "polmone", "similarity": 0.932}, {"source_book": "coloquios_da_orta_1563", "source_name": "pulmão", "target_book": "polyanthea_medicinal", "target_name": "pulmonum", "similarity": 0.969}, {"source_book": "ricettario_fiorentino_1597", "source_name": "polmone", "target_book": "polyanthea_medicinal", "target_name": "pulmonum", "similarity": 0.933}], "id": 336, "stable_key": "clu_5dd6d2dd8df17f0c", "ground_truth": {"modern_name": "lung", "confidence": "high", "type": "anatomy", "description": "The respiratory organ in the chest of humans and animals.", "wikipedia_extract": "The lungs are the primary organs of the respiratory system in many animals, including humans. In mammals and most other tetrapods, two lungs are located near the backbone on either side of the heart. Their function in the respiratory system is to extract oxygen from the atmosphere and transfer it into the bloodstream, and to release carbon dioxide from the bloodstream into the atmosphere, in a process of gas exchange. Respiration is driven by different muscular systems in different species. Mammals, reptiles and birds use their musculoskeletal systems to support and foster breathing. In early tetrapods, air was driven into the lungs by the pharyngeal muscles via buccal pumping, a mechanism still seen in amphibians."}, "cross_references": [{"found_name": "chest", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 311, "target_cluster_name": "Chest", "source_book": "llm_generated", "evidence_snippet": "The lungs are located within the chest cavity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The lungs are located within the chest cavity."}]}, {"canonical_name": "Heródoto", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 4, "total_mentions": 18, "members": [{"entity_id": "herodotus", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Herodotus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 5, "variants": ["Herodotus"], "contexts": ["ancient historian", "ancient historian, father of history"]}, {"entity_id": "hérodote", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Hérodote", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Hérodote"], "contexts": ["ancient Greek historian", "ancient historian"]}, {"entity_id": "herodotus", "book_id": "kosmos_humboldt_1845", "name": "Herodotus", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Herodotus"], "contexts": ["ancient Greek historian", "described Scythia as free from earthquakes"]}, {"entity_id": "heródoto", "book_id": "coloquios_da_orta_1563", "name": "Heródoto", "category": "PERSON", "subcategory": "AUTHORITY", "count": 8, "variants": ["Heródoto"], "contexts": ["ancient historian mentioning Scythas and hemp", "Ancient writer of fables"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Herodotus", "target_book": "relation_historique_humboldt_vol3_1825", "target_name": "Hérodote", "similarity": 0.877}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Herodotus", "target_book": "kosmos_humboldt_1845", "target_name": "Herodotus", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Herodotus", "target_book": "coloquios_da_orta_1563", "target_name": "Heródoto", "similarity": 0.856}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Hérodote", "target_book": "kosmos_humboldt_1845", "target_name": "Herodotus", "similarity": 0.877}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Hérodote", "target_book": "coloquios_da_orta_1563", "target_name": "Heródoto", "similarity": 0.901}, {"source_book": "kosmos_humboldt_1845", "source_name": "Herodotus", "target_book": "coloquios_da_orta_1563", "target_name": "Heródoto", "similarity": 0.856}], "id": 337, "stable_key": "clu_cdb6e2dede7f0433", "ground_truth": {"modern_name": "Herodotus", "confidence": "high", "type": "person", "birth_year": -484, "death_year": -425, "description": "Ancient Greek historian, known as the 'Father of History'.", "wikidata_id": "Q26825", "wikidata_description": "Greek historian and geographer (c.484–c.425 BC)", "wikipedia_url": "https://en.wikipedia.org/wiki/Herodotus", "wikipedia_extract": "Herodotus (Ancient Greek: Ἡρόδοτος, romanized: Hēródotos; c. 484 – c. 425 BC) was a Greek historian and geographer from the Greek city of Halicarnassus (now Bodrum, Turkey), under Persian control in the 5th century BC, and a later citizen of Thurii in modern Calabria, Italy. He wrote the Histories, a detailed account of the Greco-Persian Wars, among other subjects such as the rise of the Achaemenid dynasty of Cyrus. He has been described as \"The Father of History\", a title conferred on him by the ancient Roman orator Cicero. The Histories primarily cover the lives of prominent kings and famous battles such as Marathon, Thermopylae, Artemisium, Salamis, Plataea, and Mycale."}, "cross_references": [{"found_name": "Egyptians", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 148, "target_cluster_name": "Egyptians", "source_book": "llm_generated", "evidence_snippet": "Herodotus was an ancient Greek historian who extensively wrote about ancient Egypt in his Histories, making him a primary source for understanding this civilization.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Herodotus was an ancient Greek historian who extensively wrote about ancient Egypt in his Histories, making him a primary source for understanding this civilization.", "is_reverse": true}, {"found_name": "Strabo", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 296, "target_cluster_name": "Strabo", "source_book": "llm_generated", "evidence_snippet": "Both were ancient Greek writers who described geography and peoples, with Herodotus being a precursor to Strabo's more systematic approach.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were ancient Greek writers who described geography and peoples, with Herodotus being a precursor to Strabo's more systematic approach.", "is_reverse": true}, {"found_name": "Ancient Greeks", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1663, "target_cluster_name": "Greci", "source_book": "llm_generated", "evidence_snippet": "Herodotus was a prominent figure of Ancient Greece, and 'Ancient Greeks' refers to his people and cultural context.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Herodotus was a prominent figure of Ancient Greece, and 'Ancient Greeks' refers to his people and cultural context."}, {"found_name": "Aristotle", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 62, "target_cluster_name": "Aristotle", "source_book": "llm_generated", "evidence_snippet": "Both Herodotus and Aristotle are foundational figures in Greek historiography and philosophy, representing different eras and approaches but within the same intellectual lineage.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both Herodotus and Aristotle are foundational figures in Greek historiography and philosophy, representing different eras and approaches but within the same intellectual lineage."}, {"found_name": "Ctesias", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2491, "target_cluster_name": "Ctesias", "source_book": "llm_generated", "evidence_snippet": "Ctesias was another ancient Greek historian whose work, like Herodotus', focused on Persia and the East, making them contemporaries and comparative figures in historical scholarship.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Ctesias was another ancient Greek historian whose work, like Herodotus', focused on Persia and the East, making them contemporaries and comparative figures in historical scholarship."}, {"found_name": "Plutarch", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 801, "target_cluster_name": "Plutarch", "source_book": "llm_generated", "evidence_snippet": "Both Plutarch and Herodotus were significant Greek historians.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both Plutarch and Herodotus were significant Greek historians.", "is_reverse": true}, {"found_name": "Eratosthenes", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1129, "target_cluster_name": "Eratosthenes", "source_book": "llm_generated", "evidence_snippet": "Both were prominent ancient Greek scholars, with Herodotus being the 'Father of History' and Eratosthenes a key figure in geography and mathematics.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were prominent ancient Greek scholars, with Herodotus being the 'Father of History' and Eratosthenes a key figure in geography and mathematics.", "is_reverse": true}]}, {"canonical_name": "digestion", "category": "CONCEPT", "subcategory": "PRACTICE", "book_count": 4, "total_mentions": 18, "members": [{"entity_id": "digestion", "book_id": "english_physician_1652", "name": "digestion", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 8, "variants": ["digestion", "Digestion", "digesting"], "contexts": ["process of breaking down food", "aided by Balm"]}, {"entity_id": "digestia", "book_id": "historia_medicinal_monardes_1574", "name": "digestia", "category": "CONCEPT", "subcategory": "OTHER_CONCEPT", "count": 1, "variants": ["digestia"], "contexts": ["process of digestion"]}, {"entity_id": "digestion", "book_id": "polyanthea_medicinal", "name": "digestion", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 8, "variants": ["digestion", "digesta", "digestione", "digestão", "digetao"], "contexts": ["process affected by eating habits", "process of breaking down food"]}, {"entity_id": "digestion", "book_id": "first_principles_spencer_1862", "name": "digestion", "category": "CONCEPT", "subcategory": "PRACTICE", "count": 1, "variants": ["digestion"], "contexts": ["process of breaking down food"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "digestion", "target_book": "historia_medicinal_monardes_1574", "target_name": "digestia", "similarity": 0.928}, {"source_book": "english_physician_1652", "source_name": "digestion", "target_book": "polyanthea_medicinal", "target_name": "digestion", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "digestion", "target_book": "first_principles_spencer_1862", "target_name": "digestion", "similarity": 1.0}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "digestia", "target_book": "polyanthea_medicinal", "target_name": "digestion", "similarity": 0.928}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "digestia", "target_book": "first_principles_spencer_1862", "target_name": "digestion", "similarity": 0.928}, {"source_book": "polyanthea_medicinal", "source_name": "digestion", "target_book": "first_principles_spencer_1862", "target_name": "digestion", "similarity": 1.0}], "id": 338, "stable_key": "clu_5f286c5131455b1b", "ground_truth": {"modern_name": "Digestion", "confidence": "high", "type": "concept", "description": "The process of breaking down food for absorption by the body.", "note": "Can refer to the physiological process or a chemical preparation.", "wikipedia_extract": "Digestion is the breakdown of large insoluble food compounds into small water-soluble components so that they can be absorbed into the blood plasma. In certain organisms, these smaller substances are absorbed through the small intestine into the blood stream. Digestion is a form of catabolism that is often divided into two processes based on how food is broken down: mechanical and chemical digestion. The term mechanical digestion refers to the physical breakdown of large pieces of food into smaller pieces which can subsequently be accessed by digestive enzymes. Mechanical digestion takes place in the mouth through mastication and in the small intestine through segmentation contractions. In chemical digestion, enzymes break down food into the small compounds that the body can use."}, "cross_references": [{"found_name": "Life", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 89, "target_cluster_name": "Life", "source_book": "llm_generated", "evidence_snippet": "Digestion is a fundamental process necessary for sustaining life in many organisms.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Digestion is a fundamental process necessary for sustaining life in many organisms.", "is_reverse": true}, {"found_name": "Respiração", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 898, "target_cluster_name": "Respiração", "source_book": "llm_generated", "evidence_snippet": "Digestion and respiration were often discussed together as essential processes for sustaining life and generating heat.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Digestion and respiration were often discussed together as essential processes for sustaining life and generating heat.", "is_reverse": true}, {"found_name": "Appetite", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2030, "target_cluster_name": "Appetite", "source_book": "llm_generated", "evidence_snippet": "Appetite is closely linked to the physiological processes of digestion and the body's need fo