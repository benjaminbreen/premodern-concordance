ry": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Fistula"], "contexts": ["medical condition involving emission of sound/voice"]}, {"entity_id": "fistula's", "book_id": "english_physician_1652", "name": "Fistula's", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 19, "variants": ["Fistula's", "Fistula", "Fistulaus", "Fistulous", "Fistulous Cankers"], "contexts": ["condition cleansed by juice", "medical condition treated with juice"]}, {"entity_id": "fistula", "book_id": "polyanthea_medicinal", "name": "fistula", "category": "DISEASE", "subcategory": "CHRONIC", "count": 6, "variants": ["fistula", "Fistula"], "contexts": ["medical condition", "abnormal passage or duct"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Fistula", "target_book": "english_physician_1652", "target_name": "Fistula's", "similarity": 0.953}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Fistula", "target_book": "polyanthea_medicinal", "target_name": "fistula", "similarity": 0.844}], "id": 670, "stable_key": "clu_89c50c57dbde8a19", "ground_truth": {"modern_name": "Fistula", "confidence": "high", "type": "disease", "description": "An abnormal passage or duct in the body, often leading to disease.", "wikipedia_extract": "In anatomy, a fistula (pl.: fistulas or fistulae ; from Latin fistula, \"tube, pipe\") is an abnormal connection (i.e. tube) joining two hollow spaces (technically, two epithelialized surfaces), such as blood vessels, intestines, or other hollow organs to each other, often resulting in an abnormal flow of fluid from one space to the other. An anal fistula connects the anal canal to the perianal skin. An anovaginal or rectovaginal fistula is a hole joining the anus or rectum to the vagina. A colovaginal fistula joins the  space in the colon to that in the vagina. A urinary tract fistula is an abnormal opening in the urinary tract or an abnormal connection between the urinary tract and another organ. An abnormal communication (i.e. hole or tube) between the bladder and the uterus is called a vesicouterine fistula, while if it is between the bladder and the vagina it is known as a vesicovaginal fistula, and if between the urethra and the vagina: a urethrovaginal fistula."}, "cross_references": [{"found_name": "contusões", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3320, "target_cluster_name": "contusões", "source_book": "llm_generated", "evidence_snippet": "A fistula is an abnormal passage or duct between two organs or from an organ to the surface of the body, often resulting from infection or injury, thus a type of wound or complication of a wound.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: A fistula is an abnormal passage or duct between two organs or from an organ to the surface of the body, often resulting from infection or injury, thus a type of wound or complication of a wound.", "is_reverse": true}]}, {"canonical_name": "Oximel", "category": "SUBSTANCE", "subcategory": "PREPARATION", "book_count": 3, "total_mentions": 26, "members": [{"entity_id": "oximel", "book_id": "english_physician_1652", "name": "Oximel", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 2, "variants": ["Oximel"], "contexts": ["mixture of honey and vinegar"]}, {"entity_id": "oximel", "book_id": "coloquios_da_orta_1563", "name": "oximel", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 1, "variants": ["oximel"], "contexts": ["preparation with seeds"]}, {"entity_id": "oximel", "book_id": "polyanthea_medicinal", "name": "Oximel", "category": "SUBSTANCE", "subcategory": "PREPARATION", "count": 23, "variants": ["Oximel", "oximel", "oximel esquilitico"], "contexts": ["simple oxymel mixture", "mixture of honey and vinegar"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Oximel", "target_book": "coloquios_da_orta_1563", "target_name": "oximel", "simi