ation_historique_humboldt_vol3_1825", "source_name": "Juin", "target_book": "coloquios_da_orta_1563", "target_name": "junho", "similarity": 0.915}, {"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Juin", "target_book": "polyanthea_medicinal", "target_name": "Junho", "similarity": 0.925}, {"source_book": "coloquios_da_orta_1563", "source_name": "junho", "target_book": "polyanthea_medicinal", "target_name": "Junho", "similarity": 0.924}], "id": 69, "stable_key": "clu_141f09f49138cd69", "ground_truth": {"modern_name": "June", "confidence": "high", "type": "concept", "note": "Refers to the month of June, often discussed in relation to astronomical observations, agricultural cycles, and seasonal bodily humors.", "wikidata_id": "", "wikidata_description": "family name", "wikipedia_url": "https://en.wikipedia.org/wiki/June", "wikipedia_extract": "June is the sixth month of the year in the Julian and Gregorian calendars—the latter the most widely used calendar in the world. Its length is 30 days. June succeeds May and precedes July. This month marks the start of summer in the Northern Hemisphere and contains the summer solstice, which is the day with the most daylight hours. In the Southern Hemisphere, June is the start of winter and contains the winter solstice, the day with the fewest hours of daylight out of the year. In places north of the Arctic Circle, the June solstice is when the midnight sun occurs, during which the Sun remains visible even at midnight."}, "cross_references": [{"found_name": "April", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 129, "target_cluster_name": "April", "source_book": "llm_generated", "evidence_snippet": "April and June are consecutive months in the Gregorian calendar, and their temporal proximity often leads to discussions of seasonal changes and agricultural cycles.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "April and June are consecutive months in the Gregorian calendar, and their temporal proximity often leads to discussions of seasonal changes and agricultural cycles."}, {"found_name": "May", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1657, "target_cluster_name": "May", "source_book": "llm_generated", "evidence_snippet": "May and June are consecutive months in the Gregorian calendar, and their temporal proximity often leads to discussions of seasonal changes and agricultural cycles.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "May and June are consecutive months in the Gregorian calendar, and their temporal proximity often leads to discussions of seasonal changes and agricultural cycles."}, {"found_name": "July", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1523, "target_cluster_name": "July", "source_book": "llm_generated", "evidence_snippet": "July and June are consecutive months in the Gregorian calendar, and their temporal proximity often leads to discussions of seasonal changes and agricultural cycles.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "July and June are consecutive months in the Gregorian calendar, and their temporal proximity often leads to discussions of seasonal changes and agricultural cycles."}, {"found_name": "Dezembro", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 988, "target_cluster_name": "Dezembro", "source_book": "llm_generated", "evidence_snippet": "June and December are months that are often contrasted due to their opposite seasons in the Northern and Southern Hemispheres.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: June and December are months that are often contrasted due to their opposite seasons in the Northern and Southern Hemispheres.", "is_reverse": true}, {"found_name": "Spring", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1680, "target_clus