t_name": "Thunder", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Thunder", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Thunder", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Thunder", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Thunder", "similarity": 1.0}], "id": 949, "stable_key": "clu_136423f129fdc713", "ground_truth": {"modern_name": "Thunder", "confidence": "high", "type": "concept", "note": "Refers to the sound produced by lightning.", "wikidata_id": "Q34116", "wikidata_description": "city in Thunder Bay District, province of Ontario, Canada"}, "cross_references": []}, {"canonical_name": "Discolourings", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "discolourings", "book_id": "english_physician_1652", "name": "Discolourings", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 7, "variants": ["Discolourings", "discolorings", "discolourings", "discolourings of the Skin"], "contexts": ["skin imperfections removed by juice", "skin discoloration"]}, {"entity_id": "descoloridos", "book_id": "historia_medicinal_monardes_1574", "name": "descoloridos", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["descoloridos"], "contexts": ["pale appearance"]}, {"entity_id": "discoloratio-", "book_id": "polyanthea_medicinal", "name": "Discoloratio-", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Discoloratio-"], "contexts": ["skin discoloration"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Discolourings", "target_book": "historia_medicinal_monardes_1574", "target_name": "descoloridos", "similarity": 0.938}, {"source_book": "english_physician_1652", "source_name": "Discolourings", "target_book": "polyanthea_medicinal", "target_name": "Discoloratio-", "similarity": 0.93}, {"source_book": "historia_medicinal_monardes_1574", "source_name": "descoloridos", "target_book": "polyanthea_medicinal", "target_name": "Discoloratio-", "similarity": 0.921}], "id": 950, "stable_key": "clu_7ebb7ff79a4cf9ab", "ground_truth": {"modern_name": "Discoloration", "confidence": "high", "type": "disease", "description": "Abnormal changes in the color of the skin or other tissues.", "note": "Refers to pale or otherwise altered skin tones.", "wikipedia_extract": "Jaundice, also known as icterus, is a yellowish or, less frequently, greenish pigmentation of the skin and sclera due to high bilirubin levels. Jaundice in adults typically indicates the presence of underlying diseases involving abnormal heme metabolism, liver dysfunction, or biliary-tract obstruction. The prevalence of jaundice in adults is rare, while jaundice in babies is common, with an estimated 80% affected during their first week of life. The most commonly associated symptoms of jaundice are itchiness, pale feces, and dark urine. Normal levels of bilirubin in blood are below 1.0 mg/dl (17 μmol/L), while levels over 2–3 mg/dl (34–51 μmol/L) typically result in jaundice. High blood bilirubin is divided into two types: unconjugated and conjugated bilirubin."}, "cross_references": [{"found_name": "Ictericia", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1510, "target_cluster_name": "Ictericia", "source_book": "llm_generated", "evidence_snippet": "Jaundice is a specific type of discoloration of the skin and sclera.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Jaundice is a specific type of discoloration of the skin and sclera.", "is_reverse": true}]}, {"canonical_name": "Yorkshire", "category": "PLACE", "subcategory": "REGION", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "yorkshire", "book_id": "english_physician_1652", "name": "Yorkshire", "category": "PLACE", "subcategory": "REGION", "count": 6, "variants": ["yorkshire", "Yorkshire"], "contexts": ["county where Red Bilberry grows", "region in the North parts of this Land"]}, {"entity_id": "yorkshire", "book_id": "origin_of_species_darwin_1859", "name": "Yorkshire", "category": "PLACE", "subcategory": "REGION", "count": 2, "variants": ["Yorkshire"], "contexts": ["district known for sheep farming", "English county"]}, {"entity_id": "yorkshire", "book_id": "first_principles_spencer_1862", "name": "Yorkshire", "category": "PLACE", "subcategory": "REGION", "count": 1, "variants": ["Yorkshire"], "contexts": ["cloth-districts"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Yorkshire", "target_book": "origin_of_species_darwin_1859", "target_name": "Yorkshire", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Yorkshire", "target_book": "first_principles_spencer_1862", "target_name": "Yorkshire", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Yorkshire", "target_book": "first_principles_spencer_1862", "target_name": "Yorkshire", "similarity": 1.0}], "id": 951, "stable_key": "clu_27e54ae73df0598c", "ground_truth": {"modern_name": "Yorkshire", "confidence": "high", "type": "place", "description": "A historic county in Northern England.", "wikipedia_extract": "Yorkshire ( YORK-shər, -⁠sheer) is an area of Northern England which was historically a county. Despite no longer being used for administration, Yorkshire retains a strong regional identity. The county was named after the city of York. The south-west of Yorkshire includes the cities of Leeds, Sheffield, Bradford, Doncaster and Wakefield. The north and east of the county includes the southern part of the Teesside conurbation; the port city of Hull is located in the south-east. York is positioned near the centre of the county."}, "cross_references": [{"found_name": "England", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 65, "target_cluster_name": "England", "source_book": "llm_generated", "evidence_snippet": "Yorkshire is a historic county within England.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Yorkshire is a historic county within England."}, {"found_name": "Great Britain", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 776, "target_cluster_name": "Great Britain", "source_book": "llm_generated", "evidence_snippet": "Yorkshire is a historic county within Great Britain.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Yorkshire is a historic county within Great Britain."}, {"found_name": "Lancashire", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2170, "target_cluster_name": "Lancashire", "source_book": "llm_generated", "evidence_snippet": "Lancashire is a neighboring historic county to Yorkshire, often contrasted in historical and cultural contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Lancashire is a neighboring historic county to Yorkshire, often contrasted in historical and cultural contexts."}, {"found_name": "Wales", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1130, "target_cluster_name": "Wales", "source_book": "llm_generated", "evidence_snippet": "Wales is a country within Great Britain, often discussed in relation to English regions like Yorkshire.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Wales is a country within Great Britain, often discussed in relation to English regions like Yorkshire."}, {"found_name": "Scotland", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 373, "target_cluster_name": "Scotland", "source_book": "llm_generated", "evidence_snippet": "Scotland is a country within Great Britain, often discussed in relation to English regions like Yorkshire.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Scotland is a country within Great Britain, often discussed in relation to English regions like Yorkshire."}]}, {"canonical_name": "Averroes", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "averrois", "book_id": "english_physician_1652", "name": "Averrois", "category": "PERSON", "subcategory": "AUTHORITY", "count": 2, "variants": ["Averrois", "Avenaris"], "contexts": ["medieval philosopher", "medieval medical authority"]}, {"entity_id": "averroes", "book_id": "polyanthea_medicinal", "name": "Averroes", "category": "PERSON", "subcategory": "AUTHORITY", "count": 6, "variants": ["Averroes", "Avenzoar"], "contexts": ["medieval philosopher and physician", "ancient authority cited"]}, {"entity_id": "averroes", "book_id": "first_principles_spencer_1862", "name": "Averroes", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Averroes"], "contexts": ["medieval Islamic philosopher"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Averrois", "target_book": "polyanthea_medicinal", "target_name": "Averroes", "similarity": 0.967}, {"source_book": "english_physician_1652", "source_name": "Averrois", "target_book": "first_principles_spencer_1862", "target_name": "Averroes", "similarity": 0.967}, {"source_book": "polyanthea_medicinal", "source_name": "Averroes", "target_book": "first_principles_spencer_1862", "target_name": "Averroes", "similarity": 1.0}], "id": 952, "stable_key": "clu_7b18b0601727def9", "ground_truth": {"modern_name": "Averroes", "confidence": "high", "type": "person", "birth_year": 1126, "death_year": 1198, "description": "Influential Islamic philosopher, jurist, and physician.", "wikidata_id": "Q39837", "wikidata_description": "Arab Andalusian Muslim writer and philosopher (1126–1198)", "wikipedia_url": "https://en.wikipedia.org/wiki/Averroes", "wikipedia_extract": "Ibn Rushd (14 April 1126 – 11 December 1198), Latinized as Averroes, was an Andalusian polymath and jurist who was proficient in a variety of intellectual fields, including philosophy, theology, medicine, astronomy, physics, psychology, mathematics, neurology,  Islamic jurisprudence and law, and linguistics. The author of more than 100 books and treatises, his philosophical works include numerous commentaries on Aristotle, for which he was known in the Western world as \"The Commentator\" and \"Father of Rationalism\". Averroes was a strong proponent of Aristotelianism; he attempted to restore what he considered the original teachings of Aristotle and opposed the Neoplatonist tendencies of earlier Muslim thinkers, such as al-Farabi and Avicenna. He also defended the pursuit of philosophy against criticism by Ash'ari theologians such as Al-Ghazali. Averroes argued that philosophy was permissible in Islam and even compulsory among certain elites. He also argued scriptural text should be interpreted allegorically if it appeared to contradict conclusions reached by reason and philosophy."}, "cross_references": [{"found_name": "Aristotle", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 62, "target_cluster_name": "Aristotle", "source_book": "llm_generated", "evidence_snippet": "Averroes was a highly influential commentator on Aristotle's works, often referred to as 'The Commentator'.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Averroes was a highly influential commentator on Aristotle's works, often referred to as 'The Commentator'."}, {"found_name": "Galen", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 29, "target_cluster_name": "Galen", "source_book": "llm_generated", "evidence_snippet": "Averroes, like many medieval scholars, engaged with and commented on the medical works of Galen.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Averroes, like many medieval scholars, engaged with and commented on the medical works of Galen."}, {"found_name": "Hippocrates", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 31, "target_cluster_name": "Hippocrates", "source_book": "llm_generated", "evidence_snippet": "Averroes, as a physician and scholar, would have been aware of and potentially engaged with the tradition of Hippocrates.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Averroes, as a physician and scholar, would have been aware of and potentially engaged with the tradition of Hippocrates."}, {"found_name": "Alberto Magno", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2461, "target_cluster_name": "Alberto Magno", "source_book": "llm_generated", "evidence_snippet": "Albertus Magnus engaged with and commented on the works of Averroes, the Islamic philosopher whose commentaries on Aristotle were highly influential in medieval Europe. Albertus Magnus sought to reconcile Aristotelian thought with Christian doctrine, often in dialogue with Averroes' interpretations.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Albertus Magnus engaged with and commented on the works of Averroes, the Islamic philosopher whose commentaries on Aristotle were highly influential in medieval Europe. Albertus Magnus sought to reconcile Aristotelian thought with Christian doctrine, often in dialogue with Averroes' interpretations.", "is_reverse": true}, {"found_name": "Paracelsus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 703, "target_cluster_name": "Paracelsus", "source_book": "llm_generated", "evidence_snippet": "Both were significant commentators and interpreters of ancient philosophical and medical texts, particularly Aristotle. Averroes was a foundational figure in Islamic philosophy whose influence extended to medieval and early modern European thought, which Paracelsus engaged with, often critically.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were significant commentators and interpreters of ancient philosophical and medical texts, particularly Aristotle. Averroes was a foundational figure in Islamic philosophy whose influence extended to medieval and early modern European thought, which Paracelsus engaged with, often critically.", "is_reverse": true}, {"found_name": "Amat.", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 902, "target_cluster_name": "Amat.", "source_book": "llm_generated", "evidence_snippet": "Averroes was a highly influential Islamic philosopher who extensively commented on and interpreted Aristotle's works, playing a crucial role in transmitting Aristotelian thought to medieval Europe.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Averroes was a highly influential Islamic philosopher who extensively commented on and interpreted Aristotle's works, playing a crucial role in transmitting Aristotelian thought to medieval Europe.", "is_reverse": true}, {"found_name": "Amatus Lusitanus", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1620, "target_cluster_name": "Amatus Lusitanus", "source_book": "llm_generated", "evidence_snippet": "Averroes, like Avicenna, was a key figure in Islamic medicine whose commentaries and original works were foundational for medical scholarship in Europe during the Renaissance.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Averroes, like Avicenna, was a key figure in Islamic medicine whose commentaries and original works were foundational for medical scholarship in Europe during the Renaissance.", "is_reverse": true}, {"found_name": "Leonardo Fioravanto", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1770, "target_cluster_name": "Leonardo Fioravanto", "source_book": "llm_generated", "evidence_snippet": "Both were significant medical scholars whose works were influential in European medical circles during the Renaissance, though Averroes was from an earlier period and Islamic tradition. Fioravanti would have been aware of and potentially built upon the knowledge transmitted through figures like Averroes.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were significant medical scholars whose works were influential in European medical circles during the Renaissance, though Averroes was from an earlier period and Islamic tradition. Fioravanti would have been aware of and potentially built upon the knowledge transmitted through figures like Averroes.", "is_reverse": true}, {"found_name": "Sepúlveda", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1959, "target_cluster_name": "Sepúlveda", "source_book": "llm_generated", "evidence_snippet": "Sepúlveda engaged in significant debate with Averroist interpretations of Aristotle, particularly concerning the immortality of the soul.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Sepúlveda engaged in significant debate with Averroist interpretations of Aristotle, particularly concerning the immortality of the soul.", "is_reverse": true}, {"found_name": "Carlos Magno", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2881, "target_cluster_name": "Carlos Magno", "source_book": "llm_generated", "evidence_snippet": "Both were influential figures in their respective spheres, Averroes in Islamic philosophy and medicine, and Charlemagne in European politics and the Carolingian Renaissance.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Both were influential figures in their respective spheres, Averroes in Islamic philosophy and medicine, and Charlemagne in European politics and the Carolingian Renaissance.", "is_reverse": true}]}, {"canonical_name": "bagno Maria", "category": "OBJECT", "subcategory": "INSTRUMENT", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "balneo_mariae", "book_id": "english_physician_1652", "name": "Balneo Mariae", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 2, "variants": ["Balneo Mariae"], "contexts": ["apparatus for distillation", "water bath for distillation"]}, {"entity_id": "bagno_maria", "book_id": "ricettario_fiorentino_1597", "name": "bagno Maria", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 6, "variants": ["bagno Maria", "bagno Marie"], "contexts": ["water bath heating method", "Bain-marie, a double boiler for gentle heating"]}, {"entity_id": "banho_chamado_de_maria", "book_id": "polyanthea_medicinal", "name": "banho chamado de Maria", "category": "OBJECT", "subcategory": "INSTRUMENT", "count": 1, "variants": ["banho chamado de Maria"], "contexts": ["method for extracting tincture"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Balneo Mariae", "target_book": "ricettario_fiorentino_1597", "target_name": "bagno Maria", "similarity": 0.896}, {"source_book": "ricettario_fiorentino_1597", "source_name": "bagno Maria", "target_book": "polyanthea_medicinal", "target_name": "banho chamado de Maria", "similarity": 0.903}], "id": 953, "stable_key": "clu_efd6efc02fac5ab3", "ground_truth": {"modern_name": "Bain-marie", "confidence": "high", "type": "object", "description": "Double boiler used for gentle heating of substances.", "note": "Also known as a water bath.", "wikipedia_extract": "A bain-marie (English:  BAN-mə-REE, French: [bɛ̃ maʁi]), also known as a water bath or double boiler, a type of heated bath, is a piece of equipment used in science, industry, and cooking to heat materials gently or to keep materials warm over a period of time. A bain-marie is also used to melt ingredients for cooking. The name comes from the French bain de Marie or bain-marie, in turn derived from the medieval Latin balneum Mariae, all meaning 'Mary's bath'. In his books, the 300 AD alchemist Zosimos of Panopolis credits for the invention of the device Mary the Jewess, an ancient alchemist. However, the water bath was known many centuries earlier (Hippocrates and Theophrastus), and the balneum Mariae attributed to Mary the Jewess was used to heat its contents above 100 °C, while the bain-marie that continues to be used today only heats its contents up to a gentle heat of less than 100 °C. The double boiler comes in a wide variety of shapes, sizes, and types, but traditionally is a wide, cylindrical, usually metal container made of three or four basic parts:  a handle, an outer (or lower) container that holds the working fluid, an inner (or upper), smaller container that fits inside the outer one and which holds the material to be heated or cooked, and sometimes a base underneath."}, "cross_references": [{"found_name": "furnace", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 100, "target_cluster_name": "furnace", "source_book": "llm_generated", "evidence_snippet": "Both are used for heating, but a furnace provides direct heat while a bain-marie provides indirect, gentle heat via water.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Both are used for heating, but a furnace provides direct heat while a bain-marie provides indirect, gentle heat via water."}, {"found_name": "pots", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3280, "target_cluster_name": "Pots", "source_book": "llm_generated", "evidence_snippet": "Pots are often used within a bain-marie to hold substances being heated.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Pots are often used within a bain-marie to hold substances being heated."}, {"found_name": "vessel", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1195, "target_cluster_name": "vaso", "source_book": "llm_generated", "evidence_snippet": "A bain-marie is a type of vessel used for heating.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "A bain-marie is a type of vessel used for heating."}, {"found_name": "alambicco", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1192, "target_cluster_name": "alambicco", "source_book": "llm_generated", "evidence_snippet": "A double boiler used in distillation, often employed in conjunction with or as part of an alembic apparatus.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: A double boiler used in distillation, often employed in conjunction with or as part of an alembic apparatus.", "is_reverse": true}]}, {"canonical_name": "Jerusalém", "category": "PLACE", "subcategory": "CITY", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "jerusalem", "book_id": "english_physician_1652", "name": "Jerusalem", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Jerusalem"], "contexts": ["Temple where writings were kept"]}, {"entity_id": "jerusalem", "book_id": "kosmos_humboldt_1845", "name": "Jerusalem", "category": "PLACE", "subcategory": "CITY", "count": 2, "variants": ["Jerusalem"], "contexts": ["location of a king", "city in the Middle East"]}, {"entity_id": "jerusalém", "book_id": "coloquios_da_orta_1563", "name": "Jerusalém", "category": "PLACE", "subcategory": "CITY", "count": 6, "variants": ["Jerusalém"], "contexts": ["city of origin for apothecary", "city where musay are found"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Jerusalem", "target_book": "kosmos_humboldt_1845", "target_name": "Jerusalem", "similarity": 1.0}, {"source_book": "english_physician_1652", "source_name": "Jerusalem", "target_book": "coloquios_da_orta_1563", "target_name": "Jerusalém", "similarity": 0.967}, {"source_book": "kosmos_humboldt_1845", "source_name": "Jerusalem", "target_book": "coloquios_da_orta_1563", "target_name": "Jerusalém", "similarity": 0.967}], "id": 954, "stable_key": "clu_3deaafe3e45de5e4", "ground_truth": {"modern_name": "Jerusalem", "confidence": "high", "type": "place", "description": "Ancient and holy city, significant in religious and historical contexts.", "wikipedia_extract": "Jerusalem is a city in the Southern Levant, on a plateau in the Judaean Mountains between the Mediterranean and the Dead Sea. It is one of the oldest cities in the world and is considered holy to the three major Abrahamic religions—Judaism, Christianity and Islam. Both Israel and Palestine claim Jerusalem as their capital city; Israel maintains its primary governmental institutions there, while Palestine ultimately foresees it as its seat of power. Neither claim is widely recognised internationally. Throughout its long history, Jerusalem has been destroyed at least twice, besieged 23 times, captured and recaptured 44 times, and attacked 52 times. The part of Jerusalem called the City of David shows first signs of settlement in the 4th millennium BCE, in the shape of encampments of nomadic shepherds."}, "cross_references": [{"found_name": "Palestina", "link_type": "same_referent", "link_strength": 1.0, "target_cluster_id": 2231, "target_cluster_name": "Palestina", "source_book": "llm_generated", "evidence_snippet": "Jerusalem is a major city located within the historical and modern territory of Palestine, holding immense religious and historical significance for the region.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Jerusalem is a major city located within the historical and modern territory of Palestine, holding immense religious and historical significance for the region.", "is_reverse": true}, {"found_name": "Damasco", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1001, "target_cluster_name": "Damasco", "source_book": "llm_generated", "evidence_snippet": "Jerusalem and Damascus are both ancient and historically significant cities in the Levant, often appearing in similar historical contexts.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Jerusalem and Damascus are both ancient and historically significant cities in the Levant, often appearing in similar historical contexts.", "is_reverse": true}, {"found_name": "Judéa", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1971, "target_cluster_name": "Judéa", "source_book": "llm_generated", "evidence_snippet": "Jerusalem is the capital city of Judea and a central historical and religious site within the region.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Jerusalem is the capital city of Judea and a central historical and religious site within the region.", "is_reverse": true}]}, {"canonical_name": "tristeza", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "sadness", "book_id": "english_physician_1652", "name": "Sadness", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["Sadness"], "contexts": ["affliction to be expelled"]}, {"entity_id": "sadness", "book_id": "kosmos_humboldt_1845", "name": "sadness", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 1, "variants": ["sadness"], "contexts": ["emotional state of unhappiness"]}, {"entity_id": "tristeza", "book_id": "polyanthea_medicinal", "name": "tristeza", "category": "DISEASE", "subcategory": "OTHER_DISEASE", "count": 7, "variants": ["tristeza", "Tristezas", "tristezas"], "contexts": ["Sadness that wine dispels", "emotion, sadness"]}], "edges": [{"source_book": "english_physician_1652", "source_name": "Sadness", "target_book": "kosmos_humboldt_1845", "target_name": "sadness", "similarity": 0.995}, {"source_book": "english_physician_1652", "source_name": "Sadness", "target_book": "polyanthea_medicinal", "target_name": "tristeza", "similarity": 0.971}, {"source_book": "kosmos_humboldt_1845", "source_name": "sadness", "target_book": "polyanthea_medicinal", "target_name": "tristeza", "similarity": 0.977}], "id": 955, "stable_key": "clu_9d7c0f11a8567850", "ground_truth": {"modern_name": "Melancholy", "confidence": "high", "type": "disease", "modern_term": "Melancholy", "note": "While 'sadness' is a direct translation, in the context of early modern medicine, 'tristeza' often referred to a more profound, melancholic state akin to what was historically understood as melancholy, a recognized condition with potential physical and mental symptoms.", "wikidata_id": "Q192077", "wikidata_description": "mood disorder of non-specific depression", "wikipedia_url": "https://en.wikipedia.org/wiki/Melancholia", "wikipedia_extract": "Melancholia or melancholy (Ancient Greek: μελαγχολία, romanized: melancholía; from μέλαινα χολή, mélaina cholḗ, 'black bile') is a concept found throughout ancient, medieval, and premodern medicine in Europe that describes a condition characterized by markedly depressed mood, bodily complaints, and sometimes hallucinations and delusions. Besides a pathological condition, melancholy could also refer to a mood or temperament and at times it was even used as a description of the human condition in general. Melancholy (or more precisely the 'black bile', from which melancholy derives its name) was regarded as one of the four temperaments matching the four humours. Until the 18th century, doctors and other scholars classified melancholic conditions as such by their perceived common cause – an excess of a notional fluid known as \"black bile\", which was commonly linked to the spleen. Hippocrates and other ancient physicians described melancholia as a distinct disease with mental and physical symptoms, including persistent fears and despondencies, poor appetite, abulia, sleeplessness, irritability, and agitation. Later, fixed delusions were added by Galen and other physicians to the list of symptoms."}, "cross_references": [{"found_name": "Grief", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1325, "target_cluster_name": "grief", "source_book": "llm_generated", "evidence_snippet": "Grief is a primary emotional state that can lead to or be a component of melancholy.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Grief is a primary emotional state that can lead to or be a component of melancholy."}]}, {"canonical_name": "geologists", "category": "PERSON", "subcategory": "SCHOLAR", "book_count": 3, "total_mentions": 9, "members": [{"entity_id": "geologists", "book_id": "origin_of_species_darwin_1859", "name": "geologists", "category": "PERSON", "subcategory": "SCHOLAR", "count": 4, "variants": ["geologists"], "contexts": ["experts in geological time", "scientists studying Earth's structure"]}, {"entity_id": "geologists", "book_id": "kosmos_humboldt_1845", "name": "geologists", "category": "PERSON", "subcategory": "SCHOLAR", "count": 2, "variants": ["geologists"], "contexts": ["scientists studying the Earth", "scientists studying earth's formation"]}, {"entity_id": "geologists", "book_id": "first_principles_spencer_1862", "name": "geologists", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["geologists"], "contexts": ["scientists studying Earth's history", "disciplines studying Earth's surface"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "geologists", "target_book": "kosmos_humboldt_1845", "target_name": "geologists", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "geologists", "target_book": "first_principles_spencer_1862", "target_name": "geologists", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "geologists", "target_book": "first_principles_spencer_1862", "target_name": "geologists", "similarity": 1.0}], "id": 956, "stable_key": "clu_6c4b35789c67621d", "ground_truth": {"modern_name": "Geologists", "confidence": "high", "type": "person", "description": "Scientists who study the Earth's physical structure and substance.", "wikidata_id": "Q520549", "wikidata_description": "scientist who studies geology", "wikipedia_url": "https://en.wikipedia.org/wiki/Geologist", "wikipedia_extract": "A geologist is a scientist who studies the structure, composition, and history of Earth. Geologists incorporate techniques from physics, chemistry, biology, mathematics, and geography to perform research in the field and the laboratory. Geologists work in the energy and mining sectors to exploit natural resources. They monitor environmental hazards such as earthquakes, volcanoes, tsunamis and landslides. Geologists are also important contributors to climate change discussions. James Hutton is often viewed as the first modern geologist."}, "cross_references": [{"found_name": "Saussure", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 707, "target_cluster_name": "Saussure", "source_book": "llm_generated", "evidence_snippet": "Saussure is described as a geologist and a founder of alpinism, which involves geological exploration of mountains.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Saussure is described as a geologist and a founder of alpinism, which involves geological exploration of mountains.", "is_reverse": true}, {"found_name": "Authors ancient or modern", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3855, "target_cluster_name": "Authors ancient or modern", "source_book": "llm_generated", "evidence_snippet": "Geologists authored works on the earth's structure and history.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Geologists authored works on the earth's structure and history.", "is_reverse": true}, {"found_name": "Astronomers", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 901, "target_cluster_name": "Astronomers", "source_book": "llm_generated", "evidence_snippet": "Geologists study the solid Earth, the rocks of which it is composed, and the processes by which they change. While distinct, both fields are part of the broader study of natural sciences and can involve geological observations of celestial bodies.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Geologists study the solid Earth, the rocks of which it is composed, and the processes by which they change. While distinct, both fields are part of the broader study of natural sciences and can involve geological observations of celestial bodies.", "is_reverse": true}, {"found_name": "Geographers", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3771, "target_cluster_name": "physical geographers", "source_book": "llm_generated", "evidence_snippet": "Geographers and geologists study aspects of the Earth, with significant overlap in their methodologies and areas of inquiry.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Geographers and geologists study aspects of the Earth, with significant overlap in their methodologies and areas of inquiry."}, {"found_name": "Charles Lyell", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1710, "target_cluster_name": "Lyell", "source_book": "llm_generated", "evidence_snippet": "Charles Lyell was a foundational figure in geology, often considered the father of modern geology.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Charles Lyell was a foundational figure in geology, often considered the father of modern geology."}, {"found_name": "James Hutton", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3558, "target_cluster_name": "Hutton", "source_book": "llm_generated", "evidence_snippet": "James Hutton is considered the father of modern geology, proposing key principles like uniformitarianism.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "James Hutton is considered the father of modern geology, proposing key principles like uniformitarianism."}, {"found_name": "Agassiz", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1842, "target_cluster_name": "Agassiz", "source_book": "llm_generated", "evidence_snippet": "Agassiz was a prominent geologist, and this entry represents the broader professional category to which he belonged and contributed.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Agassiz was a prominent geologist, and this entry represents the broader professional category to which he belonged and contributed.", "is_reverse": true}, {"found_name": "Murchison", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2183, "target_cluster_name": "Murchison", "source_book": "llm_generated", "evidence_snippet": "Murchison was a leading figure in the field of geology, and this entry represents the broader professional category he belonged to.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Murchison was a leading figure in the field of geology, and this entry represents the broader professional category he belonged to.", "is_reverse": true}, {"found_name": "Mr. Lyell", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3139, "target_cluster_name": "Mr. Lyell", "source_book": "llm_generated", "evidence_snippet": "Charles Lyell was a foundational figure in the field of geology, and his work defined much of the discipline during his lifetime.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Charles Lyell was a foundational figure in the field of geology, and his work defined much of the discipline during his lifetime.", "is_reverse": true}, {"found_name": "palæontologists", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2529, "target_cluster_name": "palæontologists", "source_book": "llm_generated", "evidence_snippet": "Paleontology is a sub-discipline of ge