ium and are considered close relatives.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Garlic and onions are both species of bulbous flowering plants in the genus Allium and are considered close relatives."}, {"found_name": "Herb", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1696, "target_cluster_name": "herbe", "source_book": "llm_generated", "evidence_snippet": "Garlic is a type of herb.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Garlic is a type of herb."}, {"found_name": "Vegetables", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3853, "target_cluster_name": "Vegetables", "source_book": "llm_generated", "evidence_snippet": "Garlic is a type of vegetable.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Garlic is a type of vegetable."}]}, {"canonical_name": "joints", "category": "SUBSTANCE", "subcategory": "ANATOMY", "book_count": 3, "total_mentions": 11, "members": [{"entity_id": "joints", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "joints", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["joints"], "contexts": ["articulations in the body", "articulations in limbs"]}, {"entity_id": "joints", "book_id": "principles_of_psychology_james_1890", "name": "joints", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 6, "variants": ["joints"], "contexts": ["articulation between bones", "articulations between bones"]}, {"entity_id": "articulations", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "articulations", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["articulations"], "contexts": ["joint-like structures", "joints or connections in the body"]}, {"entity_id": "articulated_parts", "book_id": "kosmos_humboldt_1845", "name": "articulated parts", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["articulated par