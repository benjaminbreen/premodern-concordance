 {"found_name": "Bodily functions", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3004, "target_cluster_name": "organic actions", "source_book": "llm_generated", "evidence_snippet": "Bodily functions are a broader category that includes nerve activity as a key component.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Bodily functions are a broader category that includes nerve activity as a key component."}, {"found_name": "Cognition", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 656, "target_cluster_name": "cognition", "source_book": "llm_generated", "evidence_snippet": "Cognition is a higher-level process that is heavily reliant on and mediated by nerve activity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Cognition is a higher-level process that is heavily reliant on and mediated by nerve activity."}, {"found_name": "Emotion and Will", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3531, "target_cluster_name": "Emotion and Will", "source_book": "llm_generated", "evidence_snippet": "Emotion and Will are complex psychological states that are understood to be generated and regulated by nerve activity.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Emotion and Will are complex psychological states that are understood to be generated and regulated by nerve activity."}]}, {"canonical_name": "Leyden", "category": "PLACE", "subcategory": "CITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "leyden", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Leyden", "category": "PLACE", "subcategory": "CITY", "count": 3, "variants": ["Leyden"], "contexts": ["city in the Netherlands", "city associated with a party of people"]}, {"entity_id": "leyden", "book_id": "english_physician_1652", "name": "Leyden", "category": "PLACE", "subcategory": "CITY", "count": 1, "variants": ["Leyden"], "contexts": ["university where Dioscorides' book is used"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Leyden", "target_book": "english_physician_1652", "target_name": "Leyden", "similarity": 1.0}], "id": 2901, "stable_key": "clu_86db141a88fc8177", "ground_truth": {"wikipedia_extract": "Leiden ( LY-dən; Dutch: [ˈlɛidə(n)] ; in English and archaic Dutch also Leyden) is a city and municipality in the province of South Holland, Netherlands. The municipality of Leiden has a population of 127,046 (31 January 2023), but the city forms one densely connected agglomeration with its suburbs Oegstgeest, Leiderdorp, Voorschoten and Zoeterwoude with 215,602 inhabitants. The Netherlands Central Bureau of Statistics (CBS) further includes Katwijk in the agglomeration which makes the total population of the Leiden urban agglomeration 282,207. Further, Teylingen, Noordwijk, and Noordwijkerhout are included in the larger Leiden urban area, which has 365,913 inhabitants. Leiden is located on the Oude Rijn, at a distance of some 20 km (12 mi) from The Hague to its south and some 40 km (25 mi) from Amsterdam to its north. The recreational area of the Kaag Lakes (Kagerplassen) lies just to the northeast of Leiden."}, "cross_references": []}, {"canonical_name": "Juvenal", "category": "PERSON", "subcategory": "AUTHORITY", "book_count": 2, "total_mentions": 4, "members": [{"entity_id": "juvenal", "book_id": "pseudodoxia_epidemica_browne_1646", "name": "Juvenal", "category": "PERSON", "subcategory": "AUTHORITY", "count": 3, "variants": ["Juvenal"], "contexts": ["ancient Roman satirist", "ancient Roman poet"]}, {"entity_id": "juvenal", "book_id": "english_physician_1652", "name": "Juvenal", "category": "PERSON", "subcategory": "AUTHORITY", "count": 1, "variants": ["Juvenal"], "contexts": ["ancient Roman poet"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "Juvenal", "target_book": "english_physician_1652", "target_name": "Juvenal", "similarity": 1.0}], "id": 2902, "stable_key": "clu_50acc99a3d390798", "ground_truth": {"modern_name": "Juvenal", "confidence": "high", "type": "person", "birth_year": 60, "death_year": 127, "description": "Roman satirist and poet, influential ancient authority", "wikidata_id": "", "wikidata_description": "family name"}, "cross_references": [{"found_name": "Ovid", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2495, "target_cluster_name": "Ovid", "source_book": "llm_generated", "evidence_snippet": "Juvenal and Ovid were both prominent Roman satirists and poets, often studied together for their literary contributions and social commentary.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Juvenal and Ovid were both prominent Roman satirists and poets, often studied together for their literary contributions and social commentary."}, {"found_name": "Martial", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2687, "target_cluster_name": "Martialis", "source_book": "llm_generated", "evidence_snippet": "Juvenal and Martial were both Roman poets known for their epigrams and satirical observations of Roman society.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Juvenal and Martial were both Roman poets known for their epigrams and satirical observations of Roman society."}, {"found_name": "Cicero", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 308, "target_cluster_name": "Cicero", "source_book": "llm_generated", "evidence_snippet": "Juvenal and Cicero were both influential Roman writers and orators, whose works are foundational to Latin literature and rhetoric.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Juvenal and Cicero were both influential Roman writers and orators, whose works are foundational to Latin literature and rhetoric."}]}, {"canonical_name": "Æsculapius", "category": "PERS