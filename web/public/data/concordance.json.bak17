_spencer_1862", "target_name": "climate", "similarity": 0.966}, {"source_book": "origin_of_species_darwin_1859", "source_name": "climates", "target_book": "first_principles_spencer_1862", "target_name": "temperate climates", "similarity": 0.882}, {"source_book": "polyanthea_medicinal", "source_name": "climas", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "climates", "similarity": 0.98}, {"source_book": "polyanthea_medicinal", "source_name": "climas", "target_book": "first_principles_spencer_1862", "target_name": "climate", "similarity": 0.964}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "climates", "target_book": "first_principles_spencer_1862", "target_name": "climate", "similarity": 0.966}, {"source_book": "connexion_physical_sciences_somerville_1858", "source_name": "climates", "target_book": "first_principles_spencer_1862", "target_name": "temperate climates", "similarity": 0.882}], "id": 415, "stable_key": "clu_0eaf11413b467232", "ground_truth": {"modern_name": "Climate", "confidence": "high", "type": "concept", "wikidata_id": "Q7937", "wikidata_description": "long-term statistical characterization of atmospheric conditions in a region, typically averaged over periods of 30 years or more", "wikipedia_url": "https://en.wikipedia.org/wiki/Climate", "wikipedia_extract": "Climate is the long-term weather pattern in a region, typically averaged over 30 years. More rigorously, it is the mean and variability of meteorological variables over a time spanning from months to millions of years. Some of the meteorological variables that are commonly measured are temperature, humidity, atmospheric pressure, wind, and precipitation. In a broader sense, climate is the state of the components of the climate system, including the atmosphere, hydrosphere, cryosphere, lithosphere and biosphere and the interactions between them. The climate of a location is affected by its latitude, longitude, terrain, altitude, land use and nearby water bodies and their currents. Climates can be classified according to the average and typical variables, most commonly temperature and precipitation."}, "cross_references": [{"found_name": "ar ambiente", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1109, "target_cluster_name": "ar ambiente", "source_book": "llm_generated", "evidence_snippet": "Climate is a fundamental aspect of the environment.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: Climate is a fundamental aspect of the environment.", "is_reverse": true}]}, {"canonical_name": "St. Helena", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 4, "total_mentions": 10, "members": [{"entity_id": "st__helena", "book_id": "origin_of_species_darwin_1859", "name": "St. Helena", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 2, "variants": ["St. Helena"], "contexts": ["island where naturalised plants/animals exterminated natives", "oceanic island with native productions exterminated"]}, {"entity_id": "saint_helena", "book_id": "principles_of_psychology_james_1890", "name": "Saint Helena", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 1, "variants": ["Saint Helena"], "contexts": ["island associated with Napoleon's exile"]}, {"entity_id": "st__helena", "book_id": "kosmos_humboldt_1845", "name": "St. Helena", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["St. Helena"], "contexts": ["volcanic island with augmented gravitation", "island in magnetic zone"]}, {"entity_id": "st__helena", "book_id": "connexion_physical_sciences_somerville_1858", "name": "St. Helena", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["St. Helena"], "contexts": ["island in the Atlantic Ocean", "location for magnetic observations"]}], "edges": [{"source_book": "origin_of_species_darwin_1859", "source_name": "St. Helena", "target_book": "principles_of_psychology_james_1890", "target_name": "Saint Helena", "similarity": 0.979}, {"source_book": "origin_of_species_darwin_1859", "source_name": "St. Helena", "target_book": "kosmos_humboldt_1845", "target_name": "St. Helena", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "St. Helena", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "St. Helena", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Saint Helena", "target_book": "kosmos_humboldt_1845", "target_name": "St. Helena", "similarity": 0.979}, {"source_book": "principles_of_psychology_james_1890", "source_name": "Saint Helena", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "St. Helena", "similarity": 0.979}, {"source_book": "kosmos_humboldt_1845", "source_name": "St. Helena", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "St. Helena", "similarity": 1.0}], "id": 416, "stable_key": "clu_33c6e9f0b1f0d5db", "ground_truth": {"wikipedia_extract": "Saint Helena (, US: ; US:  ) is a volcanic and tropical island, located in the South Atlantic Ocean, some 1,874 km (1,165 miles) west of the mainland of the continent of Africa, with the Southern African nations of Angola and Namibia on its southeastern coast being the closest nations geographically. The island is around 1,950 km (1,210 mi) west of the coast of southwestern Angola, and 4,000 km (2,500 mi) east of the major seaport city of Rio de Janeiro, Brazil in South America. It is one of the three constituent parts of Saint Helena, Ascension and Tristan da Cunha, a British overseas territory. Saint Helena measures about 16 by 8 km (10 by 5 mi) and had a population of 4,439 in the 2021 census. It was named after Saint Helena (c. AD 246/248–330), the mother of the Roman emperor Constantine I (AD 272–337, reigned 306–337), also known as Constantine the Great."}, "cross_references": []}, {"canonical_name": "vallées", "categ