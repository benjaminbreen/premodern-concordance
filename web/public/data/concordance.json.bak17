gans of sight"]}, {"entity_id": "eyes", "book_id": "connexion_physical_sciences_somerville_1858", "name": "eyes", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["eyes"], "contexts": ["sensory organs for sight", "sense organ perceiving light"]}, {"entity_id": "organ_of_sight", "book_id": "connexion_physical_sciences_somerville_1858", "name": "organ of sight", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 1, "variants": ["organ of sight"], "contexts": ["the eye and its visual structures"]}, {"entity_id": "visual_organs", "book_id": "first_principles_spencer_1862", "name": "visual organs", "category": "SUBSTANCE", "subcategory": "ANATOMY", "count": 2, "variants": ["visual organs"], "contexts": ["organs responsible for sight"]}], "edges": [{"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "eye", "target_book": "origin_of_species_darwin_1859", "target_name": "Eye", "similarity": 0.994}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "eye", "target_book": "principles_of_psychology_james_1890", "target_name": "eye", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "eye", "target_book": "kosmos_humboldt_1845", "target_name": "eye", "similarity": 1.0}, {"source_book": "pseudodoxia_epidemica_browne_1646", "source_name": "eye", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "eye", "similarity": 1.0}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Eye", "target_book": "principles_of_psychology_james_1890", "target_name": "eye", "similarity": 0.994}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Eye", "target_book": "kosmos_humboldt_1845", "target_name": "eye", "similarity": 0.994}, {"source_book": "origin_of_species_darwin_1859", "source_name": "Eye", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "eye", "similarity": 0.994}, {"source_book": "principles_of_psychology_james_1890", "source_name": "eye", "target_book": "kosmos_humboldt_1845", "target_name": "eye", "similarity": 1.0}, {"source_book": "principles_of_psychology_james_1890", "source_name": "eye", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "eye", "similarity": 1.0}, {"source_book": "kosmos_humboldt_1845", "source_name": "eye", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "eye", "similarity": 1.0}], "id": 81, "stable_key": "clu_3a44f29332afae47", "ground_truth": {"modern_name": "Eye", "confidence": "high", "type": "object", "wikidata_id": "Q7364", "wikidata_description": "organ that detects light and converts it into electro-chemical impulses in neurons", "wikipedia_url": "https://en.wikipedia.org/wiki/Eye", "note": "While 'eyes' can refer to a part of an animal, the contexts and the general usage in natural philosophy lean towards the organ of sight as an object of study rather than the animal itself.", "wikipedia_extract": "An eye is a sensory organ that allows an organism to perceive visual information. It detects light and converts it into electro-chemical impulses in neurons (neurones). It is part of an organism's visual system. In higher organisms, the eye is a complex optical system that collects light from the surrounding environment, regulates its intensity through a diaphragm, focuses it through an adjustable assembly of lenses to form an image, converts this image into a set of electrical signals, and transmits these signals to the brain through neural pathways that connect the eye via the optic nerve to the visual cortex and other areas of the brain. Eyes with resolving power have come in ten fundamentally different forms, classified into compound eyes and non-compound eyes. Compound eyes are made up of multiple small visual units, and are common on insects and crustaceans."}, "member_count": 12, "cross_references": [{"found_name": "Iris", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 2909, "target_cluster_name": "Iris", "source_book": "llm_generated", "evidence_snippet": "The iris is a part of the eye.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The iris is a part of the eye."}, {"found_name": "Auditory nerve", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3092, "target_cluster_name": "auditory nerve", "source_book": "llm_generated", "evidence_snippet": "The auditory nerve is part of the sensory system, analogous to the optic nerve which is part of the visual system.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "The auditory nerve is part of the sensory system, analogous to the optic nerve which is part of the visual system."}, {"found_name": "Light", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 34, "target_cluster_name": "light", "source_book": "llm_generated", "evidence_snippet": "Light is essential for the function of the eye.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "Light is essential for the function of the eye."}, {"found_name": "Faces", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 3833, "target_cluster_name": "Faces", "source_book": "llm_generated", "evidence_snippet": "The eye is a sense organ located in the face.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The eye is a sense organ located in the face.", "is_reverse": true}, {"found_name": "Cornea", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_id": 1083, "target_cluster_name": "Cornea", "source_book": "llm_generated", "evidence_snippet": "The cornea is a part of the eye.", "confidence": 0.85, "auto_label": "llm_related", "found_relationship": "reverse: The cornea is a part of the eye.", "is_reverse": true}, {"found_name": "sense-organs", "link_type": "conceptual_overlap", "link_strength": 0.5, "target_cluster_