subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "lambert", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Lambert", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 4, "variants": ["Lambert"], "contexts": ["author of 'Illustration of the gems Cinchona'", "scholar cited for astronomical acts"]}, {"entity_id": "lambert", "book_id": "kosmos_humboldt_1845", "name": "Lambert", "category": "PERSON", "subcategory": "SCHOLAR", "count": 3, "variants": ["Lambert"], "contexts": ["speculative conclusions about universe structure", "idea about wind direction and barometer"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Lambert", "target_book": "kosmos_humboldt_1845", "target_name": "Lambert", "similarity": 0.733}], "id": 2398, "stable_key": "clu_160f2c2c117f11c0", "ground_truth": {"modern_name": "Johann Heinrich Lambert", "confidence": "high", "type": "person", "birth_year": 1728, "death_year": 1777, "description": "Swiss mathematician, physicist, and astronomer; developed cosmological theories.", "note": "The text mentions 'Illustration of the gems Cinchona' which might be a misattribution or a different Lambert. However, his cosmological theories align with the 'speculative conclusions about universe structure'.", "wikidata_id": "Q122999", "wikidata_description": "German mathematician, physicist and astronomer (1728-1777)", "wikipedia_url": "https://en.wikipedia.org/wiki/Johann%20Heinrich%20Lambert", "wikipedia_extract": "Johann Heinrich Lambert (German: [ˈlambɛʁt]; French: Jean-Henri Lambert; 26 or 28 August 1728 – 25 September 1777) was a polymath from the Republic of Mulhouse, at that time allied to the Swiss Confederacy, who made important contributions to the subjects of mathematics, physics (particularly optics), philosophy, astronomy and map projections. Lambert was born in 1728 into a Huguenot family in the city of Mulhouse, nowadays in  Alsace, France, at that time a city-state allied to the Swiss Confederacy. Some sources give 26 August as his birth date and others 28 August. Leaving school at 12, he continued to study in his free time while undertaking a series of jobs. These included assistant to his father (a tailor), a clerk at a nearby iron works, a private tutor, secretary to the editor of Basler Zeitung and, at the age of 20, private tutor to the sons of Count Salis in Chur. Travelling Europe with his charges (1756–1758) allowed him to meet established mathematicians in the German states, The Netherlands, France and the Italian states."}, "cross_references": []}, {"canonical_name": "Chinese", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "chinois", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Chinois", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["chinois", "Chinois"], "contexts": ["people using quippos for arithmetic", "deserts"]}, {"entity_id": "chinese", "book_id": "connexion_physical_sciences_somerville_1858", "name": "Chinese", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 4, "variants": ["Chinese"], "contexts": ["observers of planetary motions", "origin of ancient comet observations"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Chinois", "target_book": "connexion_physical_sciences_somerville_1858", "target_name": "Chinese", "similarity": 0.961}], "id": 2399, "stable_key": "clu_001dbccf66676c18", "ground_truth": {"modern_name": "Chinese people", "confidence": "high", "type": "concept", "note": "This refers to a group of people and their practices, not a specific individual."}, "cross_references": []}, {"canonical_name": "Maine", "category": "PLACE", "subcategory": "OTHER_PLACE", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "maine", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Maine", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 3, "variants": ["Maine"], "contexts": ["state separated from Massachusets", "State in the United States"]}, {"entity_id": "maine", "book_id": "kosmos_humboldt_1845", "name": "Maine", "category": "PLACE", "subcategory": "OTHER_PLACE", "count": 4, "variants": ["Maine"], "contexts": ["state where J. G. Clarke observed comet", "river region in Germany"]}], "edges": [{"source_book": "relation_historique_humboldt_vol3_1825", "source_name": "Maine", "target_book": "kosmos_humboldt_1845", "target_name": "Maine", "similarity": 1.0}], "id": 2400, "stable_key": "clu_f375b59fe6a0b97b", "ground_truth": {"modern_name": "Maine", "confidence": "high", "type": "place", "country": "United States", "wikipedia_extract": "Maine (  MAYN) is a state in the New England region of the United States, and the northeasternmost state in the contiguous United States. It borders New Hampshire to the west, the Gulf of Maine to the southeast, and the Canadian provinces of New Brunswick and Quebec to the northeast and northwest, and shares a maritime border with Nova Scotia. It is the only state to border only one other state, which is New Hampshire. Maine is the largest state in New England by total area, almost as large as the combined area of the remaining five states. Of the 50 U.S. states, it is the 12th-smallest by area, the 9th-least populous, the 13th-least densely populated, and the most rural. As of 2024, Maine's population stood at a Census-estimated 1,400,000, the state's highest-ever population estimate."}, "cross_references": []}, {"canonical_name": "Santos", "category": "PERSON", "subcategory": "OTHER_PERSON", "book_count": 2, "total_mentions": 7, "members": [{"entity_id": "santos", "book_id": "relation_historique_humboldt_vol3_1825", "name": "Santos", "category": "PERSON", "subcategory": "OTHER_PERSON", "count": 3, "variants": ["Santos"], "contexts": ["dictated notes", "friend of Rodriguez"]}, {"entity_id": "santos", "book_id": "pol